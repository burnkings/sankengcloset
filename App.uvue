<script setup lang="uts">
import { nextTick } from 'vue'
import { initializeTheme, syncSystemChrome, syncTabBarChrome } from '@/theme/use-theme'
import { warmRuntimeCache } from '@/config/runtime'
import { useSyncStore } from '@/stores/sync-store'

// 网络恢复监听（仅注册一次）：恢复联网后冲刷本地待同步队列
let networkListenerBound = false
function bindNetworkListener() {
  if (networkListenerBound) return
  networkListenerBound = true
  uni.onNetworkStatusChange((res) => {
    if (res.isConnected) useSyncStore().syncNow()
  })
}

// 首次启动：未同意条款则进**登录页**（隐私同意已经并进登录页了，不再单独拦一个页面）。
// 2026-09-28：原实现在这里 redirectTo('/pages/privacy/index')，那是一个只有
// 「同意并继续 / 不同意」两个按钮的孤立整页，和登录完全割裂，也没有任何品牌上下文。
// 现在统一由 pages/auth/login 承载：微信一键登录 / 仅在本机使用 + 底部条款勾选行。
// `v2_privacy_gate_shown` 只表示「看过并选择先逛逛」，用来避免每次冷启动都拦一次；
// 它**不等于同意**，真正的同意只在用户勾选后写入 `v2_privacy_agreed`。
function ensurePrivacyConsent() {
  try {
    const agreed = uni.getStorageSync('v2_privacy_agreed') as string
    if (agreed === '1') return
    const shown = uni.getStorageSync('v2_privacy_gate_shown') as string
    if (shown === '1') return
    uni.redirectTo({ url: '/pages/auth/login' })
  } catch (e) {}
}

onLaunch(() => {
  warmRuntimeCache()
  // 主题初始化延迟到下一微任务：避开 vapor 首帧渲染 effect 的建立窗口，
  // 消除模块级 reactive 同步写导致的 "Active effect was not restored correctly"
  nextTick(() => {
    initializeTheme()
    syncTabBarChrome()
  })
  ensurePrivacyConsent()
  // 启动时冲刷队列（离线期间的写操作补上送）
  useSyncStore().syncNow()
  bindNetworkListener()
})

onAppShow(() => {
  syncSystemChrome()
  useSyncStore().syncNow()
})
</script>

<style>
/*
 * 全局字体 — 「三坑绮橱-UI优化设计」设计稿
 *   Inter + Noto Sans SC，两者均为 OFL（自由商用）
 *   Noto Sans SC 经过按需子集化（923 个 UI 实际用到的 CJK 字 + ASCII），
 *   缺字回落 PingFang SC / 系统中文（font-family 栈在 MainLayout 中）。
 *
 * ⚠️ 只在 App 端注册：微信小程序的 @font-face **不支持包内本地路径**（渲染层安全沙箱
 *    禁止 url('./fonts/x.ttf') 这类包内引用），只认 base64 或已加白名单的 HTTPS 地址，
 *    且优先 woff/woff2 —— ttf 本地路径会被直接忽略。
 *    也就是说这 5 个 ttf（≈603KB，占主包约 1/3）在小程序里**既不生效又白占体积**，
 *    而且单文件 332.7KB 还会触发「图片和音频资源应不超过 200K」的未通过项。
 *    所以用条件编译只给 App 注册；小程序端一直用的就是系统字体，视觉不变。
 *    对应地，小程序产物里的 static/fonts/*.ttf 由 scripts/build-mp-weixin.ps1 剔除。
 */
/* #ifdef APP */
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-Regular.ttf') format('truetype');
}
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-Medium.ttf') format('truetype');
}
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-SemiBold.ttf') format('truetype');
}
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-Bold.ttf') format('truetype');
}
@font-face {
  font-family: 'Noto Sans SC';
  src: url('/static/fonts/NotoSansSC-Regular.ttf') format('truetype');
}
/* #endif */
</style>
