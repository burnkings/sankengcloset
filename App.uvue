<script setup lang="uts">
import { nextTick } from 'vue'
import { initializeTheme, syncSystemChrome, syncTabBarChrome } from '@/theme/use-theme'
import { warmRuntimeCache } from '@/config/runtime'
import { useSyncStore } from '@/stores/sync-store'

// 网络恢复监听（仅注册一次）：恢复联网后冲刷本地待同步队列
let networkListenerBound = false
function bindNetworkListener() {
  if (networkListenerBound) return
  networkListenerBound = true
  uni.onNetworkStatusChange((res) => {
    if (res.isConnected) useSyncStore().syncNow()
  })
}

onLaunch(() => {
  warmRuntimeCache()
  // 主题初始化延迟到下一微任务：避开 vapor 首帧渲染 effect 的建立窗口，
  // 消除模块级 reactive 同步写导致的 "Active effect was not restored correctly"
  nextTick(() => {
    initializeTheme()
    syncTabBarChrome()
  })
  // 启动时冲刷队列（离线期间的写操作补上送）
  useSyncStore().syncNow()
  bindNetworkListener()
})

onAppShow(() => {
  syncSystemChrome()
  useSyncStore().syncNow()
})

onAppHide(() => {})
</script>

<style>
/*
 * 全局字体 — 「三坑绮橱-UI优化设计」设计稿
 *   Inter + Noto Sans SC，两者均为 OFL（自由商用）
 *   Noto Sans SC 经过按需子集化（923 个 UI 实际用到的 CJK 字 + ASCII），
 *   缺字回落 PingFang SC / 系统中文（font-family 栈在 MainLayout 中）。
 */
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-Regular.ttf') format('truetype');
}
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-Medium.ttf') format('truetype');
}
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-SemiBold.ttf') format('truetype');
}
@font-face {
  font-family: 'Inter';
  src: url('/static/fonts/Inter-Bold.ttf') format('truetype');
}
@font-face {
  font-family: 'Noto Sans SC';
  src: url('/static/fonts/NotoSansSC-Regular.ttf') format('truetype');
}
</style>
