  // 首页最可能的下一步是「商品详情」，其次是「品牌」。只预下载这两个、且只在 Wi-Fi 下。
  // 不要在启动页用 network:"all" 预下载 —— 那等于把首屏下载量又加回去了，分包就白做了。
  "preloadRule": {
    "pages/home/index": {
      "network": "wifi",
      "packages": ["pages/product", "pages/brand"]
    },
    "pages/favorites/index": {
      "network": "wifi",
      "packages": ["pages/product"]
    },
    // 发布动态页在 `pages/share` 分包里。不预下载的话，用户第一次点「发布」要等
    // 子包下载完才进得去 —— 就是反馈里的「第一次点击发布动态还要刷新一段时间」。
    // ⚠️ `network` 必须用 `wifi`：项目门禁（check-pages-parity）会拦 `all` ——
    // 非启动页在**移动网络**下预下载，会被算进微信的「首屏下载量」，把刚优化下来的体积加回去。
    "pages/community/index": {
      "network": "wifi",
      "packages": ["pages/share", "pages/product"]
    }
  },
  // #endif
  "globalStyle": {
    "navigationBarTextStyle": "@navTextStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    // ⚠️ backgroundColor 和 backgroundColorContent 是**两个不同的层**，别只写一个：
    //   · backgroundColor        = 下拉刷新露出的「窗口背景」（微信官方口径），深色下由 theme.json 驱动
    //   · backgroundColorContent = **页面内容背景**，也就是 page 本体那一层的底色
    //   只设 backgroundColor 时，page 本体仍是微信默认白底；子页面（无原生 tabBar）底部那条
    //   带子不在根容器覆盖范围内，露出的就是这层白 —— 深色模式下表现为「底部一条白」。
    //   uni-app x 官方暗黑适配文档点名要求 globalStyle 必须配 backgroundColorContent，
    //   否则页面创建瞬间还会闪白。见 https://doc.dcloud.net.cn/uni-app-x/api/theme-change.html
    "backgroundColorContent": "@bgContentColor",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/tab-home.png",
        "selectedIconPath": "static/tabbar/tab-home-active.png"
      },
      {
        "pagePath": "pages/discover/index",
        "text": "发现",
        "iconPath": "static/tabbar/tab-discover.png",
        "selectedIconPath": "static/tabbar/tab-discover-active.png"
      },
