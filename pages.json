      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } },
        { "path": "edit", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "name": "editorial",
      "root": "pages/editorial",
      "pages": [
        { "path": "detail", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
