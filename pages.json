  // #ifdef MP-WEIXIN
  // 小程序端分包：非 tabBar 页面全部按目录下沉。
  // 「按目录」不是偷懒 —— 微信要求 subpackage root 是一个目录、路径前缀即包边界；
  // 好处是页面 URL 完全不变（root 只是前缀），所有 navigateTo 一行都不用改。
  "subPackages": [
    {
      "name": "search",
      "root": "pages/search",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "name": "share",
      "root": "pages/share",
      "pages": [
        { "path": "create", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "name": "product",
      "root": "pages/product",
      "pages": [
        { "path": "detail", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "name": "wardrobe",
      "root": "pages/wardrobe",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } },
        { "path": "edit", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "name": "budget",
      "root": "pages/budget",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } }
      ]
    },
    {
      "name": "purchase",
      "root": "pages/purchase",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } },
        { "path": "detail", "style": { "navigationStyle": "custom" } },
        { "path": "edit", "style": { "navigationStyle": "custom" } },
