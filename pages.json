      "root": "pages/preferences",
      "pages": [
        { "path": "index", "style": { "navigationStyle": "custom" } },
        { "path": "appearance", "style": { "navigationStyle": "custom" } },
        { "path": "notification", "style": { "navigationStyle": "custom" } },
