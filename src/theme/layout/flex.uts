/**
 * Flex Design System — UniApp X 统一布局系统
 *
 * UniApp X 默认: display:flex; flex-direction:column
 * 因此:
 *   - display:'flex' 永远不需要（已是默认）
 *   - flexDirection:'column' 永远不需要（已是默认）
 *   - 只有 flexDirection:'row' 需要显式声明
 *
 * 使用方式: import { flexRowCenter, flexCenter } from '@/theme/layout/flex'
 * 然后: <view :style="{ ...flexRowCenter, gap: '16rpx' }">
 */

// ==================== Row 布局 ====================

/** 横向布局 */
export const flexRow = {
  flexDirection: 'row',
} as any

/** 横向居中 */
export const flexRowCenter = {
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'center',
} as any

/** 横向两端对齐 */
export const flexRowBetween = {
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'space-between',
} as any

/** 横向环绕分布 */
export const flexRowAround = {
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'space-around',
} as any

/** 横向左对齐 */
export const flexRowStart = {
  flexDirection: 'row',
  alignItems: 'center',
} as any

/** 横向右对齐 */
export const flexRowEnd = {
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'flex-end',
} as any

// ==================== Column 布局 ====================

/** 纵向布局（默认，空对象） */
export const flexColumn = {} as any

/** 纵向居中 */
export const flexColumnCenter = {
  alignItems: 'center',
} as any

/** 纵向两端对齐 */
export const flexColumnBetween = {
  justifyContent: 'space-between',
} as any

/** 纵向拉伸 */
export const flexColumnStretch = {
  alignItems: 'stretch',
} as any

// ==================== 通用 ====================

/** 完全居中（纵横都居中） */
export const flexCenter = {
  alignItems: 'center',
  justifyContent: 'center',
} as any

/** 填充父容器 */
export const flexFill = {
  flex: 1,
} as any

// ==================== 工厂函数 ====================

class FlexOptions {
  direction: string = ''
  align: string = ''
  justify: string = ''
  gap: string = ''
  wrap: boolean = false
}

/**
 * 创建自定义 flex 布局
 * 只传非默认值，UniApp X 默认已经是 column + flex-start
 */
export function createFlex(options: FlexOptions): any {
  const style: any = {}
  // 只有 row 需要显式设置
  if (options.direction == 'row') style.flexDirection = 'row'
  if (options.align != '') style.alignItems = options.align
  if (options.justify != '') style.justifyContent = options.justify
  if (options.gap != '') style.gap = options.gap
  if (options.wrap) style.flexWrap = 'wrap'
  return style
}
