<template>
  <MainLayout>
    <template #navbar>
      <AppNavbar title="我的" :show-back="false" />
    </template>
    <template #default>
      <view :style="pageStyle">
        <view :style="userCardStyle">
          <view :style="avatarStyle">
            <text :style="avatarTextStyle">🎀</text>
          </view>
          <view :style="userInfoStyle">
            <text :style="userNameStyle">三坑小主</text>
            <text :style="userTagStyle">本地账户 · 游客模式</text>
          </view>
        </view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import {, brand } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRowCenter, flexCenter } from '@/theme/layout/flex'
import { gap } from '@/theme/layout/spacing'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'


const pageStyle = computed(() => ({
  ...gap.lg,
  padding: spacing[4],
}))

const userCardStyle = computed(() => ({
  ...flexRowCenter,
  gap: spacing[4],
  padding: spacing[4],
  backgroundColor: n.value.surface,
  borderRadius: '24rpx',
}))

const avatarStyle = computed(() => ({
  width: '100rpx',
  height: '100rpx',
  borderRadius: '50%',
  backgroundColor: brand[500] + '15',
  ...flexCenter,
}))

const avatarTextStyle = computed(() => ({
  fontSize: '48rpx',
}))

const userInfoStyle = computed(() => ({
  flex: 1,
}))

const userNameStyle = computed(() => ({
  fontSize: fontSize.lg,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
}))

const userTagStyle = computed(() => ({
  fontSize: fontSize.sm,
  color: n.value.textTertiary,
  marginTop: spacing[1],
}))
</script>
