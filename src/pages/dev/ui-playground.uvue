<template>
  <MainLayout>
    <template #navbar>
      <AppNavbar title="UI Playground" :show-back="false" />
    </template>

    <template #default>
      <view :style="pageStyle">

        <!-- ====== Section: Flex Row ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">横向布局 (Row)</text>

          <text :style="labelStyle">flexRowStart</text>
          <view :style="{ ...flexRowStart, ...demoBoxStyle, gap: spacing[2] }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">flexRowCenter</text>
          <view :style="{ ...flexRowCenter, ...demoBoxStyle, gap: spacing[2] }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">flexRowBetween</text>
          <view :style="{ ...flexRowBetween, ...demoBoxStyle, gap: spacing[2] }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">flexRowEnd</text>
          <view :style="{ ...flexRowEnd, ...demoBoxStyle, gap: spacing[2] }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>
        </view>

        <!-- ====== Section: Flex Column ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">纵向布局 (Column)</text>

          <text :style="labelStyle">flexColumnCenter</text>
          <view :style="{ ...flexColumnCenter, ...demoBoxStyle, gap: spacing[2] }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">flexCenter</text>
          <view :style="{ ...flexCenter, ...demoBoxStyle, height: '200rpx' }">
            <view :style="blockA" />
          </view>
        </view>

        <!-- ====== Section: Gap ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">间距 (Gap)</text>

          <text :style="labelStyle">gap.xs (8rpx)</text>
          <view :style="{ ...flexRow, ...demoBoxStyle, ...gap.xs }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">gap.sm (16rpx)</text>
          <view :style="{ ...flexRow, ...demoBoxStyle, ...gap.sm }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">gap.md (24rpx)</text>
          <view :style="{ ...flexRow, ...demoBoxStyle, ...gap.md }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>

          <text :style="labelStyle">gap.lg (32rpx)</text>
          <view :style="{ ...flexRow, ...demoBoxStyle, ...gap.lg }">
            <view :style="blockA" /><view :style="blockB" /><view :style="blockC" />
          </view>
        </view>

        <!-- ====== Section: Padding ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">内边距 (Padding)</text>

          <text :style="labelStyle">pad.sm (16rpx)</text>
          <view :style="{ ...pad.sm, ...demoOutlineStyle }">
            <view :style="blockA" />
          </view>

          <text :style="labelStyle">pad.md (24rpx)</text>
          <view :style="{ ...pad.md, ...demoOutlineStyle }">
            <view :style="blockA" />
          </view>

          <text :style="labelStyle">pad.lg (32rpx)</text>
          <view :style="{ ...pad.lg, ...demoOutlineStyle }">
            <view :style="blockA" />
          </view>
        </view>

        <!-- ====== Section: Card ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">卡片 (Card)</text>

          <AppCard>
            <text :style="cardTitleStyle">默认 Card (elevated=true)</text>
            <text :style="cardBodyStyle">自带 padding、圆角、阴影</text>
          </AppCard>

          <AppCard :elevated="false" :padding="spacing[2]">
            <text :style="cardTitleStyle">无阴影 Card</text>
            <text :style="cardBodyStyle">elevated=false, padding=spacing[2]</text>
          </AppCard>
        </view>

        <!-- ====== Section: Button ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">按钮 (Button)</text>

          <view :style="{ ...gap.sm }">
            <AppButton variant="primary" block @click="onBtnClick('primary')">primary</AppButton>
            <AppButton variant="secondary" block @click="onBtnClick('secondary')">secondary</AppButton>
            <AppButton variant="outline" block @click="onBtnClick('outline')">outline</AppButton>
            <AppButton variant="ghost" block @click="onBtnClick('ghost')">ghost</AppButton>
            <AppButton variant="danger" block @click="onBtnClick('danger')">danger</AppButton>
          </view>

          <text :style="labelStyle">尺寸</text>
          <view :style="{ ...flexRowCenter, ...gap.sm }">
            <AppButton variant="primary" size="sm" @click="onBtnClick('sm')">sm</AppButton>
            <AppButton variant="primary" size="md" @click="onBtnClick('md')">md</AppButton>
            <AppButton variant="primary" size="lg" @click="onBtnClick('lg')">lg</AppButton>
          </view>

          <text :style="labelStyle">禁用 + Loading</text>
          <view :style="{ ...flexRowCenter, ...gap.sm }">
            <AppButton variant="primary" block disabled>disabled</AppButton>
            <AppButton variant="primary" block loading>loading</AppButton>
          </view>

          <text :style="labelStyle">自定义颜色</text>
          <AppButton variant="primary" block color="#8B5CF6">紫色按钮</AppButton>
        </view>

        <!-- ====== Section: Avatar ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">头像 (Avatar)</text>

          <view :style="{ ...flexRowCenter, ...gap.lg }">
            <view :style="avatarSmStyle">
              <text :style="avatarEmojiStyle">🎀</text>
            </view>
            <view :style="avatarMdStyle">
              <text :style="avatarEmojiStyle">👗</text>
            </view>
            <view :style="avatarLgStyle">
              <text :style="avatarEmojiStyle">🌸</text>
            </view>
          </view>
        </view>

        <!-- ====== Section: Grid ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">网格 (Grid)</text>

          <text :style="labelStyle">2 列 (grid2 + grid2Item)</text>
          <view :style="grid2">
            <view :style="gridItem2Style"><text :style="gridTextStyle">1</text></view>
            <view :style="gridItem2Style"><text :style="gridTextStyle">2</text></view>
            <view :style="gridItem2Style"><text :style="gridTextStyle">3</text></view>
            <view :style="gridItem2Style"><text :style="gridTextStyle">4</text></view>
          </view>

          <text :style="labelStyle">3 列 (grid3 + grid3Item)</text>
          <view :style="grid3">
            <view :style="gridItem3Style"><text :style="gridTextStyle">1</text></view>
            <view :style="gridItem3Style"><text :style="gridTextStyle">2</text></view>
            <view :style="gridItem3Style"><text :style="gridTextStyle">3</text></view>
            <view :style="gridItem3Style"><text :style="gridTextStyle">4</text></view>
            <view :style="gridItem3Style"><text :style="gridTextStyle">5</text></view>
            <view :style="gridItem3Style"><text :style="gridTextStyle">6</text></view>
          </view>
        </view>

        <!-- ====== Section: Input ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">输入框 (Input)</text>

          <AppInput v-model="inputValue" placeholder="请输入内容" clearable />
          <text :style="labelStyle">当前值: {{ inputValue }}</text>

          <AppInput placeholder="错误状态" error="请输入必填项" />
        </view>

        <!-- ====== Section: Loading ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">加载 (Loading)</text>

          <AppLoading text="加载中..." />
        </view>

        <!-- ====== Section: List ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">列表 (List)</text>

          <view :style="{ ...gap.sm }">
            <AppCard v-for="(item, index) in listItems" :key="index" :padding="spacing[3]">
              <template #header>
                <view :style="{ ...flexRowBetween }">
                  <text :style="listItemTitleStyle">{{ item.title }}</text>
                  <text :style="listItemArrowStyle">›</text>
                </view>
              </template>
              <text :style="listItemDescStyle">{{ item.desc }}</text>
            </AppCard>
          </view>
        </view>

        <!-- ====== Section: Dialog ====== -->
        <view :style="sectionStyle">
          <text :style="sectionTitleStyle">弹窗 (Dialog)</text>
          <AppButton variant="outline" block @click="showDialog = true">打开 Dialog</AppButton>
          <AppDialog
            v-model:visible="showDialog"
            title="确认删除"
            message="删除后无法恢复，确定要删除吗？"
            @confirm="onDialogConfirm"
            @cancel="onDialogCancel"
          />
        </view>

        <view :style="{ height: '64rpx' }" />
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { neutralLight, brand, accent } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { shadow } from '@/theme/tokens/shadow'
import {
  flexRow, flexRowCenter, flexRowBetween, flexRowStart, flexRowEnd,
  flexColumnCenter, flexCenter,
} from '@/theme/layout/flex'
import { gap, pad } from '@/theme/layout/spacing'
import { grid2, grid2Item, grid3, grid3Item } from '@/theme/layout/grid'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppCard from '@/components/base/AppCard.uvue'
import AppButton from '@/components/base/AppButton.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'

// 使用 light 主题（Playground 不切换暗色）
const n = neutralLight

// 状态
const inputValue = ref('')
const showDialog = ref(false)

const pageStyle = {
  padding: spacing[4],
  gap: spacing[4],
}

const sectionStyle = {
  gap: spacing[3],
}

const sectionTitleStyle = {
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: n.text,
  marginBottom: spacing[1],
}

const labelStyle = {
  fontSize: fontSize.xs,
  color: n.textTertiary,
  marginTop: spacing[1],
}

const demoBoxStyle = {
  backgroundColor: n.bgTertiary,
  borderRadius: radius.md,
  padding: spacing[2],
  minHeight: '80rpx',
}

const demoOutlineStyle = {
  borderWidth: '2rpx',
  borderStyle: 'solid',
  borderColor: n.border,
  borderRadius: radius.md,
}

// Color blocks
const blockA = {
  width: '60rpx',
  height: '60rpx',
  backgroundColor: brand[500],
  borderRadius: radius.sm,
}

const blockB = {
  width: '60rpx',
  height: '60rpx',
  backgroundColor: accent[500],
  borderRadius: radius.sm,
}

const blockC = {
  width: '60rpx',
  height: '60rpx',
  backgroundColor: brand[300],
  borderRadius: radius.sm,
}

// Card
const cardTitleStyle = {
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: n.text,
}

const cardBodyStyle = {
  fontSize: fontSize.sm,
  color: n.textSecondary,
  marginTop: spacing[1],
}

// Avatar
const avatarSmStyle = {
  width: '80rpx',
  height: '80rpx',
  borderRadius: semanticRadius.avatar,
  backgroundColor: brand[500] + '15',
  ...flexCenter,
}

const avatarMdStyle = {
  width: '120rpx',
  height: '120rpx',
  borderRadius: semanticRadius.avatar,
  backgroundColor: accent[500] + '15',
  ...flexCenter,
}

const avatarLgStyle = {
  width: '160rpx',
  height: '160rpx',
  borderRadius: semanticRadius.avatar,
  backgroundColor: brand[300] + '15',
  ...flexCenter,
}

const avatarEmojiStyle = {
  fontSize: '48rpx',
}

// Grid
const gridItem2Style = {
  ...grid2Item,
  backgroundColor: n.bgTertiary,
  borderRadius: radius.md,
  padding: spacing[3],
  ...flexCenter,
}

const gridItem3Style = {
  ...grid3Item,
  backgroundColor: n.bgTertiary,
  borderRadius: radius.md,
  padding: spacing[3],
  ...flexCenter,
}

const gridTextStyle = {
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: n.textSecondary,
}

// List
const listItems = [
  { title: 'JK 制服', desc: '水手服 · 格裙 · 西装' },
  { title: 'Lolita', desc: '甜系 · 田园 · 哥特' },
  { title: '汉服', desc: '宋制 · 明制 · 唐制' },
]

const listItemTitleStyle = {
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: n.text,
}

const listItemArrowStyle = {
  fontSize: fontSize.xl,
  color: n.textTertiary,
}

const listItemDescStyle = {
  fontSize: fontSize.sm,
  color: n.textSecondary,
}

// Event handlers
function onBtnClick(name: string) {
  console.log(`[Playground] Button clicked: ${name}`)
}

function onDialogConfirm() {
  console.log('[Playground] Dialog confirmed')
}

function onDialogCancel() {
  console.log('[Playground] Dialog cancelled')
}
</script>
