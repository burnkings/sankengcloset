/**
 * PurchaseRepo — 消费记录数据仓库
 * 简单封装 uni.storage
 */

import { PurchaseRecord } from '@/domain/purchase-record'

const STORAGE_KEY = 'purchase_records'

function loadAll(): PurchaseRecord[] {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (!raw) return []
    const arr = JSON.parse(raw) as any[]
    return arr.map((obj) => {
      const r = new PurchaseRecord()
      r.id = obj.id ?? ''
      r.name = obj.name ?? ''
      r.brand = obj.brand ?? ''
      r.shopName = obj.shopName ?? ''
      r.category = obj.category ?? ''
      r.totalAmount = obj.totalAmount ?? 0
      r.depositAmount = obj.depositAmount ?? 0
      r.paidAmount = obj.paidAmount ?? 0
      r.remainingAmount = obj.remainingAmount ?? 0
      r.paymentStatus = obj.paymentStatus ?? 'PRE_ORDER'
      r.purchaseDate = obj.purchaseDate ?? ''
      r.deadline = obj.deadline ?? ''
      r.note = obj.note ?? ''
      r.isFavorite = obj.isFavorite ?? false
      r.isDeleted = obj.isDeleted ?? false
      r.createdAt = obj.createdAt ?? ''
      r.updatedAt = obj.updatedAt ?? ''
      return r
    })
  } catch {
    return []
  }
}

function saveAll(records: PurchaseRecord[]) {
  uni.setStorageSync(STORAGE_KEY, JSON.stringify(records))
}

function generateId(): string {
  return `${Date.now()}-${Math.floor(Math.random() * 10000)}`
}

export function getAll(): PurchaseRecord[] {
  return loadAll().filter((r) => !r.isDeleted)
}

export function getById(id: string): PurchaseRecord | undefined {
  return loadAll().find((r) => r.id === id && !r.isDeleted)
}

export function add(record: PurchaseRecord): PurchaseRecord {
  const records = loadAll()
  record.id = generateId()
  record.remainingAmount = Math.max(0, record.totalAmount - record.paidAmount)
  record.createdAt = new Date().toISOString()
  record.updatedAt = record.createdAt
  records.push(record)
  saveAll(records)
  return record
}

export function update(id: string, data: any): boolean {
  const records = loadAll()
  const idx = records.findIndex((r) => r.id === id)
  if (idx < 0) return false
  const r = records[idx]
  if (data.name !== undefined) r.name = data.name
  if (data.brand !== undefined) r.brand = data.brand
  if (data.shopName !== undefined) r.shopName = data.shopName
  if (data.totalAmount !== undefined) r.totalAmount = data.totalAmount
  if (data.depositAmount !== undefined) r.depositAmount = data.depositAmount
  if (data.paidAmount !== undefined) r.paidAmount = data.paidAmount
  if (data.paymentStatus !== undefined) r.paymentStatus = data.paymentStatus
  if (data.purchaseDate !== undefined) r.purchaseDate = data.purchaseDate
  if (data.deadline !== undefined) r.deadline = data.deadline
  if (data.note !== undefined) r.note = data.note
  r.remainingAmount = Math.max(0, r.totalAmount - r.paidAmount)
  r.updatedAt = new Date().toISOString()
  saveAll(records)
  return true
}

export function softDelete(id: string): boolean {
  const records = loadAll()
  const r = records.find((rec) => rec.id === id)
  if (!r) return false
  r.isDeleted = true
  r.updatedAt = new Date().toISOString()
  saveAll(records)
  return true
}

export function initMockData() {
  const existing = loadAll()
  if (existing.length > 0) return

  const now = new Date().toISOString()
  const mockData: PurchaseRecord[] = [
    (() => { const r = new PurchaseRecord(); r.id = 'p1'; r.name = '深蓝格裙 45cm'; r.brand = '中牌'; r.shopName = '中牌制服馆'; r.totalAmount = 128; r.depositAmount = 30; r.paidAmount = 128; r.remainingAmount = 0; r.paymentStatus = 'COMPLETED'; r.purchaseDate = '2026-05-10'; r.deadline = ''; r.createdAt = now; r.updatedAt = now; return r })(),
    (() => { const r = new PurchaseRecord(); r.id = 'p2'; r.name = '甜系草莓柄 SK'; r.brand = 'Alice兔'; r.shopName = 'Alice兔原创'; r.totalAmount = 680; r.depositAmount = 200; r.paidAmount = 200; r.remainingAmount = 480; r.paymentStatus = 'DEPOSIT_PAID'; r.purchaseDate = '2026-06-15'; r.deadline = '2026-08-15'; r.createdAt = now; r.updatedAt = now; return r })(),
    (() => { const r = new PurchaseRecord(); r.id = 'p3'; r.name = '哥特十字架 JSK'; r.brand = 'BABY'; r.shopName = 'BABY天猫'; r.totalAmount = 1580; r.depositAmount = 500; r.paidAmount = 0; r.remainingAmount = 1580; r.paymentStatus = 'PRE_ORDER'; r.purchaseDate = '2026-07-01'; r.deadline = '2026-10-01'; r.createdAt = now; r.updatedAt = now; return r })(),
