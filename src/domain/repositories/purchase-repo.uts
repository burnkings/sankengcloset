    (() => { const r = new PurchaseRecord(); r.id = 'p6'; r.name = '蕾丝边夹套装'; r.brand = '表面咒语'; r.shopName = '表面咒语'; r.totalAmount = 260; r.depositAmount = 80; r.paidAmount = 0; r.remainingAmount = 260; r.paymentStatus = 'CANCELLED'; r.purchaseDate = '2026-05-20'; r.deadline = ''; r.createdAt = now; r.updatedAt = now; return r })(),
  ]
  saveAll(mockData)
}
