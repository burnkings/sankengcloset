// ====== 优先级 ======

export const PRIORITY_HIGH = 'HIGH'
export const PRIORITY_MEDIUM = 'MEDIUM'
export const PRIORITY_LOW = 'LOW'

export type WishPriority = 'HIGH' | 'MEDIUM' | 'LOW'

export const PRIORITY_LABELS: any = {
  HIGH: '高',
  MEDIUM: '中',
  LOW: '低',
}

export const PRIORITY_COLORS: any = {
  HIGH: '#EF4444',
  MEDIUM: '#F59E0B',
  LOW: '#9CA3AF',
}

export const PRIORITY_ORDER: any = {
  HIGH: 1,
  MEDIUM: 2,
  LOW: 3,
}

// ====== 来源 ======

export const SOURCE_MANUAL = 'MANUAL'
export const SOURCE_AI_IMPORT = 'AI_IMPORT'
export const SOURCE_DISCOVERY = 'DISCOVERY'

export type WishSource = 'MANUAL' | 'AI_IMPORT' | 'DISCOVERY'

export const SOURCE_LABELS: any = {
  MANUAL: '手动添加',
  AI_IMPORT: 'AI导入',
  DISCOVERY: '发现',
}

// ====== 数据模型 ======

export class WishItem {
  id: string = ''
  name: string = ''
  coverImage: string = ''
  brand: string = ''
  estimatedPrice: number = 0
  priority: string = 'MEDIUM'
  status: string = 'WISH'
  source: string = 'MANUAL'
  // 生命周期关联
  wardrobeId: string = ''
  purchaseId: string = ''
  convertedAt: string = ''
  // 附加信息
  note: string = ''
  url: string = ''
  isDeleted: boolean = false
  createdAt: string = ''
  updatedAt: string = ''
}
