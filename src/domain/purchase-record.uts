/**
 * PurchaseRecord — 消费记录数据模型
 * 简化版：纯数据 class
 */

export const STATUS_PRE_ORDER = 'PRE_ORDER'
export const STATUS_DEPOSIT_PAID = 'DEPOSIT_PAID'
export const STATUS_BALANCE_PENDING = 'BALANCE_PENDING'
export const STATUS_COMPLETED = 'COMPLETED'
export const STATUS_CANCELLED = 'CANCELLED'

export type PaymentStatus = 'PRE_ORDER' | 'DEPOSIT_PAID' | 'BALANCE_PENDING' | 'COMPLETED' | 'CANCELLED'

export const PAYMENT_STATUS_LABELS: any = {
  PRE_ORDER: '预售中',
  DEPOSIT_PAID: '已付定金',
  BALANCE_PENDING: '待付款',
  COMPLETED: '已完成',
  CANCELLED: '已取消',
}

export const PAYMENT_STATUS_COLORS: any = {
  PRE_ORDER: '#8B5CF6',
  DEPOSIT_PAID: '#FF4D7E',
  BALANCE_PENDING: '#F59E0B',
  COMPLETED: '#22C55E',
  CANCELLED: '#9CA3AF',
}

export class PurchaseRecord {
  id: string = ''
  name: string = ''
  brand: string = ''
  shopName: string = ''
  category: string = ''
  totalAmount: number = 0
  depositAmount: number = 0
  paidAmount: number = 0
  remainingAmount: number = 0
  paymentStatus: string = 'PRE_ORDER'
  purchaseDate: string = ''
  deadline: string = ''
  note: string = ''
  isFavorite: boolean = false
  isDeleted: boolean = false
  createdAt: string = ''
  updatedAt: string = ''
}

/** 状态筛选选项 */
export const FILTER_OPTIONS = [
  { label: '全部', value: '' },
  { label: '预售中', value: 'PRE_ORDER' },
  { label: '已付定金', value: 'DEPOSIT_PAID' },
  { label: '待付款', value: 'BALANCE_PENDING' },
  { label: '已完成', value: 'COMPLETED' },
  { label: '已取消', value: 'CANCELLED' },
]
