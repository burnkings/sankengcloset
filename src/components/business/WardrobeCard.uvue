<template>
  <!-- Grid 模式：图片在上，信息在下 -->
  <view v-if="mode === 'grid'" :style="gridContainerStyle" @tap="emit('click')">
    <AppImage
      :src="item.coverImage"
      width="100%"
      height="240rpx"
      :radius-token="radius.md"
      lazy-load
    />
    <view :style="gridBodyStyle">
      <text :style="gridNameStyle">{{ item.name }}</text>
      <text v-if="item.brand" :style="gridBrandStyle">{{ item.brand }}</text>
      <view :style="tagRowStyle">
        <view :style="categoryTagStyle">
          <text :style="categoryTagText">{{ categoryLabel }}</text>
        </view>
      </view>
      <view :style="gridBottomRow">
        <text v-if="item.purchasePrice > 0" :style="priceStyle">¥{{ item.purchasePrice }}</text>
        <text v-if="item.isFavorite" :style="favIconSmall">❤️</text>
      </view>
    </view>
  </view>

  <!-- List 模式：图片在左，信息在右 -->
  <AppCard v-else :padding="spacing[3]" @click="emit('click')">
    <view :style="rowStyle">
      <AppImage
        :src="item.coverImage"
        width="160rpx"
        height="200rpx"
        :radius-token="radius.md"
        lazy-load
      />
      <view :style="infoStyle">
        <text :style="nameStyle">{{ item.name }}</text>
        <view :style="tagRowStyle">
          <view :style="categoryTagStyle">
            <text :style="categoryTagText">{{ categoryLabel }}</text>
          </view>
          <text v-if="item.brand" :style="brandStyle">{{ item.brand }}</text>
        </view>
        <text v-if="item.color" :style="detailStyle">颜色: {{ item.color }}</text>
        <text v-if="item.size" :style="detailStyle">尺码: {{ item.size }}</text>
        <view :style="bottomRowStyle">
          <text v-if="item.purchasePrice > 0" :style="priceStyle">¥{{ item.purchasePrice }}</text>
          <text :style="statusStyle">{{ wearStatusLabel }}</text>
        </view>
      </view>
      <view v-if="item.isFavorite" :style="favStyle">
        <text :style="favIconStyle">❤️</text>
      </view>
    </view>
  </AppCard>
</template>

<script setup lang="uts">
import { WardrobeItem } from '@/domain/wardrobe-item'
import { CATEGORY_LABELS, CATEGORY_JK, CATEGORY_LOLITA, CATEGORY_HANFU } from '@/domain/clothing-category'
import {, brand, categoryColors } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { shadow } from '@/theme/tokens/shadow'
import { flexRow, flexFill, flexRowBetween } from '@/theme/layout/flex'
import { gap } from '@/theme/layout/spacing'
import { n } from '@/theme/use-theme'
import AppCard from '@/components/base/AppCard.uvue'
import AppImage from '@/components/base/AppImage.uvue'

const props = withDefaults(defineProps<{
  item: WardrobeItem
  mode?: string
}>(), {
  mode: 'list',
})

const emit = defineEmits<{
  click: []
}>()


const categoryLabel = computed(() => CATEGORY_LABELS[props.item.category] ?? '其他')

const wearStatusLabel = computed(() => {
  const map = {
    UNWORN: '未穿',
    WORN: '已穿',
    FREQUENT: '常穿',
  } as any
  return map[props.item.wearStatus] ?? ''
})

const categoryTagColor = computed(() => {
  if (props.item.category === CATEGORY_JK) return categoryColors.jk.primary
  if (props.item.category === CATEGORY_LOLITA) return categoryColors.lolita.primary
  if (props.item.category === CATEGORY_HANFU) return categoryColors.hanfu.primary
  return brand[500]
})

// ====== Grid 模式样式 ======

const gridContainerStyle = computed(() => ({
  backgroundColor: n.value.surface,
  borderRadius: radius.lg,
  overflow: 'hidden' as string,
  boxShadow: shadow.card,
}))

const gridBodyStyle = {
  padding: `${spacing[2]} ${spacing[2]}`,
}

const gridNameStyle = computed(() => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  overflow: 'hidden' as string,
  lines: 1,
}))

const gridBrandStyle = computed(() => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  marginTop: '4rpx',
  overflow: 'hidden' as string,
  lines: 1,
}))

const gridBottomRow = {
  ...flexRowBetween,
  alignItems: 'center' as string,
  marginTop: spacing[1],
}

const favIconSmall = {
  fontSize: '24rpx',
}

// ====== List 模式样式 ======

const rowStyle = {
  ...flexRow,
  gap: spacing[3],
  position: 'relative' as string,
}

const infoStyle = {
  ...flexFill,
  gap: spacing[1],
  overflow: 'hidden' as string,
}

const nameStyle = computed(() => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  overflow: 'hidden' as string,
  lines: 1,
}))

// ====== 共享样式 ======

const tagRowStyle = {
  ...flexRow,
  gap: spacing[1],
  alignItems: 'center' as string,
  marginTop: spacing[1],
}

const categoryTagStyle = computed(() => ({
  paddingHorizontal: spacing[2],
  paddingVertical: '4rpx',
  borderRadius: radius.sm,
  backgroundColor: categoryTagColor.value + '15',
}))

const categoryTagText = computed(() => ({
  fontSize: fontSize.xs,
  color: categoryTagColor.value,
}))

const brandStyle = computed(() => ({
  fontSize: fontSize.sm,
  color: n.value.textTertiary,
}))

const detailStyle = computed(() => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  marginTop: '4rpx',
}))

const bottomRowStyle = {
  ...flexRow,
  justifyContent: 'space-between' as string,
  alignItems: 'center' as string,
  marginTop: spacing[2],
}

const priceStyle = computed(() => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.bold,
  color: brand[500],
}))

const statusStyle = computed(() => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
}))

const favStyle = {
  position: 'absolute' as string,
  top: '0',
  right: '0',
}

const favIconStyle = {
  fontSize: '28rpx',
}
</script>
