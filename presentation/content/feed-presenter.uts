// ====== Badge 颜色 ======

/** 角标颜色：新品/预售/降价/联名/限定 */
export function getBadgeColor(badge: string): string {
  if (badge === '新品') return semantic.success
  if (badge === '预售') return accent[500]
  if (badge === '降价') return semantic.error
  if (badge === '联名') return '#6366F1'
  if (badge === '限定') return semantic.warning
  if (badge === '动态') return brand[500]
  return brand[500]
}

/** 分类占位图背景色 */
export function getCategoryPlaceholderBg(category: string): string {
  if (category === 'JK') return jkColors.bg
  if (category === 'LOLITA') return lolitaColors.bg
  if (category === 'HANFU') return hanfuColors.bg
  return '#FFF8E1'
}

/** 分类主色 */
export function getCategoryAccent(category: string): string {
  if (category === 'JK') return jkColors.primary
  if (category === 'LOLITA') return lolitaColors.primary
  if (category === 'HANFU') return hanfuColors.primary
  return brand[500]
}
