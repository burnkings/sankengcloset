/**
 * FeedPresenter — 内容 Feed 展示层元数据
 * 从 domain 层提取的 Labels / Colors / Badge 样式
 * Domain 只保留状态值和数据字段；展示文案和颜色在这里
 *
 * 颜色值引用 theme tokens，不硬编码
 */

import { brand, accent, semantic, jkColors, lolitaColors, hanfuColors } from '@/theme/tokens/colors'
import { ReleaseEvent } from '@/domain/content/release-event'
import { formatPriceCents } from '@/utils/format'

// ====== FeedType 展示 ======

export const FeedTypeLabels: UTSJSONObject = {
  product: '商品',
  release_event: '发售',
  brand_post: '品牌动态',
  outfit: '穿搭',
  editorial: '编辑精选',
  ai_recommendation: 'AI推荐',
} as UTSJSONObject

export function getFeedTypeLabel(feedType: string): string {
  const label = FeedTypeLabels[feedType]
  return label != null ? label as string : '内容'
}

export function getFeedTypeColor(feedType: string): string {
  if (feedType === 'product') return brand[500]
  if (feedType === 'release_event') return accent[500]
  if (feedType === 'brand_post') return '#6366F1'
  if (feedType === 'outfit') return semantic.success
  if (feedType === 'editorial') return semantic.warning
  if (feedType === 'ai_recommendation') return semantic.info
  return brand[500]
}

// ====== EventType 展示 ======

export const EventTypeLabels: UTSJSONObject = {
  preview: '图透',
  reservation: '预约',
  deposit: '定金',
  final_payment: '尾款',
  release: '发售',
  restock: '补货',
  price_drop: '降价',
} as UTSJSONObject

export function getEventTypeLabel(eventType: string): string {
  const label = EventTypeLabels[eventType]
  return label != null ? label as string : eventType
}

export function getEventTypeColor(eventType: string): string {
  if (eventType === 'preview') return accent[500]
  if (eventType === 'reservation') return '#6366F1'
  if (eventType === 'deposit') return semantic.warning
  if (eventType === 'final_payment') return brand[500]
  if (eventType === 'release') return semantic.success
  if (eventType === 'restock') return semantic.info
  if (eventType === 'price_drop') return semantic.error
  return brand[500]
}

