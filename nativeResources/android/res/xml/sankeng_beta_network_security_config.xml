<?xml version="1.0" encoding="utf-8"?>
<!--
  BETA 专用网络配置（与正式包隔离）：
  允许所有明文 HTTP 流量，仅限本地内测 / 连调试服务器使用。
  ⚠️ release 构建不得引用本文件 —— 正式包使用 sankeng_network_security_config.xml（cleartext 禁用）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
