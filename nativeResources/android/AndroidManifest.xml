<?xml version="1.0" encoding="utf-8"?>
<!-- V2.5 Android configuration. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.dcloud.sankengcloset">
    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33): 图片选择需要的新权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 13+ (API 33): 通知权限（提醒功能需要） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12 及以下兼容：旧存储权限（仅对 Android 12 及以下生效） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/sankeng_beta_network_security_config"
        tools:replace="android:usesCleartextTraffic,android:networkSecurityConfig" />
</manifest>
