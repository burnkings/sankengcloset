<?xml version="1.0" encoding="utf-8"?>
<!-- V2.6 Android configuration — 正式包安全默认。
  cleartext HTTP 全局禁用；仅允许生产 API 域名走 HTTPS。
  内测如需明文 HTTP，请临时切换引用 beta 网络配置（见 res/xml/ 下 beta 文件），
  并确保 release 构建不继承该 beta 配置。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.dcloud.sankengcloset">
    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33): 图片选择需要的新权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 13+ (API 33): 通知权限（提醒功能需要） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12 及以下兼容：旧存储权限（仅对 Android 12 及以下生效） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <application
        android:networkSecurityConfig="@xml/sankeng_network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
