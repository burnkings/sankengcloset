import { SyncOperation, SYNC_PENDING, SYNC_FAILED } from '@/domain/sync/sync-operation'
import { DATA_MODE_REMOTE, getRuntimeConfig, getAccessToken } from '@/config/runtime'
import { apiPostAuthorized, apiPatchAuthorized, apiDeleteAuthorized, apiPutAuthorized, apiErrorStatus, encodeQuery } from '@/services/platform/api-client'
import { listWishlistRemote, followBrandRemote, unfollowBrandRemote, setCommunityPostLikeRemote, deleteCommunityPostRemote, saveBudgetRemote, markNotificationReadRemote } from '@/services/user-data/user-data-service'

const QUEUE_IDS_KEY = 'v21_sync_queue_ids'
const PREFIX = 'v21_sync_op_'
const DEVICE_KEY = 'v21_device_id'
const DROPPED_KEY = 'v21_sync_dropped'
const DROPPED_MAX = 100

// ====== 队列淘汰策略 ======
/** 单条操作最大重试次数：超过后不再重放，移入存档 */
const MAX_RETRY = 3
/** 操作最大保留时长（7 天）：超过后不再重放，移入存档 */
const TTL_MS = 7 * 24 * 3600 * 1000
/** 真正无自动重放端点的实体：本地已乐观更新、后端无对应 CRUD，直接存档降级。
 * 注意：brand_follow/post_like/budget/outfit(远程删除) 均有真实直写端点，在 replayOperation 中重放，不入本列表。 */
const NON_REPLAYABLE = ['wish', 'ai_import_confirmation']

function readString(key: string): string {
  try { const value = uni.getStorageSync(key); return value == null ? '' : value as string } catch (e) { return '' }
}
function readIds(): string[] { const raw = readString(QUEUE_IDS_KEY); return raw === '' ? [] : raw.split(',').filter((id) => id !== '') }
function writeIds(ids: string[]): boolean {
  try { uni.setStorageSync(QUEUE_IDS_KEY, ids.join(',')); return true } catch (e) { return false }
}
function key(id: string, field: string): string { return `${PREFIX}${id}_${field}` }
function writeOperation(op: SyncOperation): boolean {
  try {
    uni.setStorageSync(key(op.opId, 'user'), op.userId); uni.setStorageSync(key(op.opId, 'device'), op.deviceId)
    uni.setStorageSync(key(op.opId, 'entity_type'), op.entityType); uni.setStorageSync(key(op.opId, 'entity_id'), op.entityId)
    uni.setStorageSync(key(op.opId, 'action'), op.action); uni.setStorageSync(key(op.opId, 'payload'), op.payload)
    uni.setStorageSync(key(op.opId, 'created_at'), op.createdAt); uni.setStorageSync(key(op.opId, 'retry'), op.retryCount.toString())
    uni.setStorageSync(key(op.opId, 'status'), op.status)
    return true
  } catch (e) {
    return false
  }
}
function readOperation(id: string): SyncOperation {
  const op = new SyncOperation(); op.opId = id; op.userId = readString(key(id, 'user')); op.deviceId = readString(key(id, 'device'))
  op.entityType = readString(key(id, 'entity_type')); op.entityId = readString(key(id, 'entity_id')); op.action = readString(key(id, 'action'))
  op.payload = readString(key(id, 'payload')); op.createdAt = readString(key(id, 'created_at'))
  const retryRaw = parseInt(readString(key(id, 'retry')))
  op.retryCount = isNaN(retryRaw) ? 0 : retryRaw
  const statusRaw = readString(key(id, 'status'))
  op.status = statusRaw === '' ? SYNC_PENDING : statusRaw
  return op
}
function removeOperation(id: string) {
  const fields = ['user','device','entity_type','entity_id','action','payload','created_at','retry','status']
  for (let i = 0; i < fields.length; i++) { try { uni.removeStorageSync(key(id, fields[i])) } catch (e) {} }
}

/**
 * 判定操作是否应淘汰：重试超限或超期。
 * 淘汰不等于丢数据：操作会移入 v21_sync_dropped 存档（上限 100 条，可 drain 恢复）。
 */
function shouldDrop(op: SyncOperation): boolean {
  if (op.retryCount >= MAX_RETRY) return true
  const createdAtMs = parseInt(op.createdAt)
  if (isNaN(createdAtMs)) return false
  return Date.now() - createdAtMs > TTL_MS
}

/** 移入存档：先写存档成功后再从队列移除（避免存档失败时操作彻底丢失）。 */
function dropOperation(op: SyncOperation, reason: string) {
  const record = {
    opId: op.opId,
    userId: op.userId,
    deviceId: op.deviceId,
    entityType: op.entityType,
    entityId: op.entityId,
    action: op.action,
    payload: op.payload,
    createdAt: op.createdAt,
    retryCount: op.retryCount,
    status: op.status,
    reason,
    droppedAt: Date.now().toString(),
  } as UTSJSONObject
  try {
    const raw = readString(DROPPED_KEY)
    let list: UTSJSONObject[] = []
    if (raw !== '') {
      try {
        const parsed = JSON.parse(raw) as UTSJSONObject[]
        if (parsed != null) list = parsed
      } catch (e) {}
    }
    list.push(record)
    if (list.length > DROPPED_MAX) list = list.slice(list.length - DROPPED_MAX)
    uni.setStorageSync(DROPPED_KEY, JSON.stringify(list))
  } catch (e) {
    // 存档写入失败：不删除队列，保留操作等待下次重试，避免不可恢复丢失
    return
  }
  removeOperation(op.opId)
}

/**
 * 重放错误分类（以后端实际幂等契约为准，客户端不伪造成功）：
 * - 401：Authorized 请求内部已单飞刷新并重试一次；仍 401 = 会话失效 → 抛出，
 *   由 flushRemote 中止整次冲刷且不消耗队列（保留至重新登录后再次 flush）。
 * - 网络层(0)/429/5xx：瞬时失败 → 保留队列（return 0），下次 flush 再试；不消耗重试计数，
 *   避免「离线多次启动 app」把可恢复操作误淘汰。上限由 7 天 TTL 预清扫兜底。
 * - 409 × create/upsert/import：幂等成功（后端 /me/* 资产以客户端 id 落库，同 id 已存在
 *   即返回冲突 → 重放收敛为「已存在」，绝不产生重复实体）。
 * - 404 × delete：幂等成功（目标已不存在，删除语义天然幂等）。
 * - 其余 4xx：不可重试（校验/权限等确定性拒绝）→ 立即存档降级（reason 带 http_<status>），
 *   不再无限重试，也不清空队列伪造成功。
 */
function replayErrorResult(op: SyncOperation, error: any): number {
  const status = apiErrorStatus(error)
  if (status == 401) throw error
  if (status == 0 || status == 429 || status >= 500) return 0
  const isCreate = op.action == 'create' || op.action == 'upsert' || op.action == 'import'
  if (status == 409 && isCreate) return 1
  if (status == 404 && op.action == 'delete') return 1
  dropOperation(op, 'http_' + status.toString())
  return 2
}

/** 读取存档（供未来版本从存档恢复重入队）。 */
export function drainDroppedOperations(): SyncOperation[] {
  const raw = readString(DROPPED_KEY)
  if (raw === '') return []
  try {
    const parsed = JSON.parse(raw) as UTSJSONObject[]
    if (parsed == null) return []
    const result: SyncOperation[] = []
    for (let i = 0; i < parsed.length; i++) {
      const item = parsed[i]
      const op = new SyncOperation()
      op.opId = item['opId'] != null ? item['opId'] as string : ''
      op.userId = item['userId'] != null ? item['userId'] as string : ''
      op.deviceId = item['deviceId'] != null ? item['deviceId'] as string : ''
      op.entityType = item['entityType'] != null ? item['entityType'] as string : ''
      op.entityId = item['entityId'] != null ? item['entityId'] as string : ''
      op.action = item['action'] != null ? item['action'] as string : ''
      op.payload = item['payload'] != null ? item['payload'] as string : ''
      op.createdAt = item['createdAt'] != null ? item['createdAt'] as string : ''
      op.retryCount = item['retryCount'] != null ? item['retryCount'] as number : 0
      op.status = item['status'] != null ? item['status'] as string : SYNC_PENDING
      result.push(op)
    }
    return result
  } catch (e) {
    return []
  }
}
function safePayload(value: string): string { if (value === '' || value.charAt(0) !== '{') return JSON.stringify({ value }); try { JSON.parse(value); return value } catch (e) { return JSON.stringify({ value }) } }

export function getCurrentSyncUserId(): string { const saved = readString('v21_session_user_id'); return saved !== '' ? saved : 'guest_local' }
export function getOrCreateDeviceId(): string { const saved = readString(DEVICE_KEY); if (saved !== '') return saved; const id = `device_${Date.now()}_${Math.floor(Math.random() * 10000)}`; uni.setStorageSync(DEVICE_KEY, id); return id }
export function enqueueLocalOperation(userId: string, entityType: string, entityId: string, action: string, payload: string): string {
  const op = new SyncOperation(); op.opId = `op_${Date.now()}_${Math.floor(Math.random() * 10000)}`; op.userId = userId; op.deviceId = getOrCreateDeviceId()
  op.entityType = entityType; op.entityId = entityId; op.action = action; op.payload = safePayload(payload); op.createdAt = Date.now().toString(); op.status = SYNC_PENDING
  if (!writeOperation(op)) return ''
  const ids = readIds(); ids.push(op.opId)
  if (!writeIds(ids)) { removeOperation(op.opId); return '' }
  return op.opId
}
export function readPendingOperations(): SyncOperation[] { const ids = readIds(); const result: SyncOperation[] = []; for (let i = 0; i < ids.length; i++) result.push(readOperation(ids[i])); return result }

/**
 * 收藏（favorite）操作重放：直接作用于 /api/v1/wishlist 真实业务端点。
 * - create/upsert：POST 创建条目（status 必填 'WISH'，productId 关联商品）。
 * - update：按 entityId 定位 wishlist 条目后 PATCH 透传 status（不硬编码、不 POST，避免重复条目）。
 *   entityId 两种可能：wishlist itemId（已登录直更失败入队）或 productId（未登录入队）。
 * - delete：按 productId 查服务端条目后 DELETE（幂等：不存在视为已删除）。
 */
async function replayFavorite(op: SyncOperation): Promise<number> {
  try {
    const payload = safePayload(op.payload)
    if (op.action == 'delete') {
      let productId = op.entityId
      if (payload != '' && payload != '{}') {
        const body = JSON.parse(payload) as UTSJSONObject
        if (body['productId'] != null && body['productId'] as string != '') productId = body['productId'] as string
      }
      const items = await listWishlistRemote()
      for (let i = 0; i < items.length; i++) {
        const raw = items[i]
        if (raw['productId'] != null && raw['productId'] as string == productId) {
          const itemId = raw['id'] != null ? raw['id'] as string : ''
          if (itemId != '') await apiDeleteAuthorized('/api/v1/wishlist/' + encodeQuery(itemId))
          return 1
        }
      }
      return 1
    }
    if (op.action == 'update') {
      // 状态更新重放：只 PATCH，绝不 POST 创建，避免重复 wishlist 条目
      const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
      const status = body['status'] != null ? body['status'] as string : ''
      if (status == '') return 0
      const items = await listWishlistRemote()
      // 场景 1：entityId 即 wishlist itemId（已登录直更失败入队）→ 直接 PATCH 该条目
      for (let i = 0; i < items.length; i++) {
        const raw = items[i]
        if (raw['id'] != null && raw['id'] as string == op.entityId) {
          await apiPatchAuthorized('/api/v1/wishlist/' + encodeQuery(op.entityId), { status } as UTSJSONObject)
          return 1
        }
      }
      // 场景 2：entityId 为 productId（未登录入队）→ 按商品定位服务端条目后 PATCH
      const targetProduct = body['productId'] != null ? body['productId'] as string : op.entityId
      if (targetProduct != '') {
        for (let i = 0; i < items.length; i++) {
          const raw = items[i]
          if (raw['productId'] != null && raw['productId'] as string == targetProduct) {
            const itemId = raw['id'] != null ? raw['id'] as string : ''
            if (itemId == '') return 0
            await apiPatchAuthorized('/api/v1/wishlist/' + encodeQuery(itemId), { status } as UTSJSONObject)
            return 1
          }
        }
      }
      // 服务端尚无对应条目：保留队列重试（前置 upsert 重放后即可命中；不 POST 创建）
      return 0
    }
    const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
    const productId = body['productId'] != null ? body['productId'] as string : op.entityId
    const title = body['title'] != null ? body['title'] as string : productId
    if (productId == '') return 0
    await apiPostAuthorized('/api/v1/wishlist', { title, status: 'WISH', productId } as UTSJSONObject)
    return 1
  } catch (e) {
    // 服务端 wishlist 以 user+productId 唯一收敛（重复 POST 返回既有条目），
    // 重放分类：409/404-delete 幂等成功、4xx 存档、网络/5xx 保留重试、401 中止
    return replayErrorResult(op, e)
  }
}

/**
 * 逐条重放一个操作到真实业务端点（依据后端实际能力）：
 * - 后端 /api/v1/sync/operations:batch 仅写入 sync_operations 审计表、不应用业务数据，
 *   因此离线期间入队的操作必须在恢复后重放真实的 /api/v1/me/* CRUD 端点。
 * - 支持实体：reminder / wardrobe_item / wishlist_item / purchase / favorite（真实 CRUD 重放）。
 * - 其余实体（outfit 缺图、post_like 等）无对应幂等重放端点：
 *   本地 _state 已乐观更新，继续保留只会每次前台恢复全量重读 → 存档降级，等价「放弃服务端补偿、保留本地最终态」。
 * @returns true 重放成功或已降级处理；false 失败（保留队列重试）
 */
async function replayOperation(op: SyncOperation): Promise<number> {
  // 返回 0=失败(保留队列重试) 1=成功(移除) 2=dropped(存档，不计入 acceptedCount)
  if (op.entityType == 'favorite') return await replayFavorite(op)
  if (NON_REPLAYABLE.indexOf(op.entityType) >= 0) {
    dropOperation(op, 'no_replay_support')
    return 2
  }
  if (op.entityType == 'brand_follow') return await replayBrandFollow(op)
  if (op.entityType == 'post_like') return await replayPostLike(op)
  if (op.entityType == 'budget') return await replayBudget(op)
  if (op.entityType == 'notification_read') {
    try {
      await markNotificationReadRemote(op.entityId)
      return 1
    } catch (e) { return replayErrorResult(op, e) }
  }
  if (op.entityType == 'outfit') {
    // 本地草稿（outfit_ 前缀）无远程端点 → 存档降级；远程帖子删除 → 真实 DELETE
    if (op.entityId.startsWith('outfit_') || op.action != 'delete') {
      dropOperation(op, 'no_replay_support')
      return 2
    }
    try {
      await deleteCommunityPostRemote(op.entityId)
      return 1
    } catch (e) {
      // 远程帖子删除 404=已不存在 → 幂等成功；其余按统一分类处理
      return replayErrorResult(op, e)
    }
  }
  let path = ''
  if (op.entityType == 'reminder') path = '/api/v1/me/reminders'
  else if (op.entityType == 'wardrobe_item') path = '/api/v1/me/wardrobe'
  else if (op.entityType == 'wishlist_item') path = '/api/v1/me/wishes'
  else if (op.entityType == 'purchase') path = '/api/v1/me/purchases'
  else return 0 // 未知实体：保留队列，不阻塞其他操作

  try {
    if (op.action == 'create' || op.action == 'upsert' || op.action == 'import') {
      const payload = safePayload(op.payload)
      const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
      await apiPostAuthorized(path, body)
      return 1
    }
    if (op.action == 'delete') {
      await apiDeleteAuthorized(path + '/' + encodeQuery(op.entityId))
      return 1
    }
    // update / 状态动作：PATCH 部分字段（队列 payload 通常为同步后的完整实体 JSON）
    const payload = safePayload(op.payload)
    const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
    await apiPatchAuthorized(path + '/' + encodeQuery(op.entityId), body)
    return 1
  } catch (e) {
    // 统一错误分类（409 create 幂等 / delete 404 幂等 / 4xx 存档 / 网络+5xx 保留 / 401 中止）
    return replayErrorResult(op, e)
  }
}

/** 品牌关注/取关重放：upsert → follow，delete → unfollow */
async function replayBrandFollow(op: SyncOperation): Promise<number> {
  const brandName = op.entityId
  if (brandName === '') return 0
  try {
    if (op.action == 'delete') await unfollowBrandRemote(brandName)
    else await followBrandRemote(brandName)
    return 1
  } catch (e) {
    // 取关 404=已未关注 → 幂等成功；品牌不存在等 4xx → 存档降级
    return replayErrorResult(op, e)
  }
}

/** 帖子点赞/取消重放：upsert → liked=true，delete → liked=false */
async function replayPostLike(op: SyncOperation): Promise<number> {
  const postId = op.entityId
  if (postId === '') return 0
  try {
    const wanted = op.action != 'delete'
    await setCommunityPostLikeRemote(postId, wanted)
    return 1
  } catch (e) {
    return replayErrorResult(op, e)
  }
}

/** 预算设置重放：upsert → saveBudgetRemote(payload) */
async function replayBudget(op: SyncOperation): Promise<number> {
  if (op.action == 'delete') { dropOperation(op, 'no_replay_support'); return 2 }
  try {
    const payload = safePayload(op.payload)
    const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
    await saveBudgetRemote(body)
    return 1
  } catch (e) {
    return replayErrorResult(op, e)
  }
}

/** 网络可达性（仅 'none' 视为离线；unknown/失败按可达处理，交由请求超时兜底） */
function isNetworkAvailable(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    try {
      uni.getNetworkType({
        success: (res) => { resolve(res.networkType != 'none') },
        fail: () => { resolve(true) },
      })
    } catch (e) {
      resolve(true)
    }
  })
}

/**
 * 冲刷队列：逐条重放真实 CRUD；结果分类见 replayErrorResult：
 * - 成功/幂等成功(1) → 移除；存档(2) → 已由重放内部 dropOperation，直接移除。
 * - 瞬时失败(0) → 标记 SYNC_FAILED 保留队列（不消耗重试计数：离线多次启动不会误淘汰，
 *   由 7 天 TTL 预清扫兜底）。
 * - 401 会话失效 → 先持久化「已成功项移除、其余保留」的队列状态，再抛出中止整次冲刷。
 */
async function flushRemote(ids: string[]): Promise<number> {
  if (getAccessToken() === '') throw new Error('请先登录账号再同步')
  const remaining: string[] = []
  let acceptedCount = 0
  for (let i = 0; i < ids.length; i++) {
    const op = readOperation(ids[i])
    let result = 0
    try {
      result = await replayOperation(op)
    } catch (e) {
      // 401（刷新后仍失败）：保留本 op 与未处理 op，已成功移除的保持移除，中止本次冲刷
      if (apiErrorStatus(e) != 401) throw e
      remaining.push(ids[i])
      for (let j = i + 1; j < ids.length; j++) remaining.push(ids[j])
      writeIds(remaining)
      throw e
    }
    if (result == 1) {
      removeOperation(ids[i])
      acceptedCount++
    } else if (result == 2) {
      // dropped：已由 replayOperation 内部存档，直接移除，不计入成功条数
      removeOperation(ids[i])
    } else {
      // 瞬时失败（网络/5xx/429）：保留队列重试，不消耗 retryCount（离线多次启动不误淘汰）
      op.status = SYNC_FAILED
      writeOperation(op)
      remaining.push(ids[i])
    }
  }
  writeIds(remaining)
  if (acceptedCount > 0) { try { uni.setStorageSync('v21_sync_last_success_at', Date.now().toString()) } catch (e) {} }
  return acceptedCount
}

/**
 * 冲刷本地队列（恢复联网 / 登录后 / onAppShow 调用）。
 * R0 修复：remote 模式此前被 `!config.mockOnline` 误阻断（mockOnline 固定为 false），
 * 离线期间入队的操作永远无法重放。现在 remote 模式仅以「已登录」为前提：
 * - 未登录 → 返回 0 保留队列（登录成功后再 flush）。
 * - 网络不可达（'none'）→ 返回 0 保留队列（onNetworkStatusChange 恢复联网后再 flush）。
 * - 可达且已登录 → 逐条重放真实 /api/v1/me/* CRUD。
 */
export async function flushLocalOperations(): Promise<number> {
  const config = getRuntimeConfig()
  let ids = readIds()
  if (ids.length === 0) return 0
  // 远程模式未登录：保留队列，不消耗任何计数
  if (config.mode === DATA_MODE_REMOTE && getAccessToken() === '') return 0
  // 网络不可达（飞行模式/断网）：安静返回 0 保留队列
  if (!(await isNetworkAvailable())) return 0
  // 预清扫：长期离线从未触发 flush 时，先淘汰超期/重试超限操作（移入存档），避免一次性全量重读
  const swept: string[] = []
  for (let i = 0; i < ids.length; i++) {
    const op = readOperation(ids[i])
    if (shouldDrop(op)) dropOperation(op, op.retryCount >= MAX_RETRY ? 'max_retry' : 'ttl_expired')
    else swept.push(ids[i])
  }
  if (swept.length !== ids.length) { ids = swept; writeIds(ids) }
  if (ids.length === 0) return 0
  // 远程模式（当前唯一运行模式）：真实重放；401 中止时队列状态已由 flushRemote 持久化
  return await flushRemote(ids)
}
export function getLastSyncAt(): string { return readString('v21_sync_last_success_at') }
