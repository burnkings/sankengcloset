import { SyncOperation, SYNC_PENDING, SYNC_FAILED } from '@/domain/sync/sync-operation'
import { DATA_MODE_REMOTE, getRuntimeConfig, getAccessToken } from '@/config/runtime'
import { apiPostAuthorized, apiPatchAuthorized, apiDeleteAuthorized, apiPutAuthorized } from '@/services/platform/api-client'
import { encodeQuery } from '@/services/platform/api-client'
import { listWishlistRemote } from '@/services/user-data/user-data-service'

const QUEUE_IDS_KEY = 'v21_sync_queue_ids'
const PREFIX = 'v21_sync_op_'
const DEVICE_KEY = 'v21_device_id'

function readString(key: string): string {
  try { const value = uni.getStorageSync(key); return value == null ? '' : value as string } catch (e) { return '' }
}
function readIds(): string[] { const raw = readString(QUEUE_IDS_KEY); return raw === '' ? [] : raw.split(',').filter((id) => id !== '') }
function writeIds(ids: string[]): boolean {
  try { uni.setStorageSync(QUEUE_IDS_KEY, ids.join(',')); return true } catch (e) { return false }
}
function key(id: string, field: string): string { return `${PREFIX}${id}_${field}` }
function writeOperation(op: SyncOperation): boolean {
  try {
    uni.setStorageSync(key(op.opId, 'user'), op.userId); uni.setStorageSync(key(op.opId, 'device'), op.deviceId)
    uni.setStorageSync(key(op.opId, 'entity_type'), op.entityType); uni.setStorageSync(key(op.opId, 'entity_id'), op.entityId)
    uni.setStorageSync(key(op.opId, 'action'), op.action); uni.setStorageSync(key(op.opId, 'payload'), op.payload)
    uni.setStorageSync(key(op.opId, 'created_at'), op.createdAt); uni.setStorageSync(key(op.opId, 'retry'), op.retryCount.toString())
    uni.setStorageSync(key(op.opId, 'status'), op.status)
    return true
  } catch (e) {
    return false
  }
}
function readOperation(id: string): SyncOperation {
  const op = new SyncOperation(); op.opId = id; op.userId = readString(key(id, 'user')); op.deviceId = readString(key(id, 'device'))
  op.entityType = readString(key(id, 'entity_type')); op.entityId = readString(key(id, 'entity_id')); op.action = readString(key(id, 'action'))
  op.payload = readString(key(id, 'payload')); op.createdAt = readString(key(id, 'created_at'))
  const retryRaw = parseInt(readString(key(id, 'retry')))
  op.retryCount = isNaN(retryRaw) ? 0 : retryRaw
  const statusRaw = readString(key(id, 'status'))
  op.status = statusRaw === '' ? SYNC_PENDING : statusRaw
  return op
}
function removeOperation(id: string) {
  const fields = ['user','device','entity_type','entity_id','action','payload','created_at','retry','status']
  for (let i = 0; i < fields.length; i++) { try { uni.removeStorageSync(key(id, fields[i])) } catch (e) {} }
}
function safePayload(value: string): string { if (value === '' || value.charAt(0) !== '{') return JSON.stringify({ value }); try { JSON.parse(value); return value } catch (e) { return JSON.stringify({ value }) } }

export function getCurrentSyncUserId(): string { const saved = readString('v21_session_user_id'); return saved !== '' ? saved : 'guest_local' }
export function getOrCreateDeviceId(): string { const saved = readString(DEVICE_KEY); if (saved !== '') return saved; const id = `device_${Date.now()}_${Math.floor(Math.random() * 10000)}`; uni.setStorageSync(DEVICE_KEY, id); return id }
export function enqueueLocalOperation(userId: string, entityType: string, entityId: string, action: string, payload: string): string {
  const op = new SyncOperation(); op.opId = `op_${Date.now()}_${Math.floor(Math.random() * 10000)}`; op.userId = userId; op.deviceId = getOrCreateDeviceId()
  op.entityType = entityType; op.entityId = entityId; op.action = action; op.payload = safePayload(payload); op.createdAt = Date.now().toString(); op.status = SYNC_PENDING
  if (!writeOperation(op)) return ''
  const ids = readIds(); ids.push(op.opId)
  if (!writeIds(ids)) { removeOperation(op.opId); return '' }
  return op.opId
}
export function readPendingOperations(): SyncOperation[] { const ids = readIds(); const result: SyncOperation[] = []; for (let i = 0; i < ids.length; i++) result.push(readOperation(ids[i])); return result }

/**
 * 收藏（favorite）操作重放：直接作用于 /api/v1/wishlist 真实业务端点。
 * - create/upsert：POST 创建条目（status 必填 'WISH'，productId 关联商品）。
 * - delete：按 productId 查服务端条目后 DELETE（幂等：不存在视为已删除）。
 */
async function replayFavorite(op: SyncOperation): Promise<boolean> {
  try {
    const payload = safePayload(op.payload)
    if (op.action == 'delete') {
      let productId = op.entityId
      if (payload != '' && payload != '{}') {
        const body = JSON.parse(payload) as UTSJSONObject
        if (body['productId'] != null && body['productId'] as string != '') productId = body['productId'] as string
      }
      const items = await listWishlistRemote()
      for (let i = 0; i < items.length; i++) {
        const raw = items[i]
        if (raw['productId'] != null && raw['productId'] as string == productId) {
          const itemId = raw['id'] != null ? raw['id'] as string : ''
          if (itemId != '') await apiDeleteAuthorized('/api/v1/wishlist/' + encodeQuery(itemId))
          return true
        }
      }
      return true
    }
    const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
    const productId = body['productId'] != null ? body['productId'] as string : op.entityId
    const title = body['title'] != null ? body['title'] as string : productId
    if (productId == '') return false
    await apiPostAuthorized('/api/v1/wishlist', { title, status: 'WISH', productId } as UTSJSONObject)
    return true
  } catch (e) {
    return false
  }
}

/**
 * 逐条重放一个操作到真实业务端点（依据后端实际能力）：
 * - 后端 /api/v1/sync/operations:batch 仅写入 sync_operations 审计表、不应用业务数据，
 *   因此离线期间入队的操作必须在恢复后重放真实的 /api/v1/me/* CRUD 端点。
 * - 支持实体：reminder / wardrobe_item / wishlist_item / purchase / favorite（真实 CRUD 重放）。
 * - 其余实体（outfit 缺图、post_like 等）不在此自动重放，保持队列等待后续扩展。
 * @returns true 重放成功；false 失败（保留队列）
 */
async function replayOperation(op: SyncOperation): Promise<boolean> {
  if (op.entityType == 'favorite') return await replayFavorite(op)
  let path = ''
  if (op.entityType == 'reminder') path = '/api/v1/me/reminders'
  else if (op.entityType == 'wardrobe_item') path = '/api/v1/me/wardrobe'
  else if (op.entityType == 'wishlist_item') path = '/api/v1/me/wishes'
  else if (op.entityType == 'purchase') path = '/api/v1/me/purchases'
  else return false // 暂不支持自动重放的实体：保留队列，不阻塞其他操作

  try {
    if (op.action == 'create' || op.action == 'upsert' || op.action == 'import') {
      const payload = safePayload(op.payload)
      const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
      await apiPostAuthorized(path, body)
      return true
    }
    if (op.action == 'delete') {
      await apiDeleteAuthorized(path + '/' + encodeQuery(op.entityId))
      return true
    }
    // update / 状态动作：PATCH 部分字段
    const payload = safePayload(op.payload)
    const body = payload != '' ? JSON.parse(payload) as UTSJSONObject : {} as UTSJSONObject
    await apiPatchAuthorized(path + '/' + encodeQuery(op.entityId), body)
    return true
  } catch (e) {
    return false
  }
}

/**
 * 冲刷队列：逐条重放真实 CRUD；成功移除，失败保留并标记 SYNC_FAILED。
 * 返回成功条数。
 */
async function flushRemote(ids: string[]): Promise<number> {
  if (getAccessToken() === '') throw new Error('请先登录远程体验账号')
  const remaining: string[] = []
  let acceptedCount = 0
  for (let i = 0; i < ids.length; i++) {
    const op = readOperation(ids[i])
    const ok = await replayOperation(op)
    if (ok) {
      removeOperation(ids[i])
      acceptedCount++
    } else {
      op.status = SYNC_FAILED
      op.retryCount += 1
      writeOperation(op)
      remaining.push(ids[i])
    }
  }
  writeIds(remaining)
  if (acceptedCount > 0) { try { uni.setStorageSync('v21_sync_last_success_at', Date.now().toString()) } catch (e) {} }
  return acceptedCount
}

export async function flushLocalOperations(): Promise<number> {
  const config = getRuntimeConfig(); const ids = readIds(); if (ids.length === 0) return 0
  try {
    if (config.mode === DATA_MODE_REMOTE) return await flushRemote(ids)
    if (!config.mockOnline) throw new Error('当前为离线模拟，操作已保留')
    await new Promise<void>((resolve) => { setTimeout(() => { resolve() }, config.mockLatencyMs) })
    for (let i = 0; i < ids.length; i++) removeOperation(ids[i]); writeIds([]); uni.setStorageSync('v21_sync_last_success_at', Date.now().toString()); return ids.length
  } catch (e) {
    for (let i = 0; i < ids.length; i++) { const op = readOperation(ids[i]); op.status = SYNC_FAILED; op.retryCount += 1; writeOperation(op) }
    throw e
  }
}
export function getLastSyncAt(): string { return readString('v21_sync_last_success_at') }
