import { SyncOperation, SYNC_PENDING, SYNC_FAILED } from '@/domain/sync/sync-operation'
import { DATA_MODE_REMOTE, getRuntimeConfig, getAccessToken } from '@/config/runtime'
import { apiPostAuthorized } from '@/services/platform/api-client'

const QUEUE_IDS_KEY = 'v21_sync_queue_ids'
const PREFIX = 'v21_sync_op_'
const DEVICE_KEY = 'v21_device_id'

function readString(key: string): string {
  try { const value = uni.getStorageSync(key); return value == null ? '' : String(value) } catch (e) { return '' }
}
function readIds(): string[] { const raw = readString(QUEUE_IDS_KEY); return raw === '' ? [] : raw.split(',').filter((id) => id !== '') }
function writeIds(ids: string[]) { uni.setStorageSync(QUEUE_IDS_KEY, ids.join(',')) }
function key(id: string, field: string): string { return `${PREFIX}${id}_${field}` }
function writeOperation(op: SyncOperation) {
  uni.setStorageSync(key(op.opId, 'user'), op.userId); uni.setStorageSync(key(op.opId, 'device'), op.deviceId)
  uni.setStorageSync(key(op.opId, 'entity_type'), op.entityType); uni.setStorageSync(key(op.opId, 'entity_id'), op.entityId)
  uni.setStorageSync(key(op.opId, 'action'), op.action); uni.setStorageSync(key(op.opId, 'payload'), op.payload)
  uni.setStorageSync(key(op.opId, 'created_at'), op.createdAt); uni.setStorageSync(key(op.opId, 'retry'), String(op.retryCount))
  uni.setStorageSync(key(op.opId, 'status'), op.status)
}
function readOperation(id: string): SyncOperation {
  const op = new SyncOperation(); op.opId = id; op.userId = readString(key(id, 'user')); op.deviceId = readString(key(id, 'device'))
  op.entityType = readString(key(id, 'entity_type')); op.entityId = readString(key(id, 'entity_id')); op.action = readString(key(id, 'action'))
  op.payload = readString(key(id, 'payload')); op.createdAt = readString(key(id, 'created_at')); op.retryCount = parseInt(readString(key(id, 'retry'))) ?? 0
  op.status = readString(key(id, 'status')) ?? SYNC_PENDING; return op
}
function removeOperation(id: string) { const fields = ['user','device','entity_type','entity_id','action','payload','created_at','retry','status']; for (let i = 0; i < fields.length; i++) uni.removeStorageSync(key(id, fields[i])) }
function safePayload(value: string): string { if (value === '' || value.charAt(0) !== '{') return JSON.stringify({ value }); try { JSON.parse(value); return value } catch (e) { return JSON.stringify({ value }) } }

export function getCurrentSyncUserId(): string { const saved = readString('v21_session_user_id'); return saved !== '' ? saved : 'guest_local' }
export function getOrCreateDeviceId(): string { const saved = readString(DEVICE_KEY); if (saved !== '') return saved; const id = `device_${Date.now()}_${Math.floor(Math.random() * 10000)}`; uni.setStorageSync(DEVICE_KEY, id); return id }
export function enqueueLocalOperation(userId: string, entityType: string, entityId: string, action: string, payload: string): string {
  const op = new SyncOperation(); op.opId = `op_${Date.now()}_${Math.floor(Math.random() * 10000)}`; op.userId = userId; op.deviceId = getOrCreateDeviceId()
  op.entityType = entityType; op.entityId = entityId; op.action = action; op.payload = safePayload(payload); op.createdAt = String(Date.now()); op.status = SYNC_PENDING
  writeOperation(op); const ids = readIds(); ids.push(op.opId); writeIds(ids); return op.opId
}
export function readPendingOperations(): SyncOperation[] { const ids = readIds(); const result: SyncOperation[] = []; for (let i = 0; i < ids.length; i++) result.push(readOperation(ids[i])); return result }

async function flushRemote(ids: string[]): Promise<number> {
  if (getAccessToken() === '') throw new Error('请先登录远程体验账号')
  const operations: any[] = []
  for (let i = 0; i < ids.length; i++) {
    const op = readOperation(ids[i])
    operations.push({ opId: op.opId, deviceId: op.deviceId, entityType: op.entityType, entityId: op.entityId, action: op.action === 'migrate' ? 'import' : op.action, payload: safePayload(op.payload), createdAt: op.createdAt })
  }
  const response = await apiPostAuthorized('/api/v1/sync/operations:batch', { operations })
  const data = response.data as any
  const receipts = data != null ? data.receipts as any[] : []
  const accepted: string[] = []
  if (receipts != null) for (let i = 0; i < receipts.length; i++) if (receipts[i].result === 'accepted') accepted.push(String(receipts[i].opId))
  const remaining: string[] = []
  for (let i = 0; i < ids.length; i++) { if (accepted.indexOf(ids[i]) >= 0) removeOperation(ids[i]); else remaining.push(ids[i]) }
  writeIds(remaining)
  if (accepted.length > 0) uni.setStorageSync('v21_sync_last_success_at', String(Date.now()))
  return accepted.length
}

export async function flushLocalOperations(): Promise<number> {
  const config = getRuntimeConfig(); const ids = readIds(); if (ids.length === 0) return 0
  try {
    if (config.mode === DATA_MODE_REMOTE) return await flushRemote(ids)
    if (!config.mockOnline) throw new Error('当前为离线模拟，操作已保留')
    await new Promise<void>((resolve) => { setTimeout(() => { resolve() }, config.mockLatencyMs) })
    for (let i = 0; i < ids.length; i++) removeOperation(ids[i]); writeIds([]); uni.setStorageSync('v21_sync_last_success_at', String(Date.now())); return ids.length
  } catch (e) {
    for (let i = 0; i < ids.length; i++) { const op = readOperation(ids[i]); op.status = SYNC_FAILED; op.retryCount += 1; writeOperation(op) }
    throw e
  }
}
export function getLastSyncAt(): string { return readString('v21_sync_last_success_at') }
