import { ApiResponse, apiGet, apiGetAuthorized, apiPostAuthorized, apiPutAuthorized, apiPatchAuthorized, apiDeleteAuthorized, encodeQuery, apiUploadBinary, apiErrorStatus, readFileAsArrayBuffer, resolveApiUrl } from '@/services/platform/api-client'

function asObject(value: any): UTSJSONObject | null {
  return value != null ? value as UTSJSONObject : null
}

function asString(value: any): string { return value != null ? value as string : '' }
function asNumber(value: any): number { return value != null ? value as number : 0 }
function asBoolean(value: any): boolean { return value == true }

export class CommunityPostRemote {
  id: string = ''
  authorUserId: string = ''
  authorNickname: string = ''
  /** 作者头像地址（空 = 作者未设头像，卡片回退文字首字） */
  authorAvatarUrl: string = ''
  mediaId: string = ''
  imageUrl: string = ''
  /** 全部图片的 mediaId（顺序即展示顺序，第 0 张 = 封面）。老数据为空数组 */
  mediaIds: string[] = []
  /** 全部图片的可展示地址，与 mediaIds 一一对应；老数据为空数组 */
  imageUrls: string[] = []
  caption: string = ''
  category: string = ''
  topic: string = ''
  likeCount: number = 0
  liked: boolean = false
  /** Phase 2.3-A：关联商品 id（空 = 普通内容） */
  productId: string = ''
  /** 'public' | 'private'（仅自己可见）。老数据/未返回时按 public 处理 */
  visibility: string = 'public'
  createdAt: string = ''
  updatedAt: string = ''
}

/** 把一组后端相对地址整体补成绝对地址（见 resolveApiUrl 的说明） */
function resolveApiUrlList(values: string[]): string[] {
  const result: string[] = []
  for (let i = 0; i < values.length; i++) result.push(resolveApiUrl(values[i]))
  return result
}

function asStringArray(value: any): string[] {
  const result: string[] = []
  if (value == null) return result
  const list = value as any[]
  if (list == null) return result
  for (let i = 0; i < list.length; i++) {
    const item = list[i]
    if (item == null) continue
    const text = item as string
    if (text != '') result.push(text)
  }
  return result
}

export class CommunityPostPageRemote {
  items: CommunityPostRemote[] = []
  nextCursor: string = ''
  hasMore: boolean = false
}

export function mapCommunityPost(raw: UTSJSONObject): CommunityPostRemote {
  const post = new CommunityPostRemote()
  post.id = asString(raw['id'])
  post.authorUserId = asString(raw['authorUserId'])
  post.authorNickname = asString(raw['authorNickname'])
  post.authorAvatarUrl = resolveApiUrl(asString(raw['authorAvatarUrl']))
  post.mediaId = asString(raw['mediaId'])
  // 后端给的是相对路径（/api/v1/media/<id>），必须补成绝对地址才能被 <image> 加载
  post.imageUrl = resolveApiUrl(asString(raw['imageUrl']))
  post.mediaIds = asStringArray(raw['mediaIds'])
  post.imageUrls = resolveApiUrlList(asStringArray(raw['imageUrls']))
  post.caption = asString(raw['caption'])
  post.category = asString(raw['category'])
  post.topic = asString(raw['topic'])
  post.likeCount = asNumber(raw['likeCount'])
  post.liked = asBoolean(raw['liked'])
  post.productId = asString(raw['productId'])
  post.visibility = asString(raw['visibility']) != '' ? asString(raw['visibility']) : 'public'
  post.createdAt = asString(raw['createdAt'])
  post.updatedAt = asString(raw['updatedAt'])
  return post
}

async function listAsset(path: string): Promise<UTSJSONObject[]> {
  const response = await apiGetAuthorized('/api/v1/me/' + path)
  const values = response.data as any[] | null
  const result = [] as UTSJSONObject[]
  if (values != null) for (let i = 0; i < values.length; i++) {
    const value = asObject(values[i])
    if (value != null) result.push(value)
  }
  return result
}

export function listWardrobeRemote(): Promise<UTSJSONObject[]> { return listAsset('wardrobe') }
export function listPurchasesRemote(): Promise<UTSJSONObject[]> { return listAsset('purchases') }
export function listRemindersRemote(): Promise<UTSJSONObject[]> { return listAsset('reminders') }
export function listWishesRemote(): Promise<UTSJSONObject[]> { return listAsset('wishes') }
export function listNotificationsRemote(): Promise<UTSJSONObject[]> { return listAsset('notifications') }
export function generateNotificationsRemote() { return apiPostAuthorized('/api/v1/me/notifications:generate', {} as UTSJSONObject) }
export function markNotificationReadRemote(id: string) { return patchAssetRemote('notifications', id, { read: true } as UTSJSONObject) }

export function createAssetRemote(path: string, payload: UTSJSONObject) { return apiPostAuthorized('/api/v1/me/' + path, payload) }
export function patchAssetRemote(path: string, id: string, payload: UTSJSONObject) { return apiPatchAuthorized('/api/v1/me/' + path + '/' + encodeQuery(id), payload) }
export function deleteAssetRemote(path: string, id: string) { return apiDeleteAuthorized('/api/v1/me/' + path + '/' + encodeQuery(id)) }

export async function loadBudgetRemote(): Promise<UTSJSONObject> {
  const response = await apiGetAuthorized('/api/v1/me/budget')
  return asObject(response.data) ?? {} as UTSJSONObject
}
export function saveBudgetRemote(payload: UTSJSONObject) { return apiPutAuthorized('/api/v1/me/budget', payload) }

export async function loadPreferencesRemote(): Promise<UTSJSONObject> {
  const response = await apiGetAuthorized('/api/v1/me/preferences')
  return asObject(response.data) ?? {} as UTSJSONObject
}
export function savePreferencesRemote(payload: UTSJSONObject) { return apiPutAuthorized('/api/v1/me/preferences', payload) }

export async function listCommunityPostPageRemote(cursor: string = '', category: string = '', topic: string = '', mine: boolean = false): Promise<CommunityPostPageRemote> {
  const root = mine ? '/api/v1/me/community/posts' : '/api/v1/community/posts'
  // 只传有值的参数：cursor 空不传、category/topic 空不传；limit 由后端默认 20
  let path = root
  let hasQuery = false
  if (cursor != '') { path += '?cursor=' + encodeQuery(cursor); hasQuery = true }
  if (!mine && category != '') { path += (hasQuery ? '&' : '?') + 'category=' + encodeQuery(category); hasQuery = true }
  if (!mine && topic != '') { path += (hasQuery ? '&' : '?') + 'topic=' + encodeQuery(topic); hasQuery = true }
  // 公开帖子允许匿名读取；我的发布必须认证（401 自动刷新重试）
  const response = mine ? await apiGetAuthorized(path) : await apiGet(path)
  const values = response.data as any[] | null
  const result = new CommunityPostPageRemote()
  if (values != null) for (let i = 0; i < values.length; i++) {
    const value = asObject(values[i])
    if (value != null) result.items.push(mapCommunityPost(value))
  }
  const page = asObject(response.page)
  result.nextCursor = page != null ? asString(page['nextCursor']) : ''
  result.hasMore = page != null && asBoolean(page['hasMore'])
  return result
}

export async function listCommunityPostsRemote(cursor: string = '', category: string = '', topic: string = '', mine: boolean = false): Promise<CommunityPostRemote[]> {
  const page = await listCommunityPostPageRemote(cursor, category, topic, mine)
  return page.items
}

export async function fetchCommunityPostRemote(id: string): Promise<CommunityPostRemote> {
  const response = await apiGet('/api/v1/community/posts/' + encodeQuery(id))
  const data = asObject(response.data)
  if (data == null) throw new Error('动态不存在')
  return mapCommunityPost(data)
}

export function setCommunityPostLikeRemote(id: string, liked: boolean) {
  return apiPutAuthorized('/api/v1/community/posts/' + encodeQuery(id) + '/like', { liked })
}
export function deleteCommunityPostRemote(id: string) {
  return apiDeleteAuthorized('/api/v1/community/posts/' + encodeQuery(id))
}

// ─── 品牌关注 ──────────────────────────────────────────────

/** 关注品牌（POST /api/v1/brands/follow） */
export function followBrandRemote(brandName: string) {
  return apiPostAuthorized('/api/v1/brands/follow', { brandId: brandName })
}

/** 取消关注品牌（DELETE /api/v1/brands/:brandId/follow） */
export function unfollowBrandRemote(brandName: string) {
  return apiDeleteAuthorized('/api/v1/brands/' + encodeQuery(brandName) + '/follow')
}

/** 拉取已关注品牌列表（GET /api/v1/brands/followed） */
export async function listFollowedBrandsRemote(): Promise<string[]> {
  const response = await apiGetAuthorized('/api/v1/brands/followed')
  const values = response.data as any[] | null
  const result = [] as string[]
  if (values != null) for (let i = 0; i < values.length; i++) {
    const value = values[i]
    const name = value != null ? value as string : ''
    if (name != '') result.push(name)
  }
  return result
}

// ─── 圈子发帖 + 图片上传 ───────────────────────────────────

// ─── 心动收藏（user_interactions PRODUCT_FAVORITE，替代旧 wishlist_items 表）────────────────

/** 拉取当前用户收藏列表（user_interactions PRODUCT_FAVORITE，含 id/title/productId/status） */
export async function listWishlistRemote(): Promise<UTSJSONObject[]> {
  const response = await apiGetAuthorized('/api/v1/wishlist')
  const values = response.data as any[] | null
  const result = [] as UTSJSONObject[]
  if (values != null) for (let i = 0; i < values.length; i++) {
    const value = asObject(values[i])
    if (value != null) result.push(value)
  }
  return result
}

/**
 * 添加收藏（POST /api/v1/wishlist，status 必填）。返回新条目 id；失败抛错由调用方入队兜底。
 * status: WISH(收藏) / WANT(想买) / WATCHING / WAIT_RELEASE(等待开售) / WAIT_BALANCE(等待尾款) / PURCHASED
 * releaseId: 用户当前关注的发售批次（user_interactions PRODUCT_FAVORITE.release_id，后端已支持；空串不传）
 */
export async function addWishlistRemote(productId: string, title: string, status: string = 'WISH', releaseId: string = ''): Promise<string> {
  const payload = { title, status, productId } as UTSJSONObject
  if (releaseId !== '') payload['releaseId'] = releaseId
  const response = await apiPostAuthorized('/api/v1/wishlist', payload)
  const data = asObject(response.data)
  return data != null && data['id'] != null ? data['id'] as string : ''
}

/** 更新收藏状态（PATCH /api/v1/wishlist/:id，后端校验 WishlistStatus 枚举） */
export function updateWishlistStatusRemote(itemId: string, status: string) {
  return apiPatchAuthorized('/api/v1/wishlist/' + encodeQuery(itemId), { status } as UTSJSONObject)
}

/** 取消收藏（DELETE /api/v1/wishlist/:id） */
export function deleteWishlistRemote(itemId: string) {
  return apiDeleteAuthorized('/api/v1/wishlist/' + encodeQuery(itemId))
}

/** 创建帖子（POST /api/v1/community/posts），mediaId 来自上传返回 */
export function createCommunityPostRemote(payload: UTSJSONObject) {
  return apiPostAuthorized('/api/v1/community/posts', payload)
}

/** 由本地路径推断上传用的 content-type（后端 prepareSchema 只放行这三种） */
export function imageContentType(localPath: string): string {
  return localPath.endsWith('.png') ? 'image/png' : localPath.endsWith('.webp') ? 'image/webp' : 'image/jpeg'
}

/**
 * 上传图片并返回 mediaId（通用：圈子穿搭图 / 头像都走这一条）。
 * 流程：POST /api/v1/uploads:prepare（purpose）→ PUT content（原始二进制）
 */
export async function uploadImageRemote(localPath: string, purpose: string): Promise<string> {
  const binary = await readFileAsArrayBuffer(localPath)
  if (binary.byteLength === 0) throw new Error('图片为空，请重新选择图片')
  const contentType = imageContentType(localPath)
  const prepared = await apiPostAuthorized('/api/v1/uploads:prepare', { purpose: purpose, contentType: contentType })
  const preparedData = asObject(prepared.data)
  if (preparedData == null || preparedData['uploadId'] == null || preparedData['mediaId'] == null) {
    throw new Error('上传准备失败，请重试')
  }
  const uploadId = preparedData['uploadId'] as string
  const mediaId = preparedData['mediaId'] as string
  try {
    await apiUploadBinary('/api/v1/uploads/' + encodeQuery(uploadId) + '/content', binary, contentType)
  } catch (e) {
    if (apiErrorStatus(e) === 413) throw new Error('图片超过服务端当前大小限制，请选择较小图片')
    throw e
  }
  return mediaId
}

/** 上传圈子穿搭图（保留旧签名，调用方零改动） */
export function uploadOutfitImageRemote(localPath: string): Promise<string> {
  return uploadImageRemote(localPath, 'outfit')
}

/** 上传头像图，返回可用于 PATCH /api/v1/me 的 mediaId */
export function uploadAvatarImageRemote(localPath: string): Promise<string> {
  return uploadImageRemote(localPath, 'avatar')
}

/**
 * 上传反馈/举报的截图，返回**运营可直接打开的公开地址**。
 *
 * 为什么返回完整地址而不是 mediaId：反馈与举报的附件是给运营看的（飞书通知里点开），
 * 运营不在 App 里，拿不到 mediaId → 必须给可直接访问的 URL。
 * 服务端把 `feedback` 用途归到公开可读组（否则 `GET /api/v1/media/:id` 会 404）。
 */
export async function uploadFeedbackImageRemote(localPath: string): Promise<string> {
  const mediaId = await uploadImageRemote(localPath, 'feedback')
  return resolveApiUrl('/api/v1/media/' + encodeQuery(mediaId))
}

/**
 * 更新个人资料（PATCH /api/v1/me）。
 * 只传要改的字段：nickname 非空才带；avatarMediaId 非空才带（空串表示清空头像）。
 * 返回服务端回带的资料（含重新拼好的绝对 avatarUrl），失败返回 null。
 */
export async function updateProfileRemote(nickname: string, avatarMediaId: string): Promise<UTSJSONObject | null> {
  const payload = {} as UTSJSONObject
  const name = nickname.trim()
  if (name !== '') payload['nickname'] = name
  if (avatarMediaId !== '') payload['avatarMediaId'] = avatarMediaId
  if (name === '' && avatarMediaId === '') return null
  const response = await apiPatchAuthorized('/api/v1/me', payload)
  return asObject(response.data)
}

/**
 * 注销账号（POST /api/v1/me/deactivate）。
 *
 * 服务端会删掉这个用户的全部个人数据（动态/收藏/衣柜/订单/提醒/上传的文件）并删除账号，
 * 反馈与举报记录**匿名化保留**（去掉 user_id，内容作为审核历史留下）。
 * 这是不可逆操作，调用方必须先做二次确认。
 */
export function deactivateAccountRemote(): Promise<ApiResponse> {
  return apiPostAuthorized('/api/v1/me/deactivate', {} as UTSJSONObject)
}

/** 读取当前账号资料（GET /api/v1/me），未登录/失败返回 null */
export async function fetchProfileRemote(): Promise<UTSJSONObject | null> {
  try {
    const response = await apiGetAuthorized('/api/v1/me')
    return asObject(response.data)
  } catch (_) {
    return null
  }
}
