import { getRuntimeConfig, getCachedAccessToken, getCachedRefreshToken, saveSessionTokens } from '@/config/runtime'

export class ApiResponse {
  data: any | null = null
  page: any | null = null
  requestId: string = ''
  statusCode: number = 0
}

class ApiRequestError extends Error {
  statusCode: number = 0
  constructor(message: string, statusCode: number) {
    super(message)
    this.statusCode = statusCode
  }
}

const FALLBACK_API_BASE = 'https://api.sankengcloset.icu'

function endpoint(path: string): string {
  const runtimeBase = getRuntimeConfig().apiBaseUrl
  const base = runtimeBase !== '' ? runtimeBase : FALLBACK_API_BASE
  return `${base}${path.startsWith('/') ? path : '/' + path}`
}

function headers(): UTSJSONObject {
  const result = { 'content-type': 'application/json' } as UTSJSONObject
  const token = getCachedAccessToken()
  if (token !== '') result['authorization'] = `Bearer ${token}`
  return result
}

function parseResponse(statusCode: number, raw: UTSJSONObject | null): ApiResponse {
  if (statusCode < 200 || statusCode >= 300) {
    const problem = raw != null ? raw['error'] : null
    const problemObj = problem != null ? problem as UTSJSONObject : null
    const message = problemObj != null && problemObj['message'] != null ? problemObj['message'] as string : `服务请求失败（${statusCode}）`
    throw new ApiRequestError(message, statusCode)
  }
  const response = new ApiResponse()
  response.statusCode = statusCode
  response.requestId = raw != null && raw['requestId'] != null ? raw['requestId'] as string : ''
  response.data = raw != null && raw['data'] != null ? raw['data'] : raw
  response.page = raw != null && raw['page'] != null ? raw['page'] : null
  return response
}

export function apiGet(path: string): Promise<ApiResponse> {
  return new Promise<ApiResponse>((resolve, reject) => {
    let url = ''
    try { url = endpoint(path) } catch (e) { reject(e); return }
    uni.request<UTSJSONObject>({
      url,
      method: 'GET',
      header: headers(),
      timeout: 12000,
      success: (res: RequestSuccess<UTSJSONObject>) => {
        try { resolve(parseResponse(res.statusCode, res.data)) }
        catch (e) { reject(e) }
      },
      fail: (error: RequestFail) => reject(new Error(error.errMsg)),
    })
  })
}

export function apiPost(path: string, payload: any): Promise<ApiResponse> {
  return new Promise<ApiResponse>((resolve, reject) => {
    let url = ''
    try { url = endpoint(path) } catch (e) { reject(e); return }
    uni.request<UTSJSONObject>({
      url,
      method: 'POST',
      header: headers(),
      data: payload,
      timeout: 15000,
      success: (res: RequestSuccess<UTSJSONObject>) => {
        try { resolve(parseResponse(res.statusCode, res.data)) }
        catch (e) { reject(e) }
      },
      fail: (error: RequestFail) => reject(new Error(error.errMsg)),
    })
  })
}

export function apiDelete(path: string): Promise<ApiResponse> {
  return new Promise<ApiResponse>((resolve, reject) => {
    let url = ''
    try { url = endpoint(path) } catch (e) { reject(e); return }
    uni.request<UTSJSONObject>({
      url,
      method: 'DELETE',
      header: headers(),
      timeout: 12000,
      success: (res: RequestSuccess<UTSJSONObject>) => {
        try { resolve(parseResponse(res.statusCode, res.data)) }
        catch (e) { reject(e) }
      },
      fail: (error: RequestFail) => reject(new Error(error.errMsg)),
    })
  })
}

function apiMutation(path: string, method: string, payload: any): Promise<ApiResponse> {
  return new Promise<ApiResponse>((resolve, reject) => {
    let url = ''
    try { url = endpoint(path) } catch (e) { reject(e); return }
    uni.request<UTSJSONObject>({
      url,
      method,
      header: headers(),
      data: payload,
      timeout: 15000,
      success: (res: RequestSuccess<UTSJSONObject>) => {
        try { resolve(parseResponse(res.statusCode, res.data)) }
        catch (e) { reject(e) }
      },
      fail: (error: RequestFail) => reject(new Error(error.errMsg)),
    })
  })
}

export function apiPut(path: string, payload: any): Promise<ApiResponse> { return apiMutation(path, 'PUT', payload) }
export function apiPatch(path: string, payload: any): Promise<ApiResponse> { return apiMutation(path, 'PATCH', payload) }

export function encodeQuery(value: string): string {
  const encoded = encodeURIComponent(value)
  return encoded != null ? encoded : value
}

// ====== 401 刷新令牌：单飞锁 ======
// 多个并发请求同时 401 时，只发起一次 refresh，其余请求等待同一个刷新 Promise。

let _refreshInFlight: Promise<boolean> | null = null

async function refreshWithSingleFlight(): Promise<boolean> {
  const inFlight = _refreshInFlight
  if (inFlight != null) return await inFlight
  const started = doRefreshRemoteSession()
  _refreshInFlight = started
  try {
    return await started
  } finally {
    _refreshInFlight = null
  }
}

async function doRefreshRemoteSession(): Promise<boolean> {
  const refreshToken = getCachedRefreshToken()
  if (refreshToken === '') return false
  try {
    const response = await apiPost('/api/v1/sessions/refresh', { refreshToken })
    const data = response.data != null ? response.data as UTSJSONObject : null
    if (data == null || data['accessToken'] == null) return false
    saveSessionTokens(data['accessToken'] as string, data['refreshToken'] != null ? data['refreshToken'] as string : refreshToken)
    return true
  } catch (e) {
    return false
  }
}

export async function refreshRemoteSession(): Promise<boolean> {
  return await refreshWithSingleFlight()
}

/**
 * 通用 Authorized 请求：401 时单飞刷新令牌并重试一次。
 * 所有需认证读取（/api/v1/me/*、/wishlist、/brands/followed 等）必须走此方法。
 */
type HttpMethod = 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE'
async function apiAuthorized(method: HttpMethod, path: string, payload?: any): Promise<ApiResponse> {
  try {
    if (method == 'GET') return await apiGet(path)
    if (method == 'DELETE') return await apiDelete(path)
    if (method == 'PUT') return await apiPut(path, payload)
    if (method == 'PATCH') return await apiPatch(path, payload)
    return await apiPost(path, payload)
  } catch (e) {
    if (e instanceof ApiRequestError && e.statusCode === 401 && (await refreshWithSingleFlight())) {
      if (method == 'GET') return await apiGet(path)
      if (method == 'DELETE') return await apiDelete(path)
      if (method == 'PUT') return await apiPut(path, payload)
      if (method == 'PATCH') return await apiPatch(path, payload)
      return await apiPost(path, payload)
    }
    throw e
  }
}

export function apiGetAuthorized(path: string): Promise<ApiResponse> { return apiAuthorized('GET', path) }

export function apiPostAuthorized(path: string, payload: any): Promise<ApiResponse> { return apiAuthorized('POST', path, payload) }

export function apiPutAuthorized(path: string, payload: any): Promise<ApiResponse> { return apiAuthorized('PUT', path, payload) }

export function apiPatchAuthorized(path: string, payload: any): Promise<ApiResponse> { return apiAuthorized('PATCH', path, payload) }

export function apiDeleteAuthorized(path: string): Promise<ApiResponse> { return apiAuthorized('DELETE', path) }

/**
 * 上传图片二进制（PUT 原始 body）。
 * 后端契约：POST /api/v1/uploads:prepare 拿 uploadId/uploadUrl → PUT /api/v1/uploads/:uploadId/content（原始二进制）
 */
export async function apiUploadBinary(path: string, data: ArrayBuffer, contentType: string): Promise<ApiResponse> {
  return new Promise<ApiResponse>((resolve, reject) => {
    let url = ''
    try { url = endpoint(path) } catch (e) { reject(e); return }
    uni.request<UTSJSONObject>({
      url,
      method: 'PUT',
      header: {
        'authorization': getCachedAccessToken() !== '' ? `Bearer ${getCachedAccessToken()}` : '',
        'content-type': contentType,
      },
      data,
      timeout: 30000,
      success: (res: RequestSuccess<UTSJSONObject>) => {
        try { resolve(parseResponse(res.statusCode, res.data)) }
        catch (e) { reject(e) }
      },
      fail: (error: RequestFail) => reject(new Error(error.errMsg)),
    })
  })
}

/** 读取本地图片为 ArrayBuffer（供上传用） */
export function readFileAsArrayBuffer(filePath: string): Promise<ArrayBuffer> {
  return new Promise<ArrayBuffer>((resolve, reject) => {
    // #ifdef APP
    const fs = uni.getFileSystemManager()
    fs.readFile({
      filePath,
      success: (res) => {
        const buf = res.data != null ? res.data as ArrayBuffer : null
        if (buf == null) { reject(new Error('读取图片失败')); return }
        resolve(buf)
      },
      fail: (error) => reject(new Error(error.errMsg != null ? error.errMsg : '读取图片失败')),
    })
    // #endif
    // #ifndef APP
    reject(new Error('当前平台不支持二进制上传'))
    // #endif
  })
}

export async function testApiConnection(): Promise<string> {
  const response = await apiGet('/health')
  const data = response.data != null ? response.data as UTSJSONObject : null
  if (data == null || data['status'] == null || data['status'] as string !== 'ok') throw new Error('服务健康检查未通过')
  return data['service'] != null ? data['service'] as string : 'sankengcloset-api'
}
