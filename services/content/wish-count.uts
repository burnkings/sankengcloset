/**
 * wish-count — 商品「收藏数」的本地增量
 *
 * 商品卡与商品详情都要显示收藏数。服务端返回的是**权威计数**（`user_interactions` 里
 * `PRODUCT_FAVORITE` 的条数，随商品一起下发），但用户点了爱心之后：
 *   · 重新拉一次列表太贵（为了一个数字刷新整页）；
 *   · 只在详情页加一、列表里不变，会出现「同一个商品两处数字不一样」。
 *
 * 所以这里放一层**本机增量**：点一次记 +1/-1，读取时把增量加到服务端计数上。
 * 任何列表、任何入口取数都走 `wishCountOf()`，因此天然一致；下一次真实拉取会用服务端值覆盖。
 *
 * 只放内存（不落盘）：它表示的是"这次会话里尚未由服务端确认的偏差"，重启后归零、
 * 由服务端计数兜底，正是想要的语义。
 */

/** productId -> 未同步的收藏数增量 */
const deltas = new Map<string, number>()

/** 收藏/取消收藏后调用：delta 传 +1 / -1 */
export function bumpWishCount(productId: string, delta: number): void {
  if (productId === '' || delta === 0) return
  deltas.set(productId, (deltas.get(productId) ?? 0) + delta)
}

/** 展示用：服务端计数 + 本机增量，且不小于 0（避免服务端还没确认时出现负数） */
export function wishCountOf(productId: string, serverCount: number): number {
  const delta = productId === '' ? 0 : (deltas.get(productId) ?? 0)
  const total = serverCount + delta
  return total < 0 ? 0 : total
}

/** 拉到了新的服务端计数 → 该商品的本地增量可以清掉了（已经对齐） */
export function clearWishDelta(productId: string): void {
  deltas.delete(productId)
}

/**
 * 服务端**已确认该商品的收藏态**时清除本地增量（2026-10-09 评审 P2-2）。
 *
 * 与 `clearWishDelta` 的区别只在调用时机，语义上是同一个动作：只有当响应里带了
 * `saved`（说明这是「带登录态的一次真实拉取」，服务端计数必然已经把用户的收藏算进去了），
 * 本机那个尚未确认的 +1/-1 才是冗余的，清掉之后数字会收敛到权威值。
 *
 * 之前这件事做在 DTO 映射层（`mapFeedItem`），但映射层看到的是**缓存优先**的响应：
 * 未 force 的请求可能直接命中几秒前的快照，此时用户的收藏动作还没被服务端计入，
 * 清掉增量就会让刚点亮的爱心数字跳回旧值。把判断权上移到「明确知道服务端已经算过」的地方。
 */
export function clearWishDeltaAfterServerConfirm(productId: string, serverConfirmedSaved: boolean): void {
  if (!serverConfirmedSaved) return
  deltas.delete(productId)
}
