import { FeedItem } from '@/domain/content/feed-item'
import { createRequestId } from '@/domain/platform/api-contract'
import { apiGet, encodeQuery } from '@/services/platform/api-client'
import { clearWishDelta } from '@/services/content/wish-count'

export class FeedPage {
  items: FeedItem[] = []
  nextCursor: string = ''
  hasMore: boolean = false
  requestId: string = ''
}

/** 图片加载失败时使用统一占位标识，AppImage 组件内部处理错误展示 */
const IMAGE_UNAVAILABLE = ''

/**
 * 去掉 feed 层加的 `feed_prd_` 前缀，还原成商品 id。
 * 原先是 mock 模块 comparison-products 里的 canonicalProductId()；2026-10-09 该模块删除后就地内联
 * （真实链路只需要这一个行为，不需要保留「展示样例 id 映射」那些假数据分支）。
 */
function stripFeedIdPrefix(id: string): string {
  return id.startsWith('feed_prd_') ? id.substring(5) : id
}

export function mapFeedItem(raw: UTSJSONObject): FeedItem {
  const item = new FeedItem()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.feedType = raw['feedType'] != null ? raw['feedType'] as string : 'product'
  item.entityId = stripFeedIdPrefix(raw['entityId'] != null ? raw['entityId'] as string : item.id)
  item.title = raw['title'] != null ? raw['title'] as string : ''
  item.subtitle = raw['subtitle'] != null ? raw['subtitle'] as string : ''
  item.coverUrl = raw['coverUrl'] != null ? raw['coverUrl'] as string : IMAGE_UNAVAILABLE
  const wishBase = raw['wishCount'] != null ? raw['wishCount'] as number : 0
  item.wishCountBase = wishBase
  item.wishCount = wishBase
  // 拿到新的服务端值 ⇒ 说明它已经包含之前那些收藏动作，本机增量必须清零，
  // 否则「服务端基数 + 旧增量」会把同一次收藏算两遍。
  clearWishDelta(item.entityId)
  item.secondaryCoverUrl = raw['secondaryCoverUrl'] != null ? raw['secondaryCoverUrl'] as string : IMAGE_UNAVAILABLE
  item.brandId = raw['brandId'] != null ? raw['brandId'] as string : ''
  // 展示名口径（2026-10-06 最终）：**名称只有一个来源 = 品牌名**。
  // 原先「有品牌显示品牌、没有品牌退回店铺名」的过渡方案已取消（products.shop_name 列已删），
  // 所以这里不再做回退 —— 后端 join brands 给出什么就显示什么。
  item.brandName = raw['brandName'] != null ? raw['brandName'] as string : ''
  item.price = raw['price'] != null ? raw['price'] as number : 0
  item.badgeText = raw['badgeText'] != null ? raw['badgeText'] as string : ''
  item.eventStartAt = raw['eventStartAt'] != null ? raw['eventStartAt'] as string : ''
  item.eventEndAt = raw['eventEndAt'] != null ? raw['eventEndAt'] as string : ''
  item.liked = raw['liked'] == true
  item.saved = raw['saved'] == true
  item.sourceLabel = raw['sourceLabel'] != null ? raw['sourceLabel'] as string : ''
  item.rankingScore = raw['rankingScore'] != null ? raw['rankingScore'] as number : 0
  item.category = raw['category'] != null ? raw['category'] as string : ''
  // ====== 业务字段完整透传（Phase 1.1-B） ======
  item.pitType = raw['pitType'] != null ? raw['pitType'] as string : ''
  item.subCategory = raw['subCategory'] != null ? raw['subCategory'] as string : ''
  item.priceSummary = raw['priceSummary'] != null ? raw['priceSummary'] as string : ''
  // Product V2 价格语义：priceType + 定金/尾款金额（后端已透传；缺失时保持 UNKNOWN，展示层不猜测）
  item.priceType = raw['priceType'] != null ? raw['priceType'] as string : 'UNKNOWN'
  item.depositCents = raw['depositCents'] != null ? raw['depositCents'] as number : 0
  item.balanceCents = raw['balanceCents'] != null ? raw['balanceCents'] as number : 0
  item.fullPriceCents = raw['fullPriceCents'] != null ? raw['fullPriceCents'] as number : 0
  // 最高价（区间右端）：后端缺失/为 0 时保持 0，展示层会按单值处理
  item.maxPriceCents = raw['maxPriceCents'] != null ? raw['maxPriceCents'] as number : 0
  item.saleStatus = raw['saleStatus'] != null ? raw['saleStatus'] as string : ''
  item.releaseType = raw['releaseType'] != null ? raw['releaseType'] as string : ''
  item.releaseTypeName = raw['releaseTypeName'] != null ? raw['releaseTypeName'] as string : ''
  // tags：后端 string[]，明确类型安全解析；缺失/异常时使用安全空值，禁止伪造
  const rawTags = raw['tags'] as any[] | null
  if (rawTags != null && Array.isArray(rawTags)) {
    const list: string[] = []
    for (let i = 0; i < rawTags.length; i++) {
      const t = rawTags[i]
      if (t != null) list.push(t as string)
    }
    item.tags = list
  }
  item.feedReason = raw['feedReason'] != null ? raw['feedReason'] as string : ''
  item.personalScore = raw['personalScore'] != null ? raw['personalScore'] as number : 0
  item.matchReason = raw['matchReason'] != null ? raw['matchReason'] as string : ''
  item.finalScore = raw['finalScore'] != null ? raw['finalScore'] as number : 0
  item.publishedAt = raw['publishedAt'] != null ? raw['publishedAt'] as string : ''
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  return item
}

function channelCode(channel: string): string {
  if (channel == '上新') return 'new'
  if (channel == '预约') return 'reservation'
  // TODO: 「现货」channel 值待后端确认（feed-presenter 已确认 releaseType==='spot' →「现货」，feed channel 枚举未在数据契约定义）
  if (channel == '现货') return 'spot'
  return 'recommend'
}

function categoryCode(category: string): string {
  if (category == 'Lolita') return 'LOLITA'
  if (category == '汉服') return 'HANFU'
  if (category == '混搭') return 'MIXED'
  return category == '全部' ? '' : category
}

/**
 * 拉取 Feed 一页。
 * @param cursor 服务端返回的 opaque cursor（首屏传 ''）；禁止用页号×每页条数伪造。
 * @param channel 频道名（推荐/上新/预约/现货）
 */
async function fetchRemoteFeed(cursor: string, channel: string, category: string, categories: string = '', force: boolean = false): Promise<FeedPage> {
  let path = '/api/v1/feed'
  let hasQuery = false
  // 只传前端真实设置的值：cursor 首页(0)不传、channel 默认推荐不传、category/categories 空不传；limit 由后端默认 20
  if (cursor != '') { path += '?cursor=' + encodeQuery(cursor); hasQuery = true }
  const ch = channelCode(channel)
  // 未知 channel 值回退 recommend 语义（不传 channel 参数），避免后端 400/空数据
  if (ch != '' && ch != 'recommend') { path += (hasQuery ? '&' : '?') + 'channel=' + encodeQuery(ch); hasQuery = true }
  const cat = categoryCode(category)
  if (cat != '') { path += (hasQuery ? '&' : '?') + 'category=' + encodeQuery(cat); hasQuery = true }
  if (categories != '') { path += (hasQuery ? '&' : '?') + 'categories=' + encodeQuery(categories); hasQuery = true }
  // force=true 时跳过进程内/磁盘新鲜缓存（用户主动下拉刷新必须真的发请求）
  const response = await apiGet(path, force)
  const result = new FeedPage()
  result.requestId = response.requestId
  const rawItems = response.data
  if (rawItems != null && Array.isArray(rawItems)) {
    for (let i = 0; i < rawItems.length; i++) result.items.push(mapFeedItem(rawItems[i] as UTSJSONObject))
  }
  const page = response.page as UTSJSONObject | null
  result.nextCursor = page != null && page['nextCursor'] != null ? page['nextCursor'] as string : ''
  result.hasMore = page != null && page['hasMore'] == true
  return result
}

export async function fetchFeedPage(cursor: string, channel: string = '推荐', category: string = '全部', categories: string = '', force: boolean = false): Promise<FeedPage> {
  const page = await fetchRemoteFeed(cursor, channel, category, categories, force)
  return page
  // 2026-10-09：「推荐」频道首屏插入 2 条「展示样例」的逻辑已整体删除（用户要求去掉假数据）。

