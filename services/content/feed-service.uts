import { FeedItem } from '@/domain/content/feed-item'
import { createRequestId } from '@/domain/platform/api-contract'
import { apiGet, encodeQuery } from '@/services/platform/api-client'
import { getRuntimeConfig } from '@/config/runtime'

const __DEV__ = true

export class FeedPage {
  items: FeedItem[] = []
  nextCursor: string = ''
  hasMore: boolean = false
  requestId: string = ''
}

/** 图片加载失败时使用统一占位标识，AppImage 组件内部处理错误展示 */
const IMAGE_UNAVAILABLE = ''

function mapFeedItem(raw: any): FeedItem {
  const item = new FeedItem()
  item.id = raw.id != null ? String(raw.id) : ''
  item.feedType = raw.feedType != null ? String(raw.feedType) : 'product'
  item.entityId = raw.entityId != null ? String(raw.entityId) : ''
  item.title = raw.title != null ? String(raw.title) : ''
  item.subtitle = raw.subtitle != null ? String(raw.subtitle) : ''
  item.coverUrl = raw.coverUrl != null ? String(raw.coverUrl) : IMAGE_UNAVAILABLE
  item.secondaryCoverUrl = raw.secondaryCoverUrl != null ? String(raw.secondaryCoverUrl) : IMAGE_UNAVAILABLE
  item.brandId = raw.brandId != null ? String(raw.brandId) : ''
  item.brandName = raw.brandName != null ? String(raw.brandName) : ''
  item.price = raw.price != null ? Number(raw.price) : 0
  item.originalPrice = raw.originalPrice != null ? Number(raw.originalPrice) : 0
  item.badgeText = raw.badgeText != null ? String(raw.badgeText) : ''
  item.eventStartAt = raw.eventStartAt != null ? String(raw.eventStartAt) : ''
  item.eventEndAt = raw.eventEndAt != null ? String(raw.eventEndAt) : ''
  item.liked = raw.liked === true
  item.saved = raw.saved === true
  item.sourceLabel = raw.sourceLabel != null ? String(raw.sourceLabel) : ''
  item.rankingScore = raw.rankingScore != null ? Number(raw.rankingScore) : 0
  item.category = raw.category != null ? String(raw.category) : ''
  item.createdAt = raw.createdAt != null ? String(raw.createdAt) : ''
  return item
}

function channelCode(channel: string): string {
  if (channel === '新品') return 'new'
  if (channel === '预约') return 'reservation'
  if (channel === '降价') return 'price_drop'
  if (channel === '穿搭') return 'outfit'
  return 'recommend'
}

function categoryCode(category: string): string {
  if (category === 'Lolita') return 'LOLITA'
  if (category === '汉服') return 'HANFU'
  return category === '全部' ? '' : category
}

async function fetchRemoteFeed(pageIndex: number, channel: string, category: string): Promise<FeedPage> {
  const offset = Math.max(pageIndex, 0) * 20
  const path = `/api/v1/feed?cursor=${offset}&limit=20&channel=${encodeQuery(channelCode(channel))}&category=${encodeQuery(categoryCode(category))}`
  if (__DEV__) console.log('[Feed] request:', getRuntimeConfig().apiBaseUrl + path)
  const response = await apiGet(path)
  if (__DEV__) {
    console.log('[Feed] HTTP status:', response.statusCode)
    const first = Array.isArray(response.data) && response.data.length > 0 ? response.data[0] : null
    if (first != null) console.log('[Feed] first:', JSON.stringify({ id: first.id, title: first.title, coverUrl: first.coverUrl }))
  }
  const rawItems = response.data as any[]
  const result = new FeedPage()
  result.requestId = response.requestId
  if (rawItems != null) for (let i = 0; i < rawItems.length; i++) result.items.push(mapFeedItem(rawItems[i]))
  const page = response.page as any
  result.nextCursor = page != null && page.nextCursor != null ? String(page.nextCursor) : ''
  result.hasMore = page != null && page.hasMore === true
  return result
}

export async function fetchFeedPage(pageIndex: number, channel: string = '推荐', category: string = '全部'): Promise<FeedPage> {
  return await fetchRemoteFeed(pageIndex, channel, category)
}

/** 服务端全文搜索：覆盖真实商品库，不依赖首页缓存。 */
export async function searchProducts(query: string, category: string = ''): Promise<FeedPage> {
  const keyword = query.trim()
  if (keyword === '') return new FeedPage()
  const path = `/api/v1/search?q=${encodeQuery(keyword)}&category=${encodeQuery(category)}&limit=50`
  const response = await apiGet(path)
  const result = new FeedPage()
  result.requestId = response.requestId
  const rawItems = response.data as any[]
  if (rawItems != null) {
    for (let i = 0; i < rawItems.length; i++) result.items.push(mapFeedItem(rawItems[i]))
  }
  const page = response.page as any
  result.nextCursor = page != null && page.nextCursor != null ? String(page.nextCursor) : ''
  result.hasMore = page != null && page.hasMore === true
  return result
}

export function filterFeedByChannel(items: FeedItem[], channel: string): FeedItem[] {
  if (channel === '' || channel === '推荐') return items
  if (channel === '新品') return items.filter((i) => i.badgeText === '新品')
  if (channel === '预约') return items.filter((i) => i.badgeText === '预约' || i.badgeText === '定金')
  if (channel === '降价') return items.filter((i) => i.badgeText === '降价')
  if (channel === '穿搭') return items.filter((i) => i.feedType === 'outfit')
  return items.filter((i) => i.category === channel)
}
