import { FeedItem } from '@/domain/content/feed-item'
import { createRequestId } from '@/domain/platform/api-contract'
import { apiGet, encodeQuery } from '@/services/platform/api-client'
import { getRuntimeConfig } from '@/config/runtime'

export class FeedPage {
  items: FeedItem[] = []
  nextCursor: string = ''
  hasMore: boolean = false
  requestId: string = ''
}

/** 图片加载失败时使用统一占位标识，AppImage 组件内部处理错误展示 */
const IMAGE_UNAVAILABLE = ''

export function mapFeedItem(raw: UTSJSONObject): FeedItem {
  const item = new FeedItem()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.feedType = raw['feedType'] != null ? raw['feedType'] as string : 'product'
  item.entityId = raw['entityId'] != null ? raw['entityId'] as string : ''
  item.title = raw['title'] != null ? raw['title'] as string : ''
  item.subtitle = raw['subtitle'] != null ? raw['subtitle'] as string : ''
  item.coverUrl = raw['coverUrl'] != null ? raw['coverUrl'] as string : IMAGE_UNAVAILABLE
  item.secondaryCoverUrl = raw['secondaryCoverUrl'] != null ? raw['secondaryCoverUrl'] as string : IMAGE_UNAVAILABLE
  item.brandId = raw['brandId'] != null ? raw['brandId'] as string : ''
  item.brandName = raw['brandName'] != null ? raw['brandName'] as string : ''
  item.price = raw['price'] != null ? raw['price'] as number : 0
  item.originalPrice = raw['originalPrice'] != null ? raw['originalPrice'] as number : 0
  item.badgeText = raw['badgeText'] != null ? raw['badgeText'] as string : ''
  item.eventStartAt = raw['eventStartAt'] != null ? raw['eventStartAt'] as string : ''
  item.eventEndAt = raw['eventEndAt'] != null ? raw['eventEndAt'] as string : ''
  item.liked = raw['liked'] == true
  item.saved = raw['saved'] == true
  item.sourceLabel = raw['sourceLabel'] != null ? raw['sourceLabel'] as string : ''
  item.rankingScore = raw['rankingScore'] != null ? raw['rankingScore'] as number : 0
  item.category = raw['category'] != null ? raw['category'] as string : ''
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  return item
}

function channelCode(channel: string): string {
  if (channel == '新品') return 'new'
  if (channel == '预约') return 'reservation'
  if (channel == '降价') return 'price_drop'
  if (channel == '穿搭') return 'outfit'
  return 'recommend'
}

function categoryCode(category: string): string {
  if (category == 'Lolita') return 'LOLITA'
  if (category == '汉服') return 'HANFU'
  return category == '全部' ? '' : category
}

/**
 * 拉取 Feed 一页。
 * @param cursor 服务端返回的 opaque cursor（首屏传 ''）；禁止用页号×每页条数伪造。
 * @param channel 频道名（推荐/新品/预约/降价/穿搭）
 */
async function fetchRemoteFeed(cursor: string, channel: string, category: string, categories: string = ''): Promise<FeedPage> {
  let path = '/api/v1/feed'
  let hasQuery = false
  // 只传前端真实设置的值：cursor 首页(0)不传、channel 默认推荐不传、category/categories 空不传；limit 由后端默认 20
  if (cursor != '') { path += '?cursor=' + encodeQuery(cursor); hasQuery = true }
  const ch = channelCode(channel)
  if (ch != '' && ch != 'recommend') { path += (hasQuery ? '&' : '?') + 'channel=' + encodeQuery(ch); hasQuery = true }
  const cat = categoryCode(category)
  if (cat != '') { path += (hasQuery ? '&' : '?') + 'category=' + encodeQuery(cat); hasQuery = true }
  if (categories != '') { path += (hasQuery ? '&' : '?') + 'categories=' + encodeQuery(categories); hasQuery = true }
  const response = await apiGet(path)
  const rawItems = response.data as any[]
  const result = new FeedPage()
  result.requestId = response.requestId
  if (rawItems != null) for (let i = 0; i < rawItems.length; i++) result.items.push(mapFeedItem(rawItems[i] as UTSJSONObject))
  const page = response.page as UTSJSONObject | null
  result.nextCursor = page != null && page['nextCursor'] != null ? page['nextCursor'] as string : ''
  result.hasMore = page != null && page['hasMore'] == true
  return result
}

export async function fetchFeedPage(cursor: string, channel: string = '推荐', category: string = '全部', categories: string = ''): Promise<FeedPage> {
  return await fetchRemoteFeed(cursor, channel, category, categories)
}

/**
 * 频道轻量过滤兜底（服务端已按 channel 参数过滤，此函数仅用于本地补充筛选）。
 * 注意：频道切换时 Store 已重新请求该频道第 1 页，这里不再承担主过滤职责。
 */
export function filterFeedByChannel(items: FeedItem[], channel: string): FeedItem[] {
  if (channel == '' || channel == '推荐') return items
  if (channel == '新品') return items.filter((i) => i.badgeText == '新品')
  if (channel == '预约') return items.filter((i) => i.badgeText == '预约' || i.badgeText == '定金')
  if (channel == '降价') return items.filter((i) => i.badgeText == '降价')
  if (channel == '穿搭') return items.filter((i) => i.feedType == 'outfit')
  return items.filter((i) => i.category == channel)
}
