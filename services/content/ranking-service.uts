/**
 * ranking-service — 三坑榜单数据
 * 远端优先使用 GET /api/v1/ranking；无数据/不可达时回退统一演示目录。
 */
import { RankingItem } from '@/domain/ranking/ranking-item'
import { apiGet, encodeQuery } from '@/services/platform/api-client'
import { listMockRanking } from '@/services/mock/mock-catalog'

function mapRemoteRanking(raw: UTSJSONObject): RankingItem {
  const item = new RankingItem()
  item.rank = raw['rank'] != null ? raw['rank'] as number : 0
  item.entityId = raw['entityId'] != null ? raw['entityId'] as string : ''
  item.title = raw['title'] != null ? raw['title'] as string : ''
  item.brandName = raw['brandName'] != null ? raw['brandName'] as string : ''
  item.coverUrl = raw['coverUrl'] != null ? raw['coverUrl'] as string : ''
  item.priceCents = raw['priceCents'] != null ? raw['priceCents'] as number : 0
  const category = raw['category'] != null ? raw['category'] as string : ''
  item.category = category == 'LOLITA' ? 'Lolita' : category == 'HANFU' ? '汉服' : category
  item.favoriteCount = raw['favoriteCount'] != null ? raw['favoriteCount'] as number : 0
  item.favoriteGrowth = raw['favoriteGrowth'] != null ? raw['favoriteGrowth'] as number : item.favoriteCount
  item.releaseTypeName = raw['releaseTypeName'] != null ? raw['releaseTypeName'] as string : ''
  item.daysAgo = raw['daysAgo'] != null ? raw['daysAgo'] as number : 0
  item.reservationCount = raw['reservationCount'] != null ? raw['reservationCount'] as number : 0
  return item
}

export async function fetchRankingRemote(tab: string): Promise<RankingItem[]> {
  try {
    const response = await apiGet('/api/v1/ranking?tab=' + encodeQuery(tab === 'favorite' ? 'hot' : tab))
    const raw = response.data as any[] | null
    const result: RankingItem[] = []
    if (raw != null) for (let i = 0; i < raw.length; i++) result.push(mapRemoteRanking(raw[i] as UTSJSONObject))
    if (result.length > 0) {
      if (tab === 'favorite') result.sort((a, b) => b.favoriteCount - a.favoriteCount)
      for (let i = 0; i < result.length; i++) result[i].rank = i + 1
      return result
    }
  } catch (e) {}
  return listMockRanking(tab)
}
