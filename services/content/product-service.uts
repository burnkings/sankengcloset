/** Phase 2.3-A：商品关联社区内容（「真实买家」模块；后端默认 4 条，游客可读） */
export async function fetchProductCommunity(id: string): Promise<ProductCommunityPost[]> {
  if (id === '') return []
  const result = [] as ProductCommunityPost[]
  try {
    const response = await apiGet(`/api/v1/products/${encodeQuery(id)}/community`)
    const values = response.data as any[] | null
    if (values != null) for (let i = 0; i < values.length; i++) {
      const raw = values[i] as UTSJSONObject
      const post = new ProductCommunityPost()
      post.id = raw['id'] != null ? raw['id'] as string : ''
      post.authorNickname = raw['authorNickname'] != null ? raw['authorNickname'] as string : '同好'
      // 社区图片是后端相对地址（/api/v1/media/<id>），必须补成绝对地址才能加载
      post.imageUrl = resolveApiUrl(raw['imageUrl'] != null ? raw['imageUrl'] as string : '')
      post.caption = raw['caption'] != null ? raw['caption'] as string : ''
      post.category = raw['category'] != null ? raw['category'] as string : ''
      post.topic = raw['topic'] != null ? raw['topic'] as string : ''
      post.likeCount = raw['likeCount'] != null ? raw['likeCount'] as number : 0
      post.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
      post.productId = raw['productId'] != null ? raw['productId'] as string : ''
      result.push(post)
    }
    return result
  } catch (e) { throw e }

  // [MOCK-DEBUG] 以下为 mock 数据回退，调试时可取消注释
  // if (findMockProduct(id) != null) {
  //   for (let i = 0; i < 2; i++) {
  //     const post = new ProductCommunityPost()
  //     post.id = 'mock_buyer_' + id + '_' + i.toString()
  //     post.authorNickname = i == 0 ? '栗子同学' : '小鹿茶会'
  //     post.imageUrl = i == 0 ? '/static/demo/outfit-01.png' : '/static/demo/outfit-02.png'
  //     post.caption = i == 0 ? '日常搭配很轻松，尺码信息以实际商品为准。' : '换一件内搭就是另一套感觉。'
  //     post.category = findMockProduct(id)!.category
  //     post.topic = '日常穿搭'
  //     post.likeCount = i == 0 ? 38 : 21
  //     post.createdAt = mockDateAfter(-i - 1)
  //     post.productId = id
  //     result.push(post)
  //   }
  // }
  // return result
}

