import { FeedItem, FEED_PRODUCT } from '@/domain/content/feed-item'
import { apiGet } from '@/services/platform/api-client'

export class ProductDetailModel {
  item: FeedItem = new FeedItem()
  images: string[] = []
  description: string = ''
  shopUrl: string = ''
  requestId: string = ''
}

function statusLabel(status: string): string {
  if (status === 'PRE_ORDER') return '预售'
  if (status === 'UPCOMING') return '预告'
  if (status === 'SOLD_OUT') return '售罄'
  if (status === 'ON_SALE') return '现货'
  return ''
}

function addUniqueImage(images: string[], url: string) {
  if (url !== '' && images.indexOf(url) < 0) images.push(url)
}

function mapRemoteProduct(raw: any, requestId: string): ProductDetailModel {
  const result = new ProductDetailModel()
  const item = new FeedItem()
  item.id = raw.id != null ? String(raw.id) : ''
  item.entityId = item.id
  item.feedType = FEED_PRODUCT
  item.title = raw.title != null ? String(raw.title) : ''
  item.subtitle = raw.description != null ? String(raw.description) : ''
  item.brandId = raw.brandId != null ? String(raw.brandId) : ''
  item.brandName = raw.brandName != null ? String(raw.brandName) : ''
  item.category = raw.category != null ? String(raw.category) : ''
  item.price = raw.priceCents != null ? Number(raw.priceCents) : 0
  item.originalPrice = raw.originalPriceCents != null ? Number(raw.originalPriceCents) : item.price
  item.badgeText = statusLabel(raw.status != null ? String(raw.status) : '')
  item.coverUrl = raw.coverUrl != null ? String(raw.coverUrl) : ''
  item.sourceLabel = '服务端'
  item.createdAt = raw.createdAt != null ? String(raw.createdAt) : ''

  const images = raw.images as any[]
  if (images != null) {
    for (let i = 0; i < images.length; i++) addUniqueImage(result.images, String(images[i]))
  }
  addUniqueImage(result.images, item.coverUrl)
  if (result.images.length > 1) item.secondaryCoverUrl = result.images[1]

  result.item = item
  result.description = raw.description != null ? String(raw.description) : ''
  result.shopUrl = raw.shopUrl != null ? String(raw.shopUrl) : ''
  result.requestId = requestId
  return result
}

export async function fetchProductDetail(id: string): Promise<ProductDetailModel | null> {
  if (id === '') return null
  const response = await apiGet(`/api/v1/products/${encodeURIComponent(id)}`)
  if (response.data == null) return null
  return mapRemoteProduct(response.data, response.requestId)
}
