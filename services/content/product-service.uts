import { FeedItem, FEED_PRODUCT } from '@/domain/content/feed-item'
import { apiGet, encodeQuery } from '@/services/platform/api-client'

export class ProductDetailModel {
  item: FeedItem = new FeedItem()
  images: string[] = []
  description: string = ''
  shopUrl: string = ''
  requestId: string = ''
}

function statusLabel(status: string): string {
  if (status === 'PRE_ORDER') return '预售'
  if (status === 'UPCOMING') return '预告'
  if (status === 'SOLD_OUT') return '售罄'
  if (status === 'ON_SALE') return '现货'
  return ''
}

function addUniqueImage(images: string[], url: string) {
  if (url !== '' && images.indexOf(url) < 0) images.push(url)
}

function mapRemoteProduct(raw: UTSJSONObject, requestId: string): ProductDetailModel {
  const result = new ProductDetailModel()
  const item = new FeedItem()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.entityId = item.id
  item.feedType = FEED_PRODUCT
  item.title = raw['title'] != null ? raw['title'] as string : ''
  item.subtitle = raw['description'] != null ? raw['description'] as string : ''
  item.brandId = raw['brandId'] != null ? raw['brandId'] as string : ''
  item.brandName = raw['brandName'] != null ? raw['brandName'] as string : ''
  item.category = raw['category'] != null ? raw['category'] as string : ''
  item.price = raw['priceCents'] != null ? raw['priceCents'] as number : 0
  item.originalPrice = raw['originalPriceCents'] != null ? raw['originalPriceCents'] as number : item.price
  item.badgeText = statusLabel(raw['status'] != null ? raw['status'] as string : '')
  item.coverUrl = raw['coverUrl'] != null ? raw['coverUrl'] as string : ''
  item.sourceLabel = '服务端'
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''

  const images = raw['images'] as any[]
  if (images != null) {
    for (let i = 0; i < images.length; i++) addUniqueImage(result.images, images[i] as string)
  }
  addUniqueImage(result.images, item.coverUrl)
  if (result.images.length > 1) item.secondaryCoverUrl = result.images[1]

  result.item = item
  result.description = raw['description'] != null ? raw['description'] as string : ''
  result.shopUrl = raw['shopUrl'] != null ? raw['shopUrl'] as string : ''
  result.requestId = requestId
  return result
}

export async function fetchProductDetail(id: string): Promise<ProductDetailModel | null> {
  if (id === '') return null
  const response = await apiGet(`/api/v1/products/${encodeQuery(id)}`)
  if (response.data == null) return null
  return mapRemoteProduct(response.data as UTSJSONObject, response.requestId)
}
