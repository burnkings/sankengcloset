import { FeedItem, FEED_PRODUCT } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
import { ProductVariant } from '@/domain/content/product-variant'
import { ProductImage, ProductReleaseBatch, deriveCoverUrl, extractImageUrls } from '@/domain/content/product'
import { apiGet, encodeQuery, resolveApiUrl } from '@/services/platform/api-client'

/** Phase 2.3-A：商品关联社区内容（「真实买家」模块条目，最小字段） */
export class ProductCommunityPost {
  id: string = ''
  authorNickname: string = ''
  imageUrl: string = ''
  caption: string = ''
  category: string = ''
  topic: string = ''
  likeCount: number = 0
  createdAt: string = ''
  productId: string = ''
}

export class ProductDetailModel {
  item: FeedItem = new FeedItem()
  /** 商品级发货说明（「15天内发货」这类时效承诺）。批次级的在同名批次的 shippingNote 上 */
  shippingNote: string = ''
  images: ProductImage[] = []
  description: string = ''
  shopUrl: string = ''
  requestId: string = ''
  /** 当前有效发售批次（后端 Product.currentRelease → 复用 ReleaseEvent Domain，非第二套模型） */
  currentRelease: ReleaseEvent | null = null
  /** 同款式商品分组 key（替代 styleId；12-table schema） */
  groupKey: string = ''
  // ====== Product V2 展示字段（Raw → Normalize → Product；前端只消费 Product 层） ======
  /** 价格语义：FULL/DEPOSIT/BALANCE/INTENTION/UNKNOWN（缺失保持 UNKNOWN，展示层不猜测） */
  priceType: string = 'UNKNOWN'
  /** 定金（分） */
  depositCents: number = 0
  /** 尾款（分） */
  balanceCents: number = 0
  /** 现货价/全款（分，= item.price） */
  fullPriceCents: number = 0
  /** 三坑类型（JK/LOLITA/HANFU/OTHER，= item.category） */
  pitType: string = ''
  /** 细分类目（格裙/衬衫/JSK/OP/襦裙/马面…） */
  subCategory: string = ''
  /** 最高价（分）；<= priceCents 表示单值。与 priceCents 构成本商品的价格区间 */
  maxPriceCents: number = 0
  /** 特点标签（Product V2 feature_tags） */
  featureTags: string[] = []
  /** 规格变体（多款式商品；空数组 = 单款式/无数据，不渲染款式价格表） */
  variants: ProductVariant[] = []
}

function statusLabel(status: string): string {
  if (status === 'PRE_ORDER') return '预售'
  if (status === 'UPCOMING') return '预告'
  if (status === 'SOLD_OUT') return '售罄'
  if (status === 'ON_SALE') return '现货'
  if (status === 'ON_SALE_PRE_ORDER') return '现货+预售'
  return ''
}

function addUniqueImage(images: string[], url: string) {
  if (url !== '' && images.indexOf(url) < 0) images.push(url)
}

/**
 * 后端 currentRelease（ProductRelease DTO）→ ReleaseEvent 映射。
 * 字段名对齐后端 camelCase：releaseName/releaseType/saleStatus/lifecycleStatus/
 * isRerelease/depositCents/balanceCents/fullPriceCents/startAt/endAt/balanceDueAt/shipAt。
 * 无 release 返回 null（UI 不伪造状态、不显示 0）。
 */
function mapCurrentRelease(raw: UTSJSONObject | null, productId: string, brandId: string): ReleaseEvent | null {
  if (raw == null) return null
  const release = new ReleaseEvent()
  release.id = raw['id'] != null ? raw['id'] as string : ''
  release.productId = productId
  release.brandId = brandId
  release.title = raw['releaseName'] != null ? raw['releaseName'] as string : ''
  release.releaseType = raw['releaseType'] != null ? raw['releaseType'] as string : 'unknown'
  release.saleStatus = raw['saleStatus'] != null ? raw['saleStatus'] as string : ''
  release.lifecycleStatus = raw['lifecycleStatus'] != null ? raw['lifecycleStatus'] as string : 'unknown'
  release.status = release.lifecycleStatus
  release.isRerelease = raw['isRerelease'] == true
  release.depositAmount = raw['depositCents'] != null ? raw['depositCents'] as number : 0
  release.finalPaymentAmount = raw['balanceCents'] != null ? raw['balanceCents'] as number : 0
  release.fullPrice = raw['fullPriceCents'] != null ? raw['fullPriceCents'] as number : 0
  release.startAt = raw['startAt'] != null ? raw['startAt'] as string : ''
  release.endAt = raw['endAt'] != null ? raw['endAt'] as string : ''
  release.balanceDueAt = raw['balanceDueAt'] != null ? raw['balanceDueAt'] as string : ''
  release.shipAt = raw['shipAt'] != null ? raw['shipAt'] as string : ''
  // ⚠️ 发货说明（「15天内发货」这类时效承诺）必须一起映射。
  //    2026-10-08 起它**只有商品级一份**（运营后台填在「销售状态」那组；批次级那份已并入并删除库列）。
  //    后端为兼容老客户端仍会在 currentRelease 上回填同一份值，所以这里照旧取 shippingNote 即可；
  //    漏映射 ⇒ release.note 恒空 ⇒ 详情页「发售信息 → 发货说明」那行永远不显示
  //    （2026-10-08 联调定位：后端 currentRelease.shippingNote 有值，前端没接）。
  release.note = raw['shippingNote'] != null ? raw['shippingNote'] as string : ''
  return release
}

function mapRemoteProduct(raw: UTSJSONObject, requestId: string): ProductDetailModel {
  const result = new ProductDetailModel()
  const item = new FeedItem()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.entityId = item.id
  item.feedType = FEED_PRODUCT
  item.title = raw['title'] != null ? raw['title'] as string : ''
  // ⚠️ 2026-09-27 第 3 轮：商品说明（description）字段已废弃 —— 不再接进 App。
  //    用户口径「删除商品说明字段和模块，不需要保留」：
  //    ① 服务端该列已置 NULL；② 详情页「商品说明」模块已删除。
  //    所以这里不再把 description 塞进 FeedItem.subtitle。
  item.brandId = raw['brandId'] != null ? raw['brandId'] as string : ''
  item.brandName = raw['brandName'] != null ? raw['brandName'] as string : ''
  item.category = raw['category'] != null ? raw['category'] as string : ''
  item.price = raw['priceCents'] != null ? raw['priceCents'] as number : 0
  // Note: price=0 with priceType=INTENTION means intention amount, not free
  item.badgeText = statusLabel(raw['saleStatus'] != null ? raw['saleStatus'] as string : '')
  // coverUrl is derived from images[0]?.url below (12-table schema)
  // 来源标签：名称只有一个来源 = 品牌名（2026-10-06 起不再有 shopName）
  item.sourceLabel = raw['brandName'] != null ? raw['brandName'] as string : ''
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  // ====== Product V2 展示字段透传（priceType 缺失保持 UNKNOWN，展示层不猜测） ======
  item.priceType = raw['priceType'] != null ? raw['priceType'] as string : 'UNKNOWN'
  item.depositCents = raw['depositCents'] != null ? raw['depositCents'] as number : 0
  item.balanceCents = raw['balanceCents'] != null ? raw['balanceCents'] as number : 0
  item.saleStatus = raw['saleStatus'] != null ? raw['saleStatus'] as string : ''
  item.pitType = raw['category'] != null ? raw['category'] as string : ''
  item.subCategory = raw['subCategory'] != null ? raw['subCategory'] as string : ''
  // 最高价（区间右端）：缺失/0 时按单值处理（见 formatPriceRange）
  item.maxPriceCents = raw['maxPriceCents'] != null ? raw['maxPriceCents'] as number : 0
  // 人气（收藏数）：**服务端基数** + 本机增量，跟商品卡/榜单卡同一个口径。
  // ⚠️ 之前这里写成 `result.item.favoriteCount = ...`，但 130 行之后 `result.item = item` 会把它整个覆盖掉，
  //    而且 FeedItem 压根没有 favoriteCount 字段 ⇒ 详情页底栏永远只显示「本机增量」，与卡片对不上（2026-10-05 修）。
  item.wishCountBase = raw['wishCount'] != null ? raw['wishCount'] as number : 0
  item.wishCount = item.wishCountBase

  // 12-table 线上契约（2026-10-10 实测 https://api.sankengcloset.icu 确认为**对象**）：
  //   {url, thumbnailUrl, width, height, sizeBytes, objectKey}（后 5 个线上恒为 null）
  // 但仍兼容后端返回 string[] 的写法 —— 那种情况下若只按对象读，副图会被静默丢弃
  // （评审 2026-10-09「待验证疑点①」；实测线上是对象，这里保留 string 兼容分支做防御）。
  const rawImages = raw['images'] as any[]
  if (rawImages != null && Array.isArray(rawImages)) {
    for (let i = 0; i < rawImages.length; i++) {
      const img = rawImages[i]
      if (img == null) continue
      const pi = new ProductImage()
      if (typeof img === 'string') {
        pi.url = img as string
      } else {
        const obj = img as UTSJSONObject
        pi.url = obj['url'] != null ? obj['url'] as string : ''
        pi.thumbnailUrl = obj['thumbnailUrl'] != null ? obj['thumbnailUrl'] as string : ''
        pi.width = obj['width'] != null ? obj['width'] as number : 0
        pi.height = obj['height'] != null ? obj['height'] as number : 0
        pi.sizeBytes = obj['sizeBytes'] != null ? obj['sizeBytes'] as number : 0
        pi.objectKey = obj['objectKey'] != null ? obj['objectKey'] as string : ''
      }
      if (pi.url !== '') result.images.push(pi)
    }
  }
  if (result.images.length == 0 && raw['coverUrl'] != null) {
    const cover = new ProductImage()
    cover.url = raw['coverUrl'] as string
    if (cover.url !== '') result.images.push(cover)
  }
  // Derive coverUrl from images[0] if available
  // 多批次：服务端只在 >1 个批次时下发；这里原样带上来，详情页据此切换成列表展示
  const rawReleases = raw['releases']
  const batches: ProductReleaseBatch[] = []
  if (rawReleases != null && Array.isArray(rawReleases)) {
    const arr = rawReleases as UTSJSONObject[]
    for (let i = 0; i < arr.length; i++) {
      const r0 = arr[i]
      const b = new ProductReleaseBatch()
      b.id = r0['id'] != null ? r0['id'] as string : ''
      b.no = r0['releaseNo'] != null ? r0['releaseNo'] as number : 0
      b.name = r0['releaseName'] != null ? r0['releaseName'] as string : ''
      b.releaseType = r0['releaseType'] != null ? r0['releaseType'] as string : ''
      b.saleStatus = r0['saleStatus'] != null ? r0['saleStatus'] as string : ''
      b.depositCents = r0['depositCents'] != null ? r0['depositCents'] as number : null
      b.balanceCents = r0['balanceCents'] != null ? r0['balanceCents'] as number : null
      b.fullPriceCents = r0['fullPriceCents'] != null ? r0['fullPriceCents'] as number : null
      b.startAt = r0['startAt'] != null ? r0['startAt'] as string : ''
      b.endAt = r0['endAt'] != null ? r0['endAt'] as string : ''
      b.balanceDueAt = r0['balanceDueAt'] != null ? r0['balanceDueAt'] as string : ''
      b.shipAt = r0['shipAt'] != null ? r0['shipAt'] as string : ''
      // 批次上不再有各自的发货说明（2026-10-08）；后端回填商品级那份，保持 ReleaseEvent.note 契约不变
      b.note = r0['shippingNote'] != null ? r0['shippingNote'] as string : ''
      batches.push(b)
    }
  }
  // ⚠️ 顺序陷阱：下面 `result.item = item` 会**整体替换**模型里的默认 FeedItem，
  //    所以所有字段都必须写在 `item` 上。写在 `result.item` 上的会被无声丢弃
  //    —— releases 曾因此完全传不到详情页（多批次列表不显示），收藏数同理（2026-10-05 修）。
  item.releases = batches
  item.coverUrl = deriveCoverUrl(result.images)
  // Secondary cover: second image URL
  if (result.images.length > 1) item.secondaryCoverUrl = result.images[1].url

  // 真实发售批次：currentRelease（存在时 eventEndAt 取 endAt，供截止时间展示）
  const currentRelease = mapCurrentRelease(raw['currentRelease'] as UTSJSONObject | null, item.id, item.brandId)
  result.currentRelease = currentRelease
  if (currentRelease != null && currentRelease.endAt !== '') item.eventEndAt = currentRelease.endAt

  result.item = item
  // 商品说明已废弃（2026-09-27 第 3 轮）：不再从 API 取 description
  result.shopUrl = raw['canonicalUrl'] != null ? raw['canonicalUrl'] as string : (raw['shopUrl'] != null ? raw['shopUrl'] as string : '')
  result.groupKey = raw['groupKey'] != null ? raw['groupKey'] as string : ''
  // ====== Product V2 展示字段 ======
  result.priceType = item.priceType
  result.depositCents = item.depositCents
  result.balanceCents = item.balanceCents
  result.fullPriceCents = item.price
  result.pitType = item.pitType
  result.subCategory = item.subCategory
  result.maxPriceCents = item.maxPriceCents
  result.featureTags = parseStringArray(raw['featureTags'])
  result.variants = parseVariants(raw['variants'])
  // 发货说明（「15天内发货」这类时效承诺）—— 2026-10-08 起**只有商品级一份**（批次级那份已并入，迁移 0111）
  result.shippingNote = raw['shippingNote'] != null ? raw['shippingNote'] as string : ''
  result.requestId = requestId
  return result
}

/** 安全解析 string[]（缺失/非数组返回空数组，不伪造数据） */
function parseStringArray(raw: any): string[] {
  const result: string[] = []
  if (raw == null || !Array.isArray(raw)) return result
  for (let i = 0; i < raw.length; i++) {
    const v = raw[i]
    if (v != null) result.push(v as string)
  }
  return result
}

/**
 * 款式噪音词：三坑不用「连衣裙」这个说法（Lolita 讲 JSK / OP / SK，汉服讲马面裙 / 褙子），
 * 它出现在规格里只会让用户困惑（用户反馈：三坑商品没有「连衣裙」标签，涉及的都删掉）。
 */
const STYLE_NOISE = '连衣裙'

/** 解析规格变体数组（12-table: product_variants 行；仅 identity 字段，无 skuCode/price/stockStatus） */
function parseVariants(raw: any): ProductVariant[] {
  const result: ProductVariant[] = []
  if (raw == null || !Array.isArray(raw)) return result
  for (let i = 0; i < raw.length; i++) {
    const r = raw[i] as UTSJSONObject
    if (r == null) continue
    const v = new ProductVariant()
    v.id = r['id'] != null ? r['id'] as string : ''
    v.productId = r['productId'] != null ? r['productId'] as string : ''
    v.name = r['name'] != null ? r['name'] as string : ''
    v.colorName = r['colorName'] != null ? r['colorName'] as string : ''
    v.referencePriceCents = r['referencePriceCents'] != null && typeof r['referencePriceCents'] === 'number' && (r['referencePriceCents'] as number) >= 0 ? r['referencePriceCents'] as number : null
    // 款式里的「连衣裙」直接丢掉（见 STYLE_NOISE）
    const styleName = r['styleName'] != null ? r['styleName'] as string : ''
    v.styleName = styleName.indexOf(STYLE_NOISE) >= 0 ? '' : styleName
    v.sizeName = r['sizeName'] != null ? r['sizeName'] as string : ''
    result.push(v)
  }
  return result
}

export async function fetchProductDetail(id: string, releaseId: string = ''): Promise<ProductDetailModel | null> {
  if (id === '') return null
  // releaseId 非空：后端优先返回该批次 currentRelease（不存在则回退最新一条）
  const query = releaseId !== '' ? `?releaseId=${encodeQuery(releaseId)}` : ''
  try {
    const response = await apiGet(`/api/v1/products/${encodeQuery(id)}${query}`)
    if (response.data != null) return mapRemoteProduct(response.data as UTSJSONObject, response.requestId)
    return null
  } catch (e) { throw e }

