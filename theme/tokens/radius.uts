/**
 * Radius — 设计令牌 v2.0
 * 更圆润的圆角，符合年轻女性消费 App 的柔和视觉
 */

export const radius = {
  none: '0rpx',
  xs: '4rpx',
  sm: '8rpx',
  md: '12rpx',
  lg: '16rpx',
  xl: '24rpx',
  '2xl': '32rpx',
  '3xl': '48rpx',
  full: '9999rpx',
}

export const semanticRadius = {
  button: radius.xl,       // 24rpx (更圆润)
  buttonSm: radius.lg,     // 16rpx
  card: radius.xl,         // 24rpx (卡片更圆润)
  cardLg: radius['2xl'],   // 32rpx (大卡片)
  dialog: radius['2xl'],   // 32rpx
  bottomSheet: radius['2xl'],
  input: radius.xl,        // 24rpx (输入框统一样式)
  tag: radius.full,        // 胶囊形
  badge: radius.full,
  avatar: radius.full,     // 50%
  image: radius.lg,        // 16rpx
  imageLg: radius.xl,      // 24rpx (大图更圆润)
  chip: radius.full,       // 胶囊形
  toast: radius.xl,        // 24rpx
  modal: radius['2xl'],    // 32rpx
  tab: radius.lg,          // 16rpx
  switch: radius.full,
  progress: radius.full,
  skeleton: radius.md,     // 12rpx
}

// ====== V3 语义圆角（Design System V3 §3.4）======

export const v3Radius = {
  feedImage: '12rpx',      // Feed 图片
  cardSmall: '12rpx',      // 商品/内容小卡容器
  listGroup: '20rpx',      // 列表组、表单组
  formGroup: '20rpx',
  largeImage: '16rpx',     // 大图、专题图
  input: '16rpx',          // 输入框
  button: '16rpx',         // 主按钮
  dialog: '24rpx',         // 弹窗/Bottom Sheet
  bottomSheet: '24rpx',
  capsule: '9999rpx',      // 胶囊筛选
}
