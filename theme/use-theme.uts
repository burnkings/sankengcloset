/**
 * useTheme — 主题切换 (Vapor 模块级兼容版)
 *
 * 三态偏好: system / light / dark
 * 存储键: v2_theme_mode
 *
 * Vapor 模式下模块顶层 ref()/computed() 没有活跃 effect scope，
 * 导致 n.value 返回 undefined → 全局白屏。
 * 解决方案：用 reactive + getter 代替 ref/computed。
 * reactive 对象在 vapor 模式下可被 Vue 追踪变化。
 */

import { reactive } from 'vue'
import { neutralLight, neutralDark, NeutralPalette, tabSelectedColor } from './tokens/colors'

const THEME_MODE_KEY = 'v2_theme_mode'
export type ThemeMode = 'system' | 'light' | 'dark'

const OLD_THEME_KEYS = ['sk_dark_mode', 'app_theme_mode', 'theme_dark_mode', 'sankeng_theme_mode']

function readStorageThemeMode(): ThemeMode {
  try {
    const current = uni.getStorageSync(THEME_MODE_KEY) as string
    if (current === 'system' || current === 'light' || current === 'dark') return current as ThemeMode
    // 迁移旧 key
    for (let i = 0; i < OLD_THEME_KEYS.length; i++) {
      const old = uni.getStorageSync(OLD_THEME_KEYS[i]) as string
      if (old === 'dark' || old === 'light') {
        uni.setStorageSync(THEME_MODE_KEY, old)
        return old as ThemeMode
      }
    }
    return 'system'
  } catch (e) {
    return 'system'
  }
}

function getSystemDark(): boolean {
  try {
    // #ifdef APP
    return uni.getDeviceInfo().osTheme == 'dark'
    // #endif
    // #ifdef MP-WEIXIN || WEB
    return uni.getAppBaseInfo().hostTheme == 'dark'
    // #endif
    return false
  } catch (e) {
    return false
  }
}
function computeIsDark(mode: ThemeMode): boolean {
  if (mode === 'dark') return true
  if (mode === 'light') return false
  return getSystemDark()
}

// getGlobalDark() 已删（2026-10-09）：全项目无调用方 —— 页面主题一律走 `n` / `isDark()` 读 _state，
// 没有第二份读 globalData.isDark 的实现。留着它只会让人误以为还有一条并行的主题来源。

/**
 * 写 globalData（供未来可能的跨 context 读取；当前仅写不读）。
 * ⚠️ 必须在 `_state.themeMode` / `_state.isDark` **赋值之后**调用，否则写进去的是上一版状态。
 */
function setGlobalDark(value: boolean) {
  try {
    const app = getApp() as UTSJSONObject
    let gd = app['globalData'] as UTSJSONObject | null
    if (gd == null) {
      gd = {} as UTSJSONObject
      app['globalData'] = gd
    }
    gd['isDark'] = value
    gd['themeMode'] = _state.themeMode
  } catch (e) {}
}

// ====== Vapor 兼容：reactive 状态 + getter ======

type ThemeState = {
  themeMode: ThemeMode
  isDark: boolean
  value: NeutralPalette
}

const _state = reactive<ThemeState>({
  themeMode: 'system',
  isDark: false,
  value: neutralLight,
})

// ====== Vapor 兼容：单一 reactive（合并主题状态，减少模块级响应式对象数量以降低 Active effect） ======
function applyPalette() {
  _state.value = (_state.isDark as boolean) ? neutralDark : neutralLight
}
let lastTabBarMode = ''
// #ifdef APP
let osThemeChangeId: number | null = null
// #endif
// #ifdef MP-WEIXIN
let hostThemeChangeId: number | null = null
// #endif

function syncFromGlobal(): boolean {
  const mode = readStorageThemeMode()
  const computedDark = computeIsDark(mode)
  const changed = _state.themeMode != mode || _state.isDark != computedDark
  if (changed) {
    _state.themeMode = mode
    _state.isDark = computedDark
    setGlobalDark(computedDark)
    // 这里**故意不调 applyPalette()**：调用方（initializeTheme / syncSystemChrome / initPageTheme）
    // 会在写完状态后自己按「原生先行、调色板后换」的顺序收尾。
    // 若在此处提前换调色板，就又回到「自绘层先变、原生层慢半拍」的老毛病（导航栏闪烁）。
  }
  return changed
}

function applySystemChrome() {
  // App 必须显式设置 appTheme；默认值始终为 light，单改页面 token 不会驱动原生 UI。
  // #ifdef APP
  const appTheme = (_state.themeMode == 'system' ? 'auto' : (_state.themeMode == 'dark' ? 'dark' : 'light')) as 'light' | 'dark' | 'auto'
  uni.setAppTheme({ theme: appTheme })
  // #endif
  // #ifdef MP-WEIXIN
  const palette = _state.isDark ? neutralDark : neutralLight
  try {
    uni.setNavigationBarColor({
      frontColor: _state.isDark ? '#ffffff' : '#000000',
      backgroundColor: palette.bg,
    })
  } catch (e) {}
  try {
    uni.setBackgroundColor({
      backgroundColor: palette.bg,
      backgroundColorTop: palette.bg,
      backgroundColorBottom: palette.bg,
    })
  } catch (e) {}
  // #endif
}

export function syncTabBarChrome() {
  // 原生 tabBar 全平台同步主题；App 与小程序共用这一套。
  const mode = _state.isDark ? 'dark' : 'light'
  if (lastTabBarMode === mode) return
  lastTabBarMode = mode
  uni.setTabBarStyle({
    color: _state.isDark ? neutralDark.textTertiary : neutralLight.textTertiary,
    // 选中色与 **tabBar 图标资源** 对齐（tabSelectedColor = #D65378 = tab-*-active.png 的像素色）。
    // 原生 tabBar 的选中图标是编译期固定 PNG（setTabBarItem 改不了图标路径），
    // 所以文字色必须跟着资源走，否则"图标一个粉、文字另一个粉"，同一项里出现两层深浅。
    selectedColor: tabSelectedColor,
    backgroundColor: _state.isDark ? neutralDark.surface : neutralLight.surface,
    borderStyle: _state.isDark ? 'white' : 'black',
    fail: () => { lastTabBarMode = '' },
  })
}

// ====== 系统主题变化监听 ======

function enableSystemThemeListener() {
  // #ifdef APP
  if (osThemeChangeId != null) return
  osThemeChangeId = uni.onOsThemeChange((result: OsThemeChangeResult) => {
    if (_state.themeMode !== 'system') return
    const newDark = result.osTheme == 'dark'
    if (_state.isDark != newDark) {
      _state.isDark = newDark
      setGlobalDark(newDark)
      lastTabBarMode = ''
      // 同 setThemeMode：原生先行、调色板后换
      applySystemChrome()
      syncTabBarChrome()
      applyPalette()
      notifyThemeChanged()
    }
  })
  // #endif
  // #ifdef MP-WEIXIN
  // 小程序端监听宿主系统主题变化（onHostThemeChange 可 off，微信 unixVer 4.41+）
  if (hostThemeChangeId != null) return
  hostThemeChangeId = uni.onHostThemeChange((result: OnHostThemeChangeCallbackResult) => {
    if (_state.themeMode !== 'system') return
    const newDark = result.hostTheme == 'dark'
    if (_state.isDark != newDark) {
      _state.isDark = newDark
      setGlobalDark(newDark)
      lastTabBarMode = ''
      // 同 setThemeMode：原生先行、调色板后换（否则跟随系统切换也会闪）
      applySystemChrome()
      syncTabBarChrome()
      applyPalette()
      notifyThemeChanged()
    }
  })
  // #endif
  // Web 端无系统主题监听：仅手动三态，不注册（getSystemDark 首次读取 hostTheme 兜底）
}

function disableSystemThemeListener() {
  // #ifdef APP
  const listenerId = osThemeChangeId
  if (listenerId != null) {
    uni.offOsThemeChange(listenerId)
    osThemeChangeId = null
  }
  // #endif
  // #ifdef MP-WEIXIN
  const hostListenerId = hostThemeChangeId
  if (hostListenerId != null) {
    uni.offHostThemeChange(hostListenerId)
    hostThemeChangeId = null
  }
  // #endif
}

// ====== 公开 API ======

export function initializeTheme() {
  syncFromGlobal()
  // 原生先行、调色板后换（理由见 setThemeMode 的注释）
  applySystemChrome()
  applyPalette()
  if (_state.themeMode === 'system') enableSystemThemeListener()
}

export function syncSystemChrome() {
  const changed = syncFromGlobal()
  if (changed) {
    applySystemChrome()
    applyPalette()
  }
}

export function initPageTheme() {
  syncFromGlobal()
  applySystemChrome()
  syncTabBarChrome()
  applyPalette()
}

/**
 * 主题变更事件广播：通知已打开页面即时刷新。
 * 页面侧如需实时刷新可 uni.$on('theme:changed') 订阅（onUnload 配对 $off）；
 * 多数页面已有 onShow → initPageTheme 兜底，本事件用于「已停留页面」的即时同步。
 */
export function notifyThemeChanged() {
  uni.$emit('theme:changed')
}

/**
 * 设置三态主题模式
 * @param mode 'system' | 'light' | 'dark'
 *
 * ⚠️ 顺序是修「深色首次切换导航栏闪一下」的关键（2026-10-09），不要调换：
 *   1. 先写 _state.themeMode / isDark + globalData —— 纯内存，不触发渲染；
 *   2. 再调 applySystemChrome() / syncTabBarChrome() —— **原生** API，本帧立即生效；
 *   3. 最后 applyPalette() —— 换调色板，触发自绘 UI 的重渲染。
 *
 * 原因是两套主题通道走不同的时序：
 *   · 原生导航栏/tabBar → theme.json + 这几个 uni API，**同步生效**，不依赖渲染帧；
 *   · 自绘导航栏（AppNavbar 的 n.value.bg）→ script 计算，要等**下一个渲染帧**。
 * 若先 applyPalette，自绘层立即重排、原生层却慢半拍；首次切换时（无缓存、原生 api 冷调用）
 * 这个差值就露出来一帧 ⇒ 导航栏闪一下。把原生放在调色板之前，两边同帧到位。
 * 官方文档同款说明：动态切换class 与 theme.json「可能不在同一帧，会造成一种闪烁感」。
 */
export function setThemeMode(mode: ThemeMode) {
  _state.themeMode = mode
  _state.isDark = computeIsDark(mode)
  setGlobalDark(_state.isDark as boolean)
  uni.setStorageSync(THEME_MODE_KEY, mode)
  lastTabBarMode = ''
  // 原生 chrome 先行（同帧、同步生效），再换调色板（下一帧生效）
  applySystemChrome()
  syncTabBarChrome()
  applyPalette()

  if (mode === 'system') {
    enableSystemThemeListener()
  } else {
    disableSystemThemeListener()
  }
  notifyThemeChanged()
}

/**
 * 向下兼容：切换暗色/亮色（会退出 system 模式）
 */
export function setDarkMode(enabled: boolean) {
  setThemeMode(enabled ? 'dark' : 'light')
}

export function toggleDarkMode(): boolean {
  const next = _state.themeMode === 'dark' ? 'light' : 'dark'
  setThemeMode(next)
  return _state.isDark as boolean
}

/**
 * useTheme 的返回载体：必须是 **class getter**（与 stores/*-store.uts 的 XxxStoreHandle 同一模式）。
 * 禁止用对象字面量 getter —— UTS 会把它包成 UTSJSONObject 并当场求值冻结（见文件末尾说明）。
 */
export class ThemeUse {
  get isDark(): boolean { return _state.isDark as boolean }
  get themeMode(): ThemeMode { return _state.themeMode as ThemeMode }
  get neutral(): NeutralPalette { return (_state.isDark as boolean) ? neutralDark : neutralLight }
}

export function useTheme(): ThemeUse {
  syncFromGlobal()
  return new ThemeUse()
}

export function getThemeLabel(): string {
  const mode = _state.themeMode as ThemeMode
  if (mode === 'system') return '跟随系统'
  if (mode === 'dark') return '深色'
  return '浅色'
}

/**
 * Vapor 兼容：n 直接指向单一 reactive（n.value = _state.value 响应）。
 *
 * ⚠️ 2026-09-24 修复（深色模式「白卡片」根因）：
 * isDark / themeMode 曾导出为对象字面量 getter —— `{ get value() { return _state.isDark } }`。
 * UTS 会把对象字面量编译成 `new UTSJSONObject({ ... })`，而 UTSJSONObject 的构造函数是
 * `for (const key in content) this[key] = content[key]`（见 unpackage/dist/dev/mp-weixin/common/vendor.js），
 * 这会**立刻求值一次 getter**，把结果当成普通数据属性复制进去 —— getter 本身没有被保留。
 * 于是 theme 模块加载时（_state.isDark 初始为 false）`isDark.value` 被永久冻结为 `false`：
 * 深色模式下所有 `isDark.value ? 深色 token : 浅色 token` 永远走**浅色分支**。
 * 表现：通知页未读卡片在深色下仍是 brand[50] 浅粉白底，标记已读后（走实时 n.value.surface）才是深色。
 * 结论：跨模块读取响应式状态**只能**用函数或 reactive 对象本身，禁止对象字面量 getter。
 */
export const n = _state
/** 当前是否深色：每次调用都真实读 _state.isDark，渲染 effect 内可正常收集依赖 */
export function isDark(): boolean { return _state.isDark as boolean }
/** 当前三态偏好：system / light / dark（同上，禁止改回 getter 对象） */
export function themeMode(): ThemeMode { return _state.themeMode as ThemeMode }

// ====== 模块加载即定调色板（2026-09-30：修「深色模式首次切页面闪一下白」）======
// 之前调色板只在 App.onLaunch 的 nextTick 里初始化，而**页面首帧渲染早于它**；
// 深色用户于是能看到一帧浅色底（换页面时尤其明显，因为新页面重新走一遍首帧）。
// 这里在模块求值阶段（任何渲染 effect 建立之前）就写定 _state：
//   · 只做纯内存读/写（读 storage 走已有 try/catch），**不碰任何 uni 原生 API** ——
//     原生 chrome（导航栏/tabBar/setAppTheme）仍然由 initializeTheme / initPageTheme 负责，
//     避免在无 effect scope 时调用原生接口。
// 这样任何页面第一次知道「自己是什么底色」，答案就已经是对的。
//
// 2026-10-09 补：这里**同时**写一次 globalData。
// 此前只写 _state、不写 globalData ⇒ 冷启动到首次 initializeTheme() 之间，
// globalData.isDark 一直是 undefined；而原生 chrome（setNavigationBarColor / setBackgroundColor）
// 在**手动切换**时才被调用，于是「首次切换深色」会先按旧状态刷一帧原生导航栏底色
// （theme.json 自己那层是另一条通路、在同一帧里各走各的）⇒ 导航栏闪一下。
// 提前把两份状态一起定死，首帧就一致。
try {
  const bootMode = readStorageThemeMode()
  _state.themeMode = bootMode
  _state.isDark = computeIsDark(bootMode)
  applyPalette()
  setGlobalDark(_state.isDark as boolean)
} catch (e) {}
