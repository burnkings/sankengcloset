/**
 * useTheme — 主题切换 (Vapor 模块级兼容版)
 *
 * Vapor 模式下模块顶层 ref()/computed() 没有活跃 effect scope，
 * 导致 n.value 返回 undefined → 全局白屏。
 * 解决方案：用 reactive + getter 代替 ref/computed。
 * reactive 对象在 vapor 模式下可被 Vue 追踪变化。
 */

import { neutralLight, neutralDark, brand } from './tokens/colors'

const THEME_STORAGE_KEY = 'sankeng_theme_mode'
const OLD_THEME_KEYS = ['sk_dark_mode', 'app_theme_mode', 'theme_dark_mode']

function readStorageDarkMode(): boolean {
  try {
    const current = uni.getStorageSync(THEME_STORAGE_KEY) as string
    if (current === 'dark') return true
    if (current === 'light') return false
    for (let i = 0; i < OLD_THEME_KEYS.length; i++) {
      const old = uni.getStorageSync(OLD_THEME_KEYS[i]) as string
      if (old === 'dark' || old === 'light') {
        uni.setStorageSync(THEME_STORAGE_KEY, old)
        return old === 'dark'
      }
    }
    return false
  } catch (e) {
    return false
  }
}

function getGlobalDark(): boolean {
  try {
    const app = getApp()
    if (app != null && app.globalData != null) {
      const val = app.globalData['isDark']
      if (val != null) return val as boolean
    }
  } catch (e) {}
  return readStorageDarkMode()
}

function setGlobalDark(value: boolean) {
  try {
    const app = getApp()
    if (app != null) {
      if (app.globalData == null) app.globalData = {}
      app.globalData['isDark'] = value
    }
  } catch (e) {}
}

// ====== Vapor 兼容：reactive 状态 + getter ======

const _state = reactive({ isDark: false })
let lastTabBarMode = ''

function syncFromGlobal(): boolean {
  const globalDark = getGlobalDark()
  const changed = _state.isDark !== globalDark
  if (changed) {
    _state.isDark = globalDark
  }
  return changed
}

function applySystemChrome() {
  // #ifdef MP-WEIXIN
  const palette = _state.isDark ? neutralDark : neutralLight
  uni.setNavigationBarColor({
    frontColor: _state.isDark ? '#ffffff' : '#000000',
    backgroundColor: palette.bg,
  })
  uni.setBackgroundColor({
    backgroundColor: palette.bg,
    backgroundColorTop: palette.bg,
    backgroundColorBottom: palette.bg,
  })
  // #endif
}

export function syncTabBarChrome() {
  // #ifdef MP-WEIXIN
  syncFromGlobal()
  const mode = _state.isDark ? 'dark' : 'light'
  if (lastTabBarMode === mode) return
  lastTabBarMode = mode
  uni.setTabBarStyle({
    color: _state.isDark ? neutralDark.textTertiary : neutralLight.textTertiary,
    selectedColor: brand[500],
    backgroundColor: _state.isDark ? neutralDark.surface : neutralLight.surface,
    borderStyle: _state.isDark ? 'white' : 'black',
    fail: () => { lastTabBarMode = '' },
  })
  // #endif
}

export function initializeTheme() {
  syncFromGlobal()
  applySystemChrome()
}

export function syncSystemChrome() {
  const changed = syncFromGlobal()
  if (changed) applySystemChrome()
}

export function initPageTheme() {
  syncFromGlobal()
  applySystemChrome()
  syncTabBarChrome()
}

export function setDarkMode(enabled: boolean) {
  _state.isDark = enabled
  setGlobalDark(enabled)
  uni.setStorageSync(THEME_STORAGE_KEY, enabled ? 'dark' : 'light')
  lastTabBarMode = ''
  applySystemChrome()
  syncTabBarChrome()
}

export function toggleDarkMode(): boolean {
  setDarkMode(!_state.isDark)
  return _state.isDark
}

export function useTheme() {
  syncFromGlobal()
  return {
    get isDark(): boolean { return _state.isDark },
    get neutral(): any { return _state.isDark ? neutralDark : neutralLight },
  }
}

/** Getter — Vue 可追踪 _state.isDark 的变化 */
export const isDark = {
  get value(): boolean {
    return _state.isDark
  }
}

export const n = {
  get value(): any {
    return _state.isDark ? neutralDark : neutralLight
  }
}
