/**
 * useTheme — 主题切换 (Vapor 模块级兼容版)
 *
 * 三态偏好: system / light / dark
 * 存储键: v2_theme_mode
 *
 * Vapor 模式下模块顶层 ref()/computed() 没有活跃 effect scope，
 * 导致 n.value 返回 undefined → 全局白屏。
 * 解决方案：用 reactive + getter 代替 ref/computed。
 * reactive 对象在 vapor 模式下可被 Vue 追踪变化。
 */

import { reactive, computed } from 'vue'
import { neutralLight, neutralDark, brand, NeutralPalette } from './tokens/colors'

const THEME_MODE_KEY = 'v2_theme_mode'
type ThemeMode = 'system' | 'light' | 'dark'

const OLD_THEME_KEYS = ['sk_dark_mode', 'app_theme_mode', 'theme_dark_mode', 'sankeng_theme_mode']

function readStorageThemeMode(): ThemeMode {
  try {
    const current = uni.getStorageSync(THEME_MODE_KEY) as string
    if (current === 'system' || current === 'light' || current === 'dark') return current as ThemeMode
    // 迁移旧 key
    for (let i = 0; i < OLD_THEME_KEYS.length; i++) {
      const old = uni.getStorageSync(OLD_THEME_KEYS[i]) as string
      if (old === 'dark' || old === 'light') {
        uni.setStorageSync(THEME_MODE_KEY, old)
        return old as ThemeMode
      }
    }
    return 'system'
  } catch (e) {
    return 'system'
  }
}

function getSystemDark(): boolean {
  try {
    const info = uni.getSystemInfoSync() as UTSJSONObject
    const theme = info['theme'] as string | null
    return theme === 'dark'
  } catch (e) {
    return false
  }
}

function computeIsDark(mode: ThemeMode): boolean {
  if (mode === 'dark') return true
  if (mode === 'light') return false
  return getSystemDark()
}

function getGlobalDark(): boolean {
  try {
    const app = getApp() as UTSJSONObject
    const gd = app['globalData'] as UTSJSONObject | null
    if (gd != null) {
      const val = gd['isDark']
      if (val != null) return val as boolean
    }
  } catch (e) {}
  return computeIsDark(readStorageThemeMode())
}

function setGlobalDark(value: boolean) {
  try {
    const app = getApp() as UTSJSONObject
    let gd = app['globalData'] as UTSJSONObject | null
    if (gd == null) {
      gd = {} as UTSJSONObject
      app['globalData'] = gd
    }
    gd['isDark'] = value
  } catch (e) {}
  try {
    const app = getApp() as UTSJSONObject
    const gd = app['globalData'] as UTSJSONObject | null
    if (gd != null) {
      gd['themeMode'] = _state.themeMode
    }
  } catch (e) {}
}

// ====== Vapor 兼容：reactive 状态 + getter ======

type ThemeState = {
  themeMode: ThemeMode
  isDark: boolean
}

const _state = reactive<ThemeState>({
  themeMode: 'system',
  isDark: false,
})
let lastTabBarMode = ''
let themeChangeHandler: (() => void) | null = null

function syncFromGlobal(): boolean {
  const mode = readStorageThemeMode()
  const computedDark = computeIsDark(mode)
  const changed = _state.themeMode !== mode || _state.isDark !== computedDark
  if (changed) {
    _state.themeMode = mode
    _state.isDark = computedDark
    setGlobalDark(computedDark)
  }
  return changed
}

function applySystemChrome() {
  // #ifdef MP-WEIXIN
  const palette = _state.isDark ? neutralDark : neutralLight
  uni.setNavigationBarColor({
    frontColor: _state.isDark ? '#ffffff' : '#000000',
    backgroundColor: palette.bg,
  })
  uni.setBackgroundColor({
    backgroundColor: palette.bg,
    backgroundColorTop: palette.bg,
    backgroundColorBottom: palette.bg,
  })
  // #endif
}

export function syncTabBarChrome() {
  // #ifdef MP-WEIXIN
  const mode = _state.isDark ? 'dark' : 'light'
  if (lastTabBarMode === mode) return
  lastTabBarMode = mode
  uni.setTabBarStyle({
    color: _state.isDark ? neutralDark.textTertiary : neutralLight.textTertiary,
    selectedColor: brand[500],
    backgroundColor: _state.isDark ? neutralDark.surface : neutralLight.surface,
    borderStyle: _state.isDark ? 'white' : 'black',
    fail: () => { lastTabBarMode = '' },
  })
  // #endif
}

// ====== 系统主题变化监听 ======

function enableSystemThemeListener() {
  if (themeChangeHandler) return
  themeChangeHandler = () => {
    if (_state.themeMode !== 'system') return
    const newDark = getSystemDark()
    if (_state.isDark !== newDark) {
      _state.isDark = newDark
      setGlobalDark(newDark)
      lastTabBarMode = ''
      applySystemChrome()
      syncTabBarChrome()
    }
  }
  // #ifdef MP-WEIXIN
  uni.onThemeChange(themeChangeHandler)
  // #endif
}

function disableSystemThemeListener() {
  // #ifdef MP-WEIXIN
  if (themeChangeHandler) {
    uni.offThemeChange(themeChangeHandler)
    themeChangeHandler = null
  }
  // #endif
}

// ====== 公开 API ======

export function initializeTheme() {
  syncFromGlobal()
  applySystemChrome()
  if (_state.themeMode === 'system') enableSystemThemeListener()
}

export function syncSystemChrome() {
  const changed = syncFromGlobal()
  if (changed) applySystemChrome()
}

export function initPageTheme() {
  syncFromGlobal()
  applySystemChrome()
  syncTabBarChrome()
}

/**
 * 设置三态主题模式
 * @param mode 'system' | 'light' | 'dark'
 */
export function setThemeMode(mode: ThemeMode) {
  _state.themeMode = mode
  _state.isDark = computeIsDark(mode)
  setGlobalDark(_state.isDark as boolean)
  uni.setStorageSync(THEME_MODE_KEY, mode)
  lastTabBarMode = ''
  applySystemChrome()
  syncTabBarChrome()

  if (mode === 'system') {
    enableSystemThemeListener()
  } else {
    disableSystemThemeListener()
  }
}

/**
 * 向下兼容：切换暗色/亮色（会退出 system 模式）
 */
export function setDarkMode(enabled: boolean) {
  setThemeMode(enabled ? 'dark' : 'light')
}

export function toggleDarkMode(): boolean {
  const next = _state.themeMode === 'dark' ? 'light' : 'dark'
  setThemeMode(next)
  return _state.isDark as boolean
}

export function useTheme() {
  syncFromGlobal()
  return {
    get isDark(): boolean { return _state.isDark as boolean },
    get themeMode(): ThemeMode { return _state.themeMode as ThemeMode },
    get neutral(): NeutralPalette { return (_state.isDark as boolean) ? neutralDark : neutralLight },
  }
}

export function getThemeLabel(): string {
  const mode = _state.themeMode as ThemeMode
  if (mode === 'system') return '跟随系统'
  if (mode === 'dark') return '深色'
  return '浅色'
}

/** Computed — Vue 可追踪 _state.isDark 的变化 */
export const isDark = computed((): boolean => {
  return _state.isDark as boolean
})

/** Computed — Vue 可追踪 _state.themeMode 的变化 */
export const themeMode = computed((): ThemeMode => {
  return _state.themeMode as ThemeMode
})

export const n = computed((): NeutralPalette => {
  return (_state.isDark as boolean) ? neutralDark : neutralLight
})
