/**
 * useTheme — 主题切换
 * 
 * 注意：不要解构返回值，直接用 theme.isDark / theme.n
 * UTS→Kotlin 编译器不支持对象解构
 */

import { neutralLight, neutralDark, brand } from './tokens/colors'

const THEME_STORAGE_KEY = 'sk_theme_mode'

function readInitialDarkMode(): boolean {
  try {
    return (uni.getStorageSync(THEME_STORAGE_KEY) as string) === 'dark'
  } catch (e) {
    return false
  }
}

// 在模块第一次求值时就确定主题，避免首个页面先浅色渲染再跳成深色。
const _isDark = ref(readInitialDarkMode())
const _neutral = computed(() => _isDark.value ? neutralDark : neutralLight)
let lastTabBarMode = ''

function applySystemChrome() {
  const palette = _isDark.value ? neutralDark : neutralLight
  uni.setNavigationBarColor({
    frontColor: _isDark.value ? '#ffffff' : '#000000',
    backgroundColor: palette.bg,
  })
  uni.setBackgroundColor({
    backgroundColor: palette.bg,
    backgroundColorTop: palette.bg,
    backgroundColorBottom: palette.bg,
  })
}

/** Only call from actual native tab pages. Secondary pages must not call setTabBarStyle. */
export function syncTabBarChrome() {
  // #ifdef MP-WEIXIN
  const mode = _isDark.value ? 'dark' : 'light'
  if (lastTabBarMode === mode) return
  lastTabBarMode = mode
  uni.setTabBarStyle({
    color: _isDark.value ? neutralDark.textTertiary : neutralLight.textTertiary,
    selectedColor: brand[500],
    backgroundColor: _isDark.value ? neutralDark.surface : neutralLight.surface,
    borderStyle: _isDark.value ? 'white' : 'black',
    fail: () => { lastTabBarMode = '' },
  })
  // #endif
}

export function initializeTheme() {
  applySystemChrome()
}

export function syncSystemChrome() {
  applySystemChrome()
}

/** Tab 页 onLoad 阶段调用：同步主题 + 系统栏 + TabBar，避免首帧闪白 */
export function initPageTheme() {
  applySystemChrome()
  syncTabBarChrome()
  // 同步设置当前页面背景，减少异步 API 延迟导致的闪白
  try {
    const palette = _isDark.value ? neutralDark : neutralLight
    uni.setBackgroundColor({
      backgroundColor: palette.bg,
      backgroundColorTop: palette.bg,
      backgroundColorBottom: palette.bg,
    })
  } catch (e) {}
}

export function setDarkMode(enabled: boolean) {
  if (_isDark.value === enabled) return
  _isDark.value = enabled
  uni.setStorageSync(THEME_STORAGE_KEY, enabled ? 'dark' : 'light')
  // 重置缓存，确保下次 syncTabBarChrome 一定会重新应用
  lastTabBarMode = ''
  applySystemChrome()
  syncTabBarChrome()
}

export function toggleDarkMode(): boolean {
  setDarkMode(!_isDark.value)
  return _isDark.value
}

export function useTheme() {
  return {
    isDark: _isDark,
    neutral: _neutral,
  }
}

/** 直接导出，避免解构 */
export const isDark = _isDark
export const n = _neutral
