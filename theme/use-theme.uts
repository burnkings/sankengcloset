/**
 * useTheme — 主题切换
 * 
 * 小程序每个页面有独立 JS 上下文，module-level ref 不跨页面共享。
 * 解决方案：通过 getApp().globalData.isDark 存储全局深色模式状态
 * 每次读取都从 globalData 取值，确保跨页面同步。
 *
 * 注意：不要解构返回值，直接用 theme.isDark / theme.n
 * UTS→Kotlin 编译器不支持对象解构
 */

import { neutralLight, neutralDark, brand } from './tokens/colors'

const THEME_STORAGE_KEY = 'sankeng_theme_mode'
const OLD_THEME_KEYS = ['sk_dark_mode', 'app_theme_mode', 'theme_dark_mode']

function readStorageDarkMode(): boolean {
  try {
    // 1. 先读新 key
    const current = uni.getStorageSync(THEME_STORAGE_KEY) as string
    if (current === 'dark') return true
    if (current === 'light') return false
    // 2. 迁移旧 key（老版本升级时保留用户偏好）
    for (let i = 0; i < OLD_THEME_KEYS.length; i++) {
      const old = uni.getStorageSync(OLD_THEME_KEYS[i]) as string
      if (old === 'dark' || old === 'light') {
        uni.setStorageSync(THEME_STORAGE_KEY, old)
        return old === 'dark'
      }
    }
    return false
  } catch (e) {
    return false
  }
}

// ====== 全局状态（跨页面共享） ======

function getGlobalDark(): boolean {
  try {
    const app = getApp()
    if (app != null && app.globalData != null) {
      const val = app.globalData['isDark']
      if (val != null) return val as boolean
    }
  } catch (e) {}
  return readStorageDarkMode()
}

function setGlobalDark(value: boolean) {
  try {
    const app = getApp()
    if (app != null) {
      if (app.globalData == null) app.globalData = {}
      app.globalData['isDark'] = value
    }
  } catch (e) {}
}

// 本地 ref：初始化时从 globalData 或 storage 读取
const _isDark = ref(getGlobalDark())
const _neutral = computed(() => _isDark.value ? neutralDark : neutralLight)
let lastTabBarMode = ''

// 每次访问 isDark 时，强制同步 globalData（跨页面一致性保障）
function syncFromGlobal() {
  const globalDark = getGlobalDark()
  if (_isDark.value !== globalDark) {
    _isDark.value = globalDark
    lastTabBarMode = ''
  }
}

function applySystemChrome() {
  const palette = _isDark.value ? neutralDark : neutralLight
  uni.setNavigationBarColor({
    frontColor: _isDark.value ? '#ffffff' : '#000000',
    backgroundColor: palette.bg,
  })
  uni.setBackgroundColor({
    backgroundColor: palette.bg,
    backgroundColorTop: palette.bg,
    backgroundColorBottom: palette.bg,
  })
}

/** Only call from actual native tab pages. Secondary pages must not call setTabBarStyle. */
export function syncTabBarChrome() {
  // #ifdef MP-WEIXIN
  syncFromGlobal()
  const mode = _isDark.value ? 'dark' : 'light'
  if (lastTabBarMode === mode) return
  lastTabBarMode = mode
  uni.setTabBarStyle({
    color: _isDark.value ? neutralDark.textTertiary : neutralLight.textTertiary,
    selectedColor: brand[500],
    backgroundColor: _isDark.value ? neutralDark.surface : neutralLight.surface,
    borderStyle: _isDark.value ? 'white' : 'black',
    fail: () => { lastTabBarMode = '' },
  })
  // #endif
}

export function initializeTheme() {
  syncFromGlobal()
  applySystemChrome()
}

export function syncSystemChrome() {
  syncFromGlobal()
  applySystemChrome()
}

/**
 * Tab 页 onLoad 阶段调用：从 globalData 同步 + 应用系统栏 + TabBar
 */
export function initPageTheme() {
  syncFromGlobal()
  applySystemChrome()
  lastTabBarMode = ''
  syncTabBarChrome()
}

export function setDarkMode(enabled: boolean) {
  _isDark.value = enabled
  // 写入全局 + storage
  setGlobalDark(enabled)
  uni.setStorageSync(THEME_STORAGE_KEY, enabled ? 'dark' : 'light')
  // 重置缓存
  lastTabBarMode = ''
  applySystemChrome()
  syncTabBarChrome()
}

export function toggleDarkMode(): boolean {
  setDarkMode(!_isDark.value)
  return _isDark.value
}

export function useTheme() {
  syncFromGlobal()
  return {
    isDark: _isDark,
    neutral: _neutral,
  }
}

/** 直接导出，避免解构。每次访问前先同步 globalData */
export const isDark = _isDark
export const n = _neutral
