/**
 * Grid Design System — UniApp X 网格布局
 */

export function createGrid(columns: number, gap: string = '16rpx'): any {
  return { flexDirection: 'row', flexWrap: 'wrap', gap: gap } as UTSJSONObject
}

export function createGridItem(columns: number): any {
  const gapRatio = (columns - 1) * 3
  const width = Math.floor((100 - gapRatio) / columns)
  return { width: `${width}%` } as UTSJSONObject
}

export const grid2 = createGrid(2)
export const grid2Item = createGridItem(2)
export const grid3 = createGrid(3)
export const grid3Item = createGridItem(3)
export const grid4 = createGrid(4)
export const grid4Item = createGridItem(4)
