/**
 * category — 坑向分类 label ↔ code 双向映射（唯一实现）
 * 供 wardrobe-store、衣柜页、心愿单等共享，避免各页面重复定义映射。
 *
 * ⚠️ 2026-09-26 修复：categoryLabelToCode 以前返回的是 CATEGORY_LABELS_CLASS.*（label），
 * 于是 'JK' → 'JK制服'、'Lolita' → 'Lolita'，而 wardrobe-store 是拿它跟 DB 里的
 * category 码（'JK'/'LOLITA'/…）直接比较的 → 衣柜页任何品类 chip 都筛出 0 条。
 * 两个方向的返回值必须是「码 → label」「label/码 → 码」。**勿再改回返回 label。**
 */
import {
  CATEGORY_LABELS_CLASS,
  CATEGORY_JK,
  CATEGORY_LOLITA,
  CATEGORY_HANFU,
  CATEGORY_MIXED,
  CATEGORY_OTHER,
} from '@/domain/clothing-category'

/** code → 展示 label（如 'LOLITA' → 'Lolita'） */
export function categoryCodeToLabel(code: string): string {
  if (code == CATEGORY_JK) return CATEGORY_LABELS_CLASS.JK
  if (code == CATEGORY_LOLITA) return CATEGORY_LABELS_CLASS.LOLITA
  if (code == CATEGORY_HANFU) return CATEGORY_LABELS_CLASS.HANFU
  if (code == CATEGORY_MIXED) return CATEGORY_LABELS_CLASS.MIXED
  return CATEGORY_LABELS_CLASS.OTHER
}

/** 展示 label 或 code → code（'Lolita' → 'LOLITA'；已是码则原样返回） */
export function categoryLabelToCode(label: string): string {
  if (label == CATEGORY_JK || label == CATEGORY_LABELS_CLASS.JK) return CATEGORY_JK
  if (label == CATEGORY_LOLITA || label == CATEGORY_LABELS_CLASS.LOLITA) return CATEGORY_LOLITA
  if (label == CATEGORY_HANFU || label == CATEGORY_LABELS_CLASS.HANFU) return CATEGORY_HANFU
  if (label == CATEGORY_MIXED || label == CATEGORY_LABELS_CLASS.MIXED) return CATEGORY_MIXED
  if (label == CATEGORY_OTHER || label == CATEGORY_LABELS_CLASS.OTHER) return CATEGORY_OTHER
  return label
}
