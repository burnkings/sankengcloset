// #ifdef APP-ANDROID
import { requestNotificationPermission } from '@/uni_modules/reminder-permission'
import { showLocalNotification } from '@/uni_modules/local-notify'
// #endif
/**
 * notify — 本地通知栏消息
 * 说明：Android 走自研 UTS 插件 `local-notify`（前台生效，不依赖 uni-push）；
 *       其它平台降级为应用内 Toast 提示。
 * 注意：自研 UTS 插件需自定义基座才能在真机生效，标准基座下会走降级提示。
 */

export function notificationAuthorized(): boolean {
  try {
    // #ifdef APP
    const auth = uni.getAppAuthorizeSetting().notificationAuthorized
    return auth == 'authorized'
    // #endif
    return true
  } catch (e) {
    return false
  }
}

export function openNotificationSetting() {
  // #ifdef APP
  uni.openAppAuthorizeSetting()
  // #endif
}

function targetTimestamp(dateStr: string, timeStr: string): number {
  try {
    const date = new Date(dateStr + (timeStr !== '' ? 'T' + timeStr + ':00' : 'T09:00:00'))
    const t = date.getTime()
    return isNaN(t) ? 0 : t
  } catch (e) {
    return 0
  }
}

/**
 * 调度一条本地通知：在 remindDate + remindTime 时刻弹出。
 * 未授权通知权限或目标时刻已过则静默跳过（权限流程由页面在保存前处理）。
 * key 用于去重：同一 key 在 60s 内仅调度一次，避免提醒编辑/联动反复叠加相同通知。
 */
const lastScheduled = {} as UTSJSONObject
export function scheduleReminderNotification(title: string, content: string, remindDate: string, remindTime: string, key: string = ''): void {
  if (title === '' || remindDate === '') return
  if (!notificationAuthorized()) return
  const when = targetTimestamp(remindDate, remindTime)
  if (when <= 0) return
  const now = Date.now()
  if (when <= now) return
  const delay = Math.floor((when - now) / 1000)
  if (delay <= 0) return
  // 同 key 60s 内去重（平台无取消/去重接口，仅能避免重复调度）
  if (key !== '') {
    const prev = lastScheduled[key] != null ? lastScheduled[key] as number : 0
    if (now - prev < 60000) return
  }
  // #ifdef APP-ANDROID
  try {
    showLocalNotification({ title: title, content: content, delaySeconds: delay })
    if (key !== '') lastScheduled[key] = now
  } catch (e) {
    // 标准基座不含该插件：静默跳过，避免多余浮层
  }
  // #endif
}

// Called by an explicit save action; no calendar access because no calendar event is written.
export async function ensureReminderNotificationPermission(): Promise<boolean> {
  if (notificationAuthorized()) return true
  // #ifdef APP-ANDROID
  try { await requestNotificationPermission() } catch (e) { /* Keep the in-app reminder available. */ }
  if (notificationAuthorized()) return true
  // #endif
  // #ifdef APP
  return new Promise<boolean>((resolve) => {
    uni.showModal({ title: '开启提醒通知', content: '需要系统通知权限才能显示到点通知。你也可以先保存提醒。',
      confirmText: '去设置', cancelText: '先保存',
      success: (result) => { if (result.confirm) openNotificationSetting(); resolve(false) },
      fail: () => { resolve(false) } })
  })
  // #endif
  // #ifndef APP
  return false
  // #endif
}
