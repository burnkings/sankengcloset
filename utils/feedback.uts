import { reactive } from 'vue'

const _feedback = reactive<{ visible: boolean; message: string }>({ visible: false, message: '' })
let feedbackSequence = 0

export function showFeedback(message: string) {
  feedbackSequence += 1
  const currentSequence = feedbackSequence
  _feedback.message = message
  _feedback.visible = true
  setTimeout(() => {
    if (currentSequence === feedbackSequence) _feedback.visible = false
  }, 1800)
}

export function hideFeedback() {
  feedbackSequence += 1
  _feedback.visible = false
}

export const feedbackState = _feedback
