<template>
  <view :style="cardStyle" @tap="emit('tap')">
    <!-- 排名徽标 + 图片 -->
    <view :style="leftWrap">
      <view :style="rankBadge(rankStyle)"><text :style="rankText(rankStyle)">{{ item.rank }}</text></view>
      <view :style="imageWrap">
        <AppImage :src="item.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
      </view>
    </view>

    <!-- 信息区 -->
    <view :style="infoWrap">
      <view :style="titleRow">
        <text :style="titleStyle">{{ item.title }}</text>

      </view>
      <view :style="brandRow">
        <text :style="brandStyle">{{ item.brandName }}</text>
        <text :style="priceStyle">{{ priceText }}</text>
      </view>

      <!-- 热榜 -->
      <template v-if="variant === 'hot'">
        <view :style="tagRow">
          <view :style="categoryTag"><text :style="categoryTagText">{{ item.category }}</text></view>
          <text :style="hotText">{{ item.favoriteCount }} 人收藏</text>
        </view>
      </template>

      <!-- 收藏榜 -->
      <template v-else-if="variant === 'favorite'">
        <view :style="tagRow">
          <view :style="categoryTag"><text :style="categoryTagText">{{ item.category }}</text></view>
          <text :style="hotText">已被收藏 {{ item.favoriteCount }} 次</text>
        </view>
      </template>

      <!-- 上新榜 -->
      <template v-else-if="variant === 'new'">
        <view :style="tagRow">
          <view :style="releaseTag"><text :style="releaseTagText">{{ item.releaseTypeName }}</text></view>
          <text :style="metaText">{{ item.daysAgo }} 天前上新</text>
        </view>
      </template>

    </view>
  </view>
</template>

<script setup lang="uts">
import AppImage from '@/components/base/AppImage.uvue'
import { RankingItem } from '@/domain/ranking/ranking-item'
import { formatPriceCents } from '@/utils/format'
import { brand } from '@/theme/tokens/colors'
import { v3TextStyle } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  item: RankingItem
  variant: string   // 'hot' | 'new' | 'favorite'
}>(), { item: new RankingItem(), variant: 'hot' })

const emit = defineEmits<{ tap: [] }>()

const rankStyle = computed((): string => {
  if (props.item.rank === 1) return 'gold'
  if (props.item.rank === 2) return 'silver'
  if (props.item.rank === 3) return 'bronze'
  return 'normal'
})
function rankBadgeBg(style: string): string {
  if (style === 'gold') return 'rgba(212,175,55,0.16)'
  if (style === 'silver') return 'rgba(168,168,168,0.20)'
  if (style === 'bronze') return 'rgba(184,115,51,0.16)'
  return n.value.bgSecondary
}
const priceText = computed((): string => formatPriceCents(props.item.priceCents))

function rankColor(style: string): string {
  if (style === 'gold') return '#D4AF37'
  if (style === 'silver') return '#A8A8A8'
  if (style === 'bronze') return '#B87333'
  return n.value.text
}

const cardStyle = computed((): any => ({
  ...flexRow,
  alignItems: 'center',
  backgroundColor: n.value.surface,
  borderRadius: '20rpx',
  padding: '24rpx',
  marginBottom: '24rpx',
  borderWidth: '1rpx',
  borderStyle: 'solid',
  borderColor: n.value.border,
}))
const leftWrap = { ...flexRow, alignItems: 'center', marginRight: '24rpx' }
const rankBadge = (style: string): any => ({ width: '56rpx', height: '56rpx', borderRadius: '28rpx', alignItems: 'center', justifyContent: 'center', marginRight: '16rpx', backgroundColor: rankBadgeBg(style) })
const rankText = (style: string): any => ({ fontSize: style === 'gold' ? '40rpx' : style === 'normal' ? '28rpx' : '36rpx', fontWeight: style === 'gold' ? 700 : style === 'normal' ? 500 : 600, color: rankColor(style) })
const imageWrap = computed((): any => ({ width: '120rpx', height: '120rpx', borderRadius: '16rpx', overflow: 'hidden', backgroundColor: n.value.bgSecondary, position: 'relative' as string }))
const infoWrap = { flex: 1 }
const titleRow = { ...flexRow, alignItems: 'center' }
const titleStyle = computed((): any => ({ fontSize: v3TextStyle.body.fontSize, fontWeight: 500, color: n.value.text, lines: 1, textOverflow: 'ellipsis', flex: 1 }))
// 品牌 + 价格同行：品牌左 flex 单行省略，价格右对齐，横向充实
const brandRow = { ...flexRow, alignItems: 'center', marginTop: '4rpx' }
const brandStyle = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, color: n.value.textSecondary, flex: 1, lines: 1, textOverflow: 'ellipsis' }))
const priceStyle = computed((): any => ({ fontSize: '30rpx', fontWeight: 600, color: brand.strong, flexShrink: 0, marginLeft: '12rpx' }))
const tagRow = { ...flexRow, alignItems: 'center', flexWrap: 'wrap' as string, marginTop: '8rpx' }
const categoryTag = computed((): any => ({ height: '36rpx', paddingLeft: '12rpx', paddingRight: '12rpx', borderRadius: '18rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '10rpx' }))
const categoryTagText = computed((): any => ({ fontSize: '20rpx', color: n.value.textSecondary }))
const hotText = computed((): any => ({ fontSize: '22rpx', fontWeight: 600, color: brand.primary, marginLeft: '12rpx' }))
const releaseTag = computed((): any => ({ height: '36rpx', paddingLeft: '12rpx', paddingRight: '12rpx', borderRadius: '18rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '10rpx' }))
const releaseTagText = computed((): any => ({ fontSize: '20rpx', color: n.value.textSecondary }))
const metaText = computed((): any => ({ fontSize: '20rpx', color: n.value.textTertiary, marginLeft: '12rpx' }))
</script>

<style>
</style>
