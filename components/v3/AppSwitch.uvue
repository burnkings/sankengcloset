<template>
  <view :style="rowWrap" @tap="onToggle">
    <view :style="trackStyle">
      <view :style="thumbStyle" />
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { n } from '@/theme/use-theme'

// V3 AppSwitch — 开关；整行点击热区由外层负责（V3 §6.25）
const props = withDefaults(defineProps<{
  modelValue?: boolean
  disabled?: boolean
}>(), { modelValue: false, disabled: false })

const emit = defineEmits<{
  'update:modelValue': [value: boolean]
}>()

function onToggle() {
  if (props.disabled) return
  emit('update:modelValue', !props.modelValue)
}

const rowWrap = computed((): any => ({
  display: 'flex',
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'flex-end',
  opacity: props.disabled ? 0.4 : 1,
}))

const trackStyle = computed((): any => ({
  display: 'flex',
  flexDirection: 'row',
  alignItems: 'center',
  width: '88rpx',
  height: '48rpx',
  borderRadius: '24rpx',
  backgroundColor: props.modelValue ? brand.primary : n.value.bgTertiary,
}))

const thumbStyle = computed((): any => ({
  width: '38rpx',
  height: '38rpx',
  borderRadius: '19rpx',
  backgroundColor: '#FFFFFF',
  marginLeft: props.modelValue ? '45rpx' : '5rpx',
}))
</script>

<style>
</style>
