<template>
  <view :style="cardStyle" @tap="emit('tap')">
    <view :style="imageWrap">
      <AppImage v-if="image !== ''" :src="image" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
      <view v-else :style="imageFallbackStyle">
        <AppIcon name="camera" :size="56" />
        <text :style="fallbackTextStyle">图片暂不可用</text>
      </view>
      <view v-if="showSave" :style="saveButtonStyle" @tap.stop="emit('toggleSave')">
        <AppIcon name="heart" :size="36" :active="saved" />
      </view>
    </view>
    <view :style="infoStyle">
      <text :style="titleStyle">{{ title }}</text>
      <view v-if="brand !== '' || typeText !== ''" :style="brandRow">
        <text v-if="brand !== ''" :style="brandStyle">{{ brand }}</text>
        <view v-if="typeText !== ''" :style="typeChipStyle"><text :style="typeChipText">{{ typeText }}</text></view>
      </view>
      <!-- 状态与价格同排；定金降级小字放在**状态 chip 下面**（左列），避免在主价下方独占一行留出空洞 -->
      <view v-if="statusText !== '' || priceText !== ''" :style="metaRow">
        <view :style="statusWrap">
          <StatusChip v-if="statusText !== ''" :label="statusText" :status="statusColor" size="sm" />
          <text v-if="priceSubText !== ''" :style="priceSubStyle">{{ priceSubText }}</text>
        </view>
        <text v-if="priceText !== ''" :style="priceStyle">{{ priceText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppIcon from '@/components/base/AppIcon.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import StatusChip from '@/components/v3/StatusChip.uvue'
import { v3TextStyle } from '@/theme/tokens/typography'
import { PRODUCT_CARD_IMAGE_HEIGHT_V3 } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'

// V3 ProductCard — 双列商品卡（Product V2 §三）：主图 → 品牌/坑向 → 标题 → 销售状态 → 价格摘要 → 收藏
// priceText 由调用方按 price_type 生成语义摘要（formatPriceSummaryByType），本组件只负责展示
const props = withDefaults(defineProps<{
  title?: string
  brand?: string
  /** 三坑类型标签（JK / Lolita / 汉服 / 其他） */
  typeText?: string
  /** 销售状态文案（在售/预售/售罄…），来源 ProductStatusLabels */
  statusText?: string
  /** 销售状态颜色（StatusChip status: positive/pending/initial/neutral/error/brand） */
  statusColor?: string
  priceText?: string
  /** 双价降级小字（定金提示）：由调用方按 price_type 生成，空串不渲染 */
  priceSubText?: string
  image?: string
  saved?: boolean
  showSave?: boolean
  imageHeight?: string
  /** 卡片与下方内容的间距。收藏页卡片下面还挂着「决策行」，需要传 0 让两者成为一张卡 */
  marginBottom?: string
}>(), { title: '', brand: '', typeText: '', statusText: '', statusColor: 'neutral', priceText: '', priceSubText: '', image: '', saved: false, showSave: true, imageHeight: PRODUCT_CARD_IMAGE_HEIGHT_V3, marginBottom: '28rpx' })

const emit = defineEmits<{
  tap: []
  toggleSave: []
}>()

const cardStyle = computed((): any => ({ width: '100%', marginBottom: props.marginBottom }))
const imageWrap = computed((): any => ({ position: 'relative', width: '100%', height: props.imageHeight, borderRadius: '12rpx', overflow: 'hidden', backgroundColor: n.value.bgSecondary }))
const imageStyle = computed((): any => ({ width: '100%', height: props.imageHeight }))
const imageFallbackStyle = computed((): any => ({ width: '100%', height: props.imageHeight, alignItems: 'center', justifyContent: 'center', backgroundColor: n.value.bgSecondary }))
const fallbackTextStyle = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, color: n.value.textTertiary, marginTop: '8rpx' }))
// 收藏按钮：默认不透明底色，避免透明热区在图片上“看不见却可点”
const saveButtonStyle = computed((): any => ({ position: 'absolute', top: '12rpx', right: '12rpx', width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.surface, alignItems: 'center', justifyContent: 'center' }))
const infoStyle = { paddingTop: '12rpx' }
const brandRow = computed((): any => ({ flexDirection: 'row' as string, alignItems: 'center', marginTop: '8rpx' }))
const brandStyle = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, lineHeight: v3TextStyle.caption.lineHeight, color: n.value.textSecondary, flexShrink: 1, lines: 1, textOverflow: 'ellipsis' }))
const typeChipStyle = computed((): any => ({ marginLeft: '8rpx', paddingLeft: '12rpx', paddingRight: '12rpx', paddingTop: '4rpx', paddingBottom: '4rpx', borderRadius: '9999rpx', backgroundColor: n.value.bgSecondary, flexShrink: 0, alignItems: 'center', justifyContent: 'center' }))
// 必须 nowrap：否则窄空间下文字会逐字竖排（肉眼可见的渲染错误）
const typeChipText = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, fontWeight: 500, color: n.value.textTertiary, whiteSpace: 'nowrap' }))
const titleStyle = computed((): any => ({ fontSize: v3TextStyle.cardTitle.fontSize, lineHeight: v3TextStyle.cardTitle.lineHeight, fontWeight: 500, color: n.value.text, lines: 2, textOverflow: 'ellipsis' }))
const metaRow = computed((): any => ({ flexDirection: 'row' as string, alignItems: 'center', marginTop: '8rpx' }))
const statusWrap = { flex: 1, flexDirection: 'column' as string, alignItems: 'flex-start' as string }
// 卡片价格统一用品牌粉（用户拍板：所有卡片价格色统一品牌粉）——走主题 token，深色自动换 #E47A96
const priceStyle = computed((): any => ({ fontSize: v3TextStyle.price.fontSize, lineHeight: v3TextStyle.price.lineHeight, fontWeight: 600, color: n.value.iconActive, marginLeft: '8rpx', flexShrink: 0 }))
// 定金降级小字：跟随状态 chip 左对齐（原来放主价下方会独占一行留出空洞）
const priceSubStyle = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, color: n.value.textTertiary, marginTop: '6rpx', lines: 1, textOverflow: 'ellipsis', whiteSpace: 'nowrap' }))
</script>

<style>
</style>
