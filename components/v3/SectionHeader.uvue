<template>
  <view :style="rowStyle">
    <text :style="titleStyle">{{ title }}</text>
    <view v-if="actionText !== ''" :style="actionWrap" @tap="emit('action')">
      <text :style="actionTextStyle">{{ actionText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { v3TextStyle } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

// V3 SectionHeader — 区块标题（sectionTitle 32rpx/600），左对齐，右侧文字动作
const props = withDefaults(defineProps<{ title?: string; actionText?: string }>(), { title: '', actionText: '' })
const emit = defineEmits<{ action: [] }>()
const rowStyle = computed((): any => ({ ...flexRow, alignItems: 'center', paddingTop: '8rpx', paddingBottom: '8rpx' }))
const titleStyle = computed((): any => ({ ...flexFill, fontSize: v3TextStyle.sectionTitle.fontSize, lineHeight: v3TextStyle.sectionTitle.lineHeight, fontWeight: v3TextStyle.sectionTitle.fontWeight, color: n.value.text }))
const actionWrap = { minWidth: '80rpx', alignItems: 'flex-end', justifyContent: 'center', height: '64rpx' }
const actionTextStyle = { fontSize: v3TextStyle.meta.fontSize, fontWeight: 500, color: brand.primary }
</script>

<style>
</style>
