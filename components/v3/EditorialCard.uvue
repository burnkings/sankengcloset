<template>
  <view :style="cardStyle" @tap="emit('tap')">
    <view :style="imageWrap">
      <image v-if="image !== ''" :src="image" :style="imageStyle" mode="aspectFill" lazy-load />
      <view v-else :style="imageFallbackStyle">
        <AppIcon name="camera" :size="56" />
      </view>
    </view>
    <view :style="infoStyle">
      <text :style="titleStyle">{{ title }}</text>
      <text :style="metaStyle">{{ sourceLabel }} · {{ updatedText }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppIcon from '@/components/base/AppIcon.uvue'
import { v3TextStyle } from '@/theme/tokens/typography'
import { n } from '@/theme/use-theme'

// V3 EditorialCard — 单列编辑专题卡（V3 §5.4）：16:9 图 + 独立文字区；标明"编辑整理/官方信息/用户投稿"及更新时间
const props = withDefaults(defineProps<{
  title?: string
  image?: string
  sourceLabel?: string
  updatedText?: string
}>(), { title: '', image: '', sourceLabel: '编辑整理', updatedText: '' })

const emit = defineEmits<{ tap: [] }>()

const cardStyle = { width: '100%', marginBottom: '28rpx' }
const imageWrap = { width: '100%', height: '422rpx', borderRadius: '16rpx', overflow: 'hidden', backgroundColor: n.value.bgSecondary }
const imageStyle = { width: '100%', height: '422rpx' }
const imageFallbackStyle = { width: '100%', height: '422rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: n.value.bgSecondary }
const infoStyle = { paddingTop: '16rpx', paddingBottom: '8rpx' }
const titleStyle = computed((): any => ({ fontSize: v3TextStyle.cardTitle.fontSize, lineHeight: v3TextStyle.cardTitle.lineHeight, fontWeight: 600, color: n.value.text }))
const metaStyle = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, color: n.value.textTertiary, marginTop: '8rpx' }))
</script>

<style>
</style>
