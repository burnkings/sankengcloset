<template>
  <scroll-view direction="horizontal" :show-scrollbar="false" :style="scrollStyle">
    <view :style="rowStyle">
      <view v-for="(item, idx) in items" :key="item" :style="shellStyle(idx)">
        <view :style="chipStyle(item)" @tap="onTap(item)">
          <text :style="chipText(item)">{{ item }}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { v3TextStyle } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

// V3 SegmentedControl — 分段控制（V3 §5.7 二级筛选同级）
const props = withDefaults(defineProps<{
  items?: Array<string>
  active?: string
  variant?: string   // 'solid' | 'soft' | 'text'
  edgeInset?: boolean
}>(), { items: () => [], active: '', variant: 'solid', edgeInset: false })

const emit = defineEmits<{ change: [value: string] }>()
function onTap(item: string) { emit('change', item) }

const scrollStyle = { width: '100%', flexDirection: 'row' }
const rowStyle = computed((): any => ({
  ...flexRow,
  flexShrink: 0,
  height: '64rpx',
  paddingLeft: props.edgeInset ? '32rpx' : '0',
  paddingRight: props.edgeInset ? '32rpx' : '0',
  alignItems: 'center',
}))
function shellStyle(idx: number) { return { marginRight: idx < props.items.length - 1 ? '16rpx' : '0', flexShrink: 0 } }

function chipStyle(item: string) {
  const active = item === props.active
  if (props.variant === 'text') {
    return { height: '60rpx', paddingLeft: '8rpx', paddingRight: '8rpx', borderRadius: radius.lg, alignItems: 'center', justifyContent: 'center', backgroundColor: 'transparent' }
  }
  const bg = active ? n.value.surfacePink : n.value.surface
  return { height: '64rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '9999rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: bg, borderWidth: active ? '0' : '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border }
}

function chipText(item: string) {
  const active = item === props.active
  if (props.variant === 'text') {
    return { fontSize: v3TextStyle.body.fontSize, fontWeight: active ? 600 : 400, color: active ? brand.primary : n.value.textSecondary }
  }
  return { fontSize: v3TextStyle.body.fontSize, fontWeight: active ? 600 : 400, color: active ? brand.primary : n.value.textSecondary }
}
</script>

<style>
</style>
