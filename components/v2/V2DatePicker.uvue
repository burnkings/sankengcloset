<template>
  <picker v-if="mode === 'date'" mode="date" :value="value" @change="onDateChange">
    <view :style="pickerRow">
      <text :style="labelStyle">{{ label }}</text>
      <text :style="valueStyle(filled)">{{ filled ? displayValue : placeholder }}</text>
      <view :style="arrowWrap"><text :style="arrowText">&#9662;</text></view>
    </view>
  </picker>
  <view v-else :style="pickerRow" @tap="openTimePicker">
    <text :style="labelStyle">{{ label }}</text>
    <text :style="valueStyle(filled)">{{ filled ? displayValue : placeholder }}</text>
    <view :style="arrowWrap"><text :style="arrowText">&#9662;</text></view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { semanticRadius } from '@/theme/tokens/radius'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  label?: string
  value?: string
  placeholder?: string
  mode?: string
}>(), { label: '', value: '', placeholder: '请选择', mode: 'date' })

const emit = defineEmits<{ change: [value: string] }>()

const filled = computed((): boolean => props.value !== '')
const displayValue = computed((): string => props.value !== '' ? props.value : props.placeholder)

function onDateChange(e: any) {
  const d = (e as UTSJSONObject)['detail'] as UTSJSONObject
  const val = d != null && d['value'] != null ? d['value'] as string : ''
  emit('change', val)
}

function openTimePicker() {
  uni.showActionSheet({
    itemList: ['06:00', '08:00', '10:00', '12:00', '14:00', '16:00', '18:00', '20:00', '22:00'],
    success: (res) => {
      const times = ['06:00', '08:00', '10:00', '12:00', '14:00', '16:00', '18:00', '20:00', '22:00']
      emit('change', times[res.tapIndex])
    },
  })
}

const pickerRow = computed((): any => ({
  ...flexRow,
  flexDirection: 'row',
  alignItems: 'center',
  height: '88rpx',
  paddingLeft: props.label !== '' ? '28rpx' : '16rpx',
  paddingRight: '16rpx',
  borderRadius: semanticRadius.input,
  backgroundColor: n.value.inputFill,
  marginBottom: '12rpx',
}))

const labelPad = computed((): string => props.label !== '' ? '28rpx' : '16rpx')

const labelStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
  marginRight: '12rpx',
  flexShrink: 0,
}))

function valueStyle(filled: boolean) {
  return {
    flex: 1,
    fontSize: fontSize.base,
    color: filled ? n.value.text : n.value.placeholder,
  }
}

const arrowWrap = {
  width: '48rpx',
  height: '48rpx',
  alignItems: 'center',
  justifyContent: 'center',
  flexShrink: 0,
}

const arrowText = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textTertiary,
}))
</script>
