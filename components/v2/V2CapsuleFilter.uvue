<template>
  <scroll-view direction="horizontal" :show-scrollbar="false" :style="scrollStyle">
    <view :style="capsuleRow">
      <view v-for="(item, idx) in items" :key="item" :style="chipWrapStyle(idx)">
        <view :style="chipStyle(item)" @tap="onTap(item)">
          <text :style="chipText(item)">{{ item }}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  items?: Array<string>
  active?: string
  activeColor?: string
}>(), { items: () => [], active: '', activeColor: '' })

const emit = defineEmits<{ change: [value: string] }>()
function onTap(item: string) { emit('change', item) }

const scrollStyle = { width: '100%' }
const capsuleRow = computed((): any => ({
  ...flexRow,
  flexDirection: 'row',
  alignItems: 'center',
  backgroundColor: n.value.surface,
  borderRadius: '32rpx',
  paddingTop: '12rpx',
  paddingBottom: '12rpx',
  paddingLeft: '8rpx',
  paddingRight: '8rpx',
}))

function chipWrapStyle(idx: number) {
  return { flexShrink: 0 }
}

function chipStyle(item: string) {
  const active = item === props.active
  const ac = props.activeColor !== '' ? props.activeColor : brand[500]
  return {
    height: '64rpx',
    paddingLeft: '28rpx',
    paddingRight: '28rpx',
    borderRadius: '32rpx',
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: active ? (ac as string) : n.value.surface,
    borderWidth: active ? '0' : '1rpx',
    borderStyle: 'solid' as string,
    borderColor: n.value.cardBorder,
    marginRight: '20rpx',
    marginBottom: '8rpx',
  }
}

function chipText(item: string) {
  const active = item === props.active
  return {
    fontSize: fontSize.sm,
    fontWeight: active ? fontWeight.semibold : fontWeight.regular,
    color: active ? baseColors.white : n.value.textSecondary,
  }
}
</script>
