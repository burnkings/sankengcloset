<template>
  <view :style="cardStyle">
    <view :style="leftStyle">
      <text :style="primaryLabelStyle">{{ primaryLabel }}</text>
      <text :style="primaryValueStyle">{{ primaryValue }}</text>
    </view>
    <view v-if="secondaryLabel !== '' || tertiaryLabel !== ''" :style="rightStyle">
      <view v-if="secondaryLabel !== ''" :style="secondaryRowStyle">
        <text :style="secondaryLabelStyle">{{ secondaryLabel }}</text>
        <text :style="secondaryValueStyle(secondaryHighlight)">{{ secondaryValue }}</text>
      </view>
      <view v-if="tertiaryLabel !== ''" :style="tertiaryRowStyle">
        <text :style="secondaryLabelStyle">{{ tertiaryLabel }}</text>
        <text :style="tertiaryValueStyle">{{ tertiaryValue }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { CARD_PADDING } from '@/theme/tokens/responsive'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  primaryLabel?: string
  primaryValue?: string
  primaryColor?: string
  secondaryLabel?: string
  secondaryValue?: string
  secondaryHighlight?: boolean
  tertiaryLabel?: string
  tertiaryValue?: string
}>(), {
  primaryLabel: '',
  primaryValue: '',
  primaryColor: '',
  secondaryLabel: '',
  secondaryValue: '',
  secondaryHighlight: false,
  tertiaryLabel: '',
  tertiaryValue: '',
})

const cardStyle = computed((): any => ({
  ...flexRow,
  flexDirection: 'row',
  alignItems: 'center',
  justifyContent: 'space-between',
  backgroundColor: n.value.surface,
  borderRadius: '24rpx',
  borderWidth: '1rpx',
  borderStyle: 'solid',
  borderColor: n.value.cardBorder,
  padding: CARD_PADDING,
}))

const leftStyle = computed((): any => ({
  display: 'flex',
  flexDirection: 'column',
  flexShrink: 0,
}))

const primaryLabelStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textSecondary,
}))

const primaryValueStyle = computed((): any => ({
  fontSize: fontSize['2xl'],
  fontWeight: fontWeight.bold,
  color: props.primaryColor !== '' ? props.primaryColor : brand[500],
  marginTop: '4rpx',
}))

const rightStyle = {
  display: 'flex',
  flexDirection: 'column',
  alignItems: 'flex-end',
  flexShrink: 0,
}

const secondaryRowStyle = {
  display: 'flex',
  flexDirection: 'column',
  alignItems: 'flex-end',
  marginBottom: '8rpx',
}

const tertiaryRowStyle = {
  display: 'flex',
  flexDirection: 'column',
  alignItems: 'flex-end',
}

const secondaryLabelStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textSecondary,
}))

function secondaryValueStyle(highlight: boolean) {
  return {
    fontSize: fontSize.xs,
    fontWeight: highlight ? fontWeight.medium : fontWeight.regular,
    color: highlight ? brand[500] : n.value.text,
    marginTop: '2rpx',
  }
}

const tertiaryValueStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textSecondary,
  marginTop: '2rpx',
}))
</script>
