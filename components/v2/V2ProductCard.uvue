<template>
  <view :style="cardStyle" @tap="emit('click')">
    <view :style="imageStyle">
      <AppImage :src="image" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
    </view>
    <view :style="infoStyle">
      <text :style="brandStyle">{{ brandName }}</text>
      <text :style="titleStyle">{{ title }}</text>
      <view v-if="badge !== '' || deadlineText !== ''" :style="metaRowStyle">
        <view v-if="badge !== ''" :style="statusStyle">
          <view :style="statusDotStyle" />
          <text :style="statusTextStyle">{{ badge }}</text>
        </view>
        <text v-if="deadlineText !== ''" :style="deadlineTextStyle">{{ deadlineText }}</text>
      </view>
      <view :style="infoSpacerStyle" />
      <view :style="priceRowStyle">
        <text :style="priceStyle">{{ priceText }}</text>
        <text v-if="originalPriceText !== ''" :style="originalPriceStyle">{{ originalPriceText }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand, accent, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { CARD_PADDING, CARD_RADIUS, PRODUCT_CARD_WIDTH, PRODUCT_CARD_IMAGE_HEIGHT, PRODUCT_CARD_INFO_MIN_HEIGHT } from '@/theme/tokens/responsive'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import AppImage from '@/components/base/AppImage.uvue'

const props = withDefaults(defineProps<{
  image?: string
  brandName?: string
  title?: string
  priceText?: string
  originalPriceText?: string
  badge?: string
  deadlineText?: string
}>(), { image: '', brandName: '', title: '', priceText: '', originalPriceText: '', badge: '', deadlineText: '' })
const emit = defineEmits<{ click: [] }>()

const cardStyle = computed((): any => ({ width: PRODUCT_CARD_WIDTH, flexShrink: 0, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, overflow: 'hidden' }))
const imageStyle = { width: PRODUCT_CARD_WIDTH, height: PRODUCT_CARD_IMAGE_HEIGHT, position: 'relative', overflow: 'hidden' }
function statusColor(): string {
  if (props.badge === '现货' || props.badge === '新品') return semantic.success
  if (props.badge === '预览' || props.badge === '图透') return accent[600]
  if (props.badge === '尾款') return semantic.warning
  if (props.badge === '降价') return semantic.error
  return brand[700]
}
const infoStyle = { padding: CARD_PADDING, minHeight: PRODUCT_CARD_INFO_MIN_HEIGHT }
const brandStyle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const titleStyle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, lines: 2, textOverflow: 'ellipsis', marginTop: '8rpx' }))
const metaRowStyle = { ...flexRow, alignItems: 'center', minHeight: '32rpx', marginTop: '10rpx' }
const statusStyle = { ...flexRow, alignItems: 'center', marginRight: '12rpx' }
const statusDotStyle = computed((): any => ({ width: '8rpx', height: '8rpx', borderRadius: '4rpx', backgroundColor: statusColor(), marginRight: '8rpx' }))
const statusTextStyle = computed((): any => ({ fontSize: fontSize['2xs'], fontWeight: fontWeight.semibold, color: statusColor() }))
const deadlineTextStyle = computed((): any => ({ fontSize: fontSize['2xs'], fontWeight: fontWeight.medium, color: n.value.textSecondary }))
const infoSpacerStyle = { flex: 1, minHeight: '12rpx' }
const priceRowStyle = { ...flexRow, alignItems: 'center', marginTop: '12rpx' }
const priceStyle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: brand[600] }
const originalPriceStyle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, textDecoration: 'line-through', marginLeft: '8rpx' }))
</script>
