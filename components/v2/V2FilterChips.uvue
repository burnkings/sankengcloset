<template>
  <scroll-view scroll-x :style="scrollStyle">
    <view :style="rowStyle">
      <view :style="edgeSpacer" />
      <view v-for="(item, idx) in items" :key="item" :style="chipShell(idx)">
        <view :style="chipStyle(item)" @tap="onTap(item)">
          <text :style="chipTextStyle(item)">{{ item }}</text>
        </view>
      </view>
      <view :style="edgeSpacer" />
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { FILTER_CHIP_HEIGHT, FILTER_CHIP_PADDING_X, FILTER_CHIP_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  items?: Array<string>
  active?: string
}>(), {
  items: () => [],
  active: '',
})

const emit = defineEmits<{ change: [value: string] }>()
function onTap(item: string) { emit('change', item) }

const scrollStyle = { width: '750rpx' }
const rowStyle = { ...flexRow, height: '80rpx', alignItems: 'center' }
const edgeSpacer = { width: PAGE_GUTTER_REGULAR, height: '80rpx', flexShrink: 0 }
function chipShell(idx: number) { return { marginRight: idx < props.items.length - 1 ? FILTER_CHIP_GAP : '0', flexShrink: 0 } }
function chipStyle(item: string) {
  return {
    height: FILTER_CHIP_HEIGHT,
    paddingLeft: FILTER_CHIP_PADDING_X,
    paddingRight: FILTER_CHIP_PADDING_X,
    borderRadius: radius.full,
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: item === props.active ? brand[600] : n.value.bgSecondary,
  }
}
function chipTextStyle(item: string) {
  return {
    fontSize: fontSize.xs,
    fontWeight: item === props.active ? fontWeight.semibold : fontWeight.medium,
    color: item === props.active ? baseColors.white : n.value.textSecondary,
  }
}
</script>
