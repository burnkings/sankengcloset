<template>
  <scroll-view direction="horizontal" :show-scrollbar="false" :style="scrollStyle">
    <view :style="rowStyle">
      <view v-for="(item, idx) in items" :key="item" :style="chipShell(idx)">
        <view :style="chipStyle(item)" @tap="onTap(item)">
          <text :style="chipTextStyle(item)">{{ item }}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { FILTER_CHIP_HEIGHT, FILTER_CHIP_PADDING_X, FILTER_CHIP_GAP } from '@/theme/tokens/responsive'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{ items?: Array<string>; active?: string; edgeInset?: boolean }>(), { items: () => [], active: '', edgeInset: false })
const emit = defineEmits<{ change: [value: string] }>()
function onTap(item: string) { emit('change', item) }

const scrollStyle = { width: '100%' }
const rowStyle = computed((): any => ({
  ...flexRow,
  minWidth: '100%',
  width: `${Math.max(670, props.items.length * 164 + (props.edgeInset ? 80 : 0))}rpx`,
  height: '80rpx',
  paddingLeft: props.edgeInset ? '40rpx' : '0',
  paddingRight: props.edgeInset ? '40rpx' : '0',
  alignItems: 'center',
}))
function chipShell(idx: number) { return { marginRight: idx < props.items.length - 1 ? FILTER_CHIP_GAP : '0', flexShrink: 0 } }
function chipStyle(item: string) { return { height: FILTER_CHIP_HEIGHT, paddingLeft: FILTER_CHIP_PADDING_X, paddingRight: FILTER_CHIP_PADDING_X, borderRadius: radius.full, alignItems: 'center', justifyContent: 'center', backgroundColor: item === props.active ? brand[600] : n.value.bgSecondary } }
function chipTextStyle(item: string) { return { fontSize: fontSize.xs, fontWeight: item === props.active ? fontWeight.semibold : fontWeight.medium, color: item === props.active ? baseColors.white : n.value.textSecondary } }
</script>
