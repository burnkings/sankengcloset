<template>
  <view :style="sectionStyle">
    <view :style="headerStyle" @tap="onToggle">
      <text :style="titleStyle">{{ title }}</text>
      <text v-if="collapsible" :style="arrowStyle">{{ open ? '▾' : '▸' }}</text>
    </view>
    <view v-if="!collapsible || open" :style="bodyStyle">
      <slot />
    </view>
  </view>
</template>

<script setup lang="uts">
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  title?: string
  collapsible?: boolean
  open?: boolean
}>(), { title: '', collapsible: false, open: true })

const emit = defineEmits<{ toggle: [] }>()
function onToggle() { if (props.collapsible) emit('toggle') }

const sectionStyle = computed((): any => ({
  marginBottom: '32rpx',
}))

const headerStyle = {
  ...flexRow,
  flexDirection: 'row',
  alignItems: 'center',
  marginBottom: '14rpx',
}

const titleStyle = computed((): any => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  flex: 1,
}))

const arrowStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textTertiary,
  marginLeft: '8rpx',
}))

const bodyStyle = {
  padding: '0',
}
</script>
