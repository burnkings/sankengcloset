<template>
  <view :style="navbarStyle">
    <view :style="statusBarStyle" />
    <view :style="contentStyle">
      <view :style="leftStyle"><slot name="left"><text v-if="showBack" :style="backStyle" @tap="onBack"><AppIcon name="arrow-back" :size="40" /></text><text v-else :style="brandStyle">三坑绮橱</text></slot></view>
      <view :style="centerStyle"><slot><text :style="titleStyle">{{ title }}</text></slot></view>
      <view :style="rightStyle"><slot name="right" /></view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { zIndex } from '@/theme/tokens/z-index'
import { shadow } from '@/theme/tokens/shadow'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import { brand } from '@/theme/tokens/colors'
import { getStatusBarHeight } from '@/utils/window-info'
import AppIcon from '@/components/base/AppIcon.uvue'

const props = withDefaults(defineProps<{ title?: string; showBack?: boolean; transparent?: boolean }>(), { title: '', showBack: true, transparent: false })
const emit = defineEmits<{ back: [] }>()
const statusBarH = getStatusBarHeight()
const navbarStyle = computed((): any => ({ position: 'fixed', top: '0', left: '0', right: '0', zIndex: zIndex.navbar, backgroundColor: props.transparent ? 'transparent' : n.value.bg, boxShadow: props.transparent ? shadow.none : shadow.navbar }))
const statusBarStyle = { height: `${statusBarH}px` }
const contentStyle = { height: '88rpx', ...flexRow, alignItems: 'center', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const leftStyle = { flexShrink: 0, ...flexRow, alignItems: 'center', width: '180rpx' }
const centerStyle = { ...flexFill, alignItems: 'center', justifyContent: 'center', overflow: 'hidden' }
const rightStyle = { flexShrink: 0, ...flexRow, alignItems: 'center', justifyContent: 'flex-end', width: '180rpx' }
const backStyle = computed((): any => ({ fontSize: fontSize.lg, color: n.value.text }))
const brandStyle = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[500] }
const titleStyle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, lines: 1, textOverflow: 'ellipsis' }))
function onBack() { emit('back'); uni.navigateBack() }
</script>
