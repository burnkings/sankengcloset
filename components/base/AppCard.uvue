<template>
  <view :style="cardStyle" @tap="emit('click')">
    <view v-if="$slots.has('header')" :style="headerStyle">
      <slot name="header" />
    </view>
    <view :style="bodyStyle">
      <slot />
    </view>
    <view v-if="$slots.has('footer')" :style="footerStyle">
      <slot name="footer" />
    </view>
  </view>
</template>

<script setup lang="uts">
import { spacing } from '@/theme/tokens/spacing'
import { semanticRadius } from '@/theme/tokens/radius'
import { shadow } from '@/theme/tokens/shadow'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  elevated?: boolean
  padding?: string
  radiusToken?: string
}>(), {
  elevated: true,
  padding: spacing[4] as string,
  radiusToken: semanticRadius.card as string })

const emit = defineEmits<{
  click: []
}>()


const cardStyle = computed((): any => ({
  backgroundColor: n.value.surface,
  borderRadius: props.radiusToken,
  padding: props.padding,
  boxShadow: props.elevated ? (shadow.card as string) : (shadow.none as string),
  overflow: 'hidden' }))

const headerStyle = { marginBottom: '24rpx' }
const bodyStyle = {}
const footerStyle = { marginTop: '24rpx' }
</script>