<template>
  <image
    v-if="iconSrc !== ''"
    :src="iconSrc"
    :style="iconStyle"
    mode="aspectFit"
  />
</template>

<script setup lang="uts">
/**
 * AppIcon — 统一线性图标组件 V2
 *
 * 24px 视觉尺寸，2px stroke，round caps/joins
 * 默认 #8C847E (neutralLight.icon)，激活 #D45F7E (brand[500]) — 已对齐设计稿
 */
const props = withDefaults(defineProps<{
  name: string
  size?: number
  active?: boolean
}>(), {
  // name 必须给默认值：漏传时 props.name 为 undefined，模板字符串会拼出
  // "/static/icons/undefined.svg"，小程序端变成一次 500 网络请求。
  name: '',
  size: 48,
  active: false,
})

const iconSrc = computed((): string => {
  if (props.name === '') return ''
  if (props.active) {
    return `/static/icons/${props.name}-active.svg`
  }
  return `/static/icons/${props.name}.svg`
})

const iconStyle = computed((): any => ({
  width: `${props.size}rpx`,
  height: `${props.size}rpx`,
  opacity: 1,
}))
</script>
