<template>
  <view :style="fabStyle" @tap="emit('tap')">
    <AppIcon name="add" :size="48" :active="true" />
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { shadow } from '@/theme/tokens/shadow'
import { getSafeBottomInset } from '@/utils/window-info'
import AppIcon from '@/components/base/AppIcon.uvue'

const emit = defineEmits<{ tap: [] }>()
const safeBottom = getSafeBottomInset()

const fabStyle = computed((): any => ({
  position: 'fixed' as string,
  left: '327rpx',
  right: '327rpx',
  bottom: `${safeBottom + 64}px`,
  width: '96rpx',
  height: '96rpx',
  borderRadius: '48rpx',
  backgroundColor: brand[500] as string,
  alignItems: 'center',
  justifyContent: 'center',
  zIndex: 100,
  boxShadow: shadow.button as string,
}))
</script>
