<template>
  <view :style="wrapperStyle">
    <image
      v-if="src !== ''"
      :src="src"
      :style="imgStyle"
      :mode="mode"
      :lazy-load="lazyLoad"
      @load="onLoad"
      @error="onError"
    />
    <view v-if="src === '' || (!loaded && !hasError)" :style="placeholderStyle">
      <view :style="skeletonPulseStyle" />
    </view>
    <view v-if="hasError" :style="errorStyle">
      <view :style="errorArtStyle">
        <view :style="errorArtTop" />
        <view :style="errorArtMiddle" />
        <view :style="errorArtBottom" />
      </view>
      <text :style="errorTextStyle">三坑绮橱</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { neutralLight } from '@/theme/tokens/colors'
import { semanticRadius } from '@/theme/tokens/radius'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  src?: string
  width?: string
  height?: string
  mode?: string
  lazyLoad?: boolean
  radiusToken?: string
}>(), {
  src: '',
  width: '100%',
  height: 'auto',
  mode: 'aspectFill',
  lazyLoad: true,
  radiusToken: semanticRadius.image })

const emit = defineEmits<{
  load: []
  error: []
}>()

const loaded = ref(false)
const hasError = ref(false)

const wrapperStyle = computed((): any => ({
  width: props.width,
  height: props.height == 'auto' ? '0' : props.height,
  position: 'relative',
  overflow: 'hidden',
  borderRadius: props.radiusToken,
  opacity: 1,
}))

const imgStyle = computed((): any => ({
  width: '100%',
  height: '100%',
  borderRadius: props.radiusToken,
  opacity: 1,
}))

const placeholderStyle = computed((): any => ({
  position: 'absolute',
  top: '0', left: '0', right: '0', bottom: '0',
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'center',
  backgroundColor: n.value.bgTertiary,
  borderRadius: props.radiusToken,
}))

const skeletonPulseStyle = {
  width: '100%', height: '100%',
  backgroundColor: 'rgba(0,0,0,0.04)',
}

const errorStyle = computed((): any => ({
  position: 'absolute',
  top: '0', left: '0', right: '0', bottom: '0',
  alignItems: 'center', justifyContent: 'center',
  backgroundColor: n.value.bgTertiary,
  borderRadius: props.radiusToken,
}))

const errorTextStyle = computed((): any => ({
  fontSize: '22rpx',
  color: n.value.textTertiary,
  fontWeight: '600',
  marginTop: '18rpx',
}))

const errorArtStyle = {
  width: '112rpx', height: '88rpx',
  alignItems: 'center', justifyContent: 'center',
}
const errorArtTop = { width: '42rpx', height: '12rpx', borderRadius: '8rpx', backgroundColor: '#D9A9B8' }
const errorArtMiddle = { width: '88rpx', height: '42rpx', borderRadius: '12rpx', backgroundColor: '#E9D4DB', marginTop: '8rpx' }
const errorArtBottom = { width: '64rpx', height: '8rpx', borderRadius: '8rpx', backgroundColor: '#B9C9C2', marginTop: '8rpx' }

function onLoad() {
  loaded.value = true
  hasError.value = false
  emit('load')
}

function onError() {
  hasError.value = true
  loaded.value = false
  emit('error')
}
</script>
