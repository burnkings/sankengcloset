<template>
  <view :style="wrapperStyle">
    <image
      v-if="src"
      :src="src"
      :style="imgStyle"
      :mode="mode"
      :lazy-load="lazyLoad"
      @load="onLoad"
      @error="onError"
    />
    <view v-if="!loaded || hasError" :style="placeholderStyle">
      <text v-if="hasError"> 🖼️ </text>
      <view v-else :style="skeletonPulseStyle" />
    </view>
  </view>
</template>

<script setup lang="uts">
import { neutralLight, neutralDark } from '@/theme/tokens/colors'
import { semanticRadius } from '@/theme/tokens/radius'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  src?: string
  width?: string
  height?: string
  mode?: string
  lazyLoad?: boolean
  radiusToken?: string
}>(), {
  src: '',
  width: '100%',
  height: 'auto',
  mode: 'aspectFill',
  lazyLoad: true,
  radiusToken: semanticRadius.image })

const emit = defineEmits<{
  load: []
  error: []
}>()

const loaded = ref(false)
const hasError = ref(false)

const wrapperStyle = computed((): any => ({
  width: props.width,
  height: props.height == 'auto' ? '0' : props.height,
  position: 'relative',
  overflow: 'hidden',
  borderRadius: props.radiusToken }))

const imgStyle = computed((): any => ({
  width: '100%',
  height: '100%',
  borderRadius: props.radiusToken }))

const placeholderStyle = computed((): any => ({
  position: 'absolute',
  top: '0',
  left: '0',
  right: '0',
  bottom: '0',
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'center',
  backgroundColor: isDark.value ? neutralDark.bgTertiary : neutralLight.bgTertiary,
  borderRadius: props.radiusToken }))

const skeletonPulseStyle = (() => {
  const s = {}
  s.width = '100%'
  s.height = '100%'
  s.backgroundColor = 'rgba(0,0,0,0.05)'
  return s
})()

function onLoad() {
  loaded.value = true
  hasError.value = false
  emit('load')
}

function onError() {
  hasError.value = true
  emit('error')
}
</script>