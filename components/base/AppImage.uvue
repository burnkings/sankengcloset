<template>
  <view :style="wrapperStyle">
    <image
      v-if="src !== ''"
      :key="imgKey"
      :src="src"
      :style="imgStyle"
      :mode="mode"
      :lazy-load="lazyLoad"
      @load="onLoad"
      @error="onError"
    />
    <view v-if="src === '' || (!loaded && !hasError)" :style="placeholderStyle">
      <view :style="skeletonPulseStyle" />
    </view>
    <view v-if="hasError" :style="errorStyle" @tap.stop="retry">
      <view :style="errorArtStyle">
        <view :style="errorArtTop" />
        <view :style="errorArtMiddle" />
        <view :style="errorArtBottom" />
      </view>
      <text :style="errorTextStyle">三坑绮橱 · 点击重试</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { semanticRadius } from '@/theme/tokens/radius'
import { n, isDark } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  src?: string
  width?: string
  height?: string
  mode?: string
  lazyLoad?: boolean
  radiusToken?: string
}>(), {
  src: '',
  width: '100%',
  height: 'auto',
  mode: 'aspectFill',
  lazyLoad: true,
  radiusToken: semanticRadius.image })

const emit = defineEmits<{
  load: []
  error: []
}>()

const loaded = ref(false)
const hasError = ref(false)
// 失败重试计数：改变 :key 强制 image 重新挂载（不改 src，避免给本地路径拼查询串）
const retryToken = ref(0)
const imgKey = computed((): string => `${props.src}#${retryToken.value}`)
watch(() => props.src, () => { loaded.value = false; hasError.value = false; retryToken.value = 0 })

/** 点击失败占位重新加载（2026-09-09 真机反馈：失败占位需要可重试） */
function retry() {
  hasError.value = false
  loaded.value = false
  retryToken.value = retryToken.value + 1
}

const wrapperStyle = computed((): any => ({
  width: props.width,
  height: props.height == 'auto' ? '0' : props.height,
  position: 'relative',
  overflow: 'hidden',
  borderRadius: props.radiusToken,
  opacity: 1,
}))

// demo 占位图（/static/demo/）本身是高饱和的亮紫/亮棕，压在暖黑底上很刺眼 —— 深色下降一档亮度。
// 真实内容图按 V3 §9 保持原色、不降亮。接入真实商品图后可移除此分支。
const isDemoArt = computed((): boolean => props.src.indexOf('/static/demo/') === 0)
const imgStyle = computed((): any => ({
  width: '100%',
  height: '100%',
  borderRadius: props.radiusToken,
  opacity: isDemoArt.value && isDark.value ? 0.82 : 1,
}))

const placeholderStyle = computed((): any => ({
  position: 'absolute',
  top: '0', left: '0', right: '0', bottom: '0',
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'center',
  backgroundColor: n.value.bgTertiary,
  borderRadius: props.radiusToken,
}))

const skeletonPulseStyle = {
  width: '100%', height: '100%',
  backgroundColor: 'rgba(0,0,0,0.04)',
}

const errorStyle = computed((): any => ({
  position: 'absolute',
  top: '0', left: '0', right: '0', bottom: '0',
  alignItems: 'center', justifyContent: 'center',
  backgroundColor: n.value.bgTertiary,
  borderRadius: props.radiusToken,
}))

const errorTextStyle = computed((): any => ({
  fontSize: '22rpx',
  color: n.value.textTertiary,
  fontWeight: '600',
  marginTop: '18rpx',
}))

const errorArtStyle = {
  width: '112rpx', height: '88rpx',
  alignItems: 'center', justifyContent: 'center',
}
// 失败插画：浅色沿用粉色阶；**深色改中性灰阶**（拍板 B）。
// 理由：失败态应当"安静 + 可重试"，品牌粉在暖黑底上会成为全页最亮元素，抢走「点击重试」的注意力，
// 而且用品牌正向色渲染"失败了"语义自相矛盾。三档灰保持原有块面形状，不损失任何信息。
const errorArtTop = computed((): any => ({ width: '42rpx', height: '12rpx', borderRadius: '8rpx', backgroundColor: isDark.value ? n.value.textDisabled : (brand[300] as string) }))
const errorArtMiddle = computed((): any => ({ width: '88rpx', height: '42rpx', borderRadius: '12rpx', backgroundColor: isDark.value ? n.value.textTertiary : (brand[100] as string), marginTop: '8rpx' }))
const errorArtBottom = computed((): any => ({ width: '64rpx', height: '8rpx', borderRadius: '8rpx', backgroundColor: isDark.value ? n.value.textSecondary : (brand[200] as string), marginTop: '8rpx' }))

function onLoad() {
  loaded.value = true
  hasError.value = false
  emit('load')
}

function onError() {
  hasError.value = true
  loaded.value = false
  emit('error')
}
</script>
