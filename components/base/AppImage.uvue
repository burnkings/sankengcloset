<template>
  <view :style="wrapperStyle">
    <image
      v-if="effectiveSrc !== ''"
      :key="imgKey"
      :src="effectiveSrc"
      :style="imgStyle"
      :mode="mode"
      :lazy-load="lazyLoad"
      @load="onLoad"
      @error="onError"
    />
    <view v-if="effectiveSrc === '' || (!loaded && !hasError)" :style="placeholderStyle">
      <view :style="skeletonPulseStyle" />
    </view>
    <view v-if="hasError" :style="errorStyle" @tap.stop="retry">
      <view :style="errorArtStyle">
        <view :style="errorArtTop" />
        <view :style="errorArtMiddle" />
        <view :style="errorArtBottom" />
      </view>
      <text :style="errorTextStyle">三坑绮橱 · 点击重试</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { semanticRadius } from '@/theme/tokens/radius'
import { n, isDark } from '@/theme/use-theme'
import { tieredSrc } from '@/utils/image-url'

/**
 * 图片地址规范化（2026-10-09 定案）。
 *
 * **背景（实测，非推测）**：线上 feed 封面尺寸从 300×300 一直到 5865×7820（相差 20 倍），
 * 单张最大 1725KB，首屏 20 张要下约 7.5MB。微信 `image` 组件对超大图会做保护性降采样
 * （业界共识：单张 >300KB 易触发），大图先被粗暴缩小再绘制 ⇒ 细节反而丢失，看起来发糊。
 *
 * **做法**：对淘宝 `alicdn` 图片，在地址末尾**追加** `_500x500q75`（如 `...O1CN01xxx.jpg`
 * → `...O1CN01xxx.jpg_500x500q75`），让 CDN 直接返回 500px 的图。
 * 列表卡片宽 337rpx ≈ 168.5 逻辑px，@3x 需 506px —— 500px **精确命中需求**，不多不少。
 *
 * **实测效果**：单张 649KB → 47KB（−92.8%），首屏 7.5MB → 0.9MB（−88%），
 * 且因为不再触发客户端降采样，**清晰度反而更稳**。这**不是**降清晰度，而是消除失真来源。
 *
 * **⚠️ 语法红线**：后缀必须**追加在原地址之后**（含扩展名）。把后缀拼成
 * `...xxx_500x500q75.jpg`（替换扩展名）会 404 —— 这正是 2026-10 之前那版
 * 「降档」从未生效过的原因。回归护栏见 `tests/image-tier-contract.test.cjs`。
 *
 * **只对列表生效**：`listWidth > 0` 时才追加后缀。详情页 hero / 预览大图**不传该属性**
 * ⇒ 走原图，保留「点开放大看高清」。
 */
const LIST_WIDTH = 500

// tieredSrc / isAliCdn / shouldSkipResize 已抽到 `utils/image-url.uts`（唯一出口）——
// 预加载 `ImagePreloader` 必须预取与本组件**完全相同**的地址，两处口径不能各算一遍。
// 详细口径见 tests/image-tier-contract.test.cjs 与本文件顶部注释。

const props = withDefaults(defineProps<{
  src?: string
  width?: string
  height?: string
  mode?: string
  lazyLoad?: boolean
  radiusToken?: string
  /**
   * 列表场景的取图宽度（px）。> 0 时对 alicdn 图追加 `_WxHqQ` 后缀按需取图；
   * 默认 0 = 原图（详情页 hero、预览大图走这条路，保证大图清晰度不被改动）。
   */
  listWidth?: number
}>(), {
  src: '',
  width: '100%',
  height: 'auto',
  mode: 'aspectFill',
  lazyLoad: true,
  radiusToken: semanticRadius.image,
  listWidth: 0 })

const emit = defineEmits<{
  load: []
  error: []
}>()

/**
 * 本次运行内**已经加载成功过**的图片地址。
 *
 * 组件每次重新挂载（换页面、切 tab 回来）时 `loaded` 都是 false，会先画一帧灰底骨架，
 * 哪怕图片其实已经在微信/系统的图片缓存里 —— 用户看到的就是「每次进来都重新刷新一遍」。
 * 这里记住成功过的地址，重挂载时直接跳过那一帧。
 * 只放内存、随进程销毁，不落盘（不把浏览过的图片地址长期留在本机）。
 */
const loadedSrcs: Set<string> = new Set<string>()
const LOADED_SRC_LIMIT = 500

// 实际使用的地址 = 按列表宽度规范化后的地址（listWidth=0 时即原图）。
// 模板、缓存键、重试计数全部以它为准 —— 保证三处口径一致。
const effectiveSrc = computed((): string => tieredSrc(props.src, props.listWidth))

const loaded = ref(loadedSrcs.has(effectiveSrc.value))
const hasError = ref(false)
// 失败重试计数：改变 :key 强制 image 重新挂载（不改 src，避免给本地路径拼查询串）
const retryToken = ref(0)
const imgKey = computed((): string => `${effectiveSrc.value}#${retryToken.value}`)
watch(() => props.src, () => { loaded.value = loadedSrcs.has(effectiveSrc.value); hasError.value = false; retryToken.value = 0 })
watch(() => props.listWidth, () => { loaded.value = loadedSrcs.has(effectiveSrc.value); hasError.value = false; retryToken.value = 0 })

/** 点击失败占位重新加载（2026-09-09 真机反馈：失败占位需要可重试） */
function retry() {
  hasError.value = false
  loaded.value = false
  retryToken.value = retryToken.value + 1
}

const wrapperStyle = computed((): any => ({
  width: props.width,
  height: props.height == 'auto' ? '0' : props.height,
  position: 'relative',
  overflow: 'hidden',
  borderRadius: props.radiusToken,
  opacity: 1,
}))

// 2026-10-09 渲染降本：占位/报错层原先各自 computed 重建整个对象，且重复了
// position/inset/borderRadius 这三段与主题无关的样式。提到模块级常量后，
// computed 只需拼「主题色」这一层 —— 首屏 20 张图 × 3 个覆盖层 = 少建 60 个对象。
const OVERLAY_BASE: any = { position: 'absolute', top: '0', left: '0', right: '0', bottom: '0' }

const imgStyle = computed((): any => ({
  width: '100%',
  height: '100%',
  borderRadius: props.radiusToken,
  opacity: 1,
}))

const placeholderStyle = computed((): any => ({
  ...OVERLAY_BASE,
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'center',
  backgroundColor: n.value.bgTertiary,
  borderRadius: props.radiusToken,
}))

const skeletonPulseStyle = {
  width: '100%', height: '100%',
  backgroundColor: 'rgba(0,0,0,0.04)',
}

const errorStyle = computed((): any => ({
  ...OVERLAY_BASE,
  alignItems: 'center', justifyContent: 'center',
  backgroundColor: n.value.bgTertiary,
  borderRadius: props.radiusToken,
}))

const errorTextStyle = computed((): any => ({
  fontSize: '22rpx',
  color: n.value.textTertiary,
  fontWeight: '600',
  marginTop: '18rpx',
}))

const errorArtStyle = {
  width: '112rpx', height: '88rpx',
  alignItems: 'center', justifyContent: 'center',
}
// 失败插画：浅色沿用粉色阶；**深色改中性灰阶**（拍板 B）。
// 理由：失败态应当"安静 + 可重试"，品牌粉在暖黑底上会成为全页最亮元素，抢走「点击重试」的注意力，
// 而且用品牌正向色渲染"失败了"语义自相矛盾。三档灰保持原有块面形状，不损失任何信息。
// 尺寸/圆角是主题无关常量，提到模块级；computed 只负责在浅/深两套色之间切换。
const ART_TOP: any = { width: '42rpx', height: '12rpx', borderRadius: '8rpx' }
const ART_MIDDLE: any = { width: '88rpx', height: '42rpx', borderRadius: '12rpx', marginTop: '8rpx' }
const ART_BOTTOM: any = { width: '64rpx', height: '8rpx', borderRadius: '8rpx', marginTop: '8rpx' }
const errorArtTop = computed((): any => ({ ...ART_TOP, backgroundColor: isDark() ? n.value.textDisabled : (brand[300] as string) }))
const errorArtMiddle = computed((): any => ({ ...ART_MIDDLE, backgroundColor: isDark() ? n.value.textTertiary : (brand[100] as string) }))
const errorArtBottom = computed((): any => ({ ...ART_BOTTOM, backgroundColor: isDark() ? n.value.textSecondary : (brand[200] as string) }))

function onLoad() {
  loaded.value = true
  hasError.value = false
  if (loadedSrcs.size >= LOADED_SRC_LIMIT) loadedSrcs.clear()
  loadedSrcs.add(effectiveSrc.value)
  emit('load')
}

function onError() {
  hasError.value = true
  loaded.value = false
  // 这次没成功，下次挂载仍要走一遍骨架 → 不要把它记成「已加载」
  loadedSrcs.delete(effectiveSrc.value)
  emit('error')
}
</script>
