<template>
  <view>
    <view :style="wrapperStyle">
      <view v-if="$slots.prefix" :style="prefixStyle"><slot name="prefix" /></view>
      <input
        :style="inputStyle"
        :type="type"
        :value="modelValue"
        :placeholder="placeholder"
        :placeholder-style="placeholderStyleStr"
        :disabled="disabled"
        :maxlength="maxlength"
        :focus="focus"
        :confirm-type="confirmType"
        @input="onInput"
        @focus="emit('focus')"
        @blur="emit('blur')"
        @confirm="emit('confirm')"
      />
      <view v-if="clearable && modelValue !== ''" :style="clearStyle" @tap.stop="onClear">
        <text :style="clearIconStyle">×</text>
      </view>
      <view v-if="$slots.suffix" :style="suffixStyle"><slot name="suffix" /></view>
    </view>
    <text v-if="error" :style="errorTextStyle">{{ error }}</text>
  </view>
</template>

<script setup lang="uts">
import { semantic } from '@/theme/tokens/colors'
import { semanticRadius } from '@/theme/tokens/radius'
import { fontSize } from '@/theme/tokens/typography'
import { flexRowCenter } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  modelValue?: string
  placeholder?: string
  type?: string
  disabled?: boolean
  error?: string
  clearable?: boolean
  maxlength?: number
  focus?: boolean
  confirmType?: string
}>(), {
  modelValue: '', placeholder: '', type: 'text', disabled: false, error: '',
  clearable: false, maxlength: 140, focus: false, confirmType: 'done'
})

const emit = defineEmits<{
  'update:modelValue': [value: string]
  focus: []
  blur: []
  confirm: []
  clear: []
}>()

const wrapperStyle = computed((): any => ({
  ...flexRowCenter,
  height: '80rpx',
  paddingLeft: '28rpx',
  paddingRight: '16rpx',
  borderRadius: semanticRadius.input,
  backgroundColor: n.value.bgTertiary,
}))
const inputStyle = computed((): any => ({ flex: 1, height: '100%', minWidth: '0', fontSize: fontSize.base, color: n.value.text }))
const placeholderStyleStr = computed(() => `color: ${n.value.placeholder}`)
const prefixStyle = { width: '40rpx', height: '56rpx', alignItems: 'flex-start', justifyContent: 'center', marginRight: '14rpx', flexShrink: 0 }
const suffixStyle = { marginLeft: '12rpx', flexShrink: 0 }
// 56rpx 的独立点击热区，避免叉号边缘难点或事件落到 input。
const clearStyle = { width: '56rpx', height: '56rpx', alignItems: 'center', justifyContent: 'center', marginLeft: '8rpx', flexShrink: 0 }
const clearIconStyle = computed((): any => ({ fontSize: fontSize.base, color: n.value.iconLight, textAlign: 'center' }))
const errorTextStyle = { fontSize: fontSize.xs, color: semantic.error, marginTop: '4rpx', paddingLeft: '8rpx' }

function onInput(e: any) {
  const val = e.detail != null ? (e.detail as any).value : ''
  emit('update:modelValue', val ?? '')
}
function onClear() {
  emit('update:modelValue', '')
  emit('clear')
}
</script>
