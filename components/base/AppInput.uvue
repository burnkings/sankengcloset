<template>
  <view>
    <view :style="wrapperStyle">
      <view v-if="$slots.prefix" :style="prefixStyle">
        <slot name="prefix" />
      </view>
      <input
        :style="inputStyle"
        :type="type"
        :value="modelValue"
        :placeholder="placeholder"
        :placeholder-style="placeholderStyleStr"
        :disabled="disabled"
        :maxlength="maxlength"
        :focus="focus"
        :confirm-type="confirmType"
        @input="onInput"
        @focus="emit('focus')"
        @blur="emit('blur')"
        @confirm="emit('confirm')"
      />
      <view v-if="clearable && modelValue" :style="clearStyle" @tap="onClear">
        <text :style="clearIconStyle"> ✕ </text>
      </view>
      <view v-if="$slots.suffix" :style="suffixStyle">
        <slot name="suffix" />
      </view>
    </view>
    <text v-if="error" :style="errorTextStyle">{{ error }}</text>
  </view>
</template>

<script setup lang="uts">
import { semantic } from '@/theme/tokens/colors'
import { semanticSpacing } from '@/theme/tokens/spacing'
import { semanticRadius } from '@/theme/tokens/radius'
import { fontSize } from '@/theme/tokens/typography'
import { flexRowCenter } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  modelValue?: string
  placeholder?: string
  type?: string
  disabled?: boolean
  error?: string
  clearable?: boolean
  maxlength?: number
  focus?: boolean
  confirmType?: string
}>(), {
  modelValue: '',
  placeholder: '',
  type: 'text',
  disabled: false,
  error: '',
  clearable: false,
  maxlength: 140,
  focus: false,
  confirmType: 'done' })

const emit = defineEmits<{
  'update:modelValue': [value: string]
  focus: []
  blur: []
  confirm: []
  clear: []
}>()


const wrapperStyle = computed((): any => ({
  ...flexRowCenter,
  backgroundColor: n.value.bgTertiary,
  borderRadius: semanticRadius.input,
  paddingHorizontal: semanticSpacing.inputPadding,
  height: '80rpx' }))

const inputStyle = computed((): any => ({
  flex: 1,
  fontSize: fontSize.base,
  color: n.value.text,
  height: '100%' }))

const placeholderStyleStr = computed(() => `color: ${n.value.placeholder}`)

const prefixStyle = (() => {
  const s = {}
  s.marginRight = '8rpx'
  return s
})()

const suffixStyle = (() => {
  const s = {}
  s.marginLeft = '8rpx'
  return s
})()

const clearStyle = (() => {
  const s = {}
  s.padding = '8rpx'
  return s
})()

const clearIconStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.iconLight }))

const errorTextStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: semantic.error,
  marginTop: '4rpx',
  paddingLeft: '8rpx' }))

function onInput(e: any) {
  const val = e.detail != null ? (e.detail as any).value : ''
  emit('update:modelValue', val ?? '')
}

function onClear() {
  emit('update:modelValue', '')
  emit('clear')
}
</script>