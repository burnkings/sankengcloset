<template>
  <view :style="buttonStyle" @tap="handleClick">
    <view v-if="loading" :style="loadingWrapperStyle">
      <view :style="spinnerStyle" />
    </view>
    <slot />
  </view>
</template>

<script setup lang="uts">
import { brand, accent, semantic, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { spacing, semanticSpacing } from '@/theme/tokens/spacing'
import { transition } from '@/theme/tokens/animation'
import { flexRowCenter } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  variant?: string
  size?: string
  block?: boolean
  disabled?: boolean
  loading?: boolean
  color?: string
}>(), {
  variant: 'primary',
  size: 'md',
  block: false,
  disabled: false,
  loading: false })

const emit = defineEmits<{
  click: []
}>()


const variantColors = computed(() => {
  const map = {
    primary: { bg: brand[500], text: baseColors.white, border: brand[500] },
    soft: { bg: brand[300], text: baseColors.white, border: brand[300] },
    secondary: { bg: accent[500], text: baseColors.white, border: accent[500] },
    outline: { bg: 'transparent', text: brand[500], border: brand[500] },
    ghost: { bg: 'transparent', text: brand[500], border: 'transparent' },
    danger: { bg: semantic.error, text: baseColors.white, border: semantic.error } } as any
  return map[props.variant] ?? map['primary']
})

const sizeMap = computed(() => {
  const map = {
    sm: { h: '60rpx', px: spacing[3], fs: fontSize.sm, fw: fontWeight.medium },
    md: { h: '80rpx', px: semanticSpacing.buttonPaddingH, fs: fontSize.base, fw: fontWeight.semibold },
    lg: { h: '96rpx', px: spacing[6], fs: fontSize.lg, fw: fontWeight.semibold } } as any
  return map[props.size] ?? map['md']
})

const buttonStyle = computed((): any => ({
  ...flexRowCenter,
  height: sizeMap.value.h,
  paddingHorizontal: sizeMap.value.px,
  fontSize: sizeMap.value.fs,
  fontWeight: sizeMap.value.fw,
  borderRadius: semanticRadius.button,
  backgroundColor: props.color || variantColors.value.bg,
  color: variantColors.value.text,
  borderWidth: props.variant == 'outline' ? '2rpx' : '0',
  borderStyle: 'solid',
  borderColor: variantColors.value.border,
  opacity: (props.disabled || props.loading) ? 0.5 : 1,
  width: props.block ? '100%' : undefined }))

const loadingWrapperStyle = {
  marginRight: '8rpx' }

const spinnerStyle = {
  width: '28rpx',
  height: '28rpx',
  borderWidth: '3rpx',
  borderStyle: 'solid',
  borderColor: 'rgba(255,255,255,0.3)',
  borderTopColor: '#ffffff',
  borderRadius: '50%' }

function handleClick() {
  if (!props.disabled && !props.loading) {
    emit('click')
  }
}
</script>
