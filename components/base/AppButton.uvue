<template>
  <view :style="buttonStyle" @tap="handleClick">
    <view v-if="loading" :style="loadingWrapperStyle">
      <view :style="spinnerStyle" />
    </view>
    <slot />
  </view>
</template>

<script setup lang="uts">
import { brand, accent, semantic, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { spacing, semanticSpacing } from '@/theme/tokens/spacing'
import { transition } from '@/theme/tokens/animation'
import { flexRowCenter } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  variant?: string
  size?: string
  block?: boolean
  disabled?: boolean
  loading?: boolean
  color?: string
}>(), {
  variant: 'primary',
  size: 'md',
  block: false,
  disabled: false,
  loading: false })

const emit = defineEmits<{
  click: []
}>()


type VariantColor = {
  bg: string
  text: string
  border: string
}

type SizeStyle = {
  h: string
  px: string
  fs: string
  fw: number
}

const variantColors = computed((): VariantColor => {
  const v = props.variant
  if (v === 'soft') return { bg: brand[300] as string, text: brand[700] as string, border: brand[300] as string }
  if (v === 'secondary') return { bg: accent[500] as string, text: baseColors.white as string, border: accent[500] as string }
  if (v === 'outline') return { bg: 'transparent', text: brand[500] as string, border: brand[500] as string }
  if (v === 'ghost') return { bg: 'transparent', text: brand[500] as string, border: 'transparent' }
  if (v === 'danger') return { bg: semantic.error as string, text: baseColors.white as string, border: semantic.error as string }
  return { bg: brand[500] as string, text: baseColors.white as string, border: brand[500] as string }
})

const sizeMap = computed((): SizeStyle => {
  const s = props.size
  if (s === 'sm') return { h: '60rpx', px: spacing[3] as string, fs: fontSize.sm as string, fw: fontWeight.medium as number }
  if (s === 'lg') return { h: '96rpx', px: spacing[6] as string, fs: fontSize.lg as string, fw: fontWeight.semibold as number }
  return { h: '80rpx', px: semanticSpacing.buttonPaddingH as string, fs: fontSize.base as string, fw: fontWeight.semibold as number }
})

const buttonStyle = computed((): any => ({
  ...flexRowCenter,
  height: sizeMap.value.h,
  paddingHorizontal: sizeMap.value.px,
  fontSize: sizeMap.value.fs,
  fontWeight: sizeMap.value.fw,
  borderRadius: semanticRadius.button,
  backgroundColor: props.color ?? variantColors.value.bg,
  color: variantColors.value.text,
  borderWidth: props.variant == 'outline' ? '2rpx' : '0',
  borderStyle: 'solid',
  borderColor: variantColors.value.border,
  opacity: (props.disabled || props.loading) ? 0.5 : 1,
  ...(props.block ? { width: '100%' } : {}) }))

const loadingWrapperStyle = {
  marginRight: '8rpx' }

const spinnerStyle = {
  width: '28rpx',
  height: '28rpx',
  borderWidth: '3rpx',
  borderStyle: 'solid',
  borderColor: 'rgba(255,255,255,0.3)',
  borderTopColor: '#ffffff',
  borderRadius: '50%' }

function handleClick() {
  if (!props.disabled && !props.loading) {
    emit('click')
  }
}
</script>
