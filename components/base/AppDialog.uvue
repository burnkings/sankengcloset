<template>
  <view v-if="visible" :style="overlayStyle" @tap="onOverlayClick">
    <view :style="dialogStyle" @tap.stop>
      <view v-if="title" :style="headerStyle">
        <text :style="titleStyle">{{ title }}</text>
        <view v-if="showClose" :style="closeStyle" @tap="onCancel"><AppIcon name="close" :size="32" /></view>
      </view>
      <view :style="bodyStyle">
        <text v-if="message" :style="messageStyle">{{ message }}</text>
        <slot />
      </view>
      <view v-if="showFooter" :style="footerStyle">
        <slot name="actions">
          <view v-if="showCancel" :style="footerBtn" @tap="onCancel"><text :style="cancelTextStyle">{{ cancelText }}</text></view>
          <view :style="footerBtn" @tap="onConfirm"><text :style="confirmTextStyle">{{ confirmText }}</text></view>
        </slot>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import AppIcon from '@/components/base/AppIcon.uvue'
import { baseColors, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { semanticRadius } from '@/theme/tokens/radius'
import { spacing } from '@/theme/tokens/spacing'
import { zIndex } from '@/theme/tokens/z-index'
import { flexCenter, flexRowEnd } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'

const props = withDefaults(defineProps<{
  visible?: boolean
  title?: string
  message?: string
  showCancel?: boolean
  cancelText?: string
  confirmText?: string
  closeOnOverlay?: boolean
  showFooter?: boolean
  showClose?: boolean
}>(), {
  visible: false,
  showFooter: true,
  showClose: false,
  title: '',
  message: '',
  showCancel: true,
  cancelText: '取消',
  confirmText: '确定',
  closeOnOverlay: true })

const emit = defineEmits<{
  'update:visible': [val: boolean]
  confirm: []
  cancel: []
}>()
const closeStyle = { position: 'absolute', right: '0', top: '0', width: '56rpx', height: '56rpx', alignItems: 'center', justifyContent: 'center' }


const overlayStyle = computed((): any => ({
  position: 'fixed',
  top: '0',
  left: '0',
  right: '0',
  bottom: '0',
  backgroundColor: n.value.overlay,
  ...flexCenter,
  zIndex: zIndex.dialog }))

const dialogStyle = computed((): any => ({
  width: '80%',
  maxWidth: '600rpx',
  backgroundColor: n.value.surface,
  borderRadius: semanticRadius.dialog,
  padding: spacing[5],
  overflow: 'hidden' }))

const headerStyle = (() => {
  const s = {}
  s.position = 'relative'
  s.paddingLeft = '48rpx'
  s.paddingRight = '48rpx'
  s.minHeight = '56rpx'
  s.marginBottom = '24rpx'
  return s
})()

const titleStyle = computed((): any => ({
  fontSize: fontSize.xl,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  textAlign: 'center' }))

const bodyStyle = (() => {
  const s = {}
  s.marginBottom = '32rpx'
  return s
})()

const messageStyle = computed((): any => ({
  fontSize: fontSize.base,
  color: n.value.textSecondary,
  lineHeight: '1.6',
  textAlign: 'center' }))

const footerStyle = (() => {
  const s = {}
  s.flexDirection = 'row'
  s.justifyContent = 'flex-end'
  s.paddingTop = '8rpx'
  return s
})()

const footerBtn = { height: '88rpx', paddingLeft: '32rpx', paddingRight: '32rpx', alignItems: 'center', justifyContent: 'center' }
const cancelTextStyle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.medium, color: n.value.textSecondary, marginRight: '16rpx' }))
const confirmTextStyle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: semantic.error as string }))

function onCancel() {
  emit('update:visible', false)
  emit('cancel')
}

function onOverlayClick() {
  if (props.closeOnOverlay) onCancel()
}

function onConfirm() {
  emit('update:visible', false)
  emit('confirm')
}
</script>
