<template>
  <view v-if="visible" :style="wrapperStyle">
    <view :style="spinnerStyle" />
    <text v-if="text" :style="textStyle">{{ text }}</text>
  </view>
</template>

<script setup lang="uts">
import { n } from '@/theme/use-theme'
import { spacing } from '@/theme/tokens/spacing'
import { fontSize } from '@/theme/tokens/typography'
import { zIndex } from '@/theme/tokens/z-index'

const props = withDefaults(defineProps<{
  visible?: boolean
  text?: string
  size?: string
  overlay?: boolean
  /** 撑满父容器并垂直居中（页面级/区块级加载）；行内小加载保持 false */
  fill?: boolean
}>(), {
  visible: true,
  text: '',
  size: '48rpx',
  overlay: false,
  fill: false })

// uvue 样式不支持 CSS animation / @keyframes（编译期会告警且不生效），
// 改用 JS 定时器驱动 transform: rotate()。25fps × 15° 视觉上足够顺滑，
// 且只重渲染本组件这一小块。
const SPIN_STEP_DEG = 15
const SPIN_INTERVAL_MS = 40
const FILL_MIN_HEIGHT = '360rpx'

const angle = ref(0)
let spinTimer: number | null = null

function startSpin() {
  if (spinTimer != null) return
  spinTimer = setInterval(() => { angle.value = (angle.value + SPIN_STEP_DEG) % 360 }, SPIN_INTERVAL_MS)
}
function stopSpin() {
  const timer = spinTimer
  if (timer != null) { clearInterval(timer); spinTimer = null }
}

watch(() => props.visible, (visible: boolean) => { if (visible) startSpin(); else stopSpin() })
onMounted(() => { if (props.visible) startSpin() })
onUnmounted(() => { stopSpin() })

// fill：撑满父容器（父级是已知高度的 flex 容器时即垂直居中；否则用 minHeight 兜底留白）
const wrapperStyle = computed((): any => ({
  flexDirection: 'column',
  alignItems: 'center',
  justifyContent: 'center',
  padding: spacing[4],
  ...(props.fill ? { flex: 1, width: '100%', minHeight: FILL_MIN_HEIGHT } : {}),
  ...(props.overlay ? {
    position: 'fixed',
    top: '0',
    left: '0',
    right: '0',
    bottom: '0',
    backgroundColor: n.value.overlay,
    zIndex: zIndex.loading } : {}) }))

const spinnerStyle = computed((): any => ({
  width: props.size,
  height: props.size,
  borderWidth: '4rpx',
  borderStyle: 'solid',
  borderColor: n.value.border,
  borderTopColor: n.value.iconActive,
  borderRadius: '999rpx',
  transform: `rotate(${angle.value}deg)` }))

const textStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.iconActive,
  marginTop: spacing[2] }))
</script>
