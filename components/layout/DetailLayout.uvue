<template>
  <view :style="layoutStyle">
    <AppNavbar :title="title" :show-back="showBack">
      <template #right>
        <slot name="right" />
      </template>
    </AppNavbar>
    <scroll-view :style="bodyStyle">
      <view :style="navbarSpacerStyle" />
      <slot />
      <view :style="safeBottomStyle" />
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { semanticSpacing } from '@/theme/tokens/spacing'
import { flexFill } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import { getStatusBarHeight, getWindowHeight } from '@/utils/window-info'
import AppNavbar from '@/components/base/AppNavbar.uvue'

const props = withDefaults(defineProps<{
  title?: string
  showBack?: boolean
}>(), {
  title: '',
  showBack: true })


const statusBarHeight = getStatusBarHeight()

const layoutStyle = computed((): any => ({
  height: `${getWindowHeight()}px`,
  backgroundColor: n.value.bg }))

const bodyStyle = computed((): any => ({
  ...flexFill }))

const navbarSpacerStyle = computed((): any => ({
  height: `${statusBarHeight + 44}px` }))

const safeBottomStyle = computed((): any => ({
  height: semanticSpacing.safeBottom }))
</script>
