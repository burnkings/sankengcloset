<template>
  <view :style="containerStyle">
    <view v-for="item in items" :key="item.id" :style="itemStyle" @tap="open(item.url)">
      <image :src="iconPath(item.id)" :style="iconStyle" mode="aspectFit" />
      <text :style="labelStyle(item.id)">{{ item.label }}</text>
      <view v-if="item.id === active" :style="indicatorStyle" />
    </view>
  </view>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { TAB_BAR_HEIGHT, TAB_ICON_SIZE, TAB_LABEL_FONT } from '@/theme/tokens/responsive'
import { zIndex } from '@/theme/tokens/z-index'
import { n } from '@/theme/use-theme'
import { getSafeBottomInset } from '@/utils/window-info'
import { openPrimaryTab } from '@/utils/tab-navigation'

/**
 * 底部 TabBar — App 唯一可见导航（pages.json APP tabBar custom:true 隐藏原生导航）
 *  - 规则五等分布局：首页 / 发现 / 绮灵AI / 圈子 / 我的
 *  - 图标 44rpx、文字 20rpx，水平垂直居中
 *  - 选中态：图标与文字变 brand[600] + 底部 4rpx 指示条
 *  - 整条底栏（非浮岛），上边框 n.value.divider，随主题变化
 *
 * 仅 App 平台渲染（H5/小程序走 pages.json 原生 tabBar）。
 */
const props = withDefaults(defineProps<{ active?: string }>(), { active: 'home' })

type NavItem = {
  id: string
  label: string
  url: string
}

const items: NavItem[] = [
  { id: 'home', label: '首页', url: '/pages/home/index' },
  { id: 'discover', label: '发现', url: '/pages/discover/index' },
  { id: 'ai', label: '绮灵AI', url: '/pages/ai/index' },
  { id: 'community', label: '圈子', url: '/pages/community/index' },
  { id: 'profile', label: '我的', url: '/pages/profile/index' },
]

const safeBottom = getSafeBottomInset()
const containerStyle = computed((): any => ({
  position: 'fixed',
  left: '0',
  right: '0',
  bottom: '0',
  height: TAB_BAR_HEIGHT,
  paddingBottom: `${safeBottom}px`,
  backgroundColor: n.value.surfaceRaised,
  borderTopWidth: '1rpx',
  borderTopStyle: 'solid',
  borderTopColor: n.value.divider,
  flexDirection: 'row',
  alignItems: 'center',
  zIndex: zIndex.tabbar,
}))

const itemStyle = {
  flexGrow: 1,
  flexShrink: 1,
  flexBasis: 0,
  height: '100%',
  flexDirection: 'column',
  alignItems: 'center',
  justifyContent: 'center',
  position: 'relative',
}

const iconStyle = { width: TAB_ICON_SIZE, height: TAB_ICON_SIZE }
function iconPath(id: string): string {
  return `/static/tabbar/tab-${id}${id === props.active ? '-active' : ''}.png`
}
function labelStyle(id: string) {
  return {
    fontSize: TAB_LABEL_FONT,
    color: id === props.active ? brand[600] : n.value.textTertiary,
    marginTop: '4rpx',
    fontWeight: id === props.active ? '600' : '400',
  }
}
// 选中指示条：底部 4rpx 圆角条，替代旧版 128rpx×96rpx 碎片胶囊
const indicatorStyle = {
  position: 'absolute',
  bottom: '8rpx',
  width: '40rpx',
  height: '4rpx',
  borderRadius: '2rpx',
  backgroundColor: brand[600],
}
function open(url: string) {
  openPrimaryTab(url)
}
</script>
