<template>
  <view :style="cardStyle" @tap="emit('click')">
    <!-- 大封面区域 -->
    <view :style="coverWrapStyle">
      <AppImage
        v-if="item.hasCover"
        :src="item.coverImage"
        width="100%"
        height="100%"
        :radius-token="'0rpx'"
        mode="aspectFill"
      />
      <view v-else :style="placeholderWrap">
        <text :style="placeholderEmoji">{{ item.statusEmoji }}</text>
        <text :style="placeholderText">{{ item.name }}</text>
      </view>
      <!-- 渐变遮罩 -->
      <view v-if="item.hasCover" :style="gradientOverlay" />
      <!-- 封面上的名称（有图时） -->
      <view v-if="item.hasCover" :style="overlayNameWrap">
        <text :style="overlayNameText">{{ item.name }}</text>
      </view>
      <!-- 优先级角标 -->
      <view v-if="item.priorityOrder <= 2" :style="priorityCorner">
        <text :style="priorityCornerText">{{ item.priorityLabel }}</text>
      </view>
      <!-- 收藏标记 -->
      <view v-if="item.isFavorite" :style="favCorner">
        <text :style="favCornerText">❤️</text>
      </view>
    </view>

    <!-- 信息区域 -->
    <view :style="infoSection">
      <view :style="infoTopRow">
        <text v-if="item.brand !== ''" :style="brandText">{{ item.brand }}</text>
        <view :style="statusPill(item.statusColor)">
          <text :style="statusPillText">{{ item.statusText }}</text>
        </view>
      </view>
      <view :style="infoBottomRow">
        <text v-if="item.priceText !== ''" :style="priceText">{{ item.priceText }}</text>
        <text v-else :style="noPriceText">未设预算</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { WishDisplayModel } from '@/domain/wish-presenter'
import { neutralLight, brand, accent, warm, baseColors } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { shadow } from '@/theme/tokens/shadow'
import { flexRow, flexFill, flexRowBetween, flexColumnCenter } from '@/theme/layout/flex'
import { gap } from '@/theme/layout/spacing'
import { n } from '@/theme/use-theme'
import AppImage from '@/components/base/AppImage.uvue'

const props = defineProps<{
  item: WishDisplayModel
}>()

const emit = defineEmits<{
  click: []
}>()


// ====== 样式 ======

const cardStyle = computed((): any => ({
  backgroundColor: n.value.surface,
  borderRadius: semanticRadius.card,
  overflow: 'hidden',
  boxShadow: shadow.card,
}))

// --- 封面区域 ---
const coverWrapStyle = {
  width: '100%',
  height: '360rpx',
  position: 'relative',
  backgroundColor: neutralLight.bgTertiary,
  overflow: 'hidden',
}

const placeholderWrap = {
  width: '100%',
  height: '100%',
  display: 'flex',
  flexDirection: 'column',
  alignItems: 'center',
  justifyContent: 'center',
  gap: spacing[2],
  backgroundColor: warm.blush,
}

const placeholderEmoji = {
  fontSize: '64rpx',
}

const placeholderText = {
  fontSize: fontSize.xs,
  color: brand[300],
  paddingHorizontal: spacing[4],
  textAlign: 'center',
  overflow: 'hidden',
  lines: 1,
}

const gradientOverlay = {
  position: 'absolute',
  bottom: '0',
  left: '0',
  right: '0',
  height: '120rpx',
  backgroundColor: 'rgba(0,0,0,0.35)',
}

const overlayNameWrap = {
  position: 'absolute',
  bottom: spacing[2],
  left: spacing[3],
  right: spacing[3],
}

const overlayNameText = {
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: baseColors.white,
  overflow: 'hidden',
  lines: 2,
  lineHeight: 1.3,
}

const priorityCorner = computed((): any => ({
  position: 'absolute',
  top: '0',
  right: '0',
  paddingHorizontal: spacing[2],
  paddingVertical: spacing[1],
  borderBottomLeftRadius: radius.md,
  backgroundColor: props.item.priorityColor,
}))

const priorityCornerText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.bold,
  color: baseColors.white,
}

const favCorner = {
  position: 'absolute',
  top: spacing[2],
  left: spacing[2],
}

const favCornerText = {
  fontSize: '28rpx',
}

// --- 信息区域 ---
const infoSection = {
  padding: `${spacing[2]} ${spacing[3]}`,
  gap: spacing[1],
}

const infoTopRow = {
  ...flexRowBetween,
  alignItems: 'center',
}

const brandText = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
  ...flexFill,
  overflow: 'hidden',
  lines: 1,
  marginRight: spacing[1],
}))

function statusPill(color: string) {
  return {
    paddingHorizontal: spacing[2],
    paddingVertical: '4rpx',
    borderRadius: radius.full,
    backgroundColor: color + '20',
    flexShrink: 0,
  }
}

const statusPillText = computed((): any => ({
  fontSize: fontSize.xs,
  fontWeight: fontWeight.medium,
}))

const infoBottomRow = {
  ...flexRow,
  alignItems: 'center',
}

const priceText = computed((): any => ({
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: accent[500],
}))

const noPriceText = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
}))
</script>
