<template>
  <DetailLayout title="三坑榜单" show-back>
    <template #right><view :style="refreshButton" @tap="reloadData(true)"><text :style="refreshText">刷新</text></view></template>
    <view :style="contentWrap">
      <!-- 一级筛选：榜单类型 -->
      <view :style="tabBar">
        <SegmentedControl :items="tabItems" :active="activeTab" variant="ranking" @change="onTabChange" />
      </view>

      <!-- 榜单卡片列表 -->
      <scroll-view :style="listScroll" direction="vertical">
        <view :style="listWrap">
          <RankingCard v-for="item in visibleItems" :key="item.entityId" :item="item" :variant="activeTabCode" @tap="openProduct(item)" />
          <PageState v-if="loading" icon="info" title="榜单加载中" message="正在整理近期关注与上新" />
          <PageState v-else-if="errorMessage !== ''" icon="info" title="加载失败" :message="errorMessage" action-text="重试" @action="reloadData(true)" />
          <PageState v-else-if="visibleItems.length === 0" icon="info" title="暂无榜单数据" message="筛选条件下暂无内容" action-text="重新加载" @action="reloadData(true)" />
          <view :style="bottomSpacer" />
        </view>
      </scroll-view>
    </view>
  </DetailLayout>
</template>

<script setup lang="uts">
import { openProductDetail } from '@/utils/content-navigation'
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import SegmentedControl from '@/components/v3/SegmentedControl.uvue'
import RankingCard from '@/components/v3/RankingCard.uvue'
import PageState from '@/components/v3/PageState.uvue'
import { RankingItem, RANKING_TAB_HOT, RANKING_TAB_NEW, RANKING_TAB_FAVORITE } from '@/domain/ranking/ranking-item'
import { peekRanking, fetchRankingRemote } from '@/services/content/ranking-service'
import { PAGE_GUTTER_V3, PAGE_HEADER_CONTENT_GAP } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'

const refreshButton = { minWidth: '88rpx', height: '88rpx', alignItems: 'center', justifyContent: 'center' }
const refreshText = computed((): any => ({ fontSize: '26rpx', color: n.value.iconActive }))
const tabItems = ['热榜', '上新榜', '收藏榜']
const activeTab = ref('热榜')
const activeCategory = ref('全部')
const rankingData = ref<RankingItem[]>([])
const loading = ref(false)
const errorMessage = ref('')

onLoad((options) => {
  initPageTheme()
  if (options != null) {
    const tab = options['tab'] != null ? options['tab'] as string : ''
    if (tab === RANKING_TAB_NEW) activeTab.value = '上新榜'
    if (tab === RANKING_TAB_FAVORITE) activeTab.value = '收藏榜'
  }
})
onShow(() => { reloadData() })

const activeTabCode = computed((): string => {
  if (activeTab.value === '上新榜') return RANKING_TAB_NEW
  if (activeTab.value === '收藏榜') return RANKING_TAB_FAVORITE
  return RANKING_TAB_HOT
})

function onTabChange(tab: string) {
  activeTab.value = tab
  activeCategory.value = '全部'
  reloadData()
}

let requestSequence = 0
async function reloadData(force: boolean = false) {
  const seq = ++requestSequence
  const cached = peekRanking(activeTabCode.value)
  rankingData.value = cached != null ? cached : []
  loading.value = cached == null
  errorMessage.value = ''
  try {
    const items = await fetchRankingRemote(activeTabCode.value, force)
    if (seq === requestSequence) rankingData.value = items
  } catch (e) { if (seq === requestSequence) errorMessage.value = '榜单加载失败，请重试' } finally { if (seq === requestSequence) loading.value = false }
}

const visibleItems = computed((): RankingItem[] => {
  let list = rankingData.value
  if (activeCategory.value !== '全部') {
    list = list.filter((item) => item.category === activeCategory.value)
  }
  return list
})

function openProduct(item: RankingItem) {
  if (item.entityId === '') return
  openProductDetail(item.entityId)
}

const contentWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const tabBar = { marginBottom: '16rpx' }
// 2026-10-04：坑向筛选行已下线（商品列表不再出现坑向分类）。
// activeCategory / visibleItems 的过滤分支保留 —— 它是「按坑向看榜」这个能力的接缝，
// 目前恒为「全部」，不改变任何现有结果。
const listScroll = { flex: 1, minHeight: '0' }
const listWrap = { paddingBottom: '24rpx' }
const bottomSpacer = { height: '32rpx' }
</script>

