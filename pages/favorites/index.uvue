<template>
  <MainLayout :scroll-top="scrollTop" @scroll="onPageScroll">
    <template #navbar><PageHeader title="收藏" /></template>
    <template #default>
      <view :style="tabsTopSpacer" />
      <FilterChips :items="tabs" :active="activeTab" :gutter="PAGE_GUTTER_V3" @change="onTabTap" />

      <view :style="pageCanvasStyle">
        <!-- 商品收藏：统一数据源（content-library-store → 后端 /api/v1/wishlist），三态展示 -->
        <view v-if="activeTab === '商品' && (library.favoritesLoading || !library.favoritesLoadedOnce)" :style="emptyContainer">
          <FeedSkeleton />
        </view>
        <view v-else-if="activeTab === '商品' && library.favoritesError !== '' && library.favoriteProducts.length === 0" :style="emptyContainer">
          <PageState icon="info" title="收藏加载失败" :message="library.favoritesError" action-text="重新加载" @action="reloadFavorites" />
        </view>
        <view v-else-if="activeTab === '商品' && visibleFavoriteProducts.length > 0" :style="contentTop">
          <view v-if="library.favoritesError !== ''" :style="partialErrorWrap">
            <text :style="partialErrorText">{{ library.favoritesError }}</text>
            <text :style="partialErrorAction" @tap="reloadFavorites">重新加载</text>
            <text v-if="library.invalidFavoriteIds.length > 0" :style="partialErrorAction" @tap="clearInvalidFavorites">清除失效</text>
          </view>
          <view :style="productColumns">
            <view :style="productColLeft">
              <view v-for="item in productLeft" :key="item.id">
                <ProductCard
                  :image="item.coverUrl"
                  :brand="item.brandName"
                  :title="item.title"
                  :price-text="productPriceText(item.price)"
                  :badge-text="item.badgeText"
                  :deadline-text="productDeadlineText(item.eventEndAt)"
                  :image-height="feedImageHeight(item)"
                  :saved="library.isFavorite(item.entityId)"
                  @tap="openProduct(item)"
                  @toggle-save="onToggleSave(item)"
                />
              </view>
            </view>
            <view :style="productColRight">
              <view v-for="item in productRight" :key="item.id">
                <ProductCard
                  :image="item.coverUrl"
                  :brand="item.brandName"
                  :title="item.title"
                  :price-text="productPriceText(item.price)"
                  :badge-text="item.badgeText"
                  :deadline-text="productDeadlineText(item.eventEndAt)"
                  :image-height="feedImageHeight(item)"
                  :saved="library.isFavorite(item.entityId)"
                  @tap="openProduct(item)"
                  @toggle-save="onToggleSave(item)"
                />
              </view>
            </view>
          </view>
        </view>

        <view v-else-if="activeTab === '品牌' && library.followedBrands.length > 0" :style="contentTop">
          <view :style="listSections">
            <ListGroup>
              <view v-for="(brandName, idx) in library.followedBrands" :key="brandName" :style="brandRow(idx)">
                <view :style="brandAvatar"><text :style="brandInitial">{{ brandName.substring(0, 1) }}</text></view>
                <text :style="brandNameText">{{ brandName }}</text>
                <text :style="followedText">已关注</text>
                <AppIcon name="chevron-right" :size="30" />
              </view>
            </ListGroup>
          </view>
        </view>

        <view v-else :style="emptyContainer">
          <PageState :icon="emptyIcon" :title="emptyTitleText" :message="emptyDescText" action-text="去发现" @action="goDiscover" />
        </view>
      </view>
    </template>
  </MainLayout>
  <BackToTop :visible="showBackTop" @tap="backToTop" />
</template>

<script setup lang="uts">
import { openPrimaryTab } from '@/utils/tab-navigation'
import { showFeedback } from '@/utils/feedback'
import { FeedItem } from '@/domain/content/feed-item'
import { formatPrice, formatDeadline, feedImageHeight } from '@/stores/home-feed-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useBlacklistStore } from '@/stores/blacklist-store'
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { COLUMN_GAP_V3, PAGE_HEADER_CONTENT_GAP, PRODUCT_CARD_WIDTH_V3, PAGE_GUTTER_V3, FEED_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import BackToTop from '@/components/base/BackToTop.uvue'
import PageHeader from '@/components/v3/PageHeader.uvue'
import FilterChips from '@/components/v3/FilterChips.uvue'
import ProductCard from '@/components/v3/ProductCard.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'

const activeTab = ref('商品')
const tabs = ['商品', '穿搭', '品牌', '合集']
const library = useContentLibraryStore()
const blacklist = useBlacklistStore()

// 返回顶部
const scrollTop = ref(0)
const lastScrollTop = ref(0)
const showBackTop = ref(false)
function onPageScroll(top: number) {
  lastScrollTop.value = top
  showBackTop.value = top > 300
}
function backToTop() {
  showBackTop.value = false
  scrollTop.value = lastScrollTop.value
  nextTick(() => { scrollTop.value = 0 })
}

const emptyTitleText = computed((): string => {
  if (activeTab.value === '品牌') return '还没有关注喜欢的品牌'
  if (activeTab.value === '穿搭') return '暂无收藏的穿搭'
  if (activeTab.value === '合集') return '还没有创建收藏合集'
  return '还没有收藏心动小裙子'
})
const emptyDescText = computed((): string => {
  if (activeTab.value === '品牌') return '在发现页关注品牌，动态会优先来到这里'
  if (activeTab.value === '穿搭') return '收藏的穿搭会显示在这里'
  if (activeTab.value === '合集') return '以后可以按场景整理心动内容'
  return '从新品、预约和降价中慢慢挑选'
})

function onTabTap(tab: string) { activeTab.value = tab }
function productPriceText(cents: number): string { return formatPrice(cents) }
function productDeadlineText(iso: string): string { return formatDeadline(iso) }
function goDiscover() { openPrimaryTab('/pages/discover/index') }
function openProduct(item: FeedItem) { uni.navigateTo({ url: `/pages/product/detail?id=${item.entityId}` }) }
function onToggleSave(item: FeedItem) { library.toggleFavorite(item.entityId, item.title) }
const visibleFavoriteProducts = computed((): FeedItem[] => {
  return library.favoriteProducts.filter((item) => !blacklist.isBlacklisted(item.brandName))
})
const productLeft = computed((): FeedItem[] => {
  const left: FeedItem[] = []
  for (let i = 0; i < visibleFavoriteProducts.value.length; i++) {
    if (i % 2 == 0) left.push(visibleFavoriteProducts.value[i])
  }
  return left
})
const productRight = computed((): FeedItem[] => {
  const right: FeedItem[] = []
  for (let i = 0; i < visibleFavoriteProducts.value.length; i++) {
    if (i % 2 == 1) right.push(visibleFavoriteProducts.value[i])
  }
  return right
})
function openBrand(brandName: string) {
  uni.setStorageSync('pending_search_keyword', brandName)
  uni.navigateTo({ url: '/pages/search/index' })
}
function reloadFavorites() { library.refreshFavorites() }
function clearInvalidFavorites() { library.removeInvalidFavorites(); showFeedback('已清除失效收藏') }
onLoad(() => { initPageTheme() })
onPageShow(() => { initPageTheme(); library.reload(); library.refreshFavorites() })

const tabsTopSpacer = { height: PAGE_HEADER_CONTENT_GAP }
const pageCanvasStyle = {}
const contentTop = { paddingTop: '24rpx' }
const listSections = { paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const emptyContainer = { paddingTop: '24rpx' }
const emptyIcon = computed((): string => {
  if (activeTab.value === '品牌') return 'heart'
  if (activeTab.value === '穿搭') return 'heart'
  if (activeTab.value === '合集') return 'grid'
  return 'wardrobe'
})
// 商品双列错落瀑布流：左右两列独立堆叠（与首页/搜索一致）
const productColumns = { ...flexRow, alignItems: 'flex-start' as string, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const productColLeft = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginRight: COLUMN_GAP_V3 }
const productColRight = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string }
// 品牌：紧凑列表（V3 §6.3 品牌用紧凑列表）
function brandRow(idx: number) { return { ...flexRow, alignItems: 'center', minHeight: '112rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderBottomWidth: idx < library.followedBrands.length - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.border } }
const brandAvatar = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const brandInitial = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: brand[600] }
const brandNameText = computed((): any => ({ ...flexFill, fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const followedText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginRight: '8rpx' }))
// 部分详情加载失败：商品仍展示，顶部提示可恢复
const partialErrorWrap = { ...flexRow, alignItems: 'center', justifyContent: 'center', paddingTop: '16rpx', paddingBottom: '16rpx' }
const partialErrorText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary }))
const partialErrorAction = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: brand[600], marginLeft: '16rpx' }))
</script>


