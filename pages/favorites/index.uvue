<template>
  <MainLayout :scroll-top="scrollTop" :bottom-spacer="pageBottomSpacer" @scroll="onPageScroll">
    <template #navbar>
      <PageHeader v-if="!selectMode" title="收藏" />
      <view v-else :style="selectNavRoot">
        <view :style="selectNavSpacer" />
        <view :style="selectNavRow">
          <text :style="selectAllText" @tap="toggleSelectAll">{{ selectAllLabel }}</text>
          <text :style="selectNavTitle">选择收藏</text>
          <text :style="selectCancelText" @tap="exitSelectMode">取消</text>
        </view>
      </view>
    </template>
    <template #default>
      <view :style="tabsTopSpacer" />
      <FilterChips :items="tabs" :active="activeTab" :gutter="PAGE_GUTTER_V3" @change="onTabTap" />

      <view :style="pageCanvasStyle">
        <!-- 商品收藏：统一数据源（content-library-store → 后端 /api/v1/wishlist），三态展示 -->
        <view v-if="activeTab === '商品' && (library.favoritesLoading || !library.favoritesLoadedOnce)" :style="emptyContainer">
          <FeedSkeleton />
        </view>
        <view v-else-if="activeTab === '商品' && library.favoritesError !== '' && library.favoriteProducts.length === 0" :style="emptyContainer">
          <PageState icon="info" title="收藏加载失败" :message="library.favoritesError" action-text="重新加载" @action="reloadFavorites" />
        </view>
        <view v-else-if="activeTab === '商品' && visibleFavoriteProducts.length > 0" :style="contentTop">
          <view v-if="library.favoritesError !== ''" :style="partialErrorWrap">
            <text :style="partialErrorText">{{ library.favoritesError }}</text>
            <text :style="partialErrorAction" @tap="reloadFavorites">重新加载</text>
            <text v-if="library.invalidFavoriteIds.length > 0" :style="partialErrorAction" @tap="clearInvalidFavorites">清除失效</text>
          </view>
          <view :style="productColumns">
            <view :style="productColLeft">
              <view v-for="item in productLeft" :key="item.id" :style="cardWrap(item.entityId)" @longpress="enterSelectMode(item.entityId)">
                <ProductCard
                  :image="item.coverUrl"
                  :brand="item.brandName"
                  :title="item.title"
                  :type-text="pitTypeLabel(item)"
                  :status-text="saleStatusText(item)"
                  :status-color="saleStatusColor(item)"
                  :price-text="priceSummaryText(item)" :price-sub-text="priceSubText(item)"
                  :image-height="feedImageHeight(item)"
                  :margin-bottom="'0rpx'"
                  :saved="library.isFavorite(item.entityId)"
                  :show-save="!selectMode"
                  @tap="selectMode ? toggleItem(item.entityId) : openProduct(item)"
                  @toggle-save="onToggleSave(item)"
                />
                <view v-if="selectMode" :style="selectCheckWrap">
                  <view :style="selectCheck(selectedIds.indexOf(item.entityId) >= 0)"><AppIcon v-if="selectedIds.indexOf(item.entityId) >= 0" name="check" :size="24" /></view>
                </view>
                <view v-if="!selectMode" :style="decisionRow">
                  <view :style="decisionLeft" @tap.stop="openStatusPicker(item)">
                    <text :style="decisionStatusText">{{ favoriteStatusLabel(item) }}</text>
                    <text :style="decisionReleaseText">{{ favoriteReleaseText(item) }}</text>
                  </view>
                  <view :style="reminderActionWrap" @tap.stop="onEnableReminder(item)"><text :style="reminderActionStyle">{{ reminderActionText(item) }}</text></view>
                </view>
              </view>
            </view>
            <view :style="productColRight">
              <view v-for="item in productRight" :key="item.id" :style="cardWrap(item.entityId)" @longpress="enterSelectMode(item.entityId)">
                <ProductCard
                  :image="item.coverUrl"
                  :brand="item.brandName"
                  :title="item.title"
                  :type-text="pitTypeLabel(item)"
                  :status-text="saleStatusText(item)"
                  :status-color="saleStatusColor(item)"
                  :price-text="priceSummaryText(item)" :price-sub-text="priceSubText(item)"
                  :image-height="feedImageHeight(item)"
                  :margin-bottom="'0rpx'"
                  :saved="library.isFavorite(item.entityId)"
                  :show-save="!selectMode"
                  @tap="selectMode ? toggleItem(item.entityId) : openProduct(item)"
                  @toggle-save="onToggleSave(item)"
                />
                <view v-if="selectMode" :style="selectCheckWrap">
                  <view :style="selectCheck(selectedIds.indexOf(item.entityId) >= 0)"><AppIcon v-if="selectedIds.indexOf(item.entityId) >= 0" name="check" :size="24" /></view>
                </view>
                <view v-if="!selectMode" :style="decisionRow">
                  <view :style="decisionLeft" @tap.stop="openStatusPicker(item)">
                    <text :style="decisionStatusText">{{ favoriteStatusLabel(item) }}</text>
                    <text :style="decisionReleaseText">{{ favoriteReleaseText(item) }}</text>
                  </view>
                  <view :style="reminderActionWrap" @tap.stop="onEnableReminder(item)"><text :style="reminderActionStyle">{{ reminderActionText(item) }}</text></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view v-else-if="activeTab === '品牌' && library.followedBrands.length > 0" :style="contentTop">
          <view :style="listSections">
            <ListGroup>
              <view v-for="(brandName, idx) in library.followedBrands" :key="brandName" :style="brandRow(idx)" @tap="openBrand(brandName)">
                <view :style="brandAvatar"><text :style="brandInitial">{{ brandName.substring(0, 1) }}</text></view>
                <text :style="brandNameText">{{ brandName }}</text>
                <text :style="followedText">已关注</text>
                <AppIcon name="chevron-right" :size="30" />
              </view>
            </ListGroup>
          </view>
        </view>

        <view v-else-if="activeTab === '动态' && likedLooks.length > 0" :style="likedLookList">
          <PostCard v-for="look in likedLooks" :key="look.id" :image="look.imageUrl" :caption="look.caption" :author="look.authorNickname" :avatar-text="look.initial" :time-text="'已收藏'" :like-count="look.likeCount" :liked="true" :product-id="look.productId" @tap="openLook(look.id)" @toggle-like="unlikeLook(look.id)" @more="openLook(look.id)" @product="openLookProduct(look.productId)" />
        </view>

        <view v-else :style="emptyContainer">
          <PageState :icon="emptyIcon" :title="emptyTitleText" :message="emptyDescText" action-text="去发现" @action="goDiscover" />
        </view>

        <AppDialog :visible="showStatusPicker" title="待购状态" @cancel="showStatusPicker = false">
          <view v-for="opt in statusOptions" :key="opt.value" :style="statusOptionRow" @tap="onSelectStatus(opt.value)">
            <text :style="statusOptionText(opt.value)">{{ opt.label }}</text>
            <AppIcon v-if="statusPickerCurrent === opt.value" name="check" :size="28" :active="true" />
          </view>
        </AppDialog>
      </view>
    </template>
  </MainLayout>

  <view v-if="selectMode && selectedIds.length > 0" :style="bottomBar">
    <view :style="deleteButton" @tap="confirmDelete"><text :style="deleteButtonText">删除收藏 ({{ selectedIds.length }})</text></view>
  </view>
  <view v-if="selectMode && selectedIds.length === 0" :style="bottomBar">
    <view :style="deleteDisabled"><text :style="deleteDisabledText">请选择收藏</text></view>
  </view>

  <AppDialog :visible="showDeleteConfirm" title="确认删除" @confirm="batchRemove" @cancel="showDeleteConfirm = false">
    <text :style="dialogText">确定从收藏中移除选中的 {{ selectedIds.length }} 件商品吗？</text>
    <template #actions>
      <view :style="dialogActions">
        <view :style="dialogCancelBtn" @tap="showDeleteConfirm = false"><text :style="dialogCancelBtnText">取消</text></view>
        <view :style="dialogDelBtn" @tap="batchRemove"><text :style="dialogDelBtnText">删除</text></view>
      </view>
    </template>
  </AppDialog>

  <BackToTop :visible="showBackTop" @tap="backToTop" />
</template>

<script setup lang="uts">
import { openProductDetail } from '@/utils/content-navigation'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { showFeedback } from '@/utils/feedback'
import { FeedItem } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
import { feedImageHeight } from '@/stores/home-feed-store'
import { useContentLibraryStore, FAVORITE_STATUS_LABELS } from '@/stores/content-library-store'
import { useBrandStore } from '@/stores/brand-store'
import { useReminderStore } from '@/stores/reminder-store'
import { deriveReleaseStatusText, formatPricePrimary, formatPriceSecondary, getPitTypeLabel, getSaleStatusChipStatus, ProductStatusLabels } from '@/presentation/content/feed-presenter'
import { useBlacklistStore } from '@/stores/blacklist-store'
import { brand, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { COLUMN_GAP_V3, PAGE_HEADER_CONTENT_GAP, PAGE_BOTTOM_SAFE_SPACER, PRODUCT_CARD_WIDTH_V3, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import { getStatusBarHeight } from '@/utils/window-info'
import { zIndex } from '@/theme/tokens/z-index'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import BackToTop from '@/components/base/BackToTop.uvue'
import PageHeader from '@/components/v3/PageHeader.uvue'
import FilterChips from '@/components/v3/FilterChips.uvue'
import ProductCard from '@/components/v3/ProductCard.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'
import PostCard from '@/components/v3/PostCard.uvue'

const activeTab = ref('商品')
const tabs = ['商品', '动态', '品牌']
const library = useContentLibraryStore()
const brandStore = useBrandStore()
const reminderStore = useReminderStore()
const blacklist = useBlacklistStore()

const likedLooks = computed(() => library.publicPosts.filter((post) => library.isPostLiked(post.id) && !blacklist.isBlacklisted(post.authorNickname)))
function openLook(id: string) { uni.navigateTo({ url: `/pages/community/detail?id=${id}` }) }
function openLookProduct(id: string) { if (id !== '') openProductDetail(id) }
function unlikeLook(id: string) { library.togglePostLike(id) }

// 返回顶部：lastScrollTop 仅回顶用，非响应式，避免滚动每帧触发重渲染
const scrollTop = ref(0)
let lastScrollTop = 0
const showBackTop = ref(false)
function onPageScroll(top: number) {
  lastScrollTop = top
  if ((top > 300) !== showBackTop.value) showBackTop.value = top > 300
}
function backToTop() {
  showBackTop.value = false
  scrollTop.value = lastScrollTop
  nextTick(() => { scrollTop.value = 0 })
}

const emptyTitleText = computed((): string => {
  if (activeTab.value === '品牌') return '还没有关注喜欢的品牌'
  if (activeTab.value === '动态') return '暂无收藏的动态'
  return '还没有收藏心动小裙子'
})
const emptyDescText = computed((): string => {
  if (activeTab.value === '品牌') return '在发现页关注品牌，动态会优先来到这里'
  if (activeTab.value === '动态') return '收藏的动态会显示在这里'
  return '从新品和预约里慢慢挑选'
})

// 切 tab 时退出选择态，避免跨 tab 残留勾选
function onTabTap(tab: string) { exitSelectMode(); activeTab.value = tab }

// ====== 长按多选删除（与提醒 / 衣橱 / 购买记录同一套交互：长按进入选择态 → 勾选 → 底部删除 + 二次确认）======
const selectMode = ref(false)
const selectedIds = ref<string[]>([])
const showDeleteConfirm = ref(false)
function enterSelectMode(id: string) {
  selectMode.value = true
  selectedIds.value = [id]
}
function exitSelectMode() {
  selectMode.value = false
  selectedIds.value = []
  showDeleteConfirm.value = false
}
function toggleItem(id: string) {
  const idx = selectedIds.value.indexOf(id)
  if (idx >= 0) {
    const next = [...selectedIds.value]; next.splice(idx, 1); selectedIds.value = next
  } else {
    selectedIds.value = [...selectedIds.value, id]
  }
}
function favoriteIds(): string[] {
  const items = visibleFavoriteProducts.value
  const ids: string[] = []
  for (let i = 0; i < items.length; i++) ids.push(items[i].entityId)
  return ids
}
function toggleSelectAll() {
  const allIds = favoriteIds()
  if (selectedIds.value.length === allIds.length) selectedIds.value = []
  else selectedIds.value = allIds
}
const selectAllLabel = computed((): string => {
  const allIds = favoriteIds()
  return selectedIds.value.length === allIds.length && selectedIds.value.length > 0 ? '取消全选' : '全选'
})
function confirmDelete() {
  if (selectedIds.value.length === 0) return
  showDeleteConfirm.value = true
}
function batchRemove() {
  const ids = [...selectedIds.value]
  const removed = library.removeFavorites(ids)
  showDeleteConfirm.value = false
  showFeedback(removed > 0 ? `已移除 ${removed} 件收藏` : '未移除任何收藏')
  exitSelectMode()
}
// ====== Product V2 商品卡展示字段（价格摘要按 price_type 语义，禁止猜测） ======
function priceSummaryText(item: FeedItem): string {
  return formatPricePrimary(item.priceType, item.price, item.fullPriceCents, item.depositCents, item.balanceCents)
}
/** 双价降级小字（仅定金场景非空） */
function priceSubText(item: FeedItem): string {
  return formatPriceSecondary(item.priceType, item.price, item.fullPriceCents, item.depositCents)
}
function pitTypeLabel(item: FeedItem): string {
  const pit = item.pitType !== '' ? item.pitType : item.category
  return getPitTypeLabel(pit)
}
function saleStatusText(item: FeedItem): string {
  if (item.saleStatus === '') return ''
  const label = ProductStatusLabels[item.saleStatus]
  return label != null ? label as string : ''
}
function saleStatusColor(item: FeedItem): string {
  return getSaleStatusChipStatus(item.saleStatus)
}
function goDiscover() { openPrimaryTab('/pages/discover/index') }
function openProduct(item: FeedItem) { openProductDetail(item.entityId) }
function onToggleSave(item: FeedItem) { library.toggleFavorite(item.entityId, item.title) }

// ====== Phase 1.1-C：发售状态 + 一键提醒（Favorite → Release → Reminder）======

function dateOnly(value: string): string {
  if (value === '') return ''
  return value.length >= 10 ? value.substring(0, 10) : value
}

/** 提醒时间规则（用户明确关注的批次字段）：等待尾款→尾款截止；首发/再贩/现货→开售；
 * 定金/抽选→截止；无对应时间不伪造（返回空串）。 */
function reminderDateFor(release: ReleaseEvent, status: string): string {
  if (status === 'WAIT_BALANCE' && release.balanceDueAt !== '') return dateOnly(release.balanceDueAt)
  if (release.releaseType === 'first_release' || release.releaseType === 'rerelease' || release.releaseType === 'spot') {
    if (release.startAt !== '') return dateOnly(release.startAt)
  }
  if (release.releaseType === 'reservation' || release.releaseType === 'lottery') {
    if (release.endAt !== '') return dateOnly(release.endAt)
  }
  if (release.balanceDueAt !== '') return dateOnly(release.balanceDueAt)
  if (release.endAt !== '') return dateOnly(release.endAt)
  if (release.startAt !== '') return dateOnly(release.startAt)
  return ''
}

/** 收藏卡发售状态行：状态文案（尾款/再贩/抽选/现货/定金/预约…）+ 提醒日期 */
// 长日期（2026-09-20）在窄行里会被拦腰斩断，统一转短格式（9月20日 / 2027年3月8日）
function shortReleaseDate(d: string): string {
  const parts = d.split('-')
  if (parts.length !== 3) return d
  const m = parseInt(parts[1])
  const day = parseInt(parts[2])
  if (isNaN(m) || isNaN(day)) return d
  const now = new Date()
  const sameYear = parseInt(parts[0]) === now.getFullYear()
  return sameYear ? `${m}月${day}日` : `${parts[0]}年${m}月${day}日`
}
/** 发售状态与商品卡上的销售状态是否同义 —— 同义就不再重复展示（评审：同一张卡两处说同一件事）。
 *  两张词表来源不同：销售状态 = ProductStatusLabels（在售/预售中/即将发售…），
 *  发售状态 = deriveReleaseStatusText（开售/预售/预告…），需要一张等价表来对齐。 */
function sameAsSaleStatus(releaseStatus: string, item: FeedItem): boolean {
  const sale = saleStatusText(item)
  if (sale === '' || releaseStatus === '') return false
  if (releaseStatus === sale) return true
  const pairs: string[][] = [
    ['预售', '预售中'],
    ['开售', '在售'],
    ['现货', '在售'],
    ['预告', '即将发售'],
    ['售罄', '已售罄'],
    ['已结束', '已下架'],
  ]
  for (let i = 0; i < pairs.length; i++) {
    const a = pairs[i][0]
    const b = pairs[i][1]
    if ((releaseStatus === a && sale === b) || (releaseStatus === b && sale === a)) return true
  }
  return false
}
function favoriteReleaseText(item: FeedItem): string {
  const release = library.favoriteReleaseOf(item.entityId)
  if (release == null) return '暂无发售信息'
  const statusText = deriveReleaseStatusText(release)
  const date = reminderDateFor(release, library.favoriteStatusOf(item.entityId))
  const datePart = date !== '' ? shortReleaseDate(date) : ''
  // 已与卡片 chip 同义 → 只留日期；否则「状态 + 日期」一次说清
  if (statusText === '' || sameAsSaleStatus(statusText, item)) return datePart !== '' ? datePart : statusText
  return datePart !== '' ? `${statusText} ${datePart}` : statusText
}

/** 提醒按钮文案：已提醒 / 可开启 / 无有效提醒时间 */
function reminderActionText(item: FeedItem): string {
  const reminders = reminderStore.remindersForProduct(item.entityId)
  if (reminders.length > 0) return '已提醒'
  const release = library.favoriteReleaseOf(item.entityId)
  if (release == null) return '开启提醒'
  const date = reminderDateFor(release, library.favoriteStatusOf(item.entityId))
  return date !== '' ? '开启提醒' : '暂无提醒'
}

/** 一键开启提醒：无有效 Release 或无有效提醒时间不创建；重复（同 productId+releaseId+type）不创建 */
function onEnableReminder(item: FeedItem) {
  const release = library.favoriteReleaseOf(item.entityId)
  if (release == null) { showFeedback('该商品暂无发售信息'); return }
  const status = library.favoriteStatusOf(item.entityId)
  const date = reminderDateFor(release, status)
  if (date === '') { showFeedback('该发售暂无提醒时间，暂不能设置'); return }
  const type = status === 'WAIT_BALANCE' ? 'BALANCE' : 'RELEASE'
  const statusText = deriveReleaseStatusText(release)
  const title = `${item.title} ${statusText !== '' ? statusText : '发售'}`
  const note = `${item.brandName} · 来自收藏`
  const created = reminderStore.createProductReminder(item.entityId, release.id, type, title, date, note)
  showFeedback(created != null ? '已开启提醒' : '该提醒已设置过')
}

// 待购状态机（Favorite = 待购决策池）：收藏→想买→等待开售→等待尾款→已购买
class StatusOption {
  value: string = ''
  label: string = ''
}
function createStatusOption(value: string, label: string): StatusOption {
  const o = new StatusOption()
  o.value = value
  o.label = label
  return o
}
const statusOptions: StatusOption[] = [
  createStatusOption('WANT', '想买'),
  createStatusOption('WAIT_RELEASE', '等待开售'),
  createStatusOption('WAIT_BALANCE', '等待尾款'),
  createStatusOption('PURCHASED', '已购买'),
]
const showStatusPicker = ref(false)
const statusPickerCurrent = ref('')
let statusPickerEntityId = ''
function openStatusPicker(item: FeedItem) {
  statusPickerEntityId = item.entityId
  statusPickerCurrent.value = library.favoriteStatusOf(item.entityId)
  showStatusPicker.value = true
}
function onSelectStatus(status: string) {
  if (statusPickerEntityId === '') return
  const productId = statusPickerEntityId
  const product = library.favoriteProducts.find((item) => item.entityId == productId)
  const entry = library.favoriteEntryOf(productId)
  library.updateFavoriteStatus(statusPickerEntityId, status)
  showStatusPicker.value = false
  if (status == 'PURCHASED' && product != null) {
    const amount = product.price > 0 ? (product.price / 100).toString() : ''
    const category = product.category == 'LOLITA' ? 'LOLITA' : product.category == 'HANFU' ? 'HANFU' : 'JK'
    const wishId = entry != null && entry.itemId != '' ? entry.itemId : productId
    const releaseId = entry != null ? entry.releaseId : ''
    uni.navigateTo({ url: `/pages/purchase/edit?name=${encodeURIComponent(product.title)}&brand=${encodeURIComponent(product.brandName)}&amount=${amount}&category=${category}&wishId=${encodeURIComponent(wishId)}&productId=${encodeURIComponent(productId)}&releaseId=${encodeURIComponent(releaseId)}` })
  }
}
/** 待购状态文案 —— **只展示用户自己的决策状态**（想买/等待开售/等待尾款/已购买）。
 *  2026-09-13：不再拿"发售状态"顶替「未设置」。原因：发售状态已经出现在卡片 chip 与右侧发售文字里，
 *  再顶到这一行等于同一件事说三遍；未设置时给「动作提示」而不是"状态断言"，
 *  也就不会再出现「未设置 + 尾款 9月21日」那种自相矛盾。 */
function favoriteStatusLabel(item: FeedItem): string {
  const status = library.favoriteStatusOf(item.entityId)
  const label = FAVORITE_STATUS_LABELS[status]
  if (status === 'WISH' || status === '') return '设置待购状态'
  return label != null ? label as string : '设置待购状态'
}
function statusOptionText(value: string): any {
  const active = statusPickerCurrent.value == value
  return { fontSize: fontSize.base, color: active ? n.value.iconActive : n.value.text, fontWeight: active ? fontWeight.semibold : fontWeight.regular }
}
const visibleFavoriteProducts = computed((): FeedItem[] => {
  return library.favoriteProducts.filter((item) => !blacklist.isBlacklisted(item.brandName))
})
const productLeft = computed((): FeedItem[] => {
  const left: FeedItem[] = []
  for (let i = 0; i < visibleFavoriteProducts.value.length; i++) {
    if (i % 2 == 0) left.push(visibleFavoriteProducts.value[i])
  }
  return left
})
const productRight = computed((): FeedItem[] => {
  const right: FeedItem[] = []
  for (let i = 0; i < visibleFavoriteProducts.value.length; i++) {
    if (i % 2 == 1) right.push(visibleFavoriteProducts.value[i])
  }
  return right
})
async function openBrand(brandName: string) {
  try {
  const list = await brandStore.fetchBrands()
  const matched = list.find((item) => item.name === brandName)
  const id = matched != null ? matched.id : brandName
  uni.navigateTo({ url: `/pages/brand/detail?id=${encodeURIComponent(id)}&name=${encodeURIComponent(brandName)}` })
  } catch (e) { showFeedback('品牌加载失败，请重试') }
}
function reloadFavorites() { library.refreshFavorites() }
function clearInvalidFavorites() { library.removeInvalidFavorites(); showFeedback('已清除失效收藏') }
onLoad(() => { initPageTheme() })
// 网络请求 30s TTL：频繁切 tab 不重复拉取（本地 reload 每次仍执行）
let lastFavoritesFetchAt = 0
onPageShow(() => {
  exitSelectMode()
  initPageTheme()
  library.reload()
  const now = Date.now()
  if (now - lastFavoritesFetchAt >= 30000) { lastFavoritesFetchAt = now; library.refreshFavorites() }
  library.refreshPublicPosts()
})

const tabsTopSpacer = { height: PAGE_HEADER_CONTENT_GAP }
const pageCanvasStyle = {}
const contentTop = { paddingTop: '24rpx' }
const listSections = { paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const emptyContainer = { paddingTop: '24rpx' }
const emptyIcon = computed((): string => {
  if (activeTab.value === '品牌') return 'heart'
  if (activeTab.value === '动态') return 'heart'
  return 'wardrobe'
})
// 商品双列错落瀑布流：左右两列独立堆叠（与首页/搜索一致）
const productColumns = { ...flexRow, alignItems: 'flex-start' as string, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const productColLeft = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginRight: COLUMN_GAP_V3 }
const productColRight = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string }
// 收藏决策行：待购状态 + 发售日期/提醒按钮合并为一行，左右各留内边距（原两行且贴边框）
const decisionRow = computed((): any => ({ ...flexRow, alignItems: 'center', justifyContent: 'space-between', marginTop: '8rpx', marginBottom: '20rpx', paddingLeft: '16rpx', paddingRight: '16rpx', paddingTop: '12rpx', paddingBottom: '12rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary }))
// 两行结构：上行购买状态、下行发售/截止信息，避免三段挤一行把日期拦腰斩断
const decisionLeft = { flex: 1, justifyContent: 'center' }
const decisionStatusText = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.iconActive }))
const decisionReleaseText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, lines: 1, textOverflow: 'ellipsis', whiteSpace: 'nowrap', marginTop: '4rpx' }))
// 裸 <text> 当按钮热区不足：外层补 88rpx 容器，视觉不变
const reminderActionWrap = { height: '88rpx', paddingLeft: '16rpx', paddingRight: '16rpx', alignItems: 'center', justifyContent: 'center', flexShrink: 0, marginLeft: '8rpx' }
const reminderActionStyle = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.iconActive }))
const statusOptionRow = computed((): any => ({ ...flexRow, alignItems: 'center', justifyContent: 'space-between', minHeight: '88rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderBottomWidth: '1rpx', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.border }))
// 品牌：紧凑列表（V3 §6.3 品牌用紧凑列表）
function brandRow(idx: number) { return { ...flexRow, alignItems: 'center', minHeight: '112rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderBottomWidth: idx < library.followedBrands.length - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.border } }
const brandAvatar = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const brandInitial = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.iconActive }))
const brandNameText = computed((): any => ({ ...flexFill, fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const followedText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginRight: '8rpx' }))
// 部分详情加载失败：商品仍展示，顶部提示可恢复
const partialErrorWrap = { ...flexRow, alignItems: 'center', justifyContent: 'center', paddingTop: '16rpx', paddingBottom: '16rpx' }
const partialErrorText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary }))
const partialErrorAction = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.iconActive, marginLeft: '16rpx' }))
const likedLookList = { paddingTop: '24rpx', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }

// ====== 选择态样式（长按多选删除）======
const statusBarH = getStatusBarHeight()
const selectNavRoot = computed((): any => ({ position: 'fixed' as string, top: '0', left: '0', right: '0', zIndex: zIndex.navbar, backgroundColor: n.value.bg }))
const selectNavSpacer = { height: `${statusBarH}px` }
const selectNavRow = computed((): any => ({ height: '96rpx', ...flexRow, alignItems: 'center', justifyContent: 'space-between', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }))
const selectNavTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const selectAllText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: n.value.iconActive }))
const selectCancelText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: n.value.textSecondary }))
// 选择态：未选中卡降透明度，选中卡保持原样（不改变布局，避免瀑布流跳动）
function cardWrap(id: string): any {
  const selected = selectedIds.value.indexOf(id) >= 0
  return { position: 'relative' as string, opacity: selectMode.value && !selected ? 0.55 : 1 }
}
const selectCheckWrap = computed((): any => ({ position: 'absolute', top: '0', left: '0', width: '88rpx', height: '88rpx', alignItems: 'center', justifyContent: 'center', zIndex: 2 }))
function selectCheck(checked: boolean): any {
  return { width: '44rpx', height: '44rpx', borderRadius: '22rpx', borderWidth: '2rpx', borderStyle: 'solid' as string, borderColor: checked ? (n.value.iconActive) : n.value.border, backgroundColor: checked ? (n.value.iconActive) : n.value.surface, alignItems: 'center', justifyContent: 'center' }
}
// 底部留白：多选态会浮起删除栏（paddingTop 20 + 按钮 88 + paddingBottom 40 ≈ 148rpx），
// 只用默认的安全区留白会**盖住最后一行卡片**（与 product/detail 同类问题）。
const pageBottomSpacer = computed((): string => selectMode ? '188rpx' : PAGE_BOTTOM_SAFE_SPACER)
const bottomBar = computed((): any => ({ position: 'fixed', bottom: '0', left: '0', right: '0', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3, paddingBottom: '40rpx', paddingTop: '20rpx', backgroundColor: n.value.surface }))
const deleteButton = computed((): any => ({ height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.iconActive, alignItems: 'center', justifyContent: 'center' }))
const deleteButtonText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: '#FFFFFF' }
const deleteDisabled = computed((): any => ({ height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.bgTertiary, alignItems: 'center', justifyContent: 'center' }))
const deleteDisabledText = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.textTertiary }))
const dialogText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, textAlign: 'center', padding: '24rpx' }))
const dialogActions = computed((): any => ({ flexDirection: 'row', justifyContent: 'flex-end', paddingTop: '8rpx' }))
const dialogCancelBtn = computed((): any => ({ height: '88rpx', paddingLeft: '32rpx', paddingRight: '32rpx', alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const dialogCancelBtnText = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.medium, color: n.value.textSecondary }))
const dialogDelBtn = computed((): any => ({ height: '88rpx', paddingLeft: '32rpx', paddingRight: '32rpx', alignItems: 'center', justifyContent: 'center' }))
const dialogDelBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: semantic.error as string }
// 全面屏手势 / 实体返回键：先关掉当前叠加层（弹窗 / 选择态），不要直接退出页面。
// 说明：iOS 原生侧滑返回不触发 onBackPress（uni-app x 官方限制），Android 手势返回与实体返回键会触发。
onBackPress((): boolean => {
  if (showStatusPicker.value) { showStatusPicker.value = false; return true }
  if (showDeleteConfirm.value) { showDeleteConfirm.value = false; return true }
  if (selectMode.value) { exitSelectMode(); return true }
  return false
})
</script>
