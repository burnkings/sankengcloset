<template>
  <DetailLayout title="深色模式">
    <view :style="contentWrap">
      <ListGroup>
        <view :style="rowShell" @tap="onSystemToggle(!isSystemMode)">
          <view :style="rowLabelWrap">
            <text :style="rowLabel">跟随系统</text>
            <text :style="rowSubtitle">开启后根据系统设置同步切换深/浅模式</text>
          </view>
          <AppSwitch :key="isSystemMode ? 'system-on' : 'system-off'" :model-value="isSystemMode" @update:modelValue="onSystemToggle" />
        </view>
      </ListGroup>
      <view :style="rowGap" />
      <ListGroup>
        <view :style="rowShell" @tap="onDarkToggle(!isDarkMode)">
          <view :style="rowLabelWrap">
            <text :style="rowLabel">深色模式</text>
            <text :style="rowSubtitle">手动开启深色外观</text>
          </view>
          <AppSwitch :key="isDarkMode ? 'dark-on' : 'dark-off'" :model-value="isDarkMode" @update:modelValue="onDarkToggle" />
        </view>
      </ListGroup>
    </view>
  </DetailLayout>
</template>

<script setup lang="uts">
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import AppSwitch from '@/components/v3/AppSwitch.uvue'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_GUTTER_V3, LIST_GROUP_HORIZONTAL_V3 } from '@/theme/tokens/responsive'
import { n, themeMode, setThemeMode, initPageTheme } from '@/theme/use-theme'

const isSystemMode = computed((): boolean => n.themeMode == 'system')
const isDarkMode = computed((): boolean => n.themeMode == 'dark')

function onSystemToggle(on: boolean) {
  if (on) setThemeMode('system')
  else setThemeMode('light')
}
function onDarkToggle(on: boolean) {
  if (on) setThemeMode('dark')
  else setThemeMode('light')
}

onLoad(() => { initPageTheme() })

const contentWrap = { paddingTop: '24rpx', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const rowGap = { height: '12rpx' }
const rowShell = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '112rpx', paddingLeft: LIST_GROUP_HORIZONTAL_V3, paddingRight: LIST_GROUP_HORIZONTAL_V3, backgroundColor: n.value.surface }))
const rowLabelWrap = { flex: 1 }
const rowLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: n.value.text }))
const rowSubtitle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx' }))
</script>
