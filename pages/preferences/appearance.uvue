<template>
  <DetailLayout title="深色模式">
    <view :style="contentWrap">
      <V2ListGroup>
        <view :style="rowShell(0, 2)">
          <V2ListRow label="跟随系统" subtitle="开启后根据系统设置同步切换深/浅模式" :show-arrow="false">
            <template #trailing>
              <view :style="toggleWrap(themeMode == 'system')" @tap.stop="() => setThemeMode('system')"><view :style="toggleKnob" /></view>
            </template>
          </V2ListRow>
        </view>
        <view :style="rowShell(1, 2)">
          <V2ListRow label="深色模式" :show-arrow="false">
            <template #trailing>
              <view :style="toggleWrap(themeMode == 'dark')" @tap.stop="() => setThemeMode('dark')"><view :style="toggleKnob" /></view>
            </template>
          </V2ListRow>
        </view>
      </V2ListGroup>
    </view>
  </DetailLayout>
</template>

<script setup lang="uts">
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import V2ListGroup from '@/components/v2/V2ListGroup.uvue'
import V2ListRow from '@/components/v2/V2ListRow.uvue'
import { brand } from '@/theme/tokens/colors'
import { PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, themeMode, setThemeMode } from '@/theme/use-theme'
const contentWrap = { paddingTop: '24rpx', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
function rowShell(idx: number, total: number) { return { borderBottomWidth: idx < total - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.divider } }
function toggleWrap(on: boolean) { return { width: '104rpx', height: '60rpx', borderRadius: '30rpx', backgroundColor: on ? (brand[500] as string) : n.value.bgTertiary, justifyContent: 'center', alignItems: on ? 'flex-end' : 'flex-start', paddingHorizontal: '6rpx' } }
const toggleKnob = { width: '48rpx', height: '48rpx', borderRadius: '24rpx', backgroundColor: '#FFFFFF' }
</script>