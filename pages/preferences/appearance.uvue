<template>
  <DetailLayout title="深色模式">
    <view :style="contentWrap">
      <V2ListGroup>
        <V2ListRow label="跟随系统" subtitle="开启后根据系统设置同步切换深/浅模式" :show-arrow="false">
          <template #trailing>
            <V2Switch v-model="isSystemMode" @update:model-value="onSystemToggle" />
          </template>
        </V2ListRow>
      </V2ListGroup>
      <view :style="rowGap" />
      <V2ListGroup>
        <V2ListRow label="深色模式" :show-arrow="false">
          <template #trailing>
            <V2Switch v-model="isDarkMode" @update:model-value="onDarkToggle" />
          </template>
        </V2ListRow>
      </V2ListGroup>
    </view>
  </DetailLayout>
</template>

<script setup lang="uts">
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import V2ListGroup from '@/components/v2/V2ListGroup.uvue'
import V2ListRow from '@/components/v2/V2ListRow.uvue'
import V2Switch from '@/components/v2/V2Switch.uvue'
import { PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, themeMode, setThemeMode } from '@/theme/use-theme'
const contentWrap = { paddingTop: '24rpx', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const rowGap = { height: '12rpx' }

const isSystemMode = computed((): boolean => themeMode.value == 'system')
const isDarkMode = computed((): boolean => themeMode.value == 'dark')

function onSystemToggle(on: boolean) {
  if (on) {
    setThemeMode('system')
  } else {
    setThemeMode('light')
  }
}

function onDarkToggle(on: boolean) {
  if (on) {
    setThemeMode('dark')
  } else {
    setThemeMode('light')
  }
}
</script>