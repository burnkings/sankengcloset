<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="内容偏好" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="introCard">
          <text :style="introTitle">选择你喜欢的坑向</text>
          <text :style="introDesc">首页「推荐」会优先展示所选坑向；可多选，全部取消时不限制内容。</text>
        </view>
        <view :style="pitRow">
          <view v-for="(item, idx) in pitItems" :key="item" :style="pitChip(idx, item)" @tap="togglePit(item)">
            <text :style="pitText(item)">{{ item }}</text>
          </view>
        </view>
        <view :style="resetRow" @tap="onReset"><text :style="resetText">重置为全部坑向</text></view>
        <text :style="footerNote">保存后回到首页，下次刷新即生效</text>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, GROUP_GAP, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import { showFeedback } from '@/utils/feedback'
import { usePreferencesStore } from '@/stores/preferences-store'

const prefs = usePreferencesStore()
const pitItems = ['JK', 'Lolita', '汉服']
function isPitSelected(name: string): boolean {
  const code = name === 'Lolita' ? 'LOLITA' : name
  return prefs.preferences.pitTypes.indexOf(code) >= 0
}
function togglePit(name: string) { prefs.togglePitType(name) }
function onReset() { prefs.resetPreferences(); showFeedback('已恢复全部坑向') }

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const introCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, marginBottom: '28rpx' }))
const introTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const introDesc = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '42rpx', marginTop: '10rpx' }))
const pitRow = { ...flexRow, marginBottom: '36rpx' }
function pitChip(idx: number, item: string) { const selected = isPitSelected(item); return { width: '200rpx', height: '100rpx', borderRadius: CARD_RADIUS, alignItems: 'center', justifyContent: 'center', backgroundColor: selected ? brand[50] : n.value.surface, borderWidth: selected ? '1rpx' : '0', borderStyle: 'solid', borderColor: brand[200], marginRight: idx < 2 ? GROUP_GAP : '0' } }
function pitText(item: string) { return { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: isPitSelected(item) ? brand[700] : n.value.textSecondary } }
const resetRow = { alignItems: 'center', paddingTop: '20rpx', paddingBottom: '20rpx' }
const resetText = { fontSize: fontSize.sm, color: brand[600] }
const footerNote = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, textAlign: 'center', marginTop: '28rpx' }))
</script>
