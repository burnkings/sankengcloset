<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="坑向偏好" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <text :style="hintText">选择你感兴趣的坑向，默认展示全部</text>
        <view :style="pitRow">
          <view v-for="(item, idx) in pitItems" :key="item" :style="pitChip(idx, item)" @tap="togglePit(item)">
            <text :style="pitText(item)">{{ item }}</text>
          </view>
        </view>
        <view :style="resetRow" @tap="onReset"><text :style="resetText">重置默认</text></view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { CARD_RADIUS, PAGE_HEADER_CONTENT_GAP, GROUP_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import { showFeedback } from '@/utils/feedback'
import { usePreferencesStore } from '@/stores/preferences-store'

const prefs = usePreferencesStore()
const pitItems = ['JK', 'Lolita', '汉服']

function isPitSelected(name: string): boolean {
  const values = prefs.preferences.pitTypes
  for (let i = 0; i < values.length; i++) { if (values[i] == name) return true }
  return false
}
function togglePit(name: string) { prefs.togglePitType(name) }
function onReset() { prefs.resetPreferences(); showFeedback('已重置') }

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const hintText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, marginBottom: '24rpx', lineHeight: '38rpx' }))
const pitRow = { ...flexRow, marginBottom: '32rpx' }
function pitChip(idx: number, item: string) {
  const selected = isPitSelected(item)
  return { ...flexRow, alignItems: 'center', justifyContent: 'center', width: '200rpx', height: '88rpx', borderRadius: CARD_RADIUS, backgroundColor: selected ? brand[50] : n.value.surface, borderWidth: selected ? '2rpx' : '1rpx', borderStyle: 'solid' as string, borderColor: selected ? (brand[500] as string) : n.value.cardBorder, marginRight: idx < 2 ? GROUP_GAP : '0' }
}
function pitText(item: string) { return { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: isPitSelected(item) ? (brand[700] as string) : n.value.textSecondary } }
const resetRow = { alignItems: 'center', paddingTop: '20rpx' }
const resetText = { fontSize: fontSize.sm, color: brand[600] }
</script>