<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="内容偏好" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <text :style="hintText">用于首页推荐与发现排序，可多选</text>
        <view :style="pitRow">
          <view v-for="(item, idx) in pitItems" :key="item" :style="pitChip(idx, item)" @tap="togglePit(item)">
            <text :style="pitText(item)">{{ item }}</text>
          </view>
        </view>
        <text :style="sectionTitle">价格偏好</text>
        <text :style="hintText">用于减少明显超出预算的推荐，不会隐藏你的主动搜索结果</text>
        <view :style="priceRow">
          <view v-for="item in priceItems" :key="item.value" :style="priceChip(item.value)" @tap="setPrice(item.value)">
            <text :style="priceText(item.value)">{{ item.label }}</text>
          </view>
        </view>
        <view :style="resetRow" @tap="onReset"><text :style="resetText">重置默认</text></view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import { showFeedback } from '@/utils/feedback'
import { usePreferencesStore } from '@/stores/preferences-store'

const prefs = usePreferencesStore()
const pitItems = ['JK', 'Lolita', '汉服']
class PriceOption { label: string = ''; value: string = '' }
function priceOption(label: string, value: string): PriceOption { const item = new PriceOption(); item.label = label; item.value = value; return item }
const priceItems = [priceOption('不限', 'all'), priceOption('¥300 内', '0-300'), priceOption('¥300–600', '300-600'), priceOption('¥600+', '600+')]

function isPitSelected(name: string): boolean {
  const values = prefs.preferences.pitTypes
  for (let i = 0; i < values.length; i++) { if (values[i] == name) return true }
  return false
}
function togglePit(name: string) { prefs.togglePitType(name) }
function setPrice(value: string) { prefs.setPriceRange(value) }
function onReset() { prefs.resetPreferences(); showFeedback('已重置') }

onLoad(() => { initPageTheme() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
const hintText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, marginBottom: '24rpx', lineHeight: '38rpx' }))
const pitRow = { ...flexRow, marginBottom: '32rpx' }
const sectionTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, marginBottom: '8rpx' }))
const priceRow = { ...flexRow, flexWrap: 'wrap' as string, marginBottom: '24rpx' }
function priceChip(value: string): any {
  const selected = prefs.preferences.priceRange == value
  return { height: '56rpx', paddingLeft: '24rpx', paddingRight: '24rpx', borderRadius: '9999rpx', backgroundColor: selected ? n.value.surfacePink : n.value.bgSecondary, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: selected ? 'transparent' : n.value.border, alignItems: 'center', justifyContent: 'center', marginRight: '12rpx', marginBottom: '12rpx' }
}
function priceText(value: string): any { return { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: prefs.preferences.priceRange == value ? brand.primary : n.value.textSecondary } }
// V3 §5.7 多选胶囊：选中品牌浅底+深色文字
function pitChip(idx: number, item: string) {
  const selected = isPitSelected(item)
  return { ...flexRow, alignItems: 'center', justifyContent: 'center', height: '56rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '9999rpx', backgroundColor: selected ? n.value.surfacePink : n.value.bgSecondary, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: selected ? 'transparent' : n.value.border, marginRight: idx < 2 ? '12rpx' : '0' }
}
function pitText(item: string) { return { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: isPitSelected(item) ? brand.primary : n.value.textSecondary } }
const resetRow = { alignItems: 'center', paddingTop: '20rpx' }
const resetText = { fontSize: fontSize.sm, color: brand[600] }
</script>
