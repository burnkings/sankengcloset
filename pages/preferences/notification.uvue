<template>
  <DetailLayout title="通知设置">
    <view :style="contentWrap">
      <!-- V3 §6.25：总开关 + 发售/尾款/到货/互动分项；整行点击热区，副标题解释影响 -->
      <ListGroup>
        <view :style="rowShell" @tap="onTogglePush">
          <view :style="rowLabelWrap">
            <text :style="rowLabel">接收通知</text>
            <text :style="rowSubtitle">开启后接收提醒与互动通知</text>
          </view>
          <AppSwitch v-model="pushEnabled" />
        </view>
      </ListGroup>
      <view :style="rowGap" />
      <ListGroup>
        <view v-for="(item, idx) in categoryItems" :key="item.key" :style="catRow(idx, categoryItems.length)" @tap="toggleCategory(item.key)">
          <view :style="rowLabelWrap">
            <text :style="catLabel">{{ item.label }}</text>
            <text :style="catSubtitle">{{ item.desc }}</text>
          </view>
          <AppSwitch v-model="item.enabled" :disabled="!pushEnabled" />
        </view>
      </ListGroup>
    </view>
  </DetailLayout>
</template>

<script setup lang="uts">
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import AppSwitch from '@/components/v3/AppSwitch.uvue'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_GUTTER_V3, LIST_GROUP_HORIZONTAL_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import { notificationAuthorized, openNotificationSetting } from '@/utils/notify'

const NOTIFY_ENABLED_KEY = 'v2_notify_enabled'
const pushEnabled = ref(true)
function loadPushEnabled() {
  try {
    const v = uni.getStorageSync(NOTIFY_ENABLED_KEY)
    pushEnabled.value = v == null || v as string === '' ? true : (v as string) === '1'
  } catch (e) {}
}
function savePushEnabled() {
  try { uni.setStorageSync(NOTIFY_ENABLED_KEY, pushEnabled.value ? '1' : '0') } catch (e) {}
}
function onTogglePush() {
  pushEnabled.value = !pushEnabled.value
  savePushEnabled()
  if (pushEnabled.value && !notificationAuthorized()) {
    uni.showModal({
      title: '开启通知',
      content: '需要允许通知权限，才能收到尾款、到货与发售提醒。是否前往系统设置开启？',
      confirmText: '去设置',
      cancelText: '暂不',
      success: (res) => {
        const r = res as UTSJSONObject
        if (r['confirm'] == true) openNotificationSetting()
      },
    })
  }
}
class CategoryItem {
  key: string = ''
  label: string = ''
  desc: string = ''
  enabled: boolean = true
}
function mkCat(key: string, label: string, desc: string, enabled: boolean): CategoryItem {
  const c = new CategoryItem()
  c.key = key; c.label = label; c.desc = desc; c.enabled = enabled
  return c
}
const categoryItems = ref([
  mkCat('release', '发售提醒', '新品、预约与再贩开售', true),
  mkCat('balance', '尾款提醒', '定金订单的尾款截止', true),
  mkCat('arrival', '到货提醒', '包裹预计送达', true),
  mkCat('social', '互动通知', '点赞与动态评论', true),
])
function toggleCategory(key: string) {
  if (!pushEnabled.value) return
  for (let i = 0; i < categoryItems.value.length; i++) {
    if (categoryItems.value[i].key === key) { categoryItems.value[i].enabled = !categoryItems.value[i].enabled; break }
  }
}

onLoad(() => { initPageTheme(); loadPushEnabled() })

const contentWrap = { paddingTop: '24rpx', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const rowGap = { height: '12rpx' }
const rowShell = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '112rpx', paddingLeft: LIST_GROUP_HORIZONTAL_V3, paddingRight: LIST_GROUP_HORIZONTAL_V3, backgroundColor: n.value.surface }))
const rowLabelWrap = { flex: 1 }
const rowLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: n.value.text }))
const rowSubtitle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx' }))
const catLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: pushEnabled.value ? n.value.text : n.value.textDisabled }))
const catSubtitle = computed((): any => ({ fontSize: fontSize.xs, color: pushEnabled.value ? n.value.textTertiary : n.value.textDisabled, marginTop: '4rpx' }))
function catRow(idx: number, total: number): any {
  return { ...flexRow, alignItems: 'center', minHeight: '112rpx', paddingLeft: LIST_GROUP_HORIZONTAL_V3, paddingRight: LIST_GROUP_HORIZONTAL_V3, backgroundColor: n.value.surface, opacity: pushEnabled.value ? 1 : 0.4, borderBottomWidth: idx < total - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.border }
}
</script>
