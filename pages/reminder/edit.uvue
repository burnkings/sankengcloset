<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar>
      <AppNavbar :title="isEdit ? '编辑提醒' : '新建提醒'" :show-back="false">
        <template #left>
          <text :style="customBackStyle" @tap="handleBack"><AppIcon name="arrow-back" :size="40" /></text>
        </template>
      </AppNavbar>
    </template>
    <template #default>
      <scroll-view :style="scrollWrap">
        <view class="page-canvas" :style="pageWrap">

          <V2FormSection title="基础信息">
            <view :style="typeRow">
              <view v-for="t in typeOptions" :key="t.value" :style="typeChip(t)" @tap="onTypeSelect(t.value)"><text :style="typeChipText(t)">{{ t.label }}</text></view>
            </view>
            <AppInput v-model="form.title" :placeholder="typePlaceholder" :clearable="true" />
          </V2FormSection>

          <V2FormSection title="提醒时间">
            <V2DatePicker label="日期" :value="form.remindDate" placeholder="选择日期" mode="date" @change="onDatePick" />
            <view :style="timeFieldRow">
              <text :style="timeFieldLabel">时间</text>
              <view :style="timeRight">
                <view :style="timeSwitchRow">
                  <text :style="timeSwitchLabel">全天</text>
                  <V2Switch :model-value="form.isAllDay" @update:model-value="onAllDayChange" />
                </view>
                <V2DatePicker v-if="!form.isAllDay" label="" :value="form.remindTime" placeholder="选择时间" mode="time" @change="onTimePick" />
                <text v-else :style="timeDisabledText">全天</text>
              </view>
            </view>
          </V2FormSection>

          <V2FormSection title="提醒配置" :collapsible="true" :open="advancedOpen" @toggle="toggleAdvanced">
            <view :style="advancedFieldRow">
              <text :style="advancedFieldLabel">多级预警提醒</text>
              <V2Switch :model-value="form.multiAlert" :disabled="!isMultiAlertAvailable" @update:model-value="onMultiAlertChange" />
            </view>
            <view v-if="form.type === 'BALANCE'" :style="advancedFieldRow">
              <text :style="advancedFieldLabel">同步预算</text>
              <V2Switch :model-value="false" :disabled="true" />
            </view>
          </V2FormSection>

          <V2FormSection title="备注">
            <view :style="noteShell">
              <textarea :value="form.note" placeholder="店铺、尺码、尾款金额等备忘" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" />
            </view>
          </V2FormSection>

          <V2FormSection v-if="isEdit" title="当前状态">
            <V2Segmented :items="statusLabels" :active="activeStatusLabel" variant="solid" @change="onStatusChange" />
          </V2FormSection>

          <view :style="tipsBanner">
            <text :style="tipsText">提醒数据保存在本地，建议开启通知权限以确保准时提醒</text>
          </view>

          <view v-if="isEdit" :style="deleteBtn" @tap="onDeleteTap"><text :style="deleteBtnText">删除提醒</text></view>
          <view :style="saveBtnWrap" @tap="onSaveTap">
            <text v-if="!saving" :style="saveBtnText">{{ isEdit ? '保存修改' : '创建提醒' }}</text>
            <text v-else :style="savingBtnText">保存中...</text>
          </view>

          <view :style="bottomSpacer" />
        </view>
      </scroll-view>
    </template>
  </MainLayout>

  <AppDialog :visible="showDeleteDialog" title="确认删除" message="删除后无法恢复，请谨慎操作" confirm-text="删除" :show-cancel="true" cancel-text="取消" @confirm="deleteItem" @cancel="showDeleteDialog = false" />
  <AppDialog :visible="showLeaveDialog" title="确认离开" message="内容尚未保存，确定离开吗？" confirm-text="离开" :show-cancel="true" cancel-text="取消" @confirm="handleLeave" @cancel="showLeaveDialog = false" />
</template>

<script setup lang="uts">
import { useReminderStore } from '@/stores/reminder-store'
import { Reminder, ReminderUpdateData, TYPE_COLORS } from '@/domain/reminder'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import V2Segmented from '@/components/v2/V2Segmented.uvue'
import V2Switch from '@/components/v2/V2Switch.uvue'
import V2FormSection from '@/components/v2/V2FormSection.uvue'
import V2DatePicker from '@/components/v2/V2DatePicker.uvue'

function getTypePlaceholder(type: string): string {
  if (type === 'ARRIVAL') return '例：包裹预计送达'
  if (type === 'BALANCE') return '例：月光曲 JSK 尾款截止'
  if (type === 'RELEASE') return '例：新品限定 10 点开售'
  return '例：提醒标题'
}

const store = useReminderStore()
const isEdit = ref(false)
const editId = ref('')
const saving = ref(false)
const showDeleteDialog = ref(false)
const showLeaveDialog = ref(false)
const advancedOpen = ref(true)

type ReminderFormState = {
  title: string
  type: string
  remindDate: string
  remindTime: string
  note: string
  status: string
  isAllDay: boolean
  multiAlert: boolean
}
let initialFormSnapshot: ReminderFormState = { title: '', type: 'CUSTOM', remindDate: '', remindTime: '', note: '', status: 'PENDING', isAllDay: false, multiAlert: false }
const form = ref<ReminderFormState>({ title: '', type: 'CUSTOM', remindDate: '', remindTime: '', note: '', status: 'PENDING', isAllDay: false, multiAlert: false })

const typeOptions = [
  { label: '尾款', value: 'BALANCE', color: TYPE_COLORS.BALANCE },
  { label: '上新发售', value: 'RELEASE', color: TYPE_COLORS.RELEASE },
  { label: '到货提醒', value: 'ARRIVAL', color: TYPE_COLORS.ARRIVAL },
  { label: '自定义', value: 'CUSTOM', color: TYPE_COLORS.CUSTOM },
]

const statusLabels = ['待提醒', '已完成', '已过期']
const activeStatusLabel = computed((): string => form.value.status === 'DONE' ? '已完成' : (form.value.status === 'MISSED' ? '已过期' : '待提醒'))
const typePlaceholder = computed((): string => getTypePlaceholder(form.value.type))
const isMultiAlertAvailable = computed((): boolean => form.value.type === 'BALANCE' || form.value.type === 'RELEASE')

function getDefaultTime(): string {
  if (form.value.type === 'BALANCE' || form.value.type === 'RELEASE') return '20:00'
  if (form.value.type === 'ARRIVAL') return '10:00'
  return '12:00'
}

function onTypeSelect(value: string) {
  form.value.type = value
  if (form.value.remindTime === '') form.value.remindTime = getDefaultTime()
  form.value.multiAlert = value === 'BALANCE' || value === 'RELEASE'
}

function typeChip(t: { label: string; value: string; color: string }): any {
  const active = form.value.type === t.value
  return {
    flex: 1 as const, height: '76rpx', alignItems: 'center' as const, justifyContent: 'center' as const,
    borderRadius: '24rpx', backgroundColor: active ? (brand[500] as string) : n.value.bgSecondary,
    marginRight: '12rpx', borderWidth: active ? '0' : '1rpx', borderStyle: 'solid' as const, borderColor: n.value.cardBorder,
  }
}
function typeChipText(t: { label: string; value: string; color: string }): any {
  const active = form.value.type === t.value
  return { fontSize: '26rpx', fontWeight: fontWeight.semibold, color: active ? baseColors.white : n.value.text }
}

function onStatusChange(label: string) { form.value.status = label === '已完成' ? 'DONE' : (label === '已过期' ? 'MISSED' : 'PENDING') }
function onNoteInput(e: any) {
  const eObj = e as UTSJSONObject
  const d = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
  form.value.note = d != null && d['value'] != null ? d['value'] as string : ''
}
function onDatePick(value: string) { form.value.remindDate = value }
function onTimePick(value: string) { form.value.remindTime = value }
function onAllDayChange(val: boolean) { form.value.isAllDay = val }
function onMultiAlertChange(val: boolean) { form.value.multiAlert = val }
function toggleAdvanced() { advancedOpen.value = !advancedOpen.value }

function onSaveTap() {
  if (saving.value) return
  if (form.value.title.trim() === '') { showFeedback('请填写提醒名称'); return }
  if (form.value.remindDate.trim() === '') { showFeedback('请选择提醒日期'); return }
  saving.value = true
  if (isEdit.value) {
    const data = new ReminderUpdateData()
    data.title = form.value.title.trim()
    data.type = form.value.type
    data.remindDate = form.value.remindDate.trim()
    data.remindTime = form.value.isAllDay ? '' : form.value.remindTime.trim()
    data.isAllDay = form.value.isAllDay
    data.note = form.value.note.trim()
    data.status = form.value.status
    if (!store.updateItem(editId.value, data)) { saving.value = false; showFeedback('保存失败，请重试'); return }
  } else {
    const item = new Reminder()
    item.title = form.value.title.trim()
    item.type = form.value.type
    item.remindDate = form.value.remindDate.trim()
    item.remindTime = form.value.isAllDay ? '' : form.value.remindTime.trim()
    item.isAllDay = form.value.isAllDay
    item.note = form.value.note.trim()
    item.status = 'PENDING'
    if (store.addItem(item) === null) { saving.value = false; showFeedback('保存失败，请重试'); return }
  }
  showFeedback(isEdit.value ? '修改已保存' : '创建成功')
  setTimeout(() => { uni.navigateBack() }, 300)
}

function onDeleteTap() { showDeleteDialog.value = true }

function deleteItem() {
  showDeleteDialog.value = false
  if (editId.value === '') { showFeedback('删除失败，请重试'); return }
  if (!store.deleteItem(editId.value)) { showFeedback('删除失败，请重试'); return }
  showFeedback('提醒已删除')
  setTimeout(() => { uni.navigateBack() }, 220)
}

function handleBack() {
  const changed = form.value.title !== initialFormSnapshot.title
    || form.value.type !== initialFormSnapshot.type
    || form.value.remindDate !== initialFormSnapshot.remindDate
    || form.value.remindTime !== initialFormSnapshot.remindTime
    || form.value.isAllDay !== initialFormSnapshot.isAllDay
    || form.value.note !== initialFormSnapshot.note
    || form.value.status !== initialFormSnapshot.status
  if (changed) { showLeaveDialog.value = true }
  else { uni.navigateBack() }
}

function handleLeave() { showLeaveDialog.value = false; uni.navigateBack() }

onLoad((options) => {
  store.fetchItems()
  if (options != null) {
    const id = options['id'] != null ? options['id'] as string : ''
    if (id !== '') {
      editId.value = id; isEdit.value = true
      const item = store.getById(id)
      if (item != null) {
        form.value.title = item.title; form.value.type = item.type
        form.value.remindDate = item.remindDate; form.value.remindTime = item.remindTime
        form.value.isAllDay = item.isAllDay; form.value.note = item.note; form.value.status = item.status
        initialFormSnapshot = { ...form.value }
      }
      return
    }
    form.value.title = options['title'] != null ? safeParam(options['title'] as string) : ''
    const typeRaw = options['type'] != null ? options['type'] as string : ''
    form.value.type = typeRaw !== '' ? typeRaw : 'CUSTOM'
    form.value.remindDate = options['date'] != null ? safeParam(options['date'] as string) : ''
    form.value.note = options['note'] != null ? safeParam(options['note'] as string) : ''
    if (form.value.remindTime === '') form.value.remindTime = getDefaultTime()
    initialFormSnapshot = { ...form.value }
  }
})

const safeBottom = getSafeBottomInset()
const scrollWrap = { flex: 1 }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: `${safeBottom + 120}px`, paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const bottomSpacer = { height: '20rpx' }

const typeRow = { flexDirection: 'row', marginBottom: '12rpx' }

const timeFieldRow = { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', height: '88rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '24rpx', backgroundColor: n.value.inputFill, marginBottom: '12rpx' }
const timeFieldLabel = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, flexShrink: 0 }))
const timeRight = { flexDirection: 'row', alignItems: 'center' }
const timeSwitchRow = { flexDirection: 'row', alignItems: 'center', marginRight: '16rpx' }
const timeSwitchLabel = { fontSize: fontSize.sm, color: n.value.text, marginRight: '10rpx' }
const timeDisabledText = { fontSize: fontSize.sm, color: n.value.textDisabled }

const advancedFieldRow = { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', height: '88rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '24rpx', backgroundColor: n.value.inputFill, marginBottom: '12rpx' }
const advancedFieldLabel = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text }))

const noteShell = computed((): any => ({ minHeight: '160rpx', padding: CARD_PADDING, borderRadius: '24rpx', backgroundColor: n.value.inputFill }))
const noteInput = computed((): any => ({ width: '100%', minHeight: '120rpx', fontSize: fontSize.base, color: n.value.text, lineHeight: '40rpx' }))
const placeholderStyle = computed((): string => `color:${n.value.placeholder}`)

const tipsBanner = computed((): any => ({ padding: '20rpx', borderRadius: '24rpx', backgroundColor: n.value.surfacePink, marginTop: '24rpx' }))
const tipsText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, lineHeight: '34rpx' }))

const deleteBtn = { height: '88rpx', alignItems: 'center', justifyContent: 'center', marginTop: '20rpx' }
const deleteBtnText = { fontSize: fontSize.sm, color: '#FF4D4F' }

const saveBtnWrap = computed((): any => ({ height: '88rpx', borderRadius: '24rpx', backgroundColor: saving.value ? n.value.bgTertiary : (brand[500] as string), alignItems: 'center' as string, justifyContent: 'center' as string, marginTop: '12rpx' }))
const saveBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.medium, color: baseColors.white }
const savingBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.medium, color: n.value.textTertiary }
const customBackStyle = computed((): any => ({ fontSize: fontSize.lg, color: n.value.text }))
</script>
