const wardrobeEmptyWrap = { alignItems: 'center', paddingTop: '40rpx', paddingBottom: '40rpx' }
const wardrobeEmptyText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
const wardrobePickerWrap = { paddingTop: '8rpx' }
const wardrobePickerScroll = { maxHeight: '600rpx' }
const wardrobeGrid = computed((): any => ({ display: 'flex', flexDirection: 'row', flexWrap: 'wrap', justifyContent: 'space-between' }))
function wardrobeGridCard(id: string): any {
  const selected = tempSelected.value.indexOf(id) >= 0
  return {
    width: '48%', borderRadius: '24rpx', overflow: 'hidden',
    backgroundColor: n.value.surface, marginBottom: '24rpx',
    borderWidth: selected ? '3rpx' : '1rpx', borderStyle: 'solid',
    borderColor: selected ? (brand[500] as string) : n.value.border,
    position: 'relative',
  }
}
const inlineActionText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '12rpx' }))
function productGridCard(entityId: string): any {
  const selected = relatedProductId.value === entityId
  return {
    width: '48%', borderRadius: '24rpx', overflow: 'hidden',
    backgroundColor: n.value.surface, marginBottom: '24rpx',
    borderWidth: selected ? '3rpx' : '1rpx', borderStyle: 'solid',
    borderColor: selected ? (brand[500] as string) : n.value.border,
    position: 'relative',
  }
}
