const wardrobeBtnRow = computed((): any => ({
  flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
  height: '88rpx', paddingLeft: '28rpx', paddingRight: '28rpx',
  borderRadius: '16rpx', backgroundColor: n.value.inputFill,
}))
