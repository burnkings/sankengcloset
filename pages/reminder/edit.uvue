<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar :title="isEdit ? '编辑提醒' : '新增提醒'" :show-back="true"></AppNavbar></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <text :style="fieldLabel">提醒内容</text>
        <AppInput v-model="form.title" placeholder="例如：月光曲 JSK 尾款截止" :clearable="true" />

        <text :style="fieldLabel">提醒类型</text>
        <V2FilterChips :items="typeLabels" :active="activeTypeLabel" @change="onTypeChange" />

        <view :style="twoColumnRow">
          <view :style="dateField">
            <text :style="fieldLabelCompact">日期</text>
            <AppInput v-model="form.remindDate" placeholder="2026-08-01" />
          </view>
          <view :style="timeField">
            <text :style="fieldLabelCompact">时间</text>
            <AppInput v-model="form.remindTime" placeholder="20:00" />
          </view>
        </view>

        <view v-if="isEdit">
          <text :style="fieldLabel">状态</text>
          <V2FilterChips :items="statusLabels" :active="activeStatusLabel" @change="onStatusChange" />
        </view>

        <text :style="fieldLabel">备注</text>
        <view :style="noteShell">
          <textarea :value="form.note" placeholder="补款金额、官方渠道或其他信息" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" />
        </view>

        <view :style="sourceHint"><AppIcon name="notification" :size="34" :active="true" /><text :style="sourceHintText">提醒保存在本机；系统通知权限将在发布前统一申请</text></view>

        <view v-if="isEdit" :style="deleteArea">
          <view v-if="!showDeleteConfirm" :style="deleteButton" @tap="showDeleteConfirm = true"><text :style="deleteText">删除这条提醒</text></view>
          <view v-else :style="confirmRow"><text :style="confirmText">确认删除？</text><view :style="cancelDelete" @tap="showDeleteConfirm = false"><text :style="cancelDeleteText">取消</text></view><view :style="confirmDelete" @tap="deleteItem"><text :style="confirmDeleteText">删除</text></view></view>
        </view>
      </view>
    </template>
  </MainLayout>
  <view :style="reminderBottomBar">
    <view :style="reminderSaveButton" @tap="save"><text :style="reminderSaveText">{{ isEdit ? '保存修改' : '创建提醒' }}</text></view>
  </view>
</template>

<script setup lang="uts">
import { useReminderStore } from '@/stores/reminder-store'
import { Reminder, ReminderUpdateData } from '@/domain/reminder'
import { brand, baseColors, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2FilterChips from '@/components/v2/V2FilterChips.uvue'

const store = useReminderStore()
const isEdit = ref(false)
const editId = ref('')
const showDeleteConfirm = ref(false)
const form = ref({ title: '', type: 'CUSTOM', remindDate: '', remindTime: '', note: '', status: 'PENDING' })

const typeLabels = ['到货', '尾款', '发售', '自定义']
const statusLabels = ['待提醒', '已完成', '已过期']
const activeTypeLabel = computed((): string => form.value.type === 'ARRIVAL' ? '到货' : (form.value.type === 'BALANCE' ? '尾款' : (form.value.type === 'RELEASE' ? '发售' : '自定义')))
const activeStatusLabel = computed((): string => form.value.status === 'DONE' ? '已完成' : (form.value.status === 'MISSED' ? '已过期' : '待提醒'))

function onTypeChange(label: string) { form.value.type = label === '到货' ? 'ARRIVAL' : (label === '尾款' ? 'BALANCE' : (label === '发售' ? 'RELEASE' : 'CUSTOM')) }
function onStatusChange(label: string) { form.value.status = label === '已完成' ? 'DONE' : (label === '已过期' ? 'MISSED' : 'PENDING') }
function onNoteInput(e: any) { form.value.note = (e.detail as any).value ?? '' }
function safeParam(value: any): string {
  const text = value == null ? '' : String(value)
  try { return text.indexOf('%') >= 0 ? decodeURIComponent(text) : text } catch (e) { return text }
}

function save() {
  if (form.value.title.trim() === '') { showFeedback('请填写提醒内容'); return }
  if (form.value.remindDate.trim() === '') { showFeedback('请填写提醒日期'); return }
  if (isEdit.value) {
    const data = new ReminderUpdateData()
    data.title = form.value.title.trim()
    data.type = form.value.type
    data.remindDate = form.value.remindDate.trim()
    data.remindTime = form.value.remindTime.trim()
    data.note = form.value.note.trim()
    data.status = form.value.status
    if (!store.updateItem(editId.value, data)) { showFeedback('保存失败，请重试'); return }
  } else {
    const item = new Reminder()
    item.title = form.value.title.trim()
    item.type = form.value.type
    item.remindDate = form.value.remindDate.trim()
    item.remindTime = form.value.remindTime.trim()
    item.note = form.value.note.trim()
    item.status = 'PENDING'
    if (store.addItem(item) === null) { showFeedback('保存失败，请重试'); return }
  }
  showFeedback(isEdit.value ? '提醒已更新' : '提醒已创建')
  setTimeout(() => { uni.navigateBack() }, 260)
}

function deleteItem() {
  if (editId.value !== '') store.deleteItem(editId.value)
  showFeedback('提醒已删除')
  setTimeout(() => { uni.navigateBack() }, 220)
}

onMounted(() => {
  store.fetchItems()
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = (currentPage as any).options ?? {}
  const id = safeParam(options.id)
  if (id !== '') {
    editId.value = id
    isEdit.value = true
    const item = store.getById(id)
    if (item != null) {
      form.value.title = item.title
      form.value.type = item.type
      form.value.remindDate = item.remindDate
      form.value.remindTime = item.remindTime
      form.value.note = item.note
      form.value.status = item.status
    }
    return
  }
  form.value.title = safeParam(options.title)
  form.value.type = safeParam(options.type) !== '' ? safeParam(options.type) : 'CUSTOM'
  form.value.remindDate = safeParam(options.date)
  form.value.note = safeParam(options.note)
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: '180rpx' , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const saveText = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: brand[600] }
const reminderSafeBottom = getSafeBottomInset()
const reminderBottomBar = computed((): any => ({ position: 'fixed' as string, left: '0', right: '0', bottom: '0', zIndex: 100, paddingTop: '20rpx', paddingLeft: '40rpx', paddingRight: '40rpx', paddingBottom: `${reminderSafeBottom + 12}px`, backgroundColor: n.value.bg, borderTopWidth: '1rpx', borderTopStyle: 'solid' as string, borderTopColor: n.value.divider }))
const reminderSaveButton = computed((): any => ({ width: '100%', height: '88rpx', borderRadius: '44rpx', backgroundColor: brand[600], alignItems: 'center' as string, justifyContent: 'center' as string }))
const reminderSaveText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
const fieldLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '30rpx', marginBottom: '14rpx' }))
const fieldLabelCompact = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, marginBottom: '14rpx' }))
const twoColumnRow = { ...flexRow, marginTop: '30rpx' }
const dateField = { width: '404rpx', marginRight: '16rpx' }
const timeField = { ...flexFill }
const noteShell = computed((): any => ({ minHeight: '190rpx', padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.bgTertiary }))
const noteInput = computed((): any => ({ width: '100%', minHeight: '150rpx', fontSize: fontSize.sm, color: n.value.text, lineHeight: '40rpx' }))
const placeholderStyle = computed((): string => `color:${n.value.placeholder}`)
const sourceHint = computed((): any => ({ ...flexRow, alignItems: 'center', padding: '20rpx', borderRadius: CARD_RADIUS, backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50], marginTop: '24rpx' }))
const sourceHintText = computed((): any => ({ ...flexFill, fontSize: fontSize.xs, color: n.value.textSecondary, lineHeight: '34rpx', marginLeft: '12rpx' }))
const deleteArea = { marginTop: '56rpx' }
const deleteButton = { height: '76rpx', alignItems: 'center', justifyContent: 'center' }
const deleteText = { fontSize: fontSize.sm, color: semantic.error }
const confirmRow = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '88rpx', paddingLeft: '20rpx', paddingRight: '12rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
const confirmText = computed((): any => ({ ...flexFill, fontSize: fontSize.sm, color: n.value.text }))
const cancelDelete = computed((): any => ({ height: '60rpx', paddingLeft: '22rpx', paddingRight: '22rpx', borderRadius: '30rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '10rpx' }))
const cancelDeleteText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary }))
const confirmDelete = { height: '60rpx', paddingLeft: '22rpx', paddingRight: '22rpx', borderRadius: '30rpx', backgroundColor: semantic.error, alignItems: 'center', justifyContent: 'center' }
const confirmDeleteText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>


