const indicatorStyleStr = computed((): string => `height: 70px; border-top: 1rpx solid ${n.value.border}; border-bottom: 1rpx solid ${n.value.border};`)
const timeFieldLabel = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, flexShrink: 0 }))
const timeRight = { flexDirection: 'row', alignItems: 'center' }

const noteShell = computed((): any => ({ minHeight: '160rpx', padding: CARD_PADDING, borderRadius: '16rpx', backgroundColor: n.value.inputFill }))
