<template>
  <MainLayout navbar-content-height="88rpx" bottom-spacer="0rpx">
    <template #navbar>
      <AppNavbar :title="isEdit ? '编辑提醒' : '新建提醒'" :show-back="false">
        <template #left><view :style="backBtnStyle" @tap="handleBack"><AppIcon name="arrow-back" :size="40" /></view></template>
      </AppNavbar>
    </template>
    <template #default>
      <view class="page-canvas" :style="contentWrap">

          <FormSection title="提醒标签">
            <view :style="typeRow">
              <view v-for="t in typeOptions.slice(0, 4)" :key="t.value" :style="typeChip(form.type === t.value)" @tap="onTypeSelect(t.value)"><text :style="typeChipText(form.type === t.value)">{{ t.label }}</text></view>
            </view>
            <view :style="typeRow">
              <view v-for="t in typeOptions.slice(4)" :key="t.value" :style="typeChip(form.type === t.value)" @tap="onTypeSelect(t.value)"><text :style="typeChipText(form.type === t.value)">{{ t.label }}</text></view>
            </view>
            <text :style="optionalHint">补充一句提醒内容（选填）</text>
            <AppInput v-model="form.title" :placeholder="typePlaceholder" :clearable="true" />
          </FormSection>

          <FormSection title="提醒时间">
            <view :style="timeFieldRow" @tap="initDateTimePicker">
              <text :style="timeFieldLabel">时间</text>
              <view :style="timeRight">
                <text :style="timeValue">{{ dateTimeDisplay }}</text>
                <AppIcon name="chevron-right" :size="28" />
              </view>
            </view>
          </FormSection>

          <FormSection title="关联商品">
            <view :style="wardrobeBtnRow" @tap="onProductRowTap">
              <text :style="wardrobeBtnText">{{ relatedProductId !== '' ? (relatedProductName !== '' ? relatedProductName : '已关联商品') : '选择商品（可选）' }}</text>
              <AppIcon name="chevron-right" :size="28" />
            </view>
            <text v-if="relatedProductId !== ''" :style="inlineActionText" @tap="clearRelatedProduct">取消关联</text>
          </FormSection>
          <FormSection title="关联我的衣物">
            <view :style="wardrobeBtnRow" @tap="openWardrobePicker">
              <text :style="wardrobeBtnText">{{ form.wardrobeBindings.length > 0 ? '已选 ' + form.wardrobeBindings.length + ' 件' : '选择衣物（可选）' }}</text>
              <AppIcon name="chevron-right" :size="28" />
            </view>
            <view v-if="form.wardrobeBindings.length > 0" :style="wardrobeTagsWrap">
              <view v-for="wdId in form.wardrobeBindings" :key="wdId" :style="wardrobeTag">
                <text :style="wardrobeTagText">{{ getWardrobeName(wdId) }}</text>
                <view :style="wardrobeTagRemoveWrap" @tap.stop="removeWardrobe(wdId)"><AppIcon name="close" :size="24" /></view>
              </view>
            </view>
          </FormSection>

          <FormSection title="备注（选填）">
            <view :style="noteShell">
              <textarea :value="form.note" placeholder="店铺、尺码、尾款金额等备忘" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" />
            </view>
          </FormSection>

          <FormSection v-if="isEdit" title="当前状态">
            <SegmentedControl :items="statusLabels" :active="activeStatusLabel" @change="onStatusChange" />
          </FormSection>

          <view v-if="isEdit" :style="deleteBtn" @tap="onDeleteTap"><text :style="deleteBtnText">删除提醒</text></view>
        </view>
    </template>
  </MainLayout>

  <BottomActionBar>
    <view :style="saveBtnWrap" @tap="onSaveTap">
      <text v-if="!saving" :style="saveBtnText">{{ isEdit ? '保存修改' : '创建提醒' }}</text>
      <text v-else :style="savingBtnText">保存中...</text>
    </view>
  </BottomActionBar>

  <AppDialog :visible="showDeleteDialog" title="确认删除" message="删除后无法恢复，请谨慎操作" confirm-text="删除" :show-cancel="true" cancel-text="取消" @confirm="deleteItem" @cancel="showDeleteDialog = false" />
  <AppDialog :visible="showLeaveDialog" title="确认离开" message="内容尚未保存，确定离开吗？" confirm-text="离开" :show-cancel="true" cancel-text="取消" @confirm="handleLeave" @cancel="showLeaveDialog = false" />

  <AppDialog :visible="showWardrobePicker" title="选择关联衣物" @confirm="confirmWardrobe" @cancel="showWardrobePicker = false">
    <view :style="wardrobePickerWrap">
      <view v-if="wardrobeStore.sortedItems.length === 0" :style="wardrobeEmptyWrap">
        <text :style="wardrobeEmptyText">暂无可关联衣物</text>
      </view>
      <scroll-view v-else :style="wardrobePickerScroll">
        <view :style="wardrobeGrid">
          <view v-for="wd in wardrobeStore.sortedItems" :key="wd.id" :style="wardrobeGridCard(wd.id)" @tap="toggleWardrobePicker(wd.id)">
            <image v-if="wd.coverImage !== ''" :src="wd.coverImage" :style="wardrobeGridImg" mode="aspectFill" />
            <view v-else :style="wardrobeGridPlaceholder"><AppIcon name="shirt" :size="40" :active="true" /></view>
            <text :style="wardrobeGridName">{{ wd.name }}</text>
            <text :style="wardrobePickerCat">{{ getWardrobeCat(wd.category) }}</text>
            <view v-if="tempSelected.indexOf(wd.id) >= 0" :style="wardrobeGridCheck">
              <AppIcon name="check" :size="22" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
    <template #actions>
      <view :style="dialogActions">
        <view :style="dialogCancelBtn" @tap="showWardrobePicker = false"><text :style="dialogCancelBtnText">取消</text></view>
        <view :style="dialogWardrobeBtn" @tap="confirmWardrobe"><text :style="dialogWardrobeBtnText">确定</text></view>
      </view>
    </template>
  </AppDialog>

  <AppDialog :visible="showProductPicker" title="选择关联商品" @cancel="showProductPicker = false">
    <view :style="wardrobePickerWrap">
      <view v-if="pickableProducts.length === 0" :style="wardrobeEmptyWrap">
        <text :style="wardrobeEmptyText">收藏里还没有商品，先去收藏几件吧</text>
      </view>
      <scroll-view v-else :style="wardrobePickerScroll">
        <view :style="wardrobeGrid">
          <view v-for="p in pickableProducts" :key="p.entityId" :style="productGridCard(p.entityId)" @tap="selectProduct(p)">
            <image v-if="p.coverUrl !== ''" :src="p.coverUrl" :style="wardrobeGridImg" mode="aspectFill" />
            <view v-else :style="wardrobeGridPlaceholder"><AppIcon name="camera" :size="40" :active="true" /></view>
            <text :style="wardrobeGridName">{{ p.title }}</text>
            <text :style="wardrobePickerCat">{{ p.brandName }}</text>
            <view v-if="relatedProductId === p.entityId" :style="wardrobeGridCheck">
              <AppIcon name="check" :size="22" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </AppDialog>

  <view v-if="showDatePicker" :style="pickerOverlay" @tap="showDatePicker = false">
    <view :style="pickerPanel" @tap.stop>
      <view :style="pickerHeader">
        <text :style="pickerCancel" @tap="showDatePicker = false">取消</text>
        <text :style="pickerTitle">选择日期时间</text>
        <text :style="pickerConfirm" @tap="confirmDateTime">确定</text>
      </view>
      <picker-view :value="dateTimePickerVal" :style="pickerViewStyle" :indicator-style="indicatorStyleStr" @change="onDateTimeChange">
        <picker-view-column>
          <view v-for="y in pickerYearOptions" :key="y" :style="pickerItem"><text :style="pickerItemText">{{ y }}年</text></view>
        </picker-view-column>
        <picker-view-column>
          <view v-for="m in 12" :key="m" :style="pickerItem"><text :style="pickerItemText">{{ m }}月</text></view>
        </picker-view-column>
        <picker-view-column>
          <view v-for="d in getDaysInMonth()" :key="d" :style="pickerItem"><text :style="pickerItemText">{{ d }}日</text></view>
        </picker-view-column>
        <picker-view-column>
          <view v-for="h in 24" :key="h" :style="pickerItem"><text :style="pickerItemText">{{ h - 1 }}时</text></view>
        </picker-view-column>
        <picker-view-column>
          <view v-for="m in 60" :key="m" :style="pickerItem"><text :style="pickerItemText">{{ m - 1 }}分</text></view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { fetchProductDetail } from '@/services/content/product-service'
const relatedProductName = ref('')
function openRelatedProduct() {
  if (relatedProductId.value !== '') uni.navigateTo({ url: `/pages/product/detail?id=${encodeURIComponent(relatedProductId.value)}` })
}
import { useReminderStore } from '@/stores/reminder-store'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { FeedItem } from '@/domain/content/feed-item'
import { reminderTypeFromContext } from '@/utils/reminder-context'
import { safeParam } from '@/utils/route-params'
import { canSetBalanceReminder } from '@/utils/purchase-reminder'
import { usePurchaseStore } from '@/stores/purchase-store'
import { Reminder, ReminderUpdateData, TYPE_LABELS, TYPE_PLACEHOLDERS } from '@/domain/reminder'
import { brand, baseColors, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import AppInput from '@/components/base/AppInput.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import FormSection from '@/components/v3/FormSection.uvue'
import SegmentedControl from '@/components/v3/SegmentedControl.uvue'
import BottomActionBar from '@/components/v3/BottomActionBar.uvue'

// 占位文案统一取自 domain/reminder.uts 的 TYPE_PLACEHOLDERS（此处曾有逐条重复的实现）
const typePlaceholder = computed((): string => {
  const p = TYPE_PLACEHOLDERS[form.value.type]
  return p != null ? p as string : '例：每日穿搭打卡'
})

const store = useReminderStore()
const wardrobeStore = useWardrobeStore()
const library = useContentLibraryStore()
// 保存/删除后延迟返回的定时器：页面卸载时清理，避免残留
let backTimer: number | null = null
onUnload(() => { if (backTimer != null) { clearTimeout(backTimer); backTimer = null } })
const isEdit = ref(false)
const editId = ref('')
const saving = ref(false)
const showDeleteDialog = ref(false)
const showLeaveDialog = ref(false)
const showWardrobePicker = ref(false)
const showProductPicker = ref(false)
const showDatePicker = ref(false)
const relatedPurchaseId = ref('')
const relatedWishId = ref('')
const relatedProductId = ref('')
// 关联商品名：不再在 id 变化时清空，避免详情拉取失败或离线时名称被抹掉
watch(relatedProductId, async (id: string) => {
  if (id === '') { relatedProductName.value = ''; return }
  try {
    const product = await fetchProductDetail(id)
    if (relatedProductId.value === id && product != null) relatedProductName.value = product.item.title
  } catch (e) {}
})
const relatedReleaseId = ref('')
const tempSelected = ref<string[]>([])
const dateTimePickerVal = ref([0, 0, 0, 0, 0])
const tempMonthDay = ref('')
const tempHourMin = ref('')
const pickerYearBase = new Date().getFullYear()
const pickerYearOptions = [pickerYearBase, pickerYearBase + 1, pickerYearBase + 2]

type ReminderFormState = {
  title: string
  type: string
  remindDate: string
  remindTime: string
  note: string
  status: string
  isAllDay: boolean
  wardrobeBindings: string[]
}
let initialFormSnapshot: ReminderFormState = { title: '', type: 'CHECKIN', remindDate: '', remindTime: '', note: '', status: 'PENDING', isAllDay: false, wardrobeBindings: [] as string[] }
const form = ref<ReminderFormState>({ title: '', type: 'CHECKIN', remindDate: '', remindTime: '', note: '', status: 'PENDING', isAllDay: false, wardrobeBindings: [] as string[] })

// 类型标签：前 4 个是「时间驱动」（有明确日期压力），后 4 个是「活动驱动」。
// 模板按 slice(0,4) / slice(4) 分两行渲染，顺序即分组，不要随意调换。
// 历史：每项曾带 color: TYPE_COLORS.X 字段，但 typeChip() 只用品牌色，属死数据，已删。
const typeOptions = [
  { label: '尾款', value: 'BALANCE' },
  { label: '上新发售', value: 'RELEASE' },
  { label: '到货提醒', value: 'ARRIVAL' },
  { label: '穿搭计划', value: 'OUTFIT' },
  { label: '拍照日程', value: 'PHOTO' },
  { label: '整理衣橱', value: 'ORGANIZE' },
  { label: '蹲新品', value: 'WISH' },
  { label: '打卡', value: 'CHECKIN' },
]

const statusLabels = ['待提醒', '已完成', '已过期']
const activeStatusLabel = computed((): string => form.value.status === 'DONE' ? '已完成' : (form.value.status === 'MISSED' ? '已过期' : '待提醒'))

function getDefaultTime(): string {
  if (form.value.type === 'BALANCE' || form.value.type === 'RELEASE') return '20:00'
  if (form.value.type === 'ARRIVAL') return '10:00'
  return '12:00'
}

const dateTimeDisplay = computed((): string => {
  if (form.value.remindDate === '') return '选择时间'
  const parts = form.value.remindDate.split('-')
  if (parts.length !== 3) return form.value.remindDate
  const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]))
  const wd = ['日', '一', '二', '三', '四', '五', '六']
  let display = `${parseInt(parts[1])}月${parseInt(parts[2])}日 周${wd[d.getDay()]}`
  if (form.value.remindTime !== '') display += ` ${form.value.remindTime}`
  return display
})

function pickerYear(): number {
  const idx = dateTimePickerVal.value[0]
  return (idx >= 0 && idx < pickerYearOptions.length) ? pickerYearOptions[idx] : pickerYearBase
}

function getDaysInMonth(): number {
  const m = dateTimePickerVal.value[1] + 1
  return new Date(pickerYear(), m, 0).getDate()
}

function pad2(value: number): string { return value < 10 ? '0' + value.toString() : value.toString() }

function initDateTimePicker() {
  const now = new Date()
  const d = form.value.remindDate !== '' ? form.value.remindDate : `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())}`
  const t = form.value.remindTime !== '' ? form.value.remindTime : '12:00'
  const dp = d.split('-')
  const tp = t.split(':')
  let yearIdx = 0
  const yearNum = parseInt(dp[0])
  if (!isNaN(yearNum)) {
    for (let i = 0; i < pickerYearOptions.length; i++) { if (pickerYearOptions[i] === yearNum) { yearIdx = i; break } }
  }
  let monthIdx = 0
  const monthNum = parseInt(dp[1])
  if (!isNaN(monthNum) && monthNum >= 1 && monthNum <= 12) monthIdx = monthNum - 1
  let dayIdx = 0
  const dayNum = parseInt(dp[2])
  if (!isNaN(dayNum) && dayNum >= 1 && dayNum <= 31) dayIdx = dayNum - 1
  let hourIdx = 0
  const hourNum = parseInt(tp[0])
  if (!isNaN(hourNum) && hourNum >= 0 && hourNum <= 23) hourIdx = hourNum
  let minuteIdx = 0
  const minuteNum = parseInt(tp[1])
  if (!isNaN(minuteNum) && minuteNum >= 0 && minuteNum <= 59) minuteIdx = minuteNum
  dateTimePickerVal.value = [yearIdx, monthIdx, dayIdx, hourIdx, minuteIdx]
  tempMonthDay.value = d
  tempHourMin.value = t
  showDatePicker.value = true
}

function onDateTimeChange(e: any) {
  const eObj = e as UTSJSONObject
  const raw = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
  const val = raw != null && raw['value'] != null ? raw['value'] as number[] : dateTimePickerVal.value
  dateTimePickerVal.value = val
  const yr = pickerYear()
  const m = val[1] + 1
  const day = Math.min(val[2] + 1, new Date(yr, m, 0).getDate())
  tempMonthDay.value = `${yr}-${pad2(m)}-${pad2(day)}`
  const hour = val[3]
  const minute = val[4]
  tempHourMin.value = `${pad2(hour)}:${pad2(minute)}`
}

function confirmDateTime() {
  form.value.remindDate = tempMonthDay.value
  form.value.remindTime = tempHourMin.value
  showDatePicker.value = false
}

function onTypeSelect(value: string) {
  form.value.type = value
  if (form.value.remindTime === '') form.value.remindTime = getDefaultTime()
}

function typeChip(active: boolean): any {
  return {
    flex: 1 as const, height: '76rpx', alignItems: 'center' as const, justifyContent: 'center' as const,
    borderRadius: '24rpx', backgroundColor: active ? n.value.surfacePink : n.value.bgSecondary,
    marginRight: '12rpx', borderWidth: active ? '0' : '1rpx', borderStyle: 'solid' as const, borderColor: n.value.border,
  }
}
// 选中态统一「浅粉底 + 玫粉字」（V3 §5.7）：实底玫粉只留给底部主 CTA，避免同 App 两套选中语言
function typeChipText(active: boolean): any {
  return { fontSize: '26rpx', fontWeight: fontWeight.semibold, color: active ? n.value.iconActive : n.value.text }
}

function onStatusChange(label: string) { form.value.status = label === '已完成' ? 'DONE' : (label === '已过期' ? 'MISSED' : 'PENDING') }
function onNoteInput(e: any) {
  const eObj = e as UTSJSONObject
  const d = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
  form.value.note = d != null && d['value'] != null ? d['value'] as string : ''
}
function onAllDayChange(val: boolean) { form.value.isAllDay = val }

function openWardrobePicker() {
  tempSelected.value = [...form.value.wardrobeBindings]
  wardrobeStore.fetchItems()
  showWardrobePicker.value = true
}
function toggleWardrobePicker(id: string) {
  const idx = tempSelected.value.indexOf(id)
  if (idx >= 0) { const next = [...tempSelected.value]; next.splice(idx, 1); tempSelected.value = next }
  else { tempSelected.value = [...tempSelected.value, id] }
}
function confirmWardrobe() {
  form.value.wardrobeBindings = [...tempSelected.value]
  showWardrobePicker.value = false
}
function removeWardrobe(id: string) {
  const idx = form.value.wardrobeBindings.indexOf(id)
  if (idx >= 0) { const next = [...form.value.wardrobeBindings]; next.splice(idx, 1); form.value.wardrobeBindings = next }
}
function getWardrobeName(id: string): string {
  const item = wardrobeStore.getById(id)
  return item != null ? item.name : '未知单品'
}
function getWardrobeCat(cat: string): string {
  if (cat === 'JK') return 'JK制服'
  if (cat === 'LOLITA') return 'Lolita'
  if (cat === 'HANFU') return '汉服'
  return '其他'
}

// ====== 关联商品（新建提醒同样可关联，来源为收藏商品池）======
const pickableProducts = computed((): FeedItem[] => library.favoriteProducts)
function openProductPicker() {
  library.reload()
  showProductPicker.value = true
}
function onProductRowTap() {
  if (relatedProductId.value !== '') openRelatedProduct()
  else openProductPicker()
}
function selectProduct(p: FeedItem) {
  relatedProductId.value = p.entityId
  relatedProductName.value = p.title
  showProductPicker.value = false
}
function clearRelatedProduct() {
  relatedProductId.value = ''
  relatedProductName.value = ''
}

function onSaveTap() {
  if (saving.value) return
  if (form.value.title.trim() === '') form.value.title = TYPE_LABELS[form.value.type] as string
  if (form.value.remindDate.trim() === '') { showFeedback('请选择提醒日期'); return }
  if (form.value.type === 'BALANCE' && relatedPurchaseId.value !== '') {
    const purchase = usePurchaseStore().getPurchaseById(relatedPurchaseId.value)
    if (!canSetBalanceReminder(purchase)) { showFeedback('订单已结清、取消或不存在，无需尾款提醒'); return }
  }
  saving.value = true
  if (isEdit.value) {
    const data = new ReminderUpdateData()
    data.title = form.value.title.trim()
    data.type = form.value.type
    data.remindDate = form.value.remindDate.trim()
    data.remindTime = form.value.isAllDay ? '' : form.value.remindTime.trim()
    data.isAllDay = form.value.isAllDay
    data.note = form.value.note.trim()
    data.status = form.value.status
    data.wardrobeBindings = form.value.wardrobeBindings
    data.relatedPurchaseId = relatedPurchaseId.value
    data.relatedWishId = relatedWishId.value
    data.productId = relatedProductId.value
    data.relatedReleaseId = relatedReleaseId.value
    if (!store.updateItem(editId.value, data)) { saving.value = false; showFeedback('保存失败，请重试'); return }
  } else {
    const item = new Reminder()
    item.title = form.value.title.trim()
    item.type = form.value.type
    item.remindDate = form.value.remindDate.trim()
    item.remindTime = form.value.isAllDay ? '' : form.value.remindTime.trim()
    item.isAllDay = form.value.isAllDay
    item.note = form.value.note.trim()
    item.status = 'PENDING'
    item.wardrobeBindings = form.value.wardrobeBindings
    item.relatedPurchaseId = relatedPurchaseId.value
    item.relatedWishId = relatedWishId.value
    item.productId = relatedProductId.value
    item.relatedReleaseId = relatedReleaseId.value
    if (store.addItem(item) === null) { saving.value = false; showFeedback('保存失败，请重试'); return }
  }
  showFeedback(isEdit.value ? '修改已保存' : '创建成功')
  backTimer = setTimeout(() => { uni.navigateBack() }, 300)
}

function onDeleteTap() { showDeleteDialog.value = true }

function deleteItem() {
  showDeleteDialog.value = false
  if (editId.value === '') { showFeedback('删除失败，请重试'); return }
  if (!store.deleteItem(editId.value)) { showFeedback('删除失败，请重试'); return }
  showFeedback('提醒已删除')
  backTimer = setTimeout(() => { uni.navigateBack() }, 220)
}

// 表单是否有未保存改动：导航栏返回箭头与系统返回共用（原实现把这段比较内联在 handleBack 里，
// 且漏了 wardrobeBindings —— 只改了关联衣物时不会提示，等于静默丢改动）
function hasUnsavedChanges(): boolean {
  return form.value.title !== initialFormSnapshot.title
    || form.value.type !== initialFormSnapshot.type
    || form.value.remindDate !== initialFormSnapshot.remindDate
    || form.value.remindTime !== initialFormSnapshot.remindTime
    || form.value.isAllDay !== initialFormSnapshot.isAllDay
    || form.value.note !== initialFormSnapshot.note
    || form.value.status !== initialFormSnapshot.status
    || form.value.wardrobeBindings.join(',') !== initialFormSnapshot.wardrobeBindings.join(',')
}

function handleBack() {
  if (hasUnsavedChanges()) { showLeaveDialog.value = true }
  else { uni.navigateBack() }
}

function handleLeave() { showLeaveDialog.value = false; uni.navigateBack() }

onLoad((options) => {
  store.fetchItems()
  wardrobeStore.fetchItems()
  if (options != null) {
    const id = options['id'] != null ? options['id'] as string : ''
    if (id !== '') {
      editId.value = id; isEdit.value = true
      const item = store.getById(id)
      if (item != null) {
        form.value.title = item.title; form.value.type = item.type
        form.value.remindDate = item.remindDate; form.value.remindTime = item.remindTime
        form.value.isAllDay = item.isAllDay; form.value.note = item.note; form.value.status = item.status
        form.value.wardrobeBindings = [...item.wardrobeBindings]
        relatedPurchaseId.value = item.relatedPurchaseId
        relatedWishId.value = item.relatedWishId
        relatedProductId.value = item.productId
        relatedReleaseId.value = item.relatedReleaseId
        initialFormSnapshot = { ...form.value }
      }
      return
    }
    form.value.title = options['title'] != null ? safeParam(options['title'] as string) : ''
    const typeRaw = options['type'] != null ? options['type'] as string : ''
    form.value.type = reminderTypeFromContext(typeRaw, options['purchaseId'] != null ? options['purchaseId'] as string : '')
    form.value.remindDate = options['date'] != null ? safeParam(options['date'] as string) : ''
    form.value.note = options['note'] != null ? safeParam(options['note'] as string) : ''
    relatedPurchaseId.value = options['purchaseId'] != null ? options['purchaseId'] as string : ''
    relatedWishId.value = options['wishId'] != null ? options['wishId'] as string : ''
    relatedProductId.value = options['productId'] != null ? safeParam(options['productId'] as string) : ''
    relatedReleaseId.value = options['releaseId'] != null ? safeParam(options['releaseId'] as string) : ''
    if (form.value.remindTime === '') form.value.remindTime = getDefaultTime()
    initialFormSnapshot = { ...form.value }
  }
})

