<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar>
      <AppNavbar v-if="!selectMode" title="提醒事项" :show-back="true" />
      <AppNavbar v-else title="选择提醒" :show-back="false">
        <template #left>
          <text :style="selectBackText" @tap="exitSelectMode">取消</text>
        </template>
        <template #default>
          <view :style="selectNavRow">
            <text :style="selectAllText" @tap="toggleSelectAll">{{ selectAllLabel }}</text>
          </view>
        </template>
      </AppNavbar>
    </template>
    <template #default>
      <scroll-view :style="scrollWrap">
        <view class="page-canvas" :style="pageWrap">

          <V2StatsCard
            primary-label="待办提醒"
            :primary-value="(store.todayCount + store.upcomingCount + store.missedCount) + ' 条'"
            secondary-label="今日到期"
            :secondary-value="store.todayCount + ' 条'"
            :secondary-highlight="store.todayCount > 0"
            tertiary-label="已过期"
            :tertiary-value="store.missedCount + ' 条'"
          />

          <V2CapsuleFilter :items="filters" :active="activeFilter" @change="onFilter" />

          <AppLoading v-if="store.loading" />

          <template v-else-if="store.groupedItems.length === 0">
            <view :style="emptyWrap">
              <AppIcon name="reminder" :size="64" />
              <text :style="emptyTitle">暂无提醒</text>
            </view>
          </template>

          <view v-else>
            <view v-for="group in store.groupedItems" :key="group.group">
              <view :style="groupHeader">
                <text :style="groupHeaderText">{{ group.label }}</text>
              </view>
              <view v-for="item in group.items" :key="item.id" :style="itemCard(item)" @tap="selectMode ? toggleItem(item.id) : openItem(item.id)" @longpress="enterSelectMode(item.id)">
                <view v-if="selectMode" :style="checkboxWrap">
                  <view :style="checkboxMark(selectedIds.indexOf(item.id) >= 0)"><text v-if="selectedIds.indexOf(item.id) >= 0" :style="checkIcon">✓</text></view>
                </view>
                <view :style="cardCenter">
                  <text :style="cardTitle">{{ item.title }}</text>
                  <view :style="cardMeta">
                    <text :style="cardTime">{{ item.dateText }}{{ item.timeDisplay !== '' ? ' ' + item.timeDisplay : '' }}</text>
                    <text :style="cardSource">· {{ item.sourceLabel }}</text>
                  </view>
                </view>
                <view v-if="!selectMode" @tap.stop="onQuickToggle(item)">
                  <V2StatusChip :label="item.statusText" :status="reminderStatusClass(item.statusText)" size="sm" />
                </view>
              </view>
            </view>
          </view>

          <view :style="bottomSpacer" />
        </view>
      </scroll-view>
    </template>
  </MainLayout>

  <view v-if="selectMode && selectedIds.length > 0" :style="bottomBar">
    <view :style="deleteButton" @tap="confirmDelete"><text :style="deleteButtonText">删除 ({{ selectedIds.length }})</text></view>
  </view>
  <view v-if="selectMode && selectedIds.length === 0" :style="bottomBar">
    <view :style="deleteDisabled"><text :style="deleteDisabledText">请选择提醒</text></view>
  </view>

  <AppDialog v-if="showDeleteConfirm" title="确认删除" confirm-text="删除" @confirm="batchDelete" @cancel="showDeleteConfirm = false">
    <text :style="dialogText">确定删除选中的 {{ selectedIds.length }} 条提醒吗？</text>
  </AppDialog>

  <AppFab v-if="!selectMode && !store.loading" @tap="goAdd" />
</template>

<script setup lang="uts">
import { useReminderStore } from '@/stores/reminder-store'
import { ReminderDisplayModel } from '@/domain/reminder-presenter'
import { TYPE_COLORS, TYPE_COLORS_DARK } from '@/domain/reminder'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import V2CapsuleFilter from '@/components/v2/V2CapsuleFilter.uvue'
import V2StatsCard from '@/components/v2/V2StatsCard.uvue'
import V2StatusChip from '@/components/v2/V2StatusChip.uvue'
import AppFab from '@/components/base/AppFab.uvue'

const store = useReminderStore()
const activeFilter = ref('全部')
const filters = ['全部', '待提醒', '已完成', '已过期']
const selectMode = ref(false)
const selectedIds = ref<string[]>([])
const showDeleteConfirm = ref(false)

function onFilter(label: string) {
  activeFilter.value = label
  store.setFilterStatus(label === '全部' ? '' : (label === '待提醒' ? 'PENDING' : (label === '已过期' ? 'MISSED' : 'DONE')))
}
function reminderStatusClass(statusText: string): string {
  if (statusText === '已完成') return 'positive'
  if (statusText === '已过期') return 'neutral'
  return 'pending'
}
function goAdd() { uni.navigateTo({ url: '/pages/reminder/edit' }) }
function openItem(id: string) { if (!selectMode.value) uni.navigateTo({ url: `/pages/reminder/edit?id=${id}` }) }
function onQuickToggle(item: ReminderDisplayModel) {
  if (item.statusText === '已过期') return
  if (item.statusText === '已完成') { store.markUndone(item.id); showFeedback('已恢复提醒') }
  else { store.markDone(item.id); showFeedback('已标记完成') }
}

function enterSelectMode(id: string) {
  selectMode.value = true
  selectedIds.value = [id]
}
function exitSelectMode() {
  selectMode.value = false
  selectedIds.value = []
  showDeleteConfirm.value = false
}
function toggleItem(id: string) {
  const idx = selectedIds.value.indexOf(id)
  if (idx >= 0) {
    const next = [...selectedIds.value]; next.splice(idx, 1); selectedIds.value = next
  } else {
    selectedIds.value = [...selectedIds.value, id]
  }
}
function toggleSelectAll() {
  const allIds = store.groupedItems.flatMap((g) => g.items.map((it) => it.id))
  if (selectedIds.value.length === allIds.length) selectedIds.value = []
  else selectedIds.value = allIds
}
const selectAllLabel = computed((): string => {
  const allIds = store.groupedItems.flatMap((g) => g.items.map((it) => it.id))
  return selectedIds.value.length === allIds.length && selectedIds.value.length > 0 ? '取消全选' : '全选'
})

function confirmDelete() {
  if (selectedIds.value.length === 0) return
  showDeleteConfirm.value = true
}
function batchDelete() {
  for (let i = 0; i < selectedIds.value.length; i++) store.deleteItem(selectedIds.value[i])
  showDeleteConfirm.value = false
  showFeedback(`已删除 ${selectedIds.value.length} 条`)
  exitSelectMode()
}

onMounted(() => { store.fetchItems() })

const scrollWrap = { flex: 1 }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const bottomSpacer = { height: '200rpx' }

const groupHeader = { paddingTop: '24rpx', paddingBottom: '12rpx' }
const groupHeaderText = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.textTertiary }))

const typeColors = computed((): any => isDark.value ? TYPE_COLORS_DARK : TYPE_COLORS)

function itemCard(item: ReminderDisplayModel): any {
  const bgColor = item.statusText === '已完成' ? '#EEEEEE' : (typeColors.value[item.type] != null ? typeColors.value[item.type] as string : n.value.surface)
  return {
    flexDirection: 'row',
    alignItems: 'center',
    height: '136rpx',
    paddingLeft: '20rpx',
    paddingRight: '24rpx',
    borderRadius: '24rpx',
    backgroundColor: bgColor,
    borderWidth: '1rpx',
    borderStyle: 'solid' as string,
    borderColor: n.value.cardBorder,
    marginBottom: '12rpx',
    overflow: 'hidden',
  }
}
const cardCenter = { flex: 1, justifyContent: 'center' }
const cardTitle = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, lines: 1, textOverflow: 'ellipsis', marginBottom: '6rpx' }))
const cardMeta = { flexDirection: 'row', alignItems: 'center' }
const cardTime = { fontSize: '22rpx', color: n.value.textSecondary }
const cardSource = { fontSize: '22rpx', color: n.value.textTertiary }

const selectNavRow = computed((): any => ({ ...flexRow, flexDirection: 'row', alignItems: 'center', height: '100%' }))
const selectAllText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: brand[500] as string }))
const selectBackText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: n.value.text, paddingRight: '16rpx' }))
const checkboxWrap = { width: '56rpx', alignItems: 'center', justifyContent: 'center', flexShrink: 0, marginRight: '10rpx' }
function checkboxMark(checked: boolean) { return { width: '40rpx', height: '40rpx', borderRadius: '20rpx', borderWidth: '3rpx', borderStyle: 'solid' as string, borderColor: checked ? (brand[500] as string) : n.value.cardBorder, backgroundColor: checked ? (brand[500] as string) : 'transparent', alignItems: 'center', justifyContent: 'center' } }
const checkIcon = { fontSize: '24rpx', color: '#FFFFFF', fontWeight: 'bold' }
const bottomBar = computed((): any => ({ position: 'fixed', bottom: '0', left: '0', right: '0', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR, paddingBottom: '40rpx', paddingTop: '20rpx', backgroundColor: n.value.surface }))
const deleteButton = computed((): any => ({ height: '96rpx', borderRadius: '24rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center' }))
const deleteButtonText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: '#FFFFFF' }
const deleteDisabled = computed((): any => ({ height: '96rpx', borderRadius: '24rpx', backgroundColor: n.value.bgTertiary, alignItems: 'center', justifyContent: 'center' }))
const deleteDisabledText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.textTertiary }
const dialogText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, textAlign: 'center', padding: '24rpx' }))

const emptyWrap = { alignItems: 'center', paddingTop: '120rpx' }
const emptyTitle = computed((): any => ({ fontSize: fontSize.lg, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '20rpx' }))
</script>
