<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><PageHeader title="圈子" action-text="发布" @action="goCreate" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view v-if="viewMode === 'mine'" :style="mineTitleWrap">
          <text :style="mineTitle">我的发布</text>
        </view>
        <view v-if="viewMode !== 'mine'">
        <text :style="introText">穿搭灵感 Gallery · 内测中，看同好如何搭配，也分享你的今日造型</text>
        <view :style="composerCard" @tap="goCreate">
          <view :style="composerIcon"><AppIcon name="camera" :size="38" :active="true" /></view>
          <view :style="composerCopy"><text :style="composerTitle">分享今天的穿搭</text><text :style="composerDesc">选择照片、坑向和话题</text></view>
          <view :style="composerButton"><text :style="composerButtonText">发布</text></view>
        </view>
        <view :style="filterBar">
          <text :style="filterLabel">筛选</text>
          <view :style="filterSpacer" />
          <view :style="dropdownWrap">
            <view :style="dropdownButton" @tap="openTopicPicker"><text :style="dropdownText">主题 · {{ activeTopic }}</text></view>
          </view>
          <view :style="dropdownWrapPit">
            <view :style="dropdownButton" @tap="openPitPicker"><text :style="dropdownText">坑向 · {{ activePitType }}</text></view>
          </view>
        </view>
        </view>

        <!-- 公开 Gallery：loading / empty / error 三态 -->
        <view v-if="viewMode !== 'mine' && (library.publicLoading || !library.publicLoadedOnce)" :style="stateWrap">
          <FeedSkeleton />
        </view>
        <view v-else-if="viewMode !== 'mine' && library.publicError !== ''" :style="stateWrap">
          <PageState icon="info" title="灵感加载失败" :message="library.publicError" action-text="重新加载" @action="reloadPublic" />
        </view>
        <view v-else-if="viewMode !== 'mine' && visibleLooks.length === 0" :style="stateWrap">
          <PageState icon="camera" title="还没有穿搭灵感" message="同好们还没分享，敬请期待" />
        </view>

        <!-- 公开 Gallery 帖子：双列 NoteCard（V3 §6.4） -->
        <view v-if="viewMode !== 'mine' && visibleLooks.length > 0" :style="lookGrid">
          <view v-for="look in visibleLooks" :key="look.id" :style="lookShell">
            <NoteCard :title="look.caption !== '' ? look.caption : '今天也认真搭配了'" :author="look.authorNickname" :image="look.imageUrl" :like-count="publicLikeCount(look)" :liked="library.isPostLiked(look.id)" @tap="previewPostImage(look.imageUrl)" @toggle-like="togglePublicLike(look.id)" />
          </view>
        </view>

        <!-- 我的发布 -->
        <view v-if="viewMode === 'mine'">
        <view v-if="visibleUserLooks.length === 0" :style="stateWrap">
          <PageState icon="camera" title="还没有发布过穿搭" message="点击右上角「发布」，分享你的第一套搭配" action-text="去发布" @action="goCreate" />
        </view>
        <view v-if="visibleUserLooks.length > 0" :style="lookGrid">
        <view v-for="look in visibleUserLooks" :key="look.id" :style="lookShell">
          <NoteCard :title="look.caption !== '' ? look.caption : '今天也认真搭配了'" :author="'我的发布'" :image="look.image" :like-count="ownLikeCount(look.id)" :liked="library.isPostLiked(look.id)" @tap="previewPostImage(look.image)" @toggle-like="toggleLike(look.id)" />
        </view>
        </view>
        </view>

      </view>
    </template>
  </MainLayout>
</view>
</template>

<script setup lang="uts">
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3, PRODUCT_CARD_WIDTH_V3, FEED_GUTTER_V3, COLUMN_GAP_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import PageHeader from '@/components/v3/PageHeader.uvue'
import NoteCard from '@/components/v3/NoteCard.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'
import { useContentLibraryStore, SavedOutfitPost, PublicLookPost } from '@/stores/content-library-store'
import { getWindowHeight } from '@/utils/window-info'

const activeTopic = ref('全部')
const activePitType = ref('全部')
const viewMode = ref('') // '' | 'mine'
const pageHeight = getWindowHeight()
const library = useContentLibraryStore()
const topics = ['全部', '今日穿搭', '茶会搭配', '通勤三坑']
const pitTypes = ['全部', 'JK', 'Lolita', '汉服', '混搭']

// 公开 Gallery：仅筛选作用于公开帖子
function filterByPitAndTopic(items: PublicLookPost[]): PublicLookPost[] {
  let result = items
  if (activePitType.value !== '全部') {
    result = result.filter((item: PublicLookPost): boolean => item.category === activePitType.value || (activePitType.value === '混搭' && item.category === '混搭'))
  }
  if (activeTopic.value !== '全部') {
    result = result.filter((item: PublicLookPost): boolean => item.topic === activeTopic.value)
  }
  return result
}
const visibleLooks = computed((): PublicLookPost[] => filterByPitAndTopic(library.publicPosts))
// 我的发布：筛选只作用于我的帖子
const visibleUserLooks = computed((): SavedOutfitPost[] => {
  let result: SavedOutfitPost[] = library.outfitPosts
  if (activePitType.value !== '全部') {
    result = result.filter((item) => item.category === activePitType.value || (activePitType.value === '混搭' && item.category === '混搭'))
  }
  if (activeTopic.value !== '全部') {
    result = result.filter((item) => item.topic === activeTopic.value)
  }
  return result
})
// Android 原生 action sheet 比嵌套浮层更稳定：不会被 list/scroll 层吞掉点击事件。
function openTopicPicker() {
  uni.showActionSheet({ itemList: topics, success: (res) => { activeTopic.value = topics[res.tapIndex] } })
}
function openPitPicker() {
  uni.showActionSheet({ itemList: pitTypes, success: (res) => { activePitType.value = pitTypes[res.tapIndex] } })
}
function goCreate() { uni.navigateTo({ url: '/pages/share/create' }) }
function previewPostImage(url: string) { if (url != '') uni.previewImage({ current: url, urls: [url] }) }
function reloadPublic() { library.refreshPublicPosts() }
// 公开帖点赞：作用于公开实体
function togglePublicLike(id: string) {
  library.togglePostLike(id)
  // 同步本地乐观计数
  const posts = library.publicPosts
  for (let i = 0; i < posts.length; i++) {
    if (posts[i].id == id) {
      const liked = library.isPostLiked(id)
      posts[i].liked = liked
      posts[i].likeCount = Math.max(0, posts[i].likeCount + (liked ? 1 : -1))
      break
    }
  }
}
function publicLikeCount(look: PublicLookPost): number {
  return look.likeCount
}
// 我的发布点赞
function toggleLike(id: string) { library.togglePostLike(id) }
function ownLikeCount(id: string): number { return library.isPostLiked(id) ? 1 : 0 }
const nowTs = ref(Date.now())
let clockTimer: number | null = null
function postTime(createdAt: string): string {
  if (createdAt == '') return '刚刚'
  const timestamp = parseInt(createdAt)
  if (isNaN(timestamp)) {
    // ISO 字符串时间
    const t = new Date(createdAt).getTime()
    if (isNaN(t)) return '刚刚'
    return relativeTime(t)
  }
  return relativeTime(timestamp)
}
function relativeTime(ts: number): string {
  const minutes = Math.floor(Math.max(0, nowTs.value - ts) / 60000)
  if (minutes < 1) return '刚刚'
  if (minutes < 60) return `${minutes}分钟前`
  const hours = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}小时前`
  const days = Math.floor(hours / 24)
  return days < 30 ? `${days}天前` : `${Math.floor(days / 30)}个月前`
}
function startClock() {
  nowTs.value = Date.now()
  if (clockTimer != null) return
  clockTimer = setInterval(() => { nowTs.value = Date.now() }, 60000)
}
function stopClock() {
  const timer = clockTimer
  if (timer != null) clearInterval(timer)
  clockTimer = null
}
onLoad(() => { initPageTheme() })
// 网络请求 30s TTL：频繁切 tab 不重复拉取（本地 reload 每次仍执行）
let lastNetworkFetchAt = 0
onShow(() => {
  initPageTheme()
  library.reload()
  const now = Date.now()
  if (now - lastNetworkFetchAt >= 30000) {
    lastNetworkFetchAt = now
    // 公开 Gallery 与我的发布分别拉取
    library.refreshPublicPosts()
    library.refreshMyPosts()
  }
  startClock()
  try {
    const pendingView = uni.getStorageSync('community_view') as string
    if (pendingView !== '') {
      viewMode.value = pendingView
      uni.removeStorageSync('community_view')
    }
  } catch (e) {}
  try {
    const pendingTopic = uni.getStorageSync('community_topic') as string
    if (pendingTopic !== '') {
      activeTopic.value = pendingTopic
      uni.removeStorageSync('community_topic')
    }
  } catch (e) {}
})
onHide(() => { stopClock() })
onUnload(() => { stopClock() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
const mineTitleWrap = { marginBottom: '12rpx' }
const mineTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const introText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '40rpx', marginBottom: '18rpx' }))
const composerCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '128rpx', paddingLeft: '20rpx', paddingRight: '16rpx', borderRadius: '16rpx', backgroundColor: n.value.inputFill, marginBottom: '8rpx' }))
const composerIcon = computed((): any => ({ width: '72rpx', height: '72rpx', borderRadius: '36rpx', backgroundColor: baseColors.white, alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const composerCopy = { ...flexFill }
const composerTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const composerDesc = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary, marginTop: '5rpx' }))
const composerButton = { minWidth: '104rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center' }
const composerButtonText = { fontSize: '26rpx', fontWeight: fontWeight.semibold, color: baseColors.white }
const filterBar = { ...flexRow, alignItems: 'center', minHeight: '76rpx', marginTop: '16rpx', position: 'relative' as string, zIndex: 20 }
const filterLabel = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const filterSpacer = { ...flexFill }
const dropdownWrap = { position: 'relative' as string, marginLeft: '12rpx' }
const dropdownWrapPit = { position: 'relative' as string, marginLeft: '12rpx' }
const dropdownButton = computed((): any => ({ ...flexRow, alignItems: 'center', height: '56rpx', paddingLeft: '20rpx', paddingRight: '20rpx', borderRadius: '9999rpx', backgroundColor: n.value.bgSecondary, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border }))
const dropdownText = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary }))

// 帖子：双列 NoteCard（V3 §6.4 双列穿搭笔记，图片优先）
const lookGrid = { ...flexRow, flexWrap: 'wrap' as string, paddingLeft: FEED_GUTTER_V3, paddingRight: FEED_GUTTER_V3 }
const lookShell = { width: PRODUCT_CARD_WIDTH_V3, marginRight: COLUMN_GAP_V3 }
// 三态使用 V3 PageState / FeedSkeleton（无本地样式）
const stateWrap = { alignItems: 'center', justifyContent: 'center', paddingTop: '96rpx', paddingBottom: '96rpx' }
</script>
