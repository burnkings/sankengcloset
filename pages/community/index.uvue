<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><V2PageHeader title="圈子" action-text="发布" @action="goCreate" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view v-if="viewMode === 'mine'" :style="mineTitleWrap">
          <text :style="mineTitle">我的发布</text>
        </view>
        <view v-if="viewMode !== 'mine'">
        <text :style="introText">看真实同好如何搭配，也分享你的今日造型</text>
        <view :style="composerCard" @tap="goCreate">
          <view :style="composerIcon"><AppIcon name="camera" :size="38" :active="true" /></view>
          <view :style="composerCopy"><text :style="composerTitle">分享今天的穿搭</text><text :style="composerDesc">选择照片、坑向和话题</text></view>
          <view :style="composerButton"><text :style="composerButtonText">发布</text></view>
        </view>
        <view :style="filterBar">
          <text :style="filterLabel">筛选</text>
          <view :style="filterSpacer" />
          <view :style="dropdownWrap">
            <view :style="dropdownButton" @tap="toggleMenu('topic')"><text :style="dropdownText">主题 · {{ activeTopic }}</text><text :style="dropdownArrow">⌄</text></view>
            <view v-if="activeMenu === 'topic'" :style="dropdownMenu">
              <text v-for="item in topics" :key="item" :style="dropdownOption(item === activeTopic)" @tap="chooseTopic(item)">{{ item }}</text>
            </view>
          </view>
          <view :style="dropdownWrapPit">
            <view :style="dropdownButton" @tap="toggleMenu('pit')"><text :style="dropdownText">坑向 · {{ activePitType }}</text><text :style="dropdownArrow">⌄</text></view>
            <view v-if="activeMenu === 'pit'" :style="dropdownMenu">
              <text v-for="item in pitTypes" :key="item" :style="dropdownOption(item === activePitType)" @tap="choosePit(item)">{{ item }}</text>
            </view>
          </view>
        </view>
        </view>

        <view v-for="look in visibleUserLooks" :key="look.id" :style="lookCard">
          <view :style="heroImage"><AppImage :src="look.image" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            <view :style="badge"><view :style="badgeDot" /><text :style="badgeText">{{ look.topic }}</text></view>
          </view>
          <view :style="lookBody">
            <view :style="authorRow"><view :style="avatar"><text :style="avatarText">我</text></view><text :style="authorName">我的圈子</text><text :style="timeText">刚刚</text><text :style="deleteOwnText(look.id)" @tap="deleteOwnPost(look.id)">{{ pendingDeleteId === look.id ? '确认删除' : '删除' }}</text></view>
            <text :style="lookCaption">{{ look.caption !== '' ? look.caption : '今天也认真搭配了' }}</text>
            <view :style="lookMeta"><view :style="ownMeta"><text :style="topicText">#{{ look.topic }}</text><text :style="categoryText">{{ look.category }}</text></view><view :style="likeAction" @tap="toggleLike(look.id)"><AppIcon name="heart" :size="32" :active="library.isPostLiked(look.id)" /><text :style="likeText(look.id)">{{ ownLikeCount(look.id) }}</text></view></view>
          </view>
        </view>

        <view v-if="viewMode !== 'mine'">
        <view v-for="look in visibleLooks" :key="look.id" :style="lookCard">
          <view :style="heroImage"><AppImage :src="look.image" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            <view :style="badge"><view :style="badgeDot" /><text :style="badgeText">{{ look.topic }}</text></view>
          </view>
          <view :style="lookBody">
            <view :style="authorRow"><view :style="avatar"><text :style="avatarText">{{ look.initial }}</text></view><text :style="authorName">{{ look.author }}</text><text :style="timeText">{{ look.time }}</text></view>
            <text :style="lookCaption">{{ look.caption }}</text>
            <view :style="lookMeta"><text :style="topicText">#{{ look.topic }}</text><view :style="likeAction" @tap="toggleLike(look.id)"><AppIcon name="heart" :size="32" :active="library.isPostLiked(look.id)" /><text :style="likeText(look.id)">{{ likeCount(look.id, look.likes) }}</text></view></view>
          </view>
        </view>
        </view>

      </view>
    </template>
  </MainLayout>
  <!-- #ifdef APP -->
  <AppBottomNav active="community" />
  <!-- #endif -->
</view>
</template>

<script setup lang="uts">
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark, syncTabBarChrome, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2PageHeader from '@/components/v2/V2PageHeader.uvue'
import { useContentLibraryStore, SavedOutfitPost } from '@/stores/content-library-store'
import { showFeedback } from '@/utils/feedback'
// #ifdef APP
import { getWindowHeight } from '@/utils/window-info'
import AppBottomNav from '@/components/layout/AppBottomNav.uvue'
// #endif

type LookItem = {
  id: string
  image: string
  topic: string
  pitType: string
  initial: string
  author: string
  time: string
  caption: string
  likes: number
}

const activeTopic = ref('全部')
const activePitType = ref('全部')
const pendingDeleteId = ref('')
const activeMenu = ref('')
const viewMode = ref('') // '' | 'mine'
const pageHeight = getWindowHeight()
const library = useContentLibraryStore()
const topics = ['全部', '今日穿搭', '茶会搭配', '通勤三坑']
const pitTypes = ['全部', 'JK', 'Lolita', '汉服', '混搭']
const looks: LookItem[] = []
function filterByPitAndTopic(items: LookItem[]): LookItem[] {
  let result = items
  if (activePitType.value !== '全部') {
    result = result.filter((item: LookItem): boolean => item.pitType === activePitType.value)
  }
  if (activeTopic.value !== '全部') {
    result = result.filter((item: LookItem): boolean => item.topic === activeTopic.value)
  }
  return result
}
const visibleLooks = computed((): LookItem[] => filterByPitAndTopic(looks))
const visibleUserLooks = computed((): SavedOutfitPost[] => {
  let result: SavedOutfitPost[] = library.outfitPosts
  if (activePitType.value !== '全部') {
    result = result.filter((item) => item.category === activePitType.value || (activePitType.value === '混搭' && item.category === '混搭'))
  }
  if (activeTopic.value !== '全部') {
    result = result.filter((item) => item.topic === activeTopic.value)
  }
  return result
})
function toggleMenu(menu: string) { activeMenu.value = activeMenu.value === menu ? '' : menu }
function chooseTopic(topic: string) { activeTopic.value = topic; activeMenu.value = '' }
function choosePit(pit: string) { activePitType.value = pit; activeMenu.value = '' }
function goCreate() { uni.navigateTo({ url: '/pages/share/create' }) }
function toggleLike(id: string) { library.togglePostLike(id) }
function likeCount(id: string, baseCount: number): number { return baseCount + (library.isPostLiked(id) ? 1 : 0) }
function ownLikeCount(id: string): number { return library.isPostLiked(id) ? 1 : 0 }
function deleteOwnPost(id: string) {
  if (pendingDeleteId.value !== id) { pendingDeleteId.value = id; showFeedback('再次点击确认删除'); return }
  library.removeOutfit(id)
  pendingDeleteId.value = ''
  showFeedback('圈子动态已删除')
}
onLoad(() => { initPageTheme() })
onShow(() => {
  initPageTheme()
  library.reload()
  try {
    const pendingView = uni.getStorageSync('community_view') as string
    if (pendingView !== '') {
      viewMode.value = pendingView
      uni.removeStorageSync('community_view')
    }
  } catch (e) {}
  try {
    const pendingTopic = uni.getStorageSync('community_topic') as string
    if (pendingTopic !== '') {
      activeTopic.value = pendingTopic
      uni.removeStorageSync('community_topic')
    }
  } catch (e) {}
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const mineTitleWrap = { marginBottom: '12rpx' }
const mineTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const introText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '40rpx', marginBottom: '18rpx' }))
const composerCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '128rpx', paddingLeft: '20rpx', paddingRight: '16rpx', borderRadius: '24rpx', backgroundColor: n.value.inputFill, marginBottom: '8rpx' }))
const composerIcon = computed((): any => ({ width: '72rpx', height: '72rpx', borderRadius: '36rpx', backgroundColor: baseColors.white, alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const composerCopy = { ...flexFill }
const composerTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const composerDesc = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary, marginTop: '5rpx' }))
const composerButton = { minWidth: '104rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: brand[500], alignItems: 'center', justifyContent: 'center' }
const composerButtonText = { fontSize: '26rpx', fontWeight: fontWeight.semibold, color: baseColors.white }
const filterBar = { ...flexRow, alignItems: 'center', minHeight: '76rpx', marginTop: '16rpx', position: 'relative' as string, zIndex: 20 }
const filterLabel = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const filterSpacer = { ...flexFill }
const dropdownWrap = { position: 'relative' as string, marginLeft: '12rpx' }
const dropdownWrapPit = { position: 'relative' as string, marginLeft: '12rpx' }
const dropdownButton = computed((): any => ({ ...flexRow, alignItems: 'center', height: '60rpx', paddingLeft: '18rpx', paddingRight: '14rpx', borderRadius: '30rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder }))
const dropdownText = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary }))
const dropdownArrow = computed((): any => ({ fontSize: '22rpx', color: n.value.textTertiary, marginLeft: '8rpx' }))
const dropdownMenu = computed((): any => ({ position: 'absolute' as string, right: '0', top: '68rpx', minWidth: '180rpx', paddingTop: '8rpx', paddingBottom: '8rpx', borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder, zIndex: 30 }))
function dropdownOption(active: boolean) { return { minHeight: '64rpx', paddingLeft: '22rpx', paddingRight: '22rpx', fontSize: '24rpx', fontWeight: active ? fontWeight.semibold : fontWeight.regular, color: active ? brand[600] : n.value.text, textAlignVertical: 'center' as string } }
const lookCard = computed((): any => ({ marginTop: '22rpx', borderRadius: '24rpx', overflow: 'hidden', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder }))
const heroImage = { width: '686rpx', height: '480rpx', position: 'relative' as string, backgroundColor: n.value.bgTertiary }
const badge = { position: 'absolute' as string, left: '28rpx', top: '28rpx', height: '52rpx', paddingLeft: '16rpx', paddingRight: '20rpx', borderRadius: '26rpx', backgroundColor: baseColors.white, ...flexRow, alignItems: 'center' as string }
const badgeDot = { width: '16rpx', height: '16rpx', borderRadius: '8rpx', backgroundColor: brand[500], marginRight: '8rpx' }
const badgeText = { fontSize: '22rpx', color: n.value.text }
const lookBody = { padding: CARD_PADDING }
const authorRow = { ...flexRow, alignItems: 'center' }
const avatar = computed((): any => ({ width: '56rpx', height: '56rpx', borderRadius: '28rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.bgTertiary, alignItems: 'center', justifyContent: 'center', marginRight: '12rpx' }))
const avatarText = { fontSize: '24rpx', fontWeight: fontWeight.semibold, color: n.value.text }
const authorName = computed((): any => ({ ...flexFill, fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text }))
const timeText = computed((): any => ({ fontSize: '22rpx', color: n.value.textTertiary }))
const lookCaption = computed((): any => ({ fontSize: '26rpx', color: n.value.textSecondary, lineHeight: '40rpx', marginTop: '14rpx' }))
const lookMeta = { ...flexRow, justifyContent: 'space-between', marginTop: '12rpx', alignItems: 'center' }
const ownMeta = { ...flexRow, alignItems: 'center' }
const topicText = { fontSize: '24rpx', color: brand[500], marginTop: '10rpx' }
const likeAction = { ...flexRow, alignItems: 'center', minWidth: '76rpx', height: '52rpx', justifyContent: 'flex-end' }
function likeText(id: string) { return { fontSize: '24rpx', color: library.isPostLiked(id) ? brand[500] : n.value.textTertiary, marginLeft: '6rpx' } }
const categoryText = computed((): any => ({ fontSize: '24rpx', color: n.value.textTertiary, marginTop: '10rpx' }))
function deleteOwnText(id: string) { return { fontSize: '20rpx', color: pendingDeleteId.value === id ? brand[700] : n.value.textTertiary, marginLeft: '16rpx' } }
</script>
