<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="我的动态" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <template v-if="filteredPosts.length === 0">
          <PageState icon="camera" title="还没有发布动态" message="发布后的内容会集中显示在这里" action-text="去发布" @action="goCreate" />
        </template>
        <view v-for="post in filteredPosts" :key="post.id" :style="postShell">
          <PostCard :image="post.image" :caption="post.caption !== '' ? post.caption : '今天也认真搭配了'" :author="'我'" :avatar-text="post.authorNickname !== '' ? post.authorNickname.substring(0, 1) : '我'" :avatar-url="post.authorAvatarUrl" :time-text="postTime(post.createdAt)" :like-count="library.isPostLiked(post.id) ? 1 : 0" :liked="library.isPostLiked(post.id)" :product-id="post.productId" @tap="previewPost(post)" @toggle-like="toggleLike(post.id)" @product="openProduct(post.productId)" @more="deletePost(post.id)">
            <!-- 标签行放进卡片内部（原来是一张独立小卡挂在动态下方，视觉上像两块东西） -->
            <template #tags>
              <view :style="tagRow"><text :style="topicStyle">#{{ post.topic !== '' ? post.topic : '日常分享' }}</text><text :style="categoryStyle">{{ post.category }}</text><text v-if="post.wardrobeIds.length > 0" :style="categoryStyle">已关联 {{ post.wardrobeIds.length }} 件衣物</text><text v-if="post.visibility === 'private'" :style="privateBadge">仅自己可见</text></view>
            </template>
          </PostCard>
        </view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { useContentLibraryStore, SavedOutfitPost } from '@/stores/content-library-store'
import { fontSize } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import PageState from '@/components/v3/PageState.uvue'
import PostCard from '@/components/v3/PostCard.uvue'
import { showFeedback } from '@/utils/feedback'
import { openProductDetail } from '@/utils/content-navigation'

const library = useContentLibraryStore()
const nowTs = ref(Date.now())
let clockTimer: number | null = null

// 仅展示已发布内容
const filteredPosts = computed((): SavedOutfitPost[] => {
  return library.outfitPosts.filter((item: SavedOutfitPost): boolean => item.isRemote)
})

function toggleLike(id: string) { library.togglePostLike(id) }
function previewPostImage(url: string) { if (url != '') uni.previewImage({ current: url, urls: [url] }) }
/** 多图：交给 previewImage 一次拿到，用户左右滑即可 */
function previewPost(post: SavedOutfitPost) {
  const urls = post.imageUrls.length > 0 ? post.imageUrls : (post.image != '' ? [post.image] : [])
  if (urls.length === 0) return
  uni.previewImage({ current: urls[0], urls })
}
function openProduct(id: string) { if (id !== '') openProductDetail(id) }
function goCreate() { uni.navigateTo({ url: '/pages/share/create' }) }
function deletePost(id: string) {
  uni.showModal({ title: '删除动态？', content: '删除后无法恢复，确定删除这条动态吗？', confirmText: '删除', cancelText: '取消', success: (answer) => {
    if (!answer.confirm) return
    library.removeOutfit(id)
    showFeedback('动态已删除')
  } })
}
function postTime(createdAt: string): string {
  if (createdAt == '') return '刚刚'
  // ⚠️ 后端给的是 ISO 字符串（2026-10-03T18:47:30.123Z）。
  // 旧写法直接 parseInt() 只拿到年份「2026」，再当毫秒时间戳去减当前时间，
  // 差了 50 多年 ⇒ 页面显示「690 个月前」。这里按形态分流：纯数字按秒/毫秒，其余走 Date.parse。
  const numeric = parseInt(createdAt)
  let timestamp = 0
  if (!isNaN(numeric) && createdAt.indexOf('-') < 0 && createdAt.indexOf('T') < 0) {
    timestamp = createdAt.length <= 10 ? numeric * 1000 : numeric
  } else {
    timestamp = Date.parse(createdAt)
  }
  if (isNaN(timestamp) || timestamp <= 0) return '刚刚'
  const minutes = Math.floor(Math.max(0, nowTs.value - timestamp) / 60000)
  if (minutes < 1) return '刚刚'
  if (minutes < 60) return `${minutes}分钟前`
  const hours = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}小时前`
  const days = Math.floor(hours / 24)
  return days < 30 ? `${days}天前` : `${Math.floor(days / 30)}个月前`
}
function startClock() {
  nowTs.value = Date.now()
  if (clockTimer != null) return
  clockTimer = setInterval(() => { nowTs.value = Date.now() }, 60000)
}
function stopClock() {
  const timer = clockTimer
  if (timer != null) clearInterval(timer)
  clockTimer = null
}
onLoad(() => { initPageTheme() })
onShow(() => { initPageTheme(); library.reload(); library.refreshMyPosts(); startClock() })
onHide(() => { stopClock() })
onUnload(() => { stopClock() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
// V3 §6.5 紧凑列表行：缩略图 + 标题/时间 + 删除；分割线分组
// 卡片自身的间距由 PostCard 负责；外层只留卡片之间的间隔
const postShell = { marginBottom: '20rpx' }
// 标签行渲染在 PostCard 的底部行里（与点赞同排、点赞贴最右）；
// 换行边界由 PostCard 的 footerLeft 控制，这里只负责标签自身的排版。
const tagRow = computed((): any => ({ ...flexRow, alignItems: 'center', flexWrap: 'wrap', marginTop: '6rpx' }))
const topicStyle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.iconActive }))
const categoryStyle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginLeft: '16rpx' }))
/** 私密动态的标识：不带它的话用户在「我的动态」里根本分不清哪条别人看不到 */
const privateBadge = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginLeft: '16rpx', paddingLeft: '12rpx', paddingRight: '12rpx', paddingTop: '4rpx', paddingBottom: '4rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
</script>
