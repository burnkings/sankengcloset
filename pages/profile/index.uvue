<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><V2PageHeader title="我的" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">

        <view :style="profileCard" @tap="session.isLoggedIn ? undefined : goLogin()">
          <view :style="avatarWrap">
            <text v-if="session.isLoggedIn" :style="avatarText">SK</text>
            <AppIcon v-else name="profile" :size="44" />
            <view v-if="session.isLoggedIn" :style="cameraBadge" @tap.stop="onEdit">
              <text :style="cameraBadgeText">+</text>
            </view>
          </view>
          <view :style="profileCopy">
            <text :style="userName">{{ session.isLoggedIn ? session.profile.nickname : '登录三坑绮橱' }}</text>
            <text v-if="session.isLoggedIn" :style="userIdText">ID: {{ session.profile.userId }}</text>
            <text v-else :style="guestDesc">同步收藏、圈子、衣橱与提醒</text>
          </view>
          <view v-if="!session.isLoggedIn" :style="loginButton"><text :style="loginText">登录</text></view>
        </view>

        <V2SectionHeader title="我的工具" />
        <view :style="gridRow">
          <view v-for="(item, idx) in gridItems" :key="item.id" :style="gridCard(idx)" @tap="onManageTap(item.id)">
            <view :style="iconWrap"><AppIcon :name="item.icon" :size="38" :active="true" /></view>
            <view :style="manageCopy"><text :style="manageLabel">{{ item.label }}</text><text :style="manageValue">{{ item.value }}</text></view>
            <AppIcon name="chevron-right" :size="24" />
          </view>
        </view>
        <view :style="budgetCard" @tap="onManageTap('budget')">
          <view :style="iconWrap"><AppIcon name="budget" :size="38" :active="true" /></view>
          <view :style="manageCopy"><text :style="manageLabel">预算</text><text :style="budgetValue">{{ budget.isConfigured ? '¥' + budget.monthlyLimit : '去设置' }}</text></view>
          <AppIcon name="chevron-right" :size="24" />
        </view>

        <V2SectionHeader title="我的内容" />
        <view :style="contentCard" @tap="openMyPosts">
          <view :style="iconWrap"><AppIcon name="camera" :size="38" :active="true" /></view>
          <view :style="outfitAssetCopy"><text :style="outfitAssetTitle">我的动态</text><text :style="outfitAssetValue">{{ library.outfitCount }} 条已发布 · {{ library.likedPostCount }} 条已点赞</text></view>
          <AppIcon name="chevron-right" :size="28" />
        </view>

        <V2SectionHeader title="系统设置" />
        <V2ListGroup>
          <view :style="settingShell(0, 3)" @tap="goPage('/pages/preferences/appearance')"><V2ListRow icon="moon" label="深色模式" :value="themeLabel" /></view>
          <view :style="settingShell(1, 3)" @tap="goPage('/pages/preferences/index')"><V2ListRow icon="heart" label="推荐偏好" :value="preferenceSummary" /></view>
          <view :style="settingShell(2, 3)" @tap="goPage('/pages/preferences/notification')"><V2ListRow icon="notification" label="通知设置" /></view>
        </V2ListGroup>

        <V2ListGroup>
          <view :style="settingShell(0, 2)" @tap="onHelpTap"><V2ListRow icon="help" label="帮助与反馈" /></view>
          <view :style="settingShell(1, 2)" @tap="onClearCacheTap"><V2ListRow icon="clear" label="清理缓存" /></view>
        </V2ListGroup>

        <V2ListGroup>
          <view :style="settingShell(0, 2)" @tap="goPage('/pages/about/index')"><V2ListRow icon="info" label="关于三坑绮橱" value="V2.5" /></view>
          <view v-if="session.isLoggedIn" :style="settingShell(1, 2)" @tap="logout"><V2ListRow icon="profile" label="退出登录" /></view>
        </V2ListGroup>

        <view :style="bottomSpacer" />
      </view>
    </template>
  </MainLayout>
</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, GROUP_GAP, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark, themeMode, initPageTheme, setThemeMode, getThemeLabel } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2PageHeader from '@/components/v2/V2PageHeader.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import V2ListGroup from '@/components/v2/V2ListGroup.uvue'
import V2ListRow from '@/components/v2/V2ListRow.uvue'
import { showFeedback } from '@/utils/feedback'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { useReminderStore } from '@/stores/reminder-store'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useWishListStore } from '@/stores/wishlist-store'
import { useBudgetStore } from '@/stores/budget-store'
import { useSessionStore } from '@/stores/session-store'
import { usePreferencesStore } from '@/stores/preferences-store'
import { getWindowHeight } from '@/utils/window-info'

const pageHeight = getWindowHeight()
const library = useContentLibraryStore()
const purchases = usePurchaseStore()
const reminders = useReminderStore()
const wardrobe = useWardrobeStore()
const wishlist = useWishListStore()
const budget = useBudgetStore()
const session = useSessionStore()
const preferences = usePreferencesStore()

const preferenceSummary = computed((): string => {
  const values = preferences.preferences.pitTypes
  return values.length == 0 ? '全部' : values.join('、')
})
const themeLabel = computed((): string => getThemeLabel())

function onEdit() { showFeedback('功能开发中') }
function goLogin() {
  session.loginWithWechat().then((ok) => {
    if (ok) { session.reload(); showFeedback('登录成功') }
    else if (session.errorMessage !== '') showFeedback(session.errorMessage)
  })
}
function logout() { session.logout(); showFeedback('已退出，设备数据仍保留') }
function goPage(url: string) { uni.navigateTo({ url }) }
function openMyPosts() { uni.navigateTo({ url: '/pages/community/mine' }) }
function onManageTap(id: string) {
  if (id === 'wardrobe') goPage('/pages/wardrobe/index')
  if (id === 'favorites') goPage('/pages/wishlist/index')
  if (id === 'orders') goPage('/pages/purchase/index')
  if (id === 'reminders') goPage('/pages/reminder/index')
  if (id === 'budget') goPage('/pages/budget/index')
}
function onHelpTap() { showFeedback('反馈入口将在账号服务接入后开放') }
function onClearCacheTap() {
  try { uni.removeStorageSync('search_recent'); uni.removeStorageSync('community_view') } catch (e) {}
  showFeedback('已清理')
}

onLoad(() => { initPageTheme() })
let lastProfileReloadTs = 0
const PROFILE_RELOAD_TTL_MS = 30 * 1000
function reloadProfileData() {
  const now = Date.now()
  if (now - lastProfileReloadTs < PROFILE_RELOAD_TTL_MS) return
  lastProfileReloadTs = now
  session.reload()
  library.reload()
  library.refreshRemotePosts()
  library.refreshRemoteBrands()
  budget.refreshRemoteBudget()
  preferences.refreshRemotePreferences()
  purchases.fetchPurchases()
  reminders.fetchItems()
  wardrobe.fetchItems()
  wishlist.fetchItems()
}
onShow(() => { initPageTheme(); reloadProfileData() })

const bottomSpacer = { height: '48rpx' }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }

const profileCard = computed((): any => ({ ...flexRow, alignItems: 'center', padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, marginBottom: '32rpx' }))
const avatarWrap = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: radius.full, backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0, position: 'relative', borderWidth: '2rpx', borderStyle: 'solid', borderColor: baseColors.white }))
const avatarText = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[500] as string }
const cameraBadge = { position: 'absolute', bottom: '-2rpx', right: '-2rpx', width: '24rpx', height: '24rpx', borderRadius: '12rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center' }
const cameraBadgeText = { fontSize: '16rpx', color: baseColors.white, fontWeight: fontWeight.bold }
const guestDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx' }))
const loginButton = computed((): any => ({ minWidth: '120rpx', height: '60rpx', borderRadius: radius.full, backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx' }))
const loginText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: baseColors.white }
const profileCopy = { ...flexFill, justifyContent: 'center' }
const userName = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const userIdText = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '2rpx' }))

class GridItem {
  id: string = ''
  icon: string = ''
  label: string = ''
  value: string = ''
}
function mkItem(id: string, icon: string, label: string, value: string): GridItem {
  const g = new GridItem()
  g.id = id; g.icon = icon; g.label = label; g.value = value
  return g
}
const gridItems = computed(() => [
  mkItem('wardrobe', 'wardrobe', '衣橱', `${wardrobe.itemCount} 件`),
  mkItem('favorites', 'heart', '愿望单', `${wishlist.itemCount} 件`),
  mkItem('orders', 'order', '购买记录', `${purchases.itemCount} 笔`),
  mkItem('reminders', 'reminder', '提醒', `${reminders.pendingCount} 条待办`),
])

const gridRow = { ...flexRow, flexWrap: 'wrap' as string }
function gridCard(idx: number) { return { ...flexRow, alignItems: 'center', width: '325rpx', height: '120rpx', flexShrink: 0, paddingLeft: '18rpx', paddingRight: '12rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder, marginRight: idx % 2 == 0 ? GROUP_GAP : '0', marginBottom: GROUP_GAP } }
const budgetCard = computed((): any => ({ ...flexRow, alignItems: 'center', width: '100%', height: '100rpx', paddingLeft: '18rpx', paddingRight: '14rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder }))
const iconWrap = computed((): any => ({ width: '60rpx', height: '60rpx', borderRadius: '18rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50] as string, alignItems: 'center', justifyContent: 'center', marginRight: '14rpx', flexShrink: 0 }))
const manageCopy = { ...flexFill }
const manageLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const manageValue = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))

const budgetValue = computed((): any => {
  if (!budget.isConfigured) return { fontSize: fontSize['2xs'], color: brand[500] as string, marginTop: '4rpx' }
  return { fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }
})

const contentCard = computed((): any => ({ ...flexRow, alignItems: 'center', height: '100rpx', paddingLeft: '20rpx', paddingRight: '18rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder, marginBottom: '32rpx' }))
const outfitAssetCopy = { ...flexFill }
const outfitAssetTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const outfitAssetValue = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))

function settingShell(idx: number, total: number) { return { borderBottomWidth: idx < total - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.divider } }
</script>
