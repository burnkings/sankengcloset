<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><V2PageHeader title="我的" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view v-if="session.isLoggedIn" :style="profileCard">
          <view :style="avatarWrap"><text :style="avatarText">SK</text></view>
          <view :style="profileCopy">
            <text :style="userName">{{ session.profile.nickname }}</text>
            <text :style="accountId">ID: {{ session.profile.userId }}</text>
          </view>
          <view :style="editButton" @tap="onEdit"><text :style="editText">编辑</text></view>
        </view>
        <view v-else :style="profileCard" @tap="goLogin">
          <view :style="guestAvatar"><AppIcon name="profile" :size="44" /></view>
          <view :style="profileCopy">
            <text :style="userName">登录三坑绮橱</text>
            <text :style="guestDesc">同步收藏、圈子、衣橱与提醒</text>
          </view>
          <view :style="loginButton"><text :style="loginText">登录</text></view>
        </view>

        <V2SectionHeader title="我的服务" />
        <view :style="manageRow">
          <view v-for="(item, idx) in manageItems" :key="item.id" :style="manageCard(idx)" @tap="onManageTap(item.id)">
            <view :style="manageIconWrap"><AppIcon :name="item.icon" :size="38" :active="true" /></view>
            <view :style="manageCopy"><text :style="manageLabel">{{ item.label }}</text><text :style="manageValue">{{ item.value }}</text></view>
            <AppIcon name="chevron-right" :size="28" />
          </view>
        </view>

        <V2SectionHeader title="我的内容" />
        <view :style="outfitAssetCard" @tap="openMyPosts">
          <view :style="outfitAssetIcon"><AppIcon name="camera" :size="38" :active="true" /></view>
          <view :style="outfitAssetCopy"><text :style="outfitAssetTitle">我的动态</text><text :style="outfitAssetValue">{{ library.outfitCount }} 条已发布 · {{ library.likedPostCount }} 条已点赞</text></view>
          <AppIcon name="chevron-right" :size="32" />
        </view>

        <V2SectionHeader title="设置" />
        <V2ListGroup>
          <view :style="settingShell(0, 3)">
            <view @tap="toggleSettingsPanel('dark')"><V2ListRow icon="moon" label="深色模式" :value="getThemeLabel()" /></view>
            <view v-if="openSettingsPanel === 'dark'" :style="dropdownPanel">
              <view v-for="option in themeOptions" :key="option.value" :style="dropdownChoice(themeMode == option.value)" @tap.stop="chooseTheme(option.value)">
                <text :style="dropdownChoiceText(themeMode == option.value)">{{ option.label }}</text>
                <text v-if="themeMode == option.value" :style="selectedMark">✓</text>
              </view>
            </view>
          </view>
          <view :style="settingShell(1, 3)">
            <view @tap="toggleSettingsPanel('preferences')"><V2ListRow icon="heart" label="推荐偏好" :value="preferenceSummary" /></view>
            <view v-if="openSettingsPanel === 'preferences'" :style="dropdownPanel">
              <text :style="dropdownHint">可多选；不选择表示全部坑向</text>
              <view :style="preferenceChipRow">
                <view v-for="(item, idx) in preferenceOptions" :key="item" :style="preferenceChip(idx, item)" @tap.stop="togglePreferenceDraft(item)">
                  <text :style="preferenceChipText(item)">{{ item }}</text>
                </view>
              </view>
              <view :style="savePreferenceButton" @tap.stop="savePreferenceDraft"><text :style="savePreferenceText">保存偏好</text></view>
            </view>
          </view>
          <view :style="settingShell(2, 3)" @tap="onSettingTap('notification')">
            <V2ListRow icon="notification" label="通知设置" />
          </view>
        </V2ListGroup>

        <V2SectionHeader title="关于" />
        <V2ListGroup>
          <view v-for="(item, idx) in aboutGroup" :key="item.id" :style="settingShell(idx, aboutGroup.length)" @tap="onSettingTap(item.id)">
            <V2ListRow :icon="item.icon" :label="item.label" :value="item.value" />
          </view>
        </V2ListGroup>
      </view>
    </template>
  </MainLayout>
  <!-- #ifdef APP -->
  <AppBottomNav active="profile" />
  <!-- #endif -->
</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, GROUP_GAP, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark, themeMode, initPageTheme, setThemeMode, getThemeLabel, ThemeMode } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2PageHeader from '@/components/v2/V2PageHeader.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import V2ListGroup from '@/components/v2/V2ListGroup.uvue'
import V2ListRow from '@/components/v2/V2ListRow.uvue'
import { showFeedback } from '@/utils/feedback'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { useReminderStore } from '@/stores/reminder-store'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useBudgetStore } from '@/stores/budget-store'
import { useSessionStore } from '@/stores/session-store'
import { usePreferencesStore } from '@/stores/preferences-store'
// #ifdef APP
import { getWindowHeight } from '@/utils/window-info'
import AppBottomNav from '@/components/layout/AppBottomNav.uvue'
// #endif

class SettingsItem {
  id: string = ''
  icon: string = ''
  label: string = ''
  value: string = ''
  section: string = ''
}

function createSettingsItem(id: string, icon: string, label: string, value: string, section: string): SettingsItem {
  const item = new SettingsItem()
  item.id = id
  item.icon = icon
  item.label = label
  item.value = value
  item.section = section
  return item
}

const pageHeight = getWindowHeight()
const library = useContentLibraryStore()
const purchases = usePurchaseStore()
const reminders = useReminderStore()
const wardrobe = useWardrobeStore()
const budget = useBudgetStore()
const session = useSessionStore()
const preferences = usePreferencesStore()
const openSettingsPanel = ref('')
const preferenceDraft = ref<string[]>([])

class ThemeOption {
  value: ThemeMode = 'system'
  label: string = ''
}
function createThemeOption(value: ThemeMode, label: string): ThemeOption {
  const option = new ThemeOption()
  option.value = value
  option.label = label
  return option
}
const themeOptions: ThemeOption[] = [
  createThemeOption('system', '跟随系统'),
  createThemeOption('light', '浅色'),
  createThemeOption('dark', '深色'),
]
const preferenceOptions = ['JK', 'Lolita', '汉服']
const preferenceSummary = computed((): string => {
  const values = preferences.preferences.pitTypes
  return values.length == 0 ? '全部' : values.join('、')
})

function toggleSettingsPanel(id: string) {
  if (openSettingsPanel.value == id) { openSettingsPanel.value = ''; return }
  openSettingsPanel.value = id
  if (id == 'preferences') {
    const values = [] as string[]
    const stored = preferences.preferences.pitTypes
    for (let i = 0; i < stored.length; i++) values.push(stored[i])
    preferenceDraft.value = values
  }
}
function chooseTheme(mode: ThemeMode) {
  setThemeMode(mode)
  openSettingsPanel.value = ''
}
function isPreferenceDraftSelected(item: string): boolean { return preferenceDraft.value.indexOf(item) >= 0 }
function togglePreferenceDraft(item: string) {
  const values = [...preferenceDraft.value]
  const idx = values.indexOf(item)
  if (idx >= 0) values.splice(idx, 1)
  else values.push(item)
  preferenceDraft.value = values
}
function savePreferenceDraft() {
  let values = [] as string[]
  if (preferenceDraft.value.length != preferenceOptions.length) {
    for (let i = 0; i < preferenceDraft.value.length; i++) values.push(preferenceDraft.value[i])
  }
  preferences.setPitTypes(values)
  openSettingsPanel.value = ''
  showFeedback('推荐偏好已保存')
}

function onEdit() { showFeedback('功能开发中') }
function goLogin() {
  session.loginWithWechat().then((ok) => {
    if (ok) { session.reload(); showFeedback('登录成功') }
    else if (session.errorMessage !== '') showFeedback(session.errorMessage)
  })
}
function logout() {
  session.logout()
  showFeedback('已退出，设备数据仍保留')
}
function goPage(url: string) { uni.navigateTo({ url }) }
function openMyPosts() { uni.navigateTo({ url: '/pages/community/mine' }) }
function onManageTap(id: string) {
  if (id === 'wardrobe') goPage('/pages/wardrobe/index')
  if (id === 'favorites') goPage('/pages/wishlist/index')
  if (id === 'orders') goPage('/pages/purchase/index')
  if (id === 'reminders') goPage('/pages/reminder/index')
  if (id === 'budget') goPage('/pages/budget/index')
}
function onSettingTap(id: string) {
  if (id === 'notification') { showFeedback('功能开发中'); return }
  if (id === 'privacy') {
    showFeedback('功能开发中')
    return
  }
  if (id === 'agreement') {
    showFeedback('功能开发中')
    return
  }
  if (id === 'policy') {
    showFeedback('功能开发中')
    return
  }
  if (id === 'about') {
    showFeedback('三坑绮橱 V2.3 后端就绪版')
    return
  }
  if (id === 'cache') {
    const cacheKeys = ['search_recent', 'pending_search_keyword', 'community_view', 'community_topic']
    try {
      for (let i = 0; i < cacheKeys.length; i++) uni.removeStorageSync(cacheKeys[i])
    } catch (e) {}
    showFeedback('缓存已清理，账号与个人数据已保留')
    return
  }
  if (id === 'help') { showFeedback('反馈入口将在账号服务接入后开放'); return }
  if (id === 'logout') { logout(); return }
}

onLoad(() => { initPageTheme() })

// 原生 tabBar 保活后 onShow 每次切 Tab 都会触发；30 秒 TTL 去重，避免频繁全量重载
let lastProfileReloadTs = 0
const PROFILE_RELOAD_TTL_MS = 30 * 1000
function reloadProfileData() {
  const now = Date.now()
  if (now - lastProfileReloadTs < PROFILE_RELOAD_TTL_MS) return
  lastProfileReloadTs = now
  session.reload()
  library.reload()
  purchases.fetchPurchases()
  reminders.fetchItems()
  wardrobe.fetchItems()
}
onShow(() => { initPageTheme(); reloadProfileData() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const profileCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '160rpx', paddingTop: '28rpx', paddingBottom: '28rpx', paddingLeft: CARD_PADDING, paddingRight: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
const avatarWrap = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: radius.full, backgroundColor: isDark.value ? n.value.surfaceRaised : brand[100], alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0 }))
const avatarText = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[600] }
const guestAvatar = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: radius.full, backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0 }))
const guestDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '8rpx' }))
const loginButton = computed((): any => ({ minWidth: '132rpx', height: '64rpx', borderRadius: radius.full, backgroundColor: isDark.value ? brand[600] : brand[500], alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx' }))
const loginText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: baseColors.white }
const profileCopy = { ...flexFill, justifyContent: 'center' }
const userName = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const accountId = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx' }))
const editButton = { minWidth: '80rpx', height: '64rpx', alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx', marginRight: '4rpx' }
const editText = { fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: brand[600] }

class ManageItem {
  id: string = ''
  icon: string = ''
  label: string = ''
  value: string = ''
}

function createManageItem(id: string, icon: string, label: string, value: string): ManageItem {
  const item = new ManageItem()
  item.id = id
  item.icon = icon
  item.label = label
  item.value = value
  return item
}

const manageItems = computed(() => [
  createManageItem('wardrobe', 'wardrobe', '衣橱', `${wardrobe.itemCount} 件`),
  createManageItem('favorites', 'heart', '愿望单', `${library.favoriteCount} 件`),
  createManageItem('orders', 'order', '购买记录', `${purchases.itemCount} 笔`),
  createManageItem('reminders', 'reminder', '提醒', `${reminders.pendingCount} 条待办`),
  createManageItem('budget', 'budget', '预算', budget.isConfigured ? `¥${budget.monthlyLimit}` : '待设置'),
])
const manageRow = { ...flexRow, flexWrap: 'wrap' as string }
function manageCard(idx: number) { return { ...flexRow, alignItems: 'center', width: '325rpx', height: '116rpx', flexShrink: 0, paddingLeft: '18rpx', paddingRight: '14rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder, marginRight: idx % 2 == 0 ? GROUP_GAP : '0', marginBottom: GROUP_GAP } }
const manageIconWrap = computed((): any => ({ width: '60rpx', height: '60rpx', borderRadius: '18rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50], alignItems: 'center', justifyContent: 'center', marginRight: '14rpx', flexShrink: 0 }))
const manageCopy = { ...flexFill }
const manageLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const manageValue = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '5rpx' }))
const outfitAssetCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '112rpx', paddingLeft: '20rpx', paddingRight: '18rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder }))
const outfitAssetIcon = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '18rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50], alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const outfitAssetCopy = { ...flexFill }
const outfitAssetTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const outfitAssetValue = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '6rpx' }))

const settingsItems = computed(() => {
  const items: SettingsItem[] = [
    createSettingsItem('privacy', 'info', '隐私与权限', '', 'about'),
    createSettingsItem('agreement', 'info', '用户协议', '', 'about'),
    createSettingsItem('policy', 'info', '隐私政策', '', 'about'),
    createSettingsItem('about', 'info', '关于', 'V2.5', 'about'),
    createSettingsItem('help', 'help-circle', '帮助与反馈', '', 'about'),
    createSettingsItem('cache', 'database', '清理缓存', '', 'about'),
  ]
  if (session.isLoggedIn) items.push(createSettingsItem('logout', 'profile', '退出登录', '', 'about'))
  return items
})
const aboutGroup = computed(() => settingsItems.value.filter((item) => item.section === 'about'))
function settingShell(idx: number, total: number) { return { borderBottomWidth: idx < total - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.divider } }
const dropdownPanel = computed((): any => ({ paddingLeft: '20rpx', paddingRight: '20rpx', paddingBottom: '20rpx', backgroundColor: n.value.surface }))
function dropdownChoice(selected: boolean) { return { ...flexRow, alignItems: 'center', minHeight: '72rpx', paddingLeft: '18rpx', paddingRight: '18rpx', borderRadius: '18rpx', backgroundColor: selected ? n.value.surfacePink : n.value.bgSecondary, marginTop: '8rpx' } }
function dropdownChoiceText(selected: boolean) { return { ...flexFill, fontSize: fontSize.sm, fontWeight: selected ? fontWeight.semibold : fontWeight.regular, color: selected ? brand[700] : n.value.textSecondary } }
const selectedMark = { fontSize: fontSize.sm, fontWeight: fontWeight.bold, color: brand[600] }
const dropdownHint = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx', marginBottom: '12rpx' }))
const preferenceChipRow = { ...flexRow, alignItems: 'center' }
function preferenceChip(idx: number, item: string) { const selected = isPreferenceDraftSelected(item); return { ...flexFill, height: '68rpx', borderRadius: '20rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: selected ? (brand[500] as string) : n.value.bgSecondary, marginRight: idx < preferenceOptions.length - 1 ? '12rpx' : '0' } }
function preferenceChipText(item: string) { return { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: isPreferenceDraftSelected(item) ? baseColors.white : n.value.textSecondary } }
const savePreferenceButton = { height: '76rpx', borderRadius: '22rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center', marginTop: '18rpx' }
const savePreferenceText = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>
