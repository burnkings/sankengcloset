<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><PageHeader title="我的" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">

        <view :style="profileCard" @tap="session.isLoggedIn ? onEdit() : openLoginOptions()">
          <view :style="avatarWrap">
            <text v-if="session.isLoggedIn" :style="avatarText">SK</text>
            <AppIcon v-else name="profile" :size="44" />
            <view v-if="session.isLoggedIn" :style="cameraBadge" @tap.stop="onEdit">
              <AppIcon name="add" :size="14" :active="true" />
            </view>
          </view>
          <view :style="profileCopy">
            <text :style="userName">{{ session.isLoggedIn ? session.profile.nickname : '登录三坑绮橱' }}</text>
            <text v-if="session.isLoggedIn" :style="userIdText">{{ session.isMock ? '本机数据' : 'ID: ' + session.profile.userId }}</text>
            <text v-else :style="guestDesc">同步收藏、动态、衣橱与提醒</text>
          </view>
          <view v-if="!session.isLoggedIn" :style="loginButton"><text :style="loginText">登录</text></view>
        </view>

        <SectionHeader title="我的工具" />
        <view :style="gridRow">
          <view v-for="(item, idx) in gridItems" :key="item.id" :style="gridCard(idx)" @tap="onManageTap(item.id)">
            <view :style="iconWrap"><AppIcon :name="item.icon" :size="34" :active="true" /></view>
            <view :style="manageCopy"><text :style="manageLabel">{{ item.label }}</text><text :style="manageValue">{{ item.value }}</text></view>
            <AppIcon name="chevron-right" :size="20" />
          </view>
        </view>

        <SectionHeader title="内容互动" />
        <view :style="contentCard" @tap="openMyPosts">
          <view :style="iconWrap"><AppIcon name="camera" :size="34" :active="true" /></view>
          <view :style="outfitAssetCopy"><text :style="outfitAssetTitle">我的动态</text><text :style="outfitAssetValue">{{ library.outfitCount }} 条发布 · {{ library.likedPostCount }} 条点赞</text></view>
          <AppIcon name="chevron-right" :size="28" />
        </view>

        <SectionHeader title="系统设置" />
        <ListGroup>
          <view :style="settingShell(0, 9)" @tap="goPage('/pages/preferences/appearance')"><ListRow icon="moon" title="深色模式" :value="themeLabel" /></view>
          <view :style="settingShell(1, 9)" @tap="goPage('/pages/preferences/index')"><ListRow icon="sparkles" title="推荐偏好" :value="preferenceSummary" /></view>
          <view :style="settingShell(2, 9)" @tap="goPage('/pages/preferences/notification')"><ListRow icon="notification" title="通知设置" /></view>
          <view :style="settingShell(3, 9)" @tap="goPage('/pages/preferences/blacklist')"><ListRow icon="close" title="屏蔽品牌" :value="blacklistCountText" /></view>
          <view :style="settingShell(4, 9)" @tap="onHelpTap"><ListRow icon="help-circle" title="帮助与反馈" /></view>
          <view :style="settingShell(5, 9)" @tap="onClearCacheTap"><ListRow icon="database" title="清理缓存" :value="cacheSizeText" /></view>
          <view :style="settingShell(6, 9)" @tap="goPage('/pages/about/index')"><ListRow icon="info" title="关于三坑绮橱" :value="APP_DISPLAY_VERSION" /></view>
          <view v-if="session.isLoggedIn" :style="settingShell(7, 9)" @tap="logout"><ListRow icon="logout" title="退出登录" /></view>
        </ListGroup>

        <view :style="bottomSpacer" />
      </view>
    </template>
  </MainLayout>
  <AppDialog :visible="showClearCacheDialog" title="清理缓存" message="确认清理本地缓存吗？" @confirm="doClearCache" @cancel="showClearCacheDialog = false" />
</view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue'
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_RADIUS_V3, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, isDark, initPageTheme, getThemeLabel } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import PageHeader from '@/components/v3/PageHeader.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import ListRow from '@/components/v3/ListRow.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import { showFeedback } from '@/utils/feedback'
import { clearableCacheBytes, clearClearableCache } from '@/utils/cache'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { useReminderStore } from '@/stores/reminder-store'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useSessionStore } from '@/stores/session-store'
import { usePreferencesStore } from '@/stores/preferences-store'
import { useBlacklistStore } from '@/stores/blacklist-store'
import { getWindowHeight } from '@/utils/window-info'
import { APP_DISPLAY_VERSION } from '@/config/app-version'

const pageHeight = getWindowHeight()
const library = useContentLibraryStore()
const purchases = usePurchaseStore()
const reminders = useReminderStore()
const wardrobe = useWardrobeStore()
const session = useSessionStore()
const preferences = usePreferencesStore()
const blacklist = useBlacklistStore()
const blacklistCountText = computed((): string => blacklist.count > 0 ? `${blacklist.count} 个` : '')

const preferenceSummary = computed((): string => {
  const values = preferences.preferences.pitTypes
  return values.length == 0 ? '全部' : values.join('、')
})
const themeLabel = computed((): string => getThemeLabel())

function onEdit() { goPage('/pages/profile/edit') }
function loginMock() {
  session.loginMock().then((ok) => {
    if (ok) {
      session.reload()
      library.reload()
      purchases.fetchPurchases()
      reminders.fetchItems()
      wardrobe.fetchItems()
      showFeedback('已切换为本机使用')
    }
    else if (session.errorMessage !== '') showFeedback(session.errorMessage)
  })
}
function loginWechat() {
  session.loginWithWechat().then((ok) => {
    if (ok) { session.reload(); showFeedback('微信登录成功') }
    else showFeedback(session.errorMessage !== '' ? session.errorMessage : '微信登录失败')
  })
}
function openLoginOptions() {
  uni.showActionSheet({
    itemList: ['微信登录', '仅在本机使用'],
    success: (res) => { if (res.tapIndex == 0) loginWechat(); else loginMock() },
  })
}
function logout() { session.logout(); showFeedback('已退出，设备数据仍保留') }
function goPage(url: string) { uni.navigateTo({ url }) }
function openMyPosts() { uni.navigateTo({ url: '/pages/community/mine' }) }
function onManageTap(id: string) {
  if (id === 'wardrobe') goPage('/pages/wardrobe/index')
  if (id === 'favorites') openPrimaryTab('/pages/favorites/index')
  if (id === 'orders') goPage('/pages/purchase/index')
  if (id === 'reminders') goPage('/pages/reminder/index')
  if (id === 'budget') goPage('/pages/budget/index')
}
function onHelpTap() { goPage('/pages/help/index') }
const showClearCacheDialog = ref(false)
const cacheSizeText = ref('')
function formatCacheSize(bytes: number): string {
  if (bytes <= 0) return '0 B'
  if (bytes < 1024) return `${bytes} B`
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`
}
function refreshCacheSize() {
  cacheSizeText.value = formatCacheSize(clearableCacheBytes())
}
function onClearCacheTap() {
  refreshCacheSize()
  showClearCacheDialog.value = true
}
function doClearCache() {
  clearClearableCache()
  showClearCacheDialog.value = false
  refreshCacheSize()
  showFeedback('缓存已清理')
}

onLoad(() => { initPageTheme() })
let lastProfileReloadTs = 0
const PROFILE_RELOAD_TTL_MS = 30 * 1000
function reloadProfileData() {
  const now = Date.now()
  if (now - lastProfileReloadTs < PROFILE_RELOAD_TTL_MS) return
  lastProfileReloadTs = now
  session.reload()
  library.reload()
  library.refreshMyPosts()
  library.refreshRemoteBrands()
  preferences.refreshRemotePreferences()
  purchases.fetchPurchases()
  reminders.fetchItems()
  wardrobe.fetchItems()
}
onShow(() => { initPageTheme(); reloadProfileData(); refreshCacheSize() })

const bottomSpacer = { height: '48rpx' }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }

// V3 §6.6 无外层卡片的紧凑个人头部：头像、昵称、Mock/同步状态、编辑入口
const profileCard = computed((): any => ({ ...flexRow, flexDirection: 'row', alignItems: 'center', paddingTop: '8rpx', paddingBottom: '24rpx', marginBottom: '8rpx' }))
const avatarWrap = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: radius.full, backgroundColor: isDark.value ? n.value.surfaceRaised : brand[100] as string, alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0, position: 'relative', borderWidth: '2rpx', borderStyle: 'solid', borderColor: baseColors.white }))
const avatarText = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[500] as string }
const cameraBadge = { position: 'absolute', bottom: '-2rpx', right: '-2rpx', width: '24rpx', height: '24rpx', borderRadius: '12rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center' }
const guestDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx' }))
const loginButton = computed((): any => ({ minWidth: '120rpx', height: '60rpx', borderRadius: radius.full, backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx' }))
const loginText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: baseColors.white }
const profileCopy = { ...flexFill, justifyContent: 'center' }
const userName = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const userIdText = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '2rpx' }))

class GridItem {
  id: string = ''
  icon: string = ''
  label: string = ''
  value: string = ''
}
function mkItem(id: string, icon: string, label: string, value: string): GridItem {
  const g = new GridItem()
  g.id = id; g.icon = icon; g.label = label; g.value = value
  return g
}
const gridItems = computed(() => [
  mkItem('wardrobe', 'wardrobe', '衣橱', wardrobe.items.length.toString() + ' 件'),
  mkItem('favorites', 'heart', '收藏', library.favoriteCount.toString() + ' 件'),
  mkItem('orders', 'order', '购买记录', purchases.itemCount.toString() + ' 笔'),
  mkItem('reminders', 'reminder', '提醒', reminders.itemCount.toString() + ' 条'),
  mkItem('budget', 'budget', '消费日志', formatAmount(purchases.totalSpent)),
])
function formatAmount(cents: number): string { return cents <= 0 ? '¥0' : '¥' + (cents / 100).toFixed(0) }

const GRID_GAP = '16rpx'
const GRID_WIDTH = '212rpx'
const gridRow = { ...flexRow, flexDirection: 'row', flexWrap: 'wrap' as string }
function gridCard(idx: number) {
  const lastInRow = (idx + 1) % 3 == 0
  return {
    ...flexRow,
    flexDirection: 'row',
    alignItems: 'center',
    width: GRID_WIDTH,
    height: '116rpx',
    flexShrink: 0,
    paddingLeft: '14rpx',
    paddingRight: '10rpx',
    borderRadius: CARD_RADIUS_V3,
    backgroundColor: n.value.surface,
    borderWidth: '1rpx',
    borderStyle: 'solid' as string,
    borderColor: n.value.border,
    marginRight: lastInRow ? '0' : GRID_GAP,
    marginBottom: GRID_GAP,
  }
}
const iconWrap = computed((): any => ({ width: '52rpx', height: '52rpx', borderRadius: '16rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50] as string, alignItems: 'center', justifyContent: 'center', marginRight: '12rpx', flexShrink: 0 }))
const manageCopy = { ...flexFill }
const manageLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const manageValue = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))

const contentCard = computed((): any => ({ ...flexRow, flexDirection: 'row', alignItems: 'center', height: '100rpx', paddingLeft: '20rpx', paddingRight: '18rpx', borderRadius: CARD_RADIUS_V3, backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border, marginBottom: '32rpx' }))
const outfitAssetCopy = { ...flexFill }
const outfitAssetTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const outfitAssetValue = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))

function settingShell(idx: number, total: number) { return { borderBottomWidth: idx < total - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.divider } }
</script>
