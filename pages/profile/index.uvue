<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><V2PageHeader title="我的" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view v-if="session.isLoggedIn" :style="profileCard">
          <view :style="avatarWrap"><text :style="avatarText">SK</text></view>
          <view :style="profileCopy">
            <text :style="userName">{{ session.profile.nickname }}</text>
            <text :style="accountId">ID: {{ session.profile.userId }}</text>
          </view>
          <view :style="editButton" @tap="onEdit"><text :style="editText">编辑</text></view>
        </view>
        <view v-else :style="profileCard" @tap="goLogin">
          <view :style="guestAvatar"><AppIcon name="profile" :size="44" /></view>
          <view :style="profileCopy">
            <text :style="userName">登录三坑绮橱</text>
            <text :style="guestDesc">同步收藏、圈子、衣橱与提醒</text>
          </view>
          <view :style="loginButton"><text :style="loginText">登录</text></view>
        </view>

        <V2SectionHeader title="数据&服务" />
        <view :style="closetCard" @tap="goPage('/pages/wardrobe/index')">
          <view :style="closetCopy">
            <view :style="closetTop"><AppIcon name="wardrobe" :size="44" :active="true" /><text :style="closetLabel">衣橱</text></view>
            <text :style="closetValue">{{ wardrobe.itemCount }} 件心爱单品</text>
            <text :style="closetDesc">JK Lolita 与汉服正在等你搭配</text>
          </view>
          <view :style="closetImage"><AppImage src="/static/demo/prod-editorial-01.jpg" width="100%" height="100%" mode="aspectFill" :lazy-load="true" /></view>
        </view>

        <view :style="manageRow">
          <view v-for="(item, idx) in manageItems" :key="item.id" :style="manageCard(idx)" @tap="onManageTap(item.id)">
            <AppIcon :name="item.icon" :size="40" :active="item.id === 'budget'" />
            <text :style="manageLabel">{{ item.label }}</text>
            <text :style="manageValue">{{ item.value }}</text>
          </view>
        </view>

        <view :style="outfitAssetCard" @tap="openCommunity">
          <view :style="outfitAssetIcon"><AppIcon name="camera" :size="38" :active="true" /></view>
          <view :style="outfitAssetCopy"><text :style="outfitAssetTitle">我的圈子</text><text :style="outfitAssetValue">{{ library.outfitCount }} 条已发布 · {{ library.likedPostCount }} 条已点赞</text></view>
          <AppIcon name="chevron-right" :size="32" />
        </view>

        <V2SectionHeader title="设置" />
        <view :style="chipSection">
          <text :style="chipSectionLabel">主题模式</text>
          <view :style="chipRow">
            <view v-for="mode in themeModes" :key="mode.id" :style="themeChip(mode.id)" @tap="onThemeModeTap(mode.id)">
              <text :style="themeChipText(mode.id)">{{ mode.label }}</text>
            </view>
          </view>
          <text :style="chipSectionLabel">坑向偏好</text>
          <text :style="chipHint">可多选；全不选表示首页展示全部</text>
          <view :style="chipRow">
            <view v-for="pit in pitTypeOptions" :key="pit" :style="pitChip(pit)" @tap="onPitToggle(pit)">
              <text :style="pitChipText(pit)">{{ pit }}</text>
            </view>
          </view>
        </view>
        <V2ListGroup>
          <view v-for="(item, idx) in settingsGroup" :key="item.id" :style="settingShell(idx, settingsGroup.length)" @tap="onSettingTap(item.id)">
            <V2ListRow :icon="item.icon" :label="item.label" :value="item.value" />
          </view>
        </V2ListGroup>

        <V2SectionHeader title="关于" />
        <V2ListGroup>
          <view v-for="(item, idx) in aboutGroup" :key="item.id" :style="settingShell(idx, aboutGroup.length)" @tap="onSettingTap(item.id)">
            <V2ListRow :icon="item.icon" :label="item.label" :value="item.value" />
          </view>
        </V2ListGroup>
      </view>
    </template>
  </MainLayout>
</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, GROUP_GAP, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark, themeMode, initPageTheme, setThemeMode } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import V2PageHeader from '@/components/v2/V2PageHeader.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import V2ListGroup from '@/components/v2/V2ListGroup.uvue'
import V2ListRow from '@/components/v2/V2ListRow.uvue'
import { showFeedback } from '@/utils/feedback'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { useReminderStore } from '@/stores/reminder-store'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useBudgetStore } from '@/stores/budget-store'
import { useSessionStore } from '@/stores/session-store'
import { usePreferencesStore } from '@/stores/preferences-store'
import { useHomeFeedStore } from '@/stores/home-feed-store'
// #ifdef APP
import { getWindowHeight } from '@/utils/window-info'
// #endif

class SettingsItem {
  id: string = ''
  icon: string = ''
  label: string = ''
  value: string = ''
  section: string = ''
}

function createSettingsItem(id: string, icon: string, label: string, value: string, section: string): SettingsItem {
  const item = new SettingsItem()
  item.id = id
  item.icon = icon
  item.label = label
  item.value = value
  item.section = section
  return item
}

const pageHeight = getWindowHeight()
const library = useContentLibraryStore()
const purchases = usePurchaseStore()
const reminders = useReminderStore()
const wardrobe = useWardrobeStore()
const budget = useBudgetStore()
const session = useSessionStore()
const prefs = usePreferencesStore()
const homeFeed = useHomeFeedStore()

// ====== 主题三态 Chip（跟随系统 / 浅色 / 深色，互斥） ======
type ThemeModeOption = {
  id: string
  label: string
}
const themeModes: ThemeModeOption[] = [
  { id: 'system', label: '跟随系统' },
  { id: 'light', label: '浅色' },
  { id: 'dark', label: '深色' },
]
function onThemeModeTap(mode: string) {
  if (mode === 'system') { setThemeMode('system'); return }
  if (mode === 'dark') { setThemeMode('dark'); return }
  setThemeMode('light')
}

// ====== 坑向偏好 Chip（JK / Lolita / 汉服，可多选可全不选） ======
const pitTypeOptions = ['JK', 'Lolita', '汉服']
function isPitSelected(pit: string): boolean {
  const values = prefs.preferences.pitTypes
  for (let i = 0; i < values.length; i++) {
    if (values[i] === pit) return true
  }
  return false
}
function onPitToggle(pit: string) {
  // store 内即时更新 reactive 状态（立即重渲染）并写入 v2_user_preferences
  prefs.togglePitType(pit)
  // 首页下次刷新按最新坑向转换为 API 分类参数重新请求
  homeFeed.refreshPreferences()
}

function onEdit() { showFeedback('功能开发中') }
function goLogin() {
  session.loginWithWechat().then((ok) => {
    if (ok) { session.reload(); showFeedback('登录成功') }
    else if (session.errorMessage !== '') showFeedback(session.errorMessage)
  })
}
function logout() {
  session.logout()
  showFeedback('已退出，设备数据仍保留')
}
function goPage(url: string) { uni.navigateTo({ url }) }
function openCommunity() {
  uni.setStorageSync('community_view', 'mine')
  openPrimaryTab('/pages/community/index')
}
function onManageTap(id: string) {
  if (id === 'favorites') goPage('/pages/wishlist/index')
  if (id === 'orders') goPage('/pages/purchase/index')
  if (id === 'reminders') goPage('/pages/reminder/index')
  if (id === 'budget') goPage('/pages/budget/index')
}
function onSettingTap(id: string) {
  if (id === 'notification') { showFeedback('功能开发中'); return }
  if (id === 'privacy') {
    showFeedback('功能开发中')
    return
  }
  if (id === 'agreement') {
    showFeedback('功能开发中')
    return
  }
  if (id === 'policy') {
    showFeedback('功能开发中')
    return
  }
  if (id === 'about') {
    showFeedback('三坑绮橱 V2.3 后端就绪版')
    return
  }
  if (id === 'cache') {
    try {
      const info = uni.getStorageInfoSync()
      const keys = info.keys
      for (let i = 0; i < keys.length; i++) {
        const key = keys[i]
        // 保留用户偏好和登录状态
        if (key.indexOf('v2_library_') === 0) continue
        if (key.indexOf('v2_user_preferences') === 0) continue
        if (key.indexOf('theme') >= 0) continue
        if (key.indexOf('login') >= 0) continue
        uni.removeStorageSync(key)
      }
    } catch (e) {}
    showFeedback('缓存已清理')
    return
  }
  if (id === 'help') { showFeedback('反馈入口将在账号服务接入后开放'); return }
  if (id === 'logout') { logout(); return }
}

onLoad(() => { initPageTheme() })

// 原生 tabBar 保活后 onPageShow 每次切 Tab 都会触发；30 秒 TTL 去重，避免频繁全量重载
let lastProfileReloadTs = 0
const PROFILE_RELOAD_TTL_MS = 30 * 1000
function reloadProfileData() {
  const now = Date.now()
  if (now - lastProfileReloadTs < PROFILE_RELOAD_TTL_MS) return
  lastProfileReloadTs = now
  session.reload()
  library.reload()
  purchases.fetchPurchases()
  reminders.fetchItems()
  wardrobe.fetchItems()
}
onPageShow(() => { initPageTheme(); reloadProfileData() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const profileCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '160rpx', paddingTop: '28rpx', paddingBottom: '28rpx', paddingLeft: CARD_PADDING, paddingRight: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
const avatarWrap = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: radius.full, backgroundColor: isDark.value ? n.value.surfaceRaised : brand[100], alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0 }))
const avatarText = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[600] }
const guestAvatar = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: radius.full, backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0 }))
const guestDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '8rpx' }))
const loginButton = computed((): any => ({ minWidth: '132rpx', height: '64rpx', borderRadius: radius.full, backgroundColor: isDark.value ? brand[600] : brand[500], alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx' }))
const loginText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: baseColors.white }
const profileCopy = { ...flexFill, justifyContent: 'center' }
const userName = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const accountId = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '4rpx' }))
const editButton = { minWidth: '80rpx', height: '64rpx', alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx', marginRight: '4rpx' }
const editText = { fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: brand[600] }

const closetCard = computed((): any => ({ ...flexRow, alignItems: 'center', height: '208rpx', paddingLeft: CARD_PADDING, borderRadius: CARD_RADIUS, overflow: 'hidden', backgroundColor: isDark.value ? n.value.surfaceWarm : brand[50] }))
const closetCopy = { ...flexFill }
const closetTop = { ...flexRow, alignItems: 'center' }
const closetLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: isDark.value ? brand[300] : brand[700], marginLeft: '12rpx' }))
const closetValue = computed((): any => ({ fontSize: fontSize.lg, fontWeight: fontWeight.bold, color: n.value.text, marginTop: '14rpx' }))
const closetDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '8rpx', lines: 1, textOverflow: 'ellipsis' }))
const closetImage = { width: '196rpx', height: '176rpx', marginRight: '16rpx', borderRadius: '16rpx', overflow: 'hidden', flexShrink: 0 }

class ManageItem {
  id: string = ''
  icon: string = ''
  label: string = ''
  value: string = ''
}

function createManageItem(id: string, icon: string, label: string, value: string): ManageItem {
  const item = new ManageItem()
  item.id = id
  item.icon = icon
  item.label = label
  item.value = value
  return item
}

const manageItems = computed(() => [
  createManageItem('favorites', 'wardrobe', '愿望单', `${library.favoriteCount} 件`),
  createManageItem('orders', 'order', '购买记录', `${purchases.itemCount} 笔`),
  createManageItem('reminders', 'reminder', '提醒', `${reminders.pendingCount} 条待办`),
  createManageItem('budget', 'budget', '预算', budget.isConfigured ? `¥${budget.monthlyLimit}` : '待设置'),
])
const manageRow = { ...flexRow, flexWrap: 'wrap' as string, marginTop: '48rpx' }
function manageCard(idx: number) { return { width: '325rpx', height: '142rpx', flexShrink: 0, padding: '20rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, marginRight: idx % 2 === 0 ? GROUP_GAP : '0', marginBottom: idx < 2 ? GROUP_GAP : '0' } }
const manageLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '12rpx' }))
const manageValue = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '10rpx' }))
const outfitAssetCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '108rpx', paddingLeft: '20rpx', paddingRight: '18rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, marginTop: '4rpx' }))
const outfitAssetIcon = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '18rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50], alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const outfitAssetCopy = { ...flexFill }
const outfitAssetTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const outfitAssetValue = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '6rpx' }))

const settingsItems = computed(() => {
  const items: SettingsItem[] = [
    createSettingsItem('notification', 'notification', '通知设置', '', 'settings'),
    createSettingsItem('privacy', 'info', '隐私与权限', '', 'about'),
    createSettingsItem('agreement', 'info', '用户协议', '', 'about'),
    createSettingsItem('policy', 'info', '隐私政策', '', 'about'),
    createSettingsItem('about', 'info', '关于', 'V2.5', 'about'),
    createSettingsItem('help', 'help-circle', '帮助与反馈', '', 'about'),
    createSettingsItem('cache', 'database', '清理缓存', '', 'about'),
  ]
  if (session.isLoggedIn) items.push(createSettingsItem('logout', 'profile', '退出登录', '', 'about'))
  return items
})
const settingsGroup = computed(() => settingsItems.value.filter((item) => item.section === 'settings'))
const aboutGroup = computed(() => settingsItems.value.filter((item) => item.section === 'about'))
function settingShell(idx: number, total: number) { return { borderBottomWidth: idx < total - 1 ? '1rpx' : '0', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.divider } }

// ====== 主题 / 坑向 Chip 样式（选中=深色底+白字，浅色深色模式均清晰） ======
const chipSection = { marginTop: '4rpx', marginBottom: '8rpx' }
const chipSectionLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '24rpx', marginBottom: '14rpx' }))
const chipHint = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginBottom: '14rpx' }))
const chipRow = { ...flexRow, flexWrap: 'wrap' as string }
function selectedChip(selected: boolean) {
  return {
    minWidth: '150rpx', height: '64rpx', borderRadius: radius.full, paddingLeft: '24rpx', paddingRight: '24rpx',
    alignItems: 'center', justifyContent: 'center', marginRight: '16rpx', marginBottom: '16rpx',
    backgroundColor: selected ? brand[600] : n.value.surface,
    borderWidth: selected ? '0' : '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border,
  }
}
function selectedChipText(selected: boolean) {
  return { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: selected ? baseColors.white : n.value.textSecondary }
}
function themeChip(mode: string) { return selectedChip(themeMode.value === mode) }
function themeChipText(mode: string) { return selectedChipText(themeMode.value === mode) }
function pitChip(pit: string) { return selectedChip(isPitSelected(pit)) }
function pitChipText(pit: string) { return selectedChipText(isPitSelected(pit)) }
</script>
