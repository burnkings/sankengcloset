<template>
  <DetailLayout title="编辑资料">
    <view :style="contentWrap">
      <FormSection title="头像">
        <view :style="avatarRow" @tap="chooseAvatar">
          <view :style="avatarWrap">
            <AppImage v-if="avatarUrl !== ''" :src="avatarUrl" width="100%" height="100%" mode="aspectFill" />
            <text v-else :style="avatarText">{{ session.profile.avatarText }}</text>
          </view>
          <view :style="avatarCopy"><text :style="avatarTitle">{{ avatarUrl === '' ? '设置头像' : '更换头像' }}</text></view>
          <AppIcon name="chevron-right" :size="28" />
        </view>
      </FormSection>
      <FormSection title="昵称">
        <AppInput v-model="nickname" placeholder="请输入昵称" :clearable="true" />
      </FormSection>
      <view :style="bottomSpacer" />
    </view>
    <BottomActionBar>
      <view :style="saveButton" @tap="save"><text :style="saveText">保存资料</text></view>
    </BottomActionBar>
  </DetailLayout>
</template>

<script setup lang="uts">
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import FormSection from '@/components/v3/FormSection.uvue'
import BottomActionBar from '@/components/v3/BottomActionBar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import { useSessionStore } from '@/stores/session-store'
import { PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { baseColors } from '@/theme/tokens/colors'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { n, initPageTheme } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'

const session = useSessionStore()
const nickname = ref('')
const avatarUrl = ref('')
const saving = ref(false)

onLoad(() => {
  initPageTheme()
  session.reload()
  if (!session.isLoggedIn) { showFeedback('请先登录'); uni.navigateBack(); return }
  nickname.value = session.profile.nickname
  avatarUrl.value = session.profile.avatarUrl
  // 进页面时校准一次云端资料（头像可能是别的设备换的）
  session.refreshProfileRemote().then((ok: boolean) => {
    if (ok) avatarUrl.value = session.profile.avatarUrl
  }).catch(() => { /* 离线就继续用本地缓存 */ })
})

function chooseAvatar() {
  if (saving.value) return
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: (res) => {
      if (res.tempFilePaths != null && res.tempFilePaths.length > 0) avatarUrl.value = res.tempFilePaths[0]
    },
  })
}

function save() {
  if (saving.value) return
  if (nickname.value.trim() == '') { showFeedback('昵称不能为空'); return }
  saving.value = true
  uni.showLoading({ title: '保存中' })
  session.saveProfileRemote(nickname.value, avatarUrl.value).then((message: string) => {
    saving.value = false
    uni.hideLoading()
    if (message !== '') { showFeedback(message); return }
    // 保存成功后**留在本页**：用户常接着改昵称/再看看头像效果，
    // 直接把人弹回去会让人以为「保存后没法确认」。
    showFeedback('资料已保存')
  }).catch(() => {
    saving.value = false
    uni.hideLoading()
    showFeedback('保存失败，请重试')
  })
}

const contentWrap = { paddingTop: '24rpx', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const avatarRow = { ...flexRow, alignItems: 'center', minHeight: '112rpx' }
const avatarWrap = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: '48rpx', overflow: 'hidden', backgroundColor: n.value.surfacePink, alignItems: 'center', justifyContent: 'center', marginRight: '20rpx' }))
const avatarText = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.bold, color: n.value.iconActive }))
const avatarCopy = { ...flexFill }
const avatarTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const bottomSpacer = { height: '160rpx' }
const saveButton = computed((): any => ({ flex: 1, height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.iconActive, alignItems: 'center', justifyContent: 'center' }))
const saveText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>
