<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar :title="isEdit ? '编辑购买记录' : '新增购买记录'" :show-back="true"></AppNavbar></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <text :style="fieldLabel">商品</text>
        <AppInput v-model="form.name" placeholder="商品名称" :clearable="true" />
        <view :style="twoColumnRow">
          <view :style="halfField"><text :style="fieldLabelCompact">品牌</text><AppInput v-model="form.brand" placeholder="品牌" /></view>
          <view :style="halfFieldLast"><text :style="fieldLabelCompact">官方渠道</text><AppInput v-model="form.shopName" placeholder="店铺或渠道" /></view>
        </view>

        <text :style="fieldLabel">坑向</text>
        <V2FilterChips :items="categoryLabels" :active="activeCategoryLabel" @change="onCategoryChange" />

        <text :style="fieldLabel">付款状态</text>
        <V2FilterChips :items="statusLabels" :active="activeStatusLabel" @change="onStatusChange" />

        <view :style="amountCard">
          <view :style="amountColumn"><text :style="amountLabel">总金额</text><AppInput v-model="form.totalAmountStr" placeholder="0" type="digit" /></view>
          <view :style="amountColumn"><text :style="amountLabel">定金</text><AppInput v-model="form.depositAmountStr" placeholder="0" type="digit" /></view>
          <view :style="amountColumnLast"><text :style="amountLabel">已支付</text><AppInput v-model="form.paidAmountStr" placeholder="0" type="digit" /></view>
        </view>

        <view :style="twoColumnRow">
          <view :style="halfField"><text :style="fieldLabelCompact">购买日期</text><AppInput v-model="form.purchaseDate" placeholder="2026-07-17" /></view>
          <view :style="halfFieldLast"><text :style="fieldLabelCompact">尾款/截止日期</text><AppInput v-model="form.deadline" placeholder="2026-08-01" /></view>
        </view>

        <text :style="fieldLabel">备注</text>
        <view :style="noteShell"><textarea :value="form.note" placeholder="记录定金、尾款或订单说明" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" /></view>
        <view :style="boundaryCard"><AppIcon name="order" :size="34" :active="true" /><text :style="boundaryText">这里只管理消费进度；支付、售后与物流仍由官方渠道负责</text></view>
      </view>
    </template>
  </MainLayout>
  <view :style="purchaseBottomBar">
    <view :style="purchaseSaveButton" @tap="save"><text :style="purchaseSaveText">{{ isEdit ? '保存修改' : '保存记录' }}</text></view>
  </view>
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { PurchaseRecord } from '@/domain/purchase-record'
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, PAGE_HEADER_CONTENT_GAP } from '@/theme/tokens/responsive'
import { n, isDark } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2FilterChips from '@/components/v2/V2FilterChips.uvue'

const store = usePurchaseStore()
const isEdit = ref(false)
const editId = ref('')
const form = ref({ name: '', brand: '', shopName: '', category: 'JK', totalAmountStr: '', depositAmountStr: '', paidAmountStr: '', paymentStatus: 'PRE_ORDER', purchaseDate: '', deadline: '', note: '' })
const categoryLabels = ['JK', 'Lolita', '汉服', '其他']
const statusLabels = ['预售中', '已付定金', '待付款', '已完成', '已取消']
const activeCategoryLabel = computed((): string => form.value.category === 'LOLITA' ? 'Lolita' : (form.value.category === 'HANFU' ? '汉服' : (form.value.category === 'OTHER' ? '其他' : 'JK')))
const activeStatusLabel = computed((): string => form.value.paymentStatus === 'DEPOSIT_PAID' ? '已付定金' : (form.value.paymentStatus === 'BALANCE_PENDING' ? '待付款' : (form.value.paymentStatus === 'COMPLETED' ? '已完成' : (form.value.paymentStatus === 'CANCELLED' ? '已取消' : '预售中'))))

function onCategoryChange(label: string) { form.value.category = label === 'Lolita' ? 'LOLITA' : (label === '汉服' ? 'HANFU' : (label === '其他' ? 'OTHER' : 'JK')) }
function onStatusChange(label: string) { form.value.paymentStatus = label === '已付定金' ? 'DEPOSIT_PAID' : (label === '待付款' ? 'BALANCE_PENDING' : (label === '已完成' ? 'COMPLETED' : (label === '已取消' ? 'CANCELLED' : 'PRE_ORDER'))) }
function onNoteInput(e: any) { form.value.note = (e.detail as any).value ?? '' }
function safeParam(value: any): string {
  const text = value == null ? '' : String(value)
  try { return text.indexOf('%') >= 0 ? decodeURIComponent(text) : text } catch (e) { return text }
}
function numberValue(value: string): number { return value.trim() === '' ? 0 : parseFloat(value) }

function save() {
  if (form.value.name.trim() === '') { showFeedback('请填写商品名称'); return }
  const total = numberValue(form.value.totalAmountStr)
  const deposit = numberValue(form.value.depositAmountStr)
  const paid = numberValue(form.value.paidAmountStr)
  if (isNaN(total) || isNaN(deposit) || isNaN(paid)) { showFeedback('请填写正确的金额'); return }
  if (total < 0 || deposit < 0 || paid < 0) { showFeedback('金额不能小于 0'); return }
  if (paid > total && total > 0) { showFeedback('已支付金额不能大于总金额'); return }
  if (isEdit.value) {
    const ok = store.updatePurchase(editId.value, {
      name: form.value.name.trim(), brand: form.value.brand.trim(), shopName: form.value.shopName.trim(), category: form.value.category,
      totalAmount: total, depositAmount: deposit, paidAmount: paid, paymentStatus: form.value.paymentStatus,
      purchaseDate: form.value.purchaseDate.trim(), deadline: form.value.deadline.trim(), note: form.value.note.trim(),
    })
    if (!ok) { showFeedback('保存失败，请重试'); return }
  } else {
    const record = new PurchaseRecord()
    record.name = form.value.name.trim()
    record.brand = form.value.brand.trim()
    record.shopName = form.value.shopName.trim()
    record.category = form.value.category
    record.totalAmount = total
    record.depositAmount = deposit
    record.paidAmount = paid
    record.paymentStatus = form.value.paymentStatus
    record.purchaseDate = form.value.purchaseDate.trim()
    record.deadline = form.value.deadline.trim()
    record.note = form.value.note.trim()
    if (store.addPurchase(record) === null) { showFeedback('保存失败，请重试'); return }
  }
  showFeedback(isEdit.value ? '购买记录已更新' : '已加入购买记录')
  setTimeout(() => { uni.navigateBack() }, 260)
}

onMounted(() => {
  store.fetchPurchases()
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const options = (currentPage as any).options ?? {}
  const id = safeParam(options.id)
  if (id !== '') {
    editId.value = id
    isEdit.value = true
    const record = store.getPurchaseById(id)
    if (record != null) {
      form.value.name = record.name; form.value.brand = record.brand; form.value.shopName = record.shopName; form.value.category = record.category
      form.value.totalAmountStr = record.totalAmount > 0 ? String(record.totalAmount) : ''
      form.value.depositAmountStr = record.depositAmount > 0 ? String(record.depositAmount) : ''
      form.value.paidAmountStr = record.paidAmount > 0 ? String(record.paidAmount) : ''
      form.value.paymentStatus = record.paymentStatus; form.value.purchaseDate = record.purchaseDate; form.value.deadline = record.deadline; form.value.note = record.note
    }
    return
  }
  form.value.name = safeParam(options.name)
  form.value.brand = safeParam(options.brand)
  form.value.totalAmountStr = safeParam(options.amount)
  form.value.category = safeParam(options.category) !== '' ? safeParam(options.category) : 'JK'
  form.value.deadline = safeParam(options.deadline)
  const now = new Date()
  form.value.purchaseDate = now.toISOString().substring(0, 10)
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: '180rpx' }
const saveText = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: brand[600] }
const purchaseSafeBottom = getSafeBottomInset()
const purchaseBottomBar = computed((): any => ({ position: 'fixed' as string, left: '0', right: '0', bottom: '0', zIndex: 100, paddingTop: '20rpx', paddingLeft: '40rpx', paddingRight: '40rpx', paddingBottom: `${purchaseSafeBottom + 12}px`, backgroundColor: n.value.bg, borderTopWidth: '1rpx', borderTopStyle: 'solid' as string, borderTopColor: n.value.divider }))
const purchaseSaveButton = computed((): any => ({ width: '100%', height: '88rpx', borderRadius: '44rpx', backgroundColor: brand[600], alignItems: 'center' as string, justifyContent: 'center' as string }))
const purchaseSaveText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: '#FFFFFF' }
const fieldLabel = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '30rpx', marginBottom: '14rpx' }))
const fieldLabelCompact = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, marginBottom: '14rpx' }))
const twoColumnRow = { ...flexRow, marginTop: '30rpx' }
const halfField = { width: '327rpx', marginRight: '16rpx' }
const halfFieldLast = { ...flexFill }
const amountCard = computed((): any => ({ ...flexRow, padding: '18rpx', borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, marginTop: '30rpx' }))
const amountColumn = { width: '198rpx', marginRight: '12rpx' }
const amountColumnLast = { ...flexFill }
const amountLabel = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginBottom: '10rpx' }))
const noteShell = computed((): any => ({ minHeight: '190rpx', padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.bgTertiary }))
const noteInput = computed((): any => ({ width: '100%', minHeight: '150rpx', fontSize: fontSize.sm, color: n.value.text, lineHeight: '40rpx' }))
const placeholderStyle = computed((): string => `color:${n.value.placeholder}`)
const boundaryCard = computed((): any => ({ ...flexRow, alignItems: 'center', padding: '20rpx', borderRadius: CARD_RADIUS, backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50], marginTop: '24rpx' }))
const boundaryText = computed((): any => ({ ...flexFill, fontSize: fontSize.xs, color: n.value.textSecondary, lineHeight: '34rpx', marginLeft: '12rpx' }))
</script>

<style>.page-canvas { padding-left: 40rpx; padding-right: 40rpx; }</style>
