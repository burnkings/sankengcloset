<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar :title="isEdit ? '编辑购买记录' : '新增购买记录'" :show-back="true"></AppNavbar></template>
    <template #default>
      <scroll-view :style="scrollStyle">
        <view class="page-canvas" :style="pageWrap">
          <view v-if="isAiDraft" :style="aiDraftBanner"><text :style="aiDraftText">这是订单识别草稿：请核对每个金额、日期和商品信息后再保存。</text></view>

          <V2FormSection title="基本信息">
            <text :style="fieldLabel">商品名称</text>
            <AppInput v-model="form.name" placeholder="商品名称" :clearable="true" />

            <text :style="fieldLabel">品牌</text>
            <AppInput v-model="form.brand" placeholder="输入品牌名" :clearable="true" @input="onBrandInput" />
            <view v-if="brandSuggestions.length > 0" :style="brandDropdown">
              <view v-for="b in brandSuggestions" :key="b" :style="brandItem" @tap="selectBrand(b)">
                <text :style="brandItemText">{{ b }}</text>
              </view>
            </view>

            <text :style="fieldLabel">店铺 / 团长</text>
            <AppInput v-model="form.shopName" placeholder="可选，便于回看订单来源" :clearable="true" />

            <text :style="fieldLabel">坑向</text>
            <V2Segmented :items="categoryLabels" :active="activeCategoryLabel" variant="solid" @change="onCategoryChange" />

            <text :style="fieldLabel">付款状态</text>
            <scroll-view direction="horizontal" :show-scrollbar="false" :style="statusScroll">
              <V2Segmented :items="statusLabels" :active="activeStatusLabel" variant="solid" @change="onStatusChange" />
            </scroll-view>

            <view :style="amountCard">
              <view :style="amountColumn"><AppInput v-model="form.totalAmountStr" placeholder="总金额" type="digit" /></view>
              <view :style="amountColumn"><AppInput v-model="form.depositAmountStr" placeholder="定金" type="digit" /></view>
              <view :style="amountColumnLast"><AppInput v-model="form.paidAmountStr" placeholder="已支付" type="digit" /></view>
            </view>

            <view :style="twoColumnRow">
              <view :style="halfField">
                <V2DatePicker label="" :value="form.purchaseDate" placeholder="购买日期" mode="date" @change="onPurchaseDatePick" />
              </view>
              <view :style="halfFieldLast">
                <V2DatePicker label="" :value="form.deadline" placeholder="尾款截止日" mode="date" @change="onDeadlinePick" />
              </view>
            </view>
            <view :style="twoColumnRow">
              <view :style="halfField"><V2DatePicker label="" :value="form.arrivalDate" placeholder="预计到货日（可选）" mode="date" @change="onArrivalDatePick" /></view>
              <view :style="halfFieldLast"><text :style="fieldHint">保存后会自动维护尾款和到货提醒</text></view>
            </view>
          </V2FormSection>

          <V2FormSection title="补充">
            <view :style="noteShell"><textarea :value="form.note" placeholder="尺码、尾款时间等信息" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" /></view>
          </V2FormSection>

          <view :style="bottomSpacer" />
        </view>
      </scroll-view>

      <view :style="bottomBar">
        <view :style="saveButtonStyle" @tap="save">
          <text :style="saveBtnText">{{ saving ? '保存中…' : (isEdit ? '保存修改' : '保存记录') }}</text>
        </view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { PurchaseRecord, PurchaseUpdateData } from '@/domain/purchase-record'
import { confirmPurchaseImport } from '@/services/ai/purchase-import-service'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import V2Segmented from '@/components/v2/V2Segmented.uvue'
import V2FormSection from '@/components/v2/V2FormSection.uvue'
import V2DatePicker from '@/components/v2/V2DatePicker.uvue'

const store = usePurchaseStore()
const isEdit = ref(false)
const editId = ref('')
// 保存防重复：确认/入库期间锁住按钮，防止连点产生重复订单
const saving = ref(false)
type FormState = {
  name: string
  brand: string
  shopName: string
  category: string
  totalAmountStr: string
  depositAmountStr: string
  paidAmountStr: string
  paymentStatus: string
  purchaseDate: string
  deadline: string
  arrivalDate: string
  note: string
}
const form = ref<FormState>({ name: '', brand: '', shopName: '', category: 'JK', totalAmountStr: '', depositAmountStr: '', paidAmountStr: '', paymentStatus: 'PRE_ORDER', purchaseDate: '', deadline: '', arrivalDate: '', note: '' })
const sourceWishId = ref('')
const sourceImportTaskId = ref('')
const isAiDraft = ref(false)

const brandSuggestions = ref<string[]>([])
function onBrandInput(e: any) {
  const val = e.detail != null ? e.detail.value as string : ''
  form.value.brand = val
  if (val.trim() === '') { brandSuggestions.value = []; return }
  const kw = val.trim().toLowerCase()
  brandSuggestions.value = store.brands.filter((b) => b.toLowerCase().includes(kw)).slice(0, 6)
}
function selectBrand(b: string) {
  form.value.brand = b
  brandSuggestions.value = []
}

const categoryLabels = ['JK', 'Lolita', '汉服', '其他']
const statusLabels = ['预售中', '已付定金', '待付款', '已完成', '已取消']
const activeCategoryLabel = computed((): string => form.value.category === 'LOLITA' ? 'Lolita' : (form.value.category === 'HANFU' ? '汉服' : (form.value.category === 'OTHER' ? '其他' : 'JK')))
const activeStatusLabel = computed((): string => form.value.paymentStatus === 'DEPOSIT_PAID' ? '已付定金' : (form.value.paymentStatus === 'BALANCE_PENDING' ? '待付款' : (form.value.paymentStatus === 'COMPLETED' ? '已完成' : (form.value.paymentStatus === 'CANCELLED' ? '已取消' : '预售中'))))

function onCategoryChange(label: string) { form.value.category = label === 'Lolita' ? 'LOLITA' : (label === '汉服' ? 'HANFU' : (label === '其他' ? 'OTHER' : 'JK')) }
function onStatusChange(label: string) {
  form.value.paymentStatus = label === '已付定金' ? 'DEPOSIT_PAID' : (label === '待付款' ? 'BALANCE_PENDING' : (label === '已完成' ? 'COMPLETED' : (label === '已取消' ? 'CANCELLED' : 'PRE_ORDER')))
}
function onNoteInput(e: any) {
  const val = e.detail != null ? e.detail.value as string : ''
  form.value.note = val
}
function onPurchaseDatePick(value: string) { form.value.purchaseDate = value }
function onDeadlinePick(value: string) { form.value.deadline = value }
function onArrivalDatePick(value: string) { form.value.arrivalDate = value }

function save() {
  if (saving.value) return
  if (form.value.name.trim() === '') { showFeedback('请填写商品名称'); return }
  // 金额输入一律按「元」解析，入库统一转为「分」；展示层再转回元
  const total = parseFloat(form.value.totalAmountStr)
  const deposit = parseFloat(form.value.depositAmountStr)
  const paid = parseFloat(form.value.paidAmountStr)
  saving.value = true
  if (isEdit.value) {
    const data = new PurchaseUpdateData()
    data.name = form.value.name.trim()
    data.brand = form.value.brand.trim()
    data.shopName = form.value.shopName.trim()
    data.category = form.value.category
    data.paymentStatus = form.value.paymentStatus
    data.totalAmount = total > 0 ? Math.round(total * 100) : 0
    data.depositAmount = deposit > 0 ? Math.round(deposit * 100) : 0
    data.paidAmount = paid > 0 ? Math.round(paid * 100) : 0
    data.purchaseDate = form.value.purchaseDate.trim()
    data.deadline = form.value.deadline.trim()
    data.arrivalDate = form.value.arrivalDate.trim()
    data.note = form.value.note.trim()
    if (!store.updatePurchase(editId.value, data)) { saving.value = false; showFeedback('保存失败，请重试'); return }
  } else {
    const record = new PurchaseRecord()
    record.name = form.value.name.trim()
    record.brand = form.value.brand.trim()
    record.shopName = form.value.shopName.trim()
    record.category = form.value.category
    record.paymentStatus = form.value.paymentStatus
    record.totalAmount = total > 0 ? Math.round(total * 100) : 0
    record.depositAmount = deposit > 0 ? Math.round(deposit * 100) : 0
    record.paidAmount = paid > 0 ? Math.round(paid * 100) : 0
    record.purchaseDate = form.value.purchaseDate.trim()
    record.deadline = form.value.deadline.trim()
    record.arrivalDate = form.value.arrivalDate.trim()
    record.wishId = sourceWishId.value
    record.note = form.value.note.trim()
    const added = store.addPurchase(record)
    if (added === null) { saving.value = false; showFeedback('保存失败，请重试'); return }
    if (sourceImportTaskId.value !== '') {
      confirmPurchaseImport(sourceImportTaskId.value, added.id, added as UTSJSONObject).catch(() => {
        // 订单本身已保存；确认回执会由服务端任务保留待下次重试，不影响用户记录。
      })
    }
  }
  showFeedback(isEdit.value ? '修改已保存' : '添加成功')
  setTimeout(() => { uni.navigateBack() }, 300)
}

onLoad((options) => {
  store.fetchPurchases()
  if (options != null) {
    const id = options['id'] != null ? options['id'] as string : ''
    if (id !== '') {
      editId.value = id; isEdit.value = true
      const record = store.getPurchaseById(id)
      if (record != null) {
        form.value.name = record.name
        form.value.brand = record.brand
        form.value.shopName = record.shopName
        form.value.category = record.category
        form.value.paymentStatus = record.paymentStatus
        form.value.totalAmountStr = yuanText(record.totalAmount)
        form.value.depositAmountStr = yuanText(record.depositAmount)
        form.value.paidAmountStr = yuanText(record.paidAmount)
        form.value.purchaseDate = record.purchaseDate
        form.value.deadline = record.deadline
        form.value.arrivalDate = record.arrivalDate
        form.value.note = record.note
      }
      return
    }
    form.value.name = options['name'] != null ? safeParam(options['name'] as string) : ''
    form.value.brand = options['brand'] != null ? safeParam(options['brand'] as string) : ''
    form.value.shopName = options['shopName'] != null ? safeParam(options['shopName'] as string) : ''
    form.value.category = options['category'] != null ? (options['category'] as string) : 'JK'
    sourceWishId.value = options['wishId'] != null ? options['wishId'] as string : ''
    sourceImportTaskId.value = options['importTaskId'] != null ? safeParam(options['importTaskId'] as string) : ''
    isAiDraft.value = options['fromAiImport'] != null && (options['fromAiImport'] as string) === '1'
    form.value.totalAmountStr = options['amount'] != null ? safeParam(options['amount'] as string) : ''
    form.value.depositAmountStr = options['deposit'] != null ? safeParam(options['deposit'] as string) : ''
    form.value.paidAmountStr = options['paid'] != null ? safeParam(options['paid'] as string) : ''
    form.value.purchaseDate = options['purchaseDate'] != null ? safeParam(options['purchaseDate'] as string) : ''
    form.value.deadline = options['deadline'] != null ? safeParam(options['deadline'] as string) : ''
    form.value.arrivalDate = options['arrivalDate'] != null ? safeParam(options['arrivalDate'] as string) : ''
    form.value.note = options['note'] != null ? safeParam(options['note'] as string) : ''
    const paid = parseFloat(form.value.paidAmountStr)
    const total = parseFloat(form.value.totalAmountStr)
    if (total > 0 && paid >= total) form.value.paymentStatus = 'COMPLETED'
    else if (paid > 0) form.value.paymentStatus = 'DEPOSIT_PAID'
  }
})
function safeParam(value: string): string { try { return value.indexOf('%') >= 0 ? (decodeURIComponent(value) ?? value) : value } catch (e) { return value } }

/** 分 → 元展示（编辑表单回填用；输入仍按元解析，保存时 ×100 转分） */
function yuanText(cents: number): string {
  if (cents <= 0) return ''
  const yuan = cents / 100
  return yuan == Math.floor(yuan) ? yuan.toString() : yuan.toFixed(2)
}

const safeBottom = getSafeBottomInset()
const scrollStyle = { flex: 1 }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR, paddingBottom: '160rpx' }
const bottomSpacer = { height: '40rpx' }
const fieldLabel = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '24rpx', marginBottom: '14rpx' }))
const aiDraftBanner = computed((): any => ({ padding: '20rpx', borderRadius: '18rpx', backgroundColor: n.value.surfacePink, marginBottom: '20rpx' }))
const aiDraftText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, lineHeight: '36rpx' }))
const statusScroll = { marginBottom: '0' }
const amountCard = { flexDirection: 'row', marginTop: '24rpx' }
const amountColumn = { flex: 1, marginRight: '12rpx' }
const amountColumnLast = { flex: 1 }
const twoColumnRow = { flexDirection: 'row', marginTop: '12rpx' }
const halfField = { flex: 1, marginRight: '12rpx' }
const halfFieldLast = { flex: 1 }
const fieldHint = computed((): any => ({ fontSize: '22rpx', color: n.value.textTertiary, lineHeight: '34rpx', paddingTop: '12rpx' }))

const brandDropdown = computed((): any => ({
  borderRadius: '24rpx', backgroundColor: n.value.surface, overflow: 'hidden',
  borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.cardBorder,
  marginTop: '8rpx', marginBottom: '8rpx',
}))
const brandItem = computed((): any => ({
  height: '80rpx', paddingLeft: '28rpx', justifyContent: 'center',
  borderBottomWidth: '1rpx', borderBottomStyle: 'solid', borderBottomColor: n.value.divider,
}))
const brandItemText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text }))

const noteShell = computed((): any => ({ minHeight: '160rpx', padding: CARD_PADDING, borderRadius: '24rpx', backgroundColor: n.value.inputFill }))
const noteInput = computed((): any => ({ width: '100%', minHeight: '120rpx', fontSize: '28rpx', color: n.value.text, lineHeight: '40rpx' }))
const placeholderStyle = computed((): string => `color:${n.value.placeholder}`)

const bottomBar = computed((): any => ({ position: 'fixed', bottom: '0', left: '0', right: '0', flexDirection: 'row', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR, paddingBottom: `${safeBottom + 20}px`, paddingTop: '16rpx', backgroundColor: n.value.surface }))
const saveButtonStyle = computed((): any => ({ flex: 1 as const, height: '88rpx', borderRadius: '24rpx', backgroundColor: saving.value ? brand[300] as string : brand[500] as string, alignItems: 'center' as string, justifyContent: 'center' as string }))
const saveBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.medium, color: baseColors.white }
</script>
