<template>
  <DetailLayout title="订单详情">
    <template #right>
      <text :style="deleteBtnStyle" @tap="onDeleteTap">删除</text>
      <text :style="editBtnStyle" @tap="onEditTap">编辑</text>
    </template>

    <!-- 未找到 -->
    <view v-if="!item" :style="notFoundStyle">
      <text :style="notFoundText">记录不存在</text>
    </view>

    <!-- 详情内容 -->
    <view v-else :style="contentStyle">

      <!-- 名称 + 状态 -->
      <view :style="sectionGap" />
      <AppCard border-type="border">
        <view :style="nameRowStyle">
          <text :style="nameTextStyle">{{ item!.name }}</text>
          <StatusChip :label="item!.statusText" :status="statusClass(item!.statusText)" size="sm" />
        </view>
        <text v-if="item!.brand !== '' || item!.shopName !== ''" :style="shopTextStyle">
          {{ item!.brand !== '' && item!.shopName !== '' ? item!.brand + ' · ' + item!.shopName : (item!.brand !== '' ? item!.brand : item!.shopName) }}
        </text>
      </AppCard>

      <!-- 金额卡片 -->
      <view :style="sectionGap" />
      <AppCard border-type="border">
        <template #header>
          <text :style="sectionTitleStyle">金额信息</text>
        </template>

        <view :style="amountGridStyle">
          <view :style="amountItemStyle">
            <text :style="amountLabelStyle">总金额</text>
            <text :style="amountValueStyle">{{ item!.totalText }}</text>
          </view>
          <view v-if="item!.depositText" :style="amountItemStyle">
            <text :style="amountLabelStyle">定金</text>
            <text :style="amountValueSmallStyle">{{ item!.depositText }}</text>
          </view>
          <view :style="amountItemStyle">
            <text :style="amountLabelStyle">已付</text>
            <text :style="amountValuePaidStyle">{{ item!.paidText }}</text>
          </view>
          <view :style="amountItemStyle">
            <text :style="amountLabelStyle">状态</text>
            <text :style="amountValueRemainingStyle">{{ item!.remainingText }}</text>
          </view>
        </view>

        <!-- 进度条 -->
        <view :style="progressSectionStyle">
          <view :style="progressTrackStyle">
            <view :style="progressFillStyle" />
          </view>
          <text :style="progressLabelStyle">付款进度 {{ item!.progressPercent }}%</text>
        </view>
      </AppCard>

      <!-- 详情信息 -->
      <view :style="sectionGap" />
      <AppCard border-type="border">
        <template #header>
          <text :style="sectionTitleStyle">详细信息</text>
        </template>

        <view :style="infoListStyle">
          <view v-if="item!.category" :style="infoRowStyle">
            <text :style="infoLabelStyle">分类</text>
            <text :style="infoValueStyle">{{ item!.category }}</text>
          </view>
          <view :style="infoRowStyle">
            <text :style="infoLabelStyle">购买日期</text>
            <text :style="infoValueStyle">{{ item!.purchaseDateText }}</text>
          </view>
          <view v-if="item!.deadlineText !== '—'" :style="infoRowStyle">
            <text :style="infoLabelStyle">截止日期</text>
            <text :style="deadlineValueStyle">{{ item!.deadlineLabel }}</text>
          </view>
          <view v-if="item!.arrivalDateText !== '—'" :style="infoRowStyle">
            <text :style="infoLabelStyle">预计到货</text>
            <text :style="infoValueStyle">{{ item!.arrivalDateText }}</text>
          </view>
          <view v-if="item!.isOverdue" :style="overdueBannerStyle">
            <text :style="overdueTextStyle">已逾期</text>
          </view>
        </view>
      </AppCard>

      <view :style="actionSection">
        <view v-if="record.value != null && record.value.productId !== ''" :style="actionBtnSecondary" @tap="onViewProduct">
          <text :style="actionBtnSecondaryText">查看来源商品</text>
        </view>
        <view v-if="canSetBalanceReminder(record)" :style="actionBtn" @tap="onSetReminder">
          <text :style="actionBtnText">设置尾款提醒</text>
        </view>
        <view v-if="record.value != null && record.value.wardrobeId !== ''" :style="actionBtnSecondary" @tap="onViewWardrobeItem">
          <text :style="actionBtnSecondaryText">查看入橱单品</text>
        </view>
        <view v-else-if="item!.statusText === '已完成'" :style="actionBtnSecondary" @tap="onAddToWardrobe">
          <text :style="actionBtnSecondaryText">收纳至衣橱</text>
        </view>
      </view>

      <!-- 备注 -->
      <view :style="sectionGap" />
      <AppCard v-if="item!.note" border-type="border">
        <template #header>
          <text :style="sectionTitleStyle">备注</text>
        </template>
        <text :style="noteTextStyle">{{ item!.note }}</text>
      </AppCard>
    </view>
  </DetailLayout>

  <!-- 删除确认 -->
  <AppDialog
    v-model:visible="deleteDialogVisible"
    title="确认删除"
    message="删除后无法恢复，确定要删除这条消费记录吗？"
    @confirm="onConfirmDelete"
  />
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { PurchaseRecord } from '@/domain/purchase-record'
import { toDisplayModel, PurchaseDisplayModel } from '@/domain/purchase-presenter'
import { brand, semantic } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { semanticRadius } from '@/theme/tokens/radius'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexRowBetween, flexCenter, flexColumnCenter, flexFill } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import { canSetBalanceReminder, balanceReminderUrl } from '@/utils/purchase-reminder'
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import AppCard from '@/components/base/AppCard.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import StatusChip from '@/components/v3/StatusChip.uvue'


const store = usePurchaseStore()
const deleteDialogVisible = ref(false)

// 获取路由参数 id
const itemId = ref('')

// 展示模型
const record = computed((): PurchaseRecord | null => {
  if (!itemId.value) return null
  return store.getPurchaseById(itemId.value)
})
const item = computed((): PurchaseDisplayModel | null => record.value == null ? null : toDisplayModel(record.value))

function statusClass(s: string): string {
  if (s === '已完成') return 'positive'
  if (s === '已取消') return 'neutral'
  if (s === '已逾期') return 'error'
  return 'pending'
}

function onDeleteTap() {
  deleteDialogVisible.value = true
}

function onEditTap() {
  uni.navigateTo({ url: `/pages/purchase/edit?id=${itemId.value}` })
}
function onSetReminder() {
  if (!canSetBalanceReminder(record.value)) return
  uni.navigateTo({ url: balanceReminderUrl(record.value!) })
}
function onAddToWardrobe() {
  if (item.value == null || record.value == null) return
  const name = encodeURIComponent(item.value!.name)
  const source = record.value
  // 订单金额单位为分，衣橱编辑页按元接收
  const priceYuan = source.totalAmount > 0 ? (source.totalAmount / 100).toString() : ''
  uni.navigateTo({ url: `/pages/wardrobe/edit?name=${name}&brand=${encodeURIComponent(item.value!.brand)}&category=${encodeURIComponent(source.category)}&price=${priceYuan}&purchaseDate=${encodeURIComponent(source.purchaseDate)}&purchaseId=${source.id}&wishId=${source.wishId}` })
}
function onViewWardrobeItem() {
  const id = record.value != null ? record.value.wardrobeId : ''
  if (id !== '') uni.navigateTo({ url: `/pages/wardrobe/edit?id=${id}` })
}
function onViewProduct() {
  if (record.value == null || record.value!.productId == '') return
  const release = record.value!.releaseId != '' ? '&releaseId=' + encodeURIComponent(record.value!.releaseId) : ''
  uni.navigateTo({ url: '/pages/product/detail?id=' + encodeURIComponent(record.value!.productId) + release })
}

function onConfirmDelete() {
  if (itemId.value) {
    store.deletePurchase(itemId.value)
    uni.navigateBack()
  }
}

// 页面加载时获取路由参数
onLoad((options) => {
  const id = options != null && options['id'] != null ? options['id'] as string : ''
  itemId.value = id
})

// ====== 样式 ======

const deleteBtnStyle = {
  fontSize: fontSize.sm,
  color: semantic.error,
  paddingHorizontal: spacing[2] }

const editBtnStyle = {
  fontSize: fontSize.sm,
  color: brand[500],
  paddingHorizontal: spacing[2],
  marginLeft: spacing[2] }

const notFoundStyle = {
  ...flexCenter,
  padding: spacing[8] }

const notFoundText = computed((): any => ({
  fontSize: fontSize.lg,
  color: n.value.textTertiary }))

const contentStyle = {
  padding: `${spacing[3] as string} ${spacing[4] as string}` }

const nameRowStyle = {
  ...flexRowBetween,
  alignItems: 'center' as string }

const nameTextStyle = computed((): any => ({
  fontSize: fontSize.xl,
  fontWeight: fontWeight.bold,
  color: n.value.text,
  ...flexFill,
  marginRight: spacing[2] }))

const statusTagStyle = computed((): any => ({
  paddingHorizontal: spacing[3],
  paddingVertical: spacing[1],
  borderRadius: radius.full,
  backgroundColor: n.value.surfacePink,
  flexShrink: 0 }))

const statusTagText = computed((): any => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.medium,
  color: item.value ? item.value.statusColor : n.value.textSecondary }))

const shopTextStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
  marginTop: spacing[1] }))

const sectionTitleStyle = computed((): any => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.semibold,
  color: n.value.textSecondary }))

const amountGridStyle = {
  ...flexRow,
  flexWrap: 'wrap' as string }

const amountItemStyle = {
  width: '45%',
  marginRight: spacing[2],
  marginBottom: spacing[2] }

const amountLabelStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary }))

const amountValueStyle = computed((): any => ({
  fontSize: fontSize['2xl'],
  fontWeight: fontWeight.bold,
  color: n.value.text }))

const amountValueSmallStyle = computed((): any => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.medium,
  color: n.value.text }))

const amountValuePaidStyle = computed((): any => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.medium,
  color: semantic.success }))

const amountValueRemainingStyle = computed((): any => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.medium,
  color: item.value && item.value.remainingText !== '已结清' ? semantic.error : semantic.success }))

const progressSectionStyle = {
  marginTop: spacing[3] }

const progressTrackStyle = computed((): any => ({
  height: '10rpx',
  borderRadius: radius.full,
  backgroundColor: n.value.bgTertiary,
  overflow: 'hidden' as string }))

const progressFillStyle = computed((): any => ({
  width: item.value ? `${item.value.progressPercent}%` : '0%',
  height: '100%',
  borderRadius: radius.full,
  backgroundColor: item.value ? item.value.statusColor : '' }))

const progressLabelStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  textAlign: 'right' as string }))

 const infoListStyle = {
   marginTop: spacing[1] }

const infoRowStyle = {
  ...flexRowBetween,
  alignItems: 'center' as string,
  paddingVertical: spacing[1] }

const infoLabelStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textTertiary }))

const infoValueStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.text }))

const deadlineValueStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: item.value && item.value.isOverdue ? semantic.error : n.value.text,
  fontWeight: item.value && item.value.isOverdue ? fontWeight.medium : fontWeight.regular }))

const overdueBannerStyle = {
  ...flexCenter,
  padding: spacing[2],
  borderRadius: radius.md,
  backgroundColor: semantic.errorLight }

const overdueTextStyle = {
  fontSize: fontSize.sm,
  color: semantic.error,
  fontWeight: fontWeight.medium }

const sectionGap = { height: '20rpx' }
const actionSection = { paddingTop: '16rpx', paddingBottom: '8rpx' }
const actionBtn = computed((): any => ({ height: '80rpx', borderRadius: '40rpx', backgroundColor: n.value.surfacePink, alignItems: 'center', justifyContent: 'center', marginBottom: '12rpx' }))
const actionBtnText = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: brand[600] as string }
const actionBtnSecondary = computed((): any => ({ height: '80rpx', borderRadius: '40rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center' }))
const actionBtnSecondaryText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.textSecondary }))

const noteTextStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
  lineHeight: '1.6' }))
</script>
