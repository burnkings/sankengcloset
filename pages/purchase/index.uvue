<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="购买记录" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="summaryCard"><view :style="summaryPrimary"><text :style="summaryLabel">累计记录</text><text :style="summaryAmount">¥{{ store.totalSpent }}</text></view><view :style="summarySide"><text :style="sideValue">{{ store.itemCount }} 笔</text><text :style="sideLabel">待结清 ¥{{ store.remainingTotal }}</text></view></view>
        <V2SectionHeader title="记录明细" :compact="true" />
        <V2FilterChips :items="filters" :active="activeFilter" @change="onFilter" />
        <AppLoading v-if="store.loading" />
        <view v-else-if="store.displayItems.length === 0" :style="emptyWrap"><AppIcon name="order" :size="64" /><text :style="emptyTitle">暂无符合条件的记录</text></view>
        <view v-else :style="listWrap">
          <view v-for="item in store.displayItems" :key="item.id" :style="recordCard" @tap="openItem(item.id)">
            <view :style="recordTop"><view :style="recordCopy"><text :style="recordTitle">{{ item.name }}</text><text :style="recordBrand">{{ item.brand !== '' ? item.brand : item.shopName }}</text></view><text :style="statusText(item.statusColor)">{{ item.statusText }}</text></view>
            <view :style="amountRow"><text :style="totalText">{{ item.totalText }}</text><text :style="remainingText">{{ item.remainingText }}</text></view>
            <view :style="progressTrack"><view :style="progressFill(item.progressPercent, item.statusColor)" /></view>
            <view :style="dateRow"><text :style="dateText">{{ item.purchaseDateText }}</text><text :style="dateText">{{ item.deadlineLabel }}</text></view>
          </view>
        </view>
      </view>
    </template>
  </MainLayout>
  <view :style="fabStyle" @tap="goAdd"><AppIcon name="add" :size="40" :active="true" /></view>
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, PAGE_HEADER_CONTENT_GAP } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import V2FilterChips from '@/components/v2/V2FilterChips.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import { getSafeBottomInset } from '@/utils/window-info'

const store = usePurchaseStore()
const safeBottom = getSafeBottomInset()
const activeFilter = ref('全部')
const filters = ['全部', '预售中', '已付定金', '待付款', '已完成', '已取消']
function onFilter(label: string) {
  activeFilter.value = label
  let status = ''
  if (label === '预售中') status = 'PREORDER'
  if (label === '已付定金') status = 'DEPOSIT_PAID'
  if (label === '待付款') status = 'PENDING_PAYMENT'
  if (label === '已完成') status = 'COMPLETED'
  if (label === '已取消') status = 'CANCELLED'
  store.setFilterStatus(status)
}
function goAdd() { uni.navigateTo({ url: '/pages/purchase/edit' }) }
function openItem(id: string) { uni.navigateTo({ url: `/pages/purchase/detail?id=${id}` }) }
onMounted(() => { store.fetchPurchases() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP }
const addText = { fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: brand[600] }
const fabStyle = computed((): any => ({ position: 'fixed' as string, right: '40rpx', bottom: `${safeBottom + 160}px`, width: '112rpx', height: '112rpx', borderRadius: '56rpx', backgroundColor: brand[600], alignItems: 'center' as string, justifyContent: 'center' as string, zIndex: 100 }))
const summaryCard = computed((): any => ({ ...flexRow, alignItems: 'center', minHeight: '152rpx', padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
const summaryPrimary = { ...flexFill }
const summaryLabel = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const summaryAmount = { fontSize: fontSize.xl, fontWeight: fontWeight.bold, color: brand[600], marginTop: '8rpx' }
const summarySide = { alignItems: 'flex-end' }
const sideValue = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const sideLabel = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '8rpx' }))
const listWrap = { marginTop: '22rpx' }
const recordCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface, marginBottom: '20rpx' }))
const recordTop = { ...flexRow, alignItems: 'flex-start' }
const recordCopy = { ...flexFill }
const recordTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const recordBrand = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '6rpx' }))
function statusText(color: string) { return { fontSize: fontSize.xs, fontWeight: fontWeight.medium, color, marginLeft: '12rpx' } }
const amountRow = { ...flexRow, alignItems: 'center', marginTop: '22rpx' }
const totalText = computed((): any => ({ ...flexFill, fontSize: fontSize.lg, fontWeight: fontWeight.bold, color: n.value.text }))
const remainingText = { fontSize: fontSize.sm, color: brand[600] }
const progressTrack = computed((): any => ({ height: '8rpx', borderRadius: '4rpx', backgroundColor: n.value.bgTertiary, overflow: 'hidden', marginTop: '18rpx' }))
function progressFill(percent: number, color: string) { return { width: `${percent}%`, height: '8rpx', borderRadius: '4rpx', backgroundColor: color } }
const dateRow = { ...flexRow, justifyContent: 'space-between', marginTop: '14rpx' }
const dateText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const emptyWrap = { alignItems: 'center', paddingTop: '160rpx' }
const emptyTitle = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary, marginTop: '18rpx' }))
</script>
<style>.page-canvas { padding-left: 40rpx; padding-right: 40rpx; }</style>
