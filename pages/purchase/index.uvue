<template>
  <MainLayout>
    <template #navbar>
      <AppNavbar title="消费记录" :show-back="false">
        <template #right>
          <view :style="navRightStyle">
            <text :style="addBtnStyle" @tap="onAddTap">+添加</text>
            <text :style="countBadgeStyle">{{ store.itemCount }}笔</text>
          </view>
        </template>
      </AppNavbar>
    </template>

    <template #default>
      <!-- 消费统计条 -->
      <view :style="statsBarStyle">
        <view :style="statsBarItem">
          <text :style="statsLabel">累计消费</text>
          <text :style="statsAmount">¥{{ store.totalSpent }}</text>
        </view>
        <view :style="statsDivider" />
        <view :style="statsBarItem">
          <text :style="statsLabel">待付款</text>
          <text :style="statsNum(store.pendingPayments.length)">{{ store.pendingPayments.length }}</text>
        </view>
        <view :style="statsDivider" />
        <view :style="statsBarItem">
          <text :style="statsLabel">未结清</text>
          <text :style="statsRemaining">¥{{ store.remainingTotal }}</text>
        </view>
      </view>

      <!-- 状态筛选 -->
      <view :style="filterStyle">
        <scroll-view scroll-x :show-scrollbar="false" :style="chipScrollStyle">
          <view :style="chipRowStyle">
            <AppTag
              v-for="opt in filterOptions"
              :key="opt.value"
              :label="opt.label"
              :variant="TAG_CHIP"
              :active="opt.value === store.filterStatus"
              @tap="store.setFilterStatus(opt.value)"
            />
          </view>
        </scroll-view>
      </view>

      <!-- Loading -->
      <AppLoading v-if="store.loading" />

      <!-- Empty -->
      <AppEmptyState
        v-else-if="store.displayItems.length === 0"
        icon="🛒"
        :title="store.filterStatus ? '没有该状态的购买记录' : '还没有购买记录'"
        :description="store.filterStatus ? '换个筛选试试' : '记录你的第一笔三坑消费吧~'"
        :action-text="store.filterStatus ? '' : '添加消费'"
        @action="onAddTap"
      />

      <!-- 列表 -->
      <view v-else :style="listStyle">
        <PurchaseCard
          v-for="item in store.displayItems"
          :key="item.id"
          :item="item"
          @click="onItemTap(item.id)"
        />
      </view>

      <!-- 底部留白 -->
      <view :style="bottomSpacer" />
    </template>
  </MainLayout>

  <!-- 删除确认 -->
  <AppDialog
    v-model:visible="deleteDialogVisible"
    title="确认删除"
    message="删除后无法恢复，确定要删除这条消费记录吗？"
    @confirm="onConfirmDelete"
  />
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { FILTER_OPTIONS } from '@/domain/purchase-record'
import { brand, accent, neutralLight, neutralDark, semantic, baseColors } from '@/theme/tokens/colors'
import { spacing, semanticSpacing } from '@/theme/tokens/spacing'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { shadow } from '@/theme/tokens/shadow'
import { flexRow, flexCenter, flexColumnCenter, flexRowBetween } from '@/theme/layout/flex'
import { gap } from '@/theme/layout/spacing'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import AppTag from '@/components/base/AppTag.uvue'
import { TAG_CHIP } from '@/components/base/app-tag-types'
import AppEmptyState from '@/components/base/AppEmptyState.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import PurchaseCard from '@/components/business/PurchaseCard.uvue'


const store = usePurchaseStore()

const filterOptions = FILTER_OPTIONS
const deleteDialogVisible = ref(false)
const deleteTargetId = ref('')

function onItemTap(id: string) {
  uni.navigateTo({ url: `/pages/purchase/detail?id=${id}` })
}

function onConfirmDelete() {
  if (deleteTargetId.value) {
    store.deletePurchase(deleteTargetId.value)
    deleteTargetId.value = ''
  }
}

function onAddTap() {
  uni.navigateTo({ url: '/pages/purchase/edit' })
}

onMounted(() => {
  store.fetchPurchases()
})

// ====== 样式 ======

// --- 消费统计条 ---
const statsBarStyle = computed((): any => ({
  ...flexRow,
  justifyContent: 'space-around',
  alignItems: 'center',
  marginHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
  padding: spacing[3],
  backgroundColor: n.value.surface,
  borderRadius: semanticRadius.card,
  boxShadow: shadow.card,
}))

const statsBarItem = {
  ...flexColumnCenter,
  gap: spacing[0.5],
}

const statsLabel = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
}))

const statsAmount = {
  fontSize: fontSize.xl,
  fontWeight: fontWeight.bold,
  color: brand[500],
  lineHeight: 1,
}

function statsNum(count: number) {
  return {
    fontSize: fontSize.xl,
    fontWeight: fontWeight.bold,
    color: count > 0 ? semantic.warning : n.value.textTertiary,
    lineHeight: 1,
  }
}

const statsRemaining = computed((): any => ({
  fontSize: fontSize.xl,
  fontWeight: fontWeight.bold,
  color: store.remainingTotal > 0 ? semantic.error : n.value.textTertiary,
  lineHeight: 1,
}))

const statsDivider = {
  width: '1rpx',
  height: '48rpx',
  backgroundColor: neutralLight.divider,
  alignSelf: 'center',
}

// --- 筛选 ---
const filterStyle = {
  ...flexRow,
  gap: spacing[2],
  padding: `${spacing[3]} ${spacing[4]}` }

const chipScrollStyle = {
  flex: 1,
  overflow: 'hidden' }

const chipRowStyle = {
  ...flexRow,
  gap: spacing[2] }

// --- 导航 ---
const countBadgeStyle = {
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  backgroundColor: n.value.bgTertiary,
  paddingHorizontal: spacing[2],
  paddingVertical: spacing[1],
  borderRadius: radius.sm }

const navRightStyle = {
  ...flexRow,
  alignItems: 'center',
  gap: spacing[2] }

const addBtnStyle = {
  fontSize: fontSize.sm,
  color: brand[500],
  fontWeight: fontWeight.medium }

// --- 列表 ---
const listStyle = {
  ...gap.sm,
  padding: `0 ${spacing[4]} ${spacing[4]}` }

// --- 底部留白 ---
const bottomSpacer = {
  height: spacing[6] }
</script>
