<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar>
      <AppNavbar v-if="!selectMode" title="购买记录" :show-back="true" />
      <AppNavbar v-else title="选择订单" :show-back="false">
        <template #left><text :style="selectAllText" @tap="toggleSelectAll">{{ selectAllLabel }}</text></template>
        <template #right><text :style="selectCancelText" @tap="exitSelect">取消</text></template>
      </AppNavbar>
    </template>
    <template #default>
      <scroll-view :style="scrollStyle">
        <view class="page-canvas" :style="pageWrap">

          <!-- V3 §6.15 SummaryStrip：只保留本月已支付和待付尾款 -->
          <SummaryStrip :items="summaryItems" :surface="true" />

          <view :style="importCard" @tap="goImport">
            <view :style="importIcon"><AppIcon name="import" :size="36" :active="true" /></view>
            <view :style="importCopy"><text :style="importTitle">尾款一键入库</text><text :style="importDesc">订单截图识别后再逐项确认，自动接入提醒</text></view>
            <AppIcon name="arrow-right" :size="32" :active="true" />
          </view>

          <FilterChips :items="filters" :active="activeFilter" @change="onFilter" />

          <FeedSkeleton v-if="store.loading" />

          <template v-else-if="store.displayItems.length === 0">
            <PageState icon="order" title="暂无订单记录" message="录入定金尾款订单，避免逾期" action-text="新增记录" @action="goAdd" />
          </template>

          <view v-else>
            <view v-for="group in groupedItems" :key="group.key">
              <view :style="groupHeader"><text :style="groupHeaderText">{{ group.label }}（{{ group.items.length }} 条）</text></view>
               <view v-for="item in group.items" :key="item.id" :style="cardStyle(item)" @tap="selectMode ? toggleItem(item.id) : openItem(item.id)" @longpress="enterSelect(item.id)">
                <view v-if="selectMode" :style="selectCheckWrap" @tap.stop="toggleItem(item.id)">
                  <view :style="selectCheckStyle(selectedIds.indexOf(item.id) >= 0)">
                    <AppIcon v-if="selectedIds.indexOf(item.id) >= 0" name="check" :size="24" />
                  </view>
                </view>
                <view v-if="item.isOverdue" :style="overdueTag"><text :style="overdueTagText">已逾期</text></view>
                <view :style="cardTop">
                  <text :style="cardTitle">{{ item.name }}</text>
                  <StatusChip :label="item.statusText" :status="statusClass(item.statusText)" size="sm" />
                </view>
                <view :style="cardProgress"><view :style="cardProgressFill(item.progressPercent, item.statusColor)" /></view>
              </view>
            </view>
          </view>

          <view :style="bottomSpacer" />
        </view>
      </scroll-view>
    </template>
  </MainLayout>
  <AppFab v-if="!selectMode" @tap="goAdd" />

  <view v-if="selectMode && selectedIds.length > 0" :style="bottomBar">
    <view :style="deleteBtn" @tap="confirmDelete"><text :style="deleteBtnText">删除 ({{ selectedIds.length }})</text></view>
  </view>
  <view v-if="selectMode && selectedIds.length === 0" :style="bottomBar">
    <view :style="deleteDisabled"><text :style="deleteDisabledText">请选择订单</text></view>
  </view>

  <AppDialog :visible="showDeleteDialog" title="确认删除" @confirm="batchDelete" @cancel="showDeleteDialog = false">
    <text :style="dialogText">确定删除选中的 {{ selectedIds.length }} 条订单吗？</text>
    <template #actions>
      <view :style="dialogActions">
        <view :style="dialogCancelBtn" @tap="showDeleteDialog = false"><text :style="dialogCancelBtnText">取消</text></view>
        <view :style="dialogDelBtn" @tap="batchDelete"><text :style="dialogDelBtnText">删除</text></view>
      </view>
    </template>
  </AppDialog>
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { PurchaseDisplayModel } from '@/domain/purchase-presenter'
import { formatPrice } from '@/stores/home-feed-store'
import { brand, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import SummaryStrip from '@/components/v3/SummaryStrip.uvue'
import FilterChips from '@/components/v3/FilterChips.uvue'
import StatusChip from '@/components/v3/StatusChip.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'
import AppFab from '@/components/base/AppFab.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'

const store = usePurchaseStore()
const selectMode = ref(false)
const selectedIds = ref<string[]>([])
const showDeleteDialog = ref(false)
const activeFilter = ref('全部')
const filters = ['全部', '预售中', '已付定金', '待付款', '已完成', '已取消']
// 金额一律分（与 FeedItem.price 一致），展示用 formatPrice 转元
const formattedTotal = computed((): string => formatPrice(store.totalSpent))
const formattedRemaining = computed((): string => formatPrice(store.remainingTotal))

function onFilter(label: string) {
  activeFilter.value = label
  let status = ''
  if (label === '预售中') status = 'PRE_ORDER'
  if (label === '已付定金') status = 'DEPOSIT_PAID'
  if (label === '待付款') status = 'BALANCE_PENDING'
  if (label === '已完成') status = 'COMPLETED'
  if (label === '已取消') status = 'CANCELLED'
  store.setFilterStatus(status)
}
function statusClass(statusText: string): string {
  if (statusText === '已完成') return 'positive'
  if (statusText === '已取消') return 'neutral'
  if (statusText === '已逾期') return 'error'
  return 'pending'
}
function goAdd() { uni.navigateTo({ url: '/pages/purchase/edit' }) }
function goImport() { uni.navigateTo({ url: '/pages/purchase/import' }) }
function openItem(id: string) { if (!selectMode.value) uni.navigateTo({ url: `/pages/purchase/detail?id=${id}` }) }

function enterSelect(id: string) { selectMode.value = true; selectedIds.value = [id] }
function exitSelect() { selectMode.value = false; selectedIds.value = [] }
function toggleItem(id: string) {
  const idx = selectedIds.value.indexOf(id)
  if (idx >= 0) { const n = [...selectedIds.value]; n.splice(idx, 1); selectedIds.value = n }
  else selectedIds.value = [...selectedIds.value, id]
}
function toggleSelectAll() {
  const allIds = groupedItems.value.flatMap((g) => g.items.map((it) => it.id))
  selectedIds.value = selectedIds.value.length === allIds.length ? [] : allIds
}
const selectAllLabel = computed((): string => {
  const allIds = groupedItems.value.flatMap((g) => g.items.map((it) => it.id))
  return selectedIds.value.length === allIds.length && selectedIds.value.length > 0 ? '取消全选' : '全选'
})
function confirmDelete() { if (selectedIds.value.length > 0) showDeleteDialog.value = true }
function batchDelete() {
  for (let i = 0; i < selectedIds.value.length; i++) store.deletePurchase(selectedIds.value[i])
  showDeleteDialog.value = false
  exitSelect()
}
onMounted(() => { store.fetchPurchases() })

const groupedItems = computed(() => {
  const items = store.displayItems
  const pending: PurchaseDisplayModel[] = []
  const thisMonth: PurchaseDisplayModel[] = []
  const older: PurchaseDisplayModel[] = []
  const now = new Date()
  const thisMonthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0]
  for (let i = 0; i < items.length; i++) {
    const it = items[i]
    if (it.remainingText !== '已结清' && it.statusText !== '已取消') pending.push(it)
    else if (it.purchaseDateText >= thisMonthStart) thisMonth.push(it)
    else older.push(it)
  }
  const result: { key: string; label: string; items: PurchaseDisplayModel[] }[] = []
  if (pending.length > 0) result.push({ key: 'pending', label: '待补尾款', items: pending })
  if (thisMonth.length > 0) result.push({ key: 'month', label: '本月订单', items: thisMonth })
  if (older.length > 0) result.push({ key: 'older', label: '往期订单', items: older })
  return result
})

const scrollStyle = { flex: 1 }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const bottomSpacer = { height: '60rpx' }

// V3 §6.15 SummaryStrip：本月已支付 + 待付尾款
const now = new Date()
const monthCode = `${now.getFullYear()}-${(now.getMonth() + 1) < 10 ? '0' + (now.getMonth() + 1).toString() : (now.getMonth() + 1).toString()}`
const summaryItems = computed(() => [
  { label: '本月已支付', value: formatPrice(store.monthlyPaid(monthCode)) },
  { label: '待付尾款', value: formatPrice(store.remainingTotal), highlight: store.remainingTotal > 0 },
])

const importCard = computed((): any => ({ ...flexRow, alignItems: 'center', padding: '22rpx', borderRadius: '16rpx', backgroundColor: n.value.surfacePink, marginTop: '18rpx', marginBottom: '8rpx' }))
const importIcon = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.surface, alignItems: 'center', justifyContent: 'center', marginRight: '16rpx' }))
const importCopy = { ...flexFill }
const importTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const importDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '5rpx' }))

const groupHeader = { paddingTop: '24rpx', paddingBottom: '10rpx' }
const groupHeaderText = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.textTertiary }))

// V3 §6.15 订单卡：小卡级圆角 12rpx；逾期用 danger token
function cardStyle(item: PurchaseDisplayModel): any {
  const borderColor = item.isOverdue ? semantic.error : n.value.border
  return { padding: CARD_PADDING, borderRadius: '12rpx', backgroundColor: n.value.surface, borderWidth: item.isOverdue ? '2rpx' : '1rpx', borderStyle: 'solid' as string, borderColor, marginBottom: '14rpx' }
}
const overdueTag = { marginBottom: '8rpx' }
const overdueTagText = { fontSize: '22rpx', fontWeight: fontWeight.semibold, color: semantic.error as string }
const cardTop = { ...flexRow, flexDirection: 'row', alignItems: 'center' }
const cardTitle = computed((): any => ({ ...flexFill, fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, lines: 1 as const, textOverflow: 'ellipsis' as string }))
const cardBrand = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary, marginTop: '6rpx' }))
const cardAmountRow = { ...flexRow, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginTop: '14rpx' }
function cardRemaining(item: PurchaseDisplayModel): any {
  const isPending = item.remainingText !== '已结清' && item.statusText !== '已取消'
  return { fontSize: '28rpx', fontWeight: fontWeight.semibold, color: isPending ? semantic.error as string : semantic.success as string }
}
const cardTotal = { fontSize: '24rpx', color: n.value.textTertiary }
const cardProgress = computed((): any => ({ height: '6rpx', borderRadius: '3rpx', backgroundColor: n.value.border, overflow: 'hidden', marginTop: '12rpx' }))
function cardProgressFill(percent: number, color: string): any {
  return { width: `${percent}%`, height: '6rpx', borderRadius: '3rpx', backgroundColor: color }
}

const selectAllText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: brand[500] as string }))
const selectCancelText = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.medium, color: n.value.text }))
const selectCheckWrap = { width: '56rpx', alignItems: 'center', justifyContent: 'center', flexShrink: 0, marginRight: '4rpx' }
function selectCheckStyle(checked: boolean): any {
  return { width: '40rpx', height: '40rpx', borderRadius: '8rpx', borderWidth: '3rpx', borderStyle: 'solid' as string, borderColor: checked ? (brand[500] as string) : n.value.border, backgroundColor: checked ? (brand[500] as string) : 'transparent', alignItems: 'center', justifyContent: 'center' }
}

const bottomBar = computed((): any => ({ position: 'fixed', bottom: '0', left: '0', right: '0', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3, paddingBottom: '40rpx', paddingTop: '20rpx', backgroundColor: n.value.surface }))
const deleteBtn = computed((): any => ({ height: '88rpx', borderRadius: '16rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center' }))
const deleteBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: '#FFFFFF' }
const deleteDisabled = computed((): any => ({ height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.bgTertiary, alignItems: 'center', justifyContent: 'center' }))
const deleteDisabledText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.textTertiary }
const dialogText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, textAlign: 'center', padding: '24rpx' }))
const dialogActions = computed((): any => ({ flexDirection: 'row', justifyContent: 'space-between', paddingTop: '8rpx' }))
const dialogCancelBtn = computed((): any => ({ flex: 1, height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '12rpx' }))
const dialogCancelBtnText = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.medium, color: n.value.text }))
const dialogDelBtn = computed((): any => ({ flex: 1, height: '88rpx', borderRadius: '16rpx', backgroundColor: semantic.error, alignItems: 'center', justifyContent: 'center' }))
const dialogDelBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: '#FFFFFF' }
</script>
