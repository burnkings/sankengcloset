<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="购买记录" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="summaryCard">
          <view :style="summaryPrimary">
            <text :style="summaryLabel">累计记录</text>
            <text :style="summaryCount">{{ store.itemCount }} 笔</text>
            <text :style="summaryAmount">¥{{ store.totalSpent }}</text>
          </view>
          <view :style="summarySide">
            <text :style="sideLabel">待结清 ¥{{ store.remainingTotal }}</text>
            <view :style="progressTrack"><view :style="progressFill" /></view>
          </view>
        </view>
        <V2SectionHeader title="记录明细" :compact="true" />
        <V2Segmented :items="filters" :active="activeFilter" variant="solid" :active-color="brand[500]" @change="onFilter" />
        <AppLoading v-if="store.loading" />
        <view v-else-if="store.displayItems.length === 0" :style="emptyWrap"><AppIcon name="order" :size="64" /><text :style="emptyTitle">暂无符合条件的记录</text></view>
        <view v-else :style="listWrap">
          <view v-for="item in store.displayItems" :key="item.id" :style="recordCard" @tap="openItem(item.id)">
            <view :style="recordTop">
              <view :style="recordCopy">
                <text :style="recordTitle">{{ item.name }}</text>
                <text :style="recordBrand">{{ item.brand !== '' ? item.brand : item.shopName }}</text>
              </view>
              <text :style="statusText(item.statusColor)">{{ item.statusText }}</text>
            </view>
            <view :style="amountRow">
              <text :style="totalText">{{ item.totalText }}</text>
              <text :style="remainingText(item.statusColor)">{{ item.remainingText }}</text>
            </view>
            <view :style="progressTrack"><view :style="progressFillPct(item.progressPercent, item.statusColor)" /></view>
            <text v-if="item.note !== ''" :style="noteText">{{ item.note }}</text>
            <text v-if="item.deadlineLabel !== ''" :style="dueText">{{ item.deadlineLabel }}</text>
          </view>
        </view>
      </view>
    </template>
  </MainLayout>
  <view :style="fabStyle" @tap="goAdd"><text :style="fabText">+</text></view>
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import V2Segmented from '@/components/v2/V2Segmented.uvue'
import { getSafeBottomInset } from '@/utils/window-info'

const store = usePurchaseStore()
const safeBottom = getSafeBottomInset()
const activeFilter = ref('全部')
const filters = ['全部', '预售中', '已付定金', '待付款', '已完成']
function onFilter(label: string) {
  activeFilter.value = label
  let status = ''
  if (label === '预售中') status = 'PREORDER'
  if (label === '已付定金') status = 'DEPOSIT_PAID'
  if (label === '待付款') status = 'PENDING_PAYMENT'
  if (label === '已完成') status = 'COMPLETED'
  store.setFilterStatus(status)
}
function goAdd() { uni.navigateTo({ url: '/pages/purchase/edit' }) }
function openItem(id: string) { uni.navigateTo({ url: `/pages/purchase/detail?id=${id}` }) }
onMounted(() => { store.fetchPurchases() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const summaryCard = computed((): any => ({ ...flexRow, alignItems: 'stretch', minHeight: '152rpx', padding: CARD_PADDING, borderRadius: '24rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder }))
const summaryPrimary = { ...flexFill, justifyContent: 'center' }
const summaryLabel = computed((): any => ({ fontSize: '24rpx', color: n.value.textSecondary }))
const summaryCount = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.medium, color: n.value.textSecondary, marginTop: '6rpx' }))
const summaryAmount = { fontSize: '44rpx', fontWeight: fontWeight.semibold, color: brand[500], marginTop: '6rpx' }
const summarySide = { alignItems: 'flex-end', justifyContent: 'center' }
const sideLabel = computed((): any => ({ fontSize: '24rpx', color: n.value.textSecondary }))
const progressTrack = computed((): any => ({ width: '220rpx', height: '8rpx', borderRadius: '4rpx', backgroundColor: n.value.cardBorder, overflow: 'hidden', marginTop: '12rpx' }))
const progressFill = computed((): any => {
  const total = store.totalSpent > 0 ? store.totalSpent : 1
  const pct = Math.min(100, Math.round(store.remainingTotal / total * 100))
  return { width: `${pct}%`, height: '8rpx', borderRadius: '4rpx', backgroundColor: brand[500] }
})
const listWrap = { marginTop: '22rpx' }
const recordCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '24rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder, marginBottom: '20rpx' }))
const recordTop = { ...flexRow, alignItems: 'flex-start' }
const recordCopy = { ...flexFill }
const recordTitle = computed((): any => ({ fontSize: '30rpx', fontWeight: fontWeight.semibold, color: n.value.text }))
const recordBrand = computed((): any => ({ fontSize: '24rpx', color: n.value.textSecondary, marginTop: '6rpx' }))
function statusText(color: string) { return { fontSize: '24rpx', fontWeight: fontWeight.semibold, color, marginLeft: '12rpx', flexShrink: 0 } }
const amountRow = { ...flexRow, alignItems: 'center', marginTop: '18rpx' }
const totalText = computed((): any => ({ ...flexFill, fontSize: '32rpx', fontWeight: fontWeight.semibold, color: n.value.text }))
function remainingText(color: string) { return { fontSize: '28rpx', fontWeight: fontWeight.semibold, color } }
function progressFillPct(percent: number, color: string) { return { width: `${percent}%`, height: '6rpx', borderRadius: '3rpx', backgroundColor: color } }
const noteText = computed((): any => ({ fontSize: '20rpx', color: n.value.textSecondary, marginTop: '14rpx' }))
const dueText = computed((): any => ({ fontSize: '20rpx', color: n.value.textSecondary, marginTop: '6rpx' }))
const emptyWrap = { alignItems: 'center', paddingTop: '160rpx' }
const emptyTitle = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary, marginTop: '18rpx' }))
const fabStyle = computed((): any => ({ position: 'fixed' as string, right: '40rpx', bottom: `${safeBottom + 64}px`, width: '104rpx', height: '104rpx', borderRadius: '52rpx', backgroundColor: brand[600], alignItems: 'center' as string, justifyContent: 'center' as string, zIndex: 100 }))
const fabText = { fontSize: '58rpx', lineHeight: '64rpx', fontWeight: fontWeight.regular, color: '#FFFFFF', textAlign: 'center' }
</script>
