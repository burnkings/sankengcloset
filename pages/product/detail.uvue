<template>
  <MainLayout navbar-content-height="0rpx">
    <template #default>
      <view v-if="loading" :style="emptyWrap"><text :style="emptyText">正在加载商品信息…</text></view>
      <view v-else-if="item !== null">
        <view :style="heroWrap">
          <swiper :style="hero" :circular="detailImages.length > 1" :indicator-dots="false" @change="onGalleryChange">
            <swiper-item v-for="imageUrl in detailImages" :key="imageUrl">
              <AppImage :src="imageUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            </swiper-item>
          </swiper>
          <view :style="heroBack" @tap="onBack">
            <view :style="heroChevron" />
          </view>
          <view v-if="detailImages.length > 1" :style="imageCounter"><text :style="imageCounterText">{{ currentImageIndex + 1 }} / {{ detailImages.length }}</text></view>
        </view>

        <view class="page-canvas" :style="pageWrap">
          <view :style="summaryCard">
            <view :style="priceRow"><text :style="priceText">{{ formatPrice(item!.price) }}</text><text v-if="item!.originalPrice > item!.price" :style="oldPrice">{{ formatPrice(item!.originalPrice) }}</text></view>
            <text :style="titleText">{{ item!.title }}</text>
            <text :style="brandText">{{ item!.brandName }}</text>
            <view :style="statusTag">
              <view :style="statusDot" />
              <text :style="statusTagText">{{ item!.badgeText !== '' ? item!.badgeText : '官方信息' }}</text>
            </view>
            <view :style="decisionRow">
              <view :style="decisionBtn(false)" @tap="createReminder"><AppIcon name="reminder" :size="32" :active="true" /><text :style="decisionText">设置提醒</text></view>
              <view :style="decisionBtn(true)" @tap="createPurchase"><image :src="orderWhiteIcon" :style="decisionIcon" mode="aspectFit" /><text :style="decisionTextLight">记入购买</text></view>
            </view>
          </view>

          <V2SectionHeader title="发售进度" />
          <view :style="stepCard">
            <view :style="stepLine" />
            <view :style="stepLineFill" />
            <view :style="stepRow">
              <view v-for="(stage, idx) in stages" :key="stage" :style="stepItem(idx)">
                <view :style="stepDot(idx)" />
                <text :style="stepLabel(idx)">{{ stage }}</text>
              </view>
            </view>
          </view>

          <V2SectionHeader title="商品说明" />
          <view :style="detailCard"><text :style="detailText">{{ description !== '' ? description : (item!.subtitle !== '' ? item!.subtitle : '商品说明待品牌补充') }}</text></view>
          <view :style="actionSpacer" />
        </view>
      </view>
      <view v-else :style="emptyWrap">
        <text :style="emptyText">{{ errorMessage !== '' ? errorMessage : '商品信息不存在' }}</text>
        <view :style="retryButton" @tap="loadDetail"><text :style="retryText">重新加载</text></view>
      </view>
    </template>
  </MainLayout>
  <view v-if="item !== null" :style="botBar">
    <view :style="botItem" @tap="toggleSaved">
      <view :style="botIcon"><AppIcon name="wardrobe" :size="40" :active="isSaved" /></view>
      <text :style="botLabel">{{ isSaved ? '已收藏' : '收藏' }}</text>
    </view>
    <view :style="botItem" @tap="askQiling">
      <view :style="botIcon"><AppIcon name="sparkles" :size="40" :active="false" /></view>
      <text :style="botLabel">问绮灵</text>
    </view>
    <view :style="goBtn" @tap="openOfficial"><text :style="goBtnText">前往官方渠道</text></view>
  </view>
</template>

<script setup lang="uts">
import { FeedItem } from '@/domain/content/feed-item'
import { fetchProductDetail } from '@/services/content/product-service'
import { formatPrice } from '@/stores/home-feed-store'
import { apiGet, apiPost, apiDelete } from '@/services/platform/api-client'
import { getCachedAccessToken } from '@/config/runtime'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { zIndex } from '@/theme/tokens/z-index'
import { getSafeBottomInset, upx2px } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import { showFeedback } from '@/utils/feedback'

const orderWhiteIcon = '/static/icons/order-white.svg'

const itemId = ref('')
const item = ref(null) as Ref<FeedItem | null>
const loading = ref(true)
const errorMessage = ref('')
const description = ref('')
const shopUrl = ref('')
const isSaved = ref(false)
const stages = ['图透', '定金', '尾款', '现货']
const currentImageIndex = ref(0)
const detailImages = ref([]) as Ref<string[]>
let savedEntityIds: string[] = []

function onGalleryChange(e: any) { currentImageIndex.value = (e.detail as any).current ?? 0 }
function onBack() { uni.navigateBack() }

function isLoggedIn(): boolean {
  return getCachedAccessToken() !== ''
}

async function fetchWishlist() {
  try {
    const response = await apiGet('/api/v1/wishlist')
    const items = response.data as any[]
    if (items != null) {
      savedEntityIds = items.map((w: any) => String(w.entityId ?? w.id ?? ''))
      if (item.value !== null) {
        isSaved.value = savedEntityIds.indexOf(item.value!.entityId) >= 0
      }
    }
  } catch (_) {
    // 未登录或网络错误 — 收藏态保持 false
  }
}

async function toggleSaved() {
  if (item.value === null) return
  const entityId = item.value!.entityId
  if (entityId === '') return

  if (!isLoggedIn()) {
    showFeedback('请先登录后收藏')
    return
  }

  const currentSaved = isSaved.value
  try {
    if (currentSaved) {
      const targetId = findWishlistId(entityId)
      if (targetId !== '') {
        await apiDelete(`/api/v1/wishlist/${encodeURIComponent(targetId)}`)
      }
      isSaved.value = false
      const idx = savedEntityIds.indexOf(entityId)
      if (idx >= 0) savedEntityIds.splice(idx, 1)
      showFeedback('已移出收藏')
    } else {
      await apiPost('/api/v1/wishlist', { entityId, feedType: item.value!.feedType, title: item.value!.title })
      isSaved.value = true
      savedEntityIds.unshift(entityId)
      showFeedback('已收进心动收藏')
    }
  } catch (e) {
    isSaved.value = currentSaved
    showFeedback(e instanceof Error ? e.message : '操作失败，请重试')
  }
}

function findWishlistId(entityId: string): string {
  return entityId
}

function openOfficial() {
  if (shopUrl.value === '') { showFeedback('暂未收录官方购买地址'); return }
  uni.setClipboardData({ data: shopUrl.value, success: () => { showFeedback('官方地址已复制，可在浏览器打开') } })
}

function askQiling() {
  uni.navigateTo({ url: '/pages/ai/index' })
}

function dateOnly(value: string): string {
  if (value === '') return ''
  return value.length >= 10 ? value.substring(0, 10) : value
}

function encoded(value: string): string { return encodeURIComponent(value) }

function createReminder() {
  if (item.value === null) return
  const type = item.value!.badgeText === '尾款' ? 'BALANCE' : 'RELEASE'
  const title = `${item.value!.title} ${item.value!.badgeText !== '' ? item.value!.badgeText : '发售'}`
  const note = `${item.value!.brandName} · 来源于商品详情`
  uni.navigateTo({ url: `/pages/reminder/edit?title=${encoded(title)}&type=${type}&date=${dateOnly(item.value!.eventEndAt)}&note=${encoded(note)}` })
}

function createPurchase() {
  if (item.value === null) return
  const amount = item.value!.price > 0 ? String(item.value!.price / 100) : ''
  const category = item.value!.category === 'LOLITA' ? 'LOLITA' : (item.value!.category === 'HANFU' ? 'HANFU' : 'JK')
  uni.navigateTo({ url: `/pages/purchase/edit?name=${encoded(item.value!.title)}&brand=${encoded(item.value!.brandName)}&amount=${amount}&category=${category}&deadline=${dateOnly(item.value!.eventEndAt)}` })
}

async function loadDetail() {
  loading.value = true
  errorMessage.value = ''
  currentImageIndex.value = 0
  isSaved.value = false
  try {
    const result = await fetchProductDetail(itemId.value)
    if (result === null) { item.value = null; errorMessage.value = '商品信息不存在'; return }
    item.value = result.item
    detailImages.value = result.images
    description.value = result.description
    shopUrl.value = result.shopUrl
    if (isLoggedIn()) {
      await fetchWishlist()
    }
  } catch (e) {
    item.value = null
    detailImages.value = []
    errorMessage.value = e instanceof Error ? e.message : '商品加载失败'
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  const pages = getCurrentPages()
  const current = pages[pages.length - 1]
  itemId.value = (current as any).options?.id ?? ''
  loadDetail()
})

const safeBottom = getSafeBottomInset()
const pageWrap = { paddingTop: '0', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const heroWrap = { width: '750rpx', height: '720rpx', position: 'relative' as string, backgroundColor: n.value.bgSecondary, overflow: 'hidden' }
const hero = { width: '750rpx', height: '720rpx' }
const heroBack = { position: 'absolute' as string, left: '32rpx', top: '28rpx', width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: baseColors.black, alignItems: 'center', justifyContent: 'center', zIndex: zIndex.navbar + 1 }
const heroChevron = { width: '26rpx', height: '26rpx', borderRightWidth: '4rpx', borderBottomWidth: '4rpx', borderStyle: 'solid', borderColor: baseColors.white, transform: 'rotate(135deg)' }
const imageCounter = { position: 'absolute' as string, right: '30rpx', bottom: '32rpx', minWidth: '84rpx', height: '48rpx', paddingLeft: '16rpx', paddingRight: '16rpx', borderRadius: '24rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: baseColors.black }
const imageCounterText = { fontSize: '22rpx', fontWeight: fontWeight.medium, color: baseColors.white }
const summaryCard = { marginTop: '20rpx', padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }
const priceRow = { ...flexRow, alignItems: 'flex-end' }
const priceText = { fontSize: fontSize['2xl'], fontWeight: fontWeight.bold, color: brand[500] }
const oldPrice = { fontSize: fontSize.xs, color: n.value.textTertiary, textDecorationLine: 'line-through', marginLeft: '10rpx', marginBottom: '4rpx' }
const titleText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, lineHeight: '44rpx', marginTop: '14rpx' }
const brandText = { fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '8rpx' }
const statusTag = { ...flexRow, alignItems: 'center', alignSelf: 'flex-start', height: '44rpx', paddingLeft: '14rpx', paddingRight: '18rpx', marginTop: '18rpx', borderRadius: '22rpx', backgroundColor: baseColors.white, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.cardBorder }
const statusDot = { width: '12rpx', height: '12rpx', borderRadius: '6rpx', backgroundColor: brand[500], marginRight: '8rpx' }
const statusTagText = { fontSize: fontSize.xs, fontWeight: fontWeight.medium, color: brand[500] }
const decisionRow = { ...flexRow, marginTop: '22rpx' }
function decisionBtn(primary: boolean) {
  return {
    ...flexFill,
    height: '88rpx',
    borderRadius: '22rpx',
    backgroundColor: primary ? brand[500] : baseColors.white,
    borderWidth: primary ? '0' : '3rpx',
    borderStyle: 'solid' as string,
    borderColor: primary ? baseColors.white : brand[500],
    ...flexRow,
    alignItems: 'center',
    justifyContent: 'center',
    marginRight: primary ? '0' : '28rpx',
  }
}
const decisionIcon = { width: '32rpx', height: '32rpx', marginRight: '8rpx' }
const decisionText = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: brand[500], marginLeft: '8rpx' }
const decisionTextLight = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: baseColors.white, marginLeft: '8rpx' }
const stepCard = { ...flexRow, height: '128rpx', paddingLeft: '24rpx', paddingRight: '24rpx', borderRadius: '24rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.cardBorder }
const stepLine = { position: 'absolute' as string, left: '110rpx', right: '110rpx', top: '71rpx', height: '2rpx', backgroundColor: n.value.cardBorder }
const stepLineFill = { position: 'absolute' as string, left: '110rpx', width: '257rpx', top: '71rpx', height: '2rpx', backgroundColor: brand[500] }
const stepRow = { ...flexFill, ...flexRow, alignItems: 'flex-start', justifyContent: 'space-between' }
function stepItem(idx: number) { return { flex: 1, alignItems: 'center' } }
function stepDot(idx: number) {
  const filled = idx < 2
  const outline = idx === 2
  const idle = idx === 3
  return {
    width: '24rpx',
    height: '24rpx',
    borderRadius: '12rpx',
    backgroundColor: filled ? brand[500] : (idle ? n.value.cardBorder : baseColors.white),
    borderWidth: outline ? '4rpx' : '0',
    borderStyle: 'solid' as string,
    borderColor: outline ? brand[500] : baseColors.white,
    marginTop: '36rpx',
  }
}
function stepLabel(idx: number) {
  const active = idx < 2
  const next = idx === 2
  return { fontSize: '22rpx', fontWeight: fontWeight.medium, color: active ? n.value.text : (next ? '#5C5550' : n.value.textSecondary), marginTop: '12rpx' }
}
const detailCard = { padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }
const detailText = { fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '42rpx' }
const actionSpacer = { height: `${upx2px(180) + safeBottom}px`, flexShrink: 0 }
const emptyWrap = { flex: 1, alignItems: 'center', justifyContent: 'center' }
const emptyText = { fontSize: fontSize.sm, color: n.value.textTertiary }
const retryButton = { marginTop: '24rpx', height: '68rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '34rpx', backgroundColor: brand[100], alignItems: 'center', justifyContent: 'center' }
const retryText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: brand[700] }
const botBar = { position: 'fixed', left: '0', right: '0', bottom: '0', zIndex: zIndex.navbar, height: '192rpx', paddingLeft: '24rpx', paddingRight: '24rpx', paddingTop: '20rpx', paddingBottom: `${safeBottom}px`, ...flexRow, alignItems: 'flex-start', backgroundColor: n.value.surface, borderTopWidth: '1rpx', borderTopStyle: 'solid', borderTopColor: n.value.divider }
const botItem = { width: '100rpx', alignItems: 'center' }
const botIcon = { width: '56rpx', height: '56rpx', alignItems: 'center', justifyContent: 'center' }
const botLabel = { fontSize: '20rpx', color: '#5C5550', marginTop: '8rpx' }
const goBtn = { ...flexFill, height: '104rpx', borderRadius: '26rpx', backgroundColor: brand[500], alignItems: 'center', justifyContent: 'center', marginLeft: '24rpx' }
const goBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>
