<template>
  <MainLayout navbar-content-height="88rpx" bottom-spacer="0rpx">
    <template #navbar>
      <AppNavbar title="商品详情" :show-back="true">
        <template #right>
          <view v-if="item !== null" :style="navMoreBtn" @tap="onMoreTap"><AppIcon name="more" :size="40" /></view>
        </template>
      </AppNavbar>
    </template>
    <template #default>
      <view v-if="loading" :style="emptyWrap"><PageSkeleton variant="detail" /></view>
      <view v-else-if="item !== null">
        <view :style="heroWrap">
          <swiper :style="hero" :circular="detailImages.length > 1" :indicator-dots="false" @change="onGalleryChange">
            <swiper-item v-for="imageUrl in detailImages" :key="imageUrl" @tap="previewGallery">
              <AppImage :src="imageUrl" width="100%" height="100%" mode="aspectFit" :lazy-load="true" />
            </swiper-item>
          </swiper>
          <view v-if="detailImages.length > 1" :style="imageCounter"><text :style="imageCounterText">{{ currentImageIndex + 1 }} / {{ detailImages.length }}</text></view>
        </view>

        <view class="page-canvas" :style="pageWrap">
          <view :style="summaryCard">
            <text :style="titleText">{{ item!.title }}</text>
              <view v-if="priceSummaryText !== ''" :style="priceRow">
                <text v-if="priceSummaryText !== ''" :style="priceText">{{ priceSummaryText }}</text>
              </view>
            <view :style="brandRow">
              <text :style="brandText">{{ item!.brandName !== '' ? item!.brandName : shopName }}</text>
              <view v-if="pitTypeLabel !== ''" :style="pitChip"><text :style="pitChipText">{{ pitTypeLabel }}</text></view>
              <view v-if="subCategory !== ''" :style="subChip"><text :style="subChipText">{{ subCategory }}</text></view>
              <!-- 屏蔽品牌（负向、低频）已移入导航栏「…」菜单；只有"已被屏蔽"时才在这里给恢复入口 -->
              <view v-if="item!.brandName !== '' && blacklist.isBlacklisted(item!.brandName)" :style="blacklistBtn" @tap="onToggleBlacklist">
                <text :style="blacklistBtnText">已屏蔽·恢复</text>
              </view>
            </view>
            <!-- 原来此处还有一行「卖点标签」—— 与「发售信息 → 当前状态」重复，2026-09-14 按反馈删除。
                 标签数据（featureTags）仍从服务端接收，留给后续筛选/搜索用。 -->
            <view v-if="blacklist.isBlacklisted(item!.brandName)" :style="blockedBanner">
              <text :style="blockedBannerText">该品牌已被你屏蔽，首页、搜索与收藏中将不再展示。可点上方「已屏蔽·恢复」取消。</text>
            </view>
            <!-- 原先此处还有一个孤立的状态胶囊（只写「尾款」两个字、无上下文），
                 与下方「发售信息 → 当前状态」完全重复，2026-09-13 按用户反馈删除：
                 发售状态统一由「发售信息」卡承载，摘要卡只放 价格/品牌/标签/搭配度。 -->
            <!-- 搭配度模块已整体下线（2026-09-14）：算法为启发式 v1，不适合以百分比上线，等排期重做。
                 算法文件 services/ai/wardrobe-compatibility-service.uts 一并删除（git 历史可恢复）。 -->
          </view>
          <template v-if="release !== null">
            <SectionHeader title="发售信息" />
            <view :style="releaseCard">
              <view v-if="releaseStatusText !== ''" :style="releaseRow"><text :style="releaseLabel">当前状态</text><text :style="releaseValue">{{ releaseStatusText }}</text></view>
              <view v-if="releaseBatchText !== ''" :style="releaseRow"><text :style="releaseLabel">批次</text><text :style="releaseValue">{{ releaseBatchText }}</text></view>
              <view v-if="releaseStartText !== ''" :style="releaseRow"><text :style="releaseLabel">预售时间</text><text :style="releaseValue">{{ releaseStartText }}</text></view>
              <view v-if="shipDateText !== ''" :style="releaseRow"><text :style="releaseLabel">出货时间</text><text :style="releaseValue">{{ shipDateText }}</text></view>
            </view>
          </template>

          <template v-if="styleOptions.length > 0 || colorTags.length > 0 || sizeOptions.length > 0">
            <SectionHeader title="规格" />
            <view :style="specCard">
              <view v-if="styleOptions.length > 0" :style="specRow">
                <text :style="specLabel">款式</text>
                <view :style="specChips">
                  <view v-for="st in styleOptions" :key="st" :style="specChip"><text :style="specChipText">{{ styleQuote(st) }}</text></view>
                </view>
              </view>
              <view v-if="colorTags.length > 0" :style="specRow">
                <text :style="specLabel">颜色</text>
                <view :style="specChips">
                  <view v-for="c in colorTags" :key="c" :style="specChip"><text :style="specChipText">{{ c }}</text></view>
                </view>
              </view>
              <view v-if="sizeOptions.length > 0" :style="specRow">
                <text :style="specLabel">尺码</text>
                <view :style="specChips">
                  <view v-for="s in sizeOptions" :key="s" :style="specChip"><text :style="specChipText">{{ s }}</text></view>
                </view>
              </view>
            </view>
          </template>

          <template v-if="materialSummary !== ''">
            <SectionHeader title="材质" />
            <view :style="detailCard"><text :style="detailText">{{ materialSummary }}</text></view>
          </template>

          <template v-if="descriptionText !== ''">
            <SectionHeader title="商品说明" />
            <view :style="detailCard"><text :style="detailText">{{ descriptionText }}</text></view>
          </template>

          <template v-if="sameStyle !== null && sameStyle.products.length > 0">
            <SectionHeader title="同款式" />
            <view :style="sameStyleCard">
              <view :style="sameStyleHeader">
                <text :style="sameStyleName">{{ sameStyle!.canonicalName }}</text>
                <text :style="sameStyleBrand">{{ sameStyle!.brandName }}</text>
              </view>
              <scroll-view direction="horizontal" :show-scrollbar="false" :style="sameStyleScroll">
                <view :style="sameStyleRow">
                  <view v-for="s in sameStyle!.products" :key="s.id" :style="sameStyleItem" @tap="openSameStyle(s.id)">
                    <AppImage :src="s.coverUrl" :style="sameStyleImage" mode="aspectFill" />
                    <text :style="sameStyleTitle">{{ s.title }}</text>
                    <text :style="sameStylePrice">{{ s.price > 0 ? formatMoney(s.price) : '价格待定' }}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </template>

          <template v-if="realBuyerPosts.length > 0">
            <SectionHeader title="相关动态" />
            <view :style="buyerCard">
              <scroll-view direction="horizontal" :show-scrollbar="false" :style="buyerScroll">
                <view :style="buyerRow">
                  <view v-for="p in realBuyerPosts" :key="p.id" :style="buyerItem" @tap="openBuyerPost(p.id)">
                    <AppImage :src="p.imageUrl" :style="buyerImage" mode="aspectFill" />
                    <text :style="buyerAuthor">{{ p.authorNickname }}</text>
                    <text :style="buyerCaption">{{ p.caption !== '' ? p.caption : '上身返图' }}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </template>

          <view :style="actionSpacer" />
        </view>
      </view>
      <view v-else :style="emptyWrap">
        <PageState icon="info" :title="errorMessage !== '' ? errorMessage : '商品信息不存在'" action-text="重新加载" @action="loadDetail" />
      </view>
    </template>
  </MainLayout>
    <view v-if="item !== null" :style="botBar">
    <view :style="botItem" @tap="toggleSaved">
      <view :style="botIcon"><AppIcon name="heart" :size="40" :active="isSaved" /></view>
      <text :style="botLabel">{{ isSaved ? '已收藏' : '收藏' }}</text>
    </view>
    <view :style="botItem" @tap="createReminder">
      <view :style="botIcon"><AppIcon name="reminder" :size="40" :active="true" /></view>
      <text :style="botLabel">设置提醒</text>
    </view>
    <view :style="botItem" @tap="onShareTap">
      <view :style="botIcon"><AppIcon name="share" :size="40" :active="true" /></view>
      <text :style="botLabel">分享</text>
    </view>
    <view :style="goBtn" @tap="openOfficial"><text :style="goBtnText">前往原店</text></view>
  </view>
</template>

<script setup lang="uts">
import { isComparisonProduct } from '@/services/mock/comparison-products'
import { computed } from 'vue'
import { FeedItem } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
import { extractImageUrls } from '@/domain/content/product'
import { StyleInfo } from '@/domain/content/style'
import { ProductVariant } from '@/domain/content/product-variant'
import { deriveReleaseStatusText, formatPriceSummaryByType, getPitTypeLabel } from '@/presentation/content/feed-presenter'
import { fetchStyle } from '@/services/content/style-service'
import { fetchProductCommunity, ProductCommunityPost } from '@/services/content/product-service'
import { useProductDetailStore } from '@/stores/product-detail-store'
import { formatPrice } from '@/stores/home-feed-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useSessionStore } from '@/stores/session-store'
import { baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight, v3TextStyle } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import { zIndex } from '@/theme/tokens/z-index'
import { getSafeBottomInset, upx2px } from '@/utils/window-info'
import { recordBrowse } from '@/stores/browse-history-store'
import { shareByCopy } from '@/utils/share'
import { showFeedback } from '@/utils/feedback'
import { useBlacklistStore } from '@/stores/blacklist-store'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import PageSkeleton from '@/components/v3/PageSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'

const itemId = ref('')
const item = ref(null) as Ref<FeedItem | null>
const loading = ref(true)
const errorMessage = ref('')
const shopUrl = ref('')
const shopName = ref('')
// 收藏态：与收藏页共用 content-library-store 统一数据源（后端 /api/v1/wishlist）
const library = useContentLibraryStore()
const session = useSessionStore()
const productDetailStore = useProductDetailStore()
const blacklist = useBlacklistStore()
const isSaved = computed((): boolean => item.value !== null && library.isFavorite(item.value!.entityId))
// 真实发售批次（后端 currentRelease → ReleaseEvent）：发售状态/时间/金额的唯一事实源，禁止 badgeText 猜测
const currentRelease = ref(null) as Ref<ReleaseEvent | null>
const release = computed((): ReleaseEvent | null => currentRelease.value)
const currentImageIndex = ref(0)
// Phase 2.1 同款式：商品绑定 groupKey 时加载款式信息（12-table: styles 表已废弃，保持 null，模块不显示）
const sameStyle = ref(null) as Ref<StyleInfo | null>
// Phase 2.3-A 真实买家：商品关联社区返图（空数组 = 模块不显示；失败静默不阻塞详情）
const realBuyerPosts = ref([]) as Ref<ProductCommunityPost[]>
// ====== Product V2 展示字段（Raw → Normalize → Product；详情页只消费 Product 层） ======
const priceType = ref('UNKNOWN')
const depositCents = ref(0)
const balanceCents = ref(0)
const pitType = ref('')
const subCategory = ref('')
const colorTags = ref([]) as Ref<string[]>
const materialTags = ref([]) as Ref<string[]>
const featureTags = ref([]) as Ref<string[]>
const variants = ref([]) as Ref<ProductVariant[]>

/** 价格摘要（price_type 语义，与商品卡一致）：FULL「¥368」/ DEPOSIT「定金 ¥100 · 全款 ¥368」/ BALANCE「尾款 ¥268」/ INTENTION「意向金 ¥1」/ UNKNOWN 空 */
const priceSummaryText = computed((): string => {
  if (item.value === null) return ''
  const full = currentRelease.value != null && currentRelease.value!.fullPrice > 0 ? currentRelease.value!.fullPrice : item.value!.fullPriceCents
  return formatPriceSummaryByType(priceType.value, item.value!.price, full, depositCents.value, balanceCents.value)
})
/** 三坑类型展示名 */
const pitTypeLabel = computed((): string => getPitTypeLabel(pitType.value))
/** 可选款式：规格变体提取去重。
 *  Lolita 一个链接常同时卖 JSK + OP —— 对这类商品，款式是**规格**（与颜色/尺码同级、可多选），不是分类标签。
 *  命名用「款式」：用户明确否掉了「型别」（口语书面都不会这么说），也去掉了「可选」前缀（规格卡里已有多余）。 */
function styleQuote(style: string): string {
  const prices: number[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const v = variants.value[i]
    if (v.styleName === style && v.referencePriceCents != null && prices.indexOf(v.referencePriceCents!) < 0) prices.push(v.referencePriceCents!)
  }
  if (prices.length === 0) return style
  prices.sort((a: number, b: number): number => a - b)
  const low = (prices[0] / 100).toString()
  const high = (prices[prices.length - 1] / 100).toString()
  return style + ' · 参考价 ¥' + low + (low === high ? '' : '–' + high)
}
const styleOptions = computed((): string[] => {
  const list: string[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const s = variants.value[i].styleName
    if (s !== '' && list.indexOf(s) < 0) list.push(s)
  }
  return list
})
/** 可选尺码：款式变体提取去重（variants 无数据则不显示尺码模块） */
const sizeOptions = computed((): string[] => {
  const sizes: string[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const s = variants.value[i].sizeName
    if (s !== '' && sizes.indexOf(s) < 0) sizes.push(s)
  }
  return sizes
})
/** 材质摘要（只展示 material_summary，不搬淘宝详情页） */
const materialSummary = computed((): string => {
  if (materialTags.value.length === 0) return ''
  return materialTags.value.join('、')
})
const releaseBatchText = computed((): string => {
  const r = currentRelease.value
  if (r == null) return ''
  const text = r.title.trim()
  if (['预约批', '现货批', '预售批', '预约', '现货', '预售'].indexOf(text) >= 0 || text === releaseStatusText.value) return ''
  return text
})
/** 商品说明（description；无数据不显示） */
const descriptionText = computed((): string => {
  if (item.value === null) return ''
  const text = item.value!.subtitle.trim()
  if (text.indexOf('展示价格、发售、收藏、提醒和购买记录。') >= 0) return ''
  return text
})
/** 出货时间（release.shipAt；无数据不显示） */
const shipDateText = computed((): string => {
  const r = currentRelease.value
  return r != null ? dateOnly(r.shipAt) : ''
})
/** 预售/发售时间区间（release.startAt ~ endAt） */
const releaseStartText = computed((): string => {
  const r = currentRelease.value
  if (r == null) return ''
  const start = dateOnly(r.startAt)
  const end = dateOnly(r.endAt)
  if (start === '' && end === '') return ''
  if (start === '') return end
  if (end === '') return start
  return `${start} ~ ${end}`
})
const releaseStatusText = computed((): string => deriveReleaseStatusText(currentRelease.value))
function formatMoney(cents: number): string { return formatPrice(cents) }
  const detailImages = ref<string[]>([])

 function onGalleryChange(e: any) {
   const eObj = e as UTSJSONObject
   const detail = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
   const current = detail != null && detail['current'] != null ? detail['current'] as number : 0
   currentImageIndex.value = current
 }
function previewGallery() {
  if (detailImages.value.length === 0) return
  uni.previewImage({ current: detailImages.value[currentImageIndex.value], urls: detailImages.value })
}

/** 同款式商品跳转（Phase 2.1） */
function openSameStyle(productId: string) {
  if (productId === '') return
  uni.navigateTo({ url: `/pages/product/detail?id=${productId}` })
}

/** 真实买家返图：复用社区内容预览机制（大图预览，不重做社区详情页） */
function openBuyerPost(postId: string) {
  const post = realBuyerPosts.value.find((p) => p.id === postId)
  if (post == null || post.imageUrl === '') return
  uni.previewImage({ current: post.imageUrl, urls: [post.imageUrl] })
}

function isLoggedIn(): boolean {
  // Mock 内测会话也算已登录：收藏写入本地（不请求受保护接口），正式会话走远程 wishlist
  return session.isLoggedIn
}

function toggleSaved() {
  if (isComparisonProduct(itemId.value)) { showFeedback('展示样例不保存收藏'); return }
  if (item.value === null) return
  const entityId = item.value!.entityId
  if (entityId === '') return

  if (!isLoggedIn()) {
    showFeedback('请先登录后收藏')
    return
  }

  // 统一数据源：content-library-store → 后端 /api/v1/wishlist（失败自动入队，恢复后重放）
  // releaseId：用户当前关注的发售批次（详情页 currentRelease 存在时提交，供收藏页锚定该批次）
  const r = currentRelease.value
  const saved = library.toggleFavorite(entityId, item.value!.title, r != null ? r.id : '')
  showFeedback(saved ? '已收进心动收藏' : '已移出收藏')
}

/** 导航栏「…」更多菜单：低频/负向动作收进来（分享、屏蔽品牌）。
 *  原先"屏蔽品牌"做成品牌行里的粉色小胶囊，等于让低频负向操作占了主信息行 —— 已搬走。 */
function onMoreTap() {
  if (item.value === null) return
  const name = item.value!.brandName
  const blocked = name !== '' && blacklist.isBlacklisted(name)
  const itemList: string[] = name !== ''
    ? ['分享商品', blocked ? '恢复该品牌' : '屏蔽该品牌']
    : ['分享商品']
  uni.showActionSheet({
    itemList: itemList,
    success: (res) => {
      if (res.tapIndex === 0) { onShareTap(); return }
      if (res.tapIndex === 1) onToggleBlacklist()
    },
  })
}

function onToggleBlacklist() {
  if (item.value === null) return
  const name = item.value!.brandName
  if (name === '') { showFeedback('该商品暂无品牌信息'); return }
  const blocked = blacklist.toggleBlacklist(name)
  showFeedback(blocked ? `已屏蔽品牌：${name}` : `已恢复品牌：${name}`)
}

function openOfficial() {
  if (shopUrl.value === '') { showFeedback('暂未收录原店链接'); return }
  // #ifdef APP
  plus.runtime.openURL(shopUrl.value)
  return
  // #endif
  // 小程序/H5 无统一外部浏览器能力，复制链接作为可靠降级。
  uni.setClipboardData({ data: shopUrl.value, success: () => { showFeedback('原店链接已复制，可在浏览器打开') } })
}

/** 分享：复制标题 + 价格/品牌 + 原店链接（有则带上） */
function onShareTap() {
  if (item.value === null) return
  const detail = priceSummaryText.value !== '' ? `${item.value!.brandName !== '' ? item.value!.brandName + ' · ' : ''}${priceSummaryText.value}` : item.value!.brandName
  shareByCopy(item.value!.title, detail, shopUrl.value)
}

function dateOnly(value: string): string {
  if (value === '') return ''
  return value.length >= 10 ? value.substring(0, 10) : value
}

function encoded(value: string): string { return encodeURIComponent(value) ?? '' }

function createReminder() {
  if (isComparisonProduct(itemId.value)) { showFeedback('展示样例不创建提醒'); return }
  if (item.value === null) return
  const r = currentRelease.value
  // 尾款期 → 尾款提醒；其余 → 发售提醒（基于真实 release 状态，非 badgeText）
  const type = releaseStatusText.value === '尾款' ? 'BALANCE' : 'RELEASE'
  const title = `${item.value!.title} ${releaseStatusText.value !== '' ? releaseStatusText.value : '发售'}`
  const note = `${item.value!.brandName} · 来源于商品详情`
  const date = r != null ? (type === 'BALANCE' ? r.balanceDueAt : r.startAt) : ''
  uni.navigateTo({ url: `/pages/reminder/edit?title=${encoded(title)}&type=${type}&date=${encoded(date)}&note=${encoded(note)}&productId=${encoded(itemId.value)}&releaseId=${encoded(r != null ? r.id : '')}` })
}


async function loadDetail() {
  loading.value = true
  errorMessage.value = ''
  currentImageIndex.value = 0
  try {
    const result = await productDetailStore.load(itemId.value)
    if (unmounted) return
    if (result === null) { item.value = null; errorMessage.value = '商品信息不存在'; return }
    item.value = result.item
    // 12-table: images is ProductImage[], extract URL strings for swiper
    detailImages.value = extractImageUrls(result.images)
    // 浏览足迹：加载成功即记入本机（不同步服务器），供「我的 → 浏览历史」找回
    if (!isComparisonProduct(itemId.value)) recordBrowse(result.item.entityId, result.item.title, result.item.brandName, result.item.coverUrl)
    shopUrl.value = result.shopUrl
    shopName.value = result.shopName
    currentRelease.value = result.currentRelease
    // ====== Product V2 展示字段赋值 ======
    priceType.value = result.priceType
    depositCents.value = result.depositCents
    balanceCents.value = result.balanceCents
    pitType.value = result.pitType
    subCategory.value = result.subCategory
    colorTags.value = result.colorTags
    materialTags.value = result.materialTags
    featureTags.value = result.featureTags
    variants.value = result.variants
    // 同款式：仅当商品已归并（styleId 非空）时加载；失败静默（不阻塞详情）
    sameStyle.value = null
    if (result.groupKey !== '') {
      // 12-table: styles table removed; sameStyle UI gracefully hidden (fetchStyle returns null)
      fetchStyle(result.groupKey).then((style: StyleInfo | null) => {
        if (unmounted) return
        sameStyle.value = style
      }).catch(() => {})
    }
    // 真实买家：商品关联社区返图（空 = 模块隐藏）；失败静默不阻塞详情
    realBuyerPosts.value = []
    fetchProductCommunity(itemId.value).then((posts: ProductCommunityPost[]) => {
      if (unmounted) return
      realBuyerPosts.value = posts
    }).catch(() => {})
    if (isLoggedIn()) {
      library.refreshRemoteFavorites().catch(() => {
        if (!unmounted) showFeedback('商品已加载，收藏状态暂未同步')
      })
    }
  } catch (e) {
    if (unmounted) return
    item.value = null
    detailImages.value = []
    errorMessage.value = e instanceof Error ? e.message : '商品加载失败'
  } finally {
    if (unmounted) return
    loading.value = false
  }
}

// 页面卸载后丢弃异步回调，避免写入已销毁实例的 ref
let unmounted = false
onUnload(() => { unmounted = true })

onLoad((options) => {
  initPageTheme()
  itemId.value = options != null && options['id'] != null ? options['id'] as string : ''
  if (itemId.value === '') { loading.value = false; errorMessage.value = '缺少商品信息'; return }
  loadDetail()
})

const safeBottom = getSafeBottomInset()
const pageWrap = { paddingTop: '0', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
// 导航栏「…」按钮：88rpx 热区（低频动作入口，不做小字）
const navMoreBtn = { width: '88rpx', height: '88rpx', alignItems: 'center', justifyContent: 'center' }
const heroWrap = computed((): any => ({ width: '750rpx', height: '720rpx', position: 'relative' as string, backgroundColor: n.value.bgSecondary, overflow: 'hidden' }))
const hero = { width: '750rpx', height: '720rpx' }
const imageCounter = { position: 'absolute' as string, right: '30rpx', bottom: '32rpx', minWidth: '84rpx', height: '48rpx', paddingLeft: '16rpx', paddingRight: '16rpx', borderRadius: '24rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: baseColors.black }
const imageCounterText = { fontSize: '22rpx', fontWeight: fontWeight.medium, color: baseColors.white }
// V3 §6.10 信息区 32rpx 边距；信息卡圆角 20rpx（列表组级）
const summaryCard = computed((): any => ({ marginTop: '20rpx', padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface }))
const priceRow = { ...flexRow, alignItems: 'flex-end' }
const priceText = computed((): any => ({ fontSize: v3TextStyle.priceLarge.fontSize, fontWeight: v3TextStyle.priceLarge.fontWeight, color: n.value.iconActive }))
const titleText = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, lineHeight: '44rpx', marginTop: '14rpx' }))
const brandText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginRight: '12rpx', minWidth: '0', flexShrink: 1, lines: 1, textOverflow: 'ellipsis' }))
// 品牌 / 坑向 / 子分类同排：允许换行 + 统一 12rpx 间隔，避免"一个内容紧接下一个内容"（用户反馈）
const brandRow = { flexDirection: 'row' as string, alignItems: 'center', flexWrap: 'nowrap' as string, marginTop: '12rpx' }
// 品牌行内小标签：坑向（品牌浅底）+ 子分类（中性底），与商品卡 typeChip 同构
const pitChip = computed((): any => ({ marginRight: '12rpx', paddingLeft: '14rpx', paddingRight: '14rpx', height: '40rpx', borderRadius: '20rpx', backgroundColor: n.value.surfacePink, alignItems: 'center', justifyContent: 'center', flexShrink: 0 }))
// 品牌色文字/前景一律走主题 token（n.value.iconActive），不再用模块级 brand[600]
// —— 模块常量在深色下不刷新，暖黑底上对比度只有约 2.7:1，等于"看不清"。
const pitChipText = computed((): any => ({ fontSize: '20rpx', fontWeight: fontWeight.medium, color: n.value.iconActive }))
const subChip = computed((): any => ({ marginRight: '12rpx', paddingLeft: '14rpx', paddingRight: '14rpx', height: '40rpx', borderRadius: '20rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', flexShrink: 0 }))
const subChipText = computed((): any => ({ fontSize: '20rpx', fontWeight: fontWeight.medium, color: n.value.textSecondary }))
const blacklistBtn = computed((): any => ({ height: '44rpx', paddingLeft: '16rpx', paddingRight: '16rpx', borderRadius: '22rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '12rpx', marginBottom: '8rpx' }))
const blacklistBtnText = computed((): any => ({ fontSize: '20rpx', fontWeight: fontWeight.medium, color: n.value.iconActive }))
const blockedBanner = computed((): any => ({ marginTop: '16rpx', padding: '16rpx', borderRadius: '12rpx', backgroundColor: n.value.surfacePink }))
const blockedBannerText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.iconActive, lineHeight: '32rpx' }))
// 卖点标签：中性底、可换行（数量不定，不用横向滚动）
// 卖点标签行的样式已随该行一并删除（2026-09-14）
// 发售信息卡：仅展示真实 release 数据（批次/时间/定金/尾款/全价），无数据不显示、不伪造、不显示 0
const releaseCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const releaseRow = { flexDirection: 'row' as string, alignItems: 'center', justifyContent: 'space-between', minHeight: '56rpx' }
const releaseLabel = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary }))
const releaseValue = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.medium, color: n.value.text, marginLeft: '24rpx' }))
// 规格卡：左侧固定标签列 + 右侧可换行 chip 组（颜色/尺码共用）
const specCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const specRow = { flexDirection: 'row' as string, alignItems: 'flex-start' as string, marginBottom: '12rpx' }
const specLabel = computed((): any => ({ width: '148rpx', flexShrink: 0, paddingTop: '10rpx', fontSize: fontSize.xs, color: n.value.textSecondary }))
const specChips = { flex: 1, flexDirection: 'row' as string, flexWrap: 'wrap' as string }
const specChip = computed((): any => ({ height: '48rpx', paddingLeft: '18rpx', paddingRight: '18rpx', borderRadius: '12rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '10rpx', marginBottom: '10rpx' }))
const specChipText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.text }))
// Phase 2.1 同款式：款式名 + 横向滚动同款商品（无 groupKey / styles 表已废弃时不渲染）
const sameStyleCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const sameStyleHeader = { ...flexRow, alignItems: 'center', marginBottom: '16rpx' }
const sameStyleName = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const sameStyleBrand = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginLeft: '12rpx' }))
const sameStyleScroll = { width: '100%', whiteSpace: 'nowrap' as string }
const sameStyleRow = { flexDirection: 'row' as string, alignItems: 'flex-start' as string }
const sameStyleItem = { width: '200rpx', marginRight: '16rpx', flexShrink: 0 }
const sameStyleImage = computed((): any => ({ width: '200rpx', height: '260rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary }))
const sameStyleTitle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.text, marginTop: '8rpx', whiteSpace: 'normal' as string, overflow: 'hidden', textOverflow: 'ellipsis', lines: 2, lineHeight: '34rpx' }))
// 价格走主题色（拍板 B，与榜单卡一致），旧写法 brand[500] 深色下不刷新
const sameStylePrice = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.iconActive, marginTop: '4rpx' }))
// Phase 2.3-A 真实买家：横向返图卡片（与同款式模块同构，V3 §6.4 卡片风格）
const buyerCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const buyerScroll = { width: '100%', whiteSpace: 'nowrap' as string }
const buyerRow = { flexDirection: 'row' as string, alignItems: 'flex-start' as string }
const buyerItem = { width: '200rpx', marginRight: '16rpx', flexShrink: 0 }
const buyerImage = computed((): any => ({ width: '200rpx', height: '260rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary }))
const buyerAuthor = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '8rpx', whiteSpace: 'normal' as string, overflow: 'hidden', textOverflow: 'ellipsis', lines: 1 }))
const buyerCaption = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '4rpx', whiteSpace: 'normal' as string, overflow: 'hidden', textOverflow: 'ellipsis', lines: 1, lineHeight: '32rpx' }))
const detailCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface }))
const detailText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '42rpx' }))
// 底部栏高度改为「内容驱动」：原来写死 160rpx，图标下方会留出约 70px 空白
// 底部留白 = 底部栏真实高度（paddingTop 12rpx + 内容 88rpx + paddingBottom(safeBottom+12)px）+ 24rpx 呼吸间距。
// 旧值只预留 upx2px(124)≈62px，小于底部栏实际高度 → 「相关动态」卡下边缘会贴死操作栏（用户反馈"贴紧了没间隔"）。
const actionSpacer = computed((): any => ({ height: `${upx2px(100) + safeBottom + 12 + upx2px(24)}px`, flexShrink: 0 }))
// 加载/失败使用 V3 PageSkeleton / PageState
const emptyWrap = { flex: 1, alignItems: 'center', justifyContent: 'center' }
// V3 §6.10 底部固定：收藏 / 设置提醒 / 前往官方渠道（避开安全区）
const botBar = computed((): any => ({ position: 'fixed', left: '0', right: '0', bottom: '0', zIndex: zIndex.navbar, paddingLeft: '24rpx', paddingRight: '24rpx', paddingTop: '12rpx', paddingBottom: `${safeBottom + 12}px`, ...flexRow, alignItems: 'center', backgroundColor: n.value.surface, borderTopWidth: '1rpx', borderTopStyle: 'solid', borderTopColor: n.value.border }))
const botItem = { width: '100rpx', minHeight: '88rpx', alignItems: 'center', justifyContent: 'center' }
const botIcon = { width: '48rpx', height: '48rpx', alignItems: 'center', justifyContent: 'center' }
const botLabel = computed((): any => ({ fontSize: '20rpx', color: n.value.textSecondary, marginTop: '4rpx' }))
const goBtn = computed((): any => ({ ...flexFill, height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.iconActive, alignItems: 'center', justifyContent: 'center', marginLeft: '24rpx' }))
const goBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>



