const releaseValue = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.medium, color: n.value.text, marginLeft: '24rpx' }))
// 规格卡：左侧固定标签列 + 右侧可换行 chip 组（颜色/尺码共用）
const specCard = computed((): any => ({ ...CARD_GAP, padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const specRow = { flexDirection: 'row' as string, alignItems: 'flex-start' as string, marginBottom: '12rpx' }
const specLabel = computed((): any => ({ width: '148rpx', flexShrink: 0, paddingTop: '10rpx', fontSize: fontSize.xs, color: n.value.textSecondary }))
const specChips = { flex: 1, flexDirection: 'row' as string, flexWrap: 'wrap' as string }
const specChip = computed((): any => ({ height: '48rpx', paddingLeft: '18rpx', paddingRight: '18rpx', borderRadius: '12rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '10rpx', marginBottom: '10rpx' }))
const specChipText = computed((): any => ({ fontSize: fontSize.xs, color: n.value.text }))
// 款式价格 chip：与颜色/尺码 chip 同构（灰底圆角），价格红色区分
const styleChip = computed((): any => ({ flexDirection: 'row' as string, alignItems: 'center', height: '48rpx', paddingLeft: '18rpx', paddingRight: '18rpx', borderRadius: '12rpx', backgroundColor: n.value.bgSecondary, marginRight: '10rpx', marginBottom: '10rpx' }))
const styleChipName = computed((): any => ({ fontSize: fontSize.xs, color: n.value.text }))
const styleChipPrice = computed((): any => ({ marginLeft: '10rpx', fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.iconActive }))
// Phase 2.1 同款式：款式名 + 横向滚动同款商品（无 groupKey / styles 表已废弃时不渲染）
const sameStyleCard = computed((): any => ({ ...CARD_GAP, padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const sameStyleHeader = { ...flexRow, alignItems: 'center', marginBottom: '16rpx' }
const sameStyleName = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const sameStyleBrand = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginLeft: '12rpx' }))
const sameStyleScroll = { width: '100%', whiteSpace: 'nowrap' as string }
const sameStyleRow = { flexDirection: 'row' as string, alignItems: 'flex-start' as string }
const sameStyleItem = { width: '200rpx', marginRight: '16rpx', flexShrink: 0 }
const sameStyleImage = computed((): any => ({ width: '200rpx', height: '260rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary }))
const sameStyleTitle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.text, marginTop: '8rpx', whiteSpace: 'normal' as string, overflow: 'hidden', textOverflow: 'ellipsis', lines: 2, lineHeight: '34rpx' }))
// 价格走主题色（拍板 B，与榜单卡一致），旧写法 brand[500] 深色下不刷新
const sameStylePrice = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.iconActive, marginTop: '4rpx' }))
// Phase 2.3-A 真实买家：横向返图卡片（与同款式模块同构，V3 §6.4 卡片风格）
const buyerCard = computed((): any => ({ ...CARD_GAP, padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
const buyerScroll = { width: '100%', whiteSpace: 'nowrap' as string }
const buyerRow = { flexDirection: 'row' as string, alignItems: 'flex-start' as string }
const buyerItem = { width: '200rpx', marginRight: '16rpx', flexShrink: 0 }
const buyerImage = computed((): any => ({ width: '200rpx', height: '260rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary }))
const buyerAuthor = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '8rpx', whiteSpace: 'normal' as string, overflow: 'hidden', textOverflow: 'ellipsis', lines: 1 }))
const buyerCaption = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '4rpx', whiteSpace: 'normal' as string, overflow: 'hidden', textOverflow: 'ellipsis', lines: 1, lineHeight: '32rpx' }))
const detailCard = computed((): any => ({ ...CARD_GAP, padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface }))
const detailText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '42rpx' }))
// 底部栏高度改为「内容驱动」：原来写死 160rpx，图标下方会留出约 70px 空白
// 底部留白 = 底部栏真实高度（paddingTop 12rpx + 内容 88rpx + paddingBottom(safeBottom+12)px）+ 24rpx 呼吸间距。
// 旧值只预留 upx2px(124)≈62px，小于底部栏实际高度 → 「相关动态」卡下边缘会贴死操作栏（用户反馈"贴紧了没间隔"）。
const actionSpacer = computed((): any => ({ height: `${upx2px(100) + safeBottom + 12 + upx2px(24)}px`, flexShrink: 0 }))
// 加载/失败使用 V3 PageSkeleton / PageState
const emptyWrap = { flex: 1, alignItems: 'center', justifyContent: 'center' }
// V3 §6.10 底部固定：收藏 / 设置提醒 / 前往官方渠道（避开安全区）
const botBar = computed((): any => ({ position: 'fixed', left: '0', right: '0', bottom: '0', zIndex: zIndex.navbar, paddingLeft: '24rpx', paddingRight: '24rpx', paddingTop: '12rpx', paddingBottom: `${safeBottom + 12}px`, ...flexRow, alignItems: 'center', backgroundColor: n.value.surface, borderTopWidth: '1rpx', borderTopStyle: 'solid', borderTopColor: n.value.border }))
const botItem = { width: '100rpx', minHeight: '88rpx', alignItems: 'center', justifyContent: 'center' }
const botIcon = { width: '48rpx', height: '48rpx', alignItems: 'center', justifyContent: 'center' }
const botLabel = computed((): any => ({ fontSize: '20rpx', color: n.value.textSecondary, marginTop: '4rpx' }))
const goBtn = computed((): any => ({ ...flexFill, height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.iconActive, alignItems: 'center', justifyContent: 'center', marginLeft: '24rpx' }))
const goBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>

