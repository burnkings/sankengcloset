// Phase 2.1 同款式：款式名 + 横向滚动同款商品（无 styleId 时不渲染）
const sameStyleCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border }))
