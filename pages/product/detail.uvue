<template>
  <MainLayout navbar-content-height="88rpx" bottom-spacer="0rpx">
    <template #navbar>
      <AppNavbar title="商品详情" :show-back="true">
        <template #right>
          <view v-if="item !== null" :style="navMoreBtn" @tap="onMoreTap"><AppIcon name="more" :size="40" /></view>
        </template>
      </AppNavbar>
    </template>
    <template #default>
      <view v-if="loading" :style="emptyWrap"><PageSkeleton variant="detail" /></view>
      <view v-else-if="item !== null">
        <view :style="heroWrap">
          <swiper :style="hero" :circular="detailImages.length > 1" :indicator-dots="false" @change="onGalleryChange">
            <swiper-item v-for="imageUrl in detailImages" :key="imageUrl" @tap="previewGallery">
              <AppImage :src="imageUrl" width="100%" height="100%" mode="aspectFit" :lazy-load="true" />
            </swiper-item>
          </swiper>
          <view v-if="detailImages.length > 1" :style="imageCounter"><text :style="imageCounterText">{{ currentImageIndex + 1 }} / {{ detailImages.length }}</text></view>
        </view>

        <view class="page-canvas" :style="pageWrap">
          <view :style="summaryCard">
            <!-- 标题 / 品牌 两行在左，价格在右并**垂直居中于这两行之间**（2026-10-08 用户三次口径：
                 价格字体大 ⇒ 让它独占一行会变三行、与标题同行又会把行高撑成「两行半」；
                 让它吃掉两行中间的高度，整体**仍然是两行**。 -->
            <view :style="headRow">
              <view :style="headLeft">
                <text :style="titleText">{{ item!.title }}</text>
                <view :style="brandRow">
                  <!-- 品牌名可点：直接进品牌商品页（原来品牌只是一段纯文本，看着像能点却没反应）。
                       没有品牌 id 时才退回纯文本，避免点了跳到空页。 -->
                  <view v-if="brandId !== ''" :style="brandTap" @tap="openBrand">
                    <text :style="brandText">{{ brandNameText }}</text>
                    <AppIcon name="chevron-right" :size="20" />
                  </view>
                  <text v-else :style="brandText">{{ brandNameText }}</text>
                  <view v-if="subCategory !== ''" :style="subChip"><text :style="subChipText">{{ subCategory }}</text></view>
                  <!-- 发货说明**不再在这里做胶囊**（2026-10-08）：它已统一到商品级、属于「销售状态」的一部分，
                       只在下面「发售信息 → 发货说明」显示一行。此前商品级为空、只有批次级有值，
                       所以这里从没显示过；现在两级合一后若保留会与那行重复。 -->
                  <!-- 屏蔽品牌（负向、低频）已移入导航栏「…」菜单；只有"已被屏蔽"时才在这里给恢复入口 -->
                  <view v-if="item!.brandName !== '' && blacklist.isBlacklisted(item!.brandName)" :style="blacklistBtn" @tap="onToggleBlacklist">
                    <text :style="blacklistBtnText">已屏蔽·恢复</text>
                  </view>
                </view>
              </view>
              <text v-if="priceDisplayText !== ''" :style="priceText">{{ priceDisplayText }}</text>
            </view>
            <!-- 原来此处还有一行「卖点标签」—— 与「发售信息 → 当前状态」重复，2026-09-14 按反馈删除。
                 标签数据（featureTags）仍从服务端接收，留给后续筛选/搜索用。 -->
            <view v-if="blacklist.isBlacklisted(item!.brandName)" :style="blockedBanner">
              <text :style="blockedBannerText">该品牌已被你屏蔽，首页、搜索与收藏中将不再展示。可点上方「已屏蔽·恢复」取消。</text>
            </view>
            <!-- 原先此处还有一个孤立的状态胶囊（只写「尾款」两个字、无上下文），
                 与下方「发售信息 → 当前状态」完全重复，2026-09-13 按用户反馈删除：
                 发售状态统一由「发售信息」卡承载，摘要卡只放 价格/品牌/标签/搭配度。 -->
            <!-- 搭配度模块已整体下线（2026-09-14）：算法为启发式 v1，不适合以百分比上线，等排期重做。
                 算法文件 services/ai/wardrobe-compatibility-service.uts 一并删除（git 历史可恢复）。 -->
          </view>
          <template v-if="release !== null">
            <!-- 发售信息卡（2026-10-06 按设计稿重构）。
                 结构：标题 + 副标题 → 当前状态 / 预售时间 / 出货时间 → 实线 →
                       「发售批次 · 共 N 批」→ 逐批两行（名称+时间 / 价格）→ 虚线 + 排序说明。
                 为什么多批次要给全量视图：热门款常同时挂着一团（已截团）、二团（预约中）、现货掉落，
                 第一眼要能回答「现在能买哪一批」，同时又能翻出已结束批次比价。 -->
            <view :style="releaseCard">
              <view :style="releaseHeaderRow">
                <text :style="releaseTitle">发售信息</text>
              </view>
              <view v-if="releaseStatusText !== ''" :style="releaseRow"><text :style="releaseLabel">当前状态</text><text :style="releaseValue">{{ releaseStatusText }}</text></view>
              <view v-if="releaseBatchText !== ''" :style="releaseRow"><text :style="releaseLabel">批次</text><text :style="releaseValue">{{ releaseBatchText }}</text></view>
              <view v-if="releaseStartText !== ''" :style="releaseRow"><text :style="releaseLabel">预售时间</text><text :style="releaseValue">{{ releaseStartText }}</text></view>
              <view v-if="shipDateText !== ''" :style="releaseRow"><text :style="releaseLabel">出货时间</text><text :style="releaseValue">{{ shipDateText }}</text></view>
              <!-- 发货说明：运营手写的时效承诺（「7天内发货」这类）。它**不是预售**，属于现货的发货承诺，
                   所以放在出货时间下面单独一行，不掺进状态里。 -->
              <view v-if="shippingNoteText !== ''" :style="releaseRow"><text :style="releaseLabel">发货说明</text><text :style="releaseValue">{{ shippingNoteText }}</text></view>

              <!-- 多批次：现货排最前、预约中次之、已结束置底；已结束整块转灰，价格保留 -->
              <template v-if="batchList.length > 1">
                <view :style="releaseDivider"></view>
                <view :style="releaseRow">
                  <text :style="releaseLabel">发售批次</text>
                  <text :style="releaseValue">共 {{ batchList.length }} 批</text>
                </view>
                <view v-for="b in batchList" :key="b.id" :style="batchRowStyle">
                  <view :style="batchHeadRow">
                    <text :style="batchNameStyle(b.saleStatus)">{{ batchTitle(b) }}</text>
                    <text :style="batchDateStyle(b.saleStatus)">{{ batchDateText(b) }}</text>
                  </view>
                  <text v-if="batchPriceText(b) !== ''" :style="batchPriceStyle(b.saleStatus)">{{ batchPriceText(b) }}</text>
                </view>
                <view :style="releaseDashedDivider"></view>
                <text :style="releaseFootnote">排序：现货 → 预约中 → 已结束。已结束的整块转灰，仍保留价格供你比价。</text>
              </template>
            </view>
          </template>

          <template v-if="styleOptions.length > 0 || colorOptions.length > 0 || sizeOptions.length > 0">
            <SectionHeader title="规格" />
            <view :style="specCard">
              <view v-if="styleOptions.length > 0" :style="specRow">
                <text :style="specLabel">款式</text>
                <view v-if="hasStylePrices" :style="specChips">
                  <view v-for="st in styleOptions" :key="st" :style="styleChip">
                    <text :style="styleChipName">{{ st }}</text>
                    <text v-if="stylePriceText(st) !== ''" :style="styleChipPrice">{{ stylePriceText(st) }}</text>
                  </view>
                </view>
                <view v-else :style="specChips">
                  <view v-for="st in styleOptions" :key="st" :style="specChip"><text :style="specChipText">{{ st }}</text></view>
                </view>
              </view>
              <!-- 颜色来自「规格选项」里的颜色项（2026-10-06）。
                   原先这里读的是 color_tags 那一列（运营后台的「颜色标签」），已被删除：
                   它跟规格里的颜色是两个东西，且运营确认不需要单独填 ⇒ 统一由规格驱动。 -->
              <view v-if="colorOptions.length > 0" :style="specRow">
                <text :style="specLabel">颜色</text>
                <view :style="specChips">
                  <view v-for="c in colorOptions" :key="c" :style="specChip"><text :style="specChipText">{{ c }}</text></view>
                </view>
              </view>
              <view v-if="sizeOptions.length > 0" :style="specRow">
                <text :style="specLabel">尺码</text>
                <view :style="specChips">
                  <view v-for="s in sizeOptions" :key="s" :style="specChip"><text :style="specChipText">{{ s }}</text></view>
                </view>
              </view>
            </view>
          </template>

          <!-- 材质区块已于 2026-10-09 硬删除（字段 products.material_tags 同步删列） -->

          <template v-if="sameStyle !== null && sameStyle.products.length > 0">
            <SectionHeader title="同款式" />
            <view :style="sameStyleCard">
              <view :style="sameStyleHeader">
                <text :style="sameStyleName">{{ sameStyle!.canonicalName }}</text>
                <text :style="sameStyleBrand">{{ sameStyle!.brandName }}</text>
              </view>
              <scroll-view direction="horizontal" :show-scrollbar="false" :style="sameStyleScroll">
                <view :style="sameStyleRow">
                  <view v-for="s in sameStyle!.products" :key="s.id" :style="sameStyleItem" @tap="openSameStyle(s.id)">
                    <AppImage :src="s.coverUrl" :style="sameStyleImage" mode="aspectFill" />
                    <text :style="sameStyleTitle">{{ s.title }}</text>
                    <text :style="sameStylePrice">{{ s.price > 0 ? formatMoney(s.price) : '价格待定' }}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </template>

          <template v-if="realBuyerPosts.length > 0">
            <SectionHeader title="相关动态" />
            <view :style="buyerCard">
              <scroll-view direction="horizontal" :show-scrollbar="false" :style="buyerScroll">
                <view :style="buyerRow">
                  <view v-for="p in realBuyerPosts" :key="p.id" :style="buyerItem" @tap="openBuyerPost(p.id)">
                    <AppImage :src="p.imageUrl" :style="buyerImage" mode="aspectFill" />
                    <text :style="buyerAuthor">{{ p.authorNickname }}</text>
                    <text :style="buyerCaption">{{ p.caption !== '' ? p.caption : '上身返图' }}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </template>

          <view :style="actionSpacer" />
        </view>
      </view>
      <view v-else :style="emptyWrap">
        <PageState icon="info" :title="errorMessage !== '' ? errorMessage : '商品信息不存在'" action-text="重新加载" @action="loadDetail" />
      </view>
    </template>
  </MainLayout>
    <view v-if="item !== null" :style="botBar">
    <view :style="botItem" @tap="toggleSaved">
      <view :style="botIcon"><AppIcon name="heart" :size="40" :active="isSaved" /></view>
      <!-- 底栏还有「提醒」「分享」，文字必须短。有收藏数时**直接用它替换掉「收藏」二字**；
           还没人收藏时保留「收藏」，否则按钮看不出是干什么的。 -->
      <text :style="botLabel">{{ favoriteCount > 0 ? favoriteCount : (isSaved ? '已收藏' : '收藏') }}</text>
    </view>
    <view :style="botItem" @tap="createReminder">
      <view :style="botIcon"><AppIcon name="reminder" :size="40" :active="true" /></view>
      <text :style="botLabel">设置提醒</text>
    </view>
    <view :style="botItem" @tap="onShareTap">
      <view :style="botIcon"><AppIcon name="share" :size="40" :active="true" /></view>
      <text :style="botLabel">分享</text>
    </view>
    <view :style="goBtn" @tap="openOfficial"><text :style="goBtnText">{{ goBtnLabel }}</text></view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { FeedItem } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
import { ProductReleaseBatch } from '@/domain/content/product'
import { extractImageUrls } from '@/domain/content/product'
import { StyleInfo } from '@/domain/content/style'
import { ProductVariant } from '@/domain/content/product-variant'
import { deriveReleaseStatusText, formatPriceSummaryByType, formatPriceRange } from '@/presentation/content/feed-presenter'
import { fetchStyle } from '@/services/content/style-service'
import { fetchProductCommunity, ProductCommunityPost } from '@/services/content/product-service'
import { useProductDetailStore } from '@/stores/product-detail-store'
import { formatPrice } from '@/stores/home-feed-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useSessionStore } from '@/stores/session-store'
import { baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight, v3TextStyle } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import { zIndex } from '@/theme/tokens/z-index'
import { getSafeBottomInset, upx2px } from '@/utils/window-info'
import { splitSizeOptions } from '@/utils/size-option'
import { recordBrowse } from '@/stores/browse-history-store'
import { shareByCopy, openExternalUrl } from '@/utils/share'
import { showFeedback } from '@/utils/feedback'
import { navigateOnce } from '@/utils/nav-guard'
import { bumpWishCount, wishCountOf } from '@/services/content/wish-count'
import { formatPriceCents } from '@/utils/format'
import { useBlacklistStore } from '@/stores/blacklist-store'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import PageSkeleton from '@/components/v3/PageSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'

const itemId = ref('')
const item = ref(null) as Ref<FeedItem | null>
const loading = ref(true)
const errorMessage = ref('')
const shopUrl = ref('')
// 收藏态：与收藏页共用 content-library-store 统一数据源（后端 /api/v1/wishlist）
const library = useContentLibraryStore()
const session = useSessionStore()
const productDetailStore = useProductDetailStore()
const blacklist = useBlacklistStore()
const isSaved = computed((): boolean => item.value !== null && library.isFavorite(item.value!.entityId))
/**
 * 收藏数（人气）。
 * 服务端随商品下发 `favoriteCount`；用户刚点过的收藏还没被服务端计数确认，
 * 所以叠加 `wish-count` 的本地增量 —— 这样列表里和详情页读到的数字是同一个。
 */
const favoriteCountBase = ref(0)
const favoriteCount = ref(0)

/** 载入商品后固定基数（服务端值），展示值从基数 + 本机增量算 */
function syncFavoriteCount() {
  if (item.value === null) return
  // 用 FeedItem.wishCountBase（服务端下发的收藏数基数）。此前读的是 favoriteCount ——
  // FeedItem 上并不存在这个字段，且服务端映射里的赋值会被整体覆盖，导致底栏数字与卡片对不上（2026-10-05 修）。
  favoriteCountBase.value = item.value!.wishCountBase
  favoriteCount.value = wishCountOf(item.value!.entityId, favoriteCountBase.value)
}
// 真实发售批次（后端 currentRelease → ReleaseEvent）：发售状态/时间/金额的唯一事实源，禁止 badgeText 猜测
const currentRelease = ref(null) as Ref<ReleaseEvent | null>
const release = computed((): ReleaseEvent | null => currentRelease.value)
const currentImageIndex = ref(0)
// Phase 2.1 同款式：商品绑定 groupKey 时加载款式信息（12-table: styles 表已废弃，保持 null，模块不显示）
const sameStyle = ref(null) as Ref<StyleInfo | null>
// Phase 2.3-A 真实买家：商品关联社区返图（空数组 = 模块不显示；失败静默不阻塞详情）
const realBuyerPosts = ref([]) as Ref<ProductCommunityPost[]>
// ====== Product V2 展示字段（Raw → Normalize → Product；详情页只消费 Product 层） ======
const priceType = ref('UNKNOWN')
const depositCents = ref(0)
const balanceCents = ref(0)
const pitType = ref('')
const subCategory = ref('')

const featureTags = ref([]) as Ref<string[]>
const variants = ref([]) as Ref<ProductVariant[]>
/**
 * 商品级发货说明（`ProductDetailModel.shippingNote`）—— 2026-10-08 起**发货说明的唯一来源**
 * （批次级那份已并入商品级、库列删除；运营后台填在「销售状态」那组里）。
 * ⚠️ 它**不是 FeedItem 的字段** —— 2026-10-08 曾误写成 `item.value!.shippingNote.trim()`，
 * 对 undefined 调 .trim() 让商品详情整页卡在「加载中」。V2 字段一律走独立 ref（同 featureTags）。
 */
const shippingNote = ref('')

/** 价格摘要（price_type 语义，与商品卡一致）：FULL「¥368」/ DEPOSIT「定金 ¥100 · 全款 ¥368」/ BALANCE「尾款 ¥268」/ INTENTION「意向金 ¥1」/ UNKNOWN 空 */
/**
 * 顶部价格（2026-10-09 起统一走「最低价～最高价」）：
 *   优先用**商品级区间**（priceCents ↔ maxPriceCents，由后台/款式参考价推导），
 *   商品级没有区间时回落到**规格参考价现算**（分部件定价的老路径，保留兼容），
 *   仍为空则回落到 price_type 摘要（定金/尾款那套）。
 */
const priceRangeText = computed((): string => {
  if (item.value !== null) {
    const range = formatPriceRange(item.value!.price, item.value!.maxPriceCents)
    if (range !== '') return range
  }
  // 回落：从款式参考价现算（同一款式多个价也算，去重后取最低/最高）
  const prices: number[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const c = variants.value[i].referencePriceCents
    if (c != null && c > 0 && prices.indexOf(c) < 0) prices.push(c)
  }
  if (prices.length < 2) return ''
  prices.sort((a: number, b: number): number => a - b)
  return formatPriceRange(prices[0], prices[prices.length - 1])
})
/** 顶栏最终显示的价格文本：优先区间，其次价格摘要（定金/尾款那套） */
const priceDisplayText = computed((): string => priceRangeText.value !== '' ? priceRangeText.value : priceSummaryText.value)
// productShippingNoteText 已删（2026-10-08）：摘要卡的「发货说明」胶囊去掉后它没有使用者，
// 发货说明统一由 shippingNoteText（下面，发售信息卡）读取。
const priceSummaryText = computed((): string => {
  if (item.value === null) return ''
  const full = currentRelease.value != null && currentRelease.value!.fullPrice > 0 ? currentRelease.value!.fullPrice : item.value!.fullPriceCents
  return formatPriceSummaryByType(priceType.value, item.value!.price, full, depositCents.value, balanceCents.value)
})
/** 三坑类型展示名 */
/** 可选款式：规格变体提取去重。
 *  Lolita 一个链接常同时卖 JSK + OP —— 对这类商品，款式是**规格**（与颜色/尺码同级、可多选），不是分类标签。
 *  命名用「款式」：用户明确否掉了「型别」（口语书面都不会这么说），也去掉了「可选」前缀（规格卡里已有多余）。 */
function stylePrices(style: string): number[] {
  const prices: number[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const v = variants.value[i]
    if (v.styleName === style && v.referencePriceCents != null && prices.indexOf(v.referencePriceCents!) < 0) prices.push(v.referencePriceCents!)
  }
  prices.sort((a: number, b: number): number => a - b)
  return prices
}
const hasStylePrices = computed((): boolean => {
  for (let i = 0; i < variants.value.length; i++) if (variants.value[i].referencePriceCents != null) return true
  return false
})
function stylePriceText(style: string): string {
  const prices = stylePrices(style)
  if (prices.length === 0) return ''
  const low = (prices[0] / 100).toString()
  const high = (prices[prices.length - 1] / 100).toString()
  return '¥' + low + (low === high ? '' : '–' + high)
}
const styleOptions = computed((): string[] => {
  const list: string[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const s = variants.value[i].styleName
    if (s !== '' && list.indexOf(s) < 0) list.push(s)
  }
  return list
})
/**
 * 可选颜色：同样从规格变体提取（2026-10-06 起颜色只认规格，`color_tags` 列已删）。
 * 与款式/尺码保持同一个数据源，避免「规格里有颜色、颜色区却是另一份数据」的两套口径。
 */
const colorOptions = computed((): string[] => {
  const list: string[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const c = variants.value[i].colorName
    if (c !== '' && list.indexOf(c) < 0) list.push(c)
  }
  return list
})
/**
 * 可选尺码：款式变体提取 → **拆分 + 白名单过滤 + 规范排序**（variants 无数据则不显示尺码模块）。
 * ⚠️ 不能直接拿 sizeName 当 chip：采集下来的 sizeName 常是 `"S\nM\nL\nXL"` 一条承载多码，
 *    原样渲染会出现「一个标签里 M 和 L 上下堆着」；还会混进「定金须先确认收货」这类噪声。
 *    拆分逻辑在 utils/size-option.uts（含体重区间、「码」后缀、垃圾项处理）。
 */
const sizeOptions = computed((): string[] => {
  const raw: string[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const s = variants.value[i].sizeName
    if (s !== '') raw.push(s)
  }
  return splitSizeOptions(raw)
})
// materialSummary 已删（2026-10-09）：材质模块整体下线（字段与展示一起移除）。
const releaseBatchText = computed((): string => {
  const r = currentRelease.value
  if (r == null) return ''
  // 多批次时下面紧跟着「发售批次 · 共 N 批」的完整列表，这里再单独重复一遍当前批次名
  // 只会让人以为有两套信息。单批次才用这一行补足批次名（2026-10-05）。
  if (item.value !== null && item.value!.releases.length > 1) return ''
  const text = r.title.trim()
  if (['预约批', '现货批', '预售批', '预约', '现货', '预售'].indexOf(text) >= 0 || text === releaseStatusText.value) return ''
  return text
})
/**
 * 发售批次列表（多批次时才用）。
 *
 * 排序规则（两级）：
 *  1. **能行动的排最前**：现货/预约中/即将发售 > 已结束；
 *  2. 同为能行动时，**现货优先于预约中**（现货是「现在下单就能发」，预约还得等尾款）。
 * 热门款常常同时挂着一团（已截团）、二团（预约中）、现货掉落 —— 第一眼必须看到「现在能买的那批」，
 * 而不是按批次号把已截团的一团排在最前面（2026-10-05 用户提出「怎么展示效果最佳」后定的口径）。
 */
const batchList = computed((): ProductReleaseBatch[] => {
  const p = item.value
  if (p === null) return [] as ProductReleaseBatch[]
  const all = p!.releases
  if (all.length <= 1) return [] as ProductReleaseBatch[]
  const sorted = [...all]
  sorted.sort((a, b) => {
    const pa = batchPriority(a.saleStatus)
    const pb = batchPriority(b.saleStatus)
    if (pa != pb) return pa - pb
    return a.no - b.no
  })
  return sorted
})

/** 越小越靠前：现货 0 > 预约中/预售 1 > 即将发售 2 > 其余（已结束/售罄/未知）3 */
function batchPriority(saleStatus: string): number {
  // 「现货+预售」= 同一商品既有现货又有预约中，对用户来说**现货优先**，排在纯预约之前
  if (saleStatus === 'ON_SALE' || saleStatus === 'ON_SALE_PRE_ORDER') return 0
  if (saleStatus === 'PRE_ORDER') return 1
  if (saleStatus === 'UPCOMING') return 2
  return 3
}

function isBatchActive(saleStatus: string): boolean {
  return saleStatus === 'ON_SALE' || saleStatus === 'ON_SALE_PRE_ORDER' || saleStatus === 'PRE_ORDER' || saleStatus === 'UPCOMING'
}

function batchTitle(b: ProductReleaseBatch): string {
  const prefix = b.no > 0 ? `第 ${b.no} 批` : '批次'
  return b.name !== '' ? `${prefix} · ${b.name}` : prefix
}

/** 金额文案：定金批给「定金 + 尾款 + 合计」，现货批只给全价 —— 不要把不存在的数字填 0 */
function batchPriceText(b: ProductReleaseBatch): string {
  const parts: string[] = []
  if (b.depositCents != null && b.depositCents > 0) parts.push(`定金 ${formatPriceCents(b.depositCents)}`)
  if (b.balanceCents != null && b.balanceCents > 0) parts.push(`尾款 ${formatPriceCents(b.balanceCents)}`)
  if (b.fullPriceCents != null && b.fullPriceCents > 0) parts.push(`全价 ${formatPriceCents(b.fullPriceCents)}`)
  return parts.join(' · ')
}

function batchDateText(b: ProductReleaseBatch): string {
  const start = b.startAt !== '' ? b.startAt.substring(0, 10) : ''
  const end = b.endAt !== '' ? b.endAt.substring(0, 10) : ''
  if (start !== '' && end !== '') return `${start} ~ ${end}`
  if (start !== '') return `${start} 起`
  return ''
}

/** 出货时间（release.shipAt；无数据不显示） */
const shipDateText = computed((): string => {
  const r = currentRelease.value
  return r != null ? dateOnly(r.shipAt) : ''
})
/**
 * 发货说明。2026-10-08 起**只有一个来源**：`ProductDetailModel.shippingNote`（商品级，
 * 即运营后台「销售状态」里的那一格；批次级那份已并入并删列）。
 * ⚠️ 这里仍然兜一层 `currentRelease.note`：后端为兼容老客户端会把它回填成同一份值，
 *    但**没有批次的现货商品** currentRelease 为 null ⇒ 必须落到 shippingNote 上才显示得出来。
 */
const shippingNoteText = computed((): string => {
  const r = currentRelease.value
  if (r != null && r.note.trim() !== '') return r.note.trim()
  return shippingNote.value.trim()
})
/** 预售/发售时间区间（release.startAt ~ endAt） */
const releaseStartText = computed((): string => {
  const r = currentRelease.value
  if (r == null) return ''
  const start = dateOnly(r.startAt)
  const end = dateOnly(r.endAt)
  if (start === '' && end === '') return ''
  if (start === '') return end
  if (end === '') return start
  return `${start} ~ ${end}`
})
const releaseStatusText = computed((): string => deriveReleaseStatusText(currentRelease.value))
function formatMoney(cents: number): string { return formatPrice(cents) }
  const detailImages = ref<string[]>([])

 function onGalleryChange(e: any) {
   const eObj = e as UTSJSONObject
   const detail = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
   const current = detail != null && detail['current'] != null ? detail['current'] as number : 0
   currentImageIndex.value = current
 }
function previewGallery() {
  if (detailImages.value.length === 0) return
  uni.previewImage({ current: detailImages.value[currentImageIndex.value], urls: detailImages.value })
}

/** 同款式商品跳转（Phase 2.1） */
function openSameStyle(productId: string) {
  if (productId === '') return
  uni.navigateTo({ url: `/pages/product/detail?id=${productId}` })
}

/** 点品牌名 → 品牌商品页（pages/brand/detail 用 id 拉品牌与它的商品列表） */
function openBrand() {
  const value = item.value
  if (value == null) return
  if (value!.brandId === '') { showFeedback('这件商品还没有关联品牌页'); return }
  navigateOnce(`/pages/brand/detail?id=${encodeURIComponent(value!.brandId)}&name=${encodeURIComponent(brandNameText.value)}`)
}

/** 真实买家返图：复用社区内容预览机制（大图预览，不重做社区详情页） */
function openBuyerPost(postId: string) {
  const post = realBuyerPosts.value.find((p) => p.id === postId)
  if (post == null || post.imageUrl === '') return
  uni.previewImage({ current: post.imageUrl, urls: [post.imageUrl] })
}

function isLoggedIn(): boolean {
  // Mock 内测会话也算已登录：收藏写入本地（不请求受保护接口），正式会话走远程 wishlist
  return session.isLoggedIn
}

function toggleSaved() {
  if (item.value === null) return
  const entityId = item.value!.entityId
  if (entityId === '') return

  if (!isLoggedIn()) {
    showFeedback('请先登录后收藏（在「我的」页登录）')
    return
  }

  // 统一数据源：content-library-store → 后端 /api/v1/wishlist（失败自动入队，恢复后重放）
  // releaseId：用户当前关注的发售批次（详情页 currentRelease 存在时提交，供收藏页锚定该批次）
  const r = currentRelease.value
  const saved = library.toggleFavorite(entityId, item.value!.title, r != null ? r.id : '', item.value!)
  // 收藏数立刻跟着动（详情页与列表共用同一份增量，两处数字不会打架）
  // 基数固定不变，展示值每次从基数重算 —— 这样「取消再收藏」不会变成 2
  bumpWishCount(entityId, saved ? 1 : -1)
  favoriteCount.value = wishCountOf(entityId, favoriteCountBase.value)
  showFeedback(saved ? '已收进心动收藏' : '已移出收藏')
}

/** 导航栏「…」更多菜单：低频/负向动作收进来（分享、屏蔽品牌）。
 *  原先"屏蔽品牌"做成品牌行里的粉色小胶囊，等于让低频负向操作占了主信息行 —— 已搬走。 */
function onMoreTap() {
  if (item.value === null) return
  const name = item.value!.brandName
  const blocked = name !== '' && blacklist.isBlacklisted(name)
  const itemList: string[] = name !== ''
    ? ['分享商品', blocked ? '恢复该品牌' : '屏蔽该品牌']
    : ['分享商品']
  uni.showActionSheet({
    itemList: itemList,
    success: (res) => {
      if (res.tapIndex === 0) { onShareTap(); return }
      if (res.tapIndex === 1) onToggleBlacklist()
    },
  })
}

function onToggleBlacklist() {
  if (item.value === null) return
  const name = item.value!.brandName
  if (name === '') { showFeedback('该商品暂无品牌信息'); return }
  const blocked = blacklist.toggleBlacklist(name)
  showFeedback(blocked ? `已屏蔽品牌：${name}` : `已恢复品牌：${name}`)
}

/**
 * 「原店」按钮文案必须与**实际行为**一致（2026-10-11）：
 *   小程序端开不了 `taobao://` 这类外部 scheme，web-view 也不允许承载站外电商页
 *   ⇒ 唯一合规动作是复制链接（见 utils/share.uts 的 openExternalUrl）；
 *   App 端能唤起淘宝 App / 系统浏览器，才是真正的「前往」。
 * 文案不一致既误导用户，也容易被审核按「诱导跳转 / 名不符实」挑出来。
 */
const goBtnLabel = ref('前往原店')
// #ifdef MP-WEIXIN
goBtnLabel.value = '原店链接'
// #endif

function openOfficial() {
  if (shopUrl.value === '') { showFeedback('暂未收录原店链接'); return }
  // uni-app x 不支持 plus.runtime.openURL：降级为复制链接（全平台可用）
  openExternalUrl(shopUrl.value)
}

/** 分享：复制标题 + 价格/品牌 + 原店链接（有则带上） */
function onShareTap() {
  if (item.value === null) return
  const detail = priceSummaryText.value !== '' ? `${item.value!.brandName !== '' ? item.value!.brandName + ' · ' : ''}${priceSummaryText.value}` : item.value!.brandName
  shareByCopy(item.value!.title, detail, shopUrl.value)
}

function dateOnly(value: string): string {
  if (value === '') return ''
  return value.length >= 10 ? value.substring(0, 10) : value
}

function encoded(value: string): string { return encodeURIComponent(value) ?? '' }

function createReminder() {
  if (item.value === null) return
  const r = currentRelease.value
  // 尾款期 → 尾款提醒；其余 → 发售提醒（基于真实 release 状态，非 badgeText）
  const type = releaseStatusText.value === '尾款' ? 'BALANCE' : 'RELEASE'
  const title = `${item.value!.title} ${releaseStatusText.value !== '' ? releaseStatusText.value : '发售'}`
  const note = `${item.value!.brandName} · 来源于商品详情`
  const date = r != null ? (type === 'BALANCE' ? r.balanceDueAt : r.startAt) : ''
  uni.navigateTo({ url: `/pages/reminder/edit?title=${encoded(title)}&type=${type}&date=${encoded(date)}&note=${encoded(note)}&productId=${encoded(itemId.value)}&releaseId=${encoded(r != null ? r.id : '')}` })
}


async function loadDetail() {
  loading.value = true
  errorMessage.value = ''
  currentImageIndex.value = 0
  try {
    const result = await productDetailStore.load(itemId.value)
    if (unmounted) return
    if (result === null) { item.value = null; errorMessage.value = '商品信息不存在'; return }
    item.value = result.item
    // 12-table: images is ProductImage[], extract URL strings for swiper
    detailImages.value = extractImageUrls(result.images)
    // 浏览足迹：加载成功即记入本机（不同步服务器），供「我的 → 浏览历史」找回
    recordBrowse(result.item.entityId, result.item.title, result.item.brandName, result.item.coverUrl)
    shopUrl.value = result.shopUrl
    syncFavoriteCount()
    currentRelease.value = result.currentRelease
    // ====== Product V2 展示字段赋值 ======
    priceType.value = result.priceType
    depositCents.value = result.depositCents
    balanceCents.value = result.balanceCents
    pitType.value = result.pitType
    subCategory.value = result.subCategory
    featureTags.value = result.featureTags
    variants.value = result.variants
    shippingNote.value = result.shippingNote
    // 同款式：仅当商品已归并（styleId 非空）时加载；失败静默（不阻塞详情）
    sameStyle.value = null
    if (result.groupKey !== '') {
      // 12-table: styles table removed; sameStyle UI gracefully hidden (fetchStyle returns null)
      fetchStyle(result.groupKey).then((style: StyleInfo | null) => {
        if (unmounted) return
        sameStyle.value = style
      }).catch(() => {})
    }
    // 真实买家：商品关联社区返图（空 = 模块隐藏）；失败静默不阻塞详情
    realBuyerPosts.value = []
    fetchProductCommunity(itemId.value).then((posts: ProductCommunityPost[]) => {
      if (unmounted) return
      realBuyerPosts.value = posts
    }).catch(() => {})
    if (isLoggedIn()) {
      library.refreshRemoteFavorites().catch(() => {
        if (!unmounted) showFeedback('商品已加载，收藏状态暂未同步')
      })
    }
  } catch (e) {
    if (unmounted) return
    item.value = null
    detailImages.value = []
    errorMessage.value = e instanceof Error ? e.message : '商品加载失败'
  } finally {
    if (unmounted) return
    loading.value = false
  }
}

// 页面卸载后丢弃异步回调，避免写入已销毁实例的 ref
let unmounted = false
onUnload(() => { unmounted = true })

onLoad((options) => {
  initPageTheme()
  itemId.value = options != null && options['id'] != null ? options['id'] as string : ''
  if (itemId.value === '') { loading.value = false; errorMessage.value = '缺少商品信息'; return }
  loadDetail()
})

