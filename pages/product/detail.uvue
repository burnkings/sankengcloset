// 加载/失败使用 V3 FeedSkeleton / PageState
const emptyWrap = { flex: 1, alignItems: 'center', justifyContent: 'center' }
// V3 §6.10 底部固定：收藏 / 设置提醒 / 前往官方渠道（避开安全区）
const botBar = computed((): any => ({ position: 'fixed', left: '0', right: '0', bottom: '0', zIndex: zIndex.navbar, height: '160rpx', paddingLeft: '24rpx', paddingRight: '24rpx', paddingTop: '16rpx', paddingBottom: `${safeBottom}px`, ...flexRow, alignItems: 'flex-start', backgroundColor: n.value.surface, borderTopWidth: '1rpx', borderTopStyle: 'solid', borderTopColor: n.value.border }))
const botItem = { width: '100rpx', alignItems: 'center' }
const botIcon = { width: '56rpx', height: '56rpx', alignItems: 'center', justifyContent: 'center' }
