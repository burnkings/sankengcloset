<template>
  <MainLayout navbar-content-height="0rpx">
    <template #default>
      <view v-if="loading" :style="emptyWrap"><FeedSkeleton /></view>
      <view v-else-if="item !== null">
        <view :style="heroWrap">
          <swiper :style="hero" :circular="detailImages.length > 1" :indicator-dots="false" @change="onGalleryChange">
            <swiper-item v-for="imageUrl in detailImages" :key="imageUrl">
              <AppImage :src="imageUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            </swiper-item>
          </swiper>
          <view :style="heroBack" @tap="onBack">
            <AppIcon name="arrow-back" :size="40" />
          </view>
          <view v-if="detailImages.length > 1" :style="imageCounter"><text :style="imageCounterText">{{ currentImageIndex + 1 }} / {{ detailImages.length }}</text></view>
        </view>

        <view class="page-canvas" :style="pageWrap">
          <view :style="summaryCard">
              <view :style="priceRow">
                <text v-if="priceSummaryText !== ''" :style="priceText">{{ priceSummaryText }}</text>
                <text v-else :style="priceFallbackText">价格待定</text>
                <text v-if="item!.originalPrice > item!.price && priceSummaryText !== ''" :style="oldPrice">{{ formatMoney(item!.originalPrice) }}</text>
              </view>
            <text :style="titleText">{{ item!.title }}</text>
            <view :style="brandRow">
              <text :style="brandText">{{ item!.brandName }}</text>
              <view v-if="pitTypeLabel !== ''" :style="pitChip"><text :style="pitChipText">{{ pitTypeLabel }}</text></view>
              <view v-if="subCategory !== ''" :style="subChip"><text :style="subChipText">{{ subCategory }}</text></view>
              <view :style="blacklistBtn" @tap="onToggleBlacklist">
                <text :style="blacklistBtnText">{{ blacklist.isBlacklisted(item!.brandName) ? '已屏蔽·恢复' : '屏蔽品牌' }}</text>
              </view>
            </view>
            <view v-if="featureTags.length > 0" :style="featureRow">
              <view v-for="tag in featureTags" :key="tag" :style="featureChip"><text :style="featureChipText">{{ tag }}</text></view>
            </view>
            <view v-if="blacklist.isBlacklisted(item!.brandName)" :style="blockedBanner">
              <text :style="blockedBannerText">该品牌已被你屏蔽，首页、搜索与收藏中将不再展示。可点上方「已屏蔽·恢复」取消。</text>
            </view>
            <view :style="statusTag">
              <view :style="statusDot" />
              <text :style="statusTagText">{{ releaseStatusText !== '' ? releaseStatusText : '官方信息' }}</text>
            </view>
            <view v-if="compatibility.score >= 0" :style="compatibilityCard">
              <view :style="compatibilityHeader"><text :style="compatibilityTitle">与你衣橱的搭配度</text><text :style="compatibilityScore">{{ compatibility.score }}%</text></view>
              <view :style="compatibilityTrack"><view :style="compatibilityFill" /></view>
              <text :style="compatibilityReason">{{ compatibility.explanation }}</text>
              <text v-if="compatibility.matchedItems.length > 0" :style="compatibilityMatches">可优先试搭：{{ compatibilityNames }}</text>
            </view>
            <view :style="decisionRow">
              <view :style="recordBtn" @tap="createPurchase"><AppIcon name="order" :size="32" :active="true" /><text :style="recordText">记入购买</text></view>
            </view>
          </view>

          <template v-if="release !== null || spotPriceVisible">
            <SectionHeader title="购买信息" />
            <view :style="releaseCard">
              <view v-if="releaseStatusText !== ''" :style="releaseRow"><text :style="releaseLabel">当前状态</text><text :style="releaseValue">{{ releaseStatusText }}</text></view>
              <view v-if="spotPriceVisible" :style="releaseRow"><text :style="releaseLabel">现货价格</text><text :style="releaseValue">{{ formatMoney(spotPriceCents) }}</text></view>
              <view v-if="release !== null && release!.title !== ''" :style="releaseRow"><text :style="releaseLabel">批次</text><text :style="releaseValue">{{ release!.title }}</text></view>
              <view v-if="releaseStartText !== ''" :style="releaseRow"><text :style="releaseLabel">预售时间</text><text :style="releaseValue">{{ releaseStartText }}</text></view>
              <view v-if="shipDateText !== ''" :style="releaseRow"><text :style="releaseLabel">出货时间</text><text :style="releaseValue">{{ shipDateText }}</text></view>
              <view v-if="release !== null && release!.depositAmount > 0" :style="releaseRow"><text :style="releaseLabel">定金</text><text :style="releaseValue">{{ formatMoney(release!.depositAmount) }}</text></view>
              <view v-if="release !== null && release!.finalPaymentAmount > 0" :style="releaseRow"><text :style="releaseLabel">尾款</text><text :style="releaseValue">{{ formatMoney(release!.finalPaymentAmount) }}</text></view>
              <view v-if="release !== null && release!.fullPrice > 0" :style="releaseRow"><text :style="releaseLabel">全款</text><text :style="releaseValue">{{ formatMoney(release!.fullPrice) }}</text></view>
            </view>
          </template>

          <template v-if="colorTags.length > 0 || sizeOptions.length > 0">
            <SectionHeader title="规格" />
            <view :style="specCard">
              <view v-if="colorTags.length > 0" :style="specRow">
                <text :style="specLabel">可选颜色</text>
                <view :style="specChips">
                  <view v-for="c in colorTags" :key="c" :style="specChip"><text :style="specChipText">{{ c }}</text></view>
                </view>
              </view>
              <view v-if="sizeOptions.length > 0" :style="specRow">
                <text :style="specLabel">可选尺码</text>
                <view :style="specChips">
                  <view v-for="s in sizeOptions" :key="s" :style="specChip"><text :style="specChipText">{{ s }}</text></view>
                </view>
              </view>
            </view>
          </template>

          <template v-if="variants.length > 0">
            <SectionHeader title="款式价格" />
            <view :style="variantCard">
              <view v-for="v in variants" :key="v.id" :style="variantRow">
                <view :style="variantInfo">
                  <text :style="variantName">{{ v.name !== '' ? v.name : variantFallbackName(v) }}</text>
                  <text :style="variantSpec">{{ variantSpecText(v) }}</text>
                </view>
                <text :style="variantPrice">{{ v.price > 0 ? formatMoney(v.price) : '价格待定' }}</text>
              </view>
            </view>
          </template>

          <template v-if="materialSummary !== ''">
            <SectionHeader title="材质" />
            <view :style="detailCard"><text :style="detailText">{{ materialSummary }}</text></view>
          </template>

          <template v-if="sameStyle !== null && sameStyle.products.length > 0">
            <SectionHeader title="同款式" />
            <view :style="sameStyleCard">
              <view :style="sameStyleHeader">
                <text :style="sameStyleName">{{ sameStyle!.canonicalName }}</text>
                <text :style="sameStyleBrand">{{ sameStyle!.brandName }}</text>
              </view>
              <scroll-view scroll-x :show-scrollbar="false" :style="sameStyleScroll">
                <view :style="sameStyleRow">
                  <view v-for="s in sameStyle!.products" :key="s.id" :style="sameStyleItem" @tap="openSameStyle(s.id)">
                    <AppImage :src="s.coverUrl" :style="sameStyleImage" mode="aspectFill" />
                    <text :style="sameStyleTitle">{{ s.title }}</text>
                    <text :style="sameStylePrice">{{ s.price > 0 ? formatMoney(s.price) : '价格待定' }}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </template>

          <template v-if="realBuyerPosts.length > 0">
            <SectionHeader title="真实买家" />
            <view :style="buyerCard">
              <scroll-view scroll-x :show-scrollbar="false" :style="buyerScroll">
                <view :style="buyerRow">
                  <view v-for="p in realBuyerPosts" :key="p.id" :style="buyerItem" @tap="openBuyerPost(p.id)">
                    <AppImage :src="p.imageUrl" :style="buyerImage" mode="aspectFill" />
                    <text :style="buyerAuthor">{{ p.authorNickname }}</text>
                    <text :style="buyerCaption" :lines="1">{{ p.caption !== '' ? p.caption : '上身返图' }}</text>
                  </view>
                </view>
              </scroll-view>
            </view>
          </template>

          <SectionHeader title="商品说明" />
          <view :style="detailCard"><text :style="detailText">{{ description !== '' ? description : (item!.subtitle !== '' ? item!.subtitle : '商品说明待品牌补充') }}</text></view>
          <view :style="actionSpacer" />
        </view>
      </view>
      <view v-else :style="emptyWrap">
        <PageState icon="info" :title="errorMessage !== '' ? errorMessage : '商品信息不存在'" action-text="重新加载" @action="loadDetail" />
      </view>
    </template>
  </MainLayout>
    <view v-if="item !== null" :style="botBar">
    <view :style="botItem" @tap="toggleSaved">
      <view :style="botIcon"><AppIcon name="heart" :size="40" :active="isSaved" /></view>
      <text :style="botLabel">{{ isSaved ? '已收藏' : '收藏' }}</text>
    </view>
    <view :style="botItem" @tap="createReminder">
      <view :style="botIcon"><AppIcon name="reminder" :size="40" :active="true" /></view>
      <text :style="botLabel">设置提醒</text>
    </view>
    <view :style="goBtn" @tap="openOfficial"><text :style="goBtnText">前往官方渠道</text></view>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { FeedItem } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
import { StyleInfo } from '@/domain/content/style'
import { ProductVariant } from '@/domain/content/product-variant'
import { deriveReleaseStatusText, formatPriceSummaryByType, getPitTypeLabel, PRICE_TYPE_FULL } from '@/presentation/content/feed-presenter'
import { fetchStyle } from '@/services/content/style-service'
import { fetchProductCommunity, ProductCommunityPost } from '@/services/content/product-service'
import { useProductDetailStore } from '@/stores/product-detail-store'
import { formatPrice } from '@/stores/home-feed-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useSessionStore } from '@/stores/session-store'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight, v3TextStyle } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { zIndex } from '@/theme/tokens/z-index'
import { getSafeBottomInset, upx2px } from '@/utils/window-info'
import { showFeedback } from '@/utils/feedback'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useBlacklistStore } from '@/stores/blacklist-store'
import { calculateWardrobeCompatibility } from '@/services/ai/wardrobe-compatibility-service'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'

const itemId = ref('')
const item = ref(null) as Ref<FeedItem | null>
const loading = ref(true)
const errorMessage = ref('')
const description = ref('')
const shopUrl = ref('')
// 收藏态：与收藏页共用 content-library-store 统一数据源（后端 /api/v1/wishlist）
const library = useContentLibraryStore()
const session = useSessionStore()
const productDetailStore = useProductDetailStore()
const wardrobe = useWardrobeStore()
const blacklist = useBlacklistStore()
const isSaved = computed((): boolean => item.value !== null && library.isFavorite(item.value!.entityId))
const compatibility = computed(() => item.value !== null ? calculateWardrobeCompatibility(item.value!, wardrobe.items) : calculateWardrobeCompatibility(new FeedItem(), wardrobe.items))
const compatibilityNames = computed((): string => compatibility.value.matchedItems.map((entry) => entry.name).join('、'))
// 真实发售批次（后端 currentRelease → ReleaseEvent）：发售状态/时间/金额的唯一事实源，禁止 badgeText 猜测
const currentRelease = ref(null) as Ref<ReleaseEvent | null>
const release = computed((): ReleaseEvent | null => currentRelease.value)
const currentImageIndex = ref(0)
// Phase 2.1 同款式：商品绑定 styleId 时加载款式信息（未归并商品保持 null，模块不显示）
const sameStyle = ref(null) as Ref<StyleInfo | null>
// Phase 2.3-A 真实买家：商品关联社区返图（空数组 = 模块不显示；失败静默不阻塞详情）
const realBuyerPosts = ref([]) as Ref<ProductCommunityPost[]>
// ====== Product V2 展示字段（Raw → Normalize → Product；详情页只消费 Product 层） ======
const priceType = ref('UNKNOWN')
const depositCents = ref(0)
const balanceCents = ref(0)
const pitType = ref('')
const subCategory = ref('')
const colorTags = ref([]) as Ref<string[]>
const materialTags = ref([]) as Ref<string[]>
const featureTags = ref([]) as Ref<string[]>
const variants = ref([]) as Ref<ProductVariant[]>

/** 价格摘要（price_type 语义，与商品卡一致）：FULL「¥368」/ DEPOSIT「定金 ¥100 · 全款 ¥368」/ BALANCE「尾款 ¥268」/ INTENTION「意向金 ¥1」/ UNKNOWN 空 */
const priceSummaryText = computed((): string => {
  if (item.value === null) return ''
  const full = currentRelease.value != null && currentRelease.value!.fullPrice > 0 ? currentRelease.value!.fullPrice : item.value!.fullPriceCents
  return formatPriceSummaryByType(priceType.value, item.value!.price, full, depositCents.value, balanceCents.value)
})
/** 现货价格（分）：release 全价 > 商品当前价（FULL 语义），否则 0（无数据显示，不伪造） */
const spotPriceCents = computed((): number => {
  if (item.value === null) return 0
  if (currentRelease.value != null && currentRelease.value!.fullPrice > 0) return currentRelease.value!.fullPrice
  return priceType.value === PRICE_TYPE_FULL && item.value!.price > 0 ? item.value!.price : 0
})
/** 三坑类型展示名 */
const pitTypeLabel = computed((): string => getPitTypeLabel(pitType.value))
/** 可选尺码：款式变体提取去重（variants 无数据则不显示尺码模块） */
const sizeOptions = computed((): string[] => {
  const sizes: string[] = []
  for (let i = 0; i < variants.value.length; i++) {
    const s = variants.value[i].sizeName
    if (s !== '' && sizes.indexOf(s) < 0) sizes.push(s)
  }
  return sizes
})
/** 材质摘要（只展示 material_summary，不搬淘宝详情页） */
const materialSummary = computed((): string => {
  if (materialTags.value.length === 0) return ''
  return materialTags.value.join('、')
})
/** 出货时间（release.shipAt；无数据不显示） */
const shipDateText = computed((): string => {
  const r = currentRelease.value
  return r != null ? dateOnly(r.shipAt) : ''
})
/** 预售/发售时间区间（release.startAt ~ endAt） */
const releaseStartText = computed((): string => {
  const r = currentRelease.value
  if (r == null) return ''
  const start = dateOnly(r.startAt)
  const end = dateOnly(r.endAt)
  if (start === '' && end === '') return ''
  if (start === '') return end
  if (end === '') return start
  return `${start} ~ ${end}`
})
const releaseStatusText = computed((): string => deriveReleaseStatusText(currentRelease.value))
function formatMoney(cents: number): string { return formatPrice(cents) }
  const detailImages = ref<string[]>([])

 function onGalleryChange(e: any) {
   const eObj = e as UTSJSONObject
   const detail = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
   const current = detail != null && detail['current'] != null ? detail['current'] as number : 0
   currentImageIndex.value = current
 }
function onBack() { uni.navigateBack() }

/** 同款式商品跳转（Phase 2.1） */
function openSameStyle(productId: string) {
  if (productId === '') return
  uni.navigateTo({ url: `/pages/product/detail?id=${productId}` })
}

/** 真实买家返图：复用社区内容预览机制（大图预览，不重做社区详情页） */
function openBuyerPost(postId: string) {
  const post = realBuyerPosts.value.find((p) => p.id === postId)
  if (post == null || post.imageUrl === '') return
  uni.previewImage({ current: post.imageUrl, urls: [post.imageUrl] })
}

function isLoggedIn(): boolean {
  // Mock 内测会话也算已登录：收藏写入本地（不请求受保护接口），正式会话走远程 wishlist
  return session.isLoggedIn
}

function toggleSaved() {
  if (item.value === null) return
  const entityId = item.value!.entityId
  if (entityId === '') return

  if (!isLoggedIn()) {
    showFeedback('请先登录后收藏')
    return
  }

  // 统一数据源：content-library-store → 后端 /api/v1/wishlist（失败自动入队，恢复后重放）
  // releaseId：用户当前关注的发售批次（详情页 currentRelease 存在时提交，供收藏页锚定该批次）
  const r = currentRelease.value
  const saved = library.toggleFavorite(entityId, item.value!.title, r != null ? r.id : '')
  showFeedback(saved ? '已收进心动收藏' : '已移出收藏')
}

function onToggleBlacklist() {
  if (item.value === null) return
  const name = item.value!.brandName
  if (name === '') { showFeedback('该商品暂无品牌信息'); return }
  const blocked = blacklist.toggleBlacklist(name)
  showFeedback(blocked ? `已屏蔽品牌：${name}` : `已恢复品牌：${name}`)
}

function openOfficial() {
  if (shopUrl.value === '') { showFeedback('暂未收录官方购买地址'); return }
  uni.setClipboardData({ data: shopUrl.value, success: () => { showFeedback('官方地址已复制，可在浏览器打开') } })
}

function dateOnly(value: string): string {
  if (value === '') return ''
  return value.length >= 10 ? value.substring(0, 10) : value
}

function encoded(value: string): string { return encodeURIComponent(value) ?? '' }

function createReminder() {
  if (item.value === null) return
  const r = currentRelease.value
  // 尾款期 → 尾款提醒；其余 → 发售提醒（基于真实 release 状态，非 badgeText）
  const type = releaseStatusText.value === '尾款' ? 'BALANCE' : 'RELEASE'
  const title = `${item.value!.title} ${releaseStatusText.value !== '' ? releaseStatusText.value : '发售'}`
  const note = `${item.value!.brandName} · 来源于商品详情`
  // 时间优先级：尾款截止 > 发售结束 > 商品截止
  const date = r != null && r.balanceDueAt !== '' ? dateOnly(r.balanceDueAt)
    : (r != null && r.endAt !== '' ? dateOnly(r.endAt) : dateOnly(item.value!.eventEndAt))
  uni.navigateTo({ url: `/pages/reminder/edit?title=${encoded(title)}&type=${type}&date=${date}&note=${encoded(note)}` })
}

function createPurchase() {
  if (item.value === null) return
  const r = currentRelease.value
  // 金额优先级：批次全价 > 商品当前价（有真实数据才带，不伪造）
  const priceCents = r != null && r.fullPrice > 0 ? r.fullPrice : item.value!.price
  const amount = priceCents > 0 ? (priceCents / 100).toString() : ''
  const category = item.value!.category === 'LOLITA' ? 'LOLITA' : (item.value!.category === 'HANFU' ? 'HANFU' : 'JK')
  const deadline = r != null && r.balanceDueAt !== '' ? dateOnly(r.balanceDueAt)
    : (r != null && r.endAt !== '' ? dateOnly(r.endAt) : dateOnly(item.value!.eventEndAt))
  uni.navigateTo({ url: `/pages/purchase/edit?name=${encoded(item.value!.title)}&brand=${encoded(item.value!.brandName)}&amount=${amount}&category=${category}&deadline=${deadline}` })
}

async function loadDetail() {
  loading.value = true
  errorMessage.value = ''
  currentImageIndex.value = 0
  try {
    const result = await productDetailStore.load(itemId.value)
    if (unmounted) return
    if (result === null) { item.value = null; errorMessage.value = '商品信息不存在'; return }
    item.value = result.item
    detailImages.value = result.images
    description.value = result.description
    shopUrl.value = result.shopUrl
    currentRelease.value = result.currentRelease
    // ====== Product V2 展示字段赋值 ======
    priceType.value = result.priceType
    depositCents.value = result.depositCents
    balanceCents.value = result.balanceCents
    pitType.value = result.pitType
    subCategory.value = result.subCategory
    colorTags.value = result.colorTags
    materialTags.value = result.materialTags
    featureTags.value = result.featureTags
    variants.value = result.variants
    // 同款式：仅当商品已归并（styleId 非空）时加载；失败静默（不阻塞详情）
    sameStyle.value = null
    if (result.styleId !== '') {
      fetchStyle(result.styleId).then((style: StyleInfo | null) => {
        if (unmounted) return
        sameStyle.value = style
      }).catch(() => {})
    }
    // 真实买家：商品关联社区返图（空 = 模块隐藏）；失败静默不阻塞详情
    realBuyerPosts.value = []
    fetchProductCommunity(itemId.value).then((posts: ProductCommunityPost[]) => {
      if (unmounted) return
      realBuyerPosts.value = posts
    }).catch(() => {})
    if (isLoggedIn()) {
      await library.refreshRemoteFavorites()
    }
  } catch (e) {
    if (unmounted) return
    item.value = null
    detailImages.value = []
    errorMessage.value = e instanceof Error ? e.message : '商品加载失败'
  } finally {
    if (unmounted) return
    loading.value = false
  }
}

// 页面卸载后丢弃异步回调，避免写入已销毁实例的 ref
let unmounted = false
onUnload(() => { unmounted = true })

onMounted(() => {
  const pages = getCurrentPages()
  const current = pages[pages.length - 1]
  const options = current.options
  itemId.value = options != null && options['id'] != null ? options['id'] as string : ''
  loadDetail()
  wardrobe.fetchItems()
})

const safeBottom = getSafeBottomInset()
const pageWrap = { paddingTop: '0', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const heroWrap = computed((): any => ({ width: '750rpx', height: '720rpx', position: 'relative' as string, backgroundColor: n.value.bgSecondary, overflow: 'hidden' }))
const hero = { width: '750rpx', height: '720rpx' }
const heroBack = { position: 'absolute' as string, left: '32rpx', top: '28rpx', width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: baseColors.black, alignItems: 'center', justifyContent: 'center', zIndex: (zIndex.navbar as number) + 1 }
const imageCounter = { position: 'absolute' as string, right: '30rpx', bottom: '32rpx', minWidth: '84rpx', height: '48rpx', paddingLeft: '16rpx', paddingRight: '16rpx', borderRadius: '24rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: baseColors.black }
const imageCounterText = { fontSize: '22rpx', fontWeight: fontWeight.medium, color: baseColors.white }
// V3 §6.10 信息区 32rpx 边距；信息卡圆角 20rpx（列表组级）
const summaryCard = computed((): any => ({ marginTop: '20rpx', padding: CARD_PADDING, borderRadius: '20rpx', backgroundColor: n.value.surface }))
const priceRow = { ...flexRow, alignItems: 'flex-end' }
const priceText = { fontSize: v3TextStyle.priceLarge.fontSize, fontWeight: v3TextStyle.priceLarge.fontWeight, color: brand.primary }
const oldPrice = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, textDecorationLine: 'line-through', marginLeft: '10rpx', marginBottom: '4rpx' }))
