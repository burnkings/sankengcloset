// V3 §6.10 「记入购买」为次要入口（外跳确认/更多操作），不制造站内交易感
const decisionRow = { ...flexRow, marginTop: '22rpx' }
const recordBtn = computed((): any => ({ ...flexFill, height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary, ...flexRow, alignItems: 'center', justifyContent: 'center' }))
