<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="商品详情" :show-back="true" /></template>
    <template #default>
      <view v-if="loading" :style="emptyWrap"><text :style="emptyText">正在加载商品信息…</text></view>
      <view v-else-if="item !== null" :style="pageWrap">
        <view :style="galleryWrap">
          <swiper :style="hero" :circular="detailImages.length > 1" :indicator-dots="detailImages.length > 1" :indicator-color="n.divider" :indicator-active-color="brand[500]" @change="onGalleryChange">
            <swiper-item v-for="imageUrl in detailImages" :key="imageUrl">
              <AppImage :src="imageUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            </swiper-item>
          </swiper>
          <view v-if="detailImages.length > 1" :style="imageCounter"><text :style="imageCounterText">{{ currentImageIndex + 1 }} / {{ detailImages.length }}</text></view>
        </view>
        <view class="page-canvas">
          <view :style="summaryCard">
            <view :style="priceRow"><text :style="priceText">{{ formatPrice(item!.price) }}</text><text v-if="item!.originalPrice > item!.price" :style="oldPrice">{{ formatPrice(item!.originalPrice) }}</text></view>
            <text :style="titleText">{{ item!.title }}</text>
            <text :style="brandText">{{ item!.brandName }}</text>
            <view :style="statusRow"><view :style="statusDot" /><text :style="statusText">{{ item!.badgeText !== '' ? item!.badgeText : '官方信息' }}</text><text v-if="formatDeadline(item!.eventEndAt) !== ''" :style="deadlineText">{{ formatDeadline(item!.eventEndAt) }}</text></view>
            <view :style="decisionRow">
              <view :style="decisionAction(false)" @tap="createReminder"><AppIcon name="reminder" :size="32" :active="true" /><text :style="decisionText">设置提醒</text></view>
              <view :style="decisionAction(true)" @tap="createPurchase"><AppIcon name="order" :size="32" :active="true" /><text :style="decisionText">记入购买</text></view>
            </view>
          </view>

          <V2SectionHeader title="发售进度" />
          <view :style="timelineCard">
            <view v-for="(stage, idx) in stages" :key="stage" :style="stageItem(idx)"><view :style="stageDot(idx)" /><text :style="stageText(idx)">{{ stage }}</text></view>
          </view>

          <V2SectionHeader title="商品说明" />
          <view :style="detailCard"><text :style="detailText">{{ description !== '' ? description : (item!.subtitle !== '' ? item!.subtitle : '商品说明待品牌补充') }}</text></view>
          <view :style="actionSpacer" />
        </view>
      </view>
      <view v-else :style="emptyWrap">
        <text :style="emptyText">{{ errorMessage !== '' ? errorMessage : '商品信息不存在' }}</text>
        <view :style="retryButton" @tap="loadDetail"><text :style="retryText">重新加载</text></view>
      </view>
    </template>
  </MainLayout>
  <view v-if="item !== null" :style="actionBar">
    <view :style="minorButton" @tap="toggleSaved"><AppIcon name="wardrobe" :size="36" :active="isSaved" /><text :style="minorText">{{ isSaved ? '已收藏' : '收藏' }}</text></view>
    <view :style="officialButton" @tap="openOfficial"><text :style="officialText">前往官方渠道</text></view>
  </view>
</template>

<script setup lang="uts">
import { FeedItem } from '@/domain/content/feed-item'
import { fetchProductDetail } from '@/services/content/product-service'
import { formatPrice, formatDeadline } from '@/stores/home-feed-store'
import { apiGet, apiPost, apiDelete } from '@/services/platform/api-client'
import { getCachedAccessToken } from '@/config/runtime'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, CARD_RADIUS, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { zIndex } from '@/theme/tokens/z-index'
import { getSafeBottomInset, upx2px } from '@/utils/window-info'
import { openPrimaryTab } from '@/utils/tab-navigation'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import { showFeedback } from '@/utils/feedback'

const itemId = ref('')
const item = ref(null) as Ref<FeedItem | null>
const loading = ref(true)
const errorMessage = ref('')
const description = ref('')
const shopUrl = ref('')
const isSaved = ref(false)
const stages = ['图透', '定金', '尾款', '现货']
const currentImageIndex = ref(0)
const detailImages = ref([]) as Ref<string[]>
let savedEntityIds: string[] = []

function onGalleryChange(e: any) { currentImageIndex.value = (e.detail as any).current ?? 0 }

function isLoggedIn(): boolean {
  return getCachedAccessToken() !== ''
}

async function fetchWishlist() {
  try {
    const response = await apiGet('/api/v1/wishlist')
    const items = response.data as any[]
    if (items != null) {
      savedEntityIds = items.map((w: any) => String(w.entityId ?? w.id ?? ''))
      if (item.value !== null) {
        isSaved.value = savedEntityIds.indexOf(item.value!.entityId) >= 0
      }
    }
  } catch (_) {
    // 未登录或网络错误 — 收藏态保持 false
  }
}

async function toggleSaved() {
  if (item.value === null) return
  const entityId = item.value!.entityId
  if (entityId === '') return

  if (!isLoggedIn()) {
    showFeedback('请先登录后收藏')
    return
  }

  const currentSaved = isSaved.value
  try {
    if (currentSaved) {
      // 查找 wishlist 中对应的 ID
      const targetId = findWishlistId(entityId)
      if (targetId !== '') {
        await apiDelete(`/api/v1/wishlist/${encodeURIComponent(targetId)}`)
      }
      isSaved.value = false
      const idx = savedEntityIds.indexOf(entityId)
      if (idx >= 0) savedEntityIds.splice(idx, 1)
      showFeedback('已移出收藏')
    } else {
      await apiPost('/api/v1/wishlist', { entityId, feedType: item.value!.feedType, title: item.value!.title })
      isSaved.value = true
      savedEntityIds.unshift(entityId)
      showFeedback('已收进心动收藏')
    }
  } catch (e) {
    // 网络错误回滚状态
    isSaved.value = currentSaved
    showFeedback(e instanceof Error ? e.message : '操作失败，请重试')
  }
}

function findWishlistId(entityId: string): string {
  // 从之前缓存的结果中找对应 ID
  // 实际场景需要保存 wishlist 项的完整映射，这里简化处理
  return entityId
}

function openOfficial() {
  if (shopUrl.value === '') { showFeedback('暂未收录官方购买地址'); return }
  uni.setClipboardData({ data: shopUrl.value, success: () => { showFeedback('官方地址已复制，可在浏览器打开') } })
}

function dateOnly(value: string): string {
  if (value === '') return ''
  return value.length >= 10 ? value.substring(0, 10) : value
}

function encoded(value: string): string { return encodeURIComponent(value) }

function createReminder() {
  if (item.value === null) return
  const type = item.value!.badgeText === '尾款' ? 'BALANCE' : 'RELEASE'
  const title = `${item.value!.title} ${item.value!.badgeText !== '' ? item.value!.badgeText : '发售'}`
  const note = `${item.value!.brandName} · 来源于商品详情`
  uni.navigateTo({ url: `/pages/reminder/edit?title=${encoded(title)}&type=${type}&date=${dateOnly(item.value!.eventEndAt)}&note=${encoded(note)}` })
}

function createPurchase() {
  if (item.value === null) return
  const amount = item.value!.price > 0 ? String(item.value!.price / 100) : ''
  const category = item.value!.category === 'LOLITA' ? 'LOLITA' : (item.value!.category === 'HANFU' ? 'HANFU' : 'JK')
  uni.navigateTo({ url: `/pages/purchase/edit?name=${encoded(item.value!.title)}&brand=${encoded(item.value!.brandName)}&amount=${amount}&category=${category}&deadline=${dateOnly(item.value!.eventEndAt)}` })
}

async function loadDetail() {
  loading.value = true
  errorMessage.value = ''
  currentImageIndex.value = 0
  isSaved.value = false
  try {
    const result = await fetchProductDetail(itemId.value)
    if (result === null) { item.value = null; errorMessage.value = '商品信息不存在'; return }
    item.value = result.item
    detailImages.value = result.images
    description.value = result.description
    shopUrl.value = result.shopUrl
    // 加载收藏状态
    if (isLoggedIn()) {
      await fetchWishlist()
    }
  } catch (e) {
    item.value = null
    detailImages.value = []
    errorMessage.value = e instanceof Error ? e.message : '商品加载失败'
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  const pages = getCurrentPages()
  const current = pages[pages.length - 1]
  itemId.value = (current as any).options?.id ?? ''
  loadDetail()
})

const safeBottom = getSafeBottomInset()
const pageWrap = { paddingBottom: '0' , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const galleryWrap = { width: '750rpx', height: '750rpx', position: 'relative' as string }
const hero = computed((): any => ({ width: '750rpx', height: '750rpx', backgroundColor: n.value.bgSecondary, overflow: 'hidden' }))
const imageCounter = { position: 'absolute' as string, right: '28rpx', bottom: '28rpx', minWidth: '82rpx', height: '44rpx', paddingLeft: '14rpx', paddingRight: '14rpx', borderRadius: '22rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: 'rgba(20,18,19,0.58)' }
const imageCounterText = { fontSize: fontSize['2xs'], fontWeight: fontWeight.medium, color: baseColors.white }
const summaryCard = computed((): any => ({ marginTop: '20rpx', padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
const priceRow = { ...flexRow, alignItems: 'flex-end' }
const priceText = { fontSize: fontSize.xl, fontWeight: fontWeight.bold, color: brand[600] }
const oldPrice = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, textDecorationLine: 'line-through', marginLeft: '10rpx', marginBottom: '4rpx' }))
const titleText = computed((): any => ({ fontSize: fontSize.lg, fontWeight: fontWeight.semibold, color: n.value.text, lineHeight: '48rpx', marginTop: '14rpx' }))
const brandText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, marginTop: '8rpx' }))
const statusRow = { ...flexRow, alignItems: 'center', marginTop: '18rpx' }
const statusDot = { width: '10rpx', height: '10rpx', borderRadius: '5rpx', backgroundColor: brand[500], marginRight: '8rpx' }
const statusText = { fontSize: fontSize.xs, color: brand[600] }
const deadlineText = { fontSize: fontSize.xs, color: brand[600], marginLeft: '16rpx' }
const decisionRow = { ...flexRow, marginTop: '22rpx' }
function decisionAction(last: boolean) { return { ...flexFill, height: '68rpx', borderRadius: '34rpx', backgroundColor: n.value.bgSecondary, ...flexRow, alignItems: 'center', justifyContent: 'center', marginRight: last ? '0' : '12rpx' } }
const decisionText = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: brand[600], marginLeft: '8rpx' }))
const timelineCard = computed((): any => ({ ...flexRow, padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
function stageItem(idx: number) { return { ...flexFill, alignItems: 'center' } }
function stageDot(idx: number) { return { width: '22rpx', height: '22rpx', borderRadius: '11rpx', backgroundColor: idx < 2 ? brand[500] : n.value.divider, borderWidth: idx === 2 ? '4rpx' : '0', borderStyle: 'solid', borderColor: brand[200] } }
function stageText(idx: number) { return { fontSize: fontSize.xs, color: idx < 2 ? brand[600] : n.value.textTertiary, marginTop: '12rpx' } }
const detailCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: CARD_RADIUS, backgroundColor: n.value.surface }))
const detailText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, lineHeight: '42rpx' }))
const actionSpacer = { height: `${upx2px(160) + safeBottom}px`, flexShrink: 0 }
const emptyWrap = { flex: 1, alignItems: 'center', justifyContent: 'center' }
const emptyText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary })); const retryButton = { marginTop: '24rpx', height: '68rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '34rpx', backgroundColor: brand[100], alignItems: 'center', justifyContent: 'center' }; const retryText = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: brand[700] }
const actionBar = computed((): any => ({ position: 'fixed', left: '0', right: '0', bottom: '0', zIndex: zIndex.navbar, minHeight: '112rpx', paddingLeft: '24rpx', paddingRight: '24rpx', paddingBottom: `${safeBottom}px`, ...flexRow, alignItems: 'center', backgroundColor: n.value.surface, borderTopWidth: '1rpx', borderTopStyle: 'solid', borderTopColor: n.value.divider }))
const minorButton = { width: '112rpx', alignItems: 'center', justifyContent: 'center' }
const minorText = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textSecondary, marginTop: '4rpx' }))
const officialButton = { ...flexFill, height: '76rpx', borderRadius: '38rpx', backgroundColor: brand[600], alignItems: 'center', justifyContent: 'center', marginLeft: '16rpx' }
const officialText = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: baseColors.white }
</script>


