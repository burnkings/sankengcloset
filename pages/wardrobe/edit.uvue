<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar>
      <AppNavbar :title="isEdit ? '编辑单品' : '添加单品'" :show-back="true" />
    </template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="photoCard" @tap="choosePhoto">
          <AppImage v-if="imagePath !== ''" :src="imagePath" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
          <view v-else :style="photoEmpty"><AppIcon name="camera" :size="52" :active="true" /><text :style="photoText">添加单品照片</text></view>
        </view>

        <FormSection title="基本信息">
          <FieldLabel label="单品名称" /><AppInput v-model="form.name" placeholder="例如：深蓝格裙 45cm" :clearable="true" />
          <FieldLabel label="坑向" /><SegmentedControl :items="categories" :active="activeCategory" @change="onCategory" />
          <view :style="twoColumnRow">
            <view :style="halfField"><FieldLabel label="品牌" /><AppInput v-model="form.brand" placeholder="品牌" /></view>
            <view :style="halfFieldLast"><FieldLabel label="购买价格" /><AppInput v-model="form.price" placeholder="0" type="digit" /></view>
          </view>
          <view :style="twoColumnRow">
            <view :style="halfField"><FieldLabel label="颜色" /><AppInput v-model="form.color" placeholder="主色" /></view>
            <view :style="halfFieldLast"><FieldLabel label="尺码" /><AppInput v-model="form.size" placeholder="尺码" /></view>
          </view>
        </FormSection>

        <FormSection title="穿着状态">
          <SegmentedControl :items="wearLabels" :active="activeWearLabel" @change="onWear" />
        </FormSection>

        <FormSection v-if="isEdit && sourcePurchase != null" title="来源订单">
          <view :style="sourceOrderCard" @tap="openSourcePurchase">
            <view :style="sourceOrderCopy">
              <text :style="sourceOrderTitle">{{ sourcePurchase.name }}</text>
              <text :style="sourceOrderMeta">{{ sourcePurchase.shopName !== '' ? sourcePurchase.shopName : '购买记录' }}</text>
            </view>
            <view :style="sourceOrderRight">
              <text :style="sourceOrderPrice">¥{{ (sourcePurchase.totalAmount / 100).toFixed(2) }}</text>
              <AppIcon name="chevron-right" :size="28" />
            </view>
          </view>
        </FormSection>

        <FormSection title="备注">
          <view :style="noteShell"><textarea :value="form.note" placeholder="搭配想法、版型或养护信息" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" /></view>
        </FormSection>

      </view>
    </template>
  </MainLayout>
  <view v-if="isEdit" :style="contentDeleteBtn" @tap="deleteItem"><text :style="contentDeleteBtnText">删除单品</text></view>
  <BottomActionBar><view :style="saveButton" @tap="save"><text :style="saveButtonText">{{ isEdit ? '保存修改' : '加入衣橱' }}</text></view></BottomActionBar>
  <AppDialog v-model:visible="showDeleteDialog" title="确认删除" message="删除后无法恢复，确定要删除这件单品吗？" confirm-text="删除" @confirm="deleteItem" />
</template>

<script setup lang="uts">
import { WardrobeItem, WardrobeUpdateData, wardrobeCoverImage } from '@/domain/wardrobe-item'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { PurchaseRecord } from '@/domain/purchase-record'
import { useWishListStore } from '@/stores/wishlist-store'
import { brand, baseColors, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import SegmentedControl from '@/components/v3/SegmentedControl.uvue'
import FormSection from '@/components/v3/FormSection.uvue'
import FieldLabel from '@/components/v3/FieldLabel.uvue'
import BottomActionBar from '@/components/v3/BottomActionBar.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'

const store = useWardrobeStore()
const purchaseStore = usePurchaseStore()
const wishStore = useWishListStore()
const isEdit = ref(false)
const editId = ref('')
const imagePath = ref('')
const showDeleteDialog = ref(false)
const sourcePurchaseId = ref('')
const sourceWishId = ref('')
const sourcePurchaseDate = ref('')
type WardrobeFormState = {
  name: string
  category: string
  brand: string
  price: string
  color: string
  size: string
  wearStatus: string
  note: string
}
const form = ref<WardrobeFormState>({ name: '', category: 'JK', brand: '', price: '', color: '', size: '', wearStatus: 'UNWORN', note: '' })
const categories = ['JK', 'Lolita', '汉服', '其他']
const wearLabels = ['未穿', '已穿', '常穿']
const activeCategory = computed((): string => form.value.category === 'LOLITA' ? 'Lolita' : (form.value.category === 'HANFU' ? '汉服' : (form.value.category === 'OTHER' ? '其他' : 'JK')))
const activeWearLabel = computed((): string => form.value.wearStatus === 'WORN' ? '已穿' : (form.value.wearStatus === 'FREQUENT' ? '常穿' : '未穿'))

function onCategory(label: string) { form.value.category = label === 'Lolita' ? 'LOLITA' : (label === '汉服' ? 'HANFU' : (label === '其他' ? 'OTHER' : 'JK')) }
function onWear(label: string) { form.value.wearStatus = label === '已穿' ? 'WORN' : (label === '常穿' ? 'FREQUENT' : 'UNWORN') }
function onNoteInput(e: any) {
  const eObj = e as UTSJSONObject
  const d = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
  form.value.note = d != null && d['value'] != null ? d['value'] as string : ''
}
function choosePhoto() {
  uni.chooseImage({ count: 1, sizeType: ['compressed'], sourceType: ['album', 'camera'], success: (res) => {
    const temporary = res.tempFilePaths.length > 0 ? res.tempFilePaths[0] : ''
    if (temporary === '') return
    imagePath.value = temporary
  } })
}
function save() {
  if (form.value.name.trim() === '') { showFeedback('请填写单品名称'); return }
  const price = form.value.price.trim() === '' ? 0 : parseFloat(form.value.price)
  if (isNaN(price) || price < 0) { showFeedback('请填写正确的价格'); return }
  if (isEdit.value) {
    const data = new WardrobeUpdateData()
    data.name = form.value.name.trim(); data.category = form.value.category; data.brand = form.value.brand.trim(); data.purchasePrice = price
    data.color = form.value.color.trim(); data.size = form.value.size.trim(); data.wearStatus = form.value.wearStatus; data.note = form.value.note.trim()
    data.images = imagePath.value === '' ? [] : [imagePath.value]
    if (!store.updateItem(editId.value, data)) { showFeedback('保存失败，请重试'); return }
  } else {
    const item = new WardrobeItem()
    item.name = form.value.name.trim(); item.category = form.value.category; item.brand = form.value.brand.trim(); item.purchasePrice = price
    item.color = form.value.color.trim(); item.size = form.value.size.trim(); item.wearStatus = form.value.wearStatus; item.note = form.value.note.trim()
    item.images = imagePath.value === '' ? [] : [imagePath.value]
    item.purchaseId = sourcePurchaseId.value
    item.wishId = sourceWishId.value
    item.purchaseDate = sourcePurchaseDate.value
    const added = store.addItem(item)
    if (added === null) { showFeedback('保存失败，请重试'); return }
    if (sourcePurchaseId.value !== '') purchaseStore.linkWardrobe(sourcePurchaseId.value, added.id)
    if (sourceWishId.value !== '') wishStore.linkWardrobe(sourceWishId.value, added.id)
  }
  showFeedback(isEdit.value ? '衣橱单品已更新' : '已加入衣橱')
  setTimeout(() => { uni.navigateBack() }, 240)
}
function deleteItem() { if (store.deleteItem(editId.value)) { showFeedback('已从衣橱删除'); setTimeout(() => { uni.navigateBack() }, 220) } }
function safeParam(value: string): string { try { return value.indexOf('%') >= 0 ? (decodeURIComponent(value) ?? value) : value } catch (e) { return value } }
onMounted(() => {
  store.fetchItems()
  const pages = getCurrentPages(); const current = pages[pages.length - 1]; const options = current.options; const id = options != null && options['id'] != null ? options['id'] as string : ''
  if (id === '') {
    if (options != null) {
      form.value.name = options['name'] != null ? safeParam(options['name'] as string) : ''
      form.value.brand = options['brand'] != null ? safeParam(options['brand'] as string) : ''
      form.value.category = options['category'] != null ? options['category'] as string : 'JK'
      form.value.price = options['price'] != null ? safeParam(options['price'] as string) : ''
      sourcePurchaseId.value = options['purchaseId'] != null ? options['purchaseId'] as string : ''
      sourceWishId.value = options['wishId'] != null ? options['wishId'] as string : ''
      sourcePurchaseDate.value = options['purchaseDate'] != null ? safeParam(options['purchaseDate'] as string) : ''
    }
    return
  }
  editId.value = id; isEdit.value = true
  const item = store.getById(id)
  if (item == null) return
  form.value.name = item.name; form.value.category = item.category; form.value.brand = item.brand; form.value.price = item.purchasePrice > 0 ? item.purchasePrice.toString() : ''
  form.value.color = item.color; form.value.size = item.size; form.value.wearStatus = item.wearStatus; form.value.note = item.note; imagePath.value = wardrobeCoverImage(item)
  sourcePurchaseId.value = item.purchaseId
  sourceWishId.value = item.wishId
})

// 编辑态「来源订单」卡片：从衣橱反查下单店铺/金额/尾款状态
const sourcePurchase = computed((): PurchaseRecord | null => {
  if (sourcePurchaseId.value === '') return null
  return purchaseStore.getPurchaseById(sourcePurchaseId.value)
})
function openSourcePurchase() {
  if (sourcePurchaseId.value !== '') uni.navigateTo({ url: `/pages/purchase/detail?id=${sourcePurchaseId.value}` })
}

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: '180rpx' , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
const editSafeBottom = getSafeBottomInset()
// V3 §5.9 主按钮：88rpx 高、16rpx 圆角
const saveButton = computed((): any => ({ width: '100%', height: '88rpx', borderRadius: '16rpx', backgroundColor: brand[500] as string, alignItems: 'center' as string, justifyContent: 'center' as string }))
const saveButtonText = { fontSize: fontSize.base, fontWeight: fontWeight.medium, color: baseColors.white }
const sourceOrderCard = computed((): any => ({ flexDirection: 'row', alignItems: 'center', padding: '20rpx', borderRadius: '16rpx', backgroundColor: n.value.inputFill }))
const sourceOrderCopy = { flex: 1 }
const sourceOrderTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold as number, color: n.value.text, lines: 1 as const, textOverflow: 'ellipsis' as string }))
const sourceOrderMeta = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '4rpx' }))
const sourceOrderRight = { flexDirection: 'row' as string, alignItems: 'center', flexShrink: 0, marginLeft: '12rpx' }
const sourceOrderPrice = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold as number, color: brand[500] as string, marginRight: '4rpx' }))
const photoCard = computed((): any => ({ width: '686rpx', height: '460rpx', borderRadius: '16rpx', overflow: 'hidden', backgroundColor: n.value.bgTertiary }))
const photoEmpty = { flex: 1, alignItems: 'center', justifyContent: 'center' }
const photoText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, marginTop: '16rpx' }))
const twoColumnRow = { ...flexRow, marginTop: '30rpx' }
const halfField = { width: '327rpx', marginRight: '16rpx' }
const halfFieldLast = { ...flexFill }
// V3 §4.4 多行输入：16rpx 圆角、surface.subtle 底
const noteShell = computed((): any => ({ minHeight: '190rpx', padding: CARD_PADDING, borderRadius: '16rpx', backgroundColor: n.value.inputFill }))
const noteInput = computed((): any => ({ width: '100%', minHeight: '150rpx', fontSize: fontSize.sm, color: n.value.text, lineHeight: '40rpx' }))
const placeholderStyle = computed((): string => `color:${n.value.placeholder}`)
// V3 §6.13 危险操作：页面末尾、与保存分离、确认后执行
const contentDeleteBtn = computed((): any => ({ position: 'fixed' as string, left: '0', right: '0', bottom: `${editSafeBottom + 108}px`, height: '44rpx', alignItems: 'center', justifyContent: 'center', zIndex: 99 }))
const contentDeleteBtnText = { fontSize: fontSize.sm, color: semantic.error as string }
</script>
