<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="月度预算" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="summaryCard">
          <text :style="summaryEyebrow">{{ currentMonth }} 已记录承诺金额</text>
          <text :style="spentText">¥{{ formatAmount(monthSpent) }}</text>
          <view :style="summaryRow">
            <text :style="summaryMeta">月预算 ¥{{ formatAmount(limitValue) }}</text>
            <text :style="summaryMeta">剩余 ¥{{ formatAmount(remaining) }}</text>
          </view>
        </view>

        <text :style="fieldLabel">月预算上限</text>
        <AppInput v-model="limitText" placeholder="例如：2000" type="digit" />

        <text :style="fieldLabel">提醒阈值</text>
        <V2Segmented :items="alertLabels" :active="activeAlert" variant="solid" :active-color="brand[500]" @change="onAlert" />

        <view :style="ruleCard">
          <view :style="ruleIcon"><text :style="ruleMark">!</text></view>
          <view :style="ruleTextWrap">
            <text :style="ruleText">按购买记录中的商品总额计算，包含尚未支付的尾款；</text>
            <text :style="ruleText">不会读取外部平台账单。</text>
          </view>
        </view>

        <view :style="saveButton" @tap="save"><text :style="saveText">保存预算</text></view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { useBudgetStore } from '@/stores/budget-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import V2Segmented from '@/components/v2/V2Segmented.uvue'

const budget = useBudgetStore(); const purchases = usePurchaseStore()
const limitText = ref(budget.monthlyLimit > 0 ? budget.monthlyLimit.toString() : '')
const alertValue = ref(budget.alertPercent)
const alertLabels = ['70%', '80%', '90%']
const activeAlert = computed((): string => `${alertValue.value}%`)
const now = new Date(); const monthNumber = now.getMonth() + 1; const currentMonth = `${now.getFullYear()}年${monthNumber}月`; const monthCode = `${now.getFullYear()}-${monthNumber < 10 ? '0' + monthNumber.toString() : monthNumber.toString()}`
const monthSpent = computed((): number => purchases.filteredItems.filter((item) => item.purchaseDate.indexOf(monthCode) === 0).reduce((sum, item) => sum + item.totalAmount, 0))
const limitValue = computed((): number => { const value = limitText.value.trim() === '' ? 0 : parseFloat(limitText.value); return isNaN(value) ? 0 : value })
const remaining = computed((): number => Math.max(0, limitValue.value - monthSpent.value))
function onAlert(label: string) { alertValue.value = parseInt(label.replace('%', '')) }
function formatAmount(value: number): string { return value === Math.floor(value) ? Math.floor(value).toString() : value.toFixed(2) }
function save() { if (limitValue.value <= 0) { showFeedback('请填写大于 0 的月预算'); return }; budget.save(limitValue.value, alertValue.value); showFeedback('月预算已保存'); setTimeout(() => { uni.navigateBack() }, 220) }
const safeBottom = getSafeBottomInset()
onMounted(() => { purchases.fetchPurchases() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: `${safeBottom + 60}px` , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const summaryCard = computed((): any => ({ padding: CARD_PADDING, borderRadius: '32rpx', backgroundColor: n.value.surfacePink }))
const summaryEyebrow = computed((): any => ({ fontSize: '24rpx', color: n.value.textSecondary }))
const spentText = computed((): any => ({ fontSize: '56rpx', fontWeight: fontWeight.bold, color: n.value.text, marginTop: '10rpx' }))
const summaryRow = { ...flexRow, marginTop: '16rpx', justifyContent: 'space-between' }
const summaryMeta = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary }))
const fieldLabel = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '40rpx', marginBottom: '14rpx' }))
const ruleCard = computed((): any => ({ ...flexRow, alignItems: 'flex-start', padding: '24rpx', borderRadius: '24rpx', backgroundColor: '#F5EFEC', marginTop: '24rpx' }))
const ruleIcon = computed((): any => ({ width: '48rpx', height: '48rpx', borderRadius: '24rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, alignItems: 'center', justifyContent: 'center', flexShrink: 0, marginRight: '14rpx' }))
const ruleMark = { fontSize: '32rpx', fontWeight: fontWeight.bold, color: brand[500], lineHeight: '48rpx' }
const ruleTextWrap = { ...flexFill }
const ruleText = computed((): any => ({ fontSize: '22rpx', color: n.value.text, lineHeight: '34rpx' }))
const saveButton = computed((): any => ({ width: '100%', height: '104rpx', borderRadius: '52rpx', backgroundColor: brand[500], alignItems: 'center' as string, justifyContent: 'center' as string, marginTop: '48rpx' }))
const saveText = { fontSize: '32rpx', fontWeight: fontWeight.semibold, color: baseColors.white }
</script>
