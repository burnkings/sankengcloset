<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="月度预算" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <!-- V3 §6.14 主模块：预算使用进度（非多张统计卡） -->
        <view :style="progressCard">
          <view :style="progressHeader">
            <text :style="progressMonth">{{ currentMonth }}</text>
            <text :style="progressUsage">已使用 {{ usagePercent }}%</text>
          </view>
          <view :style="progressTrack"><view :style="progressFill" /></view>
          <SummaryStrip :items="summaryItems" />
        </view>

        <text :style="fieldLabel">月预算上限</text>
        <AppInput v-model="limitText" placeholder="例如：2000" type="digit" />

        <text :style="fieldLabel">提醒阈值</text>
        <SegmentedControl :items="alertLabels" :active="activeAlert" @change="onAlert" />

        <view :style="ruleCard">
          <view :style="ruleIcon"><AppIcon name="info" :size="36" :active="true" /></view>
          <view :style="ruleTextWrap">
            <text :style="ruleText">已承诺 ¥{{ formatAmount(monthCommitted) }}，预算剩余 ¥{{ formatAmount(remaining) }}。</text>
            <text :style="ruleText">其中含“决定买”的 ¥{{ formatAmount(decisionReserve) }} 预留；{{ alertText }}</text>
          </view>
        </view>

        <view :style="saveButton" @tap="save"><text :style="saveText">保存预算</text></view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { useBudgetStore } from '@/stores/budget-store'
import { usePurchaseStore } from '@/stores/purchase-store'
import { useWishListStore } from '@/stores/wishlist-store'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, isDark, initPageTheme } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import SummaryStrip from '@/components/v3/SummaryStrip.uvue'
import SegmentedControl from '@/components/v3/SegmentedControl.uvue'

const budget = useBudgetStore(); const purchases = usePurchaseStore(); const wishes = useWishListStore()
// 保存后延迟返回的定时器：页面卸载时清理，避免残留
let backTimer: number | null = null
onUnload(() => { if (backTimer != null) { clearTimeout(backTimer); backTimer = null } })
const limitText = ref(budget.monthlyLimit > 0 ? budget.monthlyLimit.toString() : '')
const alertValue = ref(budget.alertPercent)
const alertLabels = ['70%', '80%', '90%']
const activeAlert = computed((): string => `${alertValue.value}%`)
const now = new Date(); const monthNumber = now.getMonth() + 1; const currentMonth = `${now.getFullYear()}年${monthNumber}月`; const monthCode = `${now.getFullYear()}-${monthNumber < 10 ? '0' + monthNumber.toString() : monthNumber.toString()}`
const decisionReserve = computed((): number => wishes.decisionReserveTotal)
// 订单金额单位为分（PurchaseRecord）；预算上限为元，这里 ÷100 统一到元再参与预算计算
const purchaseCommitted = computed((): number => purchases.monthlyCommitted(monthCode) / 100)
const monthCommitted = computed((): number => purchaseCommitted.value + decisionReserve.value)
const monthPaid = computed((): number => purchases.monthlyPaid(monthCode) / 100)
const monthOutstanding = computed((): number => purchases.monthlyOutstanding(monthCode) / 100)
const limitValue = computed((): number => { const value = limitText.value.trim() === '' ? 0 : parseFloat(limitText.value); return (isNaN(value) || !isFinite(value)) ? 0 : value })
const remaining = computed((): number => Math.max(0, limitValue.value - monthCommitted.value))
const usagePercent = computed((): number => limitValue.value <= 0 ? 0 : Math.round(monthCommitted.value / limitValue.value * 100))
const alertText = computed((): string => usagePercent.value >= alertValue.value ? `已触及 ${alertValue.value}% 预警线` : `距 ${alertValue.value}% 预警线还有空间`)
function onAlert(label: string) { alertValue.value = parseInt(label.replace('%', '')) }
function formatAmount(value: number): string { return value === Math.floor(value) ? Math.floor(value).toString() : value.toFixed(2) }
function save() { if (limitValue.value <= 0) { showFeedback('请填写大于 0 的月预算'); return }; budget.save(limitValue.value, alertValue.value); showFeedback('月预算已保存'); backTimer = setTimeout(() => { uni.navigateBack() }, 220) }
const safeBottom = getSafeBottomInset()
onMounted(() => {
  purchases.fetchPurchases()
  wishes.fetchItems()
  budget.refreshRemoteBudget().then(() => {
    if (limitText.value === '') limitText.value = budget.monthlyLimit > 0 ? budget.monthlyLimit.toString() : ''
    alertValue.value = budget.alertPercent
  })
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: `${safeBottom + 60}px` , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
const fieldLabel = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '40rpx', marginBottom: '14rpx' }))
// V3 §6.14 预算使用进度卡
const progressCard = computed((): any => ({ padding: '28rpx', borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border, marginTop: '8rpx' }))
const progressHeader = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', marginBottom: '16rpx' }
const progressMonth = computed((): any => ({ fontSize: '30rpx', fontWeight: fontWeight.semibold, color: n.value.text }))
const progressUsage = computed((): any => ({ fontSize: '24rpx', fontWeight: 600, color: usagePercent.value >= alertValue.value ? brand.strong : n.value.textSecondary }))
const progressTrack = computed((): any => ({ height: '12rpx', borderRadius: '6rpx', backgroundColor: n.value.bgTertiary, overflow: 'hidden', marginBottom: '20rpx' }))
const progressFill = computed((): any => ({ height: '12rpx', width: `${Math.min(100, usagePercent.value)}%`, borderRadius: '6rpx', backgroundColor: usagePercent.value >= alertValue.value ? brand.strong : brand.primary }))
const summaryItems = computed(() => [
  { label: '已支付', value: `¥${formatAmount(monthPaid.value)}` },
  { label: '待支付', value: `¥${formatAmount(monthOutstanding.value)}` },
  { label: '剩余', value: `¥${formatAmount(remaining.value)}`, highlight: remaining.value < 0 },
])
const ruleCard = computed((): any => ({ ...flexRow, flexDirection: 'row', alignItems: 'flex-start', padding: '24rpx', borderRadius: '16rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, marginTop: '24rpx' }))
const saveButton = computed((): any => ({ width: '100%', height: '88rpx', borderRadius: '16rpx', backgroundColor: brand[500] as string, alignItems: 'center' as string, justifyContent: 'center' as string, marginTop: '48rpx' }))
const saveText = { fontSize: fontSize.base, fontWeight: fontWeight.medium, color: baseColors.white }
const ruleIcon = computed((): any => ({ width: '48rpx', height: '48rpx', borderRadius: '24rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.surfacePink, alignItems: 'center', justifyContent: 'center', flexShrink: 0, marginRight: '14rpx' }))
const ruleTextWrap = { ...flexFill }
const ruleText = computed((): any => ({ fontSize: '22rpx', color: n.value.text, lineHeight: '34rpx' }))
</script>
