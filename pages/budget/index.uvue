<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="消费日志" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="budgetCard">
          <view :style="budgetHeader">
            <view :style="budgetCopy">
              <text :style="budgetTitle">月度预算</text>
              <text :style="budgetDesc">{{ budgetDescription }}</text>
            </view>
            <text :style="budgetAction" @tap="toggleBudgetEditor">{{ showBudgetEditor ? '收起' : (budget.isConfigured ? '调整' : '设置') }}</text>
          </view>
          <view v-if="budget.isConfigured" :style="progressTrack"><view :style="progressBar" /></view>
          <view v-if="showBudgetEditor" :style="budgetEditor">
            <AppInput v-model="budgetLimitInput" placeholder="每月预算（元）" type="digit" />
            <text :style="budgetEditorHint">消费达到预算 {{ alertPercent }}% 时提示</text>
            <SegmentedControl :items="alertOptions" :active="alertLabel" @change="onAlertChange" />
            <view :style="budgetSave" @tap="saveBudget"><text :style="budgetSaveText">保存预算</text></view>
          </view>
        </view>

        <!-- 月份切换器：可查看任意历史月份 -->
        <view :style="monthBar">
          <view :style="monthArrow" @tap="prevMonth"><text :style="monthArrowText">‹</text></view>
          <view @tap="showMonthPicker = true"><text :style="monthTitle">{{ displayMonth }}⌄</text></view>
          <view :style="monthArrow" @tap="nextMonth"><text :style="monthArrowText">›</text></view>
        </view>

        <!-- 月度汇总 -->
        <view :style="summaryCard">
          <SummaryStrip :items="summaryItems" :surface="true" />
        </view>

        <!-- 分类小计 -->
        <view v-if="categoryRows.length > 0" :style="categoryCard">
          <text :style="categoryTitle">分类支出</text>
          <view v-for="row in categoryRows" :key="row.label" :style="categoryRow">
            <text :style="categoryLabel">{{ row.label }}</text>
            <text :style="categoryValue">{{ row.value }}</text>
          </view>
        </view>

        <!-- 逐笔消费流水（按日期分组） -->
        <view v-if="visibleGroups.length > 0" :style="feedWrap">
          <view v-for="group in visibleGroups" :key="group.date" :style="groupBlock">
            <view :style="groupHeader">
              <text :style="groupHeaderDate">{{ formatDay(group.date) }}</text>
              <text :style="groupHeaderTotal">支出 {{ group.totalText }}</text>
            </view>
            <ListGroup>
              <view v-for="(item, idx) in group.items" :key="item.id" :style="itemRow(item, idx, group.items.length)" @tap="openDetail(item.id)">
                <view :style="categoryDot(item)"><text :style="categoryDotText(item)">{{ categoryAbbr(item) }}</text></view>
                <view :style="itemCopy">
                  <text :style="itemName">{{ item.name }}</text>
                  <text :style="itemMeta">{{ item.brand !== '' ? item.brand : '三坑好物' }} · {{ statusText(item) }}</text>
                </view>
                <view :style="itemAmountWrap">
                  <text :style="itemAmount">{{ formatCentsYuan(item.paidAmount) }}</text>
                  <text v-if="item.remainingAmount > 0" :style="itemRemain">待付 {{ formatCentsYuan(item.remainingAmount) }}</text>
                </view>
              </view>
            </ListGroup>
          </view>
        </view>

        <!-- 空态 -->
        <view v-else :style="emptyWrap">
          <PageState icon="order" title="该月暂无消费" message="切换月份查看历史记录" />
        </view>
      </view>
    </template>
  </MainLayout>
  <MonthPicker v-model:visible="showMonthPicker" :value="monthCursor" @change="onMonthPick" />
</template>

<script setup lang="uts">
import { usePurchaseStore } from '@/stores/purchase-store'
import { useBudgetStore } from '@/stores/budget-store'
import { PurchaseRecord, PAYMENT_STATUS_LABELS } from '@/domain/purchase-record'
import { formatCentsYuan } from '@/utils/format'
import { fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import { getSafeBottomInset } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import MonthPicker from '@/components/v3/MonthPicker.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import SummaryStrip from '@/components/v3/SummaryStrip.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import SegmentedControl from '@/components/v3/SegmentedControl.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import PageState from '@/components/v3/PageState.uvue'
import { brand, baseColors } from '@/theme/tokens/colors'
import { showFeedback } from '@/utils/feedback'
import { parseMoneyYuan } from '@/utils/money'

const purchases = usePurchaseStore()
const budget = useBudgetStore()

// ====== 月份切换 ======

function padMonth(m: number): string { return m < 10 ? '0' + m.toString() : m.toString() }
const now = new Date()
const monthCursor = ref(`${now.getFullYear()}-${padMonth(now.getMonth() + 1)}`)
const showMonthPicker = ref(false)
function onMonthPick(value: string) { monthCursor.value = value }
const showBudgetEditor = ref(false)
const budgetLimitInput = ref('')
const alertPercent = ref(80)
const alertOptions = ['70%', '80%', '90%', '100%']
const alertLabel = computed((): string => alertPercent.value.toString() + '%')

const currentMonthPaid = computed((): number => purchases.monthlyPaid(monthCursor.value))
const budgetRatio = computed((): number => budget.monthlyLimit > 0 ? Math.min(100, Math.round(currentMonthPaid.value * 100 / budget.monthlyLimit)) : 0)
const budgetDescription = computed((): string => {
  if (!budget.isConfigured) return '设定上限后，这里会显示本月使用进度'
  const remain = Math.max(0, budget.monthlyLimit - currentMonthPaid.value)
  return `已用 ${budgetRatio.value}% · 剩余 ${formatCentsYuan(remain)}`
})
function yuanInput(cents: number): string { return cents <= 0 ? '' : (cents / 100).toString() }
function toggleBudgetEditor() {
  showBudgetEditor.value = !showBudgetEditor.value
  if (showBudgetEditor.value) {
    budgetLimitInput.value = yuanInput(budget.monthlyLimit)
    alertPercent.value = budget.alertPercent
  }
}
function onAlertChange(label: string) { alertPercent.value = parseInt(label) }
function saveBudget() {
  const cents = parseMoneyYuan(budgetLimitInput.value)
  if (cents <= 0) { showFeedback('请输入有效的月度预算'); return }
  budget.save(cents, alertPercent.value)
  showBudgetEditor.value = false
  showFeedback('月度预算已保存')
}
const displayMonth = computed((): string => {
  const parts = monthCursor.value.split('-')
  return `${parts[0]}年${parseInt(parts[1])}月`
})
function shiftMonth(delta: number) {
  const parts = monthCursor.value.split('-')
  let year = parseInt(parts[0])
  let month = parseInt(parts[1]) + delta
  if (month < 1) { month = 12; year -= 1 }
  if (month > 12) { month = 1; year += 1 }
  monthCursor.value = `${year}-${padMonth(month)}`
}
function prevMonth() { shiftMonth(-1) }
function nextMonth() { shiftMonth(1) }

// ====== 月度数据（复用 purchase-store 既有能力）======

const records = computed((): PurchaseRecord[] => purchases.recordsForMonth(monthCursor.value))

const summaryItems = computed(() => [
  { label: '本月已付', value: formatCentsYuan(purchases.monthlyPaid(monthCursor.value)) },
  { label: '待付尾款', value: formatCentsYuan(purchases.monthlyOutstanding(monthCursor.value)), highlight: purchases.monthlyOutstanding(monthCursor.value) > 0 },
  { label: '订单笔数', value: `${records.value.length} 笔` },
])

const categoryRows = computed((): Array<{ label: string; value: string }> => {
  const codes = ['JK', 'LOLITA', 'HANFU', 'OTHER']
  const names = ['JK', 'Lolita', '汉服', '其他']
  const rows: Array<{ label: string; value: string }> = []
  let total = 0
  for (let i = 0; i < codes.length; i++) {
    let sum = 0
    for (let j = 0; j < records.value.length; j++) {
      if (records.value[j].category == codes[i]) sum += records.value[j].paidAmount
    }
    if (sum > 0) {
      rows.push({ label: names[i], value: formatCentsYuan(sum) })
      total += sum
    }
  }
  if (total > 0) rows.push({ label: '合计', value: formatCentsYuan(total) })
  return rows
})

type DayGroup = { date: string; totalText: string; items: PurchaseRecord[] }
const visibleGroups = computed((): DayGroup[] => {
  const map = new Map<string, PurchaseRecord[]>()
  for (let i = 0; i < records.value.length; i++) {
    const rec = records.value[i]
    const date = rec.purchaseDate
    if (date === '') continue
    const list = map.get(date)
    if (list == null) map.set(date, [rec])
    else list.push(rec)
  }
  const dates = Array.from(map.keys())
  dates.sort().reverse()
  const groups: DayGroup[] = []
  for (let i = 0; i < dates.length; i++) {
    const group = map.get(dates[i])
    if (group == null) continue
    let total = 0
    for (let j = 0; j < group.length; j++) total += group[j].paidAmount
    groups.push({ date: dates[i], totalText: formatCentsYuan(total), items: group })
  }
  return groups
})

function formatDay(date: string): string {
  const parts = date.split('-')
  if (parts.length < 3) return date
  const m = parseInt(parts[1])
  const d = parseInt(parts[2])
  return `${m}月${d}日`
}
function statusText(item: PurchaseRecord): string {
  const label = PAYMENT_STATUS_LABELS[item.paymentStatus]
  return label != null ? label as string : ''
}
function categoryAbbr(item: PurchaseRecord): string {
  if (item.category == 'LOLITA') return 'L'
  if (item.category == 'HANFU') return '汉'
  if (item.category == 'OTHER') return '其'
  return 'J'
}
function categoryDot(item: PurchaseRecord): any {
  let bg = '#F7E7EC'
  if (item.category == 'LOLITA') bg = '#F3F0F7'
  if (item.category == 'HANFU') bg = '#FBF2E8'
  if (item.category == 'OTHER') bg = '#F0E6E8'
  return { width: '56rpx', height: '56rpx', borderRadius: '28rpx', backgroundColor: bg, alignItems: 'center', justifyContent: 'center', marginRight: '16rpx', flexShrink: 0 }
}
function categoryDotText(item: PurchaseRecord): any {
  let fg = '#D45F7E'
  if (item.category == 'LOLITA') fg = '#9B6FAE'
  if (item.category == 'HANFU') fg = '#C4924A'
  if (item.category == 'OTHER') fg = '#8A8184'
  return { fontSize: '22rpx', fontWeight: 600, color: fg }
}
function openDetail(id: string) { uni.navigateTo({ url: `/pages/purchase/detail?id=${id}` }) }

// ====== 生命周期 ======

onLoad(() => { initPageTheme() })
onShow(() => { initPageTheme(); purchases.fetchPurchases(); budget.refreshRemoteBudget() })

const safeBottom = getSafeBottomInset()
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: `${safeBottom + 40}px`, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const budgetCard = computed((): any => ({ padding: '24rpx', borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border, marginBottom: '24rpx' }))
const budgetHeader = { ...flexRow, alignItems: 'center' }
const budgetCopy = { flex: 1 }
const budgetTitle = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text }))
const budgetDesc = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary, marginTop: '6rpx' }))
const budgetAction = { fontSize: '24rpx', fontWeight: 600, color: brand[600] }
const progressTrack = computed((): any => ({ height: '12rpx', borderRadius: '6rpx', backgroundColor: n.value.bgSecondary, marginTop: '20rpx', overflow: 'hidden' }))
const progressBar = computed((): any => ({ width: budgetRatio.value.toString() + '%', height: '12rpx', borderRadius: '6rpx', backgroundColor: budgetRatio.value >= budget.alertPercent ? '#E8956A' : brand[500] }))
const budgetEditor = { marginTop: '20rpx' }
const budgetEditorHint = computed((): any => ({ fontSize: '22rpx', color: n.value.textSecondary, marginTop: '16rpx', marginBottom: '12rpx' }))
const budgetSave = { height: '72rpx', borderRadius: '16rpx', backgroundColor: brand[500], alignItems: 'center', justifyContent: 'center', marginTop: '20rpx' }
const budgetSaveText = { fontSize: '26rpx', fontWeight: 600, color: baseColors.white }
const monthBar = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', marginBottom: '16rpx' }
const monthArrow = { width: '88rpx', height: '88rpx', alignItems: 'center', justifyContent: 'center' }
const monthArrowText = computed((): any => ({ fontSize: '44rpx', lineHeight: '44rpx', color: n.value.textSecondary }))
const monthTitle = computed((): any => ({ fontSize: '32rpx', fontWeight: fontWeight.semibold, color: n.value.text }))
const summaryCard = { marginBottom: '24rpx' }
const categoryCard = computed((): any => ({ padding: '24rpx', borderRadius: '20rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border, marginBottom: '24rpx' }))
const categoryTitle = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, marginBottom: '8rpx' }))
const categoryRow = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', paddingTop: '10rpx', paddingBottom: '10rpx' }
const categoryLabel = computed((): any => ({ fontSize: '26rpx', color: n.value.textSecondary }))
const categoryValue = computed((): any => ({ fontSize: '26rpx', fontWeight: 600, color: n.value.text }))
const feedWrap = {}
const groupBlock = { marginBottom: '24rpx' }
const groupHeader = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', paddingTop: '8rpx', paddingBottom: '12rpx' }
const groupHeaderDate = computed((): any => ({ fontSize: '24rpx', fontWeight: 600, color: n.value.textSecondary }))
const groupHeaderTotal = computed((): any => ({ fontSize: '22rpx', color: n.value.textTertiary }))
function itemRow(item: PurchaseRecord, idx: number, count: number): any {
  const last = idx >= count - 1
  return { ...flexRow, alignItems: 'center', minHeight: '120rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderBottomWidth: last ? '0' : '1rpx', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.border }
}
const itemCopy = { flex: 1, marginRight: '12rpx' }
const itemName = computed((): any => ({ fontSize: '28rpx', fontWeight: 500, color: n.value.text, lines: 1, textOverflow: 'ellipsis' }))
const itemMeta = computed((): any => ({ fontSize: '20rpx', color: n.value.textTertiary, marginTop: '6rpx', lines: 1, textOverflow: 'ellipsis' }))
const itemAmountWrap = { alignItems: 'flex-end' as string, flexShrink: 0 }
const itemAmount = computed((): any => ({ fontSize: '28rpx', fontWeight: 600, color: n.value.text }))
const itemRemain = computed((): any => ({ fontSize: '18rpx', color: n.value.textTertiary, marginTop: '4rpx' }))
const emptyWrap = { paddingTop: '48rpx' }
</script>
