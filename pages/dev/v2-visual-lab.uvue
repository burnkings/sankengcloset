<template>
  <view :style="page">
    <view :style="header">
      <text :style="title">V2 Visual Lab</text>
      <text :style="subtitle">Phase 2A.2 — Visual Foundation Gate</text>
    </view>

    <!-- Color Palette -->
    <view :style="section">
      <text :style="sectionTitle">Color Palette</text>
      <view :style="colorGrid">
        <view v-for="sw in swatches" :key="sw.name" :style="swatchBox(sw.color)">
          <text :style="swatchLabel">{{ sw.name }}</text>
          <text :style="swatchHex">{{ sw.color }}</text>
        </view>
      </view>
    </view>

    <!-- Typography -->
    <view :style="section">
      <text :style="sectionTitle">Typography</text>
      <text :style="textPrimary">textPrimary — 页面标题 / 卡片标题</text>
      <text :style="textSecondary">textSecondary — 副标题 / 说明文字</text>
      <text :style="textTertiary">textTertiary — 品牌 / 时间 / 辅助信息</text>
    </view>

    <!-- Icons -->
    <view :style="section">
      <text :style="sectionTitle">Icon System (24px, 2px stroke)</text>
      <view :style="iconGrid">
        <view v-for="ic in icons" :key="ic" :style="iconCell">
          <AppIcon :name="ic" :size="48" />
          <text :style="iconLabel">{{ ic }}</text>
        </view>
        <view v-for="ic in icons" :key="ic + '-active'" :style="iconCell">
          <AppIcon :name="ic" :size="48" :active="true" />
          <text :style="iconLabelActive">{{ ic }} (active)</text>
        </view>
      </view>
    </view>

    <!-- Cards -->
    <view :style="section">
      <text :style="sectionTitle">Product Card (3:4)</text>
      <view :style="cardDemoRow">
        <view :style="cardDemo">
          <view :style="imgWrap34">
            <AppImage src="/static/demo/prod-01.png" width="100%" height="100%" mode="aspectFill" />
            <view :style="badgePos">
              <text :style="badgeTxt">新品</text>
            </view>
          </view>
          <view :style="cardInfo">
            <text :style="cardBrand">兔缝缝</text>
            <text :style="cardTitle">深蓝格裙 45cm</text>
            <view :style="priceRow">
              <text :style="priceTxt">¥128</text>
            </view>
          </view>
        </view>
        <view :style="cardDemo">
          <view :style="imgWrap34">
            <AppImage src="/static/demo/prod-02.png" width="100%" height="100%" mode="aspectFill" />
            <view :style="badgePos">
              <text :style="badgeTxt">降价</text>
            </view>
          </view>
          <view :style="cardInfo">
            <text :style="cardBrand">星辰猫</text>
            <text :style="cardTitle">月光曲 JSK</text>
            <view :style="priceRow">
              <text :style="priceTxt">¥368</text>
              <text :style="origPrice">¥428</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 2x2 Grid -->
    <view :style="section">
      <text :style="sectionTitle">2×2 Management Grid</text>
      <view :style="grid2x2">
        <view :style="gridCard">
          <AppIcon name="wardrobe" :size="48" />
          <text :style="gridCardName">衣橱</text>
          <text :style="gridCardCount">12 件</text>
        </view>
        <view :style="gridCard">
          <AppIcon name="order" :size="48" />
          <text :style="gridCardName">订单</text>
          <text :style="gridCardCount">3 笔</text>
        </view>
        <view :style="gridCard">
          <AppIcon name="reminder" :size="48" />
          <text :style="gridCardName">提醒</text>
          <text :style="gridCardCount">5 条</text>
        </view>
        <view :style="gridCard">
          <AppIcon name="budget" :size="48" />
          <text :style="gridCardName">预算</text>
          <text :style="gridCardCount">¥2,400</text>
        </view>
      </view>
    </view>

    <!-- Settings List -->
    <view :style="section">
      <text :style="sectionTitle">Settings List</text>
      <view :style="settingsCard">
        <view :style="settingsRow">
          <AppIcon name="notification" :size="44" />
