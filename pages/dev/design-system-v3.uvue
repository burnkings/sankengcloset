<template>
  <view :style="pageStyle">
    <!-- V3 Token / 组件预览页（开发用，不进入正式路由导航） -->
    <PageHeader title="Design System V3" action-text="" />

    <view :style="sectionStyle">
      <SectionHeader title="颜色 Tokens" />
      <view :style="colorRow">
        <view v-for="c in colorSwatches" :key="c.name" :style="swatchWrap">
          <view :style="swatchStyle(c.color)" />
          <text :style="swatchLabel">{{ c.name }}</text>
          <text :style="swatchHex">{{ c.color }}</text>
        </view>
      </view>
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="频道 / 筛选" />
      <ChannelTabs :items="channels" :active="activeChannel" @change="onChannel" />
      <FilterChips :items="filters" :active="activeFilter" @change="onFilter" />
      <SegmentedControl :items="segments" :active="activeSegment" @change="onSegment" />
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="列表组 / 行" />
      <ListGroup>
        <ListRow title="列表行示例" subtitle="副标题说明" value="¥199" @tap="noop" />
        <ManagementRow title="管理行示例" subtitle="状态与时间" value="¥599" @tap="noop" />
      </ListGroup>
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="摘要 / 状态" />
      <SummaryStrip :items="summaryItems" :surface="true" />
      <view :style="chipRow">
        <StatusChip label="已完成" status="positive" />
        <StatusChip label="待处理" status="pending" />
        <StatusChip label="已过期" status="error" />
        <StatusChip label="品牌" status="brand" />
      </view>
      <view :style="chipRow">
        <AppSwitch v-model="switchOn" />
      </view>
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="商品卡 / 内容卡" />
      <view :style="twoColRow">
        <ProductCard title="草莓柄甜系 SK" brand="Alice 兔" price-text="¥329" image="" :saved="false" @tap="noop" @toggle-save="noop" />
        <NoteCard title="今日穿搭分享" author="三坑女孩" image="" :like-count="12" @tap="noop" />
      </view>
      <ReleaseCard title="月光曲 JSK 再贩" brand="Gothic 品牌" time-text="2026-08-20 20:00 开售" overlay-text="2026-08-20 20:00 开售" @tap="noop" @remind="noop" @view="noop" />
      <EditorialCard title="秋季新品专题：甜系与暗黑" source-label="编辑整理" updated-text="2026-08-12 更新" image="" @tap="noop" />
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="表单" />
      <FormSection title="基础信息" :required="true">
        <view :style="inputStyle"><text :style="inputText">示例输入框</text></view>
        <DateField value="" placeholder="请选择日期" @change="noop" />
      </FormSection>
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="页面状态 / 骨架" />
      <PageState icon="info" title="暂无内容" message="当前频道还没有内容" action-text="去发现" @action="noop" />
      <FeedSkeleton />
    </view>

    <view :style="sectionStyle">
      <SectionHeader title="底部操作栏" />
      <view :style="actionRow">
        <view :style="primaryBtn" @tap="noop"><text :style="primaryBtnText">主操作</text></view>
        <view :style="secondaryBtn" @tap="noop"><text :style="secondaryBtnText">次操作</text></view>
      </view>
    </view>

    <view :style="bottomSpacer" />
    <BottomSheet :visible="sheetVisible" title="底部面板示例" @close="closeSheet">
      <text :style="sheetBodyText">选择多项 / 筛选 / 日期 / 外跳说明使用 BottomSheet。</text>
    </BottomSheet>
  </view>
</template>

<script setup lang="uts">
import PageHeader from '@/components/v3/PageHeader.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import ChannelTabs from '@/components/v3/ChannelTabs.uvue'
import FilterChips from '@/components/v3/FilterChips.uvue'
import SegmentedControl from '@/components/v3/SegmentedControl.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import ListRow from '@/components/v3/ListRow.uvue'
import ManagementRow from '@/components/v3/ManagementRow.uvue'
import SummaryStrip from '@/components/v3/SummaryStrip.uvue'
import StatusChip from '@/components/v3/StatusChip.uvue'
import AppSwitch from '@/components/v3/AppSwitch.uvue'
import ProductCard from '@/components/v3/ProductCard.uvue'
import NoteCard from '@/components/v3/NoteCard.uvue'
import ReleaseCard from '@/components/v3/ReleaseCard.uvue'
import EditorialCard from '@/components/v3/EditorialCard.uvue'
import FormSection from '@/components/v3/FormSection.uvue'
import DateField from '@/components/v3/DateField.uvue'
import PageState from '@/components/v3/PageState.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import BottomSheet from '@/components/v3/BottomSheet.uvue'
import { brand } from '@/theme/tokens/colors'
import { v3TextStyle } from '@/theme/tokens/typography'
import { n } from '@/theme/use-theme'

const pageStyle = computed((): any => ({ flex: 1, backgroundColor: n.value.bg, paddingTop: '200rpx', paddingLeft: '32rpx', paddingRight: '32rpx' }))
const sectionStyle = { marginTop: '16rpx', marginBottom: '16rpx' }

const colorSwatches = [
  { name: 'brand', color: '#D45F7E' },
  { name: 'canvas', color: '#FAF8F7' },
  { name: 'surface', color: '#FFFFFF' },
  { name: 'subtle', color: '#F5F2F3' },
  { name: 'text', color: '#262223' },
  { name: 'text2', color: '#686164' },
  { name: 'border', color: '#EEE9EB' },
  { name: 'success', color: '#4F9870' },
  { name: 'warning', color: '#C47A45' },
  { name: 'danger', color: '#C5535B' },
]
const colorRow = { flexDirection: 'row' as string, flexWrap: 'wrap' as string }
const swatchWrap = { width: '20%', alignItems: 'center', marginBottom: '16rpx' }
function swatchStyle(color: string) {
  return { width: '72rpx', height: '72rpx', borderRadius: '16rpx', backgroundColor: color, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border }
}
const swatchLabel = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, color: n.value.textSecondary, marginTop: '8rpx' }))
const swatchHex = computed((): any => ({ fontSize: v3TextStyle.caption.fontSize, color: n.value.textTertiary }))

const channels = ['推荐', '新品', '预约', '降价', '穿搭']
const activeChannel = ref('推荐')
function onChannel(v: string) { activeChannel.value = v }
const filters = ['全部', 'JK', 'Lolita', '汉服']
const activeFilter = ref('全部')
function onFilter(v: string) { activeFilter.value = v }
const segments = ['商品', '穿搭', '品牌']
const activeSegment = ref('商品')
function onSegment(v: string) { activeSegment.value = v }

const summaryItems = [
  { label: '总件数', value: '128' },
  { label: '本月已付', value: '¥2,340' },
  { label: '待付尾款', value: '¥860' },
]
const chipRow = { flexDirection: 'row' as string, marginTop: '16rpx' }
const switchOn = ref(false)

const twoColRow = { flexDirection: 'row' as string, justifyContent: 'space-between' }
const inputStyle = computed((): any => ({ height: '88rpx', borderRadius: '16rpx', backgroundColor: n.value.inputFill, justifyContent: 'center', paddingLeft: '28rpx', marginBottom: '16rpx' }))
const inputText = computed((): any => ({ fontSize: v3TextStyle.body.fontSize, color: n.value.text }))

const actionRow = { flexDirection: 'row' as string, marginTop: '16rpx' }
const primaryBtn = { flex: 1, height: '88rpx', borderRadius: '16rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: brand.primary, marginRight: '16rpx' }
const primaryBtnText = { fontSize: v3TextStyle.body.fontSize, fontWeight: 600, color: '#FFFFFF' }
const secondaryBtn = computed((): any => ({ flex: 1, height: '88rpx', borderRadius: '16rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: n.value.bgSecondary }))
const secondaryBtnText = computed((): any => ({ fontSize: v3TextStyle.body.fontSize, fontWeight: 500, color: n.value.text }))
const bottomSpacer = { height: '64rpx' }

const sheetVisible = ref(false)
function closeSheet() { sheetVisible.value = false }
const sheetBodyText = computed((): any => ({ fontSize: v3TextStyle.body.fontSize, color: n.value.textSecondary }))

function noop() {}
</script>

<style>
</style>
