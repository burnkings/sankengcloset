<template>
  <MainLayout>
    <template #navbar>
      <AppNavbar title="Feed 性能 Spike" :show-back="false">
        <template #right>
          <text :style="badgeStyle">{{ itemCount }}卡</text>
        </template>
      </AppNavbar>
    </template>

    <template #default>
      <!-- 控制面板 -->
      <view :style="controlPanel">
        <text :style="controlTitle">数据量</text>
        <view :style="controlRow">
          <view v-for="opt in countOptions" :key="opt" :style="countBtn(opt)" @tap="setItemCount(opt)">
            <text :style="countBtnText(opt)">{{ opt }}</text>
          </view>
        </view>

        <text :style="controlTitle">布局</text>
        <view :style="controlRow">
          <view :style="layoutBtn('single')" @tap="setLayout('single')">
            <text :style="layoutBtnText('single')">单列</text>
          </view>
          <view :style="layoutBtn('grid')" @tap="setLayout('grid')">
            <text :style="layoutBtnText('grid')">双列</text>
          </view>
        </view>

        <!-- 性能指标 -->
        <view :style="metricsRow">
          <view :style="metricItem">
            <text :style="metricValue">{{ renderTime }}ms</text>
            <text :style="metricLabel">渲染耗时</text>
          </view>
          <view :style="metricItem">
            <text :style="metricValue">{{ imageLoadCount }}/{{ itemCount }}</text>
            <text :style="metricLabel">图片加载</text>
          </view>
        </view>
      </view>

      <!--
        list-view: App 平台使用原生 recycle list (vapor)
                   mp-weixin 自动转为 scroll-view
        list-item: App 平台的回收单元
      -->
      <list-view :style="listStyle" @scrolltolower="onScrollToLower">
        <!-- 单列模式 -->
        <list-item v-if="layout === 'single'" v-for="(item, index) in feedItems" :key="item.id" :type="'single'">
          <view :style="singleCardStyle">
            <!-- 图片区：固定 3:4 -->
            <view :style="imageWrapStyle">
              <view :style="imagePlaceholderStyle(item.color)">
                <text :style="placeholderIndex">{{ index + 1 }}</text>
              </view>
            </view>
            <!-- 信息区 -->
            <view :style="infoStyle">
              <text :style="cardTitleStyle">{{ item.title }}</text>
              <text :style="cardBrandStyle">{{ item.brand }}</text>
              <view :style="cardBottomRow">
                <text :style="cardPriceStyle">¥{{ item.price }}</text>
                <view :style="favBtnStyle">
                  <text :style="favBtnText">{{ item.liked ? '❤️' : '🤍' }}</text>
                </view>
              </view>
            </view>
          </view>
        </list-item>

        <!-- 双列网格模式 -->
        <list-item v-if="layout === 'grid'" v-for="(pair, pIndex) in gridPairs" :key="'pair-' + pIndex" :type="'grid'">
          <view :style="gridRowStyle">
            <view :style="gridCardStyle">
              <view :style="gridImageWrapStyle">
                <view :style="imagePlaceholderStyle(pair[0].color)">
                  <text :style="placeholderIndex">{{ pair[0].index }}</text>
                </view>
              </view>
              <view :style="gridInfoStyle">
                <text :style="gridTitleStyle">{{ pair[0].title }}</text>
                <text :style="gridPriceStyle">¥{{ pair[0].price }}</text>
              </view>
            </view>
            <view v-if="pair.length > 1" :style="gridCardStyle">
              <view :style="gridImageWrapStyle">
                <view :style="imagePlaceholderStyle(pair[1].color)">
                  <text :style="placeholderIndex">{{ pair[1].index }}</text>
                </view>
              </view>
              <view :style="gridInfoStyle">
                <text :style="gridTitleStyle">{{ pair[1].title }}</text>
                <text :style="gridPriceStyle">¥{{ pair[1].price }}</text>
              </view>
            </view>
          </view>
        </list-item>

        <!-- 底部加载状态 -->
        <list-item :type="'footer'">
          <view :style="bottomStyle">
            <text :style="bottomText">{{ isLoadingMore ? '加载中...' : '已加载全部' }}</text>
          </view>
        </list-item>
      </list-view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { brand, accent, neutralLight } from '@/theme/tokens/colors'
import { spacing, semanticSpacing } from '@/theme/tokens/spacing'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { shadow } from '@/theme/tokens/shadow'
import { flexRow, flexRowBetween, flexColumnCenter, flexCenter, flexFill } from '@/theme/layout/flex'
import { gap } from '@/theme/layout/spacing'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'

// ====== 数据模型 ======

const BRANDS = ['兔缝缝', '星辰猫', '花筵', '仲夏物语', '摇篮曲', 'With Puji', '表面咒语', '婴梵塔']
const TITLES = ['格裙 45cm', '衬衫 关西襟', 'KC 头饰', 'Lo裙 A型', '宋制旋裙', '马面裙', '发带 缎面', '皮鞋 玛丽珍']
const COLORS = ['#FFE0E8', '#EDE9FE', '#FFF8E1', '#E8F5E9', '#E3F2FD', '#FCE4EC', '#F3E5F5', '#FFF3E0']

class FeedItem {
  id: string = ''
  title: string = ''
  brand: string = ''
  price: number = 0
  color: string = ''
  liked: boolean = false
  index: number = 0
}

function generateItems(count: number, startIdx: number): FeedItem[] {
  const items: FeedItem[] = []
  for (let i = 0; i < count; i++) {
    const item = new FeedItem()
    const idx = startIdx + i
    item.id = `feed-${idx}`
    item.title = TITLES[idx % TITLES.length]
    item.brand = BRANDS[idx % BRANDS.length]
    item.price = Math.floor(Math.random() * 500) + 99
    item.color = COLORS[idx % COLORS.length]
    item.liked = idx % 5 === 0
    item.index = idx + 1
    items.push(item)
  }
  return items
}

// ====== 状态 ======

const countOptions = [30, 100, 300]
const itemCount = ref(30)
const layout = ref('single') // 'single' | 'grid'
const feedItems = ref([]) as Ref<FeedItem[]>
const renderTime = ref(0)
const imageLoadCount = ref(0)
const isLoadingMore = ref(false)

// ====== 计算属性: 双列配对 ======

const gridPairs = computed((): FeedItem[][] => {
  const pairs: FeedItem[][] = []
  const items = feedItems.value
  for (let i = 0; i < items.length; i += 2) {
    if (i + 1 < items.length) {
      pairs.push([items[i], items[i + 1]])
    } else {
      pairs.push([items[i]])
    }
  }
  return pairs
})

// ====== 操作 ======

function setItemCount(count: number) {
  itemCount.value = count
  rebuildFeed()
}

function setLayout(mode: string) {
  layout.value = mode
}

function rebuildFeed() {
  const start = Date.now()
  feedItems.value = generateItems(itemCount.value, 0)
  imageLoadCount.value = itemCount.value
  setTimeout(() => {
    renderTime.value = Date.now() - start
  }, 100)
}

function onScrollToLower() {
  if (isLoadingMore.value) return
  isLoadingMore.value = true
  setTimeout(() => {
    const currentLen = feedItems.value.length
    const newItems = generateItems(20, currentLen)
    feedItems.value = [...feedItems.value, ...newItems]
    itemCount.value = feedItems.value.length
    imageLoadCount.value = feedItems.value.length
    isLoadingMore.value = false
  }, 300)
}

// ====== 初始化 ======
rebuildFeed()

// ====== 样式 ======

const listStyle = {
  ...flexFill,
}

const controlPanel = computed((): any => ({
  padding: spacing[3],
  paddingHorizontal: semanticSpacing.pageHorizontal,
  backgroundColor: n.value.surface,
  borderBottomWidth: '1rpx',
  borderBottomStyle: 'solid',
  borderBottomColor: n.value.divider,
  gap: spacing[2],
}))

const controlTitle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  fontWeight: fontWeight.medium,
}))

const controlRow = { ...flexRow, gap: spacing[2] }

function countBtn(count: number) {
  return {
    paddingHorizontal: spacing[3],
    paddingVertical: spacing[1],
    borderRadius: radius.full,
    backgroundColor: itemCount.value === count ? brand[500] : neutralLight.bgTertiary,
  }
}

function countBtnText(count: number) {
  return {
    fontSize: fontSize.sm,
    fontWeight: fontWeight.medium,
    color: itemCount.value === count ? '#FFFFFF' : neutralLight.textSecondary,
  }
}

function layoutBtn(mode: string) {
  return {
    paddingHorizontal: spacing[3],
    paddingVertical: spacing[1],
    borderRadius: radius.full,
    backgroundColor: layout.value === mode ? accent[500] : neutralLight.bgTertiary,
  }
}

function layoutBtnText(mode: string) {
  return {
    fontSize: fontSize.sm,
    fontWeight: fontWeight.medium,
    color: layout.value === mode ? '#FFFFFF' : neutralLight.textSecondary,
  }
}

const metricsRow = {
  ...flexRow,
  justifyContent: 'space-around',
  marginTop: spacing[2],
  padding: spacing[2],
  backgroundColor: neutralLight.bgTertiary,
  borderRadius: radius.md,
}

const metricItem = { ...flexColumnCenter, gap: '2rpx' }
const metricValue = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[500] }
const metricLabel = { fontSize: fontSize.xs, color: neutralLight.textTertiary }
const badgeStyle = {
  fontSize: fontSize.xs,
  color: neutralLight.textTertiary,
  backgroundColor: neutralLight.bgTertiary,
  paddingHorizontal: spacing[2],
  paddingVertical: spacing[1],
  borderRadius: radius.sm,
}

// --- 单列卡片 ---

const singleCardStyle = computed((): any => ({
  marginHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
  borderRadius: semanticRadius.card,
  backgroundColor: n.value.surface,
  boxShadow: shadow.card,
  overflow: 'hidden',
}))

const imageWrapStyle = {
  width: '100%',
  paddingBottom: '133.33%', // 3:4
  position: 'relative' as string,
  overflow: 'hidden',
}

function imagePlaceholderStyle(color: string) {
  return {
    position: 'absolute' as string,
    top: '0', left: '0', right: '0', bottom: '0',
    backgroundColor: color,
    display: 'flex', alignItems: 'center', justifyContent: 'center',
  }
}

const placeholderIndex = {
  fontSize: fontSize['3xl'],
  fontWeight: fontWeight.extrabold,
  color: 'rgba(0,0,0,0.15)',
}

const infoStyle = { padding: spacing[3], gap: spacing[1] }
const cardTitleStyle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const cardBrandStyle = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary }))
const cardBottomRow = { ...flexRowBetween, alignItems: 'center', marginTop: spacing[1] }
const cardPriceStyle = { fontSize: fontSize.lg, fontWeight: fontWeight.bold, color: brand[600] }
const favBtnStyle = { width: '56rpx', height: '56rpx', ...flexCenter }
const favBtnText = { fontSize: '32rpx' }

// --- 双列网格 ---

const gridRowStyle = {
  ...flexRow,
  gap: spacing[2],
  paddingHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[2],
}

const gridCardStyle = computed((): any => ({
  flex: 1,
  borderRadius: semanticRadius.card,
  backgroundColor: n.value.surface,
  boxShadow: shadow.sm,
  overflow: 'hidden',
}))

const gridImageWrapStyle = {
  width: '100%',
  paddingBottom: '133.33%',
  position: 'relative' as string,
  overflow: 'hidden',
}

const gridInfoStyle = { padding: spacing[2], gap: '2rpx' }
const gridTitleStyle = computed((): any => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.medium,
  color: n.value.text,
  lines: 1,
  textOverflow: 'ellipsis',
}))
const gridPriceStyle = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[600] }

// --- 底部 ---

const bottomStyle = { ...flexCenter, padding: spacing[4] }
const bottomText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
</script>
