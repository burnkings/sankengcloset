<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar><PageHeader title="发现" /></template>
      <template #default>
      <view class="page-canvas" :style="pageWrap">

        <SectionHeader title="榜单排行" action-text="查看全部" @action="openRanking('hot')" />
        <view :style="rankingRow">
          <view :style="rankingCard('hot')" @tap="openRanking('hot')"><text :style="rankingTitle">热榜</text><text :style="rankingHint">大家在看</text></view>
          <view :style="rankingCard('new')" @tap="openRanking('new')"><text :style="rankingTitle">上新榜</text><text :style="rankingHint">最近收录</text></view>
          <view :style="rankingCard('favorite')" @tap="openRanking('favorite')"><text :style="rankingTitle">收藏榜</text><text :style="rankingHint">心动收藏</text></view>
        </view>

        <SectionHeader v-if="features.length > 0" title="精选专题" />
        <scroll-view direction="horizontal" :style="featureScroll">
          <view :style="featureRow">
            <view v-for="(item, idx) in features" :key="item.id" :style="featureCard(idx)" @tap="openEditorial(item)">
              <view :style="featureImage"><AppImage :src="item.image" width="100%" height="100%" mode="aspectFill" :lazy-load="true" /></view>
              <view :style="featureCopy"><text :style="featureTitle">{{ item.title }}</text><text :style="featureDesc">{{ item.desc }}</text></view>
            </view>
            <view :style="endPad" />
          </view>
        </scroll-view>

        <SectionHeader title="品牌目录" action-text="全部品牌" @action="openBrandDirectory" />
        <view :style="brandGrid">
          <view v-for="(item, idx) in brands" :key="item.name" :style="brandCard(idx)" @tap="openBrand(item)">
            <view :style="brandMonogram"><text :style="brandInitial">{{ item.initial }}</text></view>
            <view :style="brandCopy"><text :style="brandName">{{ item.name }}</text><text v-if="item.meta !== ''" :style="brandMeta">{{ item.meta }}</text></view>
            <view :style="followAction(item.name)" @tap.stop="toggleBrand(item.name)"><text :style="followText(item.name)">{{ library.isFollowingBrand(item.name) ? '已关注' : '关注' }}</text></view>
          </view>
        </view>

        <SectionHeader title="发售日历" />
        <view :style="calHeader">
          <view :style="calArrow" @tap="prevMonth"><text :style="calArrowText">‹</text></view>
          <text :style="calTitle">{{ calYear }}年{{ calMonth }}月</text>
          <view :style="calArrow" @tap="nextMonth"><text :style="calArrowText">›</text></view>
        </view>
        <view :style="calWeekRow">
          <text v-for="w in weekLabels" :key="w" :style="calWeekLabel">{{ w }}</text>
        </view>
        <view :style="calGrid">
          <view v-for="(cell, idx) in calendarGrid" :key="idx" :style="calCell" @tap="onCellTap(cell)">
            <text v-if="cell.day > 0" :style="calDay(cell)">{{ cell.day }}</text>
            <view v-if="cell.day > 0 && cell.events.length > 0" :style="calEventRow">
              <view v-for="evt in cell.events" :key="evt.id" :style="calEventDot" />
            </view>
          </view>
        </view>

        <AppDialog :visible="showDayRelease" :title="selectedDayTitle" :show-footer="false" :show-close="true" @cancel="showDayRelease = false">
          <scroll-view direction="vertical" :style="{ maxHeight: '640rpx' }">
          <view v-if="selectedDayEvents.length === 0" :style="dayEmptyWrap">
            <text :style="dayEmptyText">当日暂无发售</text>
          </view>
          <view v-for="evt in selectedDayEvents" :key="evt.id" :style="dayEventRow" @tap="onReleaseProduct(evt)">
            <view :style="dayEventCopy">
              <text :style="dayEventTitle">{{ evt.title }}</text>
              <text :style="dayEventMeta">{{ evt.brand !== '' ? evt.brand : evt.tag }}</text>
            </view>
            <view :style="dayEventAction" @tap.stop="onAddReleaseReminder(evt)"><AppIcon name="reminder" :size="28" :active="true" /><text :style="dayEventActionText">设置提醒</text></view>
          </view>
          </scroll-view>
        </AppDialog>
      </view>
    </template>
  </MainLayout>
</view>
</template>

<script setup lang="uts">
import { openProductDetail } from '@/utils/content-navigation'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_RADIUS_V3, PAGE_HEADER_CONTENT_GAP, SEARCH_HEIGHT_V3, SEARCH_RADIUS_V3, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, isDark, initPageTheme } from '@/theme/use-theme'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useBlacklistStore } from '@/stores/blacklist-store'
import { useHomeFeedStore } from '@/stores/home-feed-store'
import { useCalendarStore } from '@/stores/calendar-store'
import { CalendarEvent } from '@/services/content/calendar-service'
import { FEED_EDITORIAL, FEED_BRAND_POST } from '@/domain/content/feed-item'
import { showFeedback } from '@/utils/feedback'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import PageHeader from '@/components/v3/PageHeader.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
// #ifdef APP
import { getWindowHeight } from '@/utils/window-info'
// #endif

class FeatureItem {
  id: string = ''
  image: string = ''
  title: string = ''
  desc: string = ''
  category: string = ''
}
class BrandItem {
  id: string = ''
  name: string = ''
  initial: string = ''
  meta: string = ''
}
class CalendarCell {
  day: number = 0
  dateKey: string = ''
  events: CalendarEvent[] = []
}
function openRanking(tab: string) { uni.navigateTo({ url: `/pages/ranking/index?tab=${tab}` }) }
const library = useContentLibraryStore()
const blacklist = useBlacklistStore()
function toggleBrand(brandName: string) {
  const followed = library.toggleBrandFollow(brandName)
  showFeedback(followed ? `已关注 ${brandName}` : `已取消关注 ${brandName}`)
}
function openEditorial(item: FeatureItem) {
  uni.navigateTo({ url: `/pages/editorial/detail?id=${item.id}&title=${encodeURIComponent(item.title)}&category=${encodeURIComponent(item.category)}` })
}
function openBrandDirectory() { uni.navigateTo({ url: '/pages/brand/index' }) }
function openBrand(item: BrandItem) { uni.navigateTo({ url: `/pages/brand/detail?id=${item.id}&name=${encodeURIComponent(item.name)}` }) }

const pageHeight = getWindowHeight()
const feedStore = useHomeFeedStore()

function brandInitialOf(name: string): string {
  if (name == '') return '#'
  return name.substring(0, 1)
}

const features = computed((): FeatureItem[] => {
  return feedStore.allItems.filter((item) => item.feedType === FEED_EDITORIAL).map((item) => {
    const f = new FeatureItem()
    f.id = item.id
    f.image = item.coverUrl
    f.title = item.title
    f.desc = item.subtitle
    f.category = item.category
    return f
  })
})
const brands = computed((): BrandItem[] => {
  const result: BrandItem[] = []
  const seen: string[] = []
  const source = feedStore.allItems.filter((item) => item.feedType === FEED_BRAND_POST && !blacklist.isBlacklisted(item.brandName !== '' ? item.brandName : item.title))
  for (let i = 0; i < source.length && result.length < 4; i++) {
    const item = source[i]
    const name = item.brandName !== '' ? item.brandName : item.title
    if (name === '' || seen.indexOf(name) >= 0) continue
    seen.push(name)
    const b = new BrandItem()
    b.id = item.brandId !== '' ? item.brandId : name
    b.name = name
    b.initial = brandInitialOf(name)
    b.meta = '精选品牌'
    result.push(b)
  }
  return result
})
const calendarStore = useCalendarStore()
// 发售日历：真实数据源（GET /api/v1/calendar，见 calendar-store），黑名单品牌过滤
const calendar = computed((): CalendarEvent[] => {
  return calendarStore.events.filter((e) => !blacklist.isBlacklisted(e.brand))
})

const now = new Date()
const calYear = ref(now.getFullYear())
const calMonth = ref(now.getMonth() + 1)
const weekLabels = ['一', '二', '三', '四', '五', '六', '日']
const calendarGrid = computed((): CalendarCell[] => {
  const cells: CalendarCell[] = []
  const year = calYear.value
  const month = calMonth.value
  const firstWeekday = new Date(year, month - 1, 1).getDay()
  const offset = (firstWeekday + 6) % 7
  const daysInMonth = new Date(year, month, 0).getDate()
  for (let i = 0; i < offset; i++) {
    const cell = new CalendarCell()
    cells.push(cell)
  }
  for (let d = 1; d <= daysInMonth; d++) {
    const cell = new CalendarCell()
    cell.day = d
    cell.dateKey = `${year}-${String(month).padStart(2, '0')}-${String(d).padStart(2, '0')}`
    cell.events = calendar.value.filter((evt) => evt.dateKey === cell.dateKey)
    cells.push(cell)
  }
  return cells
})
function prevMonth() {
  if (calMonth.value === 1) { calMonth.value = 12; calYear.value -= 1 }
  else calMonth.value -= 1
  calendarStore.loadMonth(calYear.value, calMonth.value)
}
function nextMonth() {
  if (calMonth.value === 12) { calMonth.value = 1; calYear.value += 1 }
  else calMonth.value += 1
  calendarStore.loadMonth(calYear.value, calMonth.value)
}

// 发售日历日程化：点日期看当日发售，可一键加提醒
const showDayRelease = ref(false)
const selectedDayKey = ref('')
const selectedDayTitle = computed((): string => {
  const key = selectedDayKey.value
  if (key === '') return '当日发售'
  const parts = key.split('-')
  return parts.length === 3 ? `${parts[1]}月${parts[2]}日发售` : '当日发售'
})
const selectedDayEvents = computed((): CalendarEvent[] => {
  return calendar.value.filter((evt) => evt.dateKey === selectedDayKey.value)
})
function onCellTap(cell: CalendarCell) {
  if (cell.day <= 0) return
  selectedDayKey.value = cell.dateKey
  showDayRelease.value = true
}
function onReleaseProduct(evt: CalendarEvent) {
  if (evt.productId !== '') {
    showDayRelease.value = false
    openProductDetail(evt.productId)
    return
  }
  showFeedback('该发售暂未关联商品详情')
}
function calendarReminderType(evt: CalendarEvent): string {
  return evt.eventType === 'reservation' || evt.eventType === 'lottery' ? 'WISH' : 'RELEASE'
}
function onAddReleaseReminder(evt: CalendarEvent) {
  const title = encodeURIComponent(evt.title)
  const date = evt.dateKey
  showDayRelease.value = false
  const type = calendarReminderType(evt)
  const releaseId = encodeURIComponent(evt.id)
  const productId = encodeURIComponent(evt.productId)
  uni.navigateTo({ url: `/pages/reminder/edit?title=${title}&date=${date}&type=${type}&productId=${productId}&releaseId=${releaseId}` })
}

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
// 榜单入口双卡（热榜/上新榜，等宽均分 + 24rpx 间距）
const rankingRow = { ...flexRow, flexDirection: 'row' as string }
function rankingCard(variant: string): any {
  return { flex: 1, minHeight: '164rpx', borderRadius: '16rpx', backgroundColor: n.value.surface, padding: '16rpx', alignItems: 'flex-start', justifyContent: 'center', flexDirection: 'column' as string, marginRight: variant !== 'favorite' ? '12rpx' : '0' }
}
const rankingTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '10rpx' }))
const rankingHint = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '6rpx' }))
const featureScroll = { width: '718rpx', marginRight: '-32rpx' }
const featureRow = computed((): any => ({ ...flexRow, width: (features.value.length * 520 + 32) + 'rpx' }))
function featureCard(idx: number) { return { width: '500rpx', flexShrink: 0, borderRadius: CARD_RADIUS_V3, overflow: 'hidden', backgroundColor: n.value.surface, marginRight: idx < features.value.length - 1 ? '20rpx' : '0' } }
const featureImage = { width: '500rpx', height: '280rpx' }
const featureCopy = { padding: '20rpx' }
const featureTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const featureDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '6rpx' }))
const endPad = { width: '32rpx', flexShrink: 0 }
const brandGrid = { ...flexRow, flexWrap: 'wrap' as string }
function brandCard(idx: number) { return { width: '337rpx', minHeight: '128rpx', ...flexRow, alignItems: 'center', padding: '18rpx', borderRadius: CARD_RADIUS_V3, backgroundColor: n.value.surface, marginRight: idx % 2 === 0 ? '12rpx' : '0', marginBottom: '12rpx' } }
const brandMonogram = computed((): any => ({ width: '60rpx', height: '60rpx', borderRadius: '30rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : brand[50], alignItems: 'center', justifyContent: 'center', marginRight: '12rpx' }))
const brandInitial = { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: brand[600] }
const brandCopy = { ...flexFill }
const brandName = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text }))
const brandMeta = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))
function followAction(brandName: string) { return { minWidth: '88rpx', height: '48rpx', borderRadius: '24rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: library.isFollowingBrand(brandName) ? brand[600] : n.value.bgSecondary, marginLeft: '8rpx' } }
function followText(brandName: string) { return { fontSize: fontSize['2xs'], fontWeight: fontWeight.semibold, color: library.isFollowingBrand(brandName) ? baseColors.white : brand[600] } }
const calHeader = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', height: '80rpx' }
const calArrow = { width: '64rpx', height: '64rpx', alignItems: 'center', justifyContent: 'center' }
const calArrowText = computed((): any => ({ fontSize: '40rpx', color: n.value.textSecondary }))
const calTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const calWeekRow = { ...flexRow }
const calWeekLabel = computed((): any => ({ width: '98rpx', textAlign: 'center', fontSize: fontSize.xs, color: n.value.textTertiary, paddingTop: '8rpx', paddingBottom: '8rpx' }))
const calGrid = { ...flexRow, flexWrap: 'wrap' as string }
const calCell = { width: '98rpx', height: '88rpx', flexDirection: 'column', alignItems: 'center', paddingTop: '8rpx' }
function calDay(cell: CalendarCell): any {
  const hasEvent = cell.events.length > 0
  return { fontSize: fontSize.sm, fontWeight: hasEvent ? fontWeight.semibold : fontWeight.regular, color: hasEvent ? (brand[600] as string) : n.value.text }
}
const calEventRow = { ...flexRow, marginTop: '6rpx' }
const calEventDot = { width: '10rpx', height: '10rpx', borderRadius: '5rpx', backgroundColor: brand[500] as string, marginLeft: '2rpx', marginRight: '2rpx' }
const dayEmptyWrap = { alignItems: 'center', paddingTop: '40rpx', paddingBottom: '40rpx' }
const dayEmptyText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
const dayEventRow = computed((): any => ({ flexDirection: 'row', alignItems: 'center', minHeight: '88rpx', borderBottomWidth: '1rpx', borderBottomStyle: 'solid' as string, borderBottomColor: n.value.border }))
const dayEventCopy = { flex: 1, justifyContent: 'center' }
const dayEventTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold as number, color: n.value.text, lines: 1 as const, textOverflow: 'ellipsis' as string }))
const dayEventMeta = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '4rpx', lines: 1 as const, textOverflow: 'ellipsis' as string }))
const dayEventAction = { flexDirection: 'row' as string, alignItems: 'center', flexShrink: 0, marginLeft: '12rpx' }
const dayEventActionText = computed((): any => ({ fontSize: fontSize.xs, color: brand[600] as string, marginLeft: '6rpx' }))
onLoad(() => { initPageTheme() })
onMounted(() => {
  calendarStore.loadMonth(calYear.value, calMonth.value)
  if (feedStore.state === 'idle' || feedStore.state === 'error') feedStore.loadFirstPage()
})
onPageShow(() => { initPageTheme(); library.reload() })
</script>
