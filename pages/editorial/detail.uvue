<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar :title="pageTitle" show-back /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <!-- Hero image -->
        <view :style="heroWrap">
          <AppImage :src="heroImage" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
          <view :style="heroOverlay" />
          <view :style="heroCopy">
            <text :style="heroTitle">{{ pageTitle }}</text>
            <text :style="heroDesc">{{ pageDesc }}</text>
          </view>
        </view>

        <!-- Collection products -->
        <SectionHeader :title="`专题商品 (${filteredItems.length})`" />
        <view v-if="filteredItems.length === 0" :style="emptyWrap">
          <PageState icon="grid" title="暂无相关商品" />
        </view>
        <view :style="productGrid">
          <view v-for="(item, idx) in filteredItems" :key="item.id" :style="productShell(idx)">
              <ProductCard
                :image="item.coverUrl"
                :brand="item.brandName"
                :title="item.title"
                :price-text="formatPrice(item.price)"
                :badge-text="item.badgeText"
                @tap="onProductTap(item.entityId)"
              />
          </view>
        </view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { FeedItem } from '@/domain/content/feed-item'
import { fontSize } from '@/theme/tokens/typography'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3, PRODUCT_CARD_WIDTH_V3, COLUMN_GAP_V3, FEED_GUTTER_V3 } from '@/theme/tokens/responsive'
import { flexRow } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import { baseColors } from '@/theme/tokens/colors'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import ProductCard from '@/components/v3/ProductCard.uvue'
import PageState from '@/components/v3/PageState.uvue'

const pageTitle = ref('')
const pageDesc = ref('')
const pageCategory = ref('')
const heroImage = ref('')
  const filteredItems = ref<FeedItem[]>([])

function formatPrice(cents: number): string {
  if (cents <= 0) return ''
  const yuan = cents / 100
  if (yuan === Math.floor(yuan)) return `¥${Math.floor(yuan)}`
  return `¥${yuan.toFixed(2)}`
}

function onProductTap(entityId: string) {
  uni.navigateTo({ url: `/pages/product/detail?id=${entityId}` })
}

onLoad((query) => {
  if (query != null) {
      if (query['title'] != null) pageTitle.value = (decodeURIComponent(query['title'] as string) ?? '')
    if (query['category'] != null) pageCategory.value = query['category'] as string
    if (query['image'] != null) {
      const img = query['image'] as string
      if (img !== '') heroImage.value = img
    }
  }

  // Set description based on category
  if (pageCategory.value === 'JK') {
    pageDesc.value = '精选格裙、水手服与配饰，打造夏日盐系风格'
  } else if (pageCategory.value === 'LOLITA') {
    pageDesc.value = '从第一条 JSK 开始，探索 Lolita 的甜美世界'
  } else if (pageCategory.value === 'HANFU') {
    pageDesc.value = '宋制、明制、唐制——传统服饰的现代演绎'
  } else {
    pageDesc.value = '编辑团队为你精心挑选的专题内容'
  }

  // Filter products by category — 后续将接入远程 API 获取专题商品
  // 当前阶段先展示空态，由 PageState 兜底
  filteredItems.value = []
})

// ====== Styles ======

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
// V3 §6.11 16:9 头图 + 独立文字区；大图圆角 16rpx
const heroWrap = { width: '686rpx', height: '386rpx', borderRadius: '16rpx', overflow: 'hidden', position: 'relative' }
const heroOverlay = { position: 'absolute', left: '0', right: '0', bottom: '0', height: '200rpx', backgroundColor: 'rgba(0,0,0,0.4)' }
const heroCopy = { position: 'absolute', left: '0', right: '0', bottom: '0', paddingLeft: '24rpx', paddingRight: '24rpx', paddingBottom: '28rpx' }
const heroTitle = { fontSize: fontSize.xl, fontWeight: 700, color: baseColors.white }
const heroDesc = { fontSize: fontSize.sm, color: 'rgba(255,255,255,0.8)', marginTop: '8rpx' }
// V3 §6.11 相关商品双列 ProductCard
const productGrid = { ...flexRow, flexWrap: 'wrap' as string, paddingLeft: FEED_GUTTER_V3, paddingRight: FEED_GUTTER_V3 }
function productShell(idx: number) { return { width: PRODUCT_CARD_WIDTH_V3, marginRight: idx % 2 === 0 ? COLUMN_GAP_V3 : '0' } }
const emptyWrap = { paddingTop: '48rpx', alignItems: 'center' }
</script>


