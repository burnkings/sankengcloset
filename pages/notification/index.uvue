<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="通知" :show-back="true"><template #right><text v-if="notices.unreadCount > 0" :style="readAllText" @tap="readAll">全部已读</text></template></AppNavbar></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="filterWrap"><FilterChips :items="filterLabels" :active="activeLabel" @change="onFilter" /></view>
        <template v-if="notices.visibleItems.length === 0">
          <PageState icon="notification" title="当前没有这类通知" />
        </template>
        <view v-for="notice in visibleNotices" :key="notice.id" :style="noticeRow(notice.read)" @tap="openNotice(notice.id, notice.actionTarget)">
          <view :style="noticeIcon(notice.type)"><AppIcon :name="noticeVisual(notice.type).icon" :size="40" :active="noticeVisual(notice.type).active" /></view>
          <view :style="noticeCopy">
            <view :style="noticeTop"><text :style="noticeTitle(notice.read)">{{ notice.title }}</text><view v-if="!notice.read" :style="unreadDot" /></view>
            <text :style="noticeBody">{{ notice.body }}</text>
            <text :style="noticeTime">{{ formatTime(notice.createdAt) }}</text>
          </view>
          <AppIcon name="chevron-right" :size="30" />
          <view :style="noticeClose" @tap.stop="dismissNotice(notice.id)"><AppIcon name="close" :size="28" /></view>
        </view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { useNotificationCenterStore } from '@/stores/notification-center-store'
import { NOTICE_RELEASE, NOTICE_PRICE, NOTICE_SOCIAL, NOTICE_SYSTEM, AppNotification } from '@/domain/notification/app-notification'
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3, LIST_GROUP_HORIZONTAL_V3, CARD_RADIUS_V3 } from '@/theme/tokens/responsive'
import { n, isDark, initPageTheme } from '@/theme/use-theme'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { showFeedback } from '@/utils/feedback'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import FilterChips from '@/components/v3/FilterChips.uvue'
import PageState from '@/components/v3/PageState.uvue'

const notices = useNotificationCenterStore()
const activeLabel = ref('全部')
const filterLabels = ['全部', '发售', '降价', '互动', '系统']
const dismissedIds = ref<string[]>([])
const visibleNotices = computed((): AppNotification[] => notices.visibleItems.filter((n: AppNotification) => dismissedIds.value.indexOf(n.id) < 0))
function dismissNotice(id: string) { dismissedIds.value = [...dismissedIds.value, id] }

class NoticeVisual {
  icon: string = ''
  active: boolean = false
}

function typeForLabel(label: string): string {
  if (label === '发售') return 'release'
  if (label === '降价') return 'price'
  if (label === '互动') return 'social'
  if (label === '系统') return 'system'
  return 'all'
}
function onFilter(label: string) { activeLabel.value = label; notices.setType(typeForLabel(label)) }
function readAll() { notices.markAllRead(); showFeedback('通知已全部标为已读') }
function openNotice(id: string, target: string) {
  notices.markRead(id)
  if (target === '') return
  const tabPages = ['/pages/home/index', '/pages/discover/index', '/pages/favorites/index', '/pages/community/index', '/pages/profile/index']
  if (tabPages.indexOf(target) >= 0) openPrimaryTab(target)
  else uni.navigateTo({ url: target })
}
// V3 §3.5：通知类型用线性图标，不使用文字符号
function noticeVisual(type: string): NoticeVisual {
  const v = new NoticeVisual()
  if (type === NOTICE_PRICE) { v.icon = 'budget'; v.active = true; return v }
  if (type === NOTICE_SOCIAL) { v.icon = 'heart'; v.active = true; return v }
  if (type === NOTICE_SYSTEM) { v.icon = 'info'; v.active = true; return v }
  v.icon = 'notification'; v.active = true
  return v
}
function formatTime(value: string): string {
  const time = parseInt(value)
  if (isNaN(time)) return ''
  const diff = Math.max(0, Date.now() - time)
  const hour = Math.floor(diff / 3600000)
  if (hour < 1) return `${Math.max(1, Math.floor(diff / 60000))} 分钟前`
  if (hour < 24) return `${hour} 小时前`
  return `${Math.floor(hour / 24)} 天前`
}
onLoad(() => { initPageTheme() })
onPageShow(() => { initPageTheme(); notices.reload() })

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingBottom: '64rpx', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const filterWrap = { marginBottom: '20rpx' }
const readAllText = { fontSize: fontSize.xs, fontWeight: fontWeight.medium, color: brand[600] }
// V3 §6.7 行结构：类型图标、标题、摘要、时间、未读点；分割线分组
function noticeRow(read: boolean) { return { ...flexRow, flexDirection: 'row', alignItems: 'center', paddingTop: '22rpx', paddingBottom: '22rpx', paddingLeft: LIST_GROUP_HORIZONTAL_V3, paddingRight: LIST_GROUP_HORIZONTAL_V3, backgroundColor: read ? n.value.surface : (isDark.value ? n.value.surfaceWarm : brand[50]), borderRadius: CARD_RADIUS_V3, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border, marginBottom: '14rpx', position: 'relative' as string } }
function noticeIcon(type: string) {
  const v = noticeVisual(type)
  return { width: '80rpx', height: '80rpx', borderRadius: '20rpx', backgroundColor: isDark.value ? n.value.surfaceRaised : n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginRight: '20rpx', flexShrink: 0 }
}
const noticeCopy = { ...flexFill }
const noticeTop = { ...flexRow, flexDirection: 'row', alignItems: 'center' }
function noticeTitle(read: boolean) { return { ...flexFill, fontSize: fontSize.sm, fontWeight: read ? fontWeight.medium : fontWeight.semibold, color: n.value.text } }
const unreadDot = { width: '12rpx', height: '12rpx', borderRadius: '6rpx', backgroundColor: brand[600], marginLeft: '10rpx' }
const noticeBody = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, lineHeight: '34rpx', marginTop: '8rpx' }))
const noticeTime = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '8rpx' }))
const noticeClose = { position: 'absolute' as string, top: '12rpx', right: '16rpx', width: '48rpx', height: '48rpx', alignItems: 'center', justifyContent: 'center', zIndex: 3 }
</script>