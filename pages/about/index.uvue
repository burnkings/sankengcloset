<template>
  <DetailLayout title="关于三坑绮橱">
    <view :style="contentWrap">
      <!-- 品牌区 -->
      <view :style="brandCard">
        <text :style="logoText">三坑绮橱</text>
        <text :style="appVersion">{{ APP_DISPLAY_VERSION }}</text>
        <text :style="appSlogan">三坑文化爱好者的商品信息与发售资讯平台</text>
      </view>

      <!-- 服务条款 -->
      <text :style="groupTitle">服务条款</text>
      <ListGroup>
        <view :style="shell(0, 3)" @tap="openLegal('agreement')">
          <ListRow title="用户协议" />
        </view>
        <view :style="shell(1, 3)" @tap="openLegal('privacy')">
          <ListRow title="隐私政策" />
        </view>
        <view :style="shell(2, 3)" @tap="onCheckUpdateTap">
          <ListRow title="检查更新" :value="APP_DISPLAY_VERSION" />
        </view>
      </ListGroup>

      <text :style="copyright">© 2026 三坑绮橱 · 昆山三坑绮橱工作室</text>
    </view>
  </DetailLayout>

  <AppDialog :visible="showUpdateDialog" :title="updateDialogTitle" :message="updateDialogMessage" confirm-text="立即更新" :show-cancel="true" cancel-text="稍后" @confirm="onUpdateConfirm" @cancel="showUpdateDialog = false" />
</template>

<script setup lang="uts">
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import ListGroup from '@/components/v3/ListGroup.uvue'
import ListRow from '@/components/v3/ListRow.uvue'
import { PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { n, initPageTheme } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import { APP_DISPLAY_VERSION } from '@/config/app-version'
import { checkUpdateRemote, AppVersionInfo } from '@/services/user-data/app-update-service'

const showUpdateDialog = ref(false)
const updateDialogTitle = ref('发现新版本')
const updateDialogMessage = ref('')
let pendingUpdateUrl = ''

onLoad(() => { initPageTheme() })

function shell(idx: number, total: number) {
  return {
    borderBottomWidth: idx < total - 1 ? '1rpx' : '0',
    borderBottomStyle: 'solid' as string,
    borderBottomColor: n.value.divider,
  }
}

function openLegal(type: string) {
  uni.navigateTo({ url: `/pages/about/legal?type=${type}` })
}

async function onCheckUpdateTap() {
  showFeedback('正在检查更新…')
  try {
    const info: AppVersionInfo = await checkUpdateRemote()
    if (info.hasUpdate) {
      updateDialogTitle.value = '发现新版本 ' + info.latestVersion.split('-')[0]
      updateDialogMessage.value = info.releaseNote !== '' ? info.releaseNote : '已发布新版本，建议尽快更新。'
      pendingUpdateUrl = info.updateUrl
      showUpdateDialog.value = true
    } else {
      showFeedback('当前已是最新版本 ' + APP_DISPLAY_VERSION)
    }
  } catch (e) {
    showFeedback('检查更新失败，请稍后重试')
  }
}

function onUpdateConfirm() {
  showUpdateDialog.value = false
  if (pendingUpdateUrl !== '') {
    // #ifdef APP
    plus.runtime.openURL(pendingUpdateUrl)
    // #endif
  } else {
    showFeedback('更新地址待配置')
  }
}

const contentWrap = {
  paddingTop: '24rpx',
  paddingLeft: PAGE_GUTTER_V3,
  paddingRight: PAGE_GUTTER_V3,
  paddingBottom: '24rpx',
}
const brandCard = computed((): any => ({
  alignItems: 'center',
  justifyContent: 'center',
  paddingTop: '56rpx',
  paddingBottom: '56rpx',
  backgroundColor: n.value.surface,
  borderRadius: '20rpx',
  marginBottom: '28rpx',
}))
// 品牌字标：纯文字 + 自适应强调色，不用色块 + 拉丁缩写（"SK"不是品牌标识）
// 品牌名一屏只出现两次（导航标题 + 字标）；曾有第三处黑色粗体名称行，与字标重复，已删
const logoText = computed((): any => ({ fontSize: fontSize['2xl'], fontWeight: fontWeight.semibold, color: n.value.iconActive, marginBottom: '20rpx' }))
const appVersion = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginBottom: '14rpx' }))
const appSlogan = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary }))
const groupTitle = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginLeft: '8rpx', marginBottom: '12rpx' }))
const copyright = computed((): any => ({
  textAlign: 'center',
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  marginTop: '28rpx',
}))
// 全面屏手势 / 实体返回键：先关掉当前叠加层（弹窗 / 选择态），不要直接退出页面。
// 说明：iOS 原生侧滑返回不触发 onBackPress（uni-app x 官方限制），Android 手势返回与实体返回键会触发。
onBackPress((): boolean => {
  if (showUpdateDialog.value) { showUpdateDialog.value = false; return true }
  return false
})
</script>
