<template>
  <DetailLayout :title="isEdit ? '编辑心愿' : '新增心愿'">
    <template #right>
      <text :style="saveBtnStyle" @tap="onSave">保存</text>
    </template>

    <view :style="formStyle">

      <!-- 名称 -->
      <AppInput v-model="form.name" label="名称" placeholder="例如：草莓柄甜系 SK" />

      <!-- 品牌 -->
      <AppInput v-model="form.brand" label="品牌" placeholder="例如：Alice兔" />

      <!-- 预估价格 -->
      <AppInput v-model="form.priceStr" label="预估价格" placeholder="0" type="digit" />

      <!-- 优先级 -->
      <view :style="fieldGroupStyle">
        <text :style="labelStyle">优先级</text>
        <view :style="chipRowStyle">
          <view
            v-for="opt in priorityOptions"
            :key="opt.value"
            :style="priorityChipStyle(opt.value === form.priority, opt.color)"
            @tap="form.priority = opt.value"
          >
            <text :style="priorityChipText(opt.value === form.priority, opt.color)">{{ opt.label }}</text>
          </view>
        </view>
      </view>

      <!-- 状态 -->
      <view :style="fieldGroupStyle">
        <text :style="labelStyle">状态</text>
        <view :style="chipRowStyle">
          <view
            v-for="opt in statusOptions"
            :key="opt.value"
            :style="statusChipStyle(opt.value === form.status, opt.color)"
            @tap="form.status = opt.value"
          >
            <text :style="statusChipText(opt.value === form.status, opt.color)">{{ opt.label }}</text>
          </view>
        </view>
      </view>

      <!-- 链接 -->
      <AppInput v-model="form.url" label="链接" placeholder="商品链接（可选）" />

      <!-- 备注 -->
      <view :style="fieldGroupStyle">
        <text :style="labelStyle">备注</text>
        <view :style="textareaWrapperStyle">
          <input
            :value="form.note"
            placeholder="可选备注..."
            :placeholder-style="placeholderStyleStr"
            :style="textareaStyle"
            @input="onNoteInput"
          />
        </view>
      </view>
    </view>
  </DetailLayout>

  <AppDialog
    v-model:visible="showConfirm"
    title="保存确认"
    :message="confirmMessage"
    @confirm="onConfirmSave"
  />
</template>

<script setup lang="uts">
import { useWishListStore } from '@/stores/wishlist-store'
import { WishItem, WishUpdateData, PRIORITY_LABELS, PRIORITY_COLORS, WISH_STATUS_LABELS, WISH_STATUS_COLORS } from '@/domain/wish-item'
import { brand } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { gap } from '@/theme/layout/spacing'
import { n } from '@/theme/use-theme'
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'


const store = useWishListStore()

const isEdit = ref(false)
const editId = ref('')
const showConfirm = ref(false)
const confirmMessage = ref('')

const form = ref({
  name: '',
  brand: '',
  priceStr: '',
  priority: 'MEDIUM',
  status: 'WISH',
  url: '',
  note: '' })

const priorityOptions = [
  { label: PRIORITY_LABELS['HIGH'], value: 'HIGH', color: PRIORITY_COLORS['HIGH'] },
  { label: PRIORITY_LABELS['MEDIUM'], value: 'MEDIUM', color: PRIORITY_COLORS['MEDIUM'] },
  { label: PRIORITY_LABELS['LOW'], value: 'LOW', color: PRIORITY_COLORS['LOW'] },
]

const statusOptions = [
  { label: '种草', value: 'WISH', color: WISH_STATUS_COLORS['WISH'] },
  { label: '观望', value: 'WATCHING', color: WISH_STATUS_COLORS['WATCHING'] },
  { label: '决定买', value: 'DECIDED', color: WISH_STATUS_COLORS['DECIDED'] },
  { label: '搁置', value: 'PAUSED', color: WISH_STATUS_COLORS['PAUSED'] },
  { label: '拔草', value: 'CANCELED', color: WISH_STATUS_COLORS['CANCELED'] },
]

function onNoteInput(e: any) {
  form.value.note = e.detail?.value ?? ''
}

function onSave() {
  if (!form.value.name.trim()) {
    uni.showToast({ title: '请输入名称', icon: 'none' })
    return
  }
  confirmMessage.value = isEdit.value ? '确认保存修改？' : '确认新增这个心愿？'
  showConfirm.value = true
}

function onConfirmSave() {
  const priceStr = form.value.priceStr
  const price = priceStr !== '' ? parseFloat(priceStr) : 0

  if (isEdit.value) {
    const data = new WishUpdateData()
    data.name = form.value.name.trim()
    data.brand = form.value.brand.trim()
    data.estimatedPrice = price
    data.priority = form.value.priority
    data.status = form.value.status
    data.url = form.value.url.trim()
    data.note = form.value.note.trim()
    const ok = store.updateItem(editId.value, data)
    if (ok) {
      uni.showToast({ title: '保存成功', icon: 'success' })
      setTimeout(() => uni.navigateBack(), 500)
    }
  } else {
    const item = new WishItem()
    item.name = form.value.name.trim()
    item.brand = form.value.brand.trim()
    item.estimatedPrice = price
    item.priority = form.value.priority
    item.status = form.value.status
    item.source = 'MANUAL'
    item.url = form.value.url.trim()
    item.note = form.value.note.trim()
    const added = store.addItem(item)
    if (added) {
      uni.showToast({ title: '新增成功', icon: 'success' })
      setTimeout(() => uni.navigateBack(), 500)
    }
  }
}

onMounted(() => {
  const pages = getCurrentPages()
  const currentPage = pages[pages.length - 1]
  const id = (currentPage as any).options?.id ?? ''

  if (id) {
    editId.value = id
    isEdit.value = true
    const item = store.getById(id)
    if (item) {
      form.value.name = item.name
      form.value.brand = item.brand
      form.value.priceStr = item.estimatedPrice > 0 ? `${item.estimatedPrice}` : ''
      form.value.priority = item.priority
      form.value.status = item.status
      form.value.url = item.url
      form.value.note = item.note
    }
  }
})

// ====== 样式 ======

const saveBtnStyle = {
  fontSize: fontSize.sm,
  color: brand[500],
  fontWeight: fontWeight.medium,
  paddingHorizontal: spacing[2] }

const formStyle = {
  ...gap.md,
  padding: `${spacing[3]} ${spacing[4]}` }

const fieldGroupStyle = {
  gap: spacing[2] }

const labelStyle = computed((): any => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.medium,
  color: n.value.text,
  marginBottom: spacing[1] }))

const chipRowStyle = {
  ...flexRow,
  gap: spacing[2],
  flexWrap: 'wrap' as string }

function priorityChipStyle(active: boolean, color: string) {
  return {
    paddingHorizontal: spacing[3],
    paddingVertical: spacing[1],
    borderRadius: radius.full,
    backgroundColor: active ? color + '20' : n.value.bgTertiary,
    borderWidth: active ? '2rpx' : '0',
    borderStyle: 'solid',
    borderColor: active ? color : 'transparent' }
}

function priorityChipText(active: boolean, color: string) {
  return {
    fontSize: fontSize.sm,
    color: active ? color : n.value.textSecondary,
    fontWeight: active ? fontWeight.medium : fontWeight.regular }
}

function statusChipStyle(active: boolean, color: string) {
  return {
    paddingHorizontal: spacing[3],
    paddingVertical: spacing[1],
    borderRadius: radius.full,
    backgroundColor: active ? color + '20' : n.value.bgTertiary,
    borderWidth: active ? '2rpx' : '0',
    borderStyle: 'solid',
    borderColor: active ? color : 'transparent' }
}

function statusChipText(active: boolean, color: string) {
  return {
    fontSize: fontSize.xs,
    color: active ? color : n.value.textSecondary,
    fontWeight: active ? fontWeight.medium : fontWeight.regular }
}

const textareaWrapperStyle = computed((): any => ({
  height: '160rpx',
  paddingHorizontal: spacing[3],
  paddingTop: spacing[2],
  backgroundColor: n.value.bgTertiary,
  borderRadius: radius.md,
  borderWidth: '2rpx',
  borderStyle: 'solid',
  borderColor: n.value.border }))

const placeholderStyleStr = `color: ${n.value.placeholder}`

const textareaStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.text,
  width: '100%' }))
</script>
