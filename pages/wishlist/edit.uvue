<template>
  <DetailLayout :title="isEdit ? '编辑心愿' : '新增心愿'">
    <template #right>
      <text :style="saveBtnStyle" @tap="onSave">保存</text>
    </template>

    <view :style="formStyle">

      <view :style="coverWrap" @tap="onCoverTap">
        <text :style="coverIcon">+</text>
        <text :style="coverText">上传封面图</text>
      </view>

      <AppInput v-model="form.name" label="商品名称" placeholder="例如：草莓柄甜系 SK" />
      <AppInput v-model="form.brand" label="品牌" placeholder="例如：Alice兔" />
      <AppInput v-model="form.priceStr" label="预估价格" placeholder="0" type="digit" />

      <view :style="fieldGroupStyle">
        <text :style="labelStyle">状态</text>
        <view :style="chipGridStyle">
          <view v-for="opt in statusOptions" :key="opt.value" :style="gridChip(opt.value === form.status, opt.color)" @tap="form.status = opt.value">
            <text :style="gridChipText(opt.value === form.status, opt.color)">{{ opt.label }}</text>
          </view>
        </view>
        <text v-if="form.status === 'PURCHASED'" :style="purchasedHint">标记已买后，可在购买记录中查看</text>
      </view>

      <view :style="fieldGroupStyle">
        <text :style="labelStyle">优先级</text>
        <view :style="chipRowStyle">
          <view v-for="opt in priorityOptions" :key="opt.value" :style="gridChip(opt.value === form.priority, opt.color)" @tap="form.priority = opt.value">
            <text :style="gridChipText(opt.value === form.priority, opt.color)">{{ opt.label }}</text>
          </view>
        </view>
      </view>

      <AppInput v-model="form.url" label="商品链接" placeholder="粘贴商品链接" />

      <view :style="fieldGroupStyle">
        <text :style="labelStyle">备注</text>
        <view :style="noteShell">
          <textarea :value="form.note" placeholder="补充尺码、再贩信息、种草原因等" :placeholder-style="placeholderStyle" :style="noteInput" :maxlength="160" @input="onNoteInput" />
        </view>
        <text :style="noteCount">{{ form.note.length }}/160</text>
      </view>

    </view>
  </DetailLayout>
  <AppDialog v-model:visible="deleteDialogVisible" title="确认删除" message="删除后无法恢复，确定要删除这个心愿吗？" confirm-text="删除" @confirm="onDeleteConfirm" />
</template>

<script setup lang="uts">
import { useWishListStore } from '@/stores/wishlist-store'
import { WishItem, WishUpdateData, WISH_WISH, WISH_WATCHING, WISH_DECIDED, WISH_PURCHASED, WISH_PAUSED, WISH_CANCELED, PRIORITY_HIGH, PRIORITY_MEDIUM, PRIORITY_LOW, WISH_STATUS_COLORS, PRIORITY_COLORS } from '@/domain/wish-item'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR, getCardRadius } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import { showFeedback } from '@/utils/feedback'
import DetailLayout from '@/components/layout/DetailLayout.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'

const store = useWishListStore()
const isEdit = ref(false)
const editId = ref('')
const deleteDialogVisible = ref(false)

const sc = WISH_STATUS_COLORS as any
const pc = PRIORITY_COLORS as any

const statusOptions = [
  { label: '种草', value: WISH_WISH, color: sc.WISH as string },
  { label: '观望', value: WISH_WATCHING, color: sc.WATCHING as string },
  { label: '决定买', value: WISH_DECIDED, color: sc.DECIDED as string },
  { label: '已买', value: WISH_PURCHASED, color: sc.PURCHASED as string },
  { label: '搁置', value: WISH_PAUSED, color: sc.PAUSED as string },
  { label: '拔草', value: WISH_CANCELED, color: sc.CANCELED as string },
]

const priorityOptions = [
  { label: '高', value: PRIORITY_HIGH, color: pc.HIGH as string },
  { label: '中', value: PRIORITY_MEDIUM, color: pc.MEDIUM as string },
  { label: '低', value: PRIORITY_LOW, color: pc.LOW as string },
]

type WishFormState = {
  name: string
  brand: string
  priceStr: string
  priority: string
  status: string
  url: string
  note: string
}
const form = ref<WishFormState>({ name: '', brand: '', priceStr: '', priority: PRIORITY_MEDIUM, status: WISH_WISH, url: '', note: '' })

function onCoverTap() { showFeedback('封面功能开发中，敬请期待') }

function onNoteInput(e: any) {
  const eObj = e as UTSJSONObject
  const d = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
  form.value.note = d != null && d['value'] != null ? d['value'] as string : ''
}

function onSave() {
  if (form.value.name.trim() === '') { showFeedback('请填写商品名称'); return }
  if (isEdit.value) {
    const data = new WishUpdateData()
    data.name = form.value.name.trim()
    data.brand = form.value.brand.trim()
    data.estimatedPrice = parseFloat(form.value.priceStr) || 0
    data.priority = form.value.priority
    data.status = form.value.status
    data.url = form.value.url.trim()
    data.note = form.value.note
    if (!store.updateItem(editId.value, data)) { showFeedback('保存失败，请重试'); return }
  } else {
    const item = new WishItem()
    item.name = form.value.name.trim()
    item.brand = form.value.brand.trim()
    item.estimatedPrice = parseFloat(form.value.priceStr) || 0
    item.priority = form.value.priority
    item.status = form.value.status
    item.url = form.value.url.trim()
    item.note = form.value.note
    item.source = 'MANUAL'
    if (store.addItem(item) === null) { showFeedback('保存失败，请重试'); return }
  }
  showFeedback('保存成功')
  setTimeout(() => { uni.navigateBack() }, 300)
}

function onDeleteConfirm() {
  if (!store.deleteItem(editId.value)) { showFeedback('删除失败，请重试'); return }
  showFeedback('已删除')
  setTimeout(() => { uni.navigateBack() }, 220)
}

onLoad((options) => {
  store.fetchItems()
  if (options != null) {
    const id = options['id'] != null ? options['id'] as string : ''
    if (id !== '') {
      editId.value = id; isEdit.value = true
      const item = store.getById(id)
      if (item != null) {
        form.value.name = item.name
        form.value.brand = item.brand
        form.value.priceStr = item.estimatedPrice > 0 ? item.estimatedPrice.toString() : ''
        form.value.priority = item.priority
        form.value.status = item.status
        form.value.url = item.url
        form.value.note = item.note
      }
      return
    }
    form.value.name = options['name'] != null ? (options['name'] as string) : ''
    form.value.brand = options['brand'] != null ? (options['brand'] as string) : ''
    form.value.url = options['url'] != null ? (options['url'] as string) : ''
    form.value.note = options['note'] != null ? (options['note'] as string) : ''
  }
})

const cr = getCardRadius()
const formStyle = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }

const coverWrap = { height: '200rpx', borderRadius: cr, backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', marginBottom: '24rpx' }
const coverIcon = { fontSize: '48rpx', color: n.value.textTertiary }
const coverText = { fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '8rpx' }

const fieldGroupStyle = { marginTop: '24rpx' }
const labelStyle = computed((): any => ({ fontSize: '28rpx', fontWeight: fontWeight.semibold, color: n.value.text, marginBottom: '14rpx' }))

const chipGridStyle = { flexDirection: 'row', flexWrap: 'wrap' as string }
const chipRowStyle = { flexDirection: 'row' }
function gridChip(active: boolean, color: string): any {
  return {
    width: '210rpx', height: '64rpx', alignItems: 'center' as string, justifyContent: 'center' as string,
    borderRadius: '20rpx', marginRight: '16rpx', marginBottom: '12rpx',
    backgroundColor: active ? color : n.value.bgSecondary,
    borderWidth: active ? '0' : '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder,
  }
}
function gridChipText(active: boolean, _color: string): any {
  return { fontSize: '26rpx', fontWeight: fontWeight.medium, color: active ? '#FFFFFF' : n.value.textSecondary }
}

const noteShell = computed((): any => ({ minHeight: '120rpx', padding: '24rpx', borderRadius: cr, backgroundColor: n.value.inputFill }))
const noteInput = computed((): any => ({ width: '100%', minHeight: '80rpx', fontSize: '28rpx', color: n.value.text, lineHeight: '40rpx' }))
const placeholderStyle = computed((): string => `color:${n.value.placeholder}`)
const noteCount = { fontSize: '22rpx', color: n.value.textTertiary, textAlign: 'right' as string, marginTop: '6rpx' }

const purchasedHint = { fontSize: '22rpx', color: n.value.textTertiary, marginTop: '8rpx' }

const saveBtnStyle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: brand[500] as string, paddingRight: '8rpx' }))
</script>
