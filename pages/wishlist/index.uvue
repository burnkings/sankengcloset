<template>
  <MainLayout navbar-content-height="88rpx" :scrollable="false">
    <template #navbar>
      <AppNavbar title="愿望单" :show-back="true" />
    </template>

    <template #default>
      <AppLoading v-if="store.loading" />

      <scroll-view v-else scroll-y :style="scrollStyle">
        <V2Segmented :items="viewTabs" :active="activeTab" variant="soft" :active-color="brand[500]" @change="onTab" />

        <view v-if="viewItems.length === 0" :style="emptyWrap">
          <text :style="emptyTitle">这个分类还是空的</text>
          <text :style="emptySub">去添加一件想拥有的三坑宝贝吧~</text>
        </view>

        <view v-else :style="gridWrap">
          <view v-for="(item, idx) in viewItems" :key="item.id" :style="itemCard(idx)" @tap="onItemTap(item.id)">
            <view :style="itemImage">
              <AppImage v-if="item.coverImage !== ''" :src="item.coverImage" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            </view>
            <view :style="itemBody">
              <text :style="itemName">{{ item.name }}</text>
                <text :style="itemPrice">{{ item.priceText }}</text>
            </view>
          </view>
        </view>

        <view :style="bottomSpacer" />
      </scroll-view>
    </template>
  </MainLayout>
  <view :style="fabStyle" @tap="onAddTap"><text :style="fabPlus">＋</text></view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { useWishListStore } from '@/stores/wishlist-store'
import { WishDisplayModel } from '@/domain/wish-presenter'
import { brand } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_PADDING, PAGE_GUTTER_REGULAR, PRODUCT_CARD_WIDTH, GROUP_GAP } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import V2Segmented from '@/components/v2/V2Segmented.uvue'
import { getSafeBottomInset } from '@/utils/window-info'

const store = useWishListStore()
const safeBottom = getSafeBottomInset()
const viewTabs = ['商品', '搭配', '品牌']
const activeTab = ref('商品')
function onTab(label: string) { activeTab.value = label }

  const viewItems = computed((): WishDisplayModel[] => {
    const all = store.displayItems
    if (activeTab.value === '搭配') return all.filter((w: WishDisplayModel) => w.status === 'WISH' || w.status === 'DECIDED')
    if (activeTab.value === '品牌') return all.filter((w: WishDisplayModel) => w.status === 'WATCHING' || w.status === 'PURCHASED')
    return all
  })

function onItemTap(id: string) {
  uni.navigateTo({ url: `/pages/wishlist/detail?id=${id}` })
}
function onAddTap() {
  uni.navigateTo({ url: '/pages/wishlist/edit' })
}
onPageShow(() => {
  store.fetchItems()
})

const scrollStyle = computed((): any => ({
  flex: 1,
  backgroundColor: n.value.bg,
}))
const gridWrap = { ...flexRow, flexWrap: 'wrap' as string, paddingTop: '20rpx', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
function itemCard(idx: number) {
  return { width: PRODUCT_CARD_WIDTH, marginRight: idx % 2 === 0 ? GROUP_GAP : '0', marginBottom: GROUP_GAP, borderRadius: '24rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.cardBorder, overflow: 'hidden' as string }
}
const itemImage = computed((): any => ({ width: PRODUCT_CARD_WIDTH, height: '420rpx', backgroundColor: n.value.bgTertiary }))
const itemBody = { padding: '20rpx' }
const itemName = computed((): any => ({ fontSize: '26rpx', fontWeight: fontWeight.semibold, color: n.value.text, lines: 1, textOverflow: 'ellipsis' }))
const itemPrice = { fontSize: '28rpx', fontWeight: fontWeight.semibold, color: brand[600], marginTop: '8rpx' }
const emptyWrap = { alignItems: 'center', paddingTop: '160rpx', paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
const emptyTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text }))
const emptySub = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, marginTop: '12rpx' }))
const bottomSpacer = { height: '180rpx' }
const fabStyle = { position: 'fixed' as string, left: '323rpx', bottom: `${safeBottom + 48}px`, width: '104rpx', height: '104rpx', borderRadius: '52rpx', backgroundColor: brand[500], alignItems: 'center', justifyContent: 'center', zIndex: 100 } as UTSJSONObject
const fabPlus = { fontSize: '56rpx', lineHeight: '64rpx', fontWeight: fontWeight.medium, color: '#FFFFFF' } as UTSJSONObject
</script>
