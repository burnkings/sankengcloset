<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar>
      <AppNavbar title="愿望单" :show-back="true" />
    </template>
    <template #default>
      <FeedSkeleton v-if="store.loading" />
      <scroll-view v-else :style="scrollStyle">
        <view class="page-canvas" :style="pageWrap">

          <!-- V3 §6.19 顶部紧凑摘要：只保留心愿总数和待买数量 -->
          <SummaryStrip :items="summaryItems" :surface="true" />

          <FilterChips :items="viewTabs" :active="activeTab" @change="onTab" />

          <template v-if="viewItems.length === 0">
            <PageState icon="heart" title="暂无心愿商品" message="记录心仪好物，避免错过再贩" action-text="添加心愿" @action="onAddTap" />
          </template>

          <view v-else :style="gridWrap">
            <view v-for="(item, idx) in viewItems" :key="item.id" :style="cardWrap(idx)" @tap="onItemTap(item.id)">
              <view :style="cardImage">
                <AppImage v-if="item.coverImage !== ''" :src="item.coverImage" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                <view v-else :style="cardPlaceholder">
                  <AppIcon name="add" :size="64" />
                </view>
                <view v-if="item.priorityOrder <= 2" :style="prioBadge(item.priorityOrder)">
                  <text :style="prioBadgeText">{{ item.priorityLabel }}</text>
                </view>
                <view :style="statusDot(item.statusColor)" />
              </view>
              <view :style="cardBody">
                <text :style="cardName">{{ item.name }}</text>
                <view :style="cardBottom">
                  <text :style="cardBrand">{{ item.brand }}</text>
                  <text :style="cardPrice">{{ item.priceText }}</text>
                </view>
              </view>
            </view>
          </view>

          <view :style="bottomSpacer" />
        </view>
      </scroll-view>
    </template>
  </MainLayout>
  <AppFab @tap="onAddTap" />
</template>

<script setup lang="uts">
import { useWishListStore } from '@/stores/wishlist-store'
import { WishDisplayModel, calcStats } from '@/domain/wish-presenter'
import { brand, semantic } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3, PRODUCT_CARD_WIDTH_V3, COLUMN_GAP_V3, FEED_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import SummaryStrip from '@/components/v3/SummaryStrip.uvue'
import FilterChips from '@/components/v3/FilterChips.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'
import AppFab from '@/components/base/AppFab.uvue'

const store = useWishListStore()
const viewTabs = ['全部', '种草', '观望', '决定买', '已买', '拔草']
const activeTab = ref('全部')

const stats = computed(() => calcStats(store.activeItems))

function onTab(label: string) { activeTab.value = label }
const viewItems = computed((): WishDisplayModel[] => {
  const all = store.displayItems
  if (activeTab.value === '种草') return all.filter((w) => w.status === 'WISH')
  if (activeTab.value === '观望') return all.filter((w) => w.status === 'WATCHING')
  if (activeTab.value === '决定买') return all.filter((w) => w.status === 'DECIDED')
  if (activeTab.value === '已买') return all.filter((w) => w.status === 'PURCHASED')
  if (activeTab.value === '拔草') return all.filter((w) => w.status === 'CANCELED')
  return all
})

function onItemTap(id: string) { uni.navigateTo({ url: `/pages/wishlist/detail?id=${id}` }) }
function onAddTap() { uni.navigateTo({ url: '/pages/wishlist/edit' }) }
onMounted(() => { store.fetchItems() })

const scrollStyle = { flex: 1, backgroundColor: n.value.bg }
const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }

// V3 §6.19 顶部紧凑摘要：心愿总数 / 待买
const summaryItems = computed(() => [
  { label: '心愿总数', value: `${stats.value.wishCount + stats.value.decidedCount + stats.value.purchasedCount} 件` },
  { label: '待买', value: `${stats.value.decidedCount} 件`, highlight: stats.value.decidedCount > 0 },
])

const gridWrap = { ...flexRow, flexDirection: 'row', flexWrap: 'wrap' as string, paddingTop: '16rpx', paddingLeft: FEED_GUTTER_V3, paddingRight: FEED_GUTTER_V3 }
function cardWrap(idx: number) {
  return { width: PRODUCT_CARD_WIDTH_V3, marginRight: idx % 2 == 0 ? COLUMN_GAP_V3 : '0', marginBottom: '28rpx', borderRadius: '12rpx', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid' as string, borderColor: n.value.border, overflow: 'hidden' as string }
}
const cardImage = { width: PRODUCT_CARD_WIDTH_V3, height: '470rpx', position: 'relative', backgroundColor: n.value.bgTertiary }
const cardPlaceholder = { width: '100%', height: '100%', backgroundColor: n.value.surfacePink, alignItems: 'center', justifyContent: 'center' }
function prioBadge(order: number): any {
  const bg = order === 1 ? semantic.error : semantic.warning
  return { position: 'absolute', top: '10rpx', left: '10rpx', paddingLeft: '10rpx', paddingRight: '10rpx', paddingTop: '3rpx', paddingBottom: '3rpx', borderRadius: '8rpx', backgroundColor: bg }
}
const prioBadgeText = { fontSize: '20rpx', color: '#FFFFFF', fontWeight: fontWeight.semibold }
function statusDot(color: string) { return { position: 'absolute', top: '10rpx', right: '10rpx', width: '16rpx', height: '16rpx', borderRadius: '8rpx', backgroundColor: color } }
const cardBody = { padding: '20rpx' }
const cardName = { fontSize: '26rpx', fontWeight: fontWeight.semibold, color: n.value.text, lines: 1, textOverflow: 'ellipsis' }
const cardBottom = { ...flexRow, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginTop: '8rpx' }
const cardBrand = { fontSize: '22rpx', color: n.value.textSecondary, flex: 1 }
const cardPrice = { fontSize: '28rpx', fontWeight: fontWeight.semibold, color: brand[600] as string, flexShrink: 0, marginLeft: '8rpx' }

const bottomSpacer = { height: '60rpx' }
</script>
