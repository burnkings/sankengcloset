<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout>
      <template #navbar>
        <V2PageHeader title="绮灵AI" />
      </template>
      <template #default>
        <view class="page-canvas" :style="pageWrap">
          <!-- 提示卡：design surfacePink #FCEFF2，圆角 16，黑字 -->
          <view :style="hintCard">
            <text :style="hintTitle">把想法变成购买与搭配决策</text>
            <text :style="hintDesc">写清场合、预算或发售节点，先由本机规则给出可解释建议</text>
          </view>

          <!-- 输入行：design 输入框 inputFill #E8E0D6 圆角24 + 发送 brand[600] 圆 48 白箭头 -->
          <view :style="composerWrap">
            <view :style="composerInput">
              <text :style="composerPlaceholder">例如:800元内的夏日茶会搭配</text>
            </view>
            <view :style="composerSend" @tap="onSend">
              <AppIcon name="arrow-right" :size="40" :active="true" />
            </view>
          </view>

          <!-- 六项专属能力 -->
          <V2SectionHeader title="六项专属能力" />
          <view :style="capGrid">
            <view
              v-for="(item, idx) in capabilities"
              :key="item.id"
              :style="capTile(idx)"
              @tap="onCapTap(item)"
            >
              <view :style="capIconWrap"><AppIcon :name="item.icon" :size="32" :active="true" /></view>
              <text :style="capTitle">{{ item.title }}</text>
              <text :style="capDesc">{{ item.desc }}</text>
            </view>
          </view>
        </view>
      </template>
    </MainLayout>
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { brand } from '@/theme/tokens/colors'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { CARD_RADIUS, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n, isDark, syncTabBarChrome, initPageTheme } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import V2PageHeader from '@/components/v2/V2PageHeader.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import { showFeedback } from '@/utils/feedback'
// #ifdef APP
import { getWindowHeight } from '@/utils/window-info'
// #endif

const pageHeight = getWindowHeight()

const capabilities = [
  { id: 'image', icon: 'import', title: '图片识款', desc: '识别草稿逐字段确认后再导入' },
  { id: 'wardrobe', icon: 'wardrobe', title: '衣橱搭配', desc: '按场合复用已有单品' },
  { id: 'dupe', icon: 'search', title: '平替雷达', desc: '按版型、总价与状态比较' },
  { id: 'profile', icon: 'heart', title: '收藏画像', desc: '识别偏好与重复购买风险' },
  { id: 'budget', icon: 'budget', title: '预算守门', desc: '把定金和尾款一起计算' },
  { id: 'release', icon: 'notification', title: '发售雷达', desc: '拆分图透、定金、尾款与现货' },
]

function pageGutter() {
  return { paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR }
}

initPageTheme()
onPageShow(() => { initPageTheme(); syncTabBarChrome() })

const pageWrap = { ...pageGutter(), paddingTop: '16rpx', paddingBottom: '48rpx' } as UTSJSONObject

// 提示卡：design bg #FCEFF2 (surfacePink)，圆角 16
const hintCard = computed((): any => ({
  borderRadius: CARD_RADIUS,
  backgroundColor: isDark.value ? n.value.surfaceWarm : n.value.surfacePink,
  padding: '24rpx',
  marginBottom: '32rpx',
}))
const hintTitle = computed((): any => ({ display: 'block', color: n.value.text, fontSize: '31rpx', fontWeight: '700', lineHeight: '40rpx', marginBottom: '8rpx' }))
const hintDesc = computed((): any => ({ display: 'block', color: n.value.textSecondary, fontSize: '25rpx', fontWeight: '400', lineHeight: '34rpx' }))

// 输入行
const composerWrap = { ...flexRow, alignItems: 'center', gap: '16rpx', marginBottom: '40rpx' } as UTSJSONObject
const composerInput = computed((): any => ({
  ...flexFill,
  height: '88rpx',
  borderRadius: '9999rpx',
  backgroundColor: n.value.inputFill,
  borderWidth: '1rpx',
  borderStyle: 'solid',
  borderColor: n.value.cardBorder,
  paddingLeft: '28rpx',
  paddingRight: '28rpx',
  justifyContent: 'center',
}))
const composerPlaceholder = computed((): any => ({ color: n.value.textSecondary, fontSize: '27rpx' }))
const composerSend = {
  width: '88rpx',
  height: '88rpx',
  borderRadius: '9999rpx',
  backgroundColor: brand[600],
  alignItems: 'center',
  justifyContent: 'center',
  flexShrink: 0,
} as UTSJSONObject

// 能力网格：2×3，每卡 170×96（≈327×184rpx），白底 + cardBorder 描边，圆角 16
const capGrid = { display: 'flex', flexDirection: 'row', flexWrap: 'wrap', gap: '16rpx' } as UTSJSONObject
function capTile(idx: number) {
  return {
    width: '327rpx',
    height: '184rpx',
    borderRadius: CARD_RADIUS,
    backgroundColor: n.value.surface,
    borderWidth: '1rpx',
    borderStyle: 'solid',
    borderColor: n.value.cardBorder,
    padding: '20rpx',
    flexShrink: 0,
  } as UTSJSONObject
}
const capIconWrap = computed((): any => ({
  width: '56rpx',
  height: '56rpx',
  borderRadius: '9999rpx',
  backgroundColor: n.value.surface,
  borderWidth: '1rpx',
  borderStyle: 'solid',
  borderColor: brand[300],
  alignItems: 'center',
  justifyContent: 'center',
  marginBottom: '14rpx',
}))
const capTitle = computed((): any => ({ display: 'block', color: n.value.text, fontSize: '27rpx', fontWeight: '700', lineHeight: '34rpx', marginBottom: '6rpx' }))
const capDesc = computed((): any => ({ display: 'block', color: n.value.textSecondary, fontSize: '21rpx', fontWeight: '400', lineHeight: '28rpx' }))

function onSend() {
  showFeedback('已收到，正在生成本机建议…')
}
function onCapTap(item: any) {
  const o = item as UTSJSONObject
  const title = o['title'] != null ? o['title'] as string : ''
  showFeedback(`${title}：功能开发中`)
}
</script>
