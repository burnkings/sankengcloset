<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar><AppNavbar title="发布动态" :show-back="true" /></template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view :style="photoCard" @tap="choosePhoto">
          <view v-if="selectedImage !== ''" :style="previewWrap">
            <AppImage :src="selectedImage" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            <view :style="replaceAction"><AppIcon name="camera" :size="30" :active="true" /><text :style="replaceText">重新选择</text></view>
          </view>
          <view v-else :style="uploadEmpty">
            <view :style="uploadIcon"><AppIcon name="camera" :size="52" :active="true" /></view>
            <text :style="uploadTitle">选择一张穿搭美照</text>
            <text :style="uploadDesc">支持从相册选择或直接拍摄</text>
          </view>
        </view>

        <FormSection title="穿搭说明">
          <AppInput v-model="caption" placeholder="例如：第一次尝试茶会风 Lolita" :maxlength="60" :clearable="true" />
        </FormSection>

        <FormSection title="选择坑向">
          <view :style="categoryRow">
            <view v-for="(item, idx) in categories" :key="item" :style="categoryChip(idx, item)" @tap="category = item">
              <text :style="categoryText(item)">{{ item }}</text>
            </view>
          </view>
        </FormSection>

        <FormSection title="选择话题">
          <view :style="topicWrap">
            <view v-for="(item, idx) in topics" :key="item" :style="topicChip(idx, item)" @tap="topic = item">
              <text :style="topicText(item)">#{{ item }}</text>
            </view>
          </view>
        </FormSection>

        <FormSection title="关联商品与衣物（可选）">
          <view v-if="selectedProductId === ''" :style="productBtnRow" @tap="openProductPicker">
            <text :style="productBtnText">搜索并选择发布的商品</text>
            <AppIcon name="search" :size="28" />
          </view>
          <view v-else :style="productCard">
            <image v-if="selectedProductCover !== ''" :src="selectedProductCover" :style="productCardImg" mode="aspectFill" />
            <view v-else :style="productCardPlaceholder"><AppIcon name="shirt" :size="30" :active="true" /></view>
            <view :style="productCardInfo">
              <text :style="productCardName">{{ selectedProductName }}</text>
              <text :style="productCardBrand">{{ selectedProductBrand }}</text>
            </view>
            <view :style="productCardRemoveWrap" @tap.stop="removeProduct"><AppIcon name="close" :size="24" /></view>
          </view>
          <view :style="wardrobeLinkRow" @tap="openWardrobePicker">
            <view :style="wardrobeLinkCopy"><text :style="wardrobeLinkTitle">{{ selectedWardrobeIds.length > 0 ? '已关联 ' + selectedWardrobeIds.length + ' 件衣物' : '关联我的衣物' }}</text><text :style="wardrobeLinkDesc">可同时关联穿搭中实际穿着的衣物</text></view>
            <AppIcon name="chevron-right" :size="28" />
          </view>
          <view v-if="selectedWardrobeIds.length > 0" :style="wardrobeTagsWrap">
            <view v-for="id in selectedWardrobeIds" :key="id" :style="wardrobeTag"><text :style="wardrobeTagText">{{ wardrobeName(id) }}</text><view :style="wardrobeTagRemove" @tap.stop="removeWardrobe(id)"><AppIcon name="close" :size="22" /></view></view>
          </view>
        </FormSection>

        <text :style="privacyNote">{{ privacyNoteText }}</text>
      </view>
    </template>
  </MainLayout>
  <BottomActionBar>
    <view :style="publishButton" @tap="publishLook">
      <text :style="publishText">发布动态</text>
    </view>
  </BottomActionBar>

  <AppDialog :visible="showProductPicker" title="选择关联商品" @confirm="confirmProduct" @cancel="showProductPicker = false">
    <view :style="productPickerWrap">
      <view :style="productSearchRow">
        <AppInput v-model="productKeyword" placeholder="搜索商品名称 / 品牌" :clearable="true" @confirm="searchProductList" />
        <view :style="productSearchBtn" @tap="searchProductList"><AppIcon name="search" :size="26" :active="true" /></view>
      </view>
      <scroll-view :style="productPickerScroll" direction="vertical">
        <view v-if="productSearchLoading" :style="productEmptyWrap"><text :style="productEmptyText">搜索中…</text></view>
        <view v-else-if="productResults.length === 0" :style="productEmptyWrap">
          <text :style="productEmptyText">{{ productKeyword !== '' ? '未找到相关商品' : '输入关键词搜索商品' }}</text>
        </view>
        <view v-else>
          <view v-for="item in productResults" :key="item.entityId" :style="productResultRow" @tap="selectProduct(item)">
            <image v-if="item.coverUrl !== ''" :src="item.coverUrl" :style="productResultImg" mode="aspectFill" />
            <view v-else :style="productResultImgPlaceholder"><AppIcon name="shirt" :size="26" :active="true" /></view>
            <view :style="productResultInfo">
              <text :style="productResultTitle">{{ item.title }}</text>
              <text :style="productResultBrand">{{ item.brandName }}</text>
            </view>
            <view :style="productResultCheck" v-if="item.entityId === selectedProductId">
              <AppIcon name="check" :size="22" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </AppDialog>

  <AppDialog :visible="showWardrobePicker" title="选择关联衣物" @confirm="confirmWardrobe" @cancel="showWardrobePicker = false">
    <scroll-view :style="wardrobePickerScroll" direction="vertical">
      <view v-if="wardrobeStore.sortedItems.length === 0" :style="productEmptyWrap"><text :style="productEmptyText">衣橱还没有可关联的衣物</text></view>
      <view v-else :style="wardrobePickerGrid">
        <view v-for="wd in wardrobeStore.sortedItems" :key="wd.id" :style="wardrobePickerItem(wd.id)" @tap="toggleWardrobe(wd.id)">
          <image v-if="wd.coverImage !== ''" :src="wd.coverImage" :style="wardrobePickerImage" mode="aspectFill" />
          <view v-else :style="wardrobePickerPlaceholder"><AppIcon name="shirt" :size="28" :active="true" /></view>
          <view :style="wardrobePickerCopy"><text :style="wardrobePickerName">{{ wd.name }}</text><text :style="wardrobePickerMeta">{{ wardrobeCategory(wd.category) }}</text></view>
          <AppIcon v-if="tempWardrobeIds.indexOf(wd.id) >= 0" name="check" :size="26" :active="true" />
        </view>
      </view>
    </scroll-view>
  </AppDialog>
</template>

<script setup lang="uts">
import { openPrimaryTab } from '@/utils/tab-navigation'
import { brand, baseColors } from '@/theme/tokens/colors'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3 } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppDialog from '@/components/base/AppDialog.uvue'
import FormSection from '@/components/v3/FormSection.uvue'
import BottomActionBar from '@/components/v3/BottomActionBar.uvue'
import { showFeedback } from '@/utils/feedback'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useWardrobeStore } from '@/stores/wardrobe-store'
import { useSessionStore } from '@/stores/session-store'
import { searchProducts } from '@/services/content/search-service'
import { FeedItem } from '@/domain/content/feed-item'

const selectedImage = ref('')
const caption = ref('')
const category = ref('JK')
const topic = ref('今日穿搭')
const categories = ['JK', 'Lolita', '汉服', '混搭']
const topics = ['今日穿搭', '茶会搭配', '通勤三坑', '低预算搭配']
const library = useContentLibraryStore()
const wardrobeStore = useWardrobeStore()
const session = useSessionStore()
const publishing = ref(false)
// 发布后延迟跳转的定时器：页面卸载时清理，避免残留
let backTimer: number | null = null
onUnload(() => { if (backTimer != null) { clearTimeout(backTimer); backTimer = null } })

// 关联商品（Phase 2.3-A）：复用现有 Search Service / Product Domain / Search API，不新建搜索系统
const showProductPicker = ref(false)
const productKeyword = ref('')
const productResults = ref<FeedItem[]>([])
const productSearchLoading = ref(false)
const selectedProductId = ref('')
const selectedProductName = ref('')
const selectedProductBrand = ref('')
const selectedProductCover = ref('')
const selectedWardrobeIds = ref<string[]>([])
const tempWardrobeIds = ref<string[]>([])
const showWardrobePicker = ref(false)
function openProductPicker() {
  productKeyword.value = ''
  productResults.value = []
  showProductPicker.value = true
}
async function searchProductList() {
  const keyword = productKeyword.value.trim()
  if (keyword === '') {
    showFeedback('输入关键词搜索商品')
    return
  }
  productSearchLoading.value = true
  try {
    const result = await searchProducts(keyword)
    productResults.value = result.items
  } catch (e) {
    showFeedback(e instanceof Error ? e.message : '搜索失败，请重试')
    productResults.value = []
  } finally {
    productSearchLoading.value = false
  }
}
function selectProduct(item: FeedItem) {
  selectedProductId.value = item.entityId
  selectedProductName.value = item.title
  selectedProductBrand.value = item.brandName
  selectedProductCover.value = item.coverUrl
  showProductPicker.value = false
}
function confirmProduct() {
  // 未选择任何商品时保持普通内容发布
  showProductPicker.value = false
}
function removeProduct() {
  selectedProductId.value = ''
  selectedProductName.value = ''
  selectedProductBrand.value = ''
  selectedProductCover.value = ''
}
function openWardrobePicker() {
  tempWardrobeIds.value = [...selectedWardrobeIds.value]
  wardrobeStore.fetchItems()
  showWardrobePicker.value = true
}
function toggleWardrobe(id: string) {
  const idx = tempWardrobeIds.value.indexOf(id)
  if (idx >= 0) { const next = [...tempWardrobeIds.value]; next.splice(idx, 1); tempWardrobeIds.value = next }
  else tempWardrobeIds.value = [...tempWardrobeIds.value, id]
}
function confirmWardrobe() {
  selectedWardrobeIds.value = [...tempWardrobeIds.value]
  showWardrobePicker.value = false
}
function removeWardrobe(id: string) {
  selectedWardrobeIds.value = selectedWardrobeIds.value.filter((item) => item !== id)
}
function wardrobeName(id: string): string {
  const item = wardrobeStore.getById(id)
  return item != null ? item.name : '衣物'
}
function wardrobeCategory(category: string): string {
  if (category === 'LOLITA') return 'Lolita'
  if (category === 'HANFU') return '汉服'
  if (category === 'JK') return 'JK制服'
  return '其他'
}

function choosePhoto() {
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    sourceType: ['album', 'camera'],
    success: (res) => {
      if (res.tempFilePaths.length > 0) selectedImage.value = res.tempFilePaths[0]
    },
  })
}

function publishLook() {
  if (publishing.value) return
  if (selectedImage.value === '') {
    showFeedback('先选一张想分享的美照')
    return
  }
  if (!session.isLoggedIn) {
    showFeedback('请先登录后再发布')
    return
  }
  publishing.value = true
  const publishRemote = async () => {
    try {
      const ok = await library.publishOutfitRemote(selectedImage.value, caption.value, category.value, topic.value, selectedWardrobeIds.value, selectedProductId.value)
      if (!ok) {
        publishing.value = false
        showFeedback('发布失败，请重试')
        return
      }
      publishing.value = false
      showFeedback('动态已发布')
      backTimer = setTimeout(() => { openPrimaryTab('/pages/community/index') }, 180)
    } catch (e) {
      publishing.value = false
      showFeedback(e instanceof Error ? e.message : '发布失败，请重试')
    }
  }
  publishRemote()
}

// 隐私提示随登录态变化：模拟登录/正式登录均可发布，未登录不产生任何内容
// 动态流支持商品与衣物关联；正式账号发布后进入公开动态流。
const privacyNoteText = computed((): string => {
  return session.isLoggedIn
    ? '发布后会展示在动态流，供同好浏览与点赞。'
    : '当前未登录：无法发布，请先登录后再分享。'
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3}
// V3 §6.9 图片选择区优先；photoCard 圆角 16rpx、token 背景
const photoCard = computed((): any => ({ width: '686rpx', height: '560rpx', borderRadius: '16rpx', backgroundColor: n.value.bgSecondary, overflow: 'hidden' }))
const previewWrap = { width: '686rpx', height: '560rpx', position: 'relative' as string }
const replaceAction = computed((): any => ({ position: 'absolute', right: '20rpx', bottom: '20rpx', height: '64rpx', paddingLeft: '18rpx', paddingRight: '18rpx', borderRadius: radius.full, backgroundColor: n.value.surface, ...flexRow, alignItems: 'center', justifyContent: 'center' }))
const replaceText = computed((): any => ({ fontSize: fontSize.xs, fontWeight: fontWeight.medium, color: n.value.text, marginLeft: '8rpx' }))
const uploadEmpty = { flex: 1, alignItems: 'center', justifyContent: 'center' }
const uploadIcon = computed((): any => ({ width: '80rpx', height: '80rpx', borderRadius: '20rpx', backgroundColor: n.value.surfacePink, alignItems: 'center', justifyContent: 'center' }))
const uploadTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '24rpx' }))
const uploadDesc = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '8rpx' }))
// V3 §5.7 二级筛选：56rpx 胶囊、选中品牌浅底+深色文字
const categoryRow = { ...flexRow, flexWrap: 'wrap' as string }
function categoryChip(idx: number, item: string) { return { height: '56rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '9999rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: category.value === item ? n.value.surfacePink : n.value.bgSecondary, borderWidth: '1rpx', borderStyle: 'solid', borderColor: category.value === item ? 'transparent' : n.value.border, marginRight: '12rpx', marginBottom: '12rpx' } }
function categoryText(item: string) { return { fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: category.value === item ? brand.primary : n.value.textSecondary } }
const topicWrap = { ...flexRow, flexWrap: 'wrap' as string }
function topicChip(idx: number, item: string) { return { height: '56rpx', paddingLeft: '24rpx', paddingRight: '24rpx', borderRadius: '9999rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: topic.value == item ? n.value.surfacePink : n.value.bgSecondary, borderWidth: '1rpx', borderStyle: 'solid', borderColor: topic.value == item ? 'transparent' : n.value.border, marginRight: '12rpx', marginBottom: '12rpx' } }
function topicText(item: string) { return { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: topic.value == item ? brand.primary : n.value.textSecondary } }
// V3 §5.9 主按钮：88rpx 高、16rpx 圆角
const publishButton = computed((): any => ({ flex: 1, height: '88rpx', borderRadius: '16rpx', backgroundColor: brand.primary, alignItems: 'center', justifyContent: 'center' }))
const publishText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
const privacyNote = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary, textAlign: 'center', lineHeight: '36rpx', marginTop: '20rpx', marginBottom: '32rpx' }))

// 关联商品（Phase 2.3-A）
const productBtnRow = computed((): any => ({ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', height: '88rpx', paddingLeft: '28rpx', paddingRight: '28rpx', borderRadius: '16rpx', backgroundColor: n.value.inputFill }))
const productBtnText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary }))
const productCard = computed((): any => ({ flexDirection: 'row', alignItems: 'center', borderRadius: '16rpx', overflow: 'hidden', backgroundColor: n.value.surface, borderWidth: '1rpx', borderStyle: 'solid', borderColor: n.value.border, padding: '16rpx' }))
const productCardImg = { width: '96rpx', height: '96rpx', borderRadius: '12rpx', flexShrink: 0 }
const productCardPlaceholder = computed((): any => ({ width: '96rpx', height: '96rpx', borderRadius: '12rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', flexShrink: 0 }))
const productCardInfo = { flex: 1, marginLeft: '16rpx', marginRight: '12rpx' }
const productCardName = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, lines: 1 }))
const productCardBrand = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '6rpx', lines: 1 }))
const productCardRemoveWrap = { width: '48rpx', height: '48rpx', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }
const productPickerWrap = { paddingTop: '8rpx' }
const productSearchRow = { flexDirection: 'row', alignItems: 'center', marginBottom: '16rpx' }
const productSearchBtn = computed((): any => ({ width: '72rpx', height: '72rpx', borderRadius: '16rpx', backgroundColor: brand.primary, alignItems: 'center', justifyContent: 'center', marginLeft: '12rpx', flexShrink: 0 }))
const productPickerScroll = { maxHeight: '560rpx' }
const productEmptyWrap = { alignItems: 'center', paddingTop: '48rpx', paddingBottom: '48rpx' }
const productEmptyText = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
const productResultRow = computed((): any => ({ flexDirection: 'row', alignItems: 'center', paddingTop: '14rpx', paddingBottom: '14rpx', borderBottomWidth: '1rpx', borderBottomStyle: 'solid', borderBottomColor: n.value.border }))
const productResultImg = { width: '88rpx', height: '88rpx', borderRadius: '12rpx', flexShrink: 0 }
const productResultImgPlaceholder = computed((): any => ({ width: '88rpx', height: '88rpx', borderRadius: '12rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', flexShrink: 0 }))
const productResultInfo = { flex: 1, marginLeft: '16rpx', marginRight: '12rpx' }
const productResultTitle = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, lines: 1 }))
const productResultBrand = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textSecondary, marginTop: '4rpx', lines: 1 }))
const productResultCheck = computed((): any => ({ width: '44rpx', height: '44rpx', borderRadius: '22rpx', backgroundColor: brand[500] as string, alignItems: 'center', justifyContent: 'center', flexShrink: 0 }))
const wardrobeLinkRow = computed((): any => ({ flexDirection: 'row', alignItems: 'center', minHeight: '88rpx', marginTop: '12rpx', paddingLeft: '24rpx', paddingRight: '24rpx', borderRadius: '16rpx', backgroundColor: n.value.inputFill }))
const wardrobeLinkCopy = { flex: 1 }
const wardrobeLinkTitle = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text }))
const wardrobeLinkDesc = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))
const wardrobeTagsWrap = { flexDirection: 'row', flexWrap: 'wrap' as string, marginTop: '12rpx' }
const wardrobeTag = computed((): any => ({ flexDirection: 'row', alignItems: 'center', height: '48rpx', paddingLeft: '16rpx', paddingRight: '8rpx', borderRadius: '24rpx', backgroundColor: n.value.surfacePink, marginRight: '8rpx', marginBottom: '8rpx' }))
const wardrobeTagText = computed((): any => ({ fontSize: fontSize.xs, color: brand.primary }))
const wardrobeTagRemove = { width: '36rpx', height: '36rpx', alignItems: 'center', justifyContent: 'center', marginLeft: '4rpx' }
const wardrobePickerScroll = { maxHeight: '560rpx' }
const wardrobePickerGrid = { flexDirection: 'column' as string }
function wardrobePickerItem(id: string): any { return { flexDirection: 'row', alignItems: 'center', minHeight: '96rpx', borderBottomWidth: '1rpx', borderBottomStyle: 'solid', borderBottomColor: n.value.border, opacity: tempWardrobeIds.value.indexOf(id) >= 0 ? 1 : 0.86 } }
const wardrobePickerImage = { width: '72rpx', height: '72rpx', borderRadius: '10rpx', flexShrink: 0 }
const wardrobePickerPlaceholder = computed((): any => ({ width: '72rpx', height: '72rpx', borderRadius: '10rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', flexShrink: 0 }))
const wardrobePickerCopy = { flex: 1, marginLeft: '14rpx', marginRight: '12rpx' }
const wardrobePickerName = computed((): any => ({ fontSize: fontSize.sm, color: n.value.text, lines: 1 }))
const wardrobePickerMeta = computed((): any => ({ fontSize: fontSize['2xs'], color: n.value.textTertiary, marginTop: '4rpx' }))
</script>
