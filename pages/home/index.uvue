<template>
  <view style="height:100vh;position:relative">
    <MainLayout :scrollable="false" navbar-content-height="288rpx">
    <template #navbar>
      <view :style="navbarStyle">
        <view :style="statusBarPad" />
        <!-- Layer 1: Brand + Capsule -->
        <view class="nav-canvas" :style="layer1">
          <text :style="brandText">三坑绮橱</text>
          <view :style="navActions">
            <view :style="noticeButton" @tap="openNotifications">
              <AppIcon name="notification" :size="38" />
              <view v-if="notices.unreadCount > 0" :style="noticeDot" />
            </view>
            <view :style="capsuleSpacer" />
          </view>
        </view>
        <view :style="wordmarkSearchSpacer" />
        <!-- Layer 2: Search -->
        <view class="nav-canvas" :style="layer2Wrap">
          <view :style="searchBox" @tap="onSearch">
            <AppIcon name="search" :size="36" />
            <text :style="searchPlaceholder">搜索商品、品牌、穿搭</text>
          </view>
        </view>
        <view :style="searchTabsSpacer" />
        <!-- Layer 3: Channels -->
        <V2HorizontalTabs :items="channels" :active="store.currentChannel" @change="onChannelTap" />
      </view>
    </template>

    <template #default>
      <AppLoading v-if="store.loading" />

      <view v-else-if="store.state === 'error'" :style="errorWrap">
        <text :style="errorTitle">加载失败</text>
        <text :style="errorMsg">{{ store.errorMessage }}</text>
        <view :style="retryBtn" @tap="onRetry">
          <text :style="retryBtnText">点击重试</text>
        </view>
      </view>

      <!-- #ifdef MP-WEIXIN -->
      <scroll-view v-else scroll-y :style="listViewStyle" @scrolltolower="onLoadMore">
      <!-- #endif -->
      <!-- #ifndef MP-WEIXIN -->
      <list-view v-else scroll-y :style="listViewStyle" @scrolltolower="onLoadMore">
      <!-- #endif -->
        <!-- Secondary category filter: scrolls away with content -->
        <!-- #ifdef MP-WEIXIN -->
        <view>
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        <list-item :type="'categoryFilters'">
        <!-- #endif -->
          <view :style="categoryFilterWrap">
            <V2FilterChips :items="categories" :active="store.currentCategory" :edge-inset="true" @change="onCategoryTap" />
          </view>
        <!-- #ifdef MP-WEIXIN -->
        </view>
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        </list-item>
        <!-- #endif -->

        <!-- Empty channel -->
        <!-- #ifdef MP-WEIXIN -->
        <view v-if="store.isEmpty">
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        <list-item v-if="store.isEmpty" :type="'empty'">
        <!-- #endif -->
          <view :style="emptyWrap">
            <text :style="emptyTitle">暂无内容</text>
            <text :style="emptyMsg">切换其他频道看看</text>
          </view>
        <!-- #ifdef MP-WEIXIN -->
        </view>
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        </list-item>
        <!-- #endif -->

        <!-- Feed rows -->
        <!-- #ifdef MP-WEIXIN -->
        <view v-for="row in store.feedRows" :key="row.id">
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        <list-item v-for="row in store.feedRows" :key="row.id" :type="row.rowType">
        <!-- #endif -->
          <!-- Product pair -->
          <view v-if="row.rowType === 'pair'" class="feed-pair-row" :style="pairRow">
            <view v-if="row.left !== null" :style="productShellLeft">
              <V2ProductCard :image="row.left!.coverUrl" :brand-name="row.left!.brandName" :title="row.left!.title" :price-text="formatPrice(row.left!.price)" :original-price-text="row.left!.originalPrice > row.left!.price ? formatPrice(row.left!.originalPrice) : ''" :badge="row.left!.badgeText" :deadline-text="formatDeadline(row.left!.eventEndAt)" @click="onTap(row.left!)" />
            </view>
            <view v-if="row.right !== null" :style="productShellRight">
              <V2ProductCard :image="row.right!.coverUrl" :brand-name="row.right!.brandName" :title="row.right!.title" :price-text="formatPrice(row.right!.price)" :original-price-text="row.right!.originalPrice > row.right!.price ? formatPrice(row.right!.originalPrice) : ''" :badge="row.right!.badgeText" :deadline-text="formatDeadline(row.right!.eventEndAt)" @click="onTap(row.right!)" />
            </view>
            <!-- Filler when one side is null -->
            <view v-if="row.right === null" :style="cardFiller" />
          </view>

          <!-- ReleaseEvent single -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType === 'release_event'" class="feed-single-card" :style="eventCard" @tap="onTap(row.single!)">
            <view :style="imgWrap169">
              <AppImage :src="row.single!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
              <view :style="eventOverlay">
                <view :style="eventTagRow">
                  <view :style="eventTagBg">
                    <text :style="eventTagTxt">{{ row.single!.badgeText }}</text>
                  </view>
                  <text :style="eventTimeTxt">{{ formatRelativeTime(row.single!.eventStartAt) }}</text>
                </view>
                <text :style="eventTitle">{{ row.single!.title }}</text>
                <text :style="eventBrand">{{ row.single!.brandName }}</text>
              </view>
            </view>
          </view>

          <!-- Outfit single 4:5 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType === 'outfit'" class="feed-single-card" :style="outfitCard" @tap="onTap(row.single!)">
            <view :style="imgWrap45">
              <AppImage :src="row.single!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
              <view :style="outfitInfoOverlay">
                <text :style="outfitTitle">{{ row.single!.title }}</text>
                <text :style="outfitSub">{{ row.single!.subtitle }}</text>
              </view>
            </view>
          </view>

          <!-- Brand post / other -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType !== 'release_event' && row.single!.feedType !== 'outfit' && row.single!.feedType !== 'product'" class="feed-single-card" :style="postCard" @tap="onTap(row.single!)">
            <view :style="imgWrap169">
              <AppImage :src="row.single!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            </view>
            <view :style="postInfo">
              <view :style="postTopRow">
                <view :style="postTagBg">
                  <text :style="postTagTxt">{{ row.single!.badgeText !== '' ? row.single!.badgeText : feedLabel(row.single!.feedType) }}</text>
                </view>
                <text :style="postSource">{{ row.single!.sourceLabel }}</text>
              </view>
              <text :style="postTitle">{{ row.single!.title }}</text>
              <text :style="postBrand">{{ row.single!.brandName }}</text>
            </view>
          </view>
        <!-- #ifdef MP-WEIXIN -->
        </view>
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        </list-item>
        <!-- #endif -->

        <!-- Footer -->
        <!-- #ifdef MP-WEIXIN -->
        <view v-if="showFeedFooter">
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        <list-item v-if="showFeedFooter" :type="'footer'">
        <!-- #endif -->
          <view :style="footerWrap">
            <text :style="footerTxt">{{ store.isLoadingMore ? '加载中...' : (store.hasMore ? '上拉加载更多' : '已显示全部') }}</text>
          </view>
        <!-- #ifdef MP-WEIXIN -->
        </view>
        <!-- #endif -->
        <!-- #ifndef MP-WEIXIN -->
        </list-item>
        <!-- #endif -->
      <!-- #ifdef MP-WEIXIN -->
      </scroll-view>
      <!-- #endif -->
      <!-- #ifndef MP-WEIXIN -->
      </list-view>
      <!-- #endif -->
    </template>
  </MainLayout>
  <!-- #ifdef APP -->
  <AppBottomNav active="home" />
  <!-- #endif -->
</view>
</template>

<script setup lang="uts">
import { useHomeFeedStore, CHANNELS, CATEGORY_FILTERS, formatPrice, formatRelativeTime, formatDeadline } from '@/stores/home-feed-store'
import { useNotificationCenterStore } from '@/stores/notification-center-store'
import { FeedItem, FEED_OUTFIT } from '@/domain/content/feed-item'
import { getFeedTypeLabel } from '@/presentation/content/feed-presenter'
import { brand, baseColors } from '@/theme/tokens/colors'
import { spacing } from '@/theme/tokens/spacing'
import { radius } from '@/theme/tokens/radius'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexCenter, flexFill } from '@/theme/layout/flex'
import { zIndex } from '@/theme/tokens/z-index'
import { n, syncTabBarChrome, initPageTheme } from '@/theme/use-theme'
import { getStatusBarHeight, getWindowHeight } from '@/utils/window-info'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { CARD_PADDING, CARD_RADIUS, BADGE_PADDING_X, BADGE_PADDING_Y, BADGE_FONT_SIZE, SEARCH_HEIGHT, SEARCH_RADIUS, PAGE_BOTTOM_SAFE_SPACER, PRODUCT_CARD_WIDTH } from '@/theme/tokens/responsive'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2HorizontalTabs from '@/components/v2/V2HorizontalTabs.uvue'
import V2FilterChips from '@/components/v2/V2FilterChips.uvue'
import V2ProductCard from '@/components/v2/V2ProductCard.uvue'
// #ifdef APP
import AppBottomNav from '@/components/layout/AppBottomNav.uvue'
// #endif

const store = useHomeFeedStore()
const notices = useNotificationCenterStore()
const channels = CHANNELS
const categories = CATEGORY_FILTERS

const statusBarH = getStatusBarHeight()
const homeNavbarPx = uni.upx2px(288)
let appTabBarPx = 0
// #ifdef APP
appTabBarPx = uni.upx2px(110)
// #endif
const homeViewportPx = ref(Math.max(getWindowHeight() - statusBarH - homeNavbarPx - appTabBarPx, 240))
function refreshViewport() { homeViewportPx.value = Math.max(getWindowHeight() - statusBarH - homeNavbarPx - appTabBarPx, 240) }

// Capsule spacer
let capsuleW = 0
// #ifdef MP-WEIXIN
try {
  const cap = uni.getMenuButtonBoundingClientRect()
  capsuleW = cap.width + 16
} catch (e) {
  capsuleW = 0
}
// #endif

function feedLabel(ft: string): string { return getFeedTypeLabel(ft) }
function onSearch() { uni.navigateTo({ url: '/pages/search/index' }) }
function openNotifications() { uni.navigateTo({ url: '/pages/notification/index' }) }
function onChannelTap(ch: string) { store.setChannel(ch) }
function onCategoryTap(category: string) { store.setCategory(category) }
function onTap(item: FeedItem) {
  if (item.feedType === FEED_OUTFIT) {
    openPrimaryTab('/pages/community/index')
    return
  }
  if (item.feedType === 'product' || item.feedType === 'release_event') {
    uni.navigateTo({ url: `/pages/product/detail?id=${item.entityId}` })
    return
  }
  uni.setStorageSync('pending_search_keyword', item.brandName !== '' ? item.brandName : item.title)
  uni.navigateTo({ url: '/pages/search/index' })
}
function onLoadMore() { store.loadMore() }
function onRetry() { store.retry() }
// 筛选后内容不足一屏时不展示“上拉加载更多/已显示全部”，避免制造虚假操作预期。
const showFeedFooter = computed((): boolean => store.isLoadingMore || store.displayItems.length >= 8)
onMounted(() => { store.loadFirstPage() })
onReady(() => { refreshViewport() })
onLoad(() => { initPageTheme() })
onShow(() => { notices.reload(); syncTabBarChrome() })

// --- Spacing tokens (no gap) ---
const CARD_PAIR_GAP = '20rpx'  // between two product cards
const CARD_V_GAP = '24rpx'     // vertical gap between card rows

// --- Navbar ---
const navbarStyle = computed((): any => ({
  position: 'fixed', top: '0', left: '0', right: '0',
  zIndex: zIndex.navbar,
  backgroundColor: n.value.bg,
}))
const statusBarPad = computed((): any => ({ height: `${statusBarH}px` }))
const layer1 = {
  height: '96rpx', ...flexRow, alignItems: 'center',
  justifyContent: 'space-between',
}
const brandText = computed((): any => ({
  fontSize: fontSize.lg, fontWeight: fontWeight.bold, color: brand[500],
}))
const capsuleSpacer = { width: `${capsuleW}px` }
const navActions = { ...flexRow, alignItems: 'center' }
const noticeButton = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', position: 'relative', marginRight: capsuleW > 0 ? '12rpx' : '0' }))
const noticeDot = { position: 'absolute', top: '8rpx', right: '8rpx', width: '12rpx', height: '12rpx', borderRadius: '6rpx', backgroundColor: brand[600] }

const wordmarkSearchSpacer = { height: '16rpx' }
const layer2Wrap = {}
const searchBox = computed((): any => ({
  height: SEARCH_HEIGHT, borderRadius: SEARCH_RADIUS,
  backgroundColor: n.value.bgTertiary,
  ...flexRow, alignItems: 'center',
  paddingLeft: '28rpx', paddingRight: '24rpx',
}))
const searchPlaceholder = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary, marginLeft: '14rpx' }))
const searchTabsSpacer = { height: '12rpx' }

// --- Styles ---
// 真机 list-view 必须拿到明确高度；height:0 + flex 在微信 VDOM 下会失效。
const listViewStyle = computed((): any => ({ width: '750rpx', height: `${homeViewportPx.value}px`, minHeight: `${homeViewportPx.value}px` }))
const categoryFilterWrap = computed((): any => ({ paddingTop: '6rpx', paddingBottom: '2rpx', backgroundColor: n.value.bg }))

// Error
const errorWrap = { ...flexFill, alignItems: 'center', justifyContent: 'center', padding: spacing[8] }
const errorTitle = computed((): any => ({ fontSize: fontSize.lg, fontWeight: fontWeight.semibold, color: n.value.text }))
const errorMsg = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, textAlign: 'center', marginTop: spacing[3] }))
const retryBtn = { paddingHorizontal: spacing[5], paddingVertical: spacing[2], borderRadius: radius.full, backgroundColor: brand[500], marginTop: spacing[2] }
const retryBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }

// Empty
const emptyWrap = { alignItems: 'center', justifyContent: 'center', padding: spacing[8] }
const emptyTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.textSecondary }))
const emptyMsg = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary, marginTop: spacing[2] }))

// Product card pair — no gap, use margin on left card
const pairRow = { ...flexRow, marginTop: CARD_V_GAP }
const productShellLeft = { width: PRODUCT_CARD_WIDTH, flexShrink: 0, marginRight: CARD_PAIR_GAP }
const productShellRight = { width: PRODUCT_CARD_WIDTH, flexShrink: 0 }
const cardFiller = { width: PRODUCT_CARD_WIDTH, flexShrink: 0 }

const imgWrap169 = { width: '670rpx', height: '360rpx', position: 'relative' as string, overflow: 'hidden' }
const imgWrap45 = { width: '670rpx', height: '760rpx', position: 'relative' as string, overflow: 'hidden' }

// Event card
const eventCard = { marginTop: CARD_V_GAP, borderRadius: CARD_RADIUS, overflow: 'hidden' }
const eventOverlay = { position: 'absolute' as string, bottom: '0', left: '0', right: '0', padding: CARD_PADDING, paddingTop: '60rpx', backgroundColor: 'rgba(0,0,0,0.4)' }
const eventTagRow = { ...flexRow, alignItems: 'center', marginBottom: spacing[1] }
const eventTagBg = { paddingRight: spacing[2], minHeight: '36rpx', alignItems: 'center', justifyContent: 'center', marginRight: spacing[2] }
const eventTagTxt = { fontSize: BADGE_FONT_SIZE, fontWeight: fontWeight.semibold, color: baseColors.white }
const eventTimeTxt = { fontSize: fontSize.xs, color: 'rgba(255,255,255,0.8)' }
const eventTitle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white, lines: 2, textOverflow: 'ellipsis' }
const eventBrand = { fontSize: fontSize.sm, color: 'rgba(255,255,255,0.7)', marginTop: '4rpx' }

// Outfit card
const outfitCard = { marginTop: CARD_V_GAP, borderRadius: CARD_RADIUS, overflow: 'hidden' }
const outfitInfoOverlay = { position: 'absolute' as string, bottom: '0', left: '0', right: '0', padding: CARD_PADDING, paddingTop: '80rpx', backgroundColor: 'rgba(0,0,0,0.3)' }
const outfitTitle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
const outfitSub = { fontSize: fontSize.xs, color: 'rgba(255,255,255,0.8)', marginTop: '4rpx' }

// Post card
const postCard = { marginTop: CARD_V_GAP, borderRadius: CARD_RADIUS, overflow: 'hidden' }
const postInfo = { padding: CARD_PADDING }
const postTopRow = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', marginBottom: '4rpx' }
const postTagBg = computed((): any => ({ paddingHorizontal: BADGE_PADDING_X, paddingVertical: BADGE_PADDING_Y, borderRadius: radius.full, backgroundColor: n.value.bgSecondary }))
const postTagTxt = { fontSize: BADGE_FONT_SIZE, fontWeight: fontWeight.medium, color: brand[500] }
const postSource = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const postTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, lines: 2, textOverflow: 'ellipsis', marginTop: spacing[1] }))
const postBrand = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, marginTop: spacing[1] }))

// Footer
const footerWrap = { ...flexCenter, paddingTop: '32rpx', paddingBottom: PAGE_BOTTOM_SAFE_SPACER }
const footerTxt = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
</script>

<style>
.nav-canvas,
.feed-pair-row {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.feed-single-card {
  margin-left: 40rpx;
  margin-right: 40rpx;
}
</style>
