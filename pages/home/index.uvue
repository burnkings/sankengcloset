<template>
  <MainLayout>
    <template #navbar>
      <AppNavbar :show-back="false">
        <template #default>
          <view :style="searchBoxStyle" @tap="onSearch">
            <text :style="searchPlaceholder">搜索商品、品牌</text>
          </view>
        </template>
        <template #right>
          <text :style="msgIcon" @tap="onNotify">消息</text>
        </template>
      </AppNavbar>
    </template>

    <template #default>
      <AppLoading v-if="store.loading" />

      <view v-else-if="store.state === 'error'" :style="errorWrap">
        <text :style="errorTitle">加载失败</text>
        <text :style="errorMsg">{{ store.errorMessage }}</text>
        <view :style="retryBtn" @tap="onRetry">
          <text :style="retryBtnText">点击重试</text>
        </view>
      </view>

      <list-view v-else :style="listViewStyle" @scrolltolower="onLoadMore">
        <!-- 频道栏 -->
        <list-item :type="'channelBar'">
          <scroll-view scroll-x :style="channelScrollStyle">
            <view :style="channelRowStyle">
              <view v-for="ch in channels" :key="ch" :style="channelChip(ch)" @tap="onChannelTap(ch)">
                <text :style="channelText(ch)">{{ ch }}</text>
              </view>
            </view>
          </scroll-view>
        </list-item>

        <!-- 空频道 -->
        <list-item v-if="store.isEmpty" :type="'empty'">
          <view :style="emptyWrap">
            <text :style="emptyTitle">暂无内容</text>
            <text :style="emptyMsg">切换其他频道看看</text>
          </view>
        </list-item>

        <!-- Feed 行 -->
        <list-item v-for="row in store.feedRows" :key="row.id" :type="row.rowType">
          <!-- 双列商品卡 -->
          <view v-if="row.rowType === 'pair'" :style="pairRow">
            <view v-if="row.left !== null" :style="productCard" @tap="onTap(row.left!)">
              <view :style="imgWrap34">
                <AppImage :src="row.left!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                <view v-if="row.left!.badgeText !== ''" :style="badgePos(row.left!.badgeText)">
                  <text :style="badgeTxt">{{ row.left!.badgeText }}</text>
                </view>
              </view>
              <view :style="cardInfo">
                <text :style="cardBrand">{{ row.left!.brandName }}</text>
                <text :style="cardTitle">{{ row.left!.title }}</text>
                <view :style="priceRow">
                  <text :style="priceTxt">{{ formatPrice(row.left!.price) }}</text>
                  <text v-if="row.left!.originalPrice > row.left!.price" :style="origPrice">{{ formatPrice(row.left!.originalPrice) }}</text>
                </view>
              </view>
            </view>
            <view v-if="row.right !== null" :style="productCard" @tap="onTap(row.right!)">
              <view :style="imgWrap34">
                <AppImage :src="row.right!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                <view v-if="row.right!.badgeText !== ''" :style="badgePos(row.right!.badgeText)">
                  <text :style="badgeTxt">{{ row.right!.badgeText }}</text>
                </view>
              </view>
              <view :style="cardInfo">
                <text :style="cardBrand">{{ row.right!.brandName }}</text>
                <text :style="cardTitle">{{ row.right!.title }}</text>
                <view :style="priceRow">
                  <text :style="priceTxt">{{ formatPrice(row.right!.price) }}</text>
                  <text v-if="row.right!.originalPrice > row.right!.price" :style="origPrice">{{ formatPrice(row.right!.originalPrice) }}</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 单列: 发售事件卡 16:9 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType === 'release_event'" :style="eventCard" @tap="onTap(row.single!)">
            <view :style="imgWrap169">
              <AppImage :src="row.single!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
              <view :style="eventOverlay">
                <view :style="eventTagRow">
                  <view :style="eventTagBg(row.single!.badgeText)">
                    <text :style="eventTagTxt">{{ row.single!.badgeText }}</text>
                  </view>
                  <text :style="eventTimeTxt">{{ formatRelativeTime(row.single!.eventStartAt) }}</text>
                </view>
                <text :style="eventTitle">{{ row.single!.title }}</text>
                <text :style="eventBrand">{{ row.single!.brandName }}</text>
              </view>
            </view>
          </view>

          <!-- 单列: 穿搭卡 4:5 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType === 'outfit'" :style="outfitCard" @tap="onTap(row.single!)">
            <view :style="imgWrap45">
              <AppImage :src="row.single!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
              <view :style="outfitOverlay">
                <text :style="outfitTitle">{{ row.single!.title }}</text>
                <text :style="outfitSub">{{ row.single!.subtitle }}</text>
              </view>
            </view>
          </view>

          <!-- 单列: 品牌动态/其他 16:9 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType !== 'release_event' && row.single!.feedType !== 'outfit' && row.single!.feedType !== 'product'" :style="postCard" @tap="onTap(row.single!)">
            <view :style="imgWrap169">
              <AppImage :src="row.single!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
            </view>
            <view :style="postInfo">
              <view :style="postTopRow">
                <view :style="postTagBg">
                  <text :style="postTagTxt">{{ row.single!.badgeText !== '' ? row.single!.badgeText : feedLabel(row.single!.feedType) }}</text>
                </view>
                <text :style="postSource">{{ row.single!.sourceLabel }}</text>
              </view>
              <text :style="postTitle">{{ row.single!.title }}</text>
              <text :style="postBrand">{{ row.single!.brandName }}</text>
            </view>
          </view>
        </list-item>

        <!-- 底部 -->
        <list-item :type="'footer'">
          <view :style="footerWrap">
            <text :style="footerTxt">{{ store.isLoadingMore ? '加载中...' : (store.hasMore ? '上拉加载更多' : '已显示全部') }}</text>
          </view>
        </list-item>
      </list-view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { useHomeFeedStore, CHANNELS, formatPrice, formatRelativeTime } from '@/stores/home-feed-store'
import { FeedItem, FEED_PRODUCT, FEED_RELEASE_EVENT, FEED_OUTFIT, FEED_BRAND_POST } from '@/domain/content/feed-item'
import { getBadgeColor, getCategoryPlaceholderBg, getFeedTypeLabel } from '@/presentation/content/feed-presenter'
import { brand, accent, neutralLight, baseColors, jkColors, lolitaColors, hanfuColors } from '@/theme/tokens/colors'
import { spacing, semanticSpacing } from '@/theme/tokens/spacing'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { shadow } from '@/theme/tokens/shadow'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexRowBetween, flexCenter, flexFill } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import AppImage from '@/components/base/AppImage.uvue'

const store = useHomeFeedStore()
const channels = CHANNELS

function feedLabel(ft: string): string { return getFeedTypeLabel(ft) }
function onSearch() {}
function onNotify() {}
function onChannelTap(ch: string) { store.setChannel(ch) }
function onTap(item: FeedItem) {}
function onLoadMore() { store.loadMore() }
function onRetry() { store.retry() }
onMounted(() => { store.loadFirstPage() })

// --- Styles ---
const listViewStyle = { ...flexFill }
const searchBoxStyle = {
  flex: 1, height: '64rpx', borderRadius: radius.full,
  backgroundColor: neutralLight.bgTertiary, display: 'flex',
  alignItems: 'center', paddingHorizontal: spacing[3],
}
const searchPlaceholder = { fontSize: fontSize.sm, color: neutralLight.textTertiary }
const msgIcon = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, fontWeight: fontWeight.medium }))

// Error
const errorWrap = { ...flexFill, alignItems: 'center', justifyContent: 'center', padding: spacing[8], gap: spacing[3] }
const errorTitle = computed((): any => ({ fontSize: fontSize.lg, fontWeight: fontWeight.semibold, color: n.value.text }))
const errorMsg = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary, textAlign: 'center' }))
const retryBtn = { paddingHorizontal: spacing[5], paddingVertical: spacing[2], borderRadius: radius.full, backgroundColor: brand[500], marginTop: spacing[2] }
const retryBtnText = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }

// Empty
const emptyWrap = { alignItems: 'center', justifyContent: 'center', padding: spacing[8], gap: spacing[2] }
const emptyTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.textSecondary }))
const emptyMsg = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))

// Channel
const channelScrollStyle = { backgroundColor: baseColors.white, borderBottomWidth: '1rpx', borderBottomStyle: 'solid' as string, borderBottomColor: neutralLight.divider }
const channelRowStyle = { ...flexRow, paddingHorizontal: semanticSpacing.pageHorizontal, paddingVertical: spacing[2], gap: spacing[2] }
function channelChip(ch: string) { return { paddingHorizontal: spacing[3], paddingVertical: spacing[1], borderRadius: radius.full, backgroundColor: ch === store.currentChannel ? brand[500] : neutralLight.bgTertiary, flexShrink: 0 } }
function channelText(ch: string) { return { fontSize: fontSize.sm, fontWeight: ch === store.currentChannel ? fontWeight.semibold : fontWeight.medium, color: ch === store.currentChannel ? baseColors.white : neutralLight.textSecondary } }

// Product card
const pairRow = { ...flexRow, gap: spacing[2], paddingHorizontal: semanticSpacing.pageHorizontal, marginTop: spacing[3] }
const productCard = computed((): any => ({ flex: 1, borderRadius: semanticRadius.card, backgroundColor: n.value.surface, boxShadow: shadow.sm, overflow: 'hidden' }))
const imgWrap34 = { width: '100%', paddingBottom: '133.33%', position: 'relative' as string, overflow: 'hidden' }
const imgWrap169 = { width: '100%', paddingBottom: '56.25%', position: 'relative' as string, overflow: 'hidden' }
const imgWrap45 = { width: '100%', paddingBottom: '125%', position: 'relative' as string, overflow: 'hidden' }
function badgePos(badge: string) { return { position: 'absolute' as string, top: '0', right: '0', paddingHorizontal: spacing[2], paddingVertical: '4rpx', borderBottomLeftRadius: radius.md, backgroundColor: getBadgeColor(badge), zIndex: 1 } }
const badgeTxt = { fontSize: fontSize.xs, fontWeight: fontWeight.bold, color: baseColors.white }
const cardInfo = { padding: spacing[2], gap: '2rpx' }
const cardBrand = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const cardTitle = computed((): any => ({ fontSize: fontSize.sm, fontWeight: fontWeight.semibold, color: n.value.text, lines: 2, textOverflow: 'ellipsis' }))
const priceRow = { ...flexRow, alignItems: 'center', gap: spacing[1], marginTop: '4rpx' }
const priceTxt = { fontSize: fontSize.base, fontWeight: fontWeight.bold, color: brand[600] }
const origPrice = { fontSize: fontSize.xs, color: neutralLight.textTertiary, textDecoration: 'line-through' }

// Event card
const eventCard = { marginHorizontal: semanticSpacing.pageHorizontal, marginTop: spacing[3], borderRadius: semanticRadius.card, overflow: 'hidden', boxShadow: shadow.card }
const eventOverlay = { position: 'absolute' as string, bottom: '0', left: '0', right: '0', padding: spacing[3], paddingTop: '60rpx', backgroundColor: 'rgba(0,0,0,0.4)' }
const eventTagRow = { ...flexRow, alignItems: 'center', gap: spacing[2], marginBottom: spacing[1] }
function eventTagBg(badge: string) { return { paddingHorizontal: spacing[2], paddingVertical: '4rpx', borderRadius: radius.full, backgroundColor: 'rgba(255,255,255,0.25)' } }
const eventTagTxt = { fontSize: fontSize.xs, fontWeight: fontWeight.semibold, color: baseColors.white }
const eventTimeTxt = { fontSize: fontSize.xs, color: 'rgba(255,255,255,0.8)' }
const eventTitle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white, lines: 2, textOverflow: 'ellipsis' }
const eventBrand = { fontSize: fontSize.sm, color: 'rgba(255,255,255,0.7)', marginTop: '4rpx' }

// Outfit card
const outfitCard = { marginHorizontal: semanticSpacing.pageHorizontal, marginTop: spacing[3], borderRadius: semanticRadius.card, overflow: 'hidden', boxShadow: shadow.card }
const outfitOverlay = { position: 'absolute' as string, bottom: '0', left: '0', right: '0', padding: spacing[3], paddingTop: '80rpx', backgroundColor: 'rgba(0,0,0,0.35)' }
const outfitTitle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
const outfitSub = { fontSize: fontSize.xs, color: 'rgba(255,255,255,0.8)', marginTop: '4rpx' }

// Post card
const postCard = { marginHorizontal: semanticSpacing.pageHorizontal, marginTop: spacing[3], borderRadius: semanticRadius.card, backgroundColor: 'transparent', overflow: 'hidden', boxShadow: shadow.sm }
const postInfo = { padding: spacing[3], gap: spacing[1] }
const postTopRow = { ...flexRow, alignItems: 'center', justifyContent: 'space-between', marginBottom: '4rpx' }
const postTagBg = { paddingHorizontal: spacing[2], paddingVertical: '4rpx', borderRadius: radius.full, backgroundColor: brand[50] }
const postTagTxt = { fontSize: fontSize.xs, fontWeight: fontWeight.medium, color: brand[500] }
const postSource = computed((): any => ({ fontSize: fontSize.xs, color: n.value.textTertiary }))
const postTitle = computed((): any => ({ fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, lines: 2, textOverflow: 'ellipsis' }))
const postBrand = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textSecondary }))

// Footer
const footerWrap = { ...flexCenter, padding: spacing[4] }
const footerTxt = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
</script>
