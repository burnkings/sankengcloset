<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <!-- 图片预取层：1px 不可见，绝对定位不参与布局。
         放在两套渲染分支（MP-WEIXIN scroll-view / 其他端 list-view）**之外**，两端都生效。
         两个实例分别对应「双列卡 500 档」与「单卡大图 800 档」——档位必须与列表里的
         :list-width 一一对应，否则预取了 A 档、列表用 B 档会白下载。 -->
    <ImagePreloader :urls="preloadCardUrls" :list-width="LIST_WIDTH_CARD" />
    <ImagePreloader :urls="preloadFullUrls" :list-width="LIST_WIDTH_FULL" />
    <MainLayout :scrollable="false" navbar-content-height="252rpx">
    <template #navbar>
      <view :style="navbarStyle">
        <view :style="statusBarPad" />
        <!-- Layer 1: Brand + Capsule -->
        <view :style="layer1">
          <text :style="brandText">三坑绮橱</text>
          <view :style="navActions">
            <!-- 红点必须放在**未圆角**的外层包裹里：
                 微信端 border-radius 会裁切子节点，红点贴在 64rpx 圆形的右上角时会被圆角削掉，
                 看起来就像"被背景圆圈遮住"。包裹层只负责定位，圆形留给内层按钮。 -->
            <view :style="noticeButtonWrap">
              <view :style="noticeButton" @tap="openNotifications">
                <AppIcon name="notification" :size="38" />
              </view>
              <view v-if="notices.unreadCount > 0" :style="noticeDot" />
            </view>
            <view :style="capsuleSpacer" />
          </view>
        </view>
        <view :style="wordmarkSearchSpacer" />
        <!-- Layer 2: Search -->
        <view :style="layer2Wrap">
          <view :style="searchBox" @tap="onSearch">
            <AppIcon name="search" :size="36" />
            <text :style="searchPlaceholder">搜索商品或品牌</text>
          </view>
        </view>
        <view :style="searchTabsSpacer" />
        <!-- Layer 3: Channels -->
        <ChannelTabs :items="channels" :active="store.currentChannel" @change="onChannelTap" />
      </view>
    </template>

    <template #default>
      <FeedSkeleton v-if="store.loading || store.state === 'idle'" />

      <PageState v-else-if="store.state === 'error'" icon="info" title="加载失败" :message="store.errorMessage" action-text="点击重试" @action="onRetry" />

      <!-- #ifdef MP-WEIXIN -->
      <scroll-view v-else scroll-y refresher-enabled :refresher-triggered="isRefreshing" @refresherrefresh="onRefresh" :style="listViewStyle" :scroll-top="scrollTop" @scroll="onPageScroll" @scrolltolower="onLoadMore">
        <view v-if="store.isEmpty" :style="emptyWrap">
          <PageState icon="info" title="暂无内容" message="切换其他频道看看" />
        </view>

          <view v-for="block in store.masonryBlocks" :key="blockKey(block)">
            <view v-if="block.type === 'columns'" :style="waterfallRow">
              <view :style="masonryColLeft">
                <FeedColumn :items="block.left" @open-item="onTap" @toggle-save="onToggleSave" />
              </view>
              <view :style="masonryColRight">
                <FeedColumn :items="block.right" @open-item="onTap" @toggle-save="onToggleSave" />
              </view>
            </view>
          <FeedBlock v-else :full="block.full" @open-item="onTap" @remind="onRemind" />
        </view>

        <view v-if="store.errorMessage !== ''" :style="loadErrorRow" @tap="onLoadMore"><text :style="loadErrorText">{{ store.errorMessage }} · 点击重试</text></view>
        <view v-if="showFeedFooter" :style="footerWrap">
          <text :style="footerTxt">{{ footerText }}</text>
        </view>
      </scroll-view>
      <!-- #endif -->

      <!-- #ifndef MP-WEIXIN -->
      <view v-else-if="store.isEmpty" :style="emptyWrap">
        <PageState icon="info" title="暂无内容" message="切换其他频道看看" />
      </view>

      <!-- 双列错落瀑布流：商品/穿搭归入左右两列（可变图片高度），发售/编辑专题全宽 -->
      <list-view v-else :style="listViewStyle" refresher-enabled :refresher-triggered="isRefreshing" @refresherrefresh="onRefresh" :scroll-top="scrollTop" @scroll="onPageScroll" @scrolltolower="onLoadMore">
        <list-item v-for="block in store.masonryBlocks" :key="blockKey(block)">
          <view v-if="block.type === 'columns'" :style="waterfallRow">
            <view :style="masonryColLeft">
              <FeedColumn :items="block.left" @open-item="onTap" @toggle-save="onToggleSave" />
            </view>
            <view :style="masonryColRight">
              <FeedColumn :items="block.right" @open-item="onTap" @toggle-save="onToggleSave" />
            </view>
          </view>
          <FeedBlock v-else :full="block.full" @open-item="onTap" @remind="onRemind" />
        </list-item>

        <list-item v-if="store.errorMessage !== ''"><view :style="loadErrorRow" @tap="onLoadMore"><text :style="loadErrorText">{{ store.errorMessage }} · 点击重试</text></view></list-item>
        <list-item v-if="showFeedFooter">
          <view :style="footerWrap"><text :style="footerTxt">{{ footerText }}</text></view>
        </list-item>
      </list-view>
      <!-- #endif -->
    </template>
  </MainLayout>
  <BackToTop :visible="showBackTop" @tap="backToTop" />
</view>
</template>

<script setup lang="uts">
import { nextTick } from 'vue'
import { useHomeFeedStore, CHANNELS, MasonryBlock } from '@/stores/home-feed-store'
import { useNotificationCenterStore } from '@/stores/notification-center-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { FeedItem, FEED_OUTFIT } from '@/domain/content/feed-item'
import { semantic } from '@/theme/tokens/colors'
import { fontSize, v3TextStyle } from '@/theme/tokens/typography'
import { flexRow, flexCenter } from '@/theme/layout/flex'
import { zIndex } from '@/theme/tokens/z-index'
import { n, initPageTheme } from '@/theme/use-theme'
import { getStatusBarHeight, getWindowHeight, upx2px } from '@/utils/window-info'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { SEARCH_HEIGHT_V3, SEARCH_RADIUS_V3, PAGE_BOTTOM_SAFE_SPACER, PRODUCT_CARD_WIDTH_V3, PAGE_GUTTER_V3, COLUMN_GAP_V3, CARD_VERTICAL_GAP_V3 } from '@/theme/tokens/responsive'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import BackToTop from '@/components/base/BackToTop.uvue'
import ChannelTabs from '@/components/v3/ChannelTabs.uvue'
import { openProductDetail } from '@/utils/content-navigation'
import FeedColumn from '@/components/v3/FeedColumn.uvue'
import FeedBlock from '@/components/v3/FeedBlock.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'
import ImagePreloader from '@/components/base/ImagePreloader.uvue'
import { LIST_WIDTH_CARD, LIST_WIDTH_FULL } from '@/utils/image-url'
import { isFeedFullWidthType } from '@/utils/feed-image-policy'

const pageHeight = getWindowHeight()
const store = useHomeFeedStore()
const notices = useNotificationCenterStore()
const library = useContentLibraryStore()
const channels = CHANNELS

// 返回顶部：lastScrollTop 仅回顶用，非响应式，避免滚动每帧触发重渲染
const scrollTop = ref(0)
let lastScrollTop = 0
const showBackTop = ref(false)
function onPageScroll(e: UniScrollEvent) {
  const top = e.detail.scrollTop
  lastScrollTop = top
  if ((top > 300) !== showBackTop.value) showBackTop.value = top > 300
}
function backToTop() {
  showBackTop.value = false
  scrollTop.value = lastScrollTop
  nextTick(() => { scrollTop.value = 0 })
}

const statusBarH = getStatusBarHeight()
const homeNavbarPx = upx2px(252)
const homeViewportPx = ref(Math.max(getWindowHeight() - statusBarH - homeNavbarPx, 240))
function refreshViewport() { homeViewportPx.value = Math.max(getWindowHeight() - statusBarH - homeNavbarPx, 240) }

// Capsule spacer
let capsuleW = 0
// #ifdef MP-WEIXIN
try {
  const cap = uni.getMenuButtonBoundingClientRect()
  capsuleW = cap.width + 16
} catch (e) {
  capsuleW = 0
}
// #endif

function blockKey(block: MasonryBlock): string {
  if (block.type == 'full') {
    const f = block.full
    return f != null ? `full-${f.id}` : 'full-empty'
  }
  if (block.left.length > 0) return `cols-${block.left[0].id}`
  if (block.right.length > 0) return `cols-${block.right[0].id}`
  return 'cols-empty'
}
function onSearch() { uni.navigateTo({ url: '/pages/search/index' }) }
function openNotifications() { uni.navigateTo({ url: '/pages/notification/index' }) }
function onChannelTap(ch: string) { store.setChannel(ch) }
function onTap(item: FeedItem) {
  if (item.feedType === FEED_OUTFIT) {
    openPrimaryTab('/pages/community/index')
    return
  }
  if (item.feedType === 'editorial') {
    uni.navigateTo({ url: `/pages/editorial/detail?title=${encodeURIComponent(item.title)}&category=${encodeURIComponent(item.category)}&image=${encodeURIComponent(item.coverUrl)}` })
    return
  }
  openProductDetail(item.entityId)
}
function onToggleSave(item: FeedItem) {
  // 同步翻转服务端 saved（乐观更新，刷新后以服务端权威值为准）
  store.toggleSave(item.id)
  library.toggleFavorite(item.entityId, item.title, '', item)
}
// Feed 发售事件 → 设置提醒（Release → Reminder 链路；点卡片主体仍进商品详情）
function onRemind(item: FeedItem) {
  if (item.entityId == '') return
  const type = 'RELEASE'
  const title = item.title
  const note = item.brandName !== '' ? `${item.brandName} · 来源于首页发售` : '来源于首页发售'
  const date = item.eventStartAt != '' && item.eventStartAt.length >= 10 ? item.eventStartAt.substring(0, 10) : ''
  const base = `/pages/reminder/edit?title=${encodeURIComponent(title)}&type=${type}&note=${encodeURIComponent(note)}`
  uni.navigateTo({ url: date != '' ? `${base}&date=${date}` : base })
}
function onLoadMore() { store.loadMore() }
function onRetry() { store.retry() }
const isRefreshing = ref(false)
async function onRefresh() {
  isRefreshing.value = true
  // 第二个参数 force=true：用户主动下拉刷新必须**真的发一次请求**，
  // 不能被 1h 新鲜缓存拦掉（否则「刷新结束」但价格/发售状态还是旧的）。
  try { await store.loadFirstPage(true, true) }
  finally { isRefreshing.value = false }
}
// Footer 文案：加载中 / 上拉加载更多 / 已显示全部
const footerText = computed((): string => {
  if (store.isLoadingMore) return '加载中...'
  return store.hasMore ? '上拉加载更多' : '已显示全部'
})
// 筛选后内容不足一屏时不展示 footer，避免制造虚假操作预期。
const showFeedFooter = computed((): boolean => store.isLoadingMore || store.displayItems.length >= 8)

// ====== 图片预取（2026-10-09）======
// 目标：避免「打开页面时图片才开始加载」。
// 做法：首屏渲染提交后，把**当前列表里靠后那批**的封面提前喂进微信/系统的图片缓存
//       （前几条反正立刻就在加载，重复预取无意义）。
// ⚠️ 档位必须与 FeedColumn / FeedBlock 里的 :list-width **一致**，否则「预取了 A 档、列表用 B 档」白下载。
// ⚠️ 必须用 nextTick 推迟到首帧提交之后 —— 否则预取会和首屏渲染抢主线程，反而更慢。
const PRELOAD_SKIP_FIRST = 6   // 前 6 条不预取（本来就在加载）
const PRELOAD_TAKE = 12        // 每次最多往后预取 12 条

/** 双列卡（500 档）待预取地址 */
const preloadCardUrls = ref<string[]>([])
/** 单卡大图（800 档）待预取地址 */
const preloadFullUrls = ref<string[]>([])

function runImagePreload() {
  const items = store.displayItems
  if (items.length <= PRELOAD_SKIP_FIRST) return
  const cardUrls: string[] = []
  const fullUrls: string[] = []
  for (let i = PRELOAD_SKIP_FIRST; i < items.length; i++) {
    const it = items[i]
    if (it.coverUrl == null || it.coverUrl === '') continue
    // ⚠️ 分类必须与**实际渲染**同源（isFeedFullWidthType 来自共享策略文件）。
    //    曾在这里手写 `outfit || release_event`，与 FeedColumn/FeedBlock 的真实分支相反
    //    ⇒ 预取 URL 与列表请求 URL 对不上，预取白做。
    if (isFeedFullWidthType(it.feedType)) {
      if (fullUrls.length < PRELOAD_TAKE) fullUrls.push(it.coverUrl)
    } else {
      if (cardUrls.length < PRELOAD_TAKE) cardUrls.push(it.coverUrl)
    }
    if (cardUrls.length >= PRELOAD_TAKE && fullUrls.length >= PRELOAD_TAKE) break
  }
  // 赋值合并历史（不去重也行：ImagePreloader 内部有 seen 幂等）
  preloadCardUrls.value = cardUrls
  preloadFullUrls.value = fullUrls
}

// 列表内容变化（首屏 / 切频道 / 上拉加载更多）→ 首帧之后异步预热
watch(() => store.displayItems.length, () => {
  nextTick(() => { runImagePreload() })
})

// 首屏加载在 onLoad 首次触发（loadedOnce 防 onPageShow 重复首刷）
let initialLoadDone = false
onLoad(() => {
  // 主题必须在首帧渲染前 applicate：放到 nextTick 里会让深色用户先看到一帧浅色（闪白）
  initPageTheme()
  refreshViewport()
  if (!initialLoadDone && store.state === 'idle') {
    initialLoadDone = true
    store.loadFirstPage()
  }
})
onPageShow(() => { initPageTheme(); store.refreshIfPreferencesChanged(); notices.reload(); library.reload() })

// --- Spacing tokens (V3 §3.3) ---
const CARD_PAIR_GAP = COLUMN_GAP_V3       // 双列间距 12rpx
const CARD_V_GAP = CARD_VERTICAL_GAP_V3   // 卡片纵向间距 28rpx

// --- Navbar ---
const navbarStyle = computed((): any => ({
  position: 'fixed', top: '0', left: '0', right: '0',
  zIndex: zIndex.navbar,
  backgroundColor: n.value.bg,
}))
const statusBarPad = computed((): any => ({ height: `${statusBarH}px` }))
const layer1 = {
  height: '96rpx', ...flexRow, alignItems: 'center',
  justifyContent: 'space-between',
  paddingLeft: PAGE_GUTTER_V3,
  paddingRight: PAGE_GUTTER_V3,
}
const brandText = computed((): any => ({
  fontSize: v3TextStyle.pageTitle.fontSize, fontWeight: v3TextStyle.pageTitle.fontWeight, color: n.value.iconActive,
}))
const capsuleSpacer = { width: `${capsuleW}px` }
const navActions = { ...flexRow, alignItems: 'center' }
// 外层只做定位（无圆角 ⇒ 不裁切红点），内层才是那个圆形按钮
const noticeButtonWrap = computed((): any => ({ position: 'relative', width: '64rpx', height: '64rpx', marginRight: capsuleW > 0 ? '12rpx' : '0' }))
const noticeButton = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center' }))
// 红点压在圆形按钮的右上沿，并描一圈页面底色，保证在浅/深两种底色上都读得出
const noticeDot = computed((): any => ({ position: 'absolute', top: '0', right: '0', width: '18rpx', height: '18rpx', borderRadius: '9rpx', backgroundColor: n.value.iconActive, borderWidth: '3rpx', borderStyle: 'solid' as string, borderColor: n.value.bg, zIndex: 3 }))

const wordmarkSearchSpacer = { height: '16rpx' }
const layer2Wrap = { paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const searchBox = computed((): any => ({
  height: SEARCH_HEIGHT_V3, borderRadius: SEARCH_RADIUS_V3,
  backgroundColor: n.value.inputFill,
  ...flexRow, alignItems: 'center',
  paddingLeft: '28rpx', paddingRight: '24rpx',
}))
const searchPlaceholder = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary, marginLeft: '14rpx', lines: 1, textOverflow: 'ellipsis' }))
const searchTabsSpacer = { height: '12rpx' }

// --- Styles ---
// 真机 list-view / waterflow 必须拿到明确高度；height:0 + flex 在微信 VDOM 下会失效。
// ⚠️ 首页必须给**确定高度**（不能只写 flex:1 + minHeight）：
//    MainLayout scrollable=false 时外层不是滚动容器，flex:1 拿不到确定高度 ⇒ scroll-view 会
//    撑到内容全高，滚动条落在没有滚动能力的父容器上 ⇒ 表现就是「能下拉刷新，但上滑不动」。
//    给定高度后 scroll-view 自己成为滚动容器，@scrolltolower 才会触发。
const listViewStyle = computed((): any => ({ width: '750rpx', height: `${homeViewportPx.value}px` }))

// Error / Empty 使用 V3 PageState（无本地样式）
const emptyWrap = { alignItems: 'center', justifyContent: 'center', padding: '48rpx' }

// 双列错落瀑布流：左右两列独立纵向堆叠（V3 §3.3：16+353+12+353+16=750）
const waterfallRow = { ...flexRow, alignItems: 'flex-start' as string, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const masonryColLeft = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginRight: CARD_PAIR_GAP, marginTop: CARD_V_GAP }
const masonryColRight = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginTop: CARD_V_GAP }

// Footer
// 加载更多失败：错误行本身即"点击重试"，必须有语义色与 >=88rpx 热区（此前是裸 text，无样式）
const loadErrorRow = computed((): any => ({ height: '88rpx', alignItems: 'center', justifyContent: 'center', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }))
const loadErrorText = computed((): any => ({ fontSize: v3TextStyle.meta.fontSize, color: semantic.error as string }))
const footerWrap = { ...flexCenter, paddingTop: '32rpx', paddingBottom: PAGE_BOTTOM_SAFE_SPACER }
const footerTxt = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
</script>


