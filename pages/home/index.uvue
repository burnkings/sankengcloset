<template>
  <MainLayout>
    <template #navbar>
      <AppNavbar :show-back="false">
        <template #default>
          <text :style="brandTitleStyle">三坑绮橱</text>
        </template>
        <template #right>
          <view :style="navIconRow">
            <text :style="navIconStyle" @tap="onSearch">搜索</text>
            <text :style="navDotStyle">·</text>
            <text :style="navIconStyle" @tap="onNotify">通知</text>
          </view>
        </template>
      </AppNavbar>
    </template>

    <template #default>
      <AppLoading v-if="store.loading" />

      <list-view v-else :style="listViewStyle" @scrolltolower="onLoadMore">
        <!-- 频道栏 -->
        <list-item :type="'channelBar'">
          <scroll-view scroll-x :style="channelScrollStyle">
            <view :style="channelRowStyle">
              <view
                v-for="ch in channels"
                :key="ch"
                :style="channelChipStyle(ch)"
                @tap="onChannelTap(ch)"
              >
                <text :style="channelChipText(ch)">{{ ch }}</text>
              </view>
            </view>
          </scroll-view>
        </list-item>

        <!-- 焦点专题：当前最重要的发售事件 -->
        <list-item v-if="focusEvent !== null" :type="'focus'">
          <view :style="focusCardStyle" @tap="onFocusTap">
            <view :style="focusTagRow">
              <view :style="focusTagBg">
                <text :style="focusTagText">{{ focusEventType }}</text>
              </view>
              <text :style="focusTimeText">{{ focusTimeLabel }}</text>
            </view>
            <text :style="focusTitleText">{{ focusEvent!.title }}</text>
            <text :style="focusBrandText">{{ focusEvent!.brandName }}</text>
            <view v-if="focusEvent!.price > 0" :style="focusPriceRow">
              <text :style="focusPriceText">{{ formatPrice(focusEvent!.price) }}</text>
            </view>
          </view>
        </list-item>

        <!-- Feed 行: 单列 or 双列配对 -->
        <list-item
          v-for="row in store.feedRows"
          :key="row.id"
          :type="row.rowType"
        >
          <!-- 双列商品卡 -->
          <view v-if="row.rowType === 'pair'" :style="pairRowStyle">
            <view :style="productCardStyle" @tap="onCardTap(row.left!)">
              <!-- 图片区 3:4 -->
              <view :style="productImageWrap">
                <view :style="placeholderBg(row.left!)">
                  <text :style="placeholderTitle">{{ row.left!.title }}</text>
                  <text :style="placeholderBrand">{{ row.left!.brandName }}</text>
                </view>
                <!-- 角标 -->
                <view v-if="row.left!.badgeText !== ''" :style="badgeCornerStyle(row.left!.badgeText)">
                  <text :style="badgeCornerText">{{ row.left!.badgeText }}</text>
                </view>
              </view>
              <!-- 信息区 -->
              <view :style="productInfoStyle">
                <text :style="productTitleText">{{ row.left!.title }}</text>
                <view :style="productBottomRow">
                  <text :style="productPriceText">{{ formatPrice(row.left!.price) }}</text>
                  <text v-if="row.left!.originalPrice > row.left!.price" :style="productOriginalPrice">
                    {{ formatPrice(row.left!.originalPrice) }}
                  </text>
                </view>
                <text :style="productSourceText">{{ row.left!.sourceLabel }}</text>
              </view>
            </view>

            <view v-if="row.right !== null" :style="productCardStyle" @tap="onCardTap(row.right!)">
              <view :style="productImageWrap">
                <view :style="placeholderBg(row.right!)">
                  <text :style="placeholderTitle">{{ row.right!.title }}</text>
                  <text :style="placeholderBrand">{{ row.right!.brandName }}</text>
                </view>
                <view v-if="row.right!.badgeText !== ''" :style="badgeCornerStyle(row.right!.badgeText)">
                  <text :style="badgeCornerText">{{ row.right!.badgeText }}</text>
                </view>
              </view>
              <view :style="productInfoStyle">
                <text :style="productTitleText">{{ row.right!.title }}</text>
                <view :style="productBottomRow">
                  <text :style="productPriceText">{{ formatPrice(row.right!.price) }}</text>
                  <text v-if="row.right!.originalPrice > row.right!.price" :style="productOriginalPrice">
                    {{ formatPrice(row.right!.originalPrice) }}
                  </text>
                </view>
                <text :style="productSourceText">{{ row.right!.sourceLabel }}</text>
              </view>
            </view>
          </view>

          <!-- 单列: 发售事件卡 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType === 'release_event'" :style="eventCardStyle" @tap="onCardTap(row.single!)">
            <view :style="eventImageWrap">
              <view :style="placeholderBg(row.single!)">
                <text :style="placeholderTitle">{{ row.single!.title }}</text>
              </view>
            </view>
            <view :style="eventInfoStyle">
              <view :style="eventTopRow">
                <view :style="eventTypeTagBg(row.single!.badgeText)">
                  <text :style="eventTypeTagText">{{ row.single!.badgeText }}</text>
                </view>
                <text :style="eventTimeText">{{ formatRelativeTime(row.single!.eventStartAt) }}</text>
              </view>
              <text :style="eventTitleText">{{ row.single!.title }}</text>
              <text :style="eventBrandText">{{ row.single!.brandName }}</text>
              <view v-if="row.single!.price > 0" :style="eventPriceRow">
                <text :style="eventPriceText">{{ formatPrice(row.single!.price) }}</text>
              </view>
            </view>
          </view>

          <!-- 单列: 穿搭沉浸卡 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType === 'outfit'" :style="outfitCardStyle" @tap="onCardTap(row.single!)">
            <view :style="outfitImageWrap">
              <view :style="placeholderBg(row.single!)">
                <text :style="outfitPlaceholderTitle">{{ row.single!.title }}</text>
              </view>
              <view :style="outfitOverlay">
                <view :style="outfitOverlayContent">
                  <text :style="outfitTitleText">{{ row.single!.title }}</text>
                  <text :style="outfitSubText">{{ row.single!.subtitle }}</text>
                </view>
              </view>
              <view v-if="row.single!.badgeText !== ''" :style="outfitBadgeStyle">
                <text :style="outfitBadgeText">{{ row.single!.badgeText }}</text>
              </view>
            </view>
          </view>

          <!-- 单列: 品牌动态/编辑精选卡 -->
          <view v-if="row.rowType === 'single' && row.single !== null && row.single!.feedType !== 'release_event' && row.single!.feedType !== 'outfit'" :style="postCardStyle" @tap="onCardTap(row.single!)">
            <view :style="postImageWrap">
              <view :style="placeholderBg(row.single!)">
                <text :style="placeholderTitle">{{ row.single!.title }}</text>
              </view>
            </view>
            <view :style="postInfoStyle">
              <view :style="postTopRow">
                <view :style="postTypeTagBg">
                  <text :style="postTypeTagText">{{ row.single!.badgeText !== '' ? row.single!.badgeText : row.single!.feedType }}</text>
                </view>
                <text :style="postSourceText">{{ row.single!.sourceLabel }}</text>
              </view>
              <text :style="postTitleText">{{ row.single!.title }}</text>
              <text :style="postBrandText">{{ row.single!.brandName }}</text>
            </view>
          </view>
        </list-item>

        <!-- 加载更多 / 已加载全部 -->
        <list-item :type="'footer'">
          <view :style="footerStyle">
            <text :style="footerText">{{ store.isLoadingMore ? '加载中...' : (store.hasMore ? '上拉加载更多' : '已显示全部内容') }}</text>
          </view>
        </list-item>
      </list-view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { useHomeFeedStore, CHANNELS, formatPrice, formatRelativeTime, getCardLayout, CARD_LAYOUT_PRODUCT, CARD_LAYOUT_EVENT, CARD_LAYOUT_OUTFIT } from '@/stores/home-feed-store'
import { FeedItem, FEED_PRODUCT, FEED_RELEASE_EVENT, FEED_OUTFIT, FeedTypeLabels } from '@/domain/content/feed-item'
import { EventTypeLabels } from '@/domain/content/release-event'
import { brand, accent, warm, neutralLight, baseColors, jkColors, lolitaColors, hanfuColors } from '@/theme/tokens/colors'
import { spacing, semanticSpacing } from '@/theme/tokens/spacing'
import { radius, semanticRadius } from '@/theme/tokens/radius'
import { shadow } from '@/theme/tokens/shadow'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexRowBetween, flexColumnCenter, flexCenter, flexFill } from '@/theme/layout/flex'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'

const store = useHomeFeedStore()
const channels = CHANNELS

// ====== 焦点专题（取第一条 release_event） ======

const focusEvent = computed((): FeedItem | null => {
  const items = store.allItems
  for (let i = 0; i < items.length; i++) {
    if (items[i].feedType === FEED_RELEASE_EVENT) {
      return items[i]
    }
  }
  return null
})

const focusEventType = computed((): string => {
  if (focusEvent.value === null) return ''
  const badge = focusEvent.value!.badgeText
  return badge !== '' ? badge : '发售'
})

const focusTimeLabel = computed((): string => {
  if (focusEvent.value === null) return ''
  return formatRelativeTime(focusEvent.value!.eventStartAt)
})

// ====== 导航事件 ======

function onSearch() {
  // Phase 1B: 不实现
}

function onNotify() {
  // Phase 1B: 不实现
}

function onChannelTap(ch: string) {
  store.setChannel(ch)
}

function onFocusTap() {
  // Phase 1B: 不实现详情页跳转
}

function onCardTap(item: FeedItem) {
  // Phase 1B: 不实现详情页跳转
}

function onLoadMore() {
  store.loadMore()
}

// ====== 占位图颜色（基于类别） ======

function placeholderColorForItem(item: FeedItem): string {
  const cat = item.category
  if (cat === 'JK') return jkColors.bg
  if (cat === 'LOLITA') return lolitaColors.bg
  if (cat === 'HANFU') return hanfuColors.bg
  return warm.cream
}

function accentColorForItem(item: FeedItem): string {
  const cat = item.category
  if (cat === 'JK') return jkColors.primary
  if (cat === 'LOLITA') return lolitaColors.primary
  if (cat === 'HANFU') return hanfuColors.primary
  return brand[500]
}

// ====== 初始化 ======

onMounted(() => {
  store.loadFirstPage()
})

// ====== 样式 ======

// --- Navbar ---
const brandTitleStyle = computed((): any => ({
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: n.value.text,
}))

const navIconRow = {
  ...flexRow,
  alignItems: 'center',
  gap: spacing[2],
}

const navIconStyle = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
  fontWeight: fontWeight.medium,
}))

const navDotStyle = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
}))

// --- List View ---
const listViewStyle = {
  ...flexFill,
}

// --- 频道栏 ---
const channelScrollStyle = {
  backgroundColor: baseColors.white,
  borderBottomWidth: '1rpx',
  borderBottomStyle: 'solid' as string,
  borderBottomColor: neutralLight.divider,
}

const channelRowStyle = {
  ...flexRow,
  paddingHorizontal: semanticSpacing.pageHorizontal,
  paddingVertical: spacing[2],
  gap: spacing[2],
}

function channelChipStyle(ch: string) {
  const isActive = ch === store.currentChannel
  return {
    paddingHorizontal: spacing[3],
    paddingVertical: spacing[1],
    borderRadius: radius.full,
    backgroundColor: isActive ? brand[500] : neutralLight.bgTertiary,
    flexShrink: 0,
  }
}

function channelChipText(ch: string) {
  const isActive = ch === store.currentChannel
  return {
    fontSize: fontSize.sm,
    fontWeight: isActive ? fontWeight.semibold : fontWeight.medium,
    color: isActive ? baseColors.white : neutralLight.textSecondary,
  }
}

// --- 焦点专题卡 ---
const focusCardStyle = computed((): any => ({
  marginHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
  padding: spacing[4],
  borderRadius: semanticRadius.card,
  backgroundColor: accent[50],
  borderLeftWidth: '6rpx',
  borderLeftStyle: 'solid' as string,
  borderLeftColor: accent[500],
}))

const focusTagRow = {
  ...flexRow,
  alignItems: 'center',
  gap: spacing[2],
  marginBottom: spacing[2],
}

const focusTagBg = {
  paddingHorizontal: spacing[2],
  paddingVertical: '4rpx',
  borderRadius: radius.full,
  backgroundColor: accent[500],
}

const focusTagText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.semibold,
  color: baseColors.white,
}

const focusTimeText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.medium,
  color: accent[600],
}

const focusTitleText = computed((): any => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  marginBottom: spacing[0.5],
}))

const focusBrandText = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
}))

const focusPriceRow = {
  marginTop: spacing[2],
}

const focusPriceText = {
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: accent[600],
}

// --- 双列商品卡行 ---
const pairRowStyle = {
  ...flexRow,
  gap: spacing[2],
  paddingHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
}

const productCardStyle = computed((): any => ({
  flex: 1,
  borderRadius: semanticRadius.card,
  backgroundColor: n.value.surface,
  boxShadow: shadow.sm,
  overflow: 'hidden',
}))

const productImageWrap = {
  width: '100%',
  paddingBottom: '133.33%', // 3:4
  position: 'relative' as string,
  overflow: 'hidden',
}

function placeholderBg(item: FeedItem) {
  return {
    position: 'absolute' as string,
    top: '0', left: '0', right: '0', bottom: '0',
    backgroundColor: placeholderColorForItem(item),
    display: 'flex' as string,
    flexDirection: 'column' as string,
    alignItems: 'center',
    justifyContent: 'center',
    paddingHorizontal: spacing[3],
    gap: spacing[1],
  }
}

const placeholderTitle = {
  fontSize: fontSize.sm,
  fontWeight: fontWeight.semibold,
  color: 'rgba(0,0,0,0.35)',
  textAlign: 'center' as string,
  lines: 2,
  textOverflow: 'ellipsis',
}

const placeholderBrand = {
  fontSize: fontSize.xs,
  color: 'rgba(0,0,0,0.2)',
  textAlign: 'center' as string,
}

// 角标（新品/预售/降价等）
function badgeCornerStyle(badge: string) {
  let bgColor = brand[500]
  if (badge === '预售') bgColor = '#8B5CF6'
  else if (badge === '降价') bgColor = '#EF4444'
  else if (badge === '新品') bgColor = '#22C55E'
  return {
    position: 'absolute' as string,
    top: '0',
    right: '0',
    paddingHorizontal: spacing[2],
    paddingVertical: '4rpx',
    borderBottomLeftRadius: radius.md,
    backgroundColor: bgColor,
  }
}

const badgeCornerText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.bold,
  color: baseColors.white,
}

// 商品信息区
const productInfoStyle = {
  padding: spacing[2],
  gap: spacing[0.5],
}

const productTitleText = computed((): any => ({
  fontSize: fontSize.sm,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  lines: 1,
  textOverflow: 'ellipsis',
}))

const productBottomRow = {
  ...flexRow,
  alignItems: 'center',
  gap: spacing[1],
  marginTop: spacing[0.5],
}

const productPriceText = {
  fontSize: fontSize.base,
  fontWeight: fontWeight.bold,
  color: brand[600],
}

const productOriginalPrice = {
  fontSize: fontSize.xs,
  color: neutralLight.textTertiary,
  textDecoration: 'line-through',
}

const productSourceText = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
  marginTop: '2rpx',
}))

// --- 发售事件卡（单列） ---
const eventCardStyle = computed((): any => ({
  marginHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
  borderRadius: semanticRadius.card,
  backgroundColor: n.value.surface,
  boxShadow: shadow.card,
  overflow: 'hidden',
}))

const eventImageWrap = {
  width: '100%',
  paddingBottom: '56.25%', // 16:9 横图
  position: 'relative' as string,
  overflow: 'hidden',
}

const eventInfoStyle = {
  padding: spacing[3],
  gap: spacing[1],
}

const eventTopRow = {
  ...flexRow,
  alignItems: 'center',
  gap: spacing[2],
  marginBottom: spacing[1],
}

function eventTypeTagBg(badge: string) {
  let bgColor = brand[500]
  if (badge === '定金') bgColor = '#F59E0B'
  else if (badge === '尾款') bgColor = '#FF4D7E'
  else if (badge === '发售') bgColor = '#22C55E'
  else if (badge === '补货') bgColor = '#3B82F6'
  else if (badge === '降价') bgColor = '#EF4444'
  else if (badge === '预约') bgColor = '#6366F1'
  else if (badge === '预览') bgColor = '#8B5CF6'
  return {
    paddingHorizontal: spacing[2],
    paddingVertical: '4rpx',
    borderRadius: radius.full,
    backgroundColor: bgColor + '20',
  }
}

const eventTypeTagText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.semibold,
  color: brand[600],
}

const eventTimeText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.medium,
  color: accent[600],
}

const eventTitleText = computed((): any => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  lines: 2,
  textOverflow: 'ellipsis',
}))

const eventBrandText = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
}))

const eventPriceRow = {
  marginTop: spacing[1],
}

const eventPriceText = {
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: brand[600],
}

// --- 穿搭沉浸卡（单列大图） ---
const outfitCardStyle = computed((): any => ({
  marginHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
  borderRadius: semanticRadius.card,
  overflow: 'hidden',
  boxShadow: shadow.card,
}))

const outfitImageWrap = {
  width: '100%',
  paddingBottom: '100%', // 1:1
  position: 'relative' as string,
  overflow: 'hidden',
}

const outfitOverlay = {
  position: 'absolute' as string,
  bottom: '0',
  left: '0',
  right: '0',
  paddingTop: '80rpx',
  paddingBottom: spacing[3],
  paddingHorizontal: spacing[3],
  backgroundColor: 'rgba(0,0,0,0.35)',
}

const outfitOverlayContent = {
  gap: spacing[0.5],
}

const outfitTitleText = {
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: baseColors.white,
}

const outfitSubText = {
  fontSize: fontSize.xs,
  color: 'rgba(255,255,255,0.8)',
}

const outfitBadgeStyle = {
  position: 'absolute' as string,
  top: spacing[2],
  left: spacing[2],
  paddingHorizontal: spacing[2],
  paddingVertical: '4rpx',
  borderRadius: radius.full,
  backgroundColor: 'rgba(255,255,255,0.85)',
}

const outfitBadgeText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.semibold,
  color: brand[600],
}

const outfitPlaceholderTitle = {
  fontSize: fontSize.lg,
  fontWeight: fontWeight.bold,
  color: 'rgba(0,0,0,0.2)',
  textAlign: 'center' as string,
}

// --- 品牌动态/编辑卡（单列横图） ---
const postCardStyle = computed((): any => ({
  marginHorizontal: semanticSpacing.pageHorizontal,
  marginTop: spacing[3],
  borderRadius: semanticRadius.card,
  backgroundColor: n.value.surface,
  boxShadow: shadow.sm,
  overflow: 'hidden',
}))

const postImageWrap = {
  width: '100%',
  paddingBottom: '56.25%', // 16:9
  position: 'relative' as string,
  overflow: 'hidden',
}

const postInfoStyle = {
  padding: spacing[3],
  gap: spacing[1],
}

const postTopRow = {
  ...flexRow,
  alignItems: 'center',
  justifyContent: 'space-between',
  marginBottom: spacing[0.5],
}

const postTypeTagBg = {
  paddingHorizontal: spacing[2],
  paddingVertical: '4rpx',
  borderRadius: radius.full,
  backgroundColor: brand[50],
}

const postTypeTagText = {
  fontSize: fontSize.xs,
  fontWeight: fontWeight.medium,
  color: brand[500],
}

const postSourceText = computed((): any => ({
  fontSize: fontSize.xs,
  color: n.value.textTertiary,
}))

const postTitleText = computed((): any => ({
  fontSize: fontSize.base,
  fontWeight: fontWeight.semibold,
  color: n.value.text,
  lines: 2,
  textOverflow: 'ellipsis',
}))

const postBrandText = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textSecondary,
}))

// --- 底部 ---
const footerStyle = {
  ...flexCenter,
  padding: spacing[4],
}

const footerText = computed((): any => ({
  fontSize: fontSize.sm,
  color: n.value.textTertiary,
}))
</script>
