<template>
  <view :style="{ height: pageHeight + 'px', position: 'relative' }">
    <MainLayout :scrollable="false" navbar-content-height="252rpx">
    <template #navbar>
      <view :style="navbarStyle">
        <view :style="statusBarPad" />
        <!-- Layer 1: Brand + Capsule -->
        <view :style="layer1">
          <text :style="brandText">三坑绮橱</text>
          <view :style="navActions">
            <view :style="noticeButton" @tap="openNotifications">
              <AppIcon name="notification" :size="38" />
              <view v-if="notices.unreadCount > 0" :style="noticeDot" />
            </view>
            <view :style="capsuleSpacer" />
          </view>
        </view>
        <view :style="wordmarkSearchSpacer" />
        <!-- Layer 2: Search -->
        <view class="nav-canvas" :style="layer2Wrap">
          <view :style="searchBox" @tap="onSearch">
            <AppIcon name="search" :size="36" />
            <text :style="searchPlaceholder">搜索商品、品牌或风格</text>
          </view>
        </view>
        <view :style="searchTabsSpacer" />
        <!-- Layer 3: Channels -->
        <ChannelTabs :items="channels" :active="store.currentChannel" @change="onChannelTap" />
      </view>
    </template>

    <template #default>
      <FeedSkeleton v-if="store.loading || store.state === 'idle'" />

      <PageState v-else-if="store.state === 'error'" icon="info" title="加载失败" :message="store.errorMessage" action-text="点击重试" @action="onRetry" />

      <!-- #ifdef MP-WEIXIN -->
      <scroll-view v-else scroll-y refresher-enabled :refresher-triggered="isRefreshing" @refresherrefresh="onRefresh" :style="listViewStyle" :scroll-top="scrollTop" @scroll="onPageScroll" @scrolltolower="onLoadMore">
        <view v-if="store.isEmpty" :style="emptyWrap">
          <PageState icon="info" title="暂无内容" message="切换其他频道看看" />
        </view>

        <view v-for="block in store.masonryBlocks" :key="blockKey(block)">
          <view v-if="block.type === 'columns'" class="feed-pair-row" :style="waterfallRow">
            <view :style="masonryColLeft">
              <view v-for="item in block.left" :key="item.id">
                <view v-if="item.feedType === FEED_OUTFIT" :style="outfitFlowCard" @tap="onTap(item)">
                  <view :style="outfitFlowImgWrap(item)">
                    <AppImage :src="item.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                    <view :style="outfitInfoOverlay">
                      <text :style="outfitTitle">{{ item.title }}</text>
                      <text :style="outfitSub">{{ item.subtitle }}</text>
                    </view>
                  </view>
                </view>
                <ProductCard v-else :image="item.coverUrl" :brand="item.brandName" :title="item.title" :price-text="formatPrice(item.price)" :badge-text="item.badgeText" :deadline-text="formatDeadline(item.eventEndAt)" :image-height="feedImageHeight(item)" :saved="library.isFavorite(item.entityId)" @tap="onTap(item)" @toggle-save="onToggleSave(item)" />
              </view>
            </view>
            <view :style="masonryColRight">
              <view v-for="item in block.right" :key="item.id">
                <view v-if="item.feedType === FEED_OUTFIT" :style="outfitFlowCard" @tap="onTap(item)">
                  <view :style="outfitFlowImgWrap(item)">
                    <AppImage :src="item.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                    <view :style="outfitInfoOverlay">
                      <text :style="outfitTitle">{{ item.title }}</text>
                      <text :style="outfitSub">{{ item.subtitle }}</text>
                    </view>
                  </view>
                </view>
                <ProductCard v-else :image="item.coverUrl" :brand="item.brandName" :title="item.title" :price-text="formatPrice(item.price)" :badge-text="item.badgeText" :deadline-text="formatDeadline(item.eventEndAt)" :image-height="feedImageHeight(item)" :saved="library.isFavorite(item.entityId)" @tap="onTap(item)" @toggle-save="onToggleSave(item)" />
              </view>
            </view>
          </view>
          <view v-else-if="block.full !== null && block.full!.feedType === 'release_event'" class="feed-single-card" @tap="onTap(block.full!)">
            <ReleaseCard :title="block.full!.title" :brand="block.full!.brandName" :image="block.full!.coverUrl" :overlay-text="formatRelativeTime(block.full!.eventStartAt)" @tap="onTap(block.full!)" @remind="onTap(block.full!)" @view="onTap(block.full!)" />
          </view>
          <view v-else-if="block.full !== null && block.full!.feedType === FEED_OUTFIT" class="feed-single-card" :style="outfitCard" @tap="onTap(block.full!)">
            <view :style="imgWrap45">
              <AppImage :src="block.full!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
              <view :style="outfitInfoOverlay">
                <text :style="outfitTitle">{{ block.full!.title }}</text>
                <text :style="outfitSub">{{ block.full!.subtitle }}</text>
              </view>
            </view>
          </view>
          <view v-else-if="block.full !== null" class="feed-single-card" @tap="onTap(block.full!)">
            <EditorialCard :title="block.full!.title" :image="block.full!.coverUrl" :source-label="block.full!.sourceLabel !== '' ? block.full!.sourceLabel : feedLabel(block.full!.feedType)" :updated-text="formatRelativeTime(block.full!.eventStartAt)" />
          </view>
        </view>

        <view v-if="showFeedFooter" :style="footerWrap">
          <text :style="footerTxt">{{ footerText }}</text>
        </view>
      </scroll-view>
      <!-- #endif -->

      <!-- #ifndef MP-WEIXIN -->
      <view v-else-if="store.isEmpty" :style="emptyWrap">
        <PageState icon="info" title="暂无内容" message="切换其他频道看看" />
      </view>

      <!-- 双列错落瀑布流：商品/穿搭归入左右两列（可变图片高度），发售/编辑专题全宽 -->
      <list-view v-else :style="listViewStyle" refresher-enabled :refresher-triggered="isRefreshing" @refresherrefresh="onRefresh" :scroll-top="scrollTop" @scroll="onPageScroll" @scrolltolower="onLoadMore">
        <list-item v-for="block in store.masonryBlocks" :key="blockKey(block)">
          <view v-if="block.type === 'columns'" class="feed-pair-row" :style="waterfallRow">
            <view :style="masonryColLeft">
              <view v-for="item in block.left" :key="item.id">
                <view v-if="item.feedType === FEED_OUTFIT" :style="outfitFlowCard" @tap="onTap(item)">
                  <view :style="outfitFlowImgWrap(item)">
                    <AppImage :src="item.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                    <view :style="outfitInfoOverlay">
                      <text :style="outfitTitle">{{ item.title }}</text>
                      <text :style="outfitSub">{{ item.subtitle }}</text>
                    </view>
                  </view>
                </view>
                <ProductCard v-else :image="item.coverUrl" :brand="item.brandName" :title="item.title" :price-text="formatPrice(item.price)" :badge-text="item.badgeText" :deadline-text="formatDeadline(item.eventEndAt)" :image-height="feedImageHeight(item)" :saved="library.isFavorite(item.entityId)" @tap="onTap(item)" @toggle-save="onToggleSave(item)" />
              </view>
            </view>
            <view :style="masonryColRight">
              <view v-for="item in block.right" :key="item.id">
                <view v-if="item.feedType === FEED_OUTFIT" :style="outfitFlowCard" @tap="onTap(item)">
                  <view :style="outfitFlowImgWrap(item)">
                    <AppImage :src="item.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
                    <view :style="outfitInfoOverlay">
                      <text :style="outfitTitle">{{ item.title }}</text>
                      <text :style="outfitSub">{{ item.subtitle }}</text>
                    </view>
                  </view>
                </view>
                <ProductCard v-else :image="item.coverUrl" :brand="item.brandName" :title="item.title" :price-text="formatPrice(item.price)" :badge-text="item.badgeText" :deadline-text="formatDeadline(item.eventEndAt)" :image-height="feedImageHeight(item)" :saved="library.isFavorite(item.entityId)" @tap="onTap(item)" @toggle-save="onToggleSave(item)" />
              </view>
            </view>
          </view>
          <view v-else-if="block.full !== null && block.full!.feedType === 'release_event'" class="feed-single-card" @tap="onTap(block.full!)">
            <ReleaseCard :title="block.full!.title" :brand="block.full!.brandName" :image="block.full!.coverUrl" :overlay-text="formatRelativeTime(block.full!.eventStartAt)" @tap="onTap(block.full!)" @remind="onTap(block.full!)" @view="onTap(block.full!)" />
          </view>
          <view v-else-if="block.full !== null && block.full!.feedType === FEED_OUTFIT" class="feed-single-card" :style="outfitCard" @tap="onTap(block.full!)">
            <view :style="imgWrap45">
              <AppImage :src="block.full!.coverUrl" width="100%" height="100%" mode="aspectFill" :lazy-load="true" />
              <view :style="outfitInfoOverlay">
                <text :style="outfitTitle">{{ block.full!.title }}</text>
                <text :style="outfitSub">{{ block.full!.subtitle }}</text>
              </view>
            </view>
          </view>
          <view v-else-if="block.full !== null" class="feed-single-card" @tap="onTap(block.full!)">
            <EditorialCard :title="block.full!.title" :image="block.full!.coverUrl" :source-label="block.full!.sourceLabel !== '' ? block.full!.sourceLabel : feedLabel(block.full!.feedType)" :updated-text="formatRelativeTime(block.full!.eventStartAt)" />
          </view>
        </list-item>

        <list-item v-if="showFeedFooter">
          <view :style="footerWrap"><text :style="footerTxt">{{ footerText }}</text></view>
        </list-item>
      </list-view>
      <!-- #endif -->
    </template>
  </MainLayout>
  <BackToTop :visible="showBackTop" @tap="backToTop" />
</view>
</template>

<script setup lang="uts">
import { nextTick } from 'vue'
import { useHomeFeedStore, CHANNELS, formatPrice, formatRelativeTime, formatDeadline, MasonryBlock, feedImageHeight } from '@/stores/home-feed-store'
import { useNotificationCenterStore } from '@/stores/notification-center-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { FeedItem, FEED_OUTFIT } from '@/domain/content/feed-item'
import { getFeedTypeLabel } from '@/presentation/content/feed-presenter'
import { brand, baseColors } from '@/theme/tokens/colors'
import { fontSize, fontWeight, v3TextStyle } from '@/theme/tokens/typography'
import { flexRow, flexCenter } from '@/theme/layout/flex'
import { zIndex } from '@/theme/tokens/z-index'
import { n, initPageTheme } from '@/theme/use-theme'
import { getStatusBarHeight, getWindowHeight, upx2px } from '@/utils/window-info'
import { openPrimaryTab } from '@/utils/tab-navigation'
import { SEARCH_HEIGHT_V3, SEARCH_RADIUS_V3, PAGE_BOTTOM_SAFE_SPACER, PRODUCT_CARD_WIDTH_V3, PAGE_GUTTER_V3, COLUMN_GAP_V3, CARD_VERTICAL_GAP_V3, CARD_RADIUS_V3 } from '@/theme/tokens/responsive'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppImage from '@/components/base/AppImage.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import BackToTop from '@/components/base/BackToTop.uvue'
import ChannelTabs from '@/components/v3/ChannelTabs.uvue'
import ProductCard from '@/components/v3/ProductCard.uvue'
import ReleaseCard from '@/components/v3/ReleaseCard.uvue'
import EditorialCard from '@/components/v3/EditorialCard.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import PageState from '@/components/v3/PageState.uvue'

const pageHeight = getWindowHeight()
const store = useHomeFeedStore()
const notices = useNotificationCenterStore()
const library = useContentLibraryStore()
const channels = CHANNELS

// 返回顶部
const scrollTop = ref(0)
const lastScrollTop = ref(0)
const showBackTop = ref(false)
function onPageScroll(e: UniScrollEvent) {
  const top = e.detail.scrollTop
  lastScrollTop.value = top
  showBackTop.value = top > 300
}
function backToTop() {
  showBackTop.value = false
  scrollTop.value = lastScrollTop.value
  nextTick(() => { scrollTop.value = 0 })
}

const statusBarH = getStatusBarHeight()
const homeNavbarPx = upx2px(252)
const homeViewportPx = ref(Math.max(getWindowHeight() - statusBarH - homeNavbarPx, 240))
function refreshViewport() { homeViewportPx.value = Math.max(getWindowHeight() - statusBarH - homeNavbarPx, 240) }

// Capsule spacer
let capsuleW = 0
// #ifdef MP-WEIXIN
try {
  const cap = uni.getMenuButtonBoundingClientRect()
  capsuleW = cap.width + 16
} catch (e) {
  capsuleW = 0
}
// #endif

function feedLabel(ft: string): string { return getFeedTypeLabel(ft) }
function blockKey(block: MasonryBlock): string {
  if (block.type == 'full') {
    const f = block.full
    return f != null ? `full-${f.id}` : 'full-empty'
  }
  if (block.left.length > 0) return `cols-${block.left[0].id}`
  if (block.right.length > 0) return `cols-${block.right[0].id}`
  return 'cols-empty'
}
function onSearch() { uni.navigateTo({ url: '/pages/search/index' }) }
function openNotifications() { uni.navigateTo({ url: '/pages/notification/index' }) }
function onChannelTap(ch: string) { store.setChannel(ch) }
function onTap(item: FeedItem) {
  if (item.feedType === FEED_OUTFIT) {
    openPrimaryTab('/pages/community/index')
    return
  }
  if (item.feedType === 'editorial') {
    uni.navigateTo({ url: `/pages/editorial/detail?title=${encodeURIComponent(item.title)}&category=${item.category}&image=${encodeURIComponent(item.coverUrl)}` })
    return
  }
  if (item.entityId == '') return
  uni.navigateTo({ url: `/pages/product/detail?id=${item.entityId}` })
}
function onToggleSave(item: FeedItem) {
  library.toggleFavorite(item.entityId, item.title)
}
function onLoadMore() { store.loadMore() }
function onRetry() { store.retry() }
const isRefreshing = ref(false)
async function onRefresh() {
  isRefreshing.value = true
  try { await store.loadFirstPage(true) }
  finally { isRefreshing.value = false }
}
// Footer 文案：加载中 / 上拉加载更多 / 已显示全部
const footerText = computed((): string => {
  if (store.isLoadingMore) return '加载中...'
  return store.hasMore ? '上拉加载更多' : '已显示全部'
})
// 筛选后内容不足一屏时不展示 footer，避免制造虚假操作预期。
const showFeedFooter = computed((): boolean => store.isLoadingMore || store.displayItems.length >= 8)
onMounted(() => { store.loadFirstPage() })
onReady(() => { refreshViewport() })
onLoad(() => { nextTick(() => initPageTheme()); refreshViewport() })
onPageShow(() => { initPageTheme(); store.refreshIfPreferencesChanged(); notices.reload(); library.reload() })

// --- Spacing tokens (V3 §3.3) ---
const CARD_PAIR_GAP = COLUMN_GAP_V3       // 双列间距 12rpx
const CARD_V_GAP = CARD_VERTICAL_GAP_V3   // 卡片纵向间距 28rpx

// --- Navbar ---
const navbarStyle = computed((): any => ({
  position: 'fixed', top: '0', left: '0', right: '0',
  zIndex: zIndex.navbar,
  backgroundColor: n.value.bg,
}))
const statusBarPad = computed((): any => ({ height: `${statusBarH}px` }))
const layer1 = {
  height: '96rpx', ...flexRow, alignItems: 'center',
  justifyContent: 'space-between',
  paddingLeft: PAGE_GUTTER_V3,
  paddingRight: PAGE_GUTTER_V3,
}
const brandText = computed((): any => ({
  fontSize: v3TextStyle.pageTitle.fontSize, fontWeight: v3TextStyle.pageTitle.fontWeight, color: brand.primary,
}))
const capsuleSpacer = { width: `${capsuleW}px` }
const navActions = { ...flexRow, alignItems: 'center' }
const noticeButton = computed((): any => ({ width: '64rpx', height: '64rpx', borderRadius: '32rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', position: 'relative', marginRight: capsuleW > 0 ? '12rpx' : '0' }))
const noticeDot = { position: 'absolute', top: '8rpx', right: '8rpx', width: '12rpx', height: '12rpx', borderRadius: '6rpx', backgroundColor: brand[600] }

const wordmarkSearchSpacer = { height: '16rpx' }
const layer2Wrap = {}
const searchBox = computed((): any => ({
  height: SEARCH_HEIGHT_V3, borderRadius: SEARCH_RADIUS_V3,
  backgroundColor: n.value.inputFill,
  ...flexRow, alignItems: 'center',
  paddingLeft: '28rpx', paddingRight: '24rpx',
}))
const searchPlaceholder = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary, marginLeft: '14rpx', lines: 1, textOverflow: 'ellipsis' }))
const searchTabsSpacer = { height: '12rpx' }

// --- Styles ---
// 真机 list-view / waterflow 必须拿到明确高度；height:0 + flex 在微信 VDOM 下会失效。
const listViewStyle = computed((): any => ({ width: '750rpx', flex: 1, minHeight: `${homeViewportPx.value}px` }))

// Error / Empty 使用 V3 PageState（无本地样式）
const emptyWrap = { alignItems: 'center', justifyContent: 'center', padding: '48rpx' }

// 双列错落瀑布流：左右两列独立纵向堆叠（V3 §3.3：16+353+12+353+16=750）
const waterfallRow = { ...flexRow, alignItems: 'flex-start' as string }
const masonryColLeft = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginRight: CARD_PAIR_GAP, marginTop: CARD_V_GAP }
const masonryColRight = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginTop: CARD_V_GAP }

// Outfit card — 单列全宽穿搭卡（与微信端同构，V3 token 化）
const outfitCard = { marginTop: CARD_V_GAP, borderRadius: CARD_RADIUS_V3, overflow: 'hidden' }
// Outfit card — 双列半宽版本（列内，与 ProductCard 同尺寸，图片高度随 feedImageHeight 错落）
const outfitFlowCard = { width: '100%', borderRadius: CARD_RADIUS_V3, overflow: 'hidden' }
function outfitFlowImgWrap(item: FeedItem): any {
  return { width: '100%', height: feedImageHeight(item), position: 'relative' as string, overflow: 'hidden' }
}
const outfitInfoOverlay = { position: 'absolute' as string, bottom: '0', left: '0', right: '0', padding: '24rpx', paddingTop: '80rpx', backgroundColor: 'rgba(0,0,0,0.3)' }
const outfitTitle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: baseColors.white }
const outfitSub = { fontSize: fontSize.xs, color: 'rgba(255,255,255,0.8)', marginTop: '4rpx' }
const imgWrap45 = { width: '718rpx', height: '760rpx', position: 'relative' as string, overflow: 'hidden' }

// Footer
const footerWrap = { ...flexCenter, paddingTop: '32rpx', paddingBottom: PAGE_BOTTOM_SAFE_SPACER }
const footerTxt = computed((): any => ({ fontSize: fontSize.sm, color: n.value.textTertiary }))
</script>

<style>
.nav-canvas {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.feed-pair-row {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.feed-single-card {
  margin-left: 32rpx;
  margin-right: 32rpx;
}
</style>
