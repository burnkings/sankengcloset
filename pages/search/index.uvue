<template>
  <MainLayout navbar-content-height="88rpx">
    <template #navbar>
      <AppNavbar :show-back="true">
        <template #default>
          <view :style="inputFlex">
            <AppInput v-model="keyword" placeholder="搜索商品、品牌、穿搭" :focus="inputFocused" confirm-type="search" :clearable="true" @confirm="onSubmit" @clear="onClear">
              <template #prefix><AppIcon name="search" :size="34" /></template>
            </AppInput>
          </view>
        </template>
        <template #right>
          <text :style="cancelText" @tap="onCancel">取消</text>
        </template>
      </AppNavbar>
    </template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view v-if="keyword === ''">
          <V2SectionHeader title="最近搜索" actionText="清空" @action="clearRecent" />
          <view :style="recentWrap">
            <view v-for="(kw, idx) in recent" :key="kw" :style="recentChip(idx)" @tap="selectKeyword(kw)">
              <text :style="recentChipText">{{ kw }}</text>
            </view>
          </view>

          <V2SectionHeader title="热门搜索" />
          <view :style="hotList">
            <view v-for="(item, idx) in hotRank" :key="item.keyword" :style="hotRow" @tap="selectKeyword(item.keyword)">
              <text :style="rankText(idx)">{{ idx + 1 }}</text>
              <text :style="hotKeywordText">{{ item.keyword }}</text>
              <text :style="heatText">{{ item.heat }}</text>
            </view>
          </view>
        </view>

        <view v-else>
          <V2SectionHeader :title="'搜索结果 · ' + String(results.length)" :compact="true" />
          <view v-if="results.length > 0" :style="resultGrid">
            <view v-for="(item, idx) in results" :key="item.id" :style="productShell(idx)">
              <V2ProductCard
                :image="item.coverUrl"
                :brand-name="item.brandName"
                :title="item.title"
                :price-text="formatPrice(item.price)"
                :original-price-text="item.originalPrice > item.price ? formatPrice(item.originalPrice) : ''"
                :badge="item.badgeText"
                :deadline-text="formatDeadline(item.eventEndAt)"
                @click="onResultTap(item)"
              />
            </view>
          </view>
          <view v-else :style="emptyWrap">
            <AppIcon name="search" :size="64" />
            <text :style="emptyTitle">没有找到相关内容</text>
            <text :style="emptyDesc">换个商品名、品牌或坑向试试</text>
          </view>
        </view>
      </view>
    </template>
  </MainLayout>
</template>

<script setup lang="uts">
import { FeedItem, FEED_PRODUCT } from '@/domain/content/feed-item'
import { formatPrice, formatDeadline } from '@/stores/home-feed-store'
import { brand, semantic, accent } from '@/theme/tokens/colors'
import { fontSize, fontWeight } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { GROUP_GAP, PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_REGULAR } from '@/theme/tokens/responsive'
import { n } from '@/theme/use-theme'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppNavbar from '@/components/base/AppNavbar.uvue'
import AppInput from '@/components/base/AppInput.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import V2SectionHeader from '@/components/v2/V2SectionHeader.uvue'
import V2ProductCard from '@/components/v2/V2ProductCard.uvue'

const keyword = ref('')
// 页面进入时始终保持静默，不因回填搜索词自动唤起手机键盘。
const inputFocused = ref(false)
const sourceItems = ref([]) as Ref<FeedItem[]>

// 最近搜索：本地存储，首次无记录时用设计稿示例填充
function loadRecent(): string[] {
  try {
    const raw = uni.getStorageSync('search_recent') as string
    if (raw && raw.length) return JSON.parse(raw) as string[]
  } catch (e) {}
  return ['樱茶JK', '梦境Lolita', 'JK制服上新', '汉服秋冬', '绮灵搭配', '甜系Lolita']
}
const recent = ref<string[]>(loadRecent())
function saveRecent() {
  try { uni.setStorageSync('search_recent', JSON.stringify(recent.value)) } catch (e) {}
}

// 热门搜索：design 编号榜 + 热度
const hotRank = [
  { keyword: '樱茶JK制服 秋冬系列', heat: '18.2万' },
  { keyword: '梦境蝴蝶结 Lolita裙', heat: '15.6万' },
  { keyword: '绮灵AI 搭配方案', heat: '12.8万' },
  { keyword: '汉服明制 上新', heat: '9.4万' },
  { keyword: '甜系 JK小物', heat: '7.1万' },
]

function normalizedQuery(value: string): string {
  let q = value.trim().toLowerCase()
  q = q.replace('洛丽塔', 'lolita').replace('洛莉塔', 'lolita').replace('lo裙', 'lolita')
  q = q.replace('水手服', 'jk').replace('格裙', 'jk').replace('制服', 'jk')
  q = q.replace('华服', '汉服').replace('汉元素', '汉服')
  return q
}

function itemSearchText(item: FeedItem): string {
  const categoryLabel = item.category === 'HANFU' ? '汉服 华服 汉元素' : (item.category === 'LOLITA' ? 'lolita 洛丽塔 洛莉塔 lo裙' : 'jk 制服 水手服 格裙')
  return `${item.title} ${item.brandName} ${item.subtitle} ${categoryLabel}`.toLowerCase()
}

const results = computed((): FeedItem[] => {
  const q = normalizedQuery(keyword.value)
  if (q === '') return []
  return sourceItems.value.filter((item) => {
    if (item.feedType !== FEED_PRODUCT) return false
    return itemSearchText(item).includes(q)
  })
})

function selectKeyword(value: string) {
  keyword.value = value
  const next = [value, ...recent.value.filter((k) => k !== value)].slice(0, 10)
  recent.value = next
  saveRecent()
}
function clearRecent() { recent.value = []; saveRecent() }
function onSubmit() { inputFocused.value = false }
function onClear() { keyword.value = ''; inputFocused.value = false }
function onCancel() {
  if (keyword.value !== '') { keyword.value = ''; inputFocused.value = false }
  else { uni.navigateBack() }
}
function onResultTap(item: FeedItem) {
  uni.navigateTo({ url: `/pages/product/detail?id=${item.entityId}` })
}

onMounted(() => {
  try {
    const pending = uni.getStorageSync('pending_search_keyword') as string
    if (pending !== '') {
      keyword.value = pending
      uni.removeStorageSync('pending_search_keyword')
    }
  } catch (e) {}
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP , paddingLeft: PAGE_GUTTER_REGULAR, paddingRight: PAGE_GUTTER_REGULAR}
const inputFlex = { ...flexFill } as any
const cancelText = { fontSize: '27rpx', fontWeight: '500', color: brand[300], flexShrink: 0, marginLeft: '16rpx' } as any

const recentWrap = { ...flexRow, flexWrap: 'wrap' as string, gap: '16rpx', marginTop: '4rpx' } as any
function recentChip(idx: number) {
  return { minHeight: '61rpx', paddingLeft: '24rpx', paddingRight: '24rpx', borderRadius: '9999rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', flexShrink: 0 } as any
}
const recentChipText = { fontSize: '25rpx', fontWeight: '400', color: n.value.textSecondary } as any

const hotList = { marginTop: '8rpx' } as any
const hotRow = { ...flexRow, alignItems: 'center', minHeight: '72rpx', paddingVertical: '8rpx' } as any
function rankText(idx: number) {
  const color = idx === 0 ? brand[500] : idx === 1 ? semantic.warning : idx === 2 ? accent[500] : n.value.textSecondary
  return { width: '44rpx', fontSize: '33rpx', fontWeight: '600', color } as any
}
const hotKeywordText = { ...flexFill, fontSize: '27rpx', fontWeight: '500', color: n.value.text } as any
const heatText = { fontSize: '21rpx', fontWeight: '400', color: semantic.warning, marginLeft: '16rpx', flexShrink: 0 } as any

const resultGrid = { ...flexRow, flexWrap: 'wrap' as string }
function productShell(idx: number) { return { width: '325rpx', marginRight: idx % 2 == 0 ? GROUP_GAP : '0', marginBottom: GROUP_GAP } }
const emptyWrap = { alignItems: 'center', paddingTop: '160rpx', paddingBottom: '120rpx' }
const emptyTitle = { fontSize: fontSize.base, fontWeight: fontWeight.semibold, color: n.value.text, marginTop: '20rpx' }
const emptyDesc = { fontSize: fontSize.sm, color: n.value.textTertiary, marginTop: '8rpx' }
</script>
