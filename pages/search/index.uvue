<template>
  <MainLayout navbar-content-height="88rpx" :scroll-top="scrollTop" @scrolltolower="loadMore" @scroll="onPageScroll">
    <template #navbar>
      <view :style="searchNavStyle">
        <view :style="statusBarPadStyle" />
        <view :style="searchRowStyle">
          <view :style="backBtnStyle" @tap="onBackTap"><AppIcon name="arrow-back" :size="40" /></view>
          <view :style="inputShellStyle">
            <view :style="inputIconStyle"><AppIcon name="search" :size="34" /></view>
            <input
              :style="inputStyle"
              :value="keyword"
              placeholder="搜索商品、品牌、穿搭"
              :placeholder-style="placeholderStyleStr"
              :focus="inputFocused"
              confirm-type="search"
              @input="onInput"
              @confirm="onSubmit"
            />
            <view v-if="keyword !== ''" :style="clearBtnStyle" @tap="onClear"><AppIcon name="close" :size="28" /></view>
          </view>
          <text :style="cancelText" @tap="onCancel">取消</text>
        </view>
      </view>
    </template>
    <template #default>
      <view class="page-canvas" :style="pageWrap">
        <view v-if="keyword === ''" :style="plainSections">
          <template v-if="recent.length > 0">
            <SectionHeader title="最近搜索" action-text="清空" @action="clearRecent" />
            <view :style="recentWrap">
              <view v-for="(kw, idx) in recent" :key="kw" :style="recentChip(idx)" @tap="selectKeyword(kw)">
                <text :style="recentChipText">{{ kw }}</text>
              </view>
            </view>
          </template>

          <SectionHeader title="编辑推荐" />
          <view :style="hotList">
            <view v-for="(item, idx) in hotRank" :key="item.keyword" :style="hotRow" @tap="selectKeyword(item.keyword)">
              <text :style="rankText(idx)">{{ idx + 1 }}</text>
              <text :style="hotKeywordText">{{ item.keyword }}</text>
              <text :style="heatText">{{ item.heat }}</text>
            </view>
          </view>
        </view>

        <view v-else>
          <scroll-view direction="horizontal" :style="filterScroll">
            <view :style="filterRow">
              <view :style="filterChip(activeSaleStatus !== '')" @tap="pickSaleStatus"><text :style="filterChipText(activeSaleStatus !== '')">{{ saleStatusLabel }}</text></view>
              <view :style="filterChip(minPrice > 0 || maxPrice > 0)" @tap="pickPrice"><text :style="filterChipText(minPrice > 0 || maxPrice > 0)">{{ priceLabel }}</text></view>
              <view v-if="hasActiveFilters" :style="clearFilter" @tap="clearFilters"><text :style="clearFilterText">清除筛选</text></view>
            </view>
          </scroll-view>
          <view v-if="searching && results.length === 0" :style="emptyWrap">
            <FeedSkeleton />
          </view>
          <view v-else-if="searchError !== '' && results.length === 0" :style="emptyWrap">
            <PageState icon="search" title="搜索失败" :message="searchError" action-text="点击重试" @action="retrySearch" />
          </view>
          <view v-else-if="results.length > 0">
            <view :style="resultColumns">
              <view :style="resultColLeft">
                <view v-for="item in resultLeft" :key="item.id">
                  <ProductCard
                    :image="item.coverUrl"
                    :brand="item.brandName"
                    :title="item.title"
                    :type-text="pitTypeLabel(item)"
                    :status-text="saleStatusText(item)"
                    :status-color="saleStatusColor(item)"
                    :price-text="priceSummaryText(item)"
                    :image-height="feedImageHeight(item)"
                    :saved="item.saved"
                    @tap="onResultTap(item)"
                    @toggle-save="onToggleSave(item)"
                  />
                </view>
              </view>
              <view :style="resultColRight">
                <view v-for="item in resultRight" :key="item.id">
                  <ProductCard
                    :image="item.coverUrl"
                    :brand="item.brandName"
                    :title="item.title"
                    :type-text="pitTypeLabel(item)"
                    :status-text="saleStatusText(item)"
                    :status-color="saleStatusColor(item)"
                    :price-text="priceSummaryText(item)"
                    :image-height="feedImageHeight(item)"
                    :saved="item.saved"
                    @tap="onResultTap(item)"
                    @toggle-save="onToggleSave(item)"
                  />
                </view>
              </view>
            </view>
            <view :style="loadMoreWrap">
              <AppLoading :visible="isLoadingMore" size="32rpx" />
            </view>
          </view>
          <view v-else :style="emptyWrap">
            <PageState icon="search" title="没有找到相关内容" message="换个商品名或品牌试试" />
          </view>
        </view>
      </view>
    </template>
  </MainLayout>
  <BackToTop :visible="showBackTop" @tap="backToTop" />
</template>

<script setup lang="uts">
import { FeedItem } from '@/domain/content/feed-item'
import { feedImageHeight } from '@/stores/home-feed-store'
import { useContentLibraryStore } from '@/stores/content-library-store'
import { useSearchStore } from '@/stores/search-store'
import { formatPriceSummaryByType, getPitTypeLabel, getSaleStatusChipStatus, ProductStatusLabels } from '@/presentation/content/feed-presenter'
import { brand, semantic, accent } from '@/theme/tokens/colors'
import { fontSize } from '@/theme/tokens/typography'
import { flexRow, flexFill } from '@/theme/layout/flex'
import { PAGE_HEADER_CONTENT_GAP, PAGE_GUTTER_V3, PRODUCT_CARD_WIDTH_V3, COLUMN_GAP_V3, FEED_GUTTER_V3 } from '@/theme/tokens/responsive'
import { zIndex } from '@/theme/tokens/z-index'
import { shadow } from '@/theme/tokens/shadow'
import { n } from '@/theme/use-theme'
import { getStatusBarHeight } from '@/utils/window-info'
import MainLayout from '@/components/layout/MainLayout.uvue'
import AppIcon from '@/components/base/AppIcon.uvue'
import BackToTop from '@/components/base/BackToTop.uvue'
import SectionHeader from '@/components/v3/SectionHeader.uvue'
import ProductCard from '@/components/v3/ProductCard.uvue'
import FeedSkeleton from '@/components/v3/FeedSkeleton.uvue'
import AppLoading from '@/components/base/AppLoading.uvue'
import PageState from '@/components/v3/PageState.uvue'
import { SearchFilters, SearchResult } from '@/services/content/search-service'

// ====== Product V2 商品卡展示字段（价格摘要按 price_type 语义，禁止猜测） ======
function priceSummaryText(item: FeedItem): string {
  return formatPriceSummaryByType(item.priceType, item.price, item.fullPriceCents, item.depositCents, item.balanceCents)
}
function pitTypeLabel(item: FeedItem): string {
  const pit = item.pitType !== '' ? item.pitType : item.category
  return getPitTypeLabel(pit)
}
function saleStatusText(item: FeedItem): string {
  if (item.saleStatus === '') return ''
  const label = ProductStatusLabels[item.saleStatus]
  return label != null ? label as string : ''
}
function saleStatusColor(item: FeedItem): string {
  return getSaleStatusChipStatus(item.saleStatus)
}

const library = useContentLibraryStore()
const searchStore = useSearchStore()

// 返回顶部：lastScrollTop 仅回顶用，非响应式，避免滚动每帧触发重渲染
const scrollTop = ref(0)
let lastScrollTop = 0
const showBackTop = ref(false)
function onPageScroll(top: number) {
  lastScrollTop = top
  if ((top > 300) !== showBackTop.value) showBackTop.value = top > 300
}
function backToTop() {
  showBackTop.value = false
  scrollTop.value = lastScrollTop
  nextTick(() => { scrollTop.value = 0 })
}

const keyword = ref('')
// 页面进入时始终保持静默，不因回填搜索词自动唤起手机键盘。
const inputFocused = ref(false)

// 服务端搜索结果 + 防抖；加载中 / 失败 / 无结果三种独立状态
const results = ref<FeedItem[]>([])
const searching = ref(false)
const searchError = ref('')
const nextCursor = ref('')
const hasMore = ref(true)
const isLoadingMore = ref(false)
const activeSaleStatus = ref('')
const minPrice = ref(0)
const maxPrice = ref(0)
let searchTimer: number | null = null
let searchSequence = 0

function currentFilters(): SearchFilters {
  const filters = new SearchFilters()
  filters.saleStatus = activeSaleStatus.value
  filters.minPrice = minPrice.value
  filters.maxPrice = maxPrice.value
  return filters
}
const hasActiveFilters = computed((): boolean => activeSaleStatus.value !== '' || minPrice.value > 0 || maxPrice.value > 0)
const saleStatusLabel = computed((): string => {
  if (activeSaleStatus.value === 'ON_SALE') return '现货'
  if (activeSaleStatus.value === 'PRE_ORDER') return '预售'
  if (activeSaleStatus.value === 'UPCOMING') return '即将发售'
  if (activeSaleStatus.value === 'SOLD_OUT') return '已售罄'
  return '全部状态'
})
const priceLabel = computed((): string => {
  if (minPrice.value === 0 && maxPrice.value === 0) return '全部价格'
  if (minPrice.value === 0) return `¥${Math.floor(maxPrice.value / 100)} 以下`
  if (maxPrice.value === 0) return `¥${Math.floor(minPrice.value / 100)} 以上`
  return `¥${Math.floor(minPrice.value / 100)}–${Math.floor(maxPrice.value / 100)}`
})

function rerunWithFilters() { if (keyword.value.trim() !== '') runSearch(keyword.value) }
function pickSaleStatus() {
  const labels = ['全部状态', '现货', '预售', '即将发售', '已售罄']
  const values = ['', 'ON_SALE', 'PRE_ORDER', 'UPCOMING', 'SOLD_OUT']
  uni.showActionSheet({ itemList: labels, success: (res) => { activeSaleStatus.value = values[res.tapIndex]; rerunWithFilters() } })
}
function pickPrice() {
  const labels = ['全部价格', '¥300 以下', '¥300–800', '¥800–1500', '¥1500 以上']
  uni.showActionSheet({ itemList: labels, success: (res) => {
    if (res.tapIndex === 0) { minPrice.value = 0; maxPrice.value = 0 }
    else if (res.tapIndex === 1) { minPrice.value = 0; maxPrice.value = 30000 }
    else if (res.tapIndex === 2) { minPrice.value = 30000; maxPrice.value = 80000 }
    else if (res.tapIndex === 3) { minPrice.value = 80000; maxPrice.value = 150000 }
    else { minPrice.value = 150000; maxPrice.value = 0 }
    rerunWithFilters()
  } })
}
function clearFilters() {
  activeSaleStatus.value = ''
  minPrice.value = 0
  maxPrice.value = 0
  rerunWithFilters()
}

// 最近搜索：只展示用户真实搜索记录；首次进入为空。
function loadRecent(): string[] {
  try {
    const raw = uni.getStorageSync('search_recent') as string
    if (raw && raw.length) return JSON.parse(raw) as string[]
  } catch (e) {}
  return []
}
const recent = ref<string[]>(loadRecent())
function saveRecent() {
  try { uni.setStorageSync('search_recent', JSON.stringify(recent.value)) } catch (e) {}
}
function addRecent(value: string) {
  const normalized = value.trim()
  if (normalized === '') return
  const next = [normalized, ...recent.value.filter((k) => k !== normalized)].slice(0, 10)
  recent.value = next
  saveRecent()
}

function runSearch(q: string) {
  const normalized = q.trim()
  if (normalized === '') {
    searchSequence += 1
    results.value = []
    searching.value = false
    searchError.value = ''
    nextCursor.value = ''
    hasMore.value = true
    return
  }

  searchSequence += 1
  const requestSequence = searchSequence
  searching.value = true
  searchError.value = ''
  nextCursor.value = ''
  hasMore.value = true
  searchStore.requestSearchPage(normalized, '', currentFilters())
    .then((res: SearchResult) => {
      // 用户继续输入后，旧请求不得覆盖新关键词的状态。
      if (requestSequence != searchSequence) return
      results.value = res.items
      nextCursor.value = res.nextCursor
      hasMore.value = res.hasMore
      searching.value = false
      addRecent(normalized)
    })
    .catch((err) => {
      if (requestSequence != searchSequence) return
      results.value = []
      searching.value = false
      searchError.value = err instanceof Error ? err.message : '搜索失败，请检查网络后重试'
    })
}

function loadMore() {
  const normalized = keyword.value.trim()
  if (normalized === '' || isLoadingMore.value || !hasMore.value || searching.value) return
  isLoadingMore.value = true
  const requestSequence = searchSequence
  searchStore.requestSearchPage(normalized, nextCursor.value, currentFilters())
    .then((res: SearchResult) => {
      if (requestSequence != searchSequence) return
      results.value = [...results.value, ...res.items]
      nextCursor.value = res.nextCursor
      hasMore.value = res.hasMore
      isLoadingMore.value = false
    })
    .catch(() => {
      if (requestSequence != searchSequence) return
      isLoadingMore.value = false
    })
}

function retrySearch() { runSearch(keyword.value) }

watch(keyword, (val: string) => {
  const timer = searchTimer
  if (timer != null) {
    clearTimeout(timer)
    searchTimer = null
  }
  if (val.trim() !== '') {
    // 输入后立即展示加载反馈，400ms 后才发请求，避免页面看起来毫无反应。
    searching.value = true
    searchError.value = ''
    results.value = []
    searchTimer = setTimeout(() => runSearch(val), 400)
  } else {
    runSearch('')
  }
})

// 编辑推荐：真实内容关键词，不展示虚构热度数字（待接入真实趋势接口后再显示热度）
type HotItem = {
  keyword: string
  heat: string
}
const hotRank: HotItem[] = [
  { keyword: '樱茶JK制服 秋冬系列', heat: '编辑推荐' },
  { keyword: '梦境蝴蝶结 Lolita裙', heat: '编辑推荐' },
  { keyword: '绮灵AI 搭配方案', heat: '编辑推荐' },
  { keyword: '汉服明制 上新', heat: '编辑推荐' },
  { keyword: '甜系 JK小物', heat: '编辑推荐' },
]

function selectKeyword(value: string) {
  keyword.value = value
  addRecent(value)
}
function clearRecent() { recent.value = []; saveRecent() }
function onInput(e: any) {
  const eObj = e as UTSJSONObject
  const d = eObj['detail'] != null ? eObj['detail'] as UTSJSONObject : null
  keyword.value = d != null && d['value'] != null ? d['value'] as string : ''
}
function onSubmit() {
  inputFocused.value = false
  const timer = searchTimer
  if (timer != null) {
    clearTimeout(timer)
    searchTimer = null
  }
  addRecent(keyword.value)
  runSearch(keyword.value)
}
function onClear() { keyword.value = ''; inputFocused.value = false }
function onCancel() {
  if (keyword.value !== '') { keyword.value = ''; inputFocused.value = false }
  else { uni.navigateBack() }
}
function onBackTap() { uni.navigateBack() }
function onResultTap(item: FeedItem) {
  uni.navigateTo({ url: `/pages/product/detail?id=${item.entityId}` })
}
function onToggleSave(item: FeedItem) {
  // 同步翻转服务端 saved（乐观更新，刷新后以服务端权威值为准）
  const next = [...results.value]
  for (let i = 0; i < next.length; i++) {
    if (next[i].id == item.id) { next[i].saved = !next[i].saved; break }
  }
  results.value = next
  library.toggleFavorite(item.entityId, item.title)
}
const resultLeft = computed((): FeedItem[] => {
  const left: FeedItem[] = []
  for (let i = 0; i < results.value.length; i++) {
    if (i % 2 == 0) left.push(results.value[i])
  }
  return left
})
const resultRight = computed((): FeedItem[] => {
  const right: FeedItem[] = []
  for (let i = 0; i < results.value.length; i++) {
    if (i % 2 == 1) right.push(results.value[i])
  }
  return right
})

onUnload(() => {
  const timer = searchTimer
  if (timer != null) clearTimeout(timer)
  searchTimer = null
  searchSequence += 1
})

onMounted(() => {
  try {
    const pending = uni.getStorageSync('pending_search_keyword') as string
    if (pending !== '') {
      keyword.value = pending
      uni.removeStorageSync('pending_search_keyword')
    }
  } catch (e) {}
})

const pageWrap = { paddingTop: PAGE_HEADER_CONTENT_GAP }
const plainSections = { paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const filterScroll = { width: '750rpx', marginBottom: '18rpx' }
const filterRow = { ...flexRow, width: '940rpx', paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
function filterChip(active: boolean): any { return { height: '56rpx', paddingLeft: '22rpx', paddingRight: '22rpx', borderRadius: '28rpx', alignItems: 'center', justifyContent: 'center', backgroundColor: active ? brand[500] : n.value.bgSecondary, marginRight: '12rpx' } }
function filterChipText(active: boolean): any { return { fontSize: fontSize.xs, color: active ? '#FFFFFF' : n.value.textSecondary } }
const clearFilter = { height: '56rpx', paddingLeft: '12rpx', paddingRight: '12rpx', alignItems: 'center', justifyContent: 'center' }
const clearFilterText = { fontSize: fontSize.xs, color: brand[600] }
// 自定义搜索导航栏：返回 64rpx + 输入框 flex:1 + 取消（不再用 AppNavbar 左右各 180rpx 三栏）
const statusBarH = getStatusBarHeight()
const searchNavStyle = computed((): any => ({ position: 'fixed', top: '0', left: '0', right: '0', zIndex: zIndex.navbar, backgroundColor: n.value.bg, boxShadow: shadow.navbar }))
const statusBarPadStyle = { height: `${statusBarH}px` }
const searchRowStyle = { height: '88rpx', ...flexRow, alignItems: 'center', paddingLeft: '4rpx', paddingRight: PAGE_GUTTER_V3 }
const backBtnStyle = { width: '64rpx', height: '88rpx', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }
const inputShellStyle = computed((): any => ({ ...flexRow, alignItems: 'center', flex: 1, minWidth: '0', height: '72rpx', borderRadius: '16rpx', backgroundColor: n.value.inputFill, paddingLeft: '24rpx', paddingRight: '12rpx', marginRight: '8rpx' }))
const inputIconStyle = { width: '40rpx', height: '56rpx', alignItems: 'center', justifyContent: 'center', marginRight: '10rpx', flexShrink: 0 }
const inputStyle = computed((): any => ({ flex: 1, height: '100%', minWidth: '0', fontSize: fontSize.base, color: n.value.text }))
const placeholderStyleStr = computed(() => `color: ${n.value.placeholder}`)
const clearBtnStyle = { width: '56rpx', height: '64rpx', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }
const cancelText = { fontSize: '27rpx', fontWeight: '500', color: brand[600], flexShrink: 0, marginLeft: '16rpx' } as UTSJSONObject

// V3 §6.8 历史 chip：56rpx 胶囊（禁 gap，用 margin）
const recentWrap = { ...flexRow, flexWrap: 'wrap' as string, marginTop: '4rpx' } as UTSJSONObject
function recentChip(idx: number) {
  return { minHeight: '56rpx', paddingLeft: '24rpx', paddingRight: '24rpx', borderRadius: '9999rpx', backgroundColor: n.value.bgSecondary, alignItems: 'center', justifyContent: 'center', flexShrink: 0, marginRight: '12rpx', marginBottom: '12rpx' } as UTSJSONObject
}
const recentChipText = computed((): any => ({ fontSize: '25rpx', fontWeight: '500', color: n.value.text }))

const hotList = { marginTop: '8rpx' } as UTSJSONObject
const hotRow = { ...flexRow, alignItems: 'center', minHeight: '72rpx', paddingVertical: '8rpx' } as UTSJSONObject
function rankText(idx: number) {
  const color = idx === 0 ? brand[500] : idx === 1 ? semantic.warning : idx === 2 ? accent[500] : n.value.textSecondary
  return { width: '44rpx', fontSize: '33rpx', fontWeight: '600', color } as UTSJSONObject
}
const hotKeywordText = computed((): any => ({ ...flexFill, fontSize: '27rpx', fontWeight: '500', color: n.value.text }))
const heatText = { fontSize: '21rpx', fontWeight: '400', color: semantic.warning, marginLeft: '16rpx', flexShrink: 0 } as UTSJSONObject

// V3 §6.8 结果：商品双列错落瀑布流（左右两列独立堆叠，图片高度错落，与首页一致）
const resultColumns = { ...flexRow, alignItems: 'flex-start' as string, paddingLeft: PAGE_GUTTER_V3, paddingRight: PAGE_GUTTER_V3 }
const resultColLeft = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string, marginRight: COLUMN_GAP_V3 }
const resultColRight = { width: PRODUCT_CARD_WIDTH_V3, flexShrink: 0, flexDirection: 'column' as string }
// 加载/空/失败使用 V3 FeedSkeleton / PageState
const emptyWrap = { alignItems: 'center', paddingTop: '48rpx', paddingBottom: '48rpx' }
const loadMoreWrap = { alignItems: 'center', minHeight: '40rpx' }
</script>
