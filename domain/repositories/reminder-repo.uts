/**
 * ReminderRepo — 提醒数据仓库
 */

import { Reminder, ReminderUpdateData } from '@/domain/reminder'
import { localToday, localDateShifted } from '@/utils/date'

import { scopedKey } from '@/utils/user-scope'

const STORAGE_KEY_BASE = 'reminder_items'

/** 当前账号的作用域键（换账号互不串号） */
function storageKey(): string { return scopedKey(STORAGE_KEY_BASE) }
/** 早期调试版种入的模板数据 id，读取时过滤，避免存量污染 */
const TEMPLATE_IDS: string[] = ['r1', 'r2', 'r3', 'r4', 'r5']

function loadAll(): Reminder[] {
  try {
    const raw = uni.getStorageSync(storageKey())
    if (raw == null || raw as string === '') return []
    const arr = JSON.parseArray<UTSJSONObject>(raw as string)
    if (arr == null) return []
    const result: Reminder[] = []
    for (let i = 0; i < arr.length; i++) {
      const obj = arr[i]
      const r = new Reminder()
      r.id = obj['id'] != null ? obj['id'] as string : ''
      r.title = obj['title'] != null ? obj['title'] as string : ''
      r.type = obj['type'] != null ? obj['type'] as string : 'CUSTOM'
      r.remindDate = obj['remindDate'] != null ? obj['remindDate'] as string : ''
      r.remindTime = obj['remindTime'] != null ? obj['remindTime'] as string : ''
      r.isAllDay = obj['isAllDay'] != null ? obj['isAllDay'] as boolean : false
      r.relatedPurchaseId = obj['relatedPurchaseId'] != null ? obj['relatedPurchaseId'] as string : ''
      r.relatedWishId = obj['relatedWishId'] != null ? obj['relatedWishId'] as string : ''
      r.productId = obj['productId'] != null ? obj['productId'] as string : ''
      r.relatedReleaseId = obj['relatedReleaseId'] != null ? obj['relatedReleaseId'] as string : ''
      r.note = obj['note'] != null ? obj['note'] as string : ''
      r.status = obj['status'] != null ? obj['status'] as string : 'PENDING'
      r.isDeleted = obj['isDeleted'] != null ? obj['isDeleted'] as boolean : false
      r.createdAt = obj['createdAt'] != null ? obj['createdAt'] as string : ''
      r.updatedAt = obj['updatedAt'] != null ? obj['updatedAt'] as string : ''
      if (obj['wardrobeBindings'] != null) {
        const wb = obj['wardrobeBindings'] as string[]
        r.wardrobeBindings = wb != null ? wb : ([] as string[])
      }
      result.push(r)
    }
    const cleaned: Reminder[] = []
    for (let i = 0; i < result.length; i++) {
      if (TEMPLATE_IDS.indexOf(result[i].id) >= 0) continue
      cleaned.push(result[i])
    }
    return cleaned
  } catch {
    return []
  }
}

function saveAll(items: Reminder[]) {
  uni.setStorageSync(storageKey(), JSON.stringify(items))
}

function generateId(): string {
  return `${Date.now()}-${Math.floor(Math.random() * 10000)}`
}

export function getAll(): Reminder[] {
  return loadAll().filter((r) => !r.isDeleted)
}

export function getById(id: string): Reminder | null {
  return loadAll().find((r) => r.id == id && !r.isDeleted)
}

export function add(item: Reminder): Reminder {
  const items = loadAll()
  item.id = generateId()
  item.createdAt = new Date().toISOString()
  item.updatedAt = item.createdAt
  items.push(item)
  saveAll(items)
  return item
}

export function update(id: string, data: ReminderUpdateData): boolean {
  const items = loadAll()
  const idx = items.findIndex((r) => r.id == id)
  if (idx < 0) return false
  const r = items[idx]
  // R0 清空语义：null=未提供（跳过）；''/[]=显式清空（覆盖为空），note/date/time/productId/releaseId/wardrobeBindings 均可清空
  if (data.title != null) r.title = data.title
  if (data.type != null) r.type = data.type
  if (data.remindDate != null) r.remindDate = data.remindDate
  if (data.remindTime != null) r.remindTime = data.remindTime
  if (data.isAllDay != null) r.isAllDay = data.isAllDay
  if (data.relatedPurchaseId != null) r.relatedPurchaseId = data.relatedPurchaseId
  if (data.relatedWishId != null) r.relatedWishId = data.relatedWishId
  if (data.productId != null) r.productId = data.productId
  if (data.relatedReleaseId != null) r.relatedReleaseId = data.relatedReleaseId
  if (data.note != null) r.note = data.note
  if (data.status != null) r.status = data.status
  if (data.wardrobeBindings != null) r.wardrobeBindings = data.wardrobeBindings
  r.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function softDelete(id: string): boolean {
  const items = loadAll()
  const r = items.find((item) => item.id == id)
  if (r == null) return false
  r.isDeleted = true
  r.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function persist(items: Reminder[]) {
  saveAll(items)
}

export function markDone(id: string): boolean {
  const items = loadAll()
  const r = items.find((item) => item.id == id)
  if (r == null) return false
  r.status = 'DONE'
  r.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}


/**
 * 用远端快照**替换**本地集合（2026-10-09 评审 P1-4）。
 * 远端恢复必须写进 repo（而非只赋 state），否则新设备上首次编辑/删除会返回 false。
 */
export function replaceAll(items: Reminder[]) {
  saveAll(items)
}
