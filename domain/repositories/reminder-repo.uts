/**
 * ReminderRepo — 提醒数据仓库
 */

import { Reminder, ReminderUpdateData } from '@/domain/reminder'
import { getRuntimeConfig } from '@/config/runtime'

const STORAGE_KEY = 'reminder_items'
/** 早期调试版种入的模板数据 id，读取时过滤，避免存量污染 */
const TEMPLATE_IDS: string[] = ['r1', 'r2', 'r3', 'r4', 'r5']

function loadAll(): Reminder[] {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (raw == null || raw as string === '') return []
    const arr = JSON.parseArray<UTSJSONObject>(raw as string)
    if (arr == null) return []
    const result: Reminder[] = []
    for (let i = 0; i < arr.length; i++) {
      const obj = arr[i]
      const r = new Reminder()
      r.id = obj['id'] != null ? obj['id'] as string : ''
      r.title = obj['title'] != null ? obj['title'] as string : ''
      r.type = obj['type'] != null ? obj['type'] as string : 'CUSTOM'
      r.remindDate = obj['remindDate'] != null ? obj['remindDate'] as string : ''
      r.remindTime = obj['remindTime'] != null ? obj['remindTime'] as string : ''
      r.relatedPurchaseId = obj['relatedPurchaseId'] != null ? obj['relatedPurchaseId'] as string : ''
      r.relatedWishId = obj['relatedWishId'] != null ? obj['relatedWishId'] as string : ''
      r.note = obj['note'] != null ? obj['note'] as string : ''
      r.status = obj['status'] != null ? obj['status'] as string : 'PENDING'
      r.isDeleted = obj['isDeleted'] != null ? obj['isDeleted'] as boolean : false
      r.createdAt = obj['createdAt'] != null ? obj['createdAt'] as string : ''
      r.updatedAt = obj['updatedAt'] != null ? obj['updatedAt'] as string : ''
      result.push(r)
    }
    const cleaned: Reminder[] = []
    for (let i = 0; i < result.length; i++) {
      if (TEMPLATE_IDS.indexOf(result[i].id) >= 0) continue
      cleaned.push(result[i])
    }
    return cleaned
  } catch {
    return []
  }
}

function saveAll(items: Reminder[]) {
  uni.setStorageSync(STORAGE_KEY, JSON.stringify(items))
}

function generateId(): string {
  return `${Date.now()}-${Math.floor(Math.random() * 10000)}`
}

export function getAll(): Reminder[] {
  return loadAll().filter((r) => !r.isDeleted)
}

export function getById(id: string): Reminder | null {
  return loadAll().find((r) => r.id == id && !r.isDeleted)
}

export function add(item: Reminder): Reminder {
  const items = loadAll()
  item.id = generateId()
  item.createdAt = new Date().toISOString()
  item.updatedAt = item.createdAt
  items.push(item)
  saveAll(items)
  return item
}

export function update(id: string, data: ReminderUpdateData): boolean {
  const items = loadAll()
  const idx = items.findIndex((r) => r.id == id)
  if (idx < 0) return false
  const r = items[idx]
  if (data.title != '') r.title = data.title
  if (data.type != '') r.type = data.type
  if (data.remindDate != '') r.remindDate = data.remindDate
  if (data.remindTime != '') r.remindTime = data.remindTime
  if (data.relatedPurchaseId != '') r.relatedPurchaseId = data.relatedPurchaseId
  if (data.relatedWishId != '') r.relatedWishId = data.relatedWishId
  if (data.note != '') r.note = data.note
  if (data.status != '') r.status = data.status
  r.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function softDelete(id: string): boolean {
  const items = loadAll()
  const r = items.find((item) => item.id == id)
  if (r == null) return false
  r.isDeleted = true
  r.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function markDone(id: string): boolean {
  const items = loadAll()
  const r = items.find((item) => item.id == id)
  if (r == null) return false
  r.status = 'DONE'
  r.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function initMockData() {
  if (!getRuntimeConfig().mockOnline) return
  const existing = loadAll()
  if (existing.length > 0) return

  const now = new Date()
  const today = now.toISOString().split('T')[0]
  const tomorrow = new Date(now.getTime() + 86400000).toISOString().split('T')[0]
  const nextWeek = new Date(now.getTime() + 7 * 86400000).toISOString().split('T')[0]
  const yesterday = new Date(now.getTime() - 86400000).toISOString().split('T')[0]
  const nowStr = now.toISOString()

  const mockData: Reminder[] = [
    (() => { const r = new Reminder(); r.id = 'r1'; r.title = '草莓柄 SK 到货'; r.type = 'ARRIVAL'; r.remindDate = today; r.remindTime = '10:00'; r.note = '快递预计今天到'; r.status = 'PENDING'; r.createdAt = nowStr; r.updatedAt = nowStr; return r })(),
    (() => { const r = new Reminder(); r.id = 'r2'; r.title = '宋制套装尾款'; r.type = 'BALANCE'; r.remindDate = tomorrow; r.remindTime = '20:00'; r.note = '尾款 ¥220'; r.status = 'PENDING'; r.createdAt = nowStr; r.updatedAt = nowStr; return r })(),
    (() => { const r = new Reminder(); r.id = 'r3'; r.title = '中牌新品发售'; r.type = 'RELEASE'; r.remindDate = nextWeek; r.remindTime = '12:00'; r.note = '新款格裙预约开始'; r.status = 'PENDING'; r.createdAt = nowStr; r.updatedAt = nowStr; return r })(),
    (() => { const r = new Reminder(); r.id = 'r4'; r.title = '整理衣橱'; r.type = 'CUSTOM'; r.remindDate = nextWeek; r.remindTime = ''; r.note = '换季整理'; r.status = 'PENDING'; r.createdAt = nowStr; r.updatedAt = nowStr; return r })(),
    (() => { const r = new Reminder(); r.id = 'r5'; r.title = '已到货确认'; r.type = 'ARRIVAL'; r.remindDate = yesterday; r.remindTime = '10:00'; r.note = '已签收'; r.status = 'DONE'; r.createdAt = nowStr; r.updatedAt = nowStr; return r })(),
  ]
  saveAll(mockData)
}
