/** PurchaseRepo — 外部购买进度的本地数据仓库。 */

import { PurchaseRecord, PurchaseUpdateData } from '@/domain/purchase-record'
import { getRuntimeConfig } from '@/config/runtime'

const STORAGE_KEY = 'purchase_records'

function loadAll(): PurchaseRecord[] {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (raw == null || raw as string === '') return []
    const arr = JSON.parseArray<UTSJSONObject>(raw as string)
    if (arr == null) return []
    const result: PurchaseRecord[] = []
    for (let i = 0; i < arr.length; i++) {
      const obj = arr[i]
      const r = new PurchaseRecord()
      r.id = obj['id'] != null ? obj['id'] as string : ''
      r.name = obj['name'] != null ? obj['name'] as string : ''
      r.brand = obj['brand'] != null ? obj['brand'] as string : ''
      r.shopName = obj['shopName'] != null ? obj['shopName'] as string : ''
      r.category = obj['category'] != null ? obj['category'] as string : ''
      r.totalAmount = obj['totalAmount'] != null ? obj['totalAmount'] as number : 0
      r.depositAmount = obj['depositAmount'] != null ? obj['depositAmount'] as number : 0
      r.paidAmount = obj['paidAmount'] != null ? obj['paidAmount'] as number : 0
      r.remainingAmount = obj['remainingAmount'] != null ? obj['remainingAmount'] as number : 0
      r.paymentStatus = obj['paymentStatus'] != null ? obj['paymentStatus'] as string : 'PRE_ORDER'
      r.purchaseDate = obj['purchaseDate'] != null ? obj['purchaseDate'] as string : ''
      r.deadline = obj['deadline'] != null ? obj['deadline'] as string : ''
      r.note = obj['note'] != null ? obj['note'] as string : ''
      r.isFavorite = obj['isFavorite'] != null ? obj['isFavorite'] as boolean : false
      r.isDeleted = obj['isDeleted'] != null ? obj['isDeleted'] as boolean : false
      r.createdAt = obj['createdAt'] != null ? obj['createdAt'] as string : ''
      r.updatedAt = obj['updatedAt'] != null ? obj['updatedAt'] as string : ''
      result.push(r)
    }
    return result
  } catch (e) {
    return []
  }
}

function saveAll(records: PurchaseRecord[]) { uni.setStorageSync(STORAGE_KEY, JSON.stringify(records)) }
function generateId(): string { return `${Date.now()}-${Math.floor(Math.random() * 10000)}` }

export function getAll(): PurchaseRecord[] { return loadAll().filter((r) => !r.isDeleted) }
export function getById(id: string): PurchaseRecord | null { return loadAll().find((r) => r.id == id && !r.isDeleted) }

export function add(record: PurchaseRecord): PurchaseRecord {
  const records = loadAll()
  record.id = generateId()
  record.remainingAmount = Math.max(0, record.totalAmount - record.paidAmount)
  record.createdAt = new Date().toISOString()
  record.updatedAt = record.createdAt
  records.push(record)
  saveAll(records)
  return record
}

export function update(id: string, data: PurchaseUpdateData): boolean {
  const records = loadAll()
  const idx = records.findIndex((r) => r.id == id)
  if (idx < 0) return false
  const r = records[idx]
  if (data.name != '') r.name = data.name
  r.brand = data.brand
  r.shopName = data.shopName
  r.category = data.category
  if (data.totalAmount >= 0) r.totalAmount = data.totalAmount
  if (data.depositAmount >= 0) r.depositAmount = data.depositAmount
  if (data.paidAmount >= 0) r.paidAmount = data.paidAmount
  if (data.paymentStatus != '') r.paymentStatus = data.paymentStatus
  r.purchaseDate = data.purchaseDate
  r.deadline = data.deadline
  r.note = data.note
  r.remainingAmount = Math.max(0, r.totalAmount - r.paidAmount)
  r.updatedAt = new Date().toISOString()
  saveAll(records)
  return true
}

export function softDelete(id: string): boolean {
  const records = loadAll()
  const record = records.find((item) => item.id == id)
  if (record == null) return false
  record.isDeleted = true
  record.updatedAt = new Date().toISOString()
  saveAll(records)
  return true
}

export function initMockData() {
  if (!getRuntimeConfig().mockOnline) return
  if (loadAll().length > 0) return
  const now = new Date().toISOString()
  const records: PurchaseRecord[] = []
  function sample(id: string, name: string, brandName: string, total: number, paid: number, status: string, deadline: string): PurchaseRecord {
    const r = new PurchaseRecord()
    r.id = id; r.name = name; r.brand = brandName; r.shopName = `${brandName}官方渠道`; r.totalAmount = total; r.paidAmount = paid
    r.remainingAmount = Math.max(0, total - paid); r.paymentStatus = status; r.deadline = deadline; r.createdAt = now; r.updatedAt = now
    return r
  }
  records.push(sample('p1', '深蓝格裙 45cm', '兔缝缝', 128, 128, 'COMPLETED', ''))
  records.push(sample('p2', '甜系草莓柄 SK', 'Alice兔', 680, 200, 'DEPOSIT_PAID', '2026-08-15'))
  records.push(sample('p3', '哥特十字架 JSK', 'BABY', 1580, 0, 'PRE_ORDER', '2026-10-01'))
  records.push(sample('p4', '宋制旋裙套装', '重回汉唐', 320, 100, 'BALANCE_PENDING', '2026-07-20'))
  saveAll(records)
}
