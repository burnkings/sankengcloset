/**
 * WishlistRepo — 心愿单数据仓库
 */

import { WishItem, WishUpdateData } from '@/domain/wish-item'

const STORAGE_KEY = 'wishlist_items'

function loadAll(): WishItem[] {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (raw == null || raw as string === '') return []
    const arr = JSON.parseArray<UTSJSONObject>(raw as string)
    if (arr == null) return []
    const result: WishItem[] = []
    for (let i = 0; i < arr.length; i++) {
      const obj = arr[i]
      const w = new WishItem()
      w.id = obj['id'] != null ? obj['id'] as string : ''
      w.name = obj['name'] != null ? obj['name'] as string : ''
      w.coverImage = obj['coverImage'] != null ? obj['coverImage'] as string : ''
      w.brand = obj['brand'] != null ? obj['brand'] as string : ''
      w.estimatedPrice = obj['estimatedPrice'] != null ? obj['estimatedPrice'] as number : 0
      w.priority = obj['priority'] != null ? obj['priority'] as string : 'MEDIUM'
      w.status = obj['status'] != null ? obj['status'] as string : 'WISH'
      w.source = obj['source'] != null ? obj['source'] as string : 'MANUAL'
      w.wardrobeId = obj['wardrobeId'] != null ? obj['wardrobeId'] as string : ''
      w.purchaseId = obj['purchaseId'] != null ? obj['purchaseId'] as string : ''
      w.convertedAt = obj['convertedAt'] != null ? obj['convertedAt'] as string : ''
      w.note = obj['note'] != null ? obj['note'] as string : ''
      w.url = obj['url'] != null ? obj['url'] as string : ''
      w.isFavorite = obj['isFavorite'] != null ? obj['isFavorite'] as boolean : false
      w.isDeleted = obj['isDeleted'] != null ? obj['isDeleted'] as boolean : false
      w.createdAt = obj['createdAt'] != null ? obj['createdAt'] as string : ''
      w.updatedAt = obj['updatedAt'] != null ? obj['updatedAt'] as string : ''
      result.push(w)
    }
    return result
  } catch {
    return []
  }
}

function saveAll(items: WishItem[]) {
  uni.setStorageSync(STORAGE_KEY, JSON.stringify(items))
}

function generateId(): string {
  return `${Date.now()}-${Math.floor(Math.random() * 10000)}`
}

export function getAll(): WishItem[] {
  return loadAll().filter((w) => !w.isDeleted)
}

export function getById(id: string): WishItem | null {
  return loadAll().find((w) => w.id == id && !w.isDeleted)
}

export function add(item: WishItem): WishItem {
  const items = loadAll()
  item.id = generateId()
  item.createdAt = new Date().toISOString()
  item.updatedAt = item.createdAt
  items.push(item)
  saveAll(items)
  return item
}

export function update(id: string, data: WishUpdateData): boolean {
  const items = loadAll()
  const idx = items.findIndex((w) => w.id == id)
  if (idx < 0) return false
  const w = items[idx]
  if (data.name != '') w.name = data.name
  if (data.coverImage != '') w.coverImage = data.coverImage
  if (data.brand != '') w.brand = data.brand
  if (data.estimatedPrice >= 0) w.estimatedPrice = data.estimatedPrice
  if (data.priority != '') w.priority = data.priority
  if (data.status != '') w.status = data.status
  if (data.note != '') w.note = data.note
  if (data.url != '') w.url = data.url
  w.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function softDelete(id: string): boolean {
  const items = loadAll()
  const w = items.find((item) => item.id == id)
  if (w == null) return false
  w.isDeleted = true
  w.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function changeStatus(id: string, newStatus: string): boolean {
  const items = loadAll()
  const w = items.find((item) => item.id == id)
  if (w == null) return false
  w.status = newStatus
  w.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function markPurchased(id: string, purchaseId: string): boolean {
  const items = loadAll()
  const w = items.find((item) => item.id == id)
  if (w == null) return false
  w.status = 'PURCHASED'
  w.purchaseId = purchaseId
  w.convertedAt = new Date().toISOString()
  w.updatedAt = w.convertedAt
  saveAll(items)
  return true
}

export function linkWardrobe(id: string, wardrobeId: string): boolean {
  const items = loadAll()
  const w = items.find((item) => item.id == id)
  if (w == null) return false
  w.wardrobeId = wardrobeId
  w.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function toggleFavorite(id: string): boolean {
  const items = loadAll()
  const w = items.find((item) => item.id == id)
  if (w == null) return false
  w.isFavorite = !w.isFavorite
  w.updatedAt = new Date().toISOString()
  saveAll(items)
  return true
}

export function addMany(newItems: WishItem[]): WishItem[] {
  const items = loadAll()
  const now = new Date().toISOString()
  for (let i = 0; i < newItems.length; i++) {
    const w = newItems[i]
    w.id = generateId()
    w.createdAt = now
    w.updatedAt = now
    items.push(w)
  }
  saveAll(items)
  return newItems
}

export function updateMany(ids: string[], data: WishUpdateData): number {
  const items = loadAll()
  let count = 0
  for (let i = 0; i < ids.length; i++) {
    const id = ids[i]
    const w = items.find((item) => item.id == id)
    if (w != null) {
      if (data.status != '') w.status = data.status
      if (data.priority != '') w.priority = data.priority
      w.updatedAt = new Date().toISOString()
      count++
    }
  }
  saveAll(items)
  return count
}

export function deleteMany(ids: string[]): number {
  const items = loadAll()
  let count = 0
  for (let i = 0; i < ids.length; i++) {
    const id = ids[i]
    const w = items.find((item) => item.id == id)
    if (w != null) {
      w.isDeleted = true
      w.updatedAt = new Date().toISOString()
      count++
    }
  }
  saveAll(items)
  return count
}

