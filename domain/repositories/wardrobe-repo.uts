import { WardrobeItem, WardrobeUpdateData } from '@/domain/wardrobe-item'

const STORAGE_KEY = 'wardrobe_items'

function loadAll(): WardrobeItem[] {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (!raw) return []
    const arr = JSON.parse(raw) as any[]
    return arr.map((obj) => {
      const item = new WardrobeItem()
      item.id = obj.id ?? ''; item.name = obj.name ?? ''; item.category = obj.category ?? 'OTHER'; item.style = obj.style ?? ''; item.brand = obj.brand ?? ''
      item.color = obj.color ?? ''; item.size = obj.size ?? ''; item.wearStatus = obj.wearStatus ?? 'UNWORN'; item.seasons = obj.seasons ?? []
      item.images = obj.images ?? []; item.tags = obj.tags ?? []; item.purchaseDate = obj.purchaseDate ?? ''; item.purchasePrice = obj.purchasePrice ?? 0
      item.purchaseSource = obj.purchaseSource ?? ''; item.note = obj.note ?? ''; item.isFavorite = obj.isFavorite ?? false; item.isDeleted = obj.isDeleted ?? false
      item.createdAt = obj.createdAt ?? ''; item.updatedAt = obj.updatedAt ?? ''
      return item
    })
  } catch (e) { return [] }
}
function saveAll(items: WardrobeItem[]) { uni.setStorageSync(STORAGE_KEY, JSON.stringify(items)) }
function generateId(): string { return `${Date.now()}-${Math.floor(Math.random() * 10000)}` }
export function getAll(): WardrobeItem[] { return loadAll().filter((item) => !item.isDeleted) }
export function getById(id: string): WardrobeItem | undefined { return loadAll().find((item) => item.id == id && !item.isDeleted) }

export function add(item: WardrobeItem): WardrobeItem {
  const items = loadAll(); item.id = generateId(); item.createdAt = new Date().toISOString(); item.updatedAt = item.createdAt; items.push(item); saveAll(items); return item
}
export function update(id: string, data: WardrobeUpdateData): boolean {
  const items = loadAll(); const item = items.find((entry) => entry.id == id); if (item == null) return false
  if (data.name != '') item.name = data.name
  if (data.category != '') item.category = data.category
  item.style = data.style; item.brand = data.brand; item.color = data.color; item.size = data.size
  if (data.wearStatus != '') item.wearStatus = data.wearStatus
  item.images = data.images; item.purchaseDate = data.purchaseDate
  if (data.purchasePrice >= 0) item.purchasePrice = data.purchasePrice
  item.purchaseSource = data.purchaseSource; item.note = data.note; item.updatedAt = new Date().toISOString(); saveAll(items); return true
}
export function softDelete(id: string): boolean {
  const items = loadAll(); const item = items.find((entry) => entry.id == id); if (item == null) return false
  item.isDeleted = true; item.updatedAt = new Date().toISOString(); saveAll(items); return true
}
export function toggleFavorite(id: string): boolean {
  const items = loadAll(); const item = items.find((entry) => entry.id == id); if (item == null) return false
  item.isFavorite = !item.isFavorite; item.updatedAt = new Date().toISOString(); saveAll(items); return true
}
export function initMockData() {
  if (loadAll().length > 0) return
  const now = new Date().toISOString(); const items: WardrobeItem[] = []
  function sample(id: string, name: string, category: string, brand: string, price: number): WardrobeItem {
    const item = new WardrobeItem(); item.id = id; item.name = name; item.category = category; item.brand = brand; item.purchasePrice = price; item.createdAt = now; item.updatedAt = now; return item
  }
  items.push(sample('1', '深蓝格裙 45cm', 'JK', '兔缝缝', 128)); items.push(sample('2', '白无本水手服', 'JK', '月野house', 89))
  items.push(sample('3', '甜系草莓柄 SK', 'LOLITA', 'Alice兔', 680)); items.push(sample('4', '哥特十字架 JSK', 'LOLITA', 'BABY', 1580))
  items.push(sample('5', '宋制旋裙套装', 'HANFU', '重回汉唐', 320)); items.push(sample('6', '明制马面裙', 'HANFU', '汉尚华莲', 450)); saveAll(items)
}
