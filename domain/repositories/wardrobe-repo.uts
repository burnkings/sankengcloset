import { WardrobeItem, WardrobeUpdateData } from '@/domain/wardrobe-item'
import { scopedKey } from '@/utils/user-scope'

const STORAGE_KEY_BASE = 'wardrobe_items'

/** 当前账号的作用域键（换账号后自动指向新账号的数据，互不串号） */
function storageKey(): string { return scopedKey(STORAGE_KEY_BASE) }

function loadAll(): WardrobeItem[] {
  try {
    const raw = uni.getStorageSync(storageKey())
    if (raw == null || raw as string === '') return []
    const arr = JSON.parseArray<UTSJSONObject>(raw as string)
    if (arr == null) return []
    const result: WardrobeItem[] = []
    for (let i = 0; i < arr.length; i++) {
      const obj = arr[i]
      const item = new WardrobeItem()
      item.id = obj['id'] != null ? obj['id'] as string : ''; item.name = obj['name'] != null ? obj['name'] as string : ''; item.category = obj['category'] != null ? obj['category'] as string : 'OTHER'; item.style = obj['style'] != null ? obj['style'] as string : ''; item.brand = obj['brand'] != null ? obj['brand'] as string : ''
      item.silhouette = obj['silhouette'] != null ? obj['silhouette'] as string : ''
      item.color = obj['color'] != null ? obj['color'] as string : ''; item.size = obj['size'] != null ? obj['size'] as string : ''; item.wearStatus = obj['wearStatus'] != null ? obj['wearStatus'] as string : 'UNWORN'; item.seasons = obj['seasons'] != null ? obj['seasons'] as string[] : []
      item.images = obj['images'] != null ? obj['images'] as string[] : []; item.tags = obj['tags'] != null ? obj['tags'] as string[] : []; item.purchaseDate = obj['purchaseDate'] != null ? obj['purchaseDate'] as string : ''; item.purchasePrice = obj['purchasePrice'] != null ? obj['purchasePrice'] as number : 0
      item.purchaseSource = obj['purchaseSource'] != null ? obj['purchaseSource'] as string : ''; item.note = obj['note'] != null ? obj['note'] as string : ''; item.isFavorite = obj['isFavorite'] != null ? obj['isFavorite'] as boolean : false; item.isDeleted = obj['isDeleted'] != null ? obj['isDeleted'] as boolean : false
      item.purchaseId = obj['purchaseId'] != null ? obj['purchaseId'] as string : ''; item.wishId = obj['wishId'] != null ? obj['wishId'] as string : ''
      item.createdAt = obj['createdAt'] != null ? obj['createdAt'] as string : ''; item.updatedAt = obj['updatedAt'] != null ? obj['updatedAt'] as string : ''
      result.push(item)
    }
    return result
  } catch (e) { return [] }
}
// vapor 模式下直接 JSON.stringify(class 实例数组) 会因原型/数组字段触发
// "Cannot convert undefined or null to object"，这里手动转纯对象再序列化。
function toPlainObject(item: WardrobeItem): UTSJSONObject {
  return {
    id: item.id,
    name: item.name,
    category: item.category,
    style: item.style,
    silhouette: item.silhouette,
    brand: item.brand,
    color: item.color,
    size: item.size,
    wearStatus: item.wearStatus,
    seasons: item.seasons,
    images: item.images,
    tags: item.tags,
    purchaseDate: item.purchaseDate,
    purchasePrice: item.purchasePrice,
    purchaseSource: item.purchaseSource,
    note: item.note,
    isFavorite: item.isFavorite,
    isDeleted: item.isDeleted,
    purchaseId: item.purchaseId,
    wishId: item.wishId,
    createdAt: item.createdAt,
    updatedAt: item.updatedAt,
  } as UTSJSONObject
}

function saveAll(items: WardrobeItem[]) {
  const plain: UTSJSONObject[] = []
  for (let i = 0; i < items.length; i++) plain.push(toPlainObject(items[i]))
  uni.setStorageSync(storageKey(), JSON.stringify(plain))
}
function generateId(): string { return `${Date.now()}-${Math.floor(Math.random() * 10000)}` }
export function getAll(): WardrobeItem[] { return loadAll().filter((item) => !item.isDeleted) }
export function getById(id: string): WardrobeItem | null { return loadAll().find((item) => item.id == id && !item.isDeleted) }

export function add(item: WardrobeItem): WardrobeItem {
  const items = loadAll(); item.id = generateId(); item.createdAt = new Date().toISOString(); item.updatedAt = item.createdAt; items.push(item); saveAll(items); return item
}
export function update(id: string, data: WardrobeUpdateData): boolean {
  const items = loadAll(); const item = items.find((entry) => entry.id == id); if (item == null) return false
  if (data.name != '') item.name = data.name
  if (data.category != '') item.category = data.category
  item.silhouette = item.category === 'HANFU' ? data.silhouette : ''
  item.style = data.style; item.brand = data.brand; item.color = data.color; item.size = data.size
  if (data.wearStatus != '') item.wearStatus = data.wearStatus
  item.images = data.images; item.purchaseDate = data.purchaseDate
  if (data.purchasePrice >= 0) item.purchasePrice = data.purchasePrice
  item.purchaseSource = data.purchaseSource; item.note = data.note; item.updatedAt = new Date().toISOString(); saveAll(items); return true
}
export function softDelete(id: string): boolean {
  const items = loadAll(); const item = items.find((entry) => entry.id == id); if (item == null) return false
  item.isDeleted = true; item.updatedAt = new Date().toISOString(); saveAll(items); return true
}
export function toggleFavorite(id: string): boolean {
  const items = loadAll(); const item = items.find((entry) => entry.id == id); if (item == null) return false
  item.isFavorite = !item.isFavorite; item.updatedAt = new Date().toISOString(); saveAll(items); return true
}

/**
 * 用远端快照**替换**本地集合（2026-10-09 评审 P1-4）。
 *
 * ⚠️ 为什么必须有：`fetchItems` 的远端分支原本只赋 `_state.items`，
 *    从不写 repo ⇒ 新设备上「state 里有、repo 里没有」，
 *    而 update/softDelete/toggleFavorite 全都从 repo.loadAll() 找 ID
 *    ⇒ **首次编辑/删除/收藏一律返回 false**，甚至连远端请求都不发。
 *    修法：远端恢复时把快照合并进 repo，让 state 与 CRUD 读写**同一个源**。
 *
 * 保留规则：本会话中尚未同步成功的本地改动（以 repo 现有项为准）不被远端旧快照覆盖。
 */
export function replaceAll(items: WardrobeItem[]) {
  saveAll(items)
}
