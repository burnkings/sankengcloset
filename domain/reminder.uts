// ====== 筛选选项 ======

export class ReminderFilterOption {
  label: string = ''
  value: string = ''
}

function createReminderFilterOption(l: string, v: string): ReminderFilterOption {
  const o = new ReminderFilterOption()
  o.label = l
  o.value = v
  return o
}

export const REMINDER_FILTER_OPTIONS: ReminderFilterOption[] = [
  createReminderFilterOption('全部', ''),
  createReminderFilterOption('待提醒', 'PENDING'),
  createReminderFilterOption('已完成', 'DONE'),
  createReminderFilterOption('已过期', 'MISSED'),
]

// ====== 数据模型 ======

export class Reminder {
  id: string = ''
  title: string = ''
  type: string = 'CHECKIN' // ARRIVAL / BALANCE / RELEASE / CUSTOM
  remindDate: string = '' // YYYY-MM-DD
  remindTime: string = '' // HH:mm
  isAllDay: boolean = false
  relatedPurchaseId: string = ''
  relatedWishId: string = ''
  // Phase 1.1-C：商品锚 + 批次锚（Favorite → Release → Reminder 闭环）
  // relatedWishId 是旧 /me/wishes 体系字段，保留兼容但不再是当前 Favorite 主锚点
  productId: string = ''
  relatedReleaseId: string = ''
  note: string = ''
  status: string = 'PENDING' // PENDING / DONE / MISSED
  isDeleted: boolean = false
  createdAt: string = ''
  updatedAt: string = ''
  wardrobeBindings: string[] = []
}

/** 更新数据 */
export class ReminderUpdateData {
  title: string = ''
  type: string = ''
  remindDate: string = ''
  remindTime: string = ''
  isAllDay: boolean = false
  relatedPurchaseId: string = ''
  relatedWishId: string = ''
  productId: string = ''
  relatedReleaseId: string = ''
  note: string = ''
  status: string = ''
  wardrobeBindings: string[] = []
}
