// ====== 提醒状态 ======

export const STATUS_PENDING = 'PENDING'
export const STATUS_DONE = 'DONE'
export const STATUS_MISSED = 'MISSED'

export const STATUS_LABELS = {
  PENDING: '待提醒',
  DONE: '已完成',
  MISSED: '已过期',
}

export const STATUS_COLORS = {
  PENDING: '#3B82F6',
  DONE: '#52C41A',
  MISSED: '#9CA3AF',
}

export const STATUS_COLORS_DARK = {
  PENDING: '#69B1FF',
  DONE: '#73D13D',
  MISSED: '#8C8C8C',
