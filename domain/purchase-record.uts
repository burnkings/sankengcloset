/**
 * PurchaseRecord — 外部购买决策与进度记录。
 * 仅记录用户在官方渠道的消费计划，不代表应用内订单。
 */

export const STATUS_PRE_ORDER = 'PRE_ORDER'
export const STATUS_DEPOSIT_PAID = 'DEPOSIT_PAID'
export const STATUS_BALANCE_PENDING = 'BALANCE_PENDING'
export const STATUS_COMPLETED = 'COMPLETED'
export const STATUS_CANCELLED = 'CANCELLED'

export const PAYMENT_STATUS_LABELS = {
  PRE_ORDER: '预售中',
  DEPOSIT_PAID: '已付定金',
  BALANCE_PENDING: '待付款',
  COMPLETED: '已完成',
  CANCELLED: '已取消',
}

export const PAYMENT_STATUS_COLORS = {
  PRE_ORDER: '#9B8AC4',
  DEPOSIT_PAID: '#D98898',
  BALANCE_PENDING: '#E8956A',
  COMPLETED: '#7BB896',
  CANCELLED: '#9C9698',
}

export class PurchaseRecord {
  id: string = ''
  name: string = ''
  brand: string = ''
  shopName: string = ''
  category: string = ''
  totalAmount: number = 0
  depositAmount: number = 0
  paidAmount: number = 0
  remainingAmount: number = 0
  paymentStatus: string = 'PRE_ORDER'
  purchaseDate: string = ''
  deadline: string = ''
  note: string = ''
  isFavorite: boolean = false
  isDeleted: boolean = false
  createdAt: string = ''
  updatedAt: string = ''
}

/** 显式更新契约，避免页面向仓库透传 any。 */
export class PurchaseUpdateData {
  name: string = ''
  brand: string = ''
  shopName: string = ''
  category: string = ''
  totalAmount: number = -1
  depositAmount: number = -1
  paidAmount: number = -1
  paymentStatus: string = ''
  purchaseDate: string = ''
  deadline: string = ''
  note: string = ''
}

export class FilterOption {
  label: string = ''
  value: string = ''
}

function createFilterOption(l: string, v: string): FilterOption {
  const o = new FilterOption()
  o.label = l
  o.value = v
  return o
}

export const PURCHASE_FILTER_OPTIONS: FilterOption[] = [
  createFilterOption('全部', ''),
  createFilterOption('预售中', 'PRE_ORDER'),
  createFilterOption('已付定金', 'DEPOSIT_PAID'),
  createFilterOption('待付款', 'BALANCE_PENDING'),
  createFilterOption('已完成', 'COMPLETED'),
  createFilterOption('已取消', 'CANCELLED'),
]
