// ====== 日期工具 ======

function futureDate(days: number): string {
  const d = new Date()
  d.setDate(d.getDate() + days)
  return d.toISOString()
}

// ====== 生成 FeedItem ======

function makeProductFeed(idx: number): FeedItem {
  const p = PRODUCTS[idx % PRODUCTS.length]
  const b = BRANDS[p.brand]
  const item = new FeedItem()
  item.id = `feed-${p.id}-${idx}`
  item.feedType = FEED_PRODUCT
  item.entityId = p.id
  item.title = p.title
  item.subtitle = b.name
  item.coverUrl = '/static/demo/prod-editorial-' + String((idx % 3) + 1).padStart(2, '0') + '.jpg'
  item.secondaryCoverUrl = '/static/demo/prod-editorial-' + String(((idx + 1) % 3) + 1).padStart(2, '0') + '.jpg'
  item.brandId = b.id
  item.brandName = b.name
  item.price = p.price
  item.originalPrice = p.badge === '降价' ? Math.floor(p.price * 1.3) : p.price
  item.badgeText = p.badge
  if (p.badge === '预售') {
    item.eventStartAt = futureDate(0)
    item.eventEndAt = futureDate(4 + (idx % 4))
  }
  item.liked = idx % 7 === 0
  item.saved = idx % 11 === 0
  item.sourceLabel = '官方'
  item.rankingScore = 100 - idx
  item.category = p.category
  item.createdAt = futureDate(-idx)
  return item
}

function makeEventFeed(idx: number): FeedItem {
  const e = RELEASE_EVENTS[idx % RELEASE_EVENTS.length]
  const b = BRANDS[e.brand]
  const item = new FeedItem()
  item.id = `feed-${e.id}-${idx}`
  item.feedType = FEED_RELEASE_EVENT
  item.entityId = e.id
  item.title = e.title
  item.subtitle = `${getEventTypeLabel(e.eventType)} · ${e.daysFromNow >= 0 ? e.daysFromNow + '天后' : Math.abs(e.daysFromNow) + '天前'}`
  item.coverUrl = idx % 2 == 0 ? '/static/demo/outfit-editorial-01.jpg' : '/static/demo/prod-editorial-02.jpg'
  item.secondaryCoverUrl = idx % 2 == 0 ? '/static/demo/prod-editorial-03.jpg' : '/static/demo/outfit-editorial-01.jpg'
  item.brandId = b.id
  item.brandName = b.name
  item.price = e.price
  item.badgeText = e.badge
  item.eventStartAt = futureDate(e.daysFromNow)
  item.eventEndAt = futureDate(e.daysFromNow + 3)
  item.liked = false
  item.saved = idx % 5 === 0
  item.sourceLabel = '官方'
  item.rankingScore = 200 - e.daysFromNow
  item.category = e.category
  item.createdAt = futureDate(-1)
  return item
}

function makePostFeed(idx: number): FeedItem {
  const p = BRAND_POSTS[idx % BRAND_POSTS.length]
  const b = BRANDS[p.brand]
  const item = new FeedItem()
  item.id = `feed-${p.id}-${idx}`
  item.feedType = FEED_BRAND_POST
  item.entityId = p.id
  item.title = p.title
  item.subtitle = b.name
  item.coverUrl = idx % 2 == 0 ? '/static/demo/outfit-editorial-01.jpg' : '/static/demo/prod-editorial-03.jpg'
  item.brandId = b.id
  item.brandName = b.name
  item.badgeText = p.badge
  item.liked = idx % 9 === 0
  item.sourceLabel = '品牌'
  item.rankingScore = 80
  item.category = p.category
  item.createdAt = futureDate(-2)
  return item
}

function makeOutfitFeed(idx: number): FeedItem {
  const o = OUTFITS[idx % OUTFITS.length]
  const item = new FeedItem()
  item.id = `feed-${o.id}-${idx}`
  item.feedType = FEED_OUTFIT
  item.entityId = o.id
  item.title = o.title
  item.subtitle = '用户投稿'
  item.coverUrl = '/static/demo/outfit-editorial-01.jpg'
  item.badgeText = o.badge
  item.liked = idx % 6 === 0
  item.sourceLabel = '用户'
  item.rankingScore = 90
  item.category = o.category
  item.createdAt = futureDate(-3)
  return item
}

// ====== 生成规则: 每页 20 条，按类型轮转 ======

function generatePage(page: number, pageSize: number): FeedItem[] {
  const items: FeedItem[] = []
  const startIdx = page * pageSize
  for (let i = 0; i < pageSize; i++) {
    const globalIdx = startIdx + i
    const slot = globalIdx % 10
    if (slot < 5) {
      items.push(makeProductFeed(globalIdx))
    } else if (slot < 7) {
      items.push(makeEventFeed(globalIdx))
    } else if (slot < 9) {
      items.push(makePostFeed(globalIdx))
    } else {
      items.push(makeOutfitFeed(globalIdx))
    }
  }
  return items
}

// ====== 公开 API ======

const PAGE_SIZE = 20
const MAX_PAGES = 5 // 最多 100 条

export function getFeedPage(page: number): FeedItem[] {
  if (page >= MAX_PAGES) return []
  return generatePage(page, PAGE_SIZE)
}

export function getFirstPage(): FeedItem[] {
  return getFeedPage(0)
}

export function getPageSize(): number {
  return PAGE_SIZE
}

export function getMaxItems(): number {
  return MAX_PAGES * PAGE_SIZE
}

/** 按频道筛选 */
export function filterByChannel(items: FeedItem[], channel: string): FeedItem[] {
  if (channel === '' || channel === '推荐') return items
  if (channel === '新品') return items.filter((i) => i.badgeText === '新品')
  if (channel === '预约') return items.filter((i) => i.feedType === FEED_RELEASE_EVENT && (i.badgeText === '预约' || i.badgeText === '定金'))
  if (channel === '降价') return items.filter((i) => i.badgeText === '降价')
  if (channel === '穿搭') return items.filter((i) => i.feedType === FEED_OUTFIT)
  // 分类频道
  return items.filter((i) => i.category === channel)
}
