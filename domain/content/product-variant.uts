/**
 * ProductVariant — 商品规格变体
 * 同一 Product 的不同颜色/尺码组合
 *
 * 展示层 Labels/Colors 见 presentation/content/feed-presenter.uts
 */

// ====== 库存状态 (纯值) ======

export const STOCK_IN_STOCK = 'IN_STOCK'
export const STOCK_LOW_STOCK = 'LOW_STOCK'
export const STOCK_OUT_OF_STOCK = 'OUT_OF_STOCK'
export const STOCK_PRE_ORDER = 'PRE_ORDER'

// ====== 数据模型 ======

export class ProductVariant {
  id: string = ''
  productId: string = ''
  name: string = ''           // "粉色 S" / "蓝色 M"
  colorName: string = ''      // 粉色、蓝色、白色
  sizeName: string = ''       // S / M / L / 均码
  skuCode: string = ''
  price: number = 0           // 分
  stockStatus: string = 'IN_STOCK'
  imageUrl: string = ''
  createdAt: string = ''
  updatedAt: string = ''
}
