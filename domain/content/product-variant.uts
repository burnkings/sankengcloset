/**
 * ProductVariant — 商品规格变体 (12-table schema)
 * 同一 Product 的不同颜色/尺码组合
 *
 * 展示层 Labels/Colors 见 presentation/content/feed-presenter.uts
 *
 * ★ 12-table schema: variants no longer carry skuCode, price, or stockStatus.
 *   These fields are now on the product_releases table or derived elsewhere.
 *   Variant only carries identity/descriptive fields: id, name, styleName, colorName, sizeName.
 */

// ====== 数据模型 ======

export class ProductVariant {
  id: string = ''
  productId: string = ''
  name: string = ''           // "粉色 S" / "蓝色 M"
  colorName: string = ''      // 粉色、蓝色、白色
  sizeName: string = ''       // S / M / L / 均码
  styleName: string = ''      // 型别：JSK / OP / SK / 背带（Lolita 的一个链接可能同时卖 JSK+OP，所以挂在变体上）
}
