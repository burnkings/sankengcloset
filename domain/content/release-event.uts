/**
 * ReleaseEvent — 发售事件
 * 商品生命周期中的关键节点：预览、预约、定金、尾款、发售、补货、降价
 */

// ====== 事件类型 ======

export const EVENT_PREVIEW = 'preview'
export const EVENT_RESERVATION = 'reservation'
export const EVENT_DEPOSIT = 'deposit'
export const EVENT_FINAL_PAYMENT = 'final_payment'
export const EVENT_RELEASE = 'release'
export const EVENT_RESTOCK = 'restock'
export const EVENT_PRICE_DROP = 'price_drop'

export class EventTypeLabels {
  static readonly preview = '预览'
  static readonly reservation = '预约'
  static readonly deposit = '定金'
  static readonly final_payment = '尾款'
  static readonly release = '发售'
  static readonly restock = '补货'
  static readonly price_drop = '降价'
}

export const EVENT_TYPE_COLORS = {
  preview: '#8B5CF6',
  reservation: '#6366F1',
  deposit: '#F59E0B',
  final_payment: '#FF4D7E',
  release: '#22C55E',
  restock: '#3B82F6',
  price_drop: '#EF4444',
} as any

export const EVENT_TYPE_EMOJI = {
  preview: '👀',
  reservation: '📋',
  deposit: '💰',
  final_payment: '💳',
  release: '🎉',
  restock: '📦',
  price_drop: '🏷️',
} as any

// ====== 事件状态 ======

export const EVENT_UPCOMING = 'upcoming'
export const EVENT_ACTIVE = 'active'
export const EVENT_ENDED = 'ended'
export const EVENT_CANCELLED = 'cancelled'

export class EventStatusLabels {
  static readonly upcoming = '未开始'
  static readonly active = '进行中'
  static readonly ended = '已结束'
  static readonly cancelled = '已取消'
}

// ====== 数据模型 ======

export class ReleaseEvent {
  id: string = ''
  productId: string = ''
  brandId: string = ''
  eventType: string = 'release'
  title: string = ''          // "星辰猫 × 月光曲 定金开售"
  description: string = ''
  startAt: string = ''        // ISO 8601
  endAt: string = ''
  depositAmount: number = 0   // 分
  finalPaymentAmount: number = 0 // 分
  status: string = 'upcoming'
  sourceId: string = ''       // 关联 SourceRecord
  imageUrl: string = ''
  shopUrl: string = ''
  createdAt: string = ''
  updatedAt: string = ''
}
