/**
 * community-topics — 圈子话题清单（**唯一口径**）
 *
 * 发布页（`pages/share/create`）和动态页的话题筛选（`pages/community/index`）必须用同一份。
 * 2026-10-04 的 bug 就是两处各写了一套：发布页 8 个话题，筛选里却是
 * 「今日穿搭 / 茶会搭配 / 通勤三坑」——用户挑了一个话题发出去，回头在筛选里根本找不到它。
 *
 * 划分原则：**每个话题回答一个不同的问题**，彼此不重叠，也不与「坑向」（JK/Lolita/汉服/混搭）重复。
 *   今日穿搭 → 今天穿了什么（展示）
 *   开箱测评 → 新到的怎么样（评价）
 *   避雷拔草 → 别买什么（负向提醒）
 *   手作改造 → 我改了什么（DIY）
 *   出片分享 → 怎么拍好看（摄影）
 *   妆造分享 → 妆发怎么弄（妆造，三坑独立高频内容）
 *   萌新入坑 → 新手怎么开始（入门求助）
 *   同好交流 → 找人聊天（社交）
 *
 * 2026-10-04 按反馈删掉了「好价情报」（价格向）和「洗护收纳」（工具向）——
 * 这两个方向会把内容流带成比价/攻略站；补进来的两个仍走「内容/社交」轴。
 */
export const COMMUNITY_TOPICS: string[] = [
  '今日穿搭',
  '开箱测评',
  '避雷拔草',
  '手作改造',
  '出片分享',
  '妆造分享',
  '萌新入坑',
  '同好交流',
]
