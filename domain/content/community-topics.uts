/**
 * community-topics — 圈子话题清单（**唯一口径**）
 *
 * 发布页（`pages/share/create`）和动态页的话题筛选（`pages/community/index`）必须用同一份。
 * 2026-10-04 的 bug 就是两处各写了一套：发布页 8 个话题，筛选里却是
 * 「今日穿搭 / 茶会搭配 / 通勤三坑」——用户挑了一个话题发出去，回头在筛选里根本找不到它。
 *
 * ── 划分原则（2026-10-11 重写）──────────────────────────────
 * **每个话题必须回答一个不同的「我要什么」**，而不是描述一个模糊的调性。
 * 判定标准：同一条动态**只应该落在一个话题里**。如果作者要犹豫「这算 A 还是 B」，
 * 那就是边界没划清 —— 要么改文案，要么合并。
 *
 * 因此每个话题都配一句 `communityTopicHint()` 的边界说明：
 *   · 它**是**什么（正面定义）
 *   · 它和最容易混的那个话题**差在哪**（区分点）
 * 发布页会把选中话题的这句提示显示出来，用户在点下去之前就知道该选哪个。
 *
 * 2026-10-11 变更：
 *   · **删除「开箱测评」**。它和其余话题不在一个轴上 —— 开箱是「买东西的评价」，
 *     而评价类内容已经有「避雷拔草」这个口子；正向评测混在展示流里会把社区带成比价/种草站。
 *     删前已核对线上：9 条动态的话题分布为 今日穿搭 4 / 萌新入坑 3 / 避雷拔草 1 / 手作改造 1，
 *     **没有一条用到它**，删除零影响。
 *   · 「今日穿搭」与「出片分享」原先最容易被混淆，已在两者的提示里写明区分点
 *     （随手记录 vs 有拍摄意图的成片）。
 *
 * 历史：2026-10-04 按反馈删掉了「好价情报」（价格向）和「洗护收纳」（工具向）——
 * 这两个方向会把内容流带成比价/攻略站。
 */
export const COMMUNITY_TOPICS: string[] = [
  '今日穿搭',
  '出片分享',
  '妆造分享',
  '手作改造',
  '避雷拔草',
  '萌新入坑',
  '同好交流',
]

/**
 * 话题的边界说明（发布页在选中后显示）。
 *
 * 用 if 链而不是 Map：uni-app x 的 UTS 里 Map/Object 字面量的跨端行为不稳，
 * 而这里只有 7 个分支，可读性也更好。**每个话题都必须有非空返回**，
 * 由 `tests/community-topics-contract.test.cjs` 钉住，漏了会 FAIL。
 */
export function communityTopicHint(topic: string): string {
  if (topic == '今日穿搭') return '今天穿了什么，随手记录即可（手机随手拍也算）'
  if (topic == '出片分享') return '有意拍过的成片：约拍、外景、古风大片，重点在照片本身'
  if (topic == '妆造分享') return '妆发怎么弄的：妆容、假发、美瞳、造型步骤，衣服只是配角'
  if (topic == '手作改造') return '自己动手的部分：改衣、配饰制作、DIY 过程与成品'
  if (topic == '避雷拔草') return '踩过的坑与劝退提醒：版型、做工、发货、售后'
  if (topic == '萌新入坑') return '新手求助与入门答疑：怎么开始、买什么、注意什么'
  if (topic == '同好交流') return '不晒作品，就是想找人聊天：约活动、问同城、日常闲聊'
  return ''
}
