/**
 * Style — DEPRECATED: styles table removed in 12-table schema
 *
 * Same-style grouping is now handled by product.groupKey.
 * This file is kept only for type-compat with any remaining imports.
 * Remove once all consumers are migrated.
 */

/** @deprecated Use product.groupKey for same-style grouping */
export class StyleItem {
  id: string = ''
  title: string = ''
  coverUrl: string = ''
  price: number = 0           // 分
  saleStatus: string = ''
  brandName: string = ''
}

/** @deprecated Use product.groupKey for same-style grouping */
export class StyleInfo {
  id: string = ''
  brandId: string = ''
  brandName: string = ''
  canonicalName: string = ''
  category: string = ''
  subCategory: string = ''
  styleTags: string[] = []
  description: string = ''
  productCount: number = 0
  products: StyleItem[] = []
}
