/**
 * SourceRecord — 数据来源记录
 * 追踪商品/发售信息的原始来源，用于审核和可信度评估
 * 不保存账号密码、Cookie 或抓取密钥
 *
 * 展示层 Labels 见 presentation/content/feed-presenter.uts
 */

// ====== 来源类型 (纯值) ======

export const SOURCE_TAOBAO = 'taobao'
export const SOURCE_WEIBO = 'weibo'
export const SOURCE_XIAOHONGSHU = 'xiaohongshu'
export const SOURCE_OFFICIAL = 'official'
export const SOURCE_USER_SUBMIT = 'user_submit'
export const SOURCE_AI_EXTRACT = 'ai_extract'

// ====== 审核状态 (纯值) ======

export const REVIEW_PENDING = 'pending'
export const REVIEW_APPROVED = 'approved'
export const REVIEW_REJECTED = 'rejected'
export const REVIEW_CORRECTED = 'corrected'

// ====== 数据模型 ======

export class SourceRecord {
  id: string = ''
  sourceType: string = 'official'
  sourceName: string = ''     // "星辰猫旗舰店" / "三坑资讯bot"
  sourceUrl: string = ''      // 原始链接 (公开 URL)
  originalId: string = ''     // 原始平台的 ID
  fetchedAt: string = ''      // 抓取时间
  publishedAt: string = ''    // 原始发布时间
  reviewStatus: string = 'pending'
  confidence: number = 0      // 0~100 可信度评分
  rawSnapshotRef: string = '' // 原始数据存储引用 (非实际内容)
  createdAt: string = ''
  updatedAt: string = ''
}
