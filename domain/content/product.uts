/**
 * Product — 三坑商品
 * 独立于 WishItem，代表商品本身（非用户心愿）
 * WishItem.purchaseId 可关联此实体
 *
 * 展示层 Labels/Colors 见 presentation/content/feed-presenter.uts
 *
 * ★ 12-table schema: images is ProductImage[] (JSONB objects), not string[].
 *   coverUrl = images[0]?.url || '' (derived, never stored raw).
 *   groupKey replaces styleId for same-style grouping.
 */

// ====== 商品状态 (纯值) ======

export const PRODUCT_UPCOMING = 'UPCOMING'     // 即将发售
export const PRODUCT_ON_SALE = 'ON_SALE'        // 在售
export const PRODUCT_PRE_ORDER = 'PRE_ORDER'    // 预售中
export const PRODUCT_SOLD_OUT = 'SOLD_OUT'      // 已售罄
export const PRODUCT_ENDED = 'ENDED'            // 已下架

// ====== 图片模型 (12-table: images JSONB) ======

export class ProductImage {
  url: string = ''
  thumbnailUrl: string = ''
  width: number = 0
  height: number = 0
  sizeBytes: number = 0
  objectKey: string = ''
}

/** 从 images JSONB 数组安全提取 URL 字符串列表（兼容旧逻辑） */
export function extractImageUrls(images: ProductImage[]): string[] {
  const urls: string[] = []
  for (let i = 0; i < images.length; i++) {
    if (images[i].url !== '') urls.push(images[i].url)
  }
  return urls
}

/** 安全获取 coverUrl：images[0]?.url || '' */
export function deriveCoverUrl(images: ProductImage[]): string {
  return images.length > 0 ? images[0].url : ''
}

// ====== 数据模型 ======

export class Product {
  id: string = ''
  name: string = ''
  brandId: string = ''
  brandName: string = ''      // 冗余，列表展示用
  groupKey: string = ''       // 同款式商品分组 key（替代 styleId）
  category: string = ''       // JK / LOLITA / HANFU / OTHER
  subCategory: string = ''    // 格裙 / 衬衫 / KC / 发带 / 鞋 / 包
  status: string = 'UPCOMING'
  images: ProductImage[] = [] // 12-table: images JSONB (full quality preserved)
  coverUrl: string = ''       // derived = images[0]?.url || ''
  price: number = 0           // 当前价格 (分)
  currency: string = 'CNY'
  description: string = ''
  tags: string[] = []
  releaseDate: string = ''    // 发售日期
  shopUrl: string = ''        // 购买链接
  viewCount: number = 0
  favoriteCount: number = 0
  isFavorited: boolean = false // 当前用户是否收藏
  /** 全部发售批次。**只有多于一个批次时**服务端才下发；单批次看 currentRelease 即可 */
  releases: ProductReleaseBatch[] = []
  createdAt: string = ''
  updatedAt: string = ''
}


/**
 * 发售批次（热门款会分批放：一团定金 / 二团定金 / 现货掉落…）。
 * 一个商品多个批次时，用户最关心的是「现在能买哪一批、下一批什么时候开」，
 * 所以详情页把批次当**列表**展示，而不是只显示一个当前批次。
 */
export class ProductReleaseBatch {
  id: string = ''
  /** 第几批（1 = 一团） */
  no: number = 0
  name: string = ''
  /** reservation（预约/定金批）/ spot（现货）/ first_release / rerelease / lottery */
  releaseType: string = ''
  saleStatus: string = ''
  depositCents: number | null = null
  balanceCents: number | null = null
  fullPriceCents: number | null = null
  startAt: string = ''
  endAt: string = ''
  balanceDueAt: string = ''
  shipAt: string = ''
  note: string = ''
}
