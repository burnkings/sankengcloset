export class WardrobeItem {
  id: string = ''; name: string = ''; category: string = 'OTHER'; style: string = ''; brand: string = ''; color: string = ''; size: string = ''
  wearStatus: string = 'UNWORN'; seasons: string[] = []; images: string[] = []; tags: string[] = []; purchaseDate: string = ''
  purchasePrice: number = 0; purchaseSource: string = ''; note: string = ''; isFavorite: boolean = false; isDeleted: boolean = false
  // 由订单入橱时保留来源，便于回看价格、履约和原始种草。
  purchaseId: string = ''; wishId: string = ''
  createdAt: string = ''; updatedAt: string = ''
}

/**
 * 读取衣橱单品的封面图（第一张图）。
 * 不用 class getter，避免 vapor 模式下 reactive proxy 包裹带 getter 的 class 实例时
 * 触发响应式追踪异常（Active effect was not restored correctly）导致白屏。
 */
export function wardrobeCoverImage(item: WardrobeItem): string {
  return item.images.length > 0 ? item.images[0] : ''
}

export class WardrobeUpdateData {
  name: string = ''; category: string = ''; style: string = ''; brand: string = ''; color: string = ''; size: string = ''
  wearStatus: string = ''; images: string[] = []; purchaseDate: string = ''; purchasePrice: number = -1; purchaseSource: string = ''; note: string = ''
}
