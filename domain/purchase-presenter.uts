/**
 * PurchasePresenter — 消费记录展示层
 * 负责 domain model → display model 转换
 * PurchaseCard 只用 display model，不做任何计算
 */

import {
  PurchaseRecord,
  PAYMENT_STATUS_LABELS,
  PAYMENT_STATUS_COLORS,
} from './purchase-record'

/** 展示模型 — PurchaseCard + Detail 页面直接使用 */
export class PurchaseDisplayModel {
  id: string = ''
  name: string = ''
  brand: string = ''
  shopName: string = ''
  category: string = ''
  statusText: string = ''
  statusColor: string = ''
  totalText: string = ''
  depositText: string = ''
  paidText: string = ''
  remainingText: string = ''
  progressPercent: number = 0
  purchaseDateText: string = ''
  deadlineText: string = ''
  deadlineLabel: string = ''
  note: string = ''
  isOverdue: boolean = false
  isFavorite: boolean = false
}

/** UTS 兼容：Kotlin/Java 无 padStart */
function padZero(n: number): string {
  return n < 10 ? '0' + String(n) : String(n)
}

/** 日期格式化 */
function formatDate(dateStr: string): string {
  if (!dateStr) return '—'
  try {
    const d = new Date(dateStr)
    const y = d.getFullYear()
    const m = padZero(d.getMonth() + 1)
    const day = padZero(d.getDate())
    return `${y}-${m}-${day}`
  } catch {
    return dateStr
  }
}

/** 判断是否逾期 */
function checkOverdue(deadline: string, status: string): boolean {
  if (!deadline) return false
  if (status === 'COMPLETED' || status === 'CANCELLED') return false
  try {
    return new Date(deadline).getTime() < Date.now()
  } catch {
    return false
  }
}

/** 单条转换 */
export function toDisplayModel(record: PurchaseRecord): PurchaseDisplayModel {
  const dm = new PurchaseDisplayModel()
  dm.id = record.id
  dm.name = record.name
  dm.brand = record.brand
  dm.shopName = record.shopName
  dm.category = record.category
  dm.statusText = PAYMENT_STATUS_LABELS[record.paymentStatus] ?? '未知'
  dm.statusColor = PAYMENT_STATUS_COLORS[record.paymentStatus] ?? '#9CA3AF'
  dm.totalText = `¥${record.totalAmount.toFixed(2)}`
  dm.depositText = record.depositAmount > 0 ? `定金 ¥${record.depositAmount.toFixed(2)}` : ''
  dm.paidText = `已付 ¥${record.paidAmount.toFixed(2)}`
  dm.remainingText = record.remainingAmount > 0
    ? `待付 ¥${record.remainingAmount.toFixed(2)}`
    : '已结清'
  dm.progressPercent = record.totalAmount > 0
    ? Math.min(100, Math.round((record.paidAmount / record.totalAmount) * 100))
    : 0
  dm.purchaseDateText = formatDate(record.purchaseDate)
  const dl = formatDate(record.deadline)
  dm.deadlineText = dl
  dm.deadlineLabel = dl !== '—' ? `截止 ${dl}` : ''
  dm.note = record.note
  dm.isOverdue = checkOverdue(record.deadline, record.paymentStatus)
  dm.isFavorite = record.isFavorite
  return dm
}

/** 批量转换 */
export function toDisplayModels(records: PurchaseRecord[]): PurchaseDisplayModel[] {
  return records.map(toDisplayModel)
}
