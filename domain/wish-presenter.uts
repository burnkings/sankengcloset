/**
 * WishPresenter — 心愿单展示层
 * domain model → display model，页面/组件零计算
 */

import {
  WishItem,
  WISH_STATUS_LABELS,
  WISH_STATUS_COLORS,
  WISH_STATUS_EMOJI,
  PRIORITY_LABELS,
  PRIORITY_COLORS,
  PRIORITY_ORDER,
  SOURCE_LABELS,
} from './wish-item'

/** 展示模型 — WishCard 直接使用 */
export class WishDisplayModel {
  id: string = ''
  name: string = ''
  brand: string = ''
  coverImage: string = ''
  hasCover: boolean = false
  // 状态
  statusText: string = ''
  statusColor: string = ''
  statusEmoji: string = ''
  // 优先级
  priorityLabel: string = ''
  priorityColor: string = ''
  priorityOrder: number = 3
  // 价格
  priceText: string = ''
  // 来源
  sourceText: string = ''
  // 关联
  hasPurchase: boolean = false
  hasWardrobe: boolean = false
  // 其他
  note: string = ''
  url: string = ''
  // 收藏
  isFavorite: boolean = false
}

/** 价格格式化 */
function formatPrice(price: number): string {
  if (price <= 0) return ''
  return `¥${price.toFixed(0)}`
}

/** 单条转换 */
export function toDisplayModel(item: WishItem): WishDisplayModel {
  const dm = new WishDisplayModel()
  dm.id = item.id
  dm.name = item.name
  dm.brand = item.brand
  dm.coverImage = item.coverImage
  dm.hasCover = item.coverImage !== ''
  // 状态
  dm.statusText = WISH_STATUS_LABELS[item.status] ?? '未知'
  dm.statusColor = WISH_STATUS_COLORS[item.status] ?? '#9CA3AF'
  dm.statusEmoji = WISH_STATUS_EMOJI[item.status] ?? '💡'
  // 优先级
  dm.priorityLabel = PRIORITY_LABELS[item.priority] ?? '中'
  dm.priorityColor = PRIORITY_COLORS[item.priority] ?? '#F59E0B'
  dm.priorityOrder = PRIORITY_ORDER[item.priority] ?? 2
  // 价格
  dm.priceText = formatPrice(item.estimatedPrice)
  // 来源
  dm.sourceText = SOURCE_LABELS[item.source] ?? '手动添加'
  // 关联
  dm.hasPurchase = item.purchaseId !== ''
  dm.hasWardrobe = item.wardrobeId !== ''
  // 其他
  dm.note = item.note
  dm.url = item.url
  dm.isFavorite = item.isFavorite
  return dm
}

/** 批量转换 */
export function toDisplayModels(items: WishItem[]): WishDisplayModel[] {
  return items.map(toDisplayModel)
}
