import {
  WishItem,
  WISH_WISH, WISH_WATCHING, WISH_DECIDED, WISH_PURCHASED, WISH_PAUSED, WISH_CANCELED,
  WISH_STATUS_COLORS, PRIORITY_COLORS, PRIORITY_ORDER,
  PRIORITY_HIGH, PRIORITY_MEDIUM, PRIORITY_LOW,
  SOURCE_MANUAL, SOURCE_AI_IMPORT, SOURCE_DISCOVERY,
} from './wish-item'

export class WishDisplayModel {
  id: string = ''
  name: string = ''
  brand: string = ''
  coverImage: string = ''
  hasCover: boolean = false
  status: string = ''
  statusText: string = ''
  statusColor: string = ''
  priorityLabel: string = ''
  priorityColor: string = ''
  priorityOrder: number = 3
  priceText: string = ''
  sourceText: string = ''
  hasPurchase: boolean = false
  hasWardrobe: boolean = false
  note: string = ''
  url: string = ''
  isFavorite: boolean = false
  daysSinceCreated: number = 0
}

function getStatusText(s: string): string {
  if (s === WISH_WISH) return '种草'
  if (s === WISH_WATCHING) return '观望'
  if (s === WISH_DECIDED) return '决定买'
  if (s === WISH_PURCHASED) return '已买'
  if (s === WISH_PAUSED) return '搁置'
  if (s === WISH_CANCELED) return '拔草'
  return '未知'
}

function getStatusColor(s: string): string {
  if (s === WISH_WISH) return WISH_STATUS_COLORS.WISH as string
  if (s === WISH_WATCHING) return WISH_STATUS_COLORS.WATCHING as string
  if (s === WISH_DECIDED) return WISH_STATUS_COLORS.DECIDED as string
  if (s === WISH_PURCHASED) return WISH_STATUS_COLORS.PURCHASED as string
  if (s === WISH_PAUSED) return WISH_STATUS_COLORS.PAUSED as string
  if (s === WISH_CANCELED) return WISH_STATUS_COLORS.CANCELED as string
  return '#9CA3AF'
}

function getPriorityLabel(p: string): string {
  if (p === PRIORITY_HIGH) return '高'
  if (p === PRIORITY_MEDIUM) return '中'
  return '低'
}

function getPriorityColor(p: string): string {
  if (p === PRIORITY_HIGH) return PRIORITY_COLORS.HIGH as string
  if (p === PRIORITY_MEDIUM) return PRIORITY_COLORS.MEDIUM as string
  return PRIORITY_COLORS.LOW as string
}

function getPriorityOrder(p: string): number {
  if (p === PRIORITY_HIGH) return 1
  if (p === PRIORITY_MEDIUM) return 2
  return 3
}

function getSourceText(s: string): string {
  if (s === SOURCE_AI_IMPORT) return 'AI导入'
  if (s === SOURCE_DISCOVERY) return '发现'
  return '手动添加'
}

function formatPrice(price: number): string {
  if (price <= 0) return ''
  return `¥${price.toFixed(0)}`
}

function calcDaysSince(createdAt: string): number {
  if (createdAt === '') return 0
  try {
    const created = new Date(createdAt).getTime()
    const now = Date.now()
    return Math.floor((now - created) / (1000 * 60 * 60 * 24))
  } catch { return 0 }
}

export function toDisplayModel(item: WishItem): WishDisplayModel {
  const dm = new WishDisplayModel()
  dm.id = item.id
  dm.name = item.name
  dm.brand = item.brand
  dm.coverImage = item.coverImage
  dm.hasCover = item.coverImage !== ''
  dm.status = item.status
  dm.statusText = getStatusText(item.status)
  dm.statusColor = getStatusColor(item.status)
  dm.priorityLabel = getPriorityLabel(item.priority)
  dm.priorityColor = getPriorityColor(item.priority)
  dm.priorityOrder = getPriorityOrder(item.priority)
  dm.priceText = formatPrice(item.estimatedPrice)
  dm.sourceText = getSourceText(item.source)
  dm.hasPurchase = item.purchaseId !== ''
  dm.hasWardrobe = item.wardrobeId !== ''
  dm.note = item.note
  dm.url = item.url
  dm.isFavorite = item.isFavorite
  dm.daysSinceCreated = calcDaysSince(item.createdAt)
  return dm
}

export function toDisplayModels(items: WishItem[]): WishDisplayModel[] {
  return items.map((item) => toDisplayModel(item))
}

export class WishStatsData {
  wishCount: number = 0
  decidedCount: number = 0
  purchasedCount: number = 0
  estimatedTotal: number = 0
}

export function calcStats(items: WishItem[]): WishStatsData {
  const s = new WishStatsData()
  for (let i = 0; i < items.length; i++) {
    const it = items[i]
    if (it.isDeleted) continue
    if (it.status === WISH_WISH || it.status === WISH_WATCHING) s.wishCount++
    if (it.status === WISH_DECIDED) { s.decidedCount++; s.estimatedTotal += it.estimatedPrice }
    if (it.status === WISH_PURCHASED) s.purchasedCount++
  }
  return s
}
