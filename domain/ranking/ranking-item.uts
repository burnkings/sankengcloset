/** ranking-item — 榜单条目模型（热榜/上新榜共用） */

export class RankingItem {
  rank: number = 0
  entityId: string = ''          // 点击跳商品详情
  title: string = ''
  brandName: string = ''
  coverUrl: string = ''
  priceCents: number = 0
  category: string = ''          // JK / Lolita / 汉服

  // 热榜
  favoriteCount: number = 0      // 「X 人关注」
  favoriteGrowth: number = 0     // 收藏榜「近周期新增收藏」
  // 上新榜
  releaseTypeName: string = ''   // 首发 / 再贩 / 现货
  daysAgo: number = 0            // 「X 天前上新」
  reservationCount: number = 0   // 「X 人蹲预约」
}

export const RANKING_TAB_HOT = 'hot'
export const RANKING_TAB_NEW = 'new'
export const RANKING_TAB_FAVORITE = 'favorite'
