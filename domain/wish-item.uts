/**
 * WishItem — 心愿单数据模型
 * 生命周期: Wishlist → Purchase → Wardrobe
 *
 * ★★★★★ Android 规范：string union → class 常量；any → 具体类型
 */

// ====== 心愿状态 ======

export const WISH_WISH = 'WISH'
export const WISH_WATCHING = 'WATCHING'
export const WISH_DECIDED = 'DECIDED'
export const WISH_PURCHASED = 'PURCHASED'
export const WISH_PAUSED = 'PAUSED'
export const WISH_CANCELED = 'CANCELED'

export const WISH_STATUS_LABELS = {
  WISH: '种草',
  WATCHING: '观望',
  DECIDED: '决定买',
  PURCHASED: '已买',
  PAUSED: '搁置',
  CANCELED: '拔草',
}

export const WISH_STATUS_COLORS = {
  WISH: '#8B5CF6',
  WATCHING: '#6366F1',
  DECIDED: '#22C55E',
  PURCHASED: '#9CA3AF',
  PAUSED: '#F59E0B',
  CANCELED: '#9CA3AF',
}

export const WISH_STATUS_EMOJI = {
  WISH: '💡',
  WATCHING: '👀',
  DECIDED: '✅',
  PURCHASED: '🛍️',
  PAUSED: '⏸️',
  CANCELED: '❌',
}

/** 状态流转规则 */
export const WISH_STATUS_FLOW = {
  WISH: ['WATCHING', 'DECIDED', 'PAUSED', 'CANCELED'],
  WATCHING: ['WISH', 'DECIDED', 'PAUSED', 'CANCELED'],
  DECIDED: ['WATCHING', 'PURCHASED', 'PAUSED', 'CANCELED'],
  PURCHASED: [],
  PAUSED: ['WISH', 'WATCHING', 'CANCELED'],
  CANCELED: ['WISH'],
}

export class WishFilterOption {
  label: string = ''
  value: string = ''
}

function createWishFilterOption(l: string, v: string): WishFilterOption {
  const o = new WishFilterOption()
  o.label = l
  o.value = v
  return o
}

export const WISH_FILTER_OPTIONS: WishFilterOption[] = [
  createWishFilterOption('全部', ''),
  createWishFilterOption('种草', 'WISH'),
  createWishFilterOption('观望', 'WATCHING'),
  createWishFilterOption('决定买', 'DECIDED'),
  createWishFilterOption('已买', 'PURCHASED'),
  createWishFilterOption('搁置', 'PAUSED'),
  createWishFilterOption('拔草', 'CANCELED'),
]

// ====== 优先级 ======

export const PRIORITY_HIGH = 'HIGH'
export const PRIORITY_MEDIUM = 'MEDIUM'
export const PRIORITY_LOW = 'LOW'

export const PRIORITY_LABELS = {
  HIGH: '高',
  MEDIUM: '中',
  LOW: '低',
}

export const PRIORITY_COLORS = {
  HIGH: '#EF4444',
  MEDIUM: '#F59E0B',
  LOW: '#9CA3AF',
}

export const PRIORITY_ORDER = {
  HIGH: 1,
  MEDIUM: 2,
  LOW: 3,
}

// ====== 来源 ======

export const SOURCE_MANUAL = 'MANUAL'
export const SOURCE_AI_IMPORT = 'AI_IMPORT'
export const SOURCE_DISCOVERY = 'DISCOVERY'

export const SOURCE_LABELS = {
  MANUAL: '手动添加',
  AI_IMPORT: 'AI导入',
  DISCOVERY: '发现',
}

// ====== 数据模型 ======

export class WishItem {
  id: string = ''
  name: string = ''
  coverImage: string = ''
  brand: string = ''
  estimatedPrice: number = 0
  priority: string = 'MEDIUM'
  status: string = 'WISH'
  source: string = 'MANUAL'
  // 生命周期关联
  wardrobeId: string = ''
  purchaseId: string = ''
  convertedAt: string = ''
  // 附加信息
  note: string = ''
  url: string = ''
  isFavorite: boolean = false
  isDeleted: boolean = false
  createdAt: string = ''
  updatedAt: string = ''
}

/** 更新数据 — 替代 updateItem(id, data: any) */
export class WishUpdateData {
  name: string = ''
  coverImage: string = ''
  brand: string = ''
  estimatedPrice: number = -1
  priority: string = ''
  status: string = ''
  note: string = ''
  url: string = ''
  isFavorite: number = -1 // -1=不变, 0=取消收藏, 1=收藏
}