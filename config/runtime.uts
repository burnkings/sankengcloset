/** V2.4 数据运行模式与远程会话配置。 */

export const DATA_MODE_LOCAL = 'local'
export const DATA_MODE_MOCK = 'mock'
export const DATA_MODE_REMOTE = 'remote'

const MODE_KEY = 'v21_runtime_data_mode'
const ONLINE_KEY = 'v21_runtime_mock_online'
const LATENCY_KEY = 'v21_runtime_mock_latency'
const API_BASE_URL_KEY = 'v24_runtime_api_base_url'
const ACCESS_TOKEN_KEY = 'v24_session_access_token'
const REFRESH_TOKEN_KEY = 'v24_session_refresh_token'

export class RuntimeConfig {
  mode: string = DATA_MODE_MOCK
  apiBaseUrl: string = ''
  mockOnline: boolean = true
  mockLatencyMs: number = 240
}

function readString(key: string): string {
  try {
    const value = uni.getStorageSync(key)
    return value == null ? '' : String(value)
  } catch (e) {
    return ''
  }
}

export function normalizeApiBaseUrl(value: string): string {
  let result = value.trim()
  while (result.endsWith('/')) result = result.substring(0, result.length - 1)
  return result
}

export function getRuntimeConfig(): RuntimeConfig {
  const config = new RuntimeConfig()
  const savedMode = readString(MODE_KEY)
  if (savedMode === DATA_MODE_LOCAL || savedMode === DATA_MODE_MOCK || savedMode === DATA_MODE_REMOTE) config.mode = savedMode
  config.apiBaseUrl = normalizeApiBaseUrl(readString(API_BASE_URL_KEY))
  config.mockOnline = readString(ONLINE_KEY) !== 'offline'
  const latency = parseInt(readString(LATENCY_KEY))
  if (!isNaN(latency) && latency >= 0) config.mockLatencyMs = Math.min(latency, 3000)
  return config
}

export function setRuntimeMode(mode: string) {
  if (mode !== DATA_MODE_LOCAL && mode !== DATA_MODE_MOCK && mode !== DATA_MODE_REMOTE) return
  uni.setStorageSync(MODE_KEY, mode)
}

export function setApiBaseUrl(value: string) {
  uni.setStorageSync(API_BASE_URL_KEY, normalizeApiBaseUrl(value))
}

export function getAccessToken(): string { return readString(ACCESS_TOKEN_KEY) }
export function getRefreshToken(): string { return readString(REFRESH_TOKEN_KEY) }

export function saveSessionTokens(accessToken: string, refreshToken: string) {
  uni.setStorageSync(ACCESS_TOKEN_KEY, accessToken)
  uni.setStorageSync(REFRESH_TOKEN_KEY, refreshToken)
}

export function clearSessionTokens() {
  uni.removeStorageSync(ACCESS_TOKEN_KEY)
  uni.removeStorageSync(REFRESH_TOKEN_KEY)
}

export function setMockOnline(online: boolean) {
  uni.setStorageSync(ONLINE_KEY, online ? 'online' : 'offline')
}

export function setMockLatency(latencyMs: number) {
  uni.setStorageSync(LATENCY_KEY, String(Math.max(0, Math.min(latencyMs, 3000))))
}
