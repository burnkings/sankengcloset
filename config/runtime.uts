/** V2.5 Runtime 固化配置 — 仅支持远程生产模式。 */

export const DATA_MODE_REMOTE = 'remote'

const ACCESS_TOKEN_KEY = 'v24_session_access_token'
const REFRESH_TOKEN_KEY = 'v24_session_refresh_token'
const SESSION_MODE_KEY = 'v26_session_mode'

// ====== 启动缓存（避免多次 getStorageSync 串行） ======

let _configCache: RuntimeConfig | null = null
export class TokenCache {
  access: string = ''
  refresh: string = ''
}

let _tokenCache: TokenCache | null = null

export class RuntimeConfig {
  mode: string = DATA_MODE_REMOTE
  apiBaseUrl: string = 'https://api.sankengcloset.icu'
  mockOnline: boolean = false
  mockLatencyMs: number = 0
}

function readString(key: string): string {
  try {
    const value = uni.getStorageSync(key)
    return value == null ? '' : value as string
  } catch (e) {
    return ''
  }
}

// ====== Token 存储混淆（非强加密） ======
// 自实现 XOR + 十六进制编码，防止明文 dump 直接读取 token。
// 局限：防「顺手读取」级别的泄露；root/越狱级攻击仍需 UTS 安全存储插件。
// 兼容：deobfuscate 对无 enc: 前缀的旧明文直接返回原文，保证登录态不因迁移中断。
const ENC_PREFIX = 'enc:'
const XOR_BASE = 0x5a

function obfuscateToken(value: string): string {
  if (value === '') return ''
  let out = ENC_PREFIX
  for (let i = 0; i < value.length; i++) {
    const code = value.charCodeAt(i) ^ (XOR_BASE + i * 7)
    out += code.toString(16) + '.'
  }
  return out
}

function deobfuscateToken(value: string): string {
  if (value === '') return ''
  if (!value.startsWith(ENC_PREFIX)) return value
  const parts = value.substring(ENC_PREFIX.length).split('.')
  let out = ''
  for (let i = 0; i < parts.length; i++) {
    if (parts[i] === '') continue
    const code = parseInt(parts[i], 16)
    // 损坏存储（非 hex 片段）：返回空串，视为无 token，触发重新登录而非乱码
    if (isNaN(code)) return ''
    out += String.fromCharCode(code ^ (XOR_BASE + i * 7))
  }
  return out
}

function readTokenValue(key: string): string {
  const raw = readString(key)
  return deobfuscateToken(raw)
}

/**
 * App.onLaunch 时调用一次，预热全部运行配置和 Token 缓存。
 * 之后 getRuntimeConfig() / getCachedAccessToken() 直接从缓存返回，
 * 不再触发多次串行 getStorageSync。
 */
export function warmRuntimeCache(): RuntimeConfig {
  const config = new RuntimeConfig()
  _configCache = config
  // 预热 Token：若存在旧明文（无 enc: 前缀），迁移为混淆并回写
  const rawAccess = readString(ACCESS_TOKEN_KEY)
  const rawRefresh = readString(REFRESH_TOKEN_KEY)
  const tc = new TokenCache()
  tc.access = deobfuscateToken(rawAccess)
  tc.refresh = deobfuscateToken(rawRefresh)
  _tokenCache = tc
  if (rawAccess !== '' && !rawAccess.startsWith(ENC_PREFIX)) {
    try { uni.setStorageSync(ACCESS_TOKEN_KEY, obfuscateToken(rawAccess)) } catch (e) {}
  }
  if (rawRefresh !== '' && !rawRefresh.startsWith(ENC_PREFIX)) {
    try { uni.setStorageSync(REFRESH_TOKEN_KEY, obfuscateToken(rawRefresh)) } catch (e) {}
  }
  return config
}

export function getRuntimeConfig(): RuntimeConfig {
  const cached = _configCache
  if (cached != null) return cached
  const config = new RuntimeConfig()
  return config
}

export function getCachedAccessToken(): string {
  const cached = _tokenCache
  if (cached != null) return cached.access
  const tc = new TokenCache()
  tc.access = readTokenValue(ACCESS_TOKEN_KEY)
  tc.refresh = readTokenValue(REFRESH_TOKEN_KEY)
  _tokenCache = tc
  return tc.access
}

export function getCachedRefreshToken(): string {
  const cached = _tokenCache
  if (cached != null) return cached.refresh
  const tc = new TokenCache()
  tc.access = readTokenValue(ACCESS_TOKEN_KEY)
  tc.refresh = readTokenValue(REFRESH_TOKEN_KEY)
  _tokenCache = tc
  return tc.refresh
}

export function getAccessToken(): string { return getCachedAccessToken() }
export function getRefreshToken(): string { return getCachedRefreshToken() }
export function isLocalMockSession(): boolean { return readString(SESSION_MODE_KEY) === 'mock' }

export function saveSessionTokens(accessToken: string, refreshToken: string) {
  const tc = new TokenCache()
  tc.access = accessToken
  tc.refresh = refreshToken
  _tokenCache = tc
  try {
    uni.setStorageSync(ACCESS_TOKEN_KEY, obfuscateToken(accessToken))
    uni.setStorageSync(REFRESH_TOKEN_KEY, obfuscateToken(refreshToken))
  } catch (e) {
    // storage 写入失败（配额/异常）：保留内存会话，重启后需重新登录
  }
}

export function clearSessionTokens() {
  _tokenCache = null
  uni.removeStorageSync(ACCESS_TOKEN_KEY)
  uni.removeStorageSync(REFRESH_TOKEN_KEY)
}
