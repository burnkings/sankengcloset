/**
 * WishlistStore — 心愿单状态管理
 * Page → Store → Repository
 */
import { reactive } from 'vue'

import { WishItem, WishUpdateData, PRIORITY_ORDER, WISH_STATUS_FLOW } from '@/domain/wish-item'
import { toDisplayModel, toDisplayModels, WishDisplayModel } from '@/domain/wish-presenter'
import * as repo from '@/domain/repositories/wishlist-repo'
import { PurchaseRecord } from '@/domain/purchase-record'
import { syncWriteBack } from '@/services/sync/write-back'
import { getCachedAccessToken } from '@/config/runtime'
import { createAssetRemote, deleteAssetRemote, listWishesRemote, patchAssetRemote } from '@/services/user-data/user-data-service'
import { localToday } from '@/utils/date'
import { readStr, readNum, readBool } from '@/utils/remote-mapping'

// ====== 模块级 reactive 状态（单例）======

type WishlistState = {
  items: WishItem[]
  loading: boolean
  error: string
  filterStatus: string
  searchKeyword: string
  currentSort: string
  showFavoritesOnly: boolean
}

const _state = reactive<WishlistState>({
  items: [] as WishItem[],
  loading: false,
  error: '',
  filterStatus: '',
  searchKeyword: '',
  currentSort: 'priority', // priority | price-high | price-low | newest
  showFavoritesOnly: false,
})

// ====== 模块级派生函数 ======

function activeItems(): WishItem[] {
  return _state.items.filter((w) => !w.isDeleted)
}

function filteredItems(): WishItem[] {
  let result = activeItems()

  // 状态筛选
  if (_state.filterStatus) {
    result = result.filter((w) => w.status == _state.filterStatus)
  }

  // 收藏筛选
  if (_state.showFavoritesOnly) {
    result = result.filter((w) => w.isFavorite)
  }

  // 搜索
  if (_state.searchKeyword) {
    const kw = _state.searchKeyword.toLowerCase()
    result = result.filter((w) => {
      if (w.name.toLowerCase().includes(kw)) return true
      if (w.brand.toLowerCase().includes(kw)) return true
      if (w.note.toLowerCase().includes(kw)) return true
      return false
    })
  }

  // 排序
  result = [...result].sort((a, b) => {
    if (_state.currentSort == 'priority') {
      const paRaw = PRIORITY_ORDER[a.priority]
      const pbRaw = PRIORITY_ORDER[b.priority]
      const pa = paRaw != null ? paRaw as number : 2
      const pb = pbRaw != null ? pbRaw as number : 2
      if (pa != pb) return pa - pb
      const da = a.createdAt ? new Date(a.createdAt).getTime() : 0
      const db = b.createdAt ? new Date(b.createdAt).getTime() : 0
      return db - da
    }
    if (_state.currentSort == 'price-high') return b.estimatedPrice - a.estimatedPrice
    if (_state.currentSort == 'price-low') return a.estimatedPrice - b.estimatedPrice
    if (_state.currentSort == 'newest') {
      const da = a.createdAt ? new Date(a.createdAt).getTime() : 0
      const db = b.createdAt ? new Date(b.createdAt).getTime() : 0
      return db - da
    }
    return 0
  })

  return result
}

function displayItems(): WishDisplayModel[] {
  return toDisplayModels(filteredItems())
}

function itemCount(): number { return activeItems().length }
function favoriteCount(): number {
  return activeItems().filter((w) => w.isFavorite).length
}

function wishCount(): number {
  return activeItems().filter((w) => w.status == 'WISH').length
}
function watchingCount(): number {
  return activeItems().filter((w) => w.status == 'WATCHING').length
}
function decidedCount(): number {
  return activeItems().filter((w) => w.status == 'DECIDED').length
}
function purchasedCount(): number {
  return activeItems().filter((w) => w.status == 'PURCHASED').length
}

function highPriorityCount(): number {
  return activeItems().filter((w) =>
    w.priority == 'HIGH' && w.status != 'PURCHASED' && w.status != 'CANCELED'
  ).length
}

function estimatedTotal(): number {
  return activeItems()
    .filter((w) => w.status != 'PURCHASED' && w.status != 'CANCELED')
    .reduce((sum, w) => sum + w.estimatedPrice, 0)
}
function decisionReserveTotal(): number {
  return activeItems().filter((w) => w.status == 'DECIDED').reduce((sum, w) => sum + w.estimatedPrice, 0)
}

function convertedCount(): number {
  return activeItems().filter((w) => w.purchaseId !== '').length
}

function notifyChanged() {}

// ====== 模块级 action ======

// 请求序号：切账号/登出时 bump，丢弃过期请求，防旧账号数据覆盖新状态
let _fetchSeq = 0
export function bumpFetchSeq() { _fetchSeq += 1 }

function mapRemoteWish(raw: UTSJSONObject): WishItem {
  const item = new WishItem()
  item.id = readStr(raw, 'id')
  item.name = readStr(raw, 'name')
  item.coverImage = readStr(raw, 'coverImage')
  item.brand = readStr(raw, 'brand')
  item.estimatedPrice = readNum(raw, 'estimatedPrice')
  item.priority = readStr(raw, 'priority', 'MEDIUM')
  item.status = readStr(raw, 'status', 'WISH')
  item.source = readStr(raw, 'source', 'MANUAL')
  item.wardrobeId = readStr(raw, 'wardrobeId')
  item.purchaseId = readStr(raw, 'purchaseId')
  item.convertedAt = readStr(raw, 'convertedAt')
  item.note = readStr(raw, 'note')
  item.url = readStr(raw, 'url')
  item.isFavorite = readBool(raw, 'isFavorite')
  item.createdAt = readStr(raw, 'createdAt')
  item.updatedAt = readStr(raw, 'updatedAt')
  return item
}

async function fetchItems() {
  const seq = ++_fetchSeq
  _state.loading = true
  _state.error = ''
  try {
    if (getCachedAccessToken() != '') {
      const remote = await listWishesRemote()
      if (seq !== _fetchSeq) return
      const restored = [] as WishItem[]
      for (let i = 0; i < remote.length; i++) restored.push(mapRemoteWish(remote[i]))
      _state.items = restored
    } else {
      if (seq !== _fetchSeq) return
      repo.initMockData()
      _state.items = repo.getAll()
    }
  } catch (err) {
    if (seq !== _fetchSeq) return
    _state.error = err instanceof Error ? err.message : '加载失败'
    _state.items = repo.getAll()
  } finally {
    if (seq === _fetchSeq) _state.loading = false
  }
  notifyChanged()
}

function addItem(item: WishItem): WishItem | null {
  try {
    const added = repo.add(item)
    _state.items = [..._state.items, added]
    // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
    syncWriteBack('wishlist_item', added.id, 'create', JSON.stringify(added), () => createAssetRemote('wishes', added as UTSJSONObject))
    notifyChanged()
    return added
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '添加失败'
    return null
  }
}

function updateItem(id: string, data: WishUpdateData): boolean {
  const ok = repo.update(id, data)
  if (ok) {
    const existing = _state.items.find((w) => w.id == id)
    if (existing != null) {
      if (data.name != '') existing.name = data.name
      if (data.coverImage != '') existing.coverImage = data.coverImage
      if (data.brand != '') existing.brand = data.brand
      if (data.estimatedPrice >= 0) existing.estimatedPrice = data.estimatedPrice
      if (data.priority != '') existing.priority = data.priority
      if (data.status != '') existing.status = data.status
      if (data.note != '') existing.note = data.note
      if (data.url != '') existing.url = data.url
      if (data.isFavorite >= 0) existing.isFavorite = data.isFavorite == 1
      existing.updatedAt = new Date().toISOString()
    }
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      syncWriteBack('wishlist_item', id, 'update', JSON.stringify(current), () => patchAssetRemote('wishes', id, current as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function deleteItem(id: string): boolean {
  const ok = repo.softDelete(id)
  if (ok) {
    _state.items = _state.items.filter((w) => w.id !== id)
    syncWriteBack('wishlist_item', id, 'delete', '', () => deleteAssetRemote('wishes', id))
    notifyChanged()
  }
  return ok
}

function changeStatus(id: string, newStatus: string): boolean {
  const ok = repo.changeStatus(id, newStatus)
  if (ok) {
    const existing = _state.items.find((w) => w.id == id)
    if (existing != null) {
      existing.status = newStatus
      existing.updatedAt = new Date().toISOString()
    }
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      syncWriteBack('wishlist_item', id, 'update', JSON.stringify(current), () => patchAssetRemote('wishes', id, current as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function toggleFavorite(id: string): boolean {
  const ok = repo.toggleFavorite(id)
  if (ok) {
    const existing = _state.items.find((w) => w.id == id)
    if (existing != null) {
      existing.isFavorite = !existing.isFavorite
    }
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      syncWriteBack('wishlist_item', id, 'update', JSON.stringify(current), () => patchAssetRemote('wishes', id, current as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function convertToPurchase(id: string): PurchaseRecord | null {
  const item = _state.items.find((w) => w.id == id)
  if (item == null) return null

  const record = new PurchaseRecord()
  record.name = item.name
  record.brand = item.brand
  // 心愿单价位为元，订单金额单位为分（×100）
  record.totalAmount = Math.round(item.estimatedPrice * 100)
  record.depositAmount = 0
  record.paidAmount = 0
  record.remainingAmount = Math.round(item.estimatedPrice * 100)
  record.paymentStatus = 'PRE_ORDER'
  record.purchaseDate = localToday()
  record.wishId = item.id
  record.note = `从心愿单转入: ${item.name}`
  return record
}

function markPurchased(id: string, purchaseId: string): boolean {
  const ok = repo.markPurchased(id, purchaseId)
  if (ok) {
    const existing = _state.items.find((w) => w.id == id)
    if (existing != null) {
      existing.status = 'PURCHASED'
      existing.purchaseId = purchaseId
      existing.convertedAt = new Date().toISOString()
      existing.updatedAt = existing.convertedAt
    }
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      syncWriteBack('wishlist_item', id, 'update', JSON.stringify(current), () => patchAssetRemote('wishes', id, current as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function linkWardrobe(id: string, wardrobeId: string): boolean {
  const ok = repo.linkWardrobe(id, wardrobeId)
  if (ok) {
    const existing = _state.items.find((w) => w.id == id)
    if (existing != null) {
      existing.wardrobeId = wardrobeId
      existing.updatedAt = new Date().toISOString()
    }
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      syncWriteBack('wishlist_item', id, 'update', JSON.stringify(current), () => patchAssetRemote('wishes', id, current as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function getAvailableTransitions(currentStatus: string): string[] {
  const flow = WISH_STATUS_FLOW[currentStatus]
  return flow != null ? flow as string[] : []
}

function setFilterStatus(status: string) {
  _state.filterStatus = status
  notifyChanged()
}

function setSearch(keyword: string) {
  _state.searchKeyword = keyword
  notifyChanged()
}

function setSort(sort: string) {
  _state.currentSort = sort
  notifyChanged()
}

function setShowFavoritesOnly(val: boolean) {
  _state.showFavoritesOnly = val
  notifyChanged()
}

function getById(id: string): WishItem | null {
  return _state.items.find((w) => w.id == id)
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class WishListStoreHandle {
  get loading(): boolean { return _state.loading }
  get error(): string { return _state.error }
  get filterStatus(): string { return _state.filterStatus }
  get searchKeyword(): string { return _state.searchKeyword }
  get currentSort(): string { return _state.currentSort }
  get showFavoritesOnly(): boolean { return _state.showFavoritesOnly }
  get activeItems(): WishItem[] { return activeItems() }
  get filteredItems(): WishItem[] { return filteredItems() }
  get displayItems(): WishDisplayModel[] { return displayItems() }
  get itemCount(): number { return itemCount() }
  get favoriteCount(): number { return favoriteCount() }
  get wishCount(): number { return wishCount() }
  get watchingCount(): number { return watchingCount() }
  get decidedCount(): number { return decidedCount() }
  get purchasedCount(): number { return purchasedCount() }
  get highPriorityCount(): number { return highPriorityCount() }
  get estimatedTotal(): number { return estimatedTotal() }
  get decisionReserveTotal(): number { return decisionReserveTotal() }
  get convertedCount(): number { return convertedCount() }
  fetchItems(): Promise<void> { return fetchItems() }
  addItem(item: WishItem): WishItem | null { return addItem(item) }
  updateItem(id: string, data: WishUpdateData): boolean { return updateItem(id, data) }
  deleteItem(id: string): boolean { return deleteItem(id) }
  changeStatus(id: string, newStatus: string): boolean { return changeStatus(id, newStatus) }
  toggleFavorite(id: string): boolean { return toggleFavorite(id) }
  convertToPurchase(id: string): PurchaseRecord | null { return convertToPurchase(id) }
  markPurchased(id: string, purchaseId: string): boolean { return markPurchased(id, purchaseId) }
  linkWardrobe(id: string, wardrobeId: string): boolean { return linkWardrobe(id, wardrobeId) }
  getAvailableTransitions(currentStatus: string): string[] { return getAvailableTransitions(currentStatus) }
  setFilterStatus(status: string): void { setFilterStatus(status) }
  setSearch(keyword: string): void { setSearch(keyword) }
  setSort(sort: string): void { setSort(sort) }
  setShowFavoritesOnly(value: boolean): void { setShowFavoritesOnly(value) }
  getById(id: string): WishItem | null { return getById(id) }
}

let _handle: WishListStoreHandle | null = null
export function useWishListStore(): WishListStoreHandle {
  if (_handle == null) _handle = new WishListStoreHandle()
  return _handle!
}
