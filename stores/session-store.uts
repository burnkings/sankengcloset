import { defineStore } from 'pinia'
/** V2.5 会话 Store：正式微信登录，无 Mock/Preview 回退。 */
import { clearSessionTokens, saveSessionTokens } from '@/config/runtime'
import { apiPost, apiGet } from '@/services/platform/api-client'

const STATE_KEY = 'v21_session_state'
const USER_ID_KEY = 'v21_session_user_id'
const NICKNAME_KEY = 'v21_session_nickname'
const AVATAR_KEY = 'v25_session_avatar'
const DEVICE_ID_KEY = 'v25_installation_id'

export class SessionProfile {
  userId: string = ''
  nickname: string = ''
  avatarUrl: string = ''
  avatarText: string = 'SK'
}

function readString(key: string): string {
  try { const value = uni.getStorageSync(key); return value == null ? '' : String(value) } catch (e) { return '' }
}

export const useSessionStore = defineStore('session', () => {
  const state = ref(readString(STATE_KEY) === 'logged_in' ? 'logged_in' : 'guest')
  const profile = ref(new SessionProfile())
  const loggingIn = ref(false)
  const errorMessage = ref('')
  const isLoggedIn = computed((): boolean => state.value === 'logged_in')
  const userId = computed((): string => isLoggedIn.value ? profile.value.userId : '')

  function reload() {
    state.value = readString(STATE_KEY) === 'logged_in' ? 'logged_in' : 'guest'
    const next = new SessionProfile()
    next.userId = readString(USER_ID_KEY)
    next.nickname = readString(NICKNAME_KEY)
    next.avatarUrl = readString(AVATAR_KEY)
    if (next.nickname === '') next.nickname = '三坑女孩'
    profile.value = next
    // 进入登录页后清除旧登录错误
    if (state.value === 'guest') errorMessage.value = ''
  }

  function persistLogin(userIdValue: string, nickname: string, avatarUrl: string) {
    uni.setStorageSync(STATE_KEY, 'logged_in')
    uni.setStorageSync(USER_ID_KEY, userIdValue)
    uni.setStorageSync(NICKNAME_KEY, nickname)
    uni.setStorageSync(AVATAR_KEY, avatarUrl)
    reload()
  }

  /**
   * 微信登录流程：
   * 1. uni.login 获取微信临时 code
   * 2. POST /api/v1/sessions/wechat { code, deviceId }
   * 3. 保存 accessToken / refreshToken
   * 4. GET /api/v1/me 恢复用户会话信息
   *
   * 登录失败不静默回退，调用方需展示 errorMessage 并给予重试能力
   */
  async function loginWithWechat(): Promise<boolean> {
    if (loggingIn.value) return false
    loggingIn.value = true
    errorMessage.value = ''
    try {
      // 1. 获取微信授权 code
      const loginResult = await new Promise<any>((resolve, reject) => {
        uni.login({
          provider: 'weixin',
          success: (res: any) => resolve(res),
          fail: (err: any) => reject(new Error(err != null && err.errMsg != null ? String(err.errMsg) : '微信授权失败')),
        })
      })
      const code: string = loginResult.code != null ? String(loginResult.code) : ''
      if (code === '') throw new Error('微信授权未返回临时 code')

      // 2. 获取设备标识
      let deviceId = readString(DEVICE_ID_KEY)
      if (deviceId === '') {
        try { deviceId = String((uni.getSystemInfoSync() as any).deviceId ?? '') } catch (_) {}
      }
      // Android 上 deviceId 可能不可用；服务端仍要求稳定的安装标识，不能因此发送空字符串。
      if (deviceId === '') {
        deviceId = `sk-${Date.now()}-${Math.floor(Math.random() * 1000000000)}`
        uni.setStorageSync(DEVICE_ID_KEY, deviceId)
      }

      // 3. POST /api/v1/sessions/wechat
      const response = await apiPost('/api/v1/sessions/wechat', { code, deviceId })
      const data: any = response.data
      if (data == null) throw new Error('登录响应为空')
      const accessToken: string = data.accessToken != null ? String(data.accessToken) : ''
      if (accessToken === '') throw new Error('登录响应缺少 accessToken')
      saveSessionTokens(accessToken, data.refreshToken != null ? String(data.refreshToken) : '')

      // 4. 获取用户信息
      let userInfo: any = null
      try {
        const meResponse = await apiGet('/api/v1/me')
        userInfo = meResponse.data
      } catch (_) {
        // 如果 /me 调用失败，仍可登录；但需要下次帧刷新
      }

      const displayName: string = userInfo != null && userInfo.nickname != null ? String(userInfo.nickname) : '三坑女孩'
      const avatar: string = userInfo != null && userInfo.avatarUrl != null ? String(userInfo.avatarUrl) : ''
      const id: string = userInfo != null && userInfo.id != null ? String(userInfo.id) : data.userId != null ? String(data.userId) : ''
      if (id === '') throw new Error('无法获取用户标识')
      persistLogin(id, displayName, avatar)
      return true
    } catch (e) {
      const message = e instanceof Error ? e.message : '登录失败，请重试'
      errorMessage.value = message
      // 显式抛出异常，调用方根据 errorMessage 展示错误状态与重试按钮
      return false
    } finally {
      loggingIn.value = false
    }
  }

  function logout() {
    clearSessionTokens()
    uni.removeStorageSync(STATE_KEY)
    uni.removeStorageSync(USER_ID_KEY)
    uni.removeStorageSync(NICKNAME_KEY)
    uni.removeStorageSync(AVATAR_KEY)
    state.value = 'guest'
    profile.value = new SessionProfile()
    errorMessage.value = ''
  }

  function clearError() {
    errorMessage.value = ''
  }

  reload()

  return {
    state,
    profile,
    isLoggedIn,
    userId,
    loggingIn,
    errorMessage,
    reload,
    loginWithWechat,
    logout,
    clearError,
  }
})
