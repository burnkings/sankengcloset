/**
 * HomeFeedStore — 首页内容发现 Feed 状态管理
 * V2.6: 稳定性修复
 * - opaque cursor 分页（保存并传递服务端 nextCursor，禁止页号×20 伪造）
 * - 频道切换重置 cursor/items/hasMore 并请求该频道第 1 页
 * - request generation 防旧请求覆盖新频道数据
 * - 保留服务端混合 Feed 原始顺序（运营内容原位插入，不全部沉底）
 * - 最大累计展示 100 条
 */

import { reactive, computed } from 'vue'
import { FeedItem, FEED_PRODUCT, FEED_RELEASE_EVENT, FEED_OUTFIT, FEED_BRAND_POST, FEED_EDITORIAL, FEED_AI_RECOMMENDATION } from '@/domain/content/feed-item'
import { fetchFeedPage, filterFeedByChannel } from '@/services/content/feed-service'
import { usePreferencesStore } from '@/stores/preferences-store'

// ====== 频道定义 ======

export const CHANNELS = ['推荐', '新品', '预约', '降价', '穿搭']

/** 最大累计展示条数（防无限创建节点） */
export const MAX_FEED_ITEMS = 100

// ====== 格式化工具 ======

/** 价格格式化：分 → ¥xxx.xx */
export function formatPrice(cents: number): string {
  if (cents <= 0) return ''
  const yuan = cents / 100
  if (yuan >= 10000) return `¥${(yuan / 10000).toFixed(1)}万`
  if (yuan == Math.floor(yuan)) return `¥${Math.floor(yuan)}`
  return `¥${yuan.toFixed(2)}`
}

/** 相对时间格式化 */
export function formatRelativeTime(isoStr: string): string {
  if (isoStr == null || isoStr == '') return ''
  const now = Date.now()
  const target = new Date(isoStr).getTime()
  const diffMs = target - now
  const diffMin = Math.floor(Math.abs(diffMs) / 60000)
  const diffHour = Math.floor(diffMin / 60)
  const diffDay = Math.floor(diffHour / 24)

  if (diffMs > 0) {
    if (diffDay > 0) return `${diffDay}天后`
    if (diffHour > 0) return `${diffHour}小时后`
    if (diffMin > 0) return `${diffMin}分钟后`
    return '即将'
  } else {
    if (diffDay > 0) return `${diffDay}天前`
    if (diffHour > 0) return `${diffHour}小时前`
    if (diffMin > 0) return `${diffMin}分钟前`
    return '刚刚'
  }
}

/** 截止时间格式化：商品卡仅展示一条紧迫度信息 */
export function formatDeadline(isoStr: string): string {
  if (isoStr == null || isoStr == '') return ''
  const diffMs = new Date(isoStr).getTime() - Date.now()
  if (diffMs <= 0) return '已结束'
  const totalMin = Math.floor(diffMs / 60000)
  const totalHour = Math.floor(totalMin / 60)
  const day = Math.floor(totalHour / 24)
  const hour = totalHour % 24
  if (day > 0) return `距结束 ${day}天${hour}时`
  if (totalHour > 0) return `距结束 ${totalHour}小时`
  return `距结束 ${Math.max(totalMin, 1)}分钟`
}

// ====== Feed 行类型 ======

export class FeedRow {
  id: string = ''
  rowType: string = 'single' // 'single' | 'pair'
  single: FeedItem | null = null
  left: FeedItem | null = null
  right: FeedItem | null = null
}

function createSingleRow(item: FeedItem): FeedRow {
  const row = new FeedRow()
  row.id = `row-${item.id}`
  row.rowType = 'single'
  row.single = item
  return row
}

function createPairRow(left: FeedItem, right: FeedItem | null): FeedRow {
  const row = new FeedRow()
  row.id = right != null ? `row-${left.id}-${right.id}` : `row-${left.id}`
  row.rowType = 'pair'
  row.left = left
  row.right = right
  return row
}

// ====== 模块级 reactive 状态（单例）======

type HomeFeedState = {
  state: string
  currentChannel: string
  allItems: FeedItem[]
  nextCursor: string
  isLoadingMore: boolean
  hasMore: boolean
  reachedLimit: boolean
  errorMessage: string
}

const _state = reactive<HomeFeedState>({
  // 状态: 'idle' | 'loading' | 'loaded' | 'error'
  state: 'idle',
  currentChannel: '推荐',
  allItems: [] as FeedItem[],
  nextCursor: '',
  isLoadingMore: false,
  hasMore: true,
  reachedLimit: false,
  errorMessage: '',
})

// 在 computed 外部初始化偏好 Store，避免在 computed 内反复调用
const prefs = usePreferencesStore()

/**
 * 偏好坑向 → 后端 categories 参数（逗号分隔，如 "LOLITA,HANFU"）
 * 空数组 = 不限分类 → 返回 ''（不传参，后端不过滤）
 */
function pitTypesToCategories(): string {
  const types = prefs.preferences.pitTypes
  if (types.length == 0) return ''
  const codes: string[] = []
  for (let i = 0; i < types.length; i++) {
    const t = types[i]
    if (t == 'Lolita') codes.push('LOLITA')
    else if (t == '汉服') codes.push('HANFU')
    else codes.push(t)
  }
  return codes.join(',')
}

const _loading = computed((): boolean => _state.state == 'loading')

/**
 * 筛选后的展示列表（按频道；顺序 = 服务端返回顺序）
 * 频道切换时 Store 已按频道重新请求，这里仅做轻量过滤兜底。
 */
const _displayItems = computed((): FeedItem[] => {
  return filterFeedByChannel(_state.allItems, _state.currentChannel)
})

const _isEmpty = computed((): boolean => {
  return _state.state == 'loaded' && _displayItems.value.length == 0
})

/**
 * Feed 行：保留服务端原始顺序。
 * 商品与穿搭（双列内容）相邻时配对成双列行；运营内容（release_event/editorial 等）
 * 原位插入为单行全宽，不再出现「全部商品先渲染、运营内容全部放后面」的割裂。
 */
function isPairEligible(item: FeedItem): boolean {
  return item.feedType == FEED_PRODUCT || item.feedType == FEED_OUTFIT
}

const _feedRows = computed((): FeedRow[] => {
  const rows: FeedRow[] = []
  const channelItems = filterFeedByChannel(_state.allItems, _state.currentChannel)
  let i = 0
  while (i < channelItems.length) {
    const item = channelItems[i]
    if (isPairEligible(item) && i + 1 < channelItems.length && isPairEligible(channelItems[i + 1])) {
      // 相邻两个商品/穿搭 → 双列行（严格保持服务端原始顺序，不跨行拉取）
      rows.push(createPairRow(item, channelItems[i + 1]))
      i += 2
    } else if (isPairEligible(item)) {
      // 商品/穿搭但无相邻配对 → 半宽单列（右侧留空），不跨越运营内容去配对
      rows.push(createPairRow(item, null))
      i += 1
    } else {
      // 发售事件/编辑专题 → 单列全宽行
      rows.push(createSingleRow(item))
      i += 1
    }
  }
  return rows
})

const CHANGE_EVENT = 'store:home-feed-changed'
function notifyChanged() { uni.$emit(CHANGE_EVENT) }

// ====== request generation：旧请求不得覆盖新频道数据 ======

let _requestSeq = 0

// ====== 模块级 action ======

// 首屏加载（silent=true 用于下拉刷新，不切 loading 态）
async function loadFirstPage(silent: boolean = false) {
  const seq = ++_requestSeq
  if (!silent) _state.state = 'loading'
  _state.errorMessage = ''
  try {
    const page = await fetchFeedPage('', _state.currentChannel, '全部', pitTypesToCategories())
    if (seq !== _requestSeq) return // 过期请求（已切频道/已刷新），丢弃
    _state.allItems = page.items.slice(0, MAX_FEED_ITEMS)
    _state.nextCursor = page.nextCursor
    _state.hasMore = page.hasMore && _state.allItems.length < MAX_FEED_ITEMS
    _state.reachedLimit = _state.allItems.length >= MAX_FEED_ITEMS
    _state.state = 'loaded'
  } catch (e) {
    if (seq !== _requestSeq) return
    _state.state = 'error'
    _state.errorMessage = e instanceof Error ? e.message : '加载失败'
  } finally {
    if (seq === _requestSeq) notifyChanged()
  }
}

// 加载更多（防重入；opaque cursor 传递）
async function loadMore() {
  if (_state.isLoadingMore || !_state.hasMore || _state.state !== 'loaded') return
  if (_state.reachedLimit || _state.allItems.length >= MAX_FEED_ITEMS) {
    _state.hasMore = false
    _state.reachedLimit = true
    notifyChanged()
    return
  }
  const seq = _requestSeq
  _state.isLoadingMore = true
  try {
    const page = await fetchFeedPage(_state.nextCursor, _state.currentChannel, '全部', pitTypesToCategories())
    if (seq !== _requestSeq) return // 期间已切频道，丢弃
    if (page.items.length == 0) {
      _state.hasMore = false
    } else {
      const remaining = MAX_FEED_ITEMS - _state.allItems.length
      const incoming = page.items.slice(0, remaining)
      _state.allItems = [..._state.allItems, ...incoming]
      _state.nextCursor = page.nextCursor
      if (_state.allItems.length >= MAX_FEED_ITEMS) {
        _state.hasMore = false
        _state.reachedLimit = true
      } else {
        _state.hasMore = page.hasMore
      }
    }
  } catch (e) {
    _state.errorMessage = e instanceof Error ? e.message : '加载失败'
  } finally {
    _state.isLoadingMore = false
    if (seq === _requestSeq) notifyChanged()
  }
}

// 切换频道：重置 cursor/items/hasMore 并请求该频道第 1 页
function setChannel(ch: string) {
  if (ch == _state.currentChannel) return
  _state.currentChannel = ch
  _state.nextCursor = ''
  _state.allItems = []
  _state.hasMore = true
  _state.reachedLimit = false
  _state.errorMessage = ''
  notifyChanged()
  loadFirstPage()
}

// 重试
function retry() {
  loadFirstPage()
}

// 切换收藏
function toggleLike(itemId: string) {
  const items: FeedItem[] = [..._state.allItems]
  for (let i = 0; i < items.length; i++) {
    if (items[i].id == itemId) {
      items[i].liked = !items[i].liked
      break
    }
  }
  _state.allItems = items
  notifyChanged()
}

function toggleSave(itemId: string) {
  const items: FeedItem[] = [..._state.allItems]
  for (let i = 0; i < items.length; i++) {
    if (items[i].id == itemId) {
      items[i].saved = !items[i].saved
      break
    }
  }
  _state.allItems = items
  notifyChanged()
}

function refreshPreferences() {
  prefs.loadPreferences()
}

// 首页 onPageShow 调用：偏好变化才重新请求 Feed（避免每次切 Tab 全量刷新）
function buildPrefSignature(): string {
  const p = prefs.preferences
  return `${p.pitTypes.join(',')}|${p.followedBrands.join(',')}|${p.priceRange}`
}
let lastPrefSignature = buildPrefSignature()
function refreshIfPreferencesChanged() {
  const sig = buildPrefSignature()
  if (sig == lastPrefSignature) return
  lastPrefSignature = sig
  loadFirstPage()
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class HomeFeedStoreHandle {
  get state(): string { return _state.state }
  get loading(): boolean { return _loading.value }
  get isEmpty(): boolean { return _isEmpty.value }
  get errorMessage(): string { return _state.errorMessage }
  get currentChannel(): string { return _state.currentChannel }
  get allItems(): FeedItem[] { return _state.allItems }
  get displayItems(): FeedItem[] { return _displayItems.value }
  get feedRows(): FeedRow[] { return _feedRows.value }
  get isLoadingMore(): boolean { return _state.isLoadingMore }
  get hasMore(): boolean { return _state.hasMore }
  get reachedLimit(): boolean { return _state.reachedLimit }
  loadFirstPage(silent: boolean = false): Promise<void> { return loadFirstPage(silent) }
  loadMore(): Promise<void> { return loadMore() }
  setChannel(ch: string): void { setChannel(ch) }
  retry(): void { retry() }
  toggleLike(itemId: string): void { toggleLike(itemId) }
  toggleSave(itemId: string): void { toggleSave(itemId) }
  refreshPreferences(): void { refreshPreferences() }
  refreshIfPreferencesChanged(): void { refreshIfPreferencesChanged() }
}

let _handle: HomeFeedStoreHandle | null = null
export function useHomeFeedStore(): HomeFeedStoreHandle {
  if (_handle == null) _handle = new HomeFeedStoreHandle()
  return _handle!
}
