/**
 * HomeFeedStore — 首页内容发现 Feed 状态管理
 * V2.6: 稳定性修复
 * - opaque cursor 分页（保存并传递服务端 nextCursor，禁止页号×20 伪造）
 * - 频道切换重置 cursor/items/hasMore 并请求该频道第 1 页
 * - request generation 防旧请求覆盖新频道数据
 * - 保留服务端混合 Feed 原始顺序（运营内容原位插入，不全部沉底）
 */

import { reactive, nextTick } from 'vue'
import { FeedItem, FEED_PRODUCT } from '@/domain/content/feed-item'
import { isFeedCardType } from '@/utils/feed-image-policy'
import { fetchFeedPage, filterFeedByChannel } from '@/services/content/feed-service'
import { usePreferencesStore } from '@/stores/preferences-store'
import { bumpWishCount, wishCountOf } from '@/services/content/wish-count'
import { useBlacklistStore } from '@/stores/blacklist-store'
import { formatPriceCents, formatRelativeTime as formatRelativeTimeImpl, formatDeadline as formatDeadlineImpl } from '@/utils/format'

// ====== 频道定义 ======

export const CHANNELS = ['推荐', '上新', '预约', '现货']

// ====== 常量 ======
/** Feed 内存上限：超过后截断最旧条目，防止持续上拉无限增长 */
const MAX_FEED_ITEMS = 200

// ====== 格式化工具（统一收敛到 utils/format.uts，此处保留导出名兼容既有 import） ======

/** 价格格式化：分 → ¥xxx.xx */
export function formatPrice(cents: number): string {
  return formatPriceCents(cents)
}

/** 相对时间格式化 */
export function formatRelativeTime(isoStr: string): string {
  return formatRelativeTimeImpl(isoStr)
}

/** 截止时间格式化：商品卡仅展示一条紧迫度信息 */
export function formatDeadline(isoStr: string): string {
  return formatDeadlineImpl(isoStr)
}

// ====== 瀑布流块类型 ======

export class MasonryBlock {
  type: string = 'columns' // 'columns' | 'full'
  full: FeedItem | null = null
  left: FeedItem[] = []
  right: FeedItem[] = []
}

/** 双列错落图片高度：按 item.id 确定性哈希，制造参差瀑布流 */
export function feedImageHeight(item: FeedItem): string {
  let h = 0
  const id = item.id
  for (let i = 0; i < id.length; i++) {
    h = (h * 31 + id.charCodeAt(i)) % 1000003
  }
  const m = h % 4
  if (m == 0) return '470rpx'
  if (m == 1) return '520rpx'
  if (m == 2) return '440rpx'
  return '580rpx'
}

// ====== 模块级 reactive 状态（单例）======

type HomeFeedState = {
  state: string
  currentChannel: string
  allItems: FeedItem[]
  nextCursor: string
  isLoadingMore: boolean
  hasMore: boolean
  errorMessage: string
}

const _state = reactive<HomeFeedState>({
  // 状态: 'idle' | 'loading' | 'loaded' | 'error'
  state: 'idle',
  currentChannel: '推荐',
  allItems: [] as FeedItem[],
  nextCursor: '',
  isLoadingMore: false,
  hasMore: true,
  errorMessage: '',
})

// 在 computed 外部初始化偏好 Store，避免在 computed 内反复调用
const prefs = usePreferencesStore()
// 品牌黑名单：屏蔽后不进入 Feed 展示
const blacklist = useBlacklistStore()

function isBrandBlocked(brandName: string): boolean {
  return blacklist.isBlacklisted(brandName)
}

function fitsPricePreference(item: FeedItem): boolean {
  if (item.feedType != FEED_PRODUCT || item.price <= 0) return true
  const range = prefs.preferences.priceRange
  if (range == '0-300') return item.price <= 30000
  if (range == '300-600') return item.price >= 30000 && item.price <= 60000
  if (range == '600+') return item.price >= 60000
  return true
}

/**
 * 偏好坑向 → 后端 categories 参数（逗号分隔，如 "LOLITA,HANFU"）
 * 空数组 = 不限分类 → 返回 ''（不传参，后端不过滤）
 */
function pitTypesToCategories(): string {
  const types = prefs.preferences.pitTypes
  if (types.length == 0) return ''
  const codes: string[] = []
  for (let i = 0; i < types.length; i++) {
    const t = types[i]
    if (t == 'Lolita') codes.push('LOLITA')
    else if (t == '汉服') codes.push('HANFU')
    else if (t == '混搭') codes.push('MIXED')
    else codes.push(t)
  }
  return codes.join(',')
}

function isLoading(): boolean { return _state.state == 'loading' }

/**
 * 筛选后的展示列表（按频道；顺序 = 服务端返回顺序）
 * 频道切换时 Store 已按频道重新请求，这里仅做轻量过滤兜底。
 */
function displayItems(): FeedItem[] {
  return filterFeedByChannel(_state.allItems, _state.currentChannel).filter((item) => !isBrandBlocked(item.brandName) && fitsPricePreference(item))
}

function isEmpty(): boolean {
  return _state.state == 'loaded' && displayItems().length == 0
}

/** 双列错落卡片：商品/穿搭归入两列，运营内容全宽。
 *  ⚠️ 分类口径统一走 utils/feed-image-policy —— 预取与本文件的判断必须同源，
 *     否则「预取 A 档、渲染 B 档」白下载（曾真实发生）。 */
function isCardEligible(item: FeedItem): boolean {
  return isFeedCardType(item.feedType)
}

/**
 * 瀑布流块：保留服务端原始顺序。
 * 连续商品/穿搭按「交替」分入左右两列（配合可变图片高度实现双列错落）；
 * 运营内容（release_event/editorial 等）原位插入为全宽块，不跨块拉取。
 */
function masonryBlocks(): MasonryBlock[] {
  const blocks: MasonryBlock[] = []
  const channelItems = filterFeedByChannel(_state.allItems, _state.currentChannel).filter((item) => !isBrandBlocked(item.brandName) && fitsPricePreference(item))
  let i = 0
  while (i < channelItems.length) {
    const item = channelItems[i]
    if (!isCardEligible(item)) {
      const b = new MasonryBlock()
      b.type = 'full'
      b.full = item
      blocks.push(b)
      i += 1
      continue
    }
    const block = new MasonryBlock()
    block.type = 'columns'
    let col = 0
    while (i < channelItems.length && isCardEligible(channelItems[i])) {
      if (col % 2 == 0) block.left.push(channelItems[i])
      else block.right.push(channelItems[i])
      col += 1
      i += 1
    }
    blocks.push(block)
  }
  return blocks
}

// ====== 瀑布流缓存：签名不变时复用已构建块，避免滚动/点赞触发全量重建 ======
let _blocksCache: MasonryBlock[] | null = null
let _blocksSig = ''
function buildBlocks(): MasonryBlock[] {
  const sig = `${_state.currentChannel}|${_state.allItems.length}|${buildPrefSignature()}|${blacklist.brands.join(',')}`
  if (_blocksCache != null && _blocksSig === sig) return _blocksCache!
  _blocksSig = sig
  _blocksCache = masonryBlocks()
  return _blocksCache!
}
function invalidateBlocksCache() { _blocksCache = null; _blocksSig = '' }

function notifyChanged() {}

// ====== request generation：旧请求不得覆盖新频道数据 ======

let _requestSeq = 0
class ChannelSnapshot {
  channel: string = ''
  items: FeedItem[] = []
  nextCursor: string = ''
  hasMore: boolean = true
  fetchedAt: number = 0
}
let channelCache: ChannelSnapshot[] = []
let currentFetchedAt = 0
/** 本次运行是否已经预取过其他频道（只做一次，避免反复打网络） */
let prefetchStarted = false

/**
 * 首屏渲染完成后，**静默预取其余频道的第一页**。
 *
 * 为什么：切频道时如果该频道本次会话还没数据，`setChannel` 会把列表清空并进 loading，
 * 模板随即用整屏骨架替换内容 —— 用户看到的就是「一换栏目，商品图全没了、过一会儿才回来」。
 * 预取之后切过去直接命中 `channelCache`，不触发骨架，视觉上是平滑替换。
 *
 * 三个约束：
 *   · **失败完全静默** —— 预取只是加速，切过去时照常加载，不能因为它报错；
 *   · **串行**，不跟可见页面抢带宽；
 *   · **只写 channelCache，不碰 _state** —— 任何情况下都不能影响当前正在看的频道。
 */
async function prefetchOtherChannels() {
  if (prefetchStarted) return
  prefetchStarted = true
  for (let i = 0; i < CHANNELS.length; i++) {
    const ch = CHANNELS[i]
    if (ch === _state.currentChannel) continue
    if (channelCache.some((item) => item.channel === ch)) continue
    try {
      const page = await fetchFeedPage('', ch, '全部', pitTypesToCategories())
      const entry = new ChannelSnapshot()
      entry.channel = ch
      entry.items = page.items
      entry.nextCursor = page.nextCursor
      entry.hasMore = page.hasMore
      entry.fetchedAt = Date.now()
      channelCache = channelCache.filter((item) => item.channel !== ch)
      channelCache.push(entry)
      if (channelCache.length > 4) channelCache.shift()
    } catch (e) {
      // 预取失败无所谓：切过去时走正常加载
    }
  }
}
function rememberChannel() {
  if (_state.state !== 'loaded') return
  const entry = new ChannelSnapshot()
  entry.channel = _state.currentChannel
  entry.items = _state.allItems.slice()
  entry.nextCursor = _state.nextCursor
  entry.hasMore = _state.hasMore
  entry.fetchedAt = currentFetchedAt
  channelCache = channelCache.filter((item) => item.channel !== entry.channel)
  channelCache.push(entry)
  if (channelCache.length > 4) channelCache.shift()
}

// ====== 模块级 action ======

// 首屏加载（silent=true 用于下拉刷新，不切 loading 态；force=true 跳过缓存强拉）
async function loadFirstPage(silent: boolean = false, force: boolean = false) {
  _state.isLoadingMore = false
  const seq = ++_requestSeq
  if (!silent) _state.state = 'loading'
  _state.errorMessage = ''
  try {
    const page = await fetchFeedPage('', _state.currentChannel, '全部', pitTypesToCategories(), force)
    if (seq !== _requestSeq) return // 过期请求（已切频道/已刷新），丢弃
    await nextTick()
    if (seq !== _requestSeq) return
    _state.allItems = page.items
    _state.nextCursor = page.nextCursor
    _state.hasMore = page.hasMore
    _state.state = 'loaded'
    currentFetchedAt = Date.now()
    rememberChannel()
    invalidateBlocksCache()
    // 首屏已经渲染完了，再去预取其余频道（不 await，不阻塞）
    prefetchOtherChannels()
  } catch (e) {
    if (seq !== _requestSeq) return
    _state.state = _state.allItems.length > 0 ? 'loaded' : 'error'
    _state.errorMessage = e instanceof Error ? e.message : '加载失败'
  } finally {
    if (seq === _requestSeq) notifyChanged()
  }
}

// 加载更多（防重入；opaque cursor 传递）
async function loadMore() {
  if (_state.isLoadingMore || !_state.hasMore || _state.state !== 'loaded') return
  const seq = _requestSeq
  _state.errorMessage = ''
  _state.isLoadingMore = true
  try {
    const page = await fetchFeedPage(_state.nextCursor, _state.currentChannel, '全部', pitTypesToCategories())
    if (seq !== _requestSeq) return // 期间已切频道，丢弃
    await nextTick()
    if (seq !== _requestSeq) return
    // ⚠️ 必须先「接收本页有效项」，再独立决定是否继续翻页。
    //    曾把「nextCursor 为空」与「本页无效」混为一谈 ⇒ 合法末页
    //    （items 非空 + hasMore=false + nextCursor=''）被整页丢弃（2026-10-09 评审 P1-5）。
    const previousCursor = _state.nextCursor
    if (page.items.length > 0) {
      const seen: Set<string> = new Set<string>()
      for (let i = 0; i < _state.allItems.length; i++) seen.add(_state.allItems[i].id)
      const incoming: FeedItem[] = []
      for (let i = 0; i < page.items.length; i++) {
        const item = page.items[i]
        if (seen.has(item.id)) continue
        seen.add(item.id)
        incoming.push(item)
      }
      if (incoming.length > 0) {
        let merged = [..._state.allItems, ...incoming]
        // 内存保护：最多保留最新 200 条，避免持续上拉无限膨胀
        if (merged.length > MAX_FEED_ITEMS) merged = merged.slice(merged.length - MAX_FEED_ITEMS)
        _state.allItems = merged
        invalidateBlocksCache()
      }
    }
    // 终止判定独立于「是否接收本页」：本页为空 / 服务端说没了 / 游标没前进 都停
    const cursorAdvanced = page.nextCursor !== '' && page.nextCursor !== previousCursor
    _state.nextCursor = page.nextCursor
    _state.hasMore = page.items.length > 0 && page.hasMore && cursorAdvanced
  } catch (e) {
    if (seq !== _requestSeq) return
    _state.errorMessage = e instanceof Error ? e.message : '加载失败'
  } finally {
    if (seq === _requestSeq) _state.isLoadingMore = false
    if (seq === _requestSeq) notifyChanged()
  }
}

// 切换频道：重置 cursor/items/hasMore 并请求该频道第 1 页
function setChannel(ch: string) {
  if (ch == _state.currentChannel) return
  rememberChannel()
  ++_requestSeq
  _state.isLoadingMore = false
  _state.currentChannel = ch
  const cached = channelCache.find((item) => item.channel === ch)
  if (cached != null) {
    _state.allItems = cached.items.slice()
    _state.nextCursor = cached.nextCursor
    _state.hasMore = cached.hasMore
    _state.state = 'loaded'
    _state.errorMessage = ''
    currentFetchedAt = cached.fetchedAt
    invalidateBlocksCache()
    if (Date.now() - cached.fetchedAt >= 300000) loadFirstPage(true)
    return
  }
  _state.nextCursor = ''
  _state.allItems = []
  _state.hasMore = true
  _state.errorMessage = ''
  invalidateBlocksCache()
  notifyChanged()
  loadFirstPage()
}

// 重试
function retry() {
  loadFirstPage()
}

// 切换收藏
function toggleLike(itemId: string) {
  const items: FeedItem[] = [..._state.allItems]
  for (let i = 0; i < items.length; i++) {
    if (items[i].id == itemId) {
      items[i].liked = !items[i].liked
      break
    }
  }
  _state.allItems = items
  notifyChanged()
}

function toggleSave(itemId: string) {
  const items: FeedItem[] = [..._state.allItems]
  for (let i = 0; i < items.length; i++) {
    if (items[i].id == itemId) {
      items[i].saved = !items[i].saved
      // 收藏数跟着动：否则会出现「爱心点亮了但数字不动」。
      // 走 wish-count 的本地增量（服务端计数 + 增量），这样任何入口读到的数字都一致。
      const entityId = items[i].entityId !== '' ? items[i].entityId : items[i].id
      bumpWishCount(entityId, items[i].saved ? 1 : -1)
      // ⚠️ 基数用 `wishCountBase`（服务端原值），**不能**用 `wishCount`（已被本地增量改过）——
      // 拿它当基数会再叠一次增量，出现「取消再收藏 → 数字变 2」。
      items[i].wishCount = wishCountOf(entityId, items[i].wishCountBase)
      break
    }
  }
  _state.allItems = items
  notifyChanged()
}

function refreshPreferences() {
  prefs.loadPreferences()
}

// 首页 onPageShow 调用：偏好变化才重新请求 Feed（避免每次切 Tab 全量刷新）
function buildPrefSignature(): string {
  const p = prefs.preferences
  return `${p.pitTypes.join(',')}|${p.followedBrands.join(',')}|${p.priceRange}`
}
let lastPrefSignature = buildPrefSignature()
function refreshIfPreferencesChanged() {
  const sig = buildPrefSignature()
  if (sig == lastPrefSignature) return
  lastPrefSignature = sig
  channelCache = []
  _state.allItems = []
  loadFirstPage()
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class HomeFeedStoreHandle {
  get state(): string { return _state.state }
  get loading(): boolean { return isLoading() }
  get isEmpty(): boolean { return isEmpty() }
  get errorMessage(): string { return _state.errorMessage }
  get currentChannel(): string { return _state.currentChannel }
  get allItems(): FeedItem[] { return _state.allItems }
  get displayItems(): FeedItem[] { return displayItems() }
  get masonryBlocks(): MasonryBlock[] { return buildBlocks() }
  get isLoadingMore(): boolean { return _state.isLoadingMore }
  get hasMore(): boolean { return _state.hasMore }
  loadFirstPage(silent: boolean = false, force: boolean = false): Promise<void> { return loadFirstPage(silent, force) }
  loadMore(): Promise<void> { return loadMore() }
  setChannel(ch: string): void { setChannel(ch) }
  retry(): void { retry() }
  toggleLike(itemId: string): void { toggleLike(itemId) }
  toggleSave(itemId: string): void { toggleSave(itemId) }
  refreshPreferences(): void { refreshPreferences() }
  refreshIfPreferencesChanged(): void { refreshIfPreferencesChanged() }
}

let _handle: HomeFeedStoreHandle | null = null
export function useHomeFeedStore(): HomeFeedStoreHandle {
  if (_handle == null) _handle = new HomeFeedStoreHandle()
  return _handle!
}

