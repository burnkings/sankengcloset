/**
 * HomeFeedStore — 首页内容发现 Feed 状态管理
 * Phase 1C: 状态完整性、分页防重、频道切换重置
 * 数据访问与筛选统一经 FeedService 提供
 */

import { reactive, computed } from 'vue'
import { FeedItem, FEED_PRODUCT, FEED_RELEASE_EVENT, FEED_OUTFIT, FEED_BRAND_POST, FEED_EDITORIAL, FEED_AI_RECOMMENDATION } from '@/domain/content/feed-item'
import { fetchFeedPage, filterFeedByChannel } from '@/services/content/feed-service'
import { usePreferencesStore } from '@/stores/preferences-store'

// ====== 频道定义 ======

export const CHANNELS = ['推荐', '新品', '预约', '降价', '穿搭']
export const CATEGORY_FILTERS = ['全部', 'JK', 'Lolita', '汉服']

function categoryCode(category: string): string {
  if (category === 'Lolita') return 'LOLITA'
  if (category === '汉服') return 'HANFU'
  return category
}



// ====== 格式化工具 ======

/** 价格格式化：分 → ¥xxx.xx */
export function formatPrice(cents: number): string {
  if (cents <= 0) return ''
  const yuan = cents / 100
  if (yuan >= 10000) return `¥${(yuan / 10000).toFixed(1)}万`
  if (yuan === Math.floor(yuan)) return `¥${Math.floor(yuan)}`
  return `¥${yuan.toFixed(2)}`
}

/** 相对时间格式化 */
export function formatRelativeTime(isoStr: string): string {
  if (isoStr === '') return ''
  const now = Date.now()
  const target = new Date(isoStr).getTime()
  const diffMs = target - now
  const diffMin = Math.floor(Math.abs(diffMs) / 60000)
  const diffHour = Math.floor(diffMin / 60)
  const diffDay = Math.floor(diffHour / 24)

  if (diffMs > 0) {
    if (diffDay > 0) return `${diffDay}天后`
    if (diffHour > 0) return `${diffHour}小时后`
    if (diffMin > 0) return `${diffMin}分钟后`
    return '即将'
  } else {
    if (diffDay > 0) return `${diffDay}天前`
    if (diffHour > 0) return `${diffHour}小时前`
    if (diffMin > 0) return `${diffMin}分钟前`
    return '刚刚'
  }
}

/** 截止时间格式化：商品卡仅展示一条紧迫度信息 */
export function formatDeadline(isoStr: string): string {
  if (isoStr === '') return ''
  const diffMs = new Date(isoStr).getTime() - Date.now()
  if (diffMs <= 0) return '已结束'
  const totalMin = Math.floor(diffMs / 60000)
  const totalHour = Math.floor(totalMin / 60)
  const day = Math.floor(totalHour / 24)
  const hour = totalHour % 24
  if (day > 0) return `距结束 ${day}天${hour}时`
  if (totalHour > 0) return `距结束 ${totalHour}小时`
  return `距结束 ${Math.max(totalMin, 1)}分钟`
}

// ====== 内存上限 ======

/** 全量缓存上限（约 3 屏），超限时丢弃最早加载的页 */
const MAX_CACHED_ITEMS = 60

// ====== Feed 行类型 ======

export class FeedRow {
  id: string = ''
  rowType: string = 'single' // 'single' | 'pair'
  single: FeedItem | null = null
  left: FeedItem | null = null
  right: FeedItem | null = null
}

function createSingleRow(item: FeedItem): FeedRow {
  const row = new FeedRow()
  row.id = `row-${item.id}`
  row.rowType = 'single'
  row.single = item
  return row
}

function createPairRow(left: FeedItem, right: FeedItem | null): FeedRow {
  const row = new FeedRow()
  row.id = right !== null ? `row-${left.id}-${right.id}` : `row-${left.id}`
  row.rowType = 'pair'
  row.left = left
  row.right = right
  return row
}

// ====== 模块级 reactive 状态（单例）======

type HomeFeedState = {
  state: string
  currentChannel: string
  currentCategory: string
  allItems: FeedItem[]
  currentPage: number
  isLoadingMore: boolean
  hasMore: boolean
  errorMessage: string
}

const _state = reactive<HomeFeedState>({
  // 状态: 'idle' | 'loading' | 'loaded' | 'error'
  state: 'idle',
  currentChannel: '推荐',
  currentCategory: '全部',
  allItems: [] as FeedItem[],
  currentPage: 0,
  isLoadingMore: false,
  hasMore: true,
  errorMessage: '',
})

// 在 computed 外部初始化偏好 Store，避免在 computed 内反复调用
const prefs = usePreferencesStore()

const _loading = computed((): boolean => _state.state === 'loading')

// 筛选后的展示列表
const _displayItems = computed((): FeedItem[] => {
  const ch = _state.currentChannel
  const channelItems = filterFeedByChannel(_state.allItems, ch)
  const category = _state.currentCategory
  let result = channelItems
  if (category === '' || category === '全部') {
    result = channelItems
  } else {
    const code = categoryCode(category)
    result = channelItems.filter((item) => item.category === code)
  }
  // Preference-based sorting
  const sorted = [...result]
  sorted.sort((a, b) => prefs.computeScore(b) - prefs.computeScore(a))
  return sorted
})

const _isEmpty = computed((): boolean => {
  return _state.state === 'loaded' && _displayItems.value.length === 0
})

// 混合流: product 双列合并，其他单列
const _feedRows = computed((): FeedRow[] => {
  const rows: FeedRow[] = []
  const filtered = _displayItems.value
  let i = 0
  while (i < filtered.length) {
    const item = filtered[i]
    if (item.feedType === FEED_PRODUCT) {
      if (i + 1 < filtered.length && filtered[i + 1].feedType === FEED_PRODUCT) {
        rows.push(createPairRow(item, filtered[i + 1]))
        i += 2
      } else {
        rows.push(createPairRow(item, null))
        i += 1
      }
    } else {
      rows.push(createSingleRow(item))
      i += 1
    }
  }
  return rows
})

const CHANGE_EVENT = 'store:home-feed-changed'
function notifyChanged() { uni.$emit(CHANGE_EVENT) }

// ====== 模块级 action ======

// 首屏加载
async function loadFirstPage() {
  _state.state = 'loading'
  _state.errorMessage = ''
  try {
    const page = await fetchFeedPage(0)
    _state.allItems = page.items
    _state.currentPage = 1
    _state.hasMore = page.hasMore
    _state.state = 'loaded'
  } catch (e) {
    _state.state = 'error'
    _state.errorMessage = e instanceof Error ? e.message : '加载失败'
  }
  notifyChanged()
}

// 加载更多（防重入）
async function loadMore() {
  if (_state.isLoadingMore || !_state.hasMore || _state.state !== 'loaded') return
  _state.isLoadingMore = true
  try {
    const page = await fetchFeedPage(_state.currentPage)
    if (page.items.length === 0) {
      _state.hasMore = false
    } else {
      // 追加新页，保留全量上限内的条目，丢弃最早的部分
      const merged = [..._state.allItems, ...page.items]
      if (merged.length > MAX_CACHED_ITEMS) {
        // 按 createdAt 降序，保留最新的 MAX_CACHED_ITEMS 条
        merged.sort((a, b) => a.createdAt < b.createdAt ? 1 : -1)
        _state.allItems = merged.slice(0, MAX_CACHED_ITEMS)
      } else {
        _state.allItems = merged
      }
      _state.currentPage += 1
      _state.hasMore = page.hasMore
    }
  } catch (e) {
    _state.errorMessage = e instanceof Error ? e.message : '加载失败'
  } finally {
    _state.isLoadingMore = false
  }
  notifyChanged()
}

// 切换频道（重置分页状态，不重新加载数据）
function setChannel(ch: string) {
  if (ch === _state.currentChannel) return
  _state.currentChannel = ch
  // displayItems computed 自动重算，hasMore 基于全量数据
  notifyChanged()
}

function setCategory(category: string) {
  if (category === _state.currentCategory) return
  _state.currentCategory = category
  notifyChanged()
}

// 重试
function retry() {
  loadFirstPage()
}

// 切换收藏
function toggleLike(itemId: string) {
  const items = _state.allItems
  for (let i = 0; i < items.length; i++) {
    if (items[i].id === itemId) {
      items[i].liked = !items[i].liked
      break
    }
  }
  notifyChanged()
}

function toggleSave(itemId: string) {
  const items = _state.allItems
  for (let i = 0; i < items.length; i++) {
    if (items[i].id === itemId) {
      items[i].saved = !items[i].saved
      break
    }
  }
  notifyChanged()
}

function refreshPreferences() {
  prefs.loadPreferences()
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class HomeFeedStoreHandle {
  get state(): string { return _state.state }
  get loading(): boolean { return _loading.value }
  get isEmpty(): boolean { return _isEmpty.value }
  get errorMessage(): string { return _state.errorMessage }
  get currentChannel(): string { return _state.currentChannel }
  get currentCategory(): string { return _state.currentCategory }
  get allItems(): FeedItem[] { return _state.allItems }
  get displayItems(): FeedItem[] { return _displayItems.value }
  get feedRows(): FeedRow[] { return _feedRows.value }
  get isLoadingMore(): boolean { return _state.isLoadingMore }
  get hasMore(): boolean { return _state.hasMore }
  loadFirstPage(): Promise<void> { return loadFirstPage() }
  loadMore(): Promise<void> { return loadMore() }
  setChannel(ch: string): void { setChannel(ch) }
  setCategory(category: string): void { setCategory(category) }
  retry(): void { retry() }
  toggleLike(itemId: string): void { toggleLike(itemId) }
  toggleSave(itemId: string): void { toggleSave(itemId) }
  refreshPreferences(): void { refreshPreferences() }
}

let _handle: HomeFeedStoreHandle | null = null
export function useHomeFeedStore(): HomeFeedStoreHandle {
  if (_handle == null) _handle = new HomeFeedStoreHandle()
  return _handle!
}
