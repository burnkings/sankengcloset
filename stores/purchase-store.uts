/** PurchaseStore — 页面与购买仓库之间的状态层。 */
import { reactive } from 'vue'

import { PurchaseRecord, PurchaseUpdateData } from '@/domain/purchase-record'
import { toDisplayModels, PurchaseDisplayModel } from '@/domain/purchase-presenter'
import * as repo from '@/domain/repositories/purchase-repo'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'
import { getCachedAccessToken } from '@/config/runtime'
import { createAssetRemote, deleteAssetRemote, listPurchasesRemote, patchAssetRemote } from '@/services/user-data/user-data-service'
import { useReminderStore } from '@/stores/reminder-store'

// ====== 模块级 reactive 状态（单例）======

type PurchaseState = {
  items: PurchaseRecord[]
  loading: boolean
  error: string
  filterStatus: string
}

const _state = reactive<PurchaseState>({
  items: [] as PurchaseRecord[],
  loading: false,
  error: '',
  filterStatus: '',
})

function activeItems(): PurchaseRecord[] { return _state.items.filter((r) => !r.isDeleted) }
function filteredItems(): PurchaseRecord[] {
  let result = activeItems()
  if (_state.filterStatus != '') result = result.filter((r) => r.paymentStatus == _state.filterStatus)
  return [...result].sort((a, b) => {
    const da = a.purchaseDate != '' ? new Date(a.purchaseDate).getTime() : 0
    const db = b.purchaseDate != '' ? new Date(b.purchaseDate).getTime() : 0
    return db - da
  })
}
function displayItems(): PurchaseDisplayModel[] { return toDisplayModels(filteredItems()) }
function pendingPayments(): PurchaseRecord[] { return activeItems().filter((r) => r.remainingAmount > 0) }
function totalSpent(): number { return activeItems().reduce((sum, r) => sum + r.totalAmount, 0) }
function remainingTotal(): number { return activeItems().reduce((sum, r) => sum + r.remainingAmount, 0) }
function itemCount(): number { return activeItems().length }

const CHANGE_EVENT = 'store:purchase-changed'
function notifyChanged() { uni.$emit(CHANGE_EVENT) }

// ====== 模块级 action ======

/** 金额读取：优先后端规格字段（totalCents 等，一律分），回退旧兼容字段（同为分） */
function readCents(raw: UTSJSONObject, centsKey: string, legacyKey: string): number {
  const cents = raw[centsKey] != null ? raw[centsKey] as number : 0
  if (cents > 0) return cents
  return raw[legacyKey] != null ? raw[legacyKey] as number : 0
}

function mapRemotePurchase(raw: UTSJSONObject): PurchaseRecord {
  const item = new PurchaseRecord()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.name = raw['name'] != null ? raw['name'] as string : ''
  item.brand = raw['brand'] != null ? raw['brand'] as string : ''
  item.shopName = raw['shopName'] != null ? raw['shopName'] as string : ''
  item.category = raw['category'] != null ? raw['category'] as string : 'OTHER'
  item.totalAmount = readCents(raw, 'totalCents', 'totalAmount')
  item.depositAmount = readCents(raw, 'depositCents', 'depositAmount')
  item.paidAmount = readCents(raw, 'paidCents', 'paidAmount')
  item.remainingAmount = readCents(raw, 'remainingCents', 'remainingAmount')
  item.paymentStatus = raw['paymentStatus'] != null ? raw['paymentStatus'] as string : 'PRE_ORDER'
  item.purchaseDate = raw['purchaseDate'] != null ? raw['purchaseDate'] as string : ''
  item.deadline = raw['deadline'] != null ? raw['deadline'] as string : ''
  item.arrivalDate = raw['arrivalDate'] != null ? raw['arrivalDate'] as string : ''
  item.wishId = raw['wishId'] != null ? raw['wishId'] as string : ''
  item.wardrobeId = raw['wardrobeId'] != null ? raw['wardrobeId'] as string : ''
  item.note = raw['note'] != null ? raw['note'] as string : ''
  item.isFavorite = raw['isFavorite'] == true
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  item.updatedAt = raw['updatedAt'] != null ? raw['updatedAt'] as string : ''
  return item
}

/** 远程 payload：规格字段（分）+ 旧兼容字段（分）双写，与后端「金额一律整数分」契约对齐 */
function toRemotePayload(record: PurchaseRecord): UTSJSONObject {
  return {
    id: record.id,
    name: record.name,
    brand: record.brand,
    shopName: record.shopName,
    category: record.category,
    paymentStatus: record.paymentStatus,
    totalCents: record.totalAmount,
    depositCents: record.depositAmount,
    paidCents: record.paidAmount,
    remainingCents: record.remainingAmount,
    totalAmount: record.totalAmount,
    depositAmount: record.depositAmount,
    paidAmount: record.paidAmount,
    remainingAmount: record.remainingAmount,
    purchaseDate: record.purchaseDate,
    deadline: record.deadline,
    arrivalDate: record.arrivalDate,
    wishId: record.wishId,
    wardrobeId: record.wardrobeId,
    note: record.note,
    isFavorite: record.isFavorite,
    createdAt: record.createdAt,
    updatedAt: record.updatedAt,
  } as UTSJSONObject
}

async function fetchPurchases() {
  _state.loading = true
  _state.error = ''
  try {
    if (getCachedAccessToken() != '') {
      const remote = await listPurchasesRemote()
      const restored = [] as PurchaseRecord[]
      for (let i = 0; i < remote.length; i++) restored.push(mapRemotePurchase(remote[i]))
      _state.items = restored
    } else {
      repo.initMockData()
      _state.items = repo.getAll()
    }
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '加载失败'
    _state.items = repo.getAll()
  } finally {
    _state.loading = false
  }
  notifyChanged()
}

function addPurchase(record: PurchaseRecord): PurchaseRecord | null {
  try {
    const added = repo.add(record)
    _state.items = [..._state.items, added]
    useReminderStore().syncPurchaseReminders(added)
    // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
    if (getCachedAccessToken() != '') {
      createAssetRemote('purchases', toRemotePayload(added)).catch(() => {
        enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', added.id, 'create', JSON.stringify(toRemotePayload(added)))
      })
    } else {
      enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', added.id, 'create', JSON.stringify(toRemotePayload(added)))
    }
    notifyChanged()
    return added
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '添加失败'
    return null
  }
}

function updatePurchase(id: string, data: PurchaseUpdateData): boolean {
  const ok = repo.update(id, data)
  if (ok) {
    _state.items = repo.getAll()
    const refreshed = _state.items.find((item) => item.id == id)
    if (refreshed != null) useReminderStore().syncPurchaseReminders(refreshed)
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
      if (getCachedAccessToken() != '') {
        patchAssetRemote('purchases', id, toRemotePayload(current)).catch(() => {
          enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'update', JSON.stringify(toRemotePayload(current)))
        })
      } else {
        enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'update', JSON.stringify(toRemotePayload(current)))
      }
    }
    notifyChanged()
  }
  return ok
}

function deletePurchase(id: string): boolean {
  const ok = repo.softDelete(id)
  if (ok) {
    _state.items = _state.items.filter((r) => r.id !== id)
    if (getCachedAccessToken() != '') {
      deleteAssetRemote('purchases', id).catch(() => {
        enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'delete', '')
      })
    } else {
      enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'delete', '')
    }
    notifyChanged()
  }
  return ok
}

function setFilterStatus(status: string) {
  _state.filterStatus = status
  notifyChanged()
}

function getPurchaseById(id: string): PurchaseRecord | null { return _state.items.find((r) => r.id == id) }

function linkWardrobe(id: string, wardrobeId: string): boolean {
  const ok = repo.linkWardrobe(id, wardrobeId)
  if (!ok) return false
  const record = _state.items.find((item) => item.id == id)
  if (record != null) {
    record.wardrobeId = wardrobeId
    record.updatedAt = new Date().toISOString()
    useReminderStore().syncPurchaseReminders(record)
    if (getCachedAccessToken() != '') patchAssetRemote('purchases', id, toRemotePayload(record)).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'update', JSON.stringify(toRemotePayload(record)))
    })
  }
  notifyChanged()
  return true
}

function recordsForMonth(monthCode: string): PurchaseRecord[] {
  return activeItems().filter((item) => item.paymentStatus != 'CANCELLED' && item.purchaseDate.indexOf(monthCode) == 0)
}
function monthlyCommitted(monthCode: string): number { return recordsForMonth(monthCode).reduce((sum, item) => sum + item.totalAmount, 0) }
function monthlyPaid(monthCode: string): number { return recordsForMonth(monthCode).reduce((sum, item) => sum + item.paidAmount, 0) }
function monthlyOutstanding(monthCode: string): number { return recordsForMonth(monthCode).reduce((sum, item) => sum + item.remainingAmount, 0) }

// 品牌联想（购买记录编辑页用）：去重排序的品牌清单
function brands(): string[] {
  const set = new Set<string>()
  for (let i = 0; i < _state.items.length; i++) {
    if (_state.items[i].brand.trim() !== '') set.add(_state.items[i].brand.trim())
  }
  const arr = Array.from(set) as string[]
  arr.sort()
  return arr
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class PurchaseStoreHandle {
  get loading(): boolean { return _state.loading }
  get error(): string { return _state.error }
  get filterStatus(): string { return _state.filterStatus }
  get filteredItems(): PurchaseRecord[] { return filteredItems() }
  get displayItems(): PurchaseDisplayModel[] { return displayItems() }
  get pendingPayments(): PurchaseRecord[] { return pendingPayments() }
  get totalSpent(): number { return totalSpent() }
  get remainingTotal(): number { return remainingTotal() }
  get itemCount(): number { return itemCount() }
  get brands(): string[] { return brands() }
  monthlyCommitted(monthCode: string): number { return monthlyCommitted(monthCode) }
  monthlyPaid(monthCode: string): number { return monthlyPaid(monthCode) }
  monthlyOutstanding(monthCode: string): number { return monthlyOutstanding(monthCode) }
  fetchPurchases(): Promise<void> { return fetchPurchases() }
  addPurchase(record: PurchaseRecord): PurchaseRecord | null { return addPurchase(record) }
  updatePurchase(id: string, data: PurchaseUpdateData): boolean { return updatePurchase(id, data) }
  deletePurchase(id: string): boolean { return deletePurchase(id) }
  setFilterStatus(status: string): void { setFilterStatus(status) }
  getPurchaseById(id: string): PurchaseRecord | null { return getPurchaseById(id) }
  linkWardrobe(id: string, wardrobeId: string): boolean { return linkWardrobe(id, wardrobeId) }
}

let _handle: PurchaseStoreHandle | null = null
export function usePurchaseStore(): PurchaseStoreHandle {
  if (_handle == null) _handle = new PurchaseStoreHandle()
  return _handle!
}
