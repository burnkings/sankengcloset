/** PurchaseStore — 页面与购买仓库之间的状态层。 */

import { PurchaseRecord, PurchaseUpdateData } from '@/domain/purchase-record'
import { toDisplayModels, PurchaseDisplayModel } from '@/domain/purchase-presenter'
import * as repo from '@/domain/repositories/purchase-repo'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'

export const usePurchaseStore = defineStore('purchase', () => {
  const items = ref([]) as Ref<PurchaseRecord[]>
  const loading = ref(false)
  const error = ref('')
  const filterStatus = ref('')

  const activeItems = computed((): PurchaseRecord[] => items.value.filter((r) => !r.isDeleted))
  const filteredItems = computed((): PurchaseRecord[] => {
    let result = activeItems.value
    if (filterStatus.value != '') result = result.filter((r) => r.paymentStatus == filterStatus.value)
    return [...result].sort((a, b) => {
      const da = a.purchaseDate != '' ? new Date(a.purchaseDate).getTime() : 0
      const db = b.purchaseDate != '' ? new Date(b.purchaseDate).getTime() : 0
      return db - da
    })
  })
  const displayItems = computed((): PurchaseDisplayModel[] => toDisplayModels(filteredItems.value))
  const pendingPayments = computed((): PurchaseRecord[] => activeItems.value.filter((r) => r.remainingAmount > 0))
  const totalSpent = computed((): number => activeItems.value.reduce((sum, r) => sum + r.totalAmount, 0))
  const remainingTotal = computed((): number => activeItems.value.reduce((sum, r) => sum + r.remainingAmount, 0))
  const itemCount = computed((): number => activeItems.value.length)

  function fetchPurchases() {
    loading.value = true
    error.value = ''
    try {
      repo.initMockData()
      items.value = repo.getAll()
    } catch (err) {
      error.value = String(err)
    } finally {
      loading.value = false
    }
  }

  function addPurchase(record: PurchaseRecord): PurchaseRecord | null {
    try {
      const added = repo.add(record)
      items.value = [...items.value, added]
      enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', added.id, 'create', JSON.stringify(added))
      return added
    } catch (err) {
      error.value = String(err)
      return null
    }
  }

  function updatePurchase(id: string, data: PurchaseUpdateData): boolean {
    const ok = repo.update(id, data)
    if (ok) {
      items.value = repo.getAll()
      enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'update', JSON.stringify(data))
    }
    return ok
  }

  function deletePurchase(id: string): boolean {
    const ok = repo.softDelete(id)
    if (ok) {
      items.value = items.value.filter((r) => r.id !== id)
      enqueueLocalOperation(getCurrentSyncUserId(), 'purchase', id, 'delete', '')
    }
    return ok
  }

  function setFilterStatus(status: string) { filterStatus.value = status }
  function getPurchaseById(id: string): PurchaseRecord | undefined { return items.value.find((r) => r.id == id) }

  return { loading, error, filterStatus, filteredItems, displayItems, pendingPayments, totalSpent, remainingTotal, itemCount, fetchPurchases, addPurchase, updatePurchase, deletePurchase, setFilterStatus, getPurchaseById }
})
