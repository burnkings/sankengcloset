/**
 * ReminderStore — 提醒状态管理
 */
import { reactive } from 'vue'

import { Reminder, ReminderUpdateData, STATUS_PENDING } from '@/domain/reminder'
import { PurchaseRecord } from '@/domain/purchase-record'
import { toDisplayModels, ReminderDisplayModel, groupByDate, ReminderGroupViewModel } from '@/domain/reminder-presenter'
import * as repo from '@/domain/repositories/reminder-repo'
import { syncWriteBack } from '@/services/sync/write-back'
import { readPendingOperations } from '@/services/sync/local-sync-queue'
import { getCachedAccessToken } from '@/config/runtime'
import { createAssetRemote, deleteAssetRemote, listRemindersRemote, patchAssetRemote } from '@/services/user-data/user-data-service'
import { scheduleReminderNotification } from '@/utils/notify'
import { localToday, localDateShifted } from '@/utils/date'

// ====== 模块级 reactive 状态（单例）======

type ReminderState = {
  items: Reminder[]
  loading: boolean
  error: string
  filterStatus: string
  searchKeyword: string
  currentSort: string
}

const _state = reactive<ReminderState>({
  items: [] as Reminder[],
  loading: false,
  error: '',
  filterStatus: '',
  searchKeyword: '',
  currentSort: 'date-asc',
})

function activeItems(): Reminder[] { return _state.items.filter((r) => !r.isDeleted) }

function todayItems(): Reminder[] {
  const today = localToday()
  return activeItems().filter((r) => r.remindDate === today && r.status === STATUS_PENDING)
}

function upcomingItems(): Reminder[] {
  const now = new Date()
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
  const weekLater = today + 7 * 86400000
  return activeItems().filter((r) => {
    if (r.status !== STATUS_PENDING) return false
    try {
      const t = new Date(r.remindDate).getTime()
      return t > today && t <= weekLater
    } catch {
      return false
    }
  })
}

function overdueItems(): Reminder[] {
  const today = localToday()
  return activeItems().filter((r) => r.remindDate < today || r.status === 'MISSED')
}

function missedItems(): Reminder[] {
  const today = localToday()
  return activeItems().filter((r) => r.remindDate < today && r.status === 'PENDING')
}

function doneItems(): Reminder[] { return activeItems().filter((r) => r.status === 'DONE') }

function filteredItems(): Reminder[] {
  autoMarkOverdue()
  let result = activeItems()
  if (_state.filterStatus) {
    if (_state.filterStatus === 'MISSED') {
      const today = localToday()
      result = result.filter((r) => r.status === 'MISSED' || r.remindDate < today)
    } else {
      result = result.filter((r) => r.status == _state.filterStatus)
    }
  }
  if (_state.searchKeyword) {
    const kw = _state.searchKeyword.toLowerCase()
    result = result.filter((r) => r.title.toLowerCase().includes(kw) || r.note.toLowerCase().includes(kw))
  }
  result = [...result].sort((a, b) => {
    if (_state.currentSort == 'date-asc') {
      const da = a.remindDate ? new Date(a.remindDate).getTime() : 0
      const db = b.remindDate ? new Date(b.remindDate).getTime() : 0
      return da - db
    }
    if (_state.currentSort == 'date-desc') {
      const da = a.remindDate ? new Date(a.remindDate).getTime() : 0
      const db = b.remindDate ? new Date(b.remindDate).getTime() : 0
      return db - da
    }
    if (_state.currentSort == 'type') {
      if (a.type != b.type) return a.type < b.type ? -1 : 1
      const da = a.remindDate ? new Date(a.remindDate).getTime() : 0
      const db = b.remindDate ? new Date(b.remindDate).getTime() : 0
      return da - db
    }
    return 0
  })
  return result
}

function displayItems(): ReminderDisplayModel[] { return toDisplayModels(filteredItems()) }
function groupedItems(): ReminderGroupViewModel[] { return groupByDate(displayItems()) }
function itemCount(): number { return activeItems().length }
function pendingCount(): number { return activeItems().filter((r) => r.status == 'PENDING').length }
function todayCount(): number { return todayItems().length }
function upcomingCount(): number { return upcomingItems().length }
function overdueCount(): number { return overdueItems().length }
function missedCount(): number { return missedItems().length }
function balancePendingCount(): number { return activeItems().filter((r) => r.type === 'BALANCE' && r.status === 'PENDING').length }

function notifyChanged() {}

function reminderContent(item: Reminder): string {
  if (item.type === 'BALANCE') return `尾款提醒：${item.title}`
  if (item.type === 'ARRIVAL') return `到货提醒：${item.title}`
  if (item.type === 'RELEASE') return `发售提醒：${item.title}`
  return item.note !== '' ? item.note : `提醒：${item.title}`
}

function scheduleFor(item: Reminder) {
  if (item.status === STATUS_PENDING && item.remindDate !== '') {
    scheduleReminderNotification(item.title, reminderContent(item), item.remindDate, item.remindTime, `reminder-${item.id}`)
  }
}

// ====== 模块级 action ======

// 请求序号：切账号/登出时 bump，丢弃过期请求，防旧账号数据覆盖新状态
let _fetchSeq = 0
export function bumpFetchSeq() { _fetchSeq += 1 }

function mapRemoteReminder(raw: UTSJSONObject): Reminder {
  const item = new Reminder()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.title = raw['title'] != null ? raw['title'] as string : ''
  item.type = raw['type'] != null ? raw['type'] as string : 'CUSTOM'
  item.remindDate = raw['remindDate'] != null ? raw['remindDate'] as string : ''
  item.remindTime = raw['remindTime'] != null ? raw['remindTime'] as string : ''
  item.isAllDay = raw['isAllDay'] != null ? (raw['isAllDay'] as boolean) : false
  item.relatedPurchaseId = raw['relatedPurchaseId'] != null ? raw['relatedPurchaseId'] as string : ''
  item.relatedWishId = raw['relatedWishId'] != null ? raw['relatedWishId'] as string : ''
  item.productId = raw['productId'] != null ? raw['productId'] as string : ''
  item.relatedReleaseId = raw['relatedReleaseId'] != null ? raw['relatedReleaseId'] as string : ''
  item.note = raw['note'] != null ? raw['note'] as string : ''
  item.status = raw['status'] != null ? raw['status'] as string : 'PENDING'
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  item.updatedAt = raw['updatedAt'] != null ? raw['updatedAt'] as string : ''
  return item
}

async function fetchItems() {
  const seq = ++_fetchSeq
  _state.loading = true
  _state.error = ''
  try {
    if (getCachedAccessToken() != '') {
      const remote = await listRemindersRemote()
      if (seq !== _fetchSeq) return
      const restored = [] as Reminder[]
      for (let i = 0; i < remote.length; i++) restored.push(mapRemoteReminder(remote[i]))
      // 合并本地队列中「待重放 create/upsert」的实体（远端还没有）：防远端拉取覆盖后丢 UI/丢数据；
      // 排除「待重放 delete」的远端实体（本地已软删）：防已删条目被快照复活。
      // 离线创建/删除在 flush 重放前必须保留在本地快照里。
      const cached = repo.getAll()
      const pending = readPendingOperations()
      for (let i = 0; i < pending.length; i++) {
        const op = pending[i]
        if (op.entityType != 'reminder') continue
        if (op.action == 'delete') {
          for (let j = 0; j < restored.length; j++) {
            if (restored[j].id == op.entityId) { restored.splice(j, 1); break }
          }
          continue
        }
        if (op.action != 'create' && op.action != 'upsert' && op.action != 'import') continue
        let exists = false
        for (let j = 0; j < restored.length; j++) { if (restored[j].id == op.entityId) { exists = true; break } }
        if (exists) continue
        for (let j = 0; j < cached.length; j++) {
          if (cached[j].id == op.entityId) { restored.push(cached[j]); break }
        }
      }
      _state.items = restored
      // 远端快照(+本地待重放实体)写入本地 repo 缓存：离线期间可编辑/删除并正确入队（repo 是 update/delete 的合并源）
      repo.persist(restored)
    } else {
      if (seq !== _fetchSeq) return
      repo.initMockData()
      _state.items = repo.getAll()
    }
  } catch (err) {
    if (seq !== _fetchSeq) return
    _state.error = err instanceof Error ? err.message : '加载失败'
    _state.items = repo.getAll()
  } finally {
    if (seq === _fetchSeq) _state.loading = false
  }
  autoMarkOverdue()
  notifyChanged()
}

function addItem(item: Reminder): Reminder | null {
  try {
    const added = repo.add(item)
    _state.items = [..._state.items, added]
    // 统一写回（远端优先、失败入队）：payload 含 repo.add 生成的稳定 id，
    // 重放 POST 时后端以同 id 落库（409=已存在 → 幂等成功），绝不产生重复实体
    syncWriteBack('reminder', added.id, 'create', JSON.stringify(added), () => createAssetRemote('reminders', added as UTSJSONObject))
    scheduleFor(added)
    notifyChanged()
    return added
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '添加失败'
    return null
  }
}

function updateItem(id: string, data: ReminderUpdateData): boolean {
  const ok = repo.update(id, data)
  if (ok) {
    // repo 为唯一合并源（R0 清空语义在 repo.update 内实现：null=未提供、''=清空），store 直接重读
    _state.items = repo.getAll()
    const existing = _state.items.find((r) => r.id == id)
    if (existing != null) {
      // payload 一律用同步后的完整实体（含可清空字段的最终值），远端 PATCH 收敛
      syncWriteBack('reminder', id, 'update', JSON.stringify(existing), () => patchAssetRemote('reminders', id, existing as UTSJSONObject))
      scheduleFor(existing)
    }
    notifyChanged()
  }
  return ok
}

function deleteItem(id: string): boolean {
  const ok = repo.softDelete(id)
  if (ok) {
    _state.items = _state.items.filter((r) => r.id !== id)
    // 远端删除 404=已不存在 → 重放按幂等成功处理
    syncWriteBack('reminder', id, 'delete', '', () => deleteAssetRemote('reminders', id))
    notifyChanged()
  }
  return ok
}

function markDone(id: string): boolean {
  const ok = repo.markDone(id)
  if (ok) {
    _state.items = repo.getAll()
    const existing = _state.items.find((r) => r.id == id)
    if (existing != null) {
      syncWriteBack('reminder', id, 'update', JSON.stringify(existing), () => patchAssetRemote('reminders', id, existing as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function markUndone(id: string): boolean {
  const data = new ReminderUpdateData()
  data.status = 'PENDING'
  const ok = repo.update(id, data)
  if (ok) {
    _state.items = repo.getAll()
    const existing = _state.items.find((r) => r.id == id)
    if (existing != null) {
      syncWriteBack('reminder', id, 'update', JSON.stringify(existing), () => patchAssetRemote('reminders', id, existing as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function setFilterStatus(status: string) {
  _state.filterStatus = status
  notifyChanged()
}

function setSearch(keyword: string) {
  _state.searchKeyword = keyword
  notifyChanged()
}

function setSort(sort: string) {
  _state.currentSort = sort
  notifyChanged()
}

function getById(id: string): Reminder | null { return _state.items.find((r) => r.id == id) }

function updateLinkedReminder(existing: Reminder, title: string, date: string, type: string, note: string, purchase: PurchaseRecord) {
  const data = new ReminderUpdateData()
  data.title = title; data.type = type; data.remindDate = date; data.note = note; data.status = 'PENDING'
  data.relatedPurchaseId = purchase.id; data.relatedWishId = purchase.wishId
  updateItem(existing.id, data)
}

/**
 * 订单是履约单一事实来源：尾款与到货提醒只按关联订单各保留一条。
 * 改订单金额、日期、取消或入橱时，这些提醒会同步更新/结束，而不是留下孤儿提醒。
 */
function syncPurchaseReminders(purchase: PurchaseRecord): void {
  const balance = activeItems().find((item) => item.relatedPurchaseId == purchase.id && item.type == 'BALANCE')
  const arrival = activeItems().find((item) => item.relatedPurchaseId == purchase.id && item.type == 'ARRIVAL')
  const active = purchase.paymentStatus != 'CANCELLED'
  const needsBalance = active && purchase.remainingAmount > 0 && purchase.deadline != ''
  if (needsBalance) {
    // 金额一律分：展示时转元
    const note = `待付 ¥${(purchase.remainingAmount / 100).toFixed(2)}${purchase.brand != '' ? ' · ' + purchase.brand : ''}`
    if (balance != null) updateLinkedReminder(balance, `${purchase.name} 尾款截止`, purchase.deadline, 'BALANCE', note, purchase)
    else {
      const item = new Reminder(); item.title = `${purchase.name} 尾款截止`; item.type = 'BALANCE'; item.remindDate = purchase.deadline
      item.relatedPurchaseId = purchase.id; item.relatedWishId = purchase.wishId; item.note = note; addItem(item)
    }
  } else if (balance != null && balance.status == 'PENDING') {
    const data = new ReminderUpdateData(); data.status = 'DONE'; updateItem(balance.id, data)
  }
  const needsArrival = active && purchase.arrivalDate != '' && purchase.wardrobeId == ''
  if (needsArrival) {
    const note = `${purchase.brand != '' ? purchase.brand + ' · ' : ''}预计到货后可一键入橱`
    if (arrival != null) updateLinkedReminder(arrival, `${purchase.name} 到货提醒`, purchase.arrivalDate, 'ARRIVAL', note, purchase)
    else {
      const item = new Reminder(); item.title = `${purchase.name} 到货提醒`; item.type = 'ARRIVAL'; item.remindDate = purchase.arrivalDate
      item.relatedPurchaseId = purchase.id; item.relatedWishId = purchase.wishId; item.note = note; addItem(item)
    }
  } else if (arrival != null && arrival.status == 'PENDING') {
    const data = new ReminderUpdateData(); data.status = 'DONE'; updateItem(arrival.id, data)
  }
}

/**
 * 删除订单时的级联清理（R0，禁孤儿提醒）：订单删除后其自动提醒（BALANCE/ARRIVAL）
 * 已失去事实来源，整条软删并走统一写回入队（远端 DELETE 404=已不存在 → 幂等成功），
 * 避免 PENDING 孤儿提醒继续提醒一个不存在的订单。
 */
function removePurchaseLinkedReminders(purchaseId: string): void {
  if (purchaseId === '') return
  const linked = activeItems().filter((r) => r.relatedPurchaseId == purchaseId && (r.type == 'BALANCE' || r.type == 'ARRIVAL'))
  for (let i = 0; i < linked.length; i++) deleteItem(linked[i].id)
}

/**
 * 商品一键提醒（Phase 1.1-C Favorite → Release → Reminder 闭环）：
 * - 去重键 = productId + relatedReleaseId + type（未删除），已存在返回 null 不重复创建
 * - 统一走 addItem 链路：本地 repo + 离线入队 + 远程 /me/reminders + 本地通知调度
 * - remindDate 为空（无有效提醒时间）不创建，禁止伪造时间
 */
function createProductReminder(productId: string, relatedReleaseId: string, type: string, title: string, remindDate: string, note: string): Reminder | null {
  if (productId === '' || remindDate === '') return null
  const existing = activeItems().find((r) =>
    r.productId == productId && r.relatedReleaseId == relatedReleaseId && r.type == type && !r.isDeleted)
  if (existing != null) return null
  const item = new Reminder()
  item.title = title
  item.type = type
  item.remindDate = remindDate
  item.note = note
  item.productId = productId
  item.relatedReleaseId = relatedReleaseId
  item.status = STATUS_PENDING
  return addItem(item)
}

/** 某商品的所有未删除提醒（收藏页展示提醒状态；productId 为空返回空数组） */
function remindersForProduct(productId: string): Reminder[] {
  if (productId === '') return [] as Reminder[]
  return activeItems().filter((r) => r.productId == productId)
}

function swapItems(id1: string, id2: string) {
  const idx1 = _state.items.findIndex((r) => r.id == id1)
  const idx2 = _state.items.findIndex((r) => r.id == id2)
  if (idx1 >= 0 && idx2 >= 0) {
    const tmp = _state.items[idx1]
    _state.items.splice(idx1, 1, _state.items[idx2])
    _state.items.splice(idx2, 1, tmp)
    repo.persist(_state.items)
    notifyChanged()
  }
}

function autoMarkOverdue() {
  const now = new Date()
  const today = localToday()
  const nowMinutes = now.getHours() * 60 + now.getMinutes()
  let changed = false
  for (let i = 0; i < _state.items.length; i++) {
    const item = _state.items[i]
    if (!item.isDeleted && item.status === 'PENDING' && item.remindDate !== '') {
      let isOverdue = false
      if (item.remindDate < today) {
        isOverdue = true
      } else if (item.remindDate === today && !item.isAllDay && item.remindTime !== '') {
        const parts = item.remindTime.split(':')
        if (parts.length === 2) {
          const remindMinutes = parseInt(parts[0]) * 60 + parseInt(parts[1])
          if (remindMinutes < nowMinutes) isOverdue = true
        }
      }
      if (isOverdue) {
        item.status = 'MISSED'
        item.updatedAt = new Date().toISOString()
        changed = true
      }
    }
  }
  if (changed) { repo.persist(_state.items); notifyChanged() }
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class ReminderStoreHandle {
  get loading(): boolean { return _state.loading }
  get error(): string { return _state.error }
  get filterStatus(): string { return _state.filterStatus }
  get searchKeyword(): string { return _state.searchKeyword }
  get currentSort(): string { return _state.currentSort }
  get activeItems(): Reminder[] { return activeItems() }
  get todayItems(): Reminder[] { return todayItems() }
  get upcomingItems(): Reminder[] { return upcomingItems() }
  get overdueItems(): Reminder[] { return overdueItems() }
  get doneItems(): Reminder[] { return doneItems() }
  get filteredItems(): Reminder[] { return filteredItems() }
  get displayItems(): ReminderDisplayModel[] { return displayItems() }
  get groupedItems(): ReminderGroupViewModel[] { return groupedItems() }
  get itemCount(): number { return itemCount() }
  get pendingCount(): number { return pendingCount() }
  get todayCount(): number { return todayCount() }
  get upcomingCount(): number { return upcomingCount() }
  get overdueCount(): number { return overdueCount() }
  get missedCount(): number { return missedCount() }
  get balancePendingCount(): number { return balancePendingCount() }
  fetchItems(): Promise<void> { return fetchItems() }
  addItem(item: Reminder): Reminder | null { return addItem(item) }
  updateItem(id: string, data: ReminderUpdateData): boolean { return updateItem(id, data) }
  deleteItem(id: string): boolean { return deleteItem(id) }
  markDone(id: string): boolean { return markDone(id) }
  markUndone(id: string): boolean { return markUndone(id) }
  setFilterStatus(status: string): void { setFilterStatus(status) }
  setSearch(keyword: string): void { setSearch(keyword) }
  setSort(sort: string): void { setSort(sort) }
  getById(id: string): Reminder | null { return getById(id) }
  syncPurchaseReminders(purchase: PurchaseRecord): void { syncPurchaseReminders(purchase) }
  removePurchaseLinkedReminders(purchaseId: string): void { removePurchaseLinkedReminders(purchaseId) }
  createProductReminder(productId: string, relatedReleaseId: string, type: string, title: string, remindDate: string, note: string): Reminder | null { return createProductReminder(productId, relatedReleaseId, type, title, remindDate, note) }
  remindersForProduct(productId: string): Reminder[] { return remindersForProduct(productId) }
  swapItems(id1: string, id2: string): void { swapItems(id1, id2) }
  autoMarkOverdue(): void { autoMarkOverdue() }
}

let _handle: ReminderStoreHandle | null = null
export function useReminderStore(): ReminderStoreHandle {
  if (_handle == null) _handle = new ReminderStoreHandle()
  return _handle!
}
