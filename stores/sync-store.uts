import { reactive, computed } from 'vue'
import { SyncOperation } from '@/domain/sync/sync-operation'
import { readPendingOperations, flushLocalOperations, getLastSyncAt } from '@/services/sync/local-sync-queue'
import { getRuntimeConfig } from '@/config/runtime'

// ====== 模块级 reactive 状态（单例）======

type SyncState = {
  operations: SyncOperation[]
  syncing: boolean
  lastSyncAt: string
  online: boolean
  errorMessage: string
}

const _state = reactive<SyncState>({
  operations: [] as SyncOperation[],
  syncing: false,
  lastSyncAt: '',
  online: true,
  errorMessage: '',
})

const _pendingCount = computed((): number => _state.operations.length)
const _hasPending = computed((): boolean => _pendingCount.value > 0)

const CHANGE_EVENT = 'store:sync-changed'
function notifyChanged() { uni.$emit(CHANGE_EVENT) }

// ====== 模块级 action ======

function reload() {
  _state.operations = readPendingOperations()
  _state.lastSyncAt = getLastSyncAt()
  _state.online = true
  notifyChanged()
}

async function syncNow(): Promise<number> {
  if (_state.syncing) return 0
  _state.syncing = true
  _state.errorMessage = ''
  try {
    const count = await flushLocalOperations()
    reload()
    return count
  } catch (e) {
    _state.errorMessage = e instanceof Error ? e.message : '同步失败，操作已保留'
    reload()
    return 0
  } finally {
    _state.syncing = false
  }
}

reload()

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class SyncStoreHandle {
  get operations(): SyncOperation[] { return _state.operations }
  get syncing(): boolean { return _state.syncing }
  get lastSyncAt(): string { return _state.lastSyncAt }
  get online(): boolean { return _state.online }
  get errorMessage(): string { return _state.errorMessage }
  get pendingCount(): number { return _pendingCount.value }
  get hasPending(): boolean { return _hasPending.value }
  reload(): void { reload() }
  syncNow(): Promise<number> { return syncNow() }
}

let _handle: SyncStoreHandle | null = null
export function useSyncStore(): SyncStoreHandle {
  if (_handle == null) _handle = new SyncStoreHandle()
  return _handle!
}
