/** 本地月预算设置。服务端账号接入后可替换存储实现。 */
import { reactive } from 'vue'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'
import { getCachedAccessToken } from '@/config/runtime'
import { loadBudgetRemote, saveBudgetRemote } from '@/services/user-data/user-data-service'

const LIMIT_KEY = 'v2_budget_monthly_limit'
const ALERT_KEY = 'v2_budget_alert_percent'

function readNumber(key: string, fallback: number): number {
  try {
    const raw = uni.getStorageSync(key)
    if (raw == null || raw as string === '') return fallback
    const value = parseFloat(raw as string) ?? fallback
    return isNaN(value) ? fallback : value
  } catch (e) {
    return fallback
  }
}

// ====== 模块级 reactive 状态（单例）======

type BudgetState = {
  monthlyLimit: number
  alertPercent: number
}

const _state = reactive<BudgetState>({
  monthlyLimit: readNumber(LIMIT_KEY, 0),
  alertPercent: readNumber(ALERT_KEY, 80),
})

function isConfigured(): boolean { return _state.monthlyLimit > 0 }

function notifyChanged() {}

// ====== 模块级 action ======

function save(limit: number, percent: number) {
  _state.monthlyLimit = Math.max(0, limit)
  _state.alertPercent = Math.min(100, Math.max(1, percent))
  try {
    uni.setStorageSync(LIMIT_KEY, _state.monthlyLimit.toString())
    uni.setStorageSync(ALERT_KEY, _state.alertPercent.toString())
  } catch (e) {}
  // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
  if (getCachedAccessToken() != '') {
    saveBudgetRemote({ monthlyLimit: _state.monthlyLimit, alertPercent: _state.alertPercent })
      .catch(() => {
        enqueueLocalOperation(
          getCurrentSyncUserId(),
          'budget',
          'monthly',
          'upsert',
          `{"monthlyLimit":${_state.monthlyLimit},"alertPercent":${_state.alertPercent}}`,
        )
      })
  } else {
    enqueueLocalOperation(
      getCurrentSyncUserId(),
      'budget',
      'monthly',
      'upsert',
      `{"monthlyLimit":${_state.monthlyLimit},"alertPercent":${_state.alertPercent}}`,
    )
  }
  notifyChanged()
}

async function refreshRemoteBudget(): Promise<void> {
  if (getCachedAccessToken() == '') return
  try {
    const remote = await loadBudgetRemote()
    if (remote['monthlyLimit'] == null || remote['alertPercent'] == null) return
    _state.monthlyLimit = remote['monthlyLimit'] as number
    _state.alertPercent = remote['alertPercent'] as number
    try {
      uni.setStorageSync(LIMIT_KEY, _state.monthlyLimit.toString())
      uni.setStorageSync(ALERT_KEY, _state.alertPercent.toString())
    } catch (e) {}
    notifyChanged()
  } catch (e) {
    // Keep the last local budget when the device is offline.
  }
}

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class BudgetStoreHandle {
  get monthlyLimit(): number { return _state.monthlyLimit }
  get alertPercent(): number { return _state.alertPercent }
  get isConfigured(): boolean { return isConfigured() }
  save(limit: number, percent: number): void { save(limit, percent) }
  refreshRemoteBudget(): Promise<void> { return refreshRemoteBudget() }
}

let _handle: BudgetStoreHandle | null = null
export function useBudgetStore(): BudgetStoreHandle {
  if (_handle == null) _handle = new BudgetStoreHandle()
  return _handle!
}
