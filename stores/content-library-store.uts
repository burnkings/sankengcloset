/** Compatibility facade: independent favorites, brand follows and community stores. */
import { readEntries, writeEntries, favoriteCount, wishCount, syncFavoriteIds, isFavorite, queueFavorite, toggleFavorite, updateFavoriteStatus, favoriteStatusOf, favoriteEntryOf, refreshRemoteFavorites, hasPendingFavorite, refreshFavorites, removeInvalidFavorites, removeFavorites, favoriteReleaseOf, isWished, toggleWish, reloadFavorite, favoriteState } from '@/stores/favorite-store'
import { followedBrandCount, isFollowingBrand, toggleBrandFollow, refreshRemoteBrands, hasPendingBrandFollow, reloadBrand, brandState } from '@/stores/brand-follow-store'
import { readMockPosts, writeMockPosts, mockToPublicLook, remoteToPublicLook, outfitCount, likedPostCount, defaultPublicLooks, refreshPublicPosts, loadMorePublicPosts, refreshMyPosts, publishOutfitRemote, removeOutfit, isPostLiked, togglePostLike, reloadCommunity, communityState } from '@/stores/community-store'
import { FavoriteEntry } from '@/stores/favorite-store'
import { SavedOutfitPost, PublicLookPost } from '@/stores/community-store'
import { FeedItem } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
export { FavoriteEntry, FAVORITE_STATUS_LABELS } from '@/stores/favorite-store'
export { SavedOutfitPost, PublicLookPost, publishOutfitRemote } from '@/stores/community-store'
function reload() { reloadFavorite(); reloadBrand(); reloadCommunity() }
// 历史：此前在模块顶层直接调用 reload()，等于「只要有人 import 这个模块就读一次 storage」，
// 属启动期隐式 I/O 且无法控制时序。改为首次取 handle 时初始化（所有页面都通过 useContentLibraryStore()）。
let _loaded = false
function ensureLoaded() {
  if (_loaded) return
  _loaded = true
  reload()
}
class ContentLibraryStoreHandle {
  get favoriteIds(): string[] { return favoriteState.favoriteIds }
  get favoriteProducts(): FeedItem[] { return favoriteState.favoriteProducts }
  get favoriteReleases(): ReleaseEvent[] { return favoriteState.favoriteReleases }
  get favoritesLoading(): boolean { return favoriteState.favoritesLoading }
  get favoritesError(): string { return favoriteState.favoritesError }
  get favoritesLoadedOnce(): boolean { return favoriteState.favoritesLoadedOnce }
  get invalidFavoriteIds(): string[] { return favoriteState.invalidFavoriteIds }
  get followedBrands(): string[] { return brandState.followedBrands }
  get outfitPosts(): SavedOutfitPost[] { return communityState.outfitPosts }
  get likedPostIds(): string[] { return communityState.likedPostIds }
  get publicPosts(): PublicLookPost[] { return communityState.publicPosts }
  get publicLoading(): boolean { return communityState.publicLoading }
  get publicError(): string { return communityState.publicError }
  get publicLoadedOnce(): boolean { return communityState.publicLoadedOnce }
  get publicHasMore(): boolean { return communityState.publicHasMore }
  get publicLoadingMore(): boolean { return communityState.publicLoadingMore }
  get favoriteCount(): number { return favoriteCount() }
  get followedBrandCount(): number { return followedBrandCount() }
  get outfitCount(): number { return outfitCount() }
  get likedPostCount(): number { return likedPostCount() }
  get wishCount(): number { return wishCount() }
  reload(): void { reload() }
  refreshPublicPosts(): Promise<void> { return refreshPublicPosts() }
  loadMorePublicPosts(): Promise<void> { return loadMorePublicPosts() }
  refreshMyPosts(): Promise<void> { return refreshMyPosts() }
  refreshRemoteBrands(): Promise<void> { return refreshRemoteBrands() }
  refreshRemoteFavorites(): Promise<void> { return refreshRemoteFavorites() }
  refreshFavorites(): Promise<void> { return refreshFavorites() }
  removeInvalidFavorites(): void { removeInvalidFavorites() }
  removeFavorites(ids: string[]): number { return removeFavorites(ids) }
  isFavorite(entityId: string): boolean { return isFavorite(entityId) }
  toggleFavorite(entityId: string, title: string = '', releaseId: string = ''): boolean { return toggleFavorite(entityId, title, releaseId) }
  favoriteReleaseOf(entityId: string): ReleaseEvent | null { return favoriteReleaseOf(entityId) }
  favoriteStatusOf(entityId: string): string { return favoriteStatusOf(entityId) }
  favoriteEntryOf(entityId: string): FavoriteEntry | null { return favoriteEntryOf(entityId) }
  updateFavoriteStatus(entityId: string, status: string): boolean { return updateFavoriteStatus(entityId, status) }
  isWished(entityId: string): boolean { return isWished(entityId) }
  toggleWish(entityId: string): boolean { return toggleWish(entityId) }
  isFollowingBrand(brandName: string): boolean { return isFollowingBrand(brandName) }
  toggleBrandFollow(brandName: string): boolean { return toggleBrandFollow(brandName) }
  publishOutfitRemote(imagePath: string, caption: string, category: string, topic: string, wardrobeIds: string[] = [], productId: string = ''): Promise<boolean> { return publishOutfitRemote(imagePath, caption, category, topic, wardrobeIds, productId) }
  removeOutfit(id: string): void { removeOutfit(id) }
  isPostLiked(postId: string): boolean { return isPostLiked(postId) }
  togglePostLike(postId: string): boolean { return togglePostLike(postId) }
}

let _handle: ContentLibraryStoreHandle | null = null
export function useContentLibraryStore(): ContentLibraryStoreHandle {
  if (_handle == null) {
    ensureLoaded()
    _handle = new ContentLibraryStoreHandle()
  }
  return _handle!
}
