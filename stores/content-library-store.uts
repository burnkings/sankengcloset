import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'

/**
 * ContentLibraryStore — V2.0 用户内容资产
 *
 * 当前以本地持久化实现商品收藏、品牌关注与晒搭发布记录。
 * 页面只依赖本 Store，后续接入账号与服务端同步时无需重写页面交互。
 */

const FAVORITE_IDS_KEY = 'v2_library_favorite_ids'
const FOLLOWED_BRANDS_KEY = 'v2_library_followed_brands'
const OUTFIT_IDS_KEY = 'v2_library_outfit_ids'
const LIKED_POST_IDS_KEY = 'v2_library_liked_post_ids'
const OUTFIT_PREFIX = 'v2_library_outfit_'
const MAX_LOCAL_OUTFITS = 30

export class SavedOutfitPost {
  id: string = ''
  image: string = ''
  caption: string = ''
  category: string = ''
  topic: string = ''
  createdAt: string = ''
}

function readString(key: string): string {
  try {
    const value = uni.getStorageSync(key)
    return value == null ? '' : String(value)
  } catch (e) {
    return ''
  }
}

function readList(key: string): string[] {
  const raw = readString(key)
  if (raw === '') return []
  return raw.split(',').filter((item) => item !== '')
}

function writeList(key: string, values: string[]) {
  uni.setStorageSync(key, values.join(','))
}


function outfitKey(id: string, field: string): string {
  return `${OUTFIT_PREFIX}${id}_${field}`
}

function readOutfit(id: string): SavedOutfitPost {
  const post = new SavedOutfitPost()
  post.id = id
  post.image = readString(outfitKey(id, 'image'))
  post.caption = readString(outfitKey(id, 'caption'))
  post.category = readString(outfitKey(id, 'category'))
  post.topic = readString(outfitKey(id, 'topic'))
  post.createdAt = readString(outfitKey(id, 'created_at'))
  return post
}

function removeOutfitStorage(id: string) {
  uni.removeStorageSync(outfitKey(id, 'image'))
  uni.removeStorageSync(outfitKey(id, 'caption'))
  uni.removeStorageSync(outfitKey(id, 'category'))
  uni.removeStorageSync(outfitKey(id, 'topic'))
  uni.removeStorageSync(outfitKey(id, 'created_at'))
}

export const useContentLibraryStore = defineStore('contentLibrary', () => {
  const favoriteIds = ref([]) as Ref<string[]>
  const followedBrands = ref([]) as Ref<string[]>
  const outfitPosts = ref([]) as Ref<SavedOutfitPost[]>
  const likedPostIds = ref([]) as Ref<string[]>

  const favoriteCount = computed((): number => favoriteIds.value.length)
  const followedBrandCount = computed((): number => followedBrands.value.length)
  const outfitCount = computed((): number => outfitPosts.value.length)
  const likedPostCount = computed((): number => likedPostIds.value.length)

  function reload() {
    favoriteIds.value = readList(FAVORITE_IDS_KEY)
    followedBrands.value = readList(FOLLOWED_BRANDS_KEY)
    likedPostIds.value = readList(LIKED_POST_IDS_KEY)
    const ids = readList(OUTFIT_IDS_KEY)
    // Phase 1C 只保存一条晒搭；首次进入 V2.0 时无损迁移到多条内容库。
    if (ids.length === 0) {
      const legacyImage = readString('local_outfit_image')
      if (legacyImage !== '') {
        const legacyId = `outfit_legacy_${Date.now()}`
        ids.push(legacyId)
        uni.setStorageSync(outfitKey(legacyId, 'image'), legacyImage)
        uni.setStorageSync(outfitKey(legacyId, 'caption'), readString('local_outfit_caption'))
        uni.setStorageSync(outfitKey(legacyId, 'category'), readString('local_outfit_category'))
        const legacyTopic = readString('local_outfit_topic')
        uni.setStorageSync(outfitKey(legacyId, 'topic'), legacyTopic !== '' ? legacyTopic : '今日穿搭')
        uni.setStorageSync(outfitKey(legacyId, 'created_at'), String(Date.now()))
        writeList(OUTFIT_IDS_KEY, ids)
        uni.removeStorageSync('local_outfit_image')
        uni.removeStorageSync('local_outfit_caption')
        uni.removeStorageSync('local_outfit_category')
        uni.removeStorageSync('local_outfit_topic')
      }
    }
    const posts: SavedOutfitPost[] = []
    for (let i = 0; i < ids.length; i++) {
      const post = readOutfit(ids[i])
      if (post.image !== '') posts.push(post)
    }
    outfitPosts.value = posts
  }

  function isFavorite(entityId: string): boolean {
    return favoriteIds.value.indexOf(entityId) >= 0
  }

  function toggleFavorite(entityId: string): boolean {
    if (entityId === '') return false
    const values = [...favoriteIds.value]
    const idx = values.indexOf(entityId)
    if (idx >= 0) values.splice(idx, 1)
    else values.unshift(entityId)
    favoriteIds.value = values
    writeList(FAVORITE_IDS_KEY, values)
    enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entityId, idx < 0 ? 'upsert' : 'delete', '')
    return idx < 0
  }

  function isFollowingBrand(brandName: string): boolean {
    return followedBrands.value.indexOf(brandName) >= 0
  }

  function toggleBrandFollow(brandName: string): boolean {
    if (brandName === '') return false
    const values = [...followedBrands.value]
    const idx = values.indexOf(brandName)
    if (idx >= 0) values.splice(idx, 1)
    else values.unshift(brandName)
    followedBrands.value = values
    writeList(FOLLOWED_BRANDS_KEY, values)
    enqueueLocalOperation(getCurrentSyncUserId(), 'brand_follow', brandName, idx < 0 ? 'upsert' : 'delete', '')
    return idx < 0
  }

  function saveOutfit(image: string, caption: string, category: string, topic: string): string {
    const id = `outfit_${Date.now()}`
    uni.setStorageSync(outfitKey(id, 'image'), image)
    uni.setStorageSync(outfitKey(id, 'caption'), caption)
    uni.setStorageSync(outfitKey(id, 'category'), category)
    uni.setStorageSync(outfitKey(id, 'topic'), topic)
    uni.setStorageSync(outfitKey(id, 'created_at'), String(Date.now()))

    const ids = readList(OUTFIT_IDS_KEY)
    ids.unshift(id)
    while (ids.length > MAX_LOCAL_OUTFITS) {
      const removedId = ids.pop()
      if (removedId != null) removeOutfitStorage(removedId)
    }
    writeList(OUTFIT_IDS_KEY, ids)
    enqueueLocalOperation(getCurrentSyncUserId(), 'outfit', id, 'create', `${category}|${topic}|${caption}`)
    reload()
    return id
  }

  function removeOutfit(id: string) {
    const ids = readList(OUTFIT_IDS_KEY)
    const idx = ids.indexOf(id)
    if (idx >= 0) ids.splice(idx, 1)
    writeList(OUTFIT_IDS_KEY, ids)
    removeOutfitStorage(id)
    enqueueLocalOperation(getCurrentSyncUserId(), 'outfit', id, 'delete', '')
    reload()
  }

  function isPostLiked(postId: string): boolean {
    return likedPostIds.value.indexOf(postId) >= 0
  }

  function togglePostLike(postId: string): boolean {
    if (postId === '') return false
    const values = [...likedPostIds.value]
    const idx = values.indexOf(postId)
    if (idx >= 0) values.splice(idx, 1)
    else values.unshift(postId)
    likedPostIds.value = values
    writeList(LIKED_POST_IDS_KEY, values)
    enqueueLocalOperation(getCurrentSyncUserId(), 'post_like', postId, idx < 0 ? 'upsert' : 'delete', '')
    return idx < 0
  }

  reload()

  return {
    favoriteIds,
    followedBrands,
    outfitPosts,
    likedPostIds,
    favoriteCount,
    followedBrandCount,
    outfitCount,
    likedPostCount,
    reload,
    isFavorite,
    toggleFavorite,
    isFollowingBrand,
    toggleBrandFollow,
    saveOutfit,
    removeOutfit,
    isPostLiked,
    togglePostLike,
  }
})
