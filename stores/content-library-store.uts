import { reactive } from 'vue'
import { enqueueLocalOperation, getCurrentSyncUserId, readPendingOperations } from '@/services/sync/local-sync-queue'
import { SyncOperation } from '@/domain/sync/sync-operation'
import { getCachedAccessToken } from '@/config/runtime'
import { FeedItem } from '@/domain/content/feed-item'
import { ReleaseEvent } from '@/domain/content/release-event'
import { fetchProductDetail } from '@/services/content/product-service'
import { deleteCommunityPostRemote, listCommunityPostsRemote, setCommunityPostLikeRemote, followBrandRemote, unfollowBrandRemote, listFollowedBrandsRemote, listWishlistRemote, addWishlistRemote, deleteWishlistRemote, updateWishlistStatusRemote, uploadOutfitImageRemote, createCommunityPostRemote } from '@/services/user-data/user-data-service'
import { useSessionStore } from '@/stores/session-store'

/**
 * ContentLibraryStore — V2.6 用户内容资产 + 圈子穿搭灵感 Gallery
 *
 * 圈子定位：轻量「穿搭灵感 Gallery」—— 公开穿搭帖子（灵感流）+ 我的发布。
 * 不做评论、私信、关注流等完整社交 Timeline。
 * 公开 Feed 调 listCommunityPostsRemote(..., false)；我的发布调用 mine=true。
 */

export class PublicLookPost {
  id: string = ''
  imageUrl: string = ''
  caption: string = ''
  category: string = ''
  topic: string = ''
  authorUserId: string = ''
  authorNickname: string = ''
  likeCount: number = 0
  liked: boolean = false
  /** Phase 2.3-A：关联商品 id（空 = 普通内容，卡片不显示商品入口） */
  productId: string = ''
  createdAt: string = ''
  initial: string = ''
}

const FAVORITE_IDS_KEY = 'v2_library_favorite_ids'
const FAVORITE_ENTRIES_KEY = 'v2_library_favorite_entries'
const WISH_IDS_KEY = 'v2_library_wish_ids'
const FOLLOWED_BRANDS_KEY = 'v2_library_followed_brands'
const LIKED_POST_IDS_KEY = 'v2_library_liked_post_ids'
/** 模拟登录（无真实 token）本地发布的圈子动态：混入公开 Gallery 与我的发布 */
const MOCK_POSTS_KEY = 'v26_mock_published_posts'

/**
 * 收藏条目：商品/实体 ID（详情页 entityId）↔ 后端 wishlist_items.id 映射。
 * itemId 为空表示尚未同步到服务端（离线/未登录收藏），登录或网络恢复后回填。
 * status 为待购决策状态：WISH(收藏)/WANT(想买)/WAIT_RELEASE(等待开售)/WAIT_PRICE(等待尾款)/PURCHASED(已购买)
 */
export class FavoriteEntry {
  productId: string = ''
  itemId: string = ''
  title: string = ''
  status: string = 'WISH'
  /** 用户关注的发售批次（wishlist_items.release_id；历史数据为空时收藏页 fallback product.currentRelease） */
  releaseId: string = ''
}

/** 收藏决策状态机（与后端 WishlistStatus 一致；展示标签） */
export const FAVORITE_STATUS_LABELS = {
  WISH: '收藏',
  WANT: '想买',
  WATCHING: '观望',
  WAIT_RELEASE: '等待开售',
  WAIT_PRICE: '等待尾款',
  PURCHASED: '已购买',
}

export class SavedOutfitPost {
  id: string = ''
  image: string = ''
  caption: string = ''
  category: string = ''
  topic: string = ''
  createdAt: string = ''
  // true = 远程已发布（listCommunityPostsRemote mine）
  isRemote: boolean = false
}

function readString(key: string): string {
  try {
    const value = uni.getStorageSync(key)
    return value == null ? '' : value as string
  } catch (e) {
    return ''
  }
}

function readList(key: string): string[] {
  const raw = readString(key)
  if (raw === '') return []
  return raw.split(',').filter((item) => item !== '')
}

function writeList(key: string, values: string[]) {
  uni.setStorageSync(key, values.join(','))
}

function readEntries(): FavoriteEntry[] {
  const raw = readString(FAVORITE_ENTRIES_KEY)
  if (raw === '') {
    // 迁移旧存量：v2_library_favorite_ids（逗号分隔 ID）→ entries（无 itemId，登录后由远程刷新回填）
    const legacy = readList(FAVORITE_IDS_KEY)
    const migrated: FavoriteEntry[] = []
    for (let i = 0; i < legacy.length; i++) {
      const entry = new FavoriteEntry()
      entry.productId = legacy[i]
      migrated.push(entry)
    }
    if (migrated.length > 0) writeEntries(migrated)
    return migrated
  }
  try {
    const parsed = JSON.parse(raw) as UTSJSONObject[]
    const entries: FavoriteEntry[] = []
    for (let i = 0; i < parsed.length; i++) {
      const item = parsed[i]
      if (item == null) continue
      const entry = new FavoriteEntry()
      entry.productId = item['productId'] != null ? item['productId'] as string : ''
      entry.itemId = item['itemId'] != null ? item['itemId'] as string : ''
      entry.title = item['title'] != null ? item['title'] as string : ''
      entry.status = item['status'] != null ? item['status'] as string : 'WISH'
      entry.releaseId = item['releaseId'] != null ? item['releaseId'] as string : ''
      if (entry.productId != '') entries.push(entry)
    }
    return entries
  } catch (e) {
    return []
  }
}

function writeEntries(entries: FavoriteEntry[]) {
  try {
    const serializable: UTSJSONObject[] = []
    for (let i = 0; i < entries.length; i++) {
      serializable.push({
        productId: entries[i].productId,
        itemId: entries[i].itemId,
        title: entries[i].title,
        status: entries[i].status,
        releaseId: entries[i].releaseId,
      } as UTSJSONObject)
    }
    uni.setStorageSync(FAVORITE_ENTRIES_KEY, JSON.stringify(serializable))
    const ids: string[] = []
    for (let i = 0; i < entries.length; i++) ids.push(entries[i].productId)
    writeList(FAVORITE_IDS_KEY, ids)
  } catch (e) {
    // write failure is non-fatal
  }
}

// ====== 模拟登录本地发布（Mock 已发布动态，混入公开 Gallery）======

function readMockPosts(): SavedOutfitPost[] {
  try {
    const raw = readString(MOCK_POSTS_KEY)
    if (raw === '') return []
    const parsed = JSON.parse(raw) as UTSJSONObject[]
    const posts: SavedOutfitPost[] = []
    for (let i = 0; i < parsed.length; i++) {
      const item = parsed[i]
      if (item == null) continue
      const p = new SavedOutfitPost()
      p.id = item['id'] != null ? item['id'] as string : ''
      p.image = item['image'] != null ? item['image'] as string : ''
      p.caption = item['caption'] != null ? item['caption'] as string : ''
      p.category = item['category'] != null ? item['category'] as string : ''
      p.topic = item['topic'] != null ? item['topic'] as string : ''
      p.createdAt = item['createdAt'] != null ? item['createdAt'] as string : ''
      p.isRemote = true
      if (p.id != '') posts.push(p)
    }
    return posts
  } catch (e) {
    return []
  }
}

function writeMockPosts(posts: SavedOutfitPost[]) {
  try {
    const serializable: UTSJSONObject[] = []
    for (let i = 0; i < posts.length; i++) {
      serializable.push({
        id: posts[i].id,
        image: posts[i].image,
        caption: posts[i].caption,
        category: posts[i].category,
        topic: posts[i].topic,
        createdAt: posts[i].createdAt,
      } as UTSJSONObject)
    }
    uni.setStorageSync(MOCK_POSTS_KEY, JSON.stringify(serializable))
  } catch (e) {
    // write failure is non-fatal
  }
}

/** 本地 Mock 已发布动态 → 公开 Gallery 展示形态 */
function mockToPublicLook(post: SavedOutfitPost): PublicLookPost {
  const p = new PublicLookPost()
  p.id = post.id
  p.imageUrl = post.image
  p.caption = post.caption
  p.category = post.category
  p.topic = post.topic
  const session = useSessionStore()
  const nickname = session.profile.nickname !== '' ? session.profile.nickname : '我'
  p.authorNickname = nickname
  p.initial = nickname.length > 0 ? nickname.substring(0, 1) : '我'
  p.likeCount = 0
  p.liked = false
  p.productId = ''
  p.createdAt = post.createdAt
  return p
}

// ====== 模块级 reactive 状态（单例）======

type ContentLibraryState = {
  favoriteEntries: FavoriteEntry[]
  favoriteIds: string[]
  favoriteProducts: FeedItem[]
  /** 收藏商品的当前关注 Release（fetchProductDetail 按条目 releaseId 定位，无则 fallback 最新批次） */
  favoriteReleases: ReleaseEvent[]
  favoritesLoading: boolean
  favoritesError: string
  favoritesLoadedOnce: boolean
  invalidFavoriteIds: string[]
  wishIds: string[]
  followedBrands: string[]
  outfitPosts: SavedOutfitPost[]
  likedPostIds: string[]
  publicPosts: PublicLookPost[]
  publicLoading: boolean
  publicError: string
  publicLoadedOnce: boolean
}

const _state = reactive<ContentLibraryState>({
  favoriteEntries: [] as FavoriteEntry[],
  favoriteIds: [] as string[],
  favoriteProducts: [] as FeedItem[],
  favoriteReleases: [] as ReleaseEvent[],
  favoritesLoading: false,
  favoritesError: '',
  favoritesLoadedOnce: false,
  invalidFavoriteIds: [] as string[],
  wishIds: [] as string[],
  followedBrands: [] as string[],
  outfitPosts: [] as SavedOutfitPost[],
  likedPostIds: [] as string[],
  publicPosts: [] as PublicLookPost[],
  publicLoading: false,
  publicError: '',
  publicLoadedOnce: false,
})

function favoriteCount(): number { return _state.favoriteIds.length }
function wishCount(): number { return _state.wishIds.length }
function followedBrandCount(): number { return _state.followedBrands.length }
function outfitCount(): number { return _state.outfitPosts.length }
function likedPostCount(): number { return _state.likedPostIds.length }

function notifyChanged() {}

// ====== 模块级 action ======

function reload() {
  const entries = readEntries()
  _state.favoriteEntries = entries
  syncFavoriteIds()
  _state.wishIds = readList(WISH_IDS_KEY)
  _state.followedBrands = readList(FOLLOWED_BRANDS_KEY)
  _state.likedPostIds = readList(LIKED_POST_IDS_KEY)
  // 我的发布：远程帖子由 refreshMyPosts 拉取；本地 Mock 已发布动态从存储恢复
  _state.outfitPosts = readMockPosts()
  notifyChanged()
}

/** 公开穿搭灵感 Gallery：listCommunityPostsRemote(..., false) */
async function refreshPublicPosts(): Promise<void> {
  // 首次加载才显示骨架屏；之后进入静默刷新，避免空数据/重复进入闪 0.5s 骨架屏。
  if (!_state.publicLoadedOnce) _state.publicLoading = true
  _state.publicError = ''
  try {
    const remote = await listCommunityPostsRemote('', '', '', false)
    const posts: PublicLookPost[] = []
    for (let i = 0; i < remote.length; i++) {
      const item = remote[i]
      const post = new PublicLookPost()
      post.id = item.id
      post.imageUrl = item.imageUrl
      post.caption = item.caption
      post.category = item.category == 'LOLITA' ? 'Lolita' : item.category == 'HANFU' ? '汉服' : item.category == 'MIXED' ? '混搭' : 'JK'
      post.topic = item.topic
      post.authorUserId = item.authorUserId
      post.authorNickname = item.authorNickname !== '' ? item.authorNickname : '同好'
      post.likeCount = item.likeCount
      post.liked = item.liked
      post.productId = item.productId
      post.createdAt = item.createdAt
      const nick = post.authorNickname
      post.initial = nick.length > 0 ? nick.substring(0, 1) : '同'
      posts.push(post)
      if (item.liked && _state.likedPostIds.indexOf(item.id) < 0) _state.likedPostIds.push(item.id)
    }
    _state.publicPosts = posts
  } catch (e) {
    _state.publicError = e instanceof Error ? e.message : '加载失败'
  } finally {
    // 本地 Mock 已发布动态混入公开 Gallery 顶部（先剔除旧的 Mock 帖，避免重复累积）
    const mock = readMockPosts()
    const mockPublic: PublicLookPost[] = []
    for (let i = 0; i < mock.length; i++) mockPublic.push(mockToPublicLook(mock[i]))
    const remoteOnly = _state.publicPosts.filter((post) => !post.id.startsWith('mock_'))
    _state.publicPosts = [...mockPublic, ...remoteOnly]
    _state.publicLoading = false
    _state.publicLoadedOnce = true
  }
  notifyChanged()
}

/** 我的发布：listCommunityPostsRemote(..., true) —— 服务端帖子 + 本地 Mock 已发布动态合并 */
async function refreshMyPosts(): Promise<void> {
  const mock = readMockPosts()
  if (getCachedAccessToken() == '') {
    // 模拟登录：仅展示本地 Mock 已发布动态
    _state.outfitPosts = mock
    notifyChanged()
    return
  }
  try {
    const remote = await listCommunityPostsRemote('', '', '', true)
    const saved = [] as SavedOutfitPost[]
    for (let i = 0; i < remote.length; i++) {
      const item = remote[i]
      const post = new SavedOutfitPost()
      post.id = item.id
      post.image = item.imageUrl
      post.caption = item.caption
      post.category = item.category == 'LOLITA' ? 'Lolita' : item.category == 'HANFU' ? '汉服' : item.category == 'MIXED' ? '混搭' : item.category
      post.topic = item.topic
      post.createdAt = item.createdAt
      post.isRemote = true
      saved.push(post)
      if (item.liked && _state.likedPostIds.indexOf(item.id) < 0) _state.likedPostIds.push(item.id)
    }
    _state.outfitPosts = [...saved, ...mock]
    notifyChanged()
  } catch (e) {
    // 网络失败保留上次列表，不阻塞社区页
  }
}

function syncFavoriteIds() {
  const ids: string[] = []
  const entries = _state.favoriteEntries
  for (let i = 0; i < entries.length; i++) ids.push(entries[i].productId)
  _state.favoriteIds = ids
}

function isFavorite(entityId: string): boolean {
  return _state.favoriteIds.indexOf(entityId) >= 0
}

/**
 * 统一收藏（心动收藏）：
 * - 数据源 = 后端 /api/v1/wishlist（wishlist_items 表），商品详情页与收藏页共用本 Store。
 * - 已登录：直接远程写（Authorized CRUD），仅失败时入队由 syncNow 重放。
 * - 未登录：本地乐观更新 + 入队，登录后 flush 重放真实 CRUD。
 */
// 收藏操作序号：取消→重收时丢弃旧回调，防止 itemId 回填到已移除的旧条目
let _favoriteOpSeq = 0
function toggleFavorite(entityId: string, title: string = '', releaseId: string = ''): boolean {
  if (entityId === '') return false
  const entries = [..._state.favoriteEntries]
  let found = -1
  for (let i = 0; i < entries.length; i++) {
    if (entries[i].productId == entityId) { found = i; break }
  }
  if (found >= 0) {
    // 取消收藏：使 in-flight 回填回调失效，避免旧 itemId 写回
    _favoriteOpSeq += 1
    // 取消收藏：删除 wishlist_items 条目
    const removed = entries[found]
    entries.splice(found, 1)
    _state.favoriteEntries = entries
    writeEntries(entries)
    syncFavoriteIds()
    const remoteItemId = removed.itemId
    if (getCachedAccessToken() != '') {
      if (remoteItemId != '') {
        deleteWishlistRemote(remoteItemId).catch(() => {
          enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', remoteItemId, 'delete', JSON.stringify({ productId: entityId }))
        })
      } else {
        enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entityId, 'delete', JSON.stringify({ productId: entityId }))
      }
    } else {
      enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entityId, 'delete', JSON.stringify({ productId: entityId }))
    }
    notifyChanged()
    return false
  }
  // 添加收藏：创建 wishlist_items 条目
  _favoriteOpSeq += 1
  const opSeq = _favoriteOpSeq
  const entry = new FavoriteEntry()
  entry.productId = entityId
  entry.title = title
  entry.itemId = ''
  entry.releaseId = releaseId
  entries.unshift(entry)
  _state.favoriteEntries = entries
  writeEntries(entries)
  syncFavoriteIds()
  if (getCachedAccessToken() != '') {
    addWishlistRemote(entityId, title, 'WISH', releaseId).then((itemId: string) => {
      if (itemId == '') return
      // 序号失效（期间已取消/重新收藏）或条目已同步，跳过回填
      if (opSeq !== _favoriteOpSeq) return
      // 回填服务端条目 ID，保证后续取消收藏可精确删除（只回填尚未同步的条目，防写错）
      const current = [..._state.favoriteEntries]
      for (let i = 0; i < current.length; i++) {
        if (current[i].productId == entityId && current[i].itemId == '') {
          current[i].itemId = itemId
          break
        }
      }
      _state.favoriteEntries = current
      writeEntries(current)
      notifyChanged()
    }).catch(() => {
      if (opSeq !== _favoriteOpSeq) return
      enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entityId, 'upsert', JSON.stringify({ productId: entityId, title, releaseId }))
    })
  } else {
    enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entityId, 'upsert', JSON.stringify({ productId: entityId, title, releaseId }))
  }
  notifyChanged()
  return true
}

/**
 * 更新收藏决策状态（收藏→想买→等待开售→已购买）。
 * 本地立即生效；已登录走 PATCH /api/v1/wishlist/:id，失败入队重放；未登录直接入队。
 */
function updateFavoriteStatus(entityId: string, status: string): boolean {
  if (entityId === '') return false
  const entries = [..._state.favoriteEntries]
  let found = -1
  for (let i = 0; i < entries.length; i++) {
    if (entries[i].productId == entityId) { found = i; break }
  }
  if (found < 0) return false
  const entry = entries[found]
  if (entry.status == status) return true
  entry.status = status
  _state.favoriteEntries = entries
  writeEntries(entries)
  if (getCachedAccessToken() != '' && entry.itemId != '') {
    updateWishlistStatusRemote(entry.itemId, status).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entry.itemId, 'update', JSON.stringify({ productId: entityId, status }))
    })
  } else {
    enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', entityId, 'update', JSON.stringify({ productId: entityId, status }))
  }
  notifyChanged()
  return true
}

/** 读取某商品收藏条目的当前决策状态（未收藏返回空串） */
function favoriteStatusOf(entityId: string): string {
  const entries = _state.favoriteEntries
  for (let i = 0; i < entries.length; i++) {
    if (entries[i].productId == entityId) return entries[i].status
  }
  return ''
}

/** 登录态拉取服务端收藏：服务端快照 ∪ 本地未同步条目合并（多端冲突保护），未登录保留本地缓存 */
async function refreshRemoteFavorites(): Promise<void> {
  if (getCachedAccessToken() == '') return
  try {
    const items = await listWishlistRemote()
    const serverByProduct = new Map<string, FavoriteEntry>()
    for (let i = 0; i < items.length; i++) {
      const raw = items[i]
      const productId = raw['productId'] != null ? raw['productId'] as string : ''
      if (productId == '') continue
      const entry = new FavoriteEntry()
      entry.productId = productId
      entry.itemId = raw['id'] != null ? raw['id'] as string : ''
      entry.title = raw['title'] != null ? raw['title'] as string : ''
      entry.status = raw['status'] != null ? raw['status'] as string : 'WISH'
      entry.releaseId = raw['releaseId'] != null ? raw['releaseId'] as string : ''
      serverByProduct.set(productId, entry)
    }
    // 本地尚未同步（itemId 为空）或本地队列仍有 pending favorite 的条目：本地优先保留
    const pendingOps = readPendingOperations()
    const localMerged = [] as FavoriteEntry[]
    const local = _state.favoriteEntries
    for (let i = 0; i < local.length; i++) {
      const l = local[i]
      const serverEntry = serverByProduct.get(l.productId)
      if (serverEntry != null) {
        // 服务端已有：采用服务端权威（itemId 精确）
        localMerged.push(serverEntry!)
      } else if (l.itemId == '' || hasPendingFavorite(pendingOps, l.productId)) {
        // 服务端无且本地未同步：保留本地（多端冲突保护，防 B 端旧快照覆盖 A 端新收藏）
        localMerged.push(l)
      }
      // 服务端无且本地已标记删除的项不并入
    }
    // 服务端独有的条目（本端从未见过）追加
    for (let i = 0; i < items.length; i++) {
      const raw = items[i]
      const productId = raw['productId'] != null ? raw['productId'] as string : ''
      if (productId == '') continue
      if (localMerged.some((e) => e.productId == productId)) continue
      const entry = new FavoriteEntry()
      entry.productId = productId
      entry.itemId = raw['id'] != null ? raw['id'] as string : ''
      entry.title = raw['title'] != null ? raw['title'] as string : ''
      entry.status = raw['status'] != null ? raw['status'] as string : 'WISH'
      entry.releaseId = raw['releaseId'] != null ? raw['releaseId'] as string : ''
      localMerged.push(entry)
    }
    _state.favoriteEntries = localMerged
    writeEntries(localMerged)
    syncFavoriteIds()
    notifyChanged()
  } catch (e) {
    // 离线时保留本地收藏缓存
  }
}

/** 本地同步队列中是否存在该商品待同步的 favorite 操作（添加/删除） */
function hasPendingFavorite(ops: SyncOperation[], productId: string): boolean {
  for (let i = 0; i < ops.length; i++) {
    if (ops[i].entityType != 'favorite') continue
    if (ops[i].entityId == productId) return true
    try {
      const body = JSON.parse(ops[i].payload) as UTSJSONObject
      if (body != null && body['productId'] != null && body['productId'] as string == productId) return true
    } catch (e) {}
  }
  return false
}

/** 收藏页：刷新收藏列表并拉取商品详情（公开 /api/v1/products/:id，未登录也可展示本地收藏）
 * 详情加载失败只影响单条：本地收藏条目始终保留，已加载商品继续展示，失败条数转为可恢复错误提示。
 * Release 定位规则：条目 releaseId 非空 → fetchProductDetail 按该批次定位 currentRelease（后端优先匹配，
 * 批次不存在则回退最新一条）；releaseId 为空（历史数据）→ 后端直接返回最新 currentRelease。
 * 回退不写回本地 releaseId（不覆盖用户原始批次锚）。 */
async function refreshFavorites(): Promise<void> {
  await refreshRemoteFavorites()
  // 首次加载才显示骨架屏；之后进入静默刷新。
  if (!_state.favoritesLoadedOnce) _state.favoritesLoading = true
  _state.favoritesError = ''
  const products: FeedItem[] = []
  const releases: ReleaseEvent[] = []
  const entries = _state.favoriteEntries
  const invalid: string[] = []
  for (let i = 0; i < entries.length; i++) {
    try {
      const detail = await fetchProductDetail(entries[i].productId, entries[i].releaseId)
      if (detail != null) {
        products.push(detail.item)
        if (detail.currentRelease != null) releases.push(detail.currentRelease)
      } else invalid.push(entries[i].productId)
    } catch (e) {
      // 单条失败不中断整列表：保留本地收藏条目，稍后可整体重试
      invalid.push(entries[i].productId)
    }
  }
  _state.favoriteProducts = products
  _state.favoriteReleases = releases
  _state.invalidFavoriteIds = invalid
  if (invalid.length > 0) {
    _state.favoritesError = `有 ${invalid.length} 个收藏的商品详情加载失败，可清除失效收藏`
  } else {
    _state.favoritesError = ''
  }
  _state.favoritesLoading = false
  _state.favoritesLoadedOnce = true
  notifyChanged()
}

/** 清除失效收藏：本地移除 + 入队幂等删除（后端无该商品则视为已删除，避免 404） */
function removeInvalidFavorites(): void {
  const invalid = _state.invalidFavoriteIds
  if (invalid.length === 0) return
  const validEntries = _state.favoriteEntries.filter((entry) => invalid.indexOf(entry.productId) < 0)
  _state.favoriteEntries = validEntries
  writeEntries(validEntries)
  syncFavoriteIds()
  for (let i = 0; i < invalid.length; i++) {
    enqueueLocalOperation(getCurrentSyncUserId(), 'favorite', invalid[i], 'delete', JSON.stringify({ productId: invalid[i] }))
  }
  _state.invalidFavoriteIds = []
  _state.favoritesError = ''
  notifyChanged()
}

/** 收藏商品当前关注 Release（fetchProductDetail 已按条目 releaseId 定位，无则 fallback 最新批次） */
function favoriteReleaseOf(entityId: string): ReleaseEvent | null {
  if (entityId === '') return null
  for (let i = 0; i < _state.favoriteReleases.length; i++) {
    if (_state.favoriteReleases[i].productId == entityId) return _state.favoriteReleases[i]
  }
  return null
}

function isWished(entityId: string): boolean {
  return _state.wishIds.indexOf(entityId) >= 0
}

function toggleWish(entityId: string): boolean {
  if (entityId === '') return false
  const values = [..._state.wishIds]
  const idx = values.indexOf(entityId)
  if (idx >= 0) values.splice(idx, 1)
  else values.unshift(entityId)
  _state.wishIds = values
  writeList(WISH_IDS_KEY, values)
  enqueueLocalOperation(getCurrentSyncUserId(), 'wish', entityId, idx < 0 ? 'upsert' : 'delete', '')
  notifyChanged()
  return idx < 0
}

function isFollowingBrand(brandName: string): boolean {
  return _state.followedBrands.indexOf(brandName) >= 0
}

function toggleBrandFollow(brandName: string): boolean {
  if (brandName === '') return false
  const values = [..._state.followedBrands]
  const idx = values.indexOf(brandName)
  if (idx >= 0) values.splice(idx, 1)
  else values.unshift(brandName)
  _state.followedBrands = values
  writeList(FOLLOWED_BRANDS_KEY, values)
  // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
  if (getCachedAccessToken() != '') {
    const following = idx < 0
    const remote = following ? followBrandRemote(brandName) : unfollowBrandRemote(brandName)
    remote.catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'brand_follow', brandName, idx < 0 ? 'upsert' : 'delete', '')
    })
  } else {
    enqueueLocalOperation(getCurrentSyncUserId(), 'brand_follow', brandName, idx < 0 ? 'upsert' : 'delete', '')
  }
  notifyChanged()
  return idx < 0
}

/** 登录态下拉取服务端已关注品牌并合并：服务端快照 ∪ 本地待同步关注（多端冲突保护） */
async function refreshRemoteBrands(): Promise<void> {
  if (getCachedAccessToken() == '') return
  try {
    const remote = await listFollowedBrandsRemote()
    const merged = [...remote]
    // 本地队列有 pending brand_follow 的品牌：本地优先保留
    const pendingOps = readPendingOperations()
    const local = readList(FOLLOWED_BRANDS_KEY)
    for (let i = 0; i < local.length; i++) {
      const brand = local[i]
      if (merged.indexOf(brand) >= 0) continue
      if (hasPendingBrandFollow(pendingOps, brand)) merged.push(brand)
    }
    _state.followedBrands = merged
    writeList(FOLLOWED_BRANDS_KEY, merged)
    notifyChanged()
  } catch (e) {
    // 离线时保留本地关注列表
  }
}

/** 本地同步队列中是否存在该品牌的待同步 brand_follow 操作 */
function hasPendingBrandFollow(ops: SyncOperation[], brandName: string): boolean {
  for (let i = 0; i < ops.length; i++) {
    if (ops[i].entityType == 'brand_follow' && ops[i].entityId == brandName) return true
  }
  return false
}

/**
 * 发布穿搭帖子到圈子：上传图片 → 创建远程帖子（需登录）。
 * 无真实 token（模拟登录）：本地 Mock 发布，动态混入公开 Gallery 与我的发布。
 * 收敛 share/create 页面的 uploadOutfitImageRemote + createCommunityPostRemote 直连。
 * 注：远程新帖由社区页 onShow → refreshMyPosts 拉取。
 */
export async function publishOutfitRemote(imagePath: string, caption: string, category: string, topic: string, wardrobeIds: string[] = [], productId: string = ''): Promise<boolean> {
  if (getCachedAccessToken() == '') {
    // 模拟登录（无真实 token）：本地 Mock 发布，写入本地并立即展示
    const post = new SavedOutfitPost()
    post.id = `mock_${Date.now()}`
    post.image = imagePath
    post.caption = caption
    post.category = category
    post.topic = topic
    post.createdAt = Date.now().toString()
    post.isRemote = true
    const posts = readMockPosts()
    posts.unshift(post)
    writeMockPosts(posts)
    _state.outfitPosts = posts
    // 混入公开 Gallery 顶部
    _state.publicPosts = [mockToPublicLook(post), ..._state.publicPosts.filter((item) => !item.id.startsWith('mock_'))]
    notifyChanged()
    return true
  }
  const mediaId = await uploadOutfitImageRemote(imagePath)
  const backendCategory = category === '混搭' ? 'MIXED' : (category === 'Lolita' ? 'LOLITA' : (category === '汉服' ? 'HANFU' : 'JK'))
  const payload = {
    mediaId,
    caption,
    category: backendCategory,
    topic,
    wardrobeIds,
    // Phase 2.3-A：可选商品关联（空串不传 → 后端 productId=null 普通内容）
    ...(productId !== '' ? { productId } : {}),
  } as UTSJSONObject
  await createCommunityPostRemote(payload)
  reload()
  return true
}

function removeOutfit(id: string) {
  const liked = [..._state.likedPostIds]
  const likedIdx = liked.indexOf(id)
  if (likedIdx >= 0) {
    liked.splice(likedIdx, 1)
    _state.likedPostIds = liked
    writeList(LIKED_POST_IDS_KEY, liked)
  }
  const mockPosts = readMockPosts()
  const isMock = mockPosts.some((post) => post.id == id)
  if (isMock) {
    // 本地 Mock 帖：直接从本地存储移除
    writeMockPosts(mockPosts.filter((post) => post.id != id))
  } else if (getCachedAccessToken() != '') {
    // 远程帖子直接 DELETE（Authorized），失败才入队由同步队列重放
    deleteCommunityPostRemote(id).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'outfit', id, 'delete', '')
    })
  }
  // 直接过滤内存列表（不再全量 reload，避免删除后其余帖子从视图消失）
  _state.outfitPosts = _state.outfitPosts.filter((post) => post.id != id)
  _state.publicPosts = _state.publicPosts.filter((post) => post.id != id)
  notifyChanged()
}
function isPostLiked(postId: string): boolean {
  return _state.likedPostIds.indexOf(postId) >= 0
}

function togglePostLike(postId: string): boolean {
  if (postId === '') return false
  const values = [..._state.likedPostIds]
  const idx = values.indexOf(postId)
  if (idx >= 0) values.splice(idx, 1)
  else values.unshift(postId)
  _state.likedPostIds = values
  writeList(LIKED_POST_IDS_KEY, values)
  // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
  if (getCachedAccessToken() != '') {
    const wanted = idx < 0
    setCommunityPostLikeRemote(postId, wanted).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'post_like', postId, idx < 0 ? 'upsert' : 'delete', '')
    })
  } else {
    enqueueLocalOperation(getCurrentSyncUserId(), 'post_like', postId, idx < 0 ? 'upsert' : 'delete', '')
  }
  notifyChanged()
  return idx < 0
}

reload()

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class ContentLibraryStoreHandle {
  get favoriteIds(): string[] { return _state.favoriteIds }
  get favoriteProducts(): FeedItem[] { return _state.favoriteProducts }
  get favoriteReleases(): ReleaseEvent[] { return _state.favoriteReleases }
  get favoritesLoading(): boolean { return _state.favoritesLoading }
  get favoritesError(): string { return _state.favoritesError }
  get favoritesLoadedOnce(): boolean { return _state.favoritesLoadedOnce }
  get invalidFavoriteIds(): string[] { return _state.invalidFavoriteIds }
  get followedBrands(): string[] { return _state.followedBrands }
  get outfitPosts(): SavedOutfitPost[] { return _state.outfitPosts }
  get likedPostIds(): string[] { return _state.likedPostIds }
  get publicPosts(): PublicLookPost[] { return _state.publicPosts }
  get publicLoading(): boolean { return _state.publicLoading }
  get publicError(): string { return _state.publicError }
  get publicLoadedOnce(): boolean { return _state.publicLoadedOnce }
  get favoriteCount(): number { return favoriteCount() }
  get followedBrandCount(): number { return followedBrandCount() }
  get outfitCount(): number { return outfitCount() }
  get likedPostCount(): number { return likedPostCount() }
  get wishCount(): number { return wishCount() }
  reload(): void { reload() }
  refreshPublicPosts(): Promise<void> { return refreshPublicPosts() }
  refreshMyPosts(): Promise<void> { return refreshMyPosts() }
  refreshRemoteBrands(): Promise<void> { return refreshRemoteBrands() }
  refreshRemoteFavorites(): Promise<void> { return refreshRemoteFavorites() }
  refreshFavorites(): Promise<void> { return refreshFavorites() }
  removeInvalidFavorites(): void { removeInvalidFavorites() }
  isFavorite(entityId: string): boolean { return isFavorite(entityId) }
  toggleFavorite(entityId: string, title: string = '', releaseId: string = ''): boolean { return toggleFavorite(entityId, title, releaseId) }
  favoriteReleaseOf(entityId: string): ReleaseEvent | null { return favoriteReleaseOf(entityId) }
  favoriteStatusOf(entityId: string): string { return favoriteStatusOf(entityId) }
  updateFavoriteStatus(entityId: string, status: string): boolean { return updateFavoriteStatus(entityId, status) }
  isWished(entityId: string): boolean { return isWished(entityId) }
  toggleWish(entityId: string): boolean { return toggleWish(entityId) }
  isFollowingBrand(brandName: string): boolean { return isFollowingBrand(brandName) }
  toggleBrandFollow(brandName: string): boolean { return toggleBrandFollow(brandName) }
  publishOutfitRemote(imagePath: string, caption: string, category: string, topic: string, wardrobeIds: string[] = [], productId: string = ''): Promise<boolean> { return publishOutfitRemote(imagePath, caption, category, topic, wardrobeIds, productId) }
  removeOutfit(id: string): void { removeOutfit(id) }
  isPostLiked(postId: string): boolean { return isPostLiked(postId) }
  togglePostLike(postId: string): boolean { return togglePostLike(postId) }
}

let _handle: ContentLibraryStoreHandle | null = null
export function useContentLibraryStore(): ContentLibraryStoreHandle {
  if (_handle == null) _handle = new ContentLibraryStoreHandle()
  return _handle!
}
