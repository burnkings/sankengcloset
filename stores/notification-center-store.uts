import { reactive } from 'vue'
import { AppNotification, NOTICE_RELEASE, NOTICE_SOCIAL, NOTICE_SYSTEM } from '@/domain/notification/app-notification'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'
import { getCachedAccessToken } from '@/config/runtime'
import { generateNotificationsRemote, listNotificationsRemote, markNotificationReadRemote } from '@/services/user-data/user-data-service'

const READ_IDS_KEY = 'v21_notification_read_ids'

function readIds(): string[] {
  try {
    const stored = uni.getStorageSync(READ_IDS_KEY)
    const raw = stored != null ? stored as string : ''
    return raw === '' ? [] : raw.split(',').filter((id) => id !== '')
  } catch (e) {
    return []
  }
}

function mockNotifications(): AppNotification[] {
  const now = Date.now()
  const items: AppNotification[] = []

  const release = new AppNotification()
  release.id = 'notice_release_01'
  release.type = NOTICE_RELEASE
  release.title = '月光曲 JSK 定金即将开始'
  release.body = '明天 20:00 开定，建议提前确认尺码与预算。'
  release.createdAt = (now - 20 * 60000).toString()
  release.actionTarget = '/pages/reminder/index'
  items.push(release)

  const social = new AppNotification()
  social.id = 'notice_social_01'
  social.type = NOTICE_SOCIAL
  social.title = '你的晒搭收到了新的喜欢'
  social.body = '茶会风格晒搭新增 3 个喜欢。'
  social.createdAt = (now - 5 * 3600000).toString()
  social.actionTarget = '/pages/community/index'
  items.push(social)

  const system = new AppNotification()
  system.id = 'notice_system_01'
  system.type = NOTICE_SYSTEM
  system.title = '通知服务已开启'
  system.body = '当前展示本机通知；登录真实账号后会优先读取云端通知。'
  system.createdAt = (now - 24 * 3600000).toString()
  system.actionTarget = '/pages/preferences/index'
  items.push(system)
  return items
}

// ====== 模块级 reactive 状态（单例）======

type NotificationCenterState = {
  items: AppNotification[]
  activeType: string
  loading: boolean
  error: string
}

const _state = reactive<NotificationCenterState>({
  items: [] as AppNotification[],
  activeType: 'all',
  loading: false,
  error: '',
})

function unreadCount(): number { return _state.items.filter((item) => !item.read).length }
function visibleItems(): AppNotification[] { return _state.activeType === 'all' ? _state.items : _state.items.filter((item) => item.type === _state.activeType) }

function notifyChanged() {}

// ====== 模块级 action ======

function reload() {
  // ⚠️ 已登录用户**不得**注入本机假通知。
  // 本机那三条（月光曲定金/晒搭被喜欢/通知服务已开启）是给游客看的占位内容；
  // 如果登录用户也拿到它们，就会出现「不属于这个账号的消息」和「假红点」。
  // 已登录时本函数是 no-op，列表等 refreshRemote 的云端结果。
  if (getCachedAccessToken() != '') return
  const savedReadIds = readIds()
  const next = mockNotifications()
  for (let i = 0; i < next.length; i++) next[i].read = savedReadIds.indexOf(next[i].id) >= 0
  _state.items = next
  notifyChanged()
}

function mapRemote(raw: UTSJSONObject): AppNotification {
  const item = new AppNotification()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.type = raw['type'] != null ? raw['type'] as string : NOTICE_SYSTEM
  item.title = raw['title'] != null ? raw['title'] as string : ''
  item.body = raw['body'] != null ? raw['body'] as string : ''
  item.actionTarget = raw['actionTarget'] != null ? raw['actionTarget'] as string : ''
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  item.read = raw['read'] == true
  return item
}

async function refreshRemote(): Promise<void> {
  if (getCachedAccessToken() == '') { reload(); return }
  _state.loading = true
  _state.error = ''
  try {
    await generateNotificationsRemote()
    const raw = await listNotificationsRemote()
    const result: AppNotification[] = []
    for (let i = 0; i < raw.length; i++) result.push(mapRemote(raw[i]))
    // ⚠️ 已登录时**云端说什么就是什么**：真实账号一条通知都没有，就该显示空列表。
    // 原来这里 `result.length > 0 ? result : reload()` —— 空列表会退回本机假通知，
    // 用户会收到并不属于自己账号的「月光曲 JSK 定金即将开始」这类内容。
    // 本机假通知只服务「游客/未登录」这一种情况（见上面 accessToken 为空的早退分支）。
    _state.items = result
  } catch (e) {
    _state.error = e instanceof Error ? e.message : '通知加载失败'
    // 拉取失败同样不回退假通知：宁可在页面上说「加载失败 + 重新加载」，也不要展示假消息。
  } finally {
    _state.loading = false
    notifyChanged()
  }
}

function persistReadState() {
  try {
    uni.setStorageSync(READ_IDS_KEY, _state.items.filter((item) => item.read).map((item) => item.id).join(','))
  } catch (e) {}
}

function markRead(id: string) {
  let changed = false
  for (let i = 0; i < _state.items.length; i++) {
    if (_state.items[i].id === id && !_state.items[i].read) {
      _state.items[i].read = true
      changed = true
    }
  }
  persistReadState()
  if (changed) {
    if (getCachedAccessToken() != '') {
      markNotificationReadRemote(id).catch(() => enqueueLocalOperation(getCurrentSyncUserId(), 'notification_read', id, 'upsert', '{"read":true}'))
    } else enqueueLocalOperation(getCurrentSyncUserId(), 'notification_read', id, 'upsert', '{"read":true}')
  }
  if (changed) notifyChanged()
}

function markAllRead() {
  const hadUnread = unreadCount() > 0
  for (let i = 0; i < _state.items.length; i++) _state.items[i].read = true
  persistReadState()
  if (hadUnread) {
    for (let i = 0; i < _state.items.length; i++) {
      const id = _state.items[i].id
      if (getCachedAccessToken() != '') {
        markNotificationReadRemote(id).catch(() => enqueueLocalOperation(getCurrentSyncUserId(), 'notification_read', id, 'upsert', '{"read":true}'))
      } else enqueueLocalOperation(getCurrentSyncUserId(), 'notification_read', id, 'upsert', '{"read":true}')
    }
  }
  if (hadUnread) notifyChanged()
}

function setType(type: string) {
  _state.activeType = type
  notifyChanged()
}

reload()

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class NotificationCenterStoreHandle {
  get items(): AppNotification[] { return _state.items }
  get activeType(): string { return _state.activeType }
  get visibleItems(): AppNotification[] { return visibleItems() }
  get unreadCount(): number { return unreadCount() }
  get loading(): boolean { return _state.loading }
  get error(): string { return _state.error }
  reload(): void { reload() }
  refreshRemote(): Promise<void> { return refreshRemote() }
  markRead(id: string): void { markRead(id) }
  markAllRead(): void { markAllRead() }
  setType(type: string): void { setType(type) }
}

let _handle: NotificationCenterStoreHandle | null = null
export function useNotificationCenterStore(): NotificationCenterStoreHandle {
  if (_handle == null) _handle = new NotificationCenterStoreHandle()
  return _handle!
}
