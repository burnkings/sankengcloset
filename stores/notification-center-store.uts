import { defineStore } from 'pinia'
import { AppNotification, NOTICE_RELEASE, NOTICE_PRICE, NOTICE_SOCIAL, NOTICE_SYSTEM, NOTICE_REMINDER } from '@/domain/notification/app-notification'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'
import { useReminderStore } from '@/stores/reminder-store'

const READ_IDS_KEY = 'v21_notification_read_ids'

function readIds(): string[] {
  try {
    const raw = String(uni.getStorageSync(READ_IDS_KEY) || '')
    return raw === '' ? [] : raw.split(',').filter((id) => id !== '')
  } catch (e) {
    return []
  }
}

function readEnabled(key: string): boolean {
  try {
    const raw: any = uni.getStorageSync('v25_notification_preferences')
    return raw == null || typeof raw !== 'object' || raw[key] !== false
  } catch (e) { return true }
}

function buildLocalNotifications(): AppNotification[] {
  const items: AppNotification[] = []
  // 通知中心只展示应用当前已有数据能真实支持的内容；不再生成虚构商品、降价或互动通知。
  const reminders = useReminderStore()
  reminders.fetchItems()
  const active = reminders.activeItems.value
  for (let i = 0; i < active.length && i < 5; i++) {
    const source = active[i]
    const notice = new AppNotification()
    notice.id = 'notice_reminder_' + source.id
    notice.type = NOTICE_REMINDER
    notice.title = '提醒：' + source.title
    notice.body = source.remindDate !== '' ? '计划日期：' + source.remindDate : '请查看这条提醒的详情。'
    notice.createdAt = source.updatedAt !== '' ? source.updatedAt : String(Date.now())
    notice.actionTarget = '/pages/reminder/index'
    items.push(notice)
  }
  const system = new AppNotification()
  system.id = 'notice_system_notification_preferences'
  system.type = NOTICE_SYSTEM
  system.title = '通知设置已生效'
  system.body = '你可以随时在通知设置中管理商品、提醒、互动和系统消息。'
  system.createdAt = String(Date.now())
  system.actionTarget = '/pages/notification-settings/index'
  items.push(system)
  return items
}

export const useNotificationCenterStore = defineStore('notificationCenter', () => {
  const items = ref([]) as Ref<AppNotification[]>
  const activeType = ref('all')
  const unreadCount = computed((): number => items.value.filter((item) => !item.read).length)
  function isEnabled(item: AppNotification): boolean {
    if (item.type === NOTICE_PRICE) return readEnabled('priceDrop')
    if (item.type === NOTICE_RELEASE) return readEnabled('release')
    if (item.type === NOTICE_REMINDER) return readEnabled('reminder')
    if (item.type === NOTICE_SOCIAL) return readEnabled('interaction')
    return readEnabled('system')
  }
  const visibleItems = computed((): AppNotification[] => {
    const enabled = items.value.filter((item) => isEnabled(item))
    return activeType.value === 'all' ? enabled : enabled.filter((item) => item.type === activeType.value)
  })

  function reload() {
    const savedReadIds = readIds()
    const next = buildLocalNotifications()
    for (let i = 0; i < next.length; i++) next[i].read = savedReadIds.indexOf(next[i].id) >= 0
    items.value = next
  }

  function persistReadState() {
    uni.setStorageSync(READ_IDS_KEY, items.value.filter((item) => item.read).map((item) => item.id).join(','))
  }

  function markRead(id: string) {
    let changed = false
    for (let i = 0; i < items.value.length; i++) {
      if (items.value[i].id === id && !items.value[i].read) {
        items.value[i].read = true
        changed = true
      }
    }
    persistReadState()
    if (changed) enqueueLocalOperation(getCurrentSyncUserId(), 'notification_read', id, 'upsert', '{"read":true}')
  }

  function markAllRead() {
    const hadUnread = unreadCount.value > 0
    for (let i = 0; i < items.value.length; i++) items.value[i].read = true
    persistReadState()
    if (hadUnread) enqueueLocalOperation(getCurrentSyncUserId(), 'notification_read', 'all', 'upsert', '{"readAll":true}')
  }

  function setType(type: string) { activeType.value = type }

  reload()
  return { items, activeType, visibleItems, unreadCount, reload, markRead, markAllRead, setType }
})
