import { reactive } from 'vue'
import { enqueueLocalOperation, getCurrentSyncUserId, readPendingOperations } from '@/services/sync/local-sync-queue'
import { SyncOperation } from '@/domain/sync/sync-operation'
import { getCachedAccessToken } from '@/config/runtime'
import { invalidateCatalog } from '@/services/platform/catalog-cache'

import { followBrandRemote, unfollowBrandRemote, listFollowedBrandsRemote } from '@/services/user-data/user-data-service'

import { readList, writeList } from '@/stores/content-storage'

const FOLLOWED_BRANDS_KEY = 'v2_library_followed_brands'
/**
 * Brand follows are now stored as BRAND_FOLLOW interactions in user_interactions table.
 * The local storage key is kept for offline/cache purposes.
 */
type State = {
  followedBrands: string[]
}
export const brandState = reactive<State>({
  followedBrands: [] as string[],
})

export function followedBrandCount(): number { return brandState.followedBrands.length }

export function isFollowingBrand(brandName: string): boolean {
  return brandState.followedBrands.indexOf(brandName) >= 0
}

export function toggleBrandFollow(brandName: string): boolean {
  if (brandName === '') return false
  const values = [...brandState.followedBrands]
  const idx = values.indexOf(brandName)
  if (idx >= 0) values.splice(idx, 1)
  else values.unshift(brandName)
  brandState.followedBrands = values
  writeList(FOLLOWED_BRANDS_KEY, values)
  // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
  if (getCachedAccessToken() != '') {
    const following = idx < 0
    const remote = following ? followBrandRemote(brandName) : unfollowBrandRemote(brandName)
    // 品牌目录走 24h 长缓存（catalog-cache），关注数 / isFollowed 这类聚合字段会因此变旧。
    // 写入成功就作废品牌前缀下的快照，下次读回来的是新的。
    remote.then(() => { invalidateCatalog('/api/v1/brands') }).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'brand_follow', brandName, idx < 0 ? 'upsert' : 'delete', '')
    })
  } else {
    enqueueLocalOperation(getCurrentSyncUserId(), 'brand_follow', brandName, idx < 0 ? 'upsert' : 'delete', '')
  }
  return idx < 0
}

export async function refreshRemoteBrands(): Promise<void> {
  if (getCachedAccessToken() == '') return
  try {
    const remote = await listFollowedBrandsRemote()
    const pending = readPendingOperations()
    const localValues = readList(FOLLOWED_BRANDS_KEY)
    const merged = remote.filter((brand) => !hasPendingBrandFollow(pending, brand) || localValues.indexOf(brand) >= 0)
    // 本地队列有 pending brand_follow 的品牌：本地优先保留
    const pendingOps = readPendingOperations()
    const local = readList(FOLLOWED_BRANDS_KEY)
    for (let i = 0; i < local.length; i++) {
      const brand = local[i]
      if (merged.indexOf(brand) >= 0) continue
      if (hasPendingBrandFollow(pendingOps, brand)) merged.push(brand)
    }
    brandState.followedBrands = merged
    writeList(FOLLOWED_BRANDS_KEY, merged)
    } catch (e) {
    // 离线时保留本地关注列表
  }
}

export function hasPendingBrandFollow(ops: SyncOperation[], brandName: string): boolean {
  for (let i = 0; i < ops.length; i++) {
    if (ops[i].entityType == 'brand_follow' && ops[i].entityId == brandName) return true
  }
  return false
}

export function reloadBrand() {
  const followed = readList(FOLLOWED_BRANDS_KEY)
  brandState.followedBrands = followed
}
