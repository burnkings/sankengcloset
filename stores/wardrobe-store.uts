import { WardrobeItem, WardrobeUpdateData } from '@/domain/wardrobe-item'
import * as repo from '@/domain/repositories/wardrobe-repo'
import { CATEGORY_LABELS } from '@/domain/clothing-category'

export const useWardrobeStore = defineStore('wardrobe', () => {
  const items = ref([]) as Ref<WardrobeItem[]>; const loading = ref(false); const error = ref(''); const currentCategory = ref(''); const searchKeyword = ref(''); const currentSort = ref('newest'); const viewMode = ref('grid'); const currentStatus = ref('')
  const filteredItems = computed((): WardrobeItem[] => items.value.filter((item) => {
    if (currentCategory.value != '' && item.category != currentCategory.value) return false
    if (currentStatus.value == 'favorite' && !item.isFavorite) return false
    if (currentStatus.value != '' && currentStatus.value != 'favorite' && item.wearStatus != currentStatus.value) return false
    if (searchKeyword.value == '') return true
    const keyword = searchKeyword.value.toLowerCase(); const category = CATEGORY_LABELS[item.category] ?? ''
    return item.name.toLowerCase().includes(keyword) || item.brand.toLowerCase().includes(keyword) || item.note.toLowerCase().includes(keyword) || category.toLowerCase().includes(keyword)
  }))
  const sortedItems = computed((): WardrobeItem[] => {
    const result = [...filteredItems.value]
    if (currentSort.value == 'earliest') result.sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime())
    else if (currentSort.value == 'priceHigh') result.sort((a, b) => b.purchasePrice - a.purchasePrice)
    else if (currentSort.value == 'priceLow') result.sort((a, b) => a.purchasePrice - b.purchasePrice)
    else if (currentSort.value == 'name') result.sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'))
    else result.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
    return result
  })
  const itemCount = computed((): number => items.value.length)
  const categoryCounts = computed(() => { const counts = {}; for (const item of items.value) counts[item.category] = (counts[item.category] ?? 0) + 1; return counts })
  function fetchItems() { loading.value = true; error.value = ''; try { repo.initMockData(); items.value = repo.getAll() } catch (err) { error.value = String(err) } finally { loading.value = false } }
  function addItem(item: WardrobeItem): WardrobeItem | null { try { const added = repo.add(item); items.value = [...items.value, added]; return added } catch (err) { error.value = String(err); return null } }
  function updateItem(id: string, data: WardrobeUpdateData): boolean { const ok = repo.update(id, data); if (ok) items.value = repo.getAll(); return ok }
  function deleteItem(id: string): boolean { const ok = repo.softDelete(id); if (ok) items.value = items.value.filter((item) => item.id !== id); return ok }
  function toggleFavorite(id: string) { if (repo.toggleFavorite(id)) items.value = repo.getAll() }
  function setCategory(value: string) { currentCategory.value = value }
  function setSearch(value: string) { searchKeyword.value = value }
  function setSort(value: string) { currentSort.value = value }
  function setStatus(value: string) { currentStatus.value = value }
  function setViewMode(value: string) { viewMode.value = value }
  function toggleViewMode() { viewMode.value = viewMode.value == 'grid' ? 'list' : 'grid' }
  function getById(id: string): WardrobeItem | undefined { return items.value.find((item) => item.id == id) }
  const activeFilterCount = computed((): number => { let count = 0; if (currentCategory.value != '') count++; if (currentStatus.value != '') count++; return count })
  const sortLabel = computed((): string => {
    if (currentSort.value == 'newest') return '最近加入'
    if (currentSort.value == 'earliest') return '最早加入'
    if (currentSort.value == 'priceHigh') return '价格高→低'
    if (currentSort.value == 'priceLow') return '价格低→高'
    if (currentSort.value == 'name') return '名称'
    return '最近加入'
  })
  return { loading, error, currentCategory, searchKeyword, currentSort, currentStatus, viewMode, sortedItems, itemCount, categoryCounts, activeFilterCount, sortLabel, fetchItems, addItem, updateItem, deleteItem, toggleFavorite, setCategory, setSearch, setSort, setStatus, setViewMode, toggleViewMode, getById }
})
