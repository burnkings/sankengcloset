import { reactive } from 'vue'
import { WardrobeItem, WardrobeUpdateData, wardrobeCoverImage } from '@/domain/wardrobe-item'
import * as repo from '@/domain/repositories/wardrobe-repo'
import { syncWriteBack } from '@/services/sync/write-back'
import { getCachedAccessToken } from '@/config/runtime'
import { createAssetRemote, deleteAssetRemote, listWardrobeRemote, patchAssetRemote } from '@/services/user-data/user-data-service'
import { SortType } from '@/types/sort'
import { categoryCodeToLabel } from '@/utils/category'
import { readStr, readNum, readBool, readStrArray } from '@/utils/remote-mapping'

// ====== 模块级 reactive 状态（单例）======

type WardrobeState = {
  items: WardrobeItem[]
  loading: boolean
  error: string
  currentCategory: string
  searchKeyword: string
  currentSort: string
  viewMode: string
  currentStatus: string
}

const _state = reactive<WardrobeState>({
  items: [] as WardrobeItem[],
  loading: false,
  error: '',
  currentCategory: '',
  searchKeyword: '',
  currentSort: SortType.NEWEST,
  viewMode: 'grid',
  currentStatus: '',
})

// 冷启动先把本地缓存倒进内存列表。
//
// 之前三张列表都只从 `[]` 起步、等 fetchItems() 回来才填，于是「我的」页里
// 衣柜/购买记录/提醒这几个计数每次冷启动都先显示 0 再跳成真实值 —— 用户看到的就是
// 「第一次进来还在刷新加载」。repo 本来就是这三个 store 的离线兜底数据源，
// 提前读一次不改变任何口径，只是把「有数据」提前到首帧。
_state.items = repo.getAll()

function categoryLabel(c: string): string { return categoryCodeToLabel(c) }

function filteredItems(): WardrobeItem[] {
  return _state.items.filter((item) => {
    if (_state.currentCategory != '' && item.category != _state.currentCategory) return false
    if (_state.currentStatus == 'favorite' && !item.isFavorite) return false
    if (_state.currentStatus != '' && _state.currentStatus != 'favorite' && item.wearStatus != _state.currentStatus) return false
    if (_state.searchKeyword == '') return true
    const keyword = _state.searchKeyword.toLowerCase()
    const category = categoryLabel(item.category)
    return item.name.toLowerCase().includes(keyword)
      || item.brand.toLowerCase().includes(keyword)
      || item.note.toLowerCase().includes(keyword)
      || category.toLowerCase().includes(keyword)
  })
}

function createdAtTime(item: WardrobeItem): number {
  if (item.createdAt == '') return 0
  return new Date(item.createdAt).getTime()
}

function sortedItems(): WardrobeItem[] {
  const result = [...filteredItems()]
  if (_state.currentSort == 'earliest') result.sort((a, b) => createdAtTime(a) - createdAtTime(b))
  else if (_state.currentSort == 'priceHigh') result.sort((a, b) => b.purchasePrice - a.purchasePrice)
  else if (_state.currentSort == 'priceLow') result.sort((a, b) => a.purchasePrice - b.purchasePrice)
  else result.sort((a, b) => createdAtTime(b) - createdAtTime(a))
  return result
}

// 渲染层纯 DTO（普通字段，无 getter）：避免 vapor 模式下 reactive proxy 包裹带 getter 的
// WardrobeItem 实例时，访问 getter 触发响应式追踪异常导致白屏。
export class WardrobeDisplayModel {
  id: string = ''
  coverImage: string = ''
  category: string = ''
  name: string = ''
  brand: string = ''
  wearStatus: string = ''
  purchasePrice: number = 0
  isFavorite: boolean = false
}

function toDisplayModel(item: WardrobeItem): WardrobeDisplayModel {
  const m = new WardrobeDisplayModel()
  m.id = item.id
  m.coverImage = wardrobeCoverImage(item)
  m.category = item.category
  m.name = item.name
  m.brand = item.brand
  m.wearStatus = item.wearStatus
  m.purchasePrice = item.purchasePrice
  m.isFavorite = item.isFavorite
  return m
}

function displaySortedItems(): WardrobeDisplayModel[] {
  const items = sortedItems()
  const result: WardrobeDisplayModel[] = []
  for (let i = 0; i < items.length; i++) result.push(toDisplayModel(items[i]))
  return result
}

function itemCount(): number { return _state.items.length }
function categoryCounts(): UTSJSONObject {
  const counts = {} as UTSJSONObject
  for (let i = 0; i < _state.items.length; i++) {
    const category = _state.items[i].category
    const current = counts[category] != null ? counts[category] as number : 0
    counts[category] = current + 1
  }
  return counts
}

function activeFilterCount(): number { let count = 0; if (_state.currentCategory != '') count++; if (_state.currentStatus != '') count++; return count }
/**
 * 排序标签。
 *
 * 2026-09-30：**去掉「名称」排序**（字母序对衣柜没有意义，中英文混排结果也很怪）。
 * 同时明确一件事：**「默认排序」和「最近加入」是同一个东西，不是两种排序** ——
 * `_state.currentSort` 的初值就是 `SortType.NEWEST`（见上方 `_state` 初始化），
 * 下面末行 `return '最近加入'` 只是把空串/未知值也归到它身上，并不存在第三种兜底顺序。
 */
function sortLabel(): string {
  if (_state.currentSort == 'earliest') return '最早加入'
  if (_state.currentSort == 'priceHigh') return '价格高→低'
  if (_state.currentSort == 'priceLow') return '价格低→高'
  return '最近加入'
}

function notifyChanged() {}

// ====== 模块级 action ======

// 请求序号：切账号/登出时 bump，丢弃过期请求，防旧账号数据覆盖新状态
let _fetchSeq = 0
export function bumpFetchSeq() { _fetchSeq += 1 }

/**
 * 退出/切账号时清空**内存态**（2026-10-09 评审 P1-3）。
 * 仅 bumpFetchSeq 只能防迟到响应，**不清已显示的数据** ⇒ 退出后
 * getPurchaseById/getAll 仍能拿到上一个账号的记录。
 */
export function resetSession() {
  _fetchSeq += 1
  _state.items = []
  _state.loading = false
  _state.error = ''
  _state.currentCategory = ''
  _state.searchKeyword = ''
  _state.currentStatus = ''
}

function mapRemoteWardrobe(raw: UTSJSONObject): WardrobeItem {
  const item = new WardrobeItem()
  item.id = readStr(raw, 'id')
  item.name = readStr(raw, 'name')
  item.category = readStr(raw, 'category', 'OTHER')
  item.style = readStr(raw, 'style')
  item.silhouette = readStr(raw, 'silhouette')
  item.brand = readStr(raw, 'brand')
  item.color = readStr(raw, 'color')
  item.size = readStr(raw, 'size')
  item.wearStatus = readStr(raw, 'wearStatus', 'UNWORN')
  item.seasons = readStrArray(raw, 'seasons')
  item.images = readStrArray(raw, 'images')
  item.tags = readStrArray(raw, 'tags')
  item.purchaseDate = readStr(raw, 'purchaseDate')
  item.purchasePrice = readNum(raw, 'purchasePrice')
  item.purchaseSource = readStr(raw, 'purchaseSource')
  item.purchaseId = readStr(raw, 'purchaseId')
  item.wishId = readStr(raw, 'wishId')
  item.note = readStr(raw, 'note')
  item.isFavorite = readBool(raw, 'isFavorite')
  item.createdAt = readStr(raw, 'createdAt')
  item.updatedAt = readStr(raw, 'updatedAt')
  return item
}

async function fetchItems() {
  const seq = ++_fetchSeq
  _state.loading = true
  _state.error = ''
  try {
    if (getCachedAccessToken() != '') {
      const remote = await listWardrobeRemote()
      if (seq !== _fetchSeq) return
      const restored = [] as WardrobeItem[]
      for (let i = 0; i < remote.length; i++) restored.push(mapRemoteWardrobe(remote[i]))
      // ⚠️ 必须同时写进 repo（评审 P1-4）：
      //    updateItem / deleteItem / toggleFavorite 都从 repo.loadAll() 找 ID，
      //    若只赋 _state.items，新设备上「state 有、repo 没有」⇒ 首次编辑/删除/收藏全部失败。
      //    合并策略：保留本地已有项中「本会话尚未成功同步」的改动，不被远端旧快照覆盖。
      const local = repo.getAll()
      if (local.length > 0) {
        const remoteIds: Set<string> = new Set<string>()
        for (let i = 0; i < restored.length; i++) remoteIds.add(restored[i].id)
        for (let i = 0; i < local.length; i++) {
          // 远端没返回的本地项（离线新建 / 待同步删除）保留，避免误删用户数据
          if (!remoteIds.has(local[i].id)) restored.push(local[i])
        }
      }
      repo.replaceAll(restored)
      _state.items = repo.getAll()
    } else {
      if (seq !== _fetchSeq) return
      // 游客（未登录）：只展示本机已存数据，不再播种 demo 假衣柜
      _state.items = repo.getAll()
    }
  } catch (err) {
    if (seq !== _fetchSeq) return
    _state.error = err instanceof Error ? err.message : '加载失败'
    _state.items = repo.getAll()
  } finally {
    if (seq === _fetchSeq) _state.loading = false
  }
  notifyChanged()
}

function addItem(item: WardrobeItem): WardrobeItem | null {
  try {
    const added = repo.add(item)
    _state.items = [..._state.items, added]
    // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
    syncWriteBack('wardrobe_item', added.id, 'create', JSON.stringify(added), () => createAssetRemote('wardrobe', added as UTSJSONObject))
    notifyChanged()
    return added
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '添加失败'
    return null
  }
}

function updateItem(id: string, data: WardrobeUpdateData): boolean {
  const ok = repo.update(id, data)
  if (ok) {
    _state.items = repo.getAll()
    const current = _state.items.find((item) => item.id == id)
    if (current != null) {
      // 统一写回：有 token 直写远程、失败入队；无 token 直接入队。payload 一律用同步后的完整对象
      syncWriteBack('wardrobe_item', id, 'update', JSON.stringify(current), () => patchAssetRemote('wardrobe', id, current as UTSJSONObject))
    }
    notifyChanged()
  }
  return ok
}

function deleteItem(id: string): boolean {
  const ok = repo.softDelete(id)
  if (ok) {
    _state.items = _state.items.filter((item) => item.id !== id)
    syncWriteBack('wardrobe_item', id, 'delete', '', () => deleteAssetRemote('wardrobe', id))
    notifyChanged()
  }
  return ok
}

function toggleFavorite(id: string) {
  if (repo.toggleFavorite(id)) {
    _state.items = repo.getAll()
    const current = _state.items.find((item) => item.id == id)
    syncWriteBack('wardrobe_item', id, 'update', current != null ? JSON.stringify(current) : 'favorite=toggle', () => patchAssetRemote('wardrobe', id, current as UTSJSONObject))
    notifyChanged()
  }
}

function setCategory(value: string) {
  _state.currentCategory = value
  notifyChanged()
}

function setSearch(value: string) {
  _state.searchKeyword = value
  notifyChanged()
}

function setSort(value: string) {
  _state.currentSort = value
  notifyChanged()
}

function setStatus(value: string) {
  _state.currentStatus = value
  notifyChanged()
}

function setViewMode(value: string) {
  _state.viewMode = value
  notifyChanged()
}

function toggleViewMode() {
  _state.viewMode = _state.viewMode == 'grid' ? 'list' : 'grid'
  notifyChanged()
}

function getById(id: string): WardrobeItem | null { return _state.items.find((item) => item.id == id) }

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class WardrobeStoreHandle {
  get loading(): boolean { return _state.loading }
  get error(): string { return _state.error }
  get currentCategory(): string { return _state.currentCategory }
  get searchKeyword(): string { return _state.searchKeyword }
  get currentSort(): string { return _state.currentSort }
  get currentStatus(): string { return _state.currentStatus }
  get viewMode(): string { return _state.viewMode }
  get sortedItems(): WardrobeDisplayModel[] { return displaySortedItems() }
  /** 供 Feed 搭配度计算使用；页面仍应使用 sortedItems 渲染。 */
  get items(): WardrobeItem[] { return _state.items }
  get itemCount(): number { return itemCount() }
  get categoryCounts(): UTSJSONObject { return categoryCounts() }
  get activeFilterCount(): number { return activeFilterCount() }
  get sortLabel(): string { return sortLabel() }
  fetchItems(): Promise<void> { return fetchItems() }
  addItem(item: WardrobeItem): WardrobeItem | null { return addItem(item) }
  updateItem(id: string, data: WardrobeUpdateData): boolean { return updateItem(id, data) }
  deleteItem(id: string): boolean { return deleteItem(id) }
  toggleFavorite(id: string): void { toggleFavorite(id) }
  setCategory(value: string): void { setCategory(value) }
  setSearch(value: string): void { setSearch(value) }
  setSort(value: string): void { setSort(value) }
  setStatus(value: string): void { setStatus(value) }
  setViewMode(value: string): void { setViewMode(value) }
  toggleViewMode(): void { toggleViewMode() }
  getById(id: string): WardrobeItem | null { return getById(id) }
}

let _handle: WardrobeStoreHandle | null = null
export function useWardrobeStore(): WardrobeStoreHandle {
  if (_handle == null) _handle = new WardrobeStoreHandle()
  return _handle!
}
