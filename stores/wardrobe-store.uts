import { reactive, computed } from 'vue'
import { WardrobeItem, WardrobeUpdateData } from '@/domain/wardrobe-item'
import * as repo from '@/domain/repositories/wardrobe-repo'
import { CATEGORY_LABELS } from '@/domain/clothing-category'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'
import { getCachedAccessToken } from '@/config/runtime'
import { createAssetRemote, deleteAssetRemote, listWardrobeRemote, patchAssetRemote } from '@/services/user-data/user-data-service'

// ====== 模块级 reactive 状态（单例）======

type WardrobeState = {
  items: WardrobeItem[]
  loading: boolean
  error: string
  currentCategory: string
  searchKeyword: string
  currentSort: string
  viewMode: string
  currentStatus: string
}

const _state = reactive<WardrobeState>({
  items: [] as WardrobeItem[],
  loading: false,
  error: '',
  currentCategory: '',
  searchKeyword: '',
  currentSort: 'newest',
  viewMode: 'grid',
  currentStatus: '',
})

const _filteredItems = computed((): WardrobeItem[] => _state.items.filter((item) => {
  if (_state.currentCategory != '' && item.category != _state.currentCategory) return false
  if (_state.currentStatus == 'favorite' && !item.isFavorite) return false
  if (_state.currentStatus != '' && _state.currentStatus != 'favorite' && item.wearStatus != _state.currentStatus) return false
  if (_state.searchKeyword == '') return true
  const keyword = _state.searchKeyword.toLowerCase()
  const categoryRaw = CATEGORY_LABELS[item.category]
  const category = categoryRaw != null ? categoryRaw as string : ''
  return item.name.toLowerCase().includes(keyword)
    || item.brand.toLowerCase().includes(keyword)
    || item.note.toLowerCase().includes(keyword)
    || category.toLowerCase().includes(keyword)
}))

function createdAtTime(item: WardrobeItem): number {
  if (item.createdAt == '') return 0
  return new Date(item.createdAt).getTime()
}

const _sortedItems = computed((): WardrobeItem[] => {
  const result = [..._filteredItems.value]
  if (_state.currentSort == 'earliest') result.sort((a, b) => createdAtTime(a) - createdAtTime(b))
  else if (_state.currentSort == 'priceHigh') result.sort((a, b) => b.purchasePrice - a.purchasePrice)
  else if (_state.currentSort == 'priceLow') result.sort((a, b) => a.purchasePrice - b.purchasePrice)
  else if (_state.currentSort == 'name') result.sort((a, b) => (a.name < b.name ? -1 : (a.name > b.name ? 1 : 0)))
  else result.sort((a, b) => createdAtTime(b) - createdAtTime(a))
  return result
})

const _itemCount = computed((): number => _state.items.length)
const _categoryCounts = computed(() => {
  const counts = {} as UTSJSONObject
  for (let i = 0; i < _state.items.length; i++) {
    const category = _state.items[i].category
    const current = counts[category] != null ? counts[category] as number : 0
    counts[category] = current + 1
  }
  return counts
})

const _activeFilterCount = computed((): number => { let count = 0; if (_state.currentCategory != '') count++; if (_state.currentStatus != '') count++; return count })
const _sortLabel = computed((): string => {
  if (_state.currentSort == 'newest') return '最近加入'
  if (_state.currentSort == 'earliest') return '最早加入'
  if (_state.currentSort == 'priceHigh') return '价格高→低'
  if (_state.currentSort == 'priceLow') return '价格低→高'
  if (_state.currentSort == 'name') return '名称'
  return '最近加入'
})

const CHANGE_EVENT = 'store:wardrobe-changed'
function notifyChanged() { uni.$emit(CHANGE_EVENT) }

// ====== 模块级 action ======

function mapRemoteWardrobe(raw: UTSJSONObject): WardrobeItem {
  const item = new WardrobeItem()
  item.id = raw['id'] != null ? raw['id'] as string : ''
  item.name = raw['name'] != null ? raw['name'] as string : ''
  item.category = raw['category'] != null ? raw['category'] as string : 'OTHER'
  item.style = raw['style'] != null ? raw['style'] as string : ''
  item.brand = raw['brand'] != null ? raw['brand'] as string : ''
  item.color = raw['color'] != null ? raw['color'] as string : ''
  item.size = raw['size'] != null ? raw['size'] as string : ''
  item.wearStatus = raw['wearStatus'] != null ? raw['wearStatus'] as string : 'UNWORN'
  item.seasons = raw['seasons'] != null ? raw['seasons'] as string[] : []
  item.images = raw['images'] != null ? raw['images'] as string[] : []
  item.tags = raw['tags'] != null ? raw['tags'] as string[] : []
  item.purchaseDate = raw['purchaseDate'] != null ? raw['purchaseDate'] as string : ''
  item.purchasePrice = raw['purchasePrice'] != null ? raw['purchasePrice'] as number : 0
  item.purchaseSource = raw['purchaseSource'] != null ? raw['purchaseSource'] as string : ''
  item.note = raw['note'] != null ? raw['note'] as string : ''
  item.isFavorite = raw['isFavorite'] == true
  item.createdAt = raw['createdAt'] != null ? raw['createdAt'] as string : ''
  item.updatedAt = raw['updatedAt'] != null ? raw['updatedAt'] as string : ''
  return item
}

async function fetchItems() {
  _state.loading = true
  _state.error = ''
  try {
    if (getCachedAccessToken() != '') {
      const remote = await listWardrobeRemote()
      const restored = [] as WardrobeItem[]
      for (let i = 0; i < remote.length; i++) restored.push(mapRemoteWardrobe(remote[i]))
      _state.items = restored
    } else {
      repo.initMockData()
      _state.items = repo.getAll()
    }
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '加载失败'
    _state.items = repo.getAll()
  } finally {
    _state.loading = false
  }
  notifyChanged()
}

function addItem(item: WardrobeItem): WardrobeItem | null {
  try {
    const added = repo.add(item)
    _state.items = [..._state.items, added]
    enqueueLocalOperation(getCurrentSyncUserId(), 'wardrobe_item', added.id, 'create', JSON.stringify(added))
    if (getCachedAccessToken() != '') createAssetRemote('wardrobe', added as UTSJSONObject).catch(() => {})
    notifyChanged()
    return added
  } catch (err) {
    _state.error = err instanceof Error ? err.message : '添加失败'
    return null
  }
}

function updateItem(id: string, data: WardrobeUpdateData): boolean {
  const ok = repo.update(id, data)
  if (ok) {
    _state.items = repo.getAll()
    enqueueLocalOperation(getCurrentSyncUserId(), 'wardrobe_item', id, 'update', JSON.stringify(data))
    if (getCachedAccessToken() != '') {
      const current = _state.items.find((item) => item.id == id)
      if (current != null) patchAssetRemote('wardrobe', id, current as UTSJSONObject).catch(() => {})
    }
    notifyChanged()
  }
  return ok
}

function deleteItem(id: string): boolean {
  const ok = repo.softDelete(id)
  if (ok) {
    _state.items = _state.items.filter((item) => item.id !== id)
    enqueueLocalOperation(getCurrentSyncUserId(), 'wardrobe_item', id, 'delete', '')
    if (getCachedAccessToken() != '') deleteAssetRemote('wardrobe', id).catch(() => {})
    notifyChanged()
  }
  return ok
}

function toggleFavorite(id: string) {
  if (repo.toggleFavorite(id)) {
    _state.items = repo.getAll()
    enqueueLocalOperation(getCurrentSyncUserId(), 'wardrobe_item', id, 'update', 'favorite=toggle')
    if (getCachedAccessToken() != '') {
      const current = _state.items.find((item) => item.id == id)
      if (current != null) patchAssetRemote('wardrobe', id, current as UTSJSONObject).catch(() => {})
    }
    notifyChanged()
  }
}

function setCategory(value: string) {
  _state.currentCategory = value
  notifyChanged()
}

function setSearch(value: string) {
  _state.searchKeyword = value
  notifyChanged()
}

function setSort(value: string) {
  _state.currentSort = value
  notifyChanged()
}

function setStatus(value: string) {
  _state.currentStatus = value
  notifyChanged()
}

function setViewMode(value: string) {
  _state.viewMode = value
  notifyChanged()
}

function toggleViewMode() {
  _state.viewMode = _state.viewMode == 'grid' ? 'list' : 'grid'
  notifyChanged()
}

function getById(id: string): WardrobeItem | null { return _state.items.find((item) => item.id == id) }

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class WardrobeStoreHandle {
  get loading(): boolean { return _state.loading }
  get error(): string { return _state.error }
  get currentCategory(): string { return _state.currentCategory }
  get searchKeyword(): string { return _state.searchKeyword }
  get currentSort(): string { return _state.currentSort }
  get currentStatus(): string { return _state.currentStatus }
  get viewMode(): string { return _state.viewMode }
  get sortedItems(): WardrobeItem[] { return _sortedItems.value }
  get itemCount(): number { return _itemCount.value }
  get categoryCounts(): UTSJSONObject { return _categoryCounts.value }
  get activeFilterCount(): number { return _activeFilterCount.value }
  get sortLabel(): string { return _sortLabel.value }
  fetchItems(): Promise<void> { return fetchItems() }
  addItem(item: WardrobeItem): WardrobeItem | null { return addItem(item) }
  updateItem(id: string, data: WardrobeUpdateData): boolean { return updateItem(id, data) }
  deleteItem(id: string): boolean { return deleteItem(id) }
  toggleFavorite(id: string): void { toggleFavorite(id) }
  setCategory(value: string): void { setCategory(value) }
  setSearch(value: string): void { setSearch(value) }
  setSort(value: string): void { setSort(value) }
  setStatus(value: string): void { setStatus(value) }
  setViewMode(value: string): void { setViewMode(value) }
  toggleViewMode(): void { toggleViewMode() }
  getById(id: string): WardrobeItem | null { return getById(id) }
}

let _handle: WardrobeStoreHandle | null = null
export function useWardrobeStore(): WardrobeStoreHandle {
  if (_handle == null) _handle = new WardrobeStoreHandle()
  return _handle!
}
