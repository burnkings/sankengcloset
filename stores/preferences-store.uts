/**
 * PreferencesStore — 推荐偏好管理
 * 管理用户的坑种偏好、内容类型偏好、关注品牌与价格区间
 * 用于首页 Feed 排序：匹配偏好内容获得更高排序分
 */

import { reactive } from 'vue'
import { FeedItem } from '@/domain/content/feed-item'
import { getCachedAccessToken } from '@/config/runtime'
import { loadPreferencesRemote, savePreferencesRemote } from '@/services/user-data/user-data-service'

const STORAGE_KEY = 'v2_user_preferences'

// ====== 默认值 ======

// 空数组 = 不限制坑向分类（展示全部）
const DEFAULT_PIT_TYPES = [] as string[]
const DEFAULT_PRICE_RANGE = 'all'

// ====== 持久化工具 ======

function readPreferences(): PreferencesData {
  try {
    const raw = uni.getStorageSync(STORAGE_KEY)
    if (raw == null || raw as string === '') return new PreferencesData()
    const parsed = JSON.parse(raw as string) as UTSJSONObject
    if (parsed == null) return new PreferencesData()
    const data = new PreferencesData()
    if (parsed['pitTypes'] != null) {
      // 迁移旧存量值：LOLITA/HANFU（大写英文）→ Lolita/汉服（UI 文案）
      const stored = parsed['pitTypes'] as string[]
      const normalized = [] as string[]
      for (let i = 0; i < stored.length; i++) {
        const v = stored[i]
        let target = v
        if (v === 'LOLITA') {
          target = 'Lolita'
        } else if (v === 'HANFU') {
          target = '汉服'
        }
        // 去重：老版本 toggle 可能产生重复条目（如 'LOLITA' 与 'Lolita' 并存），迁移后需收敛
        if (normalized.indexOf(target) === -1) normalized.push(target)
      }
      // 旧存量恰好同时包含 JK/Lolita/汉服 → 视为「全部」，转换为空数组
      const hasJK = normalized.indexOf('JK') >= 0
      const hasLolita = normalized.indexOf('Lolita') >= 0
      const hasHanfu = normalized.indexOf('汉服') >= 0
      if (hasJK && hasLolita && hasHanfu) {
        data.pitTypes = [] as string[]
      } else {
        data.pitTypes = normalized
      }
    }
    if (parsed['followedBrands'] != null) data.followedBrands = parsed['followedBrands'] as string[]
    if (parsed['priceRange'] != null) data.priceRange = parsed['priceRange'] as string
    return data
  } catch (e) {
    return new PreferencesData()
  }
}

function writePreferences(data: PreferencesData) {
  try {
    const json = JSON.stringify(data)
    uni.setStorageSync(STORAGE_KEY, json)
  } catch (e) {
    // write failure is non-fatal
  }
}

// ====== 数据模型 ======

export class PreferencesData {
  pitTypes: string[] = [] // 空数组 = 全部
  followedBrands: string[] = []
  priceRange: string = DEFAULT_PRICE_RANGE
}

// ====== 模块级 reactive 状态（单例）======

type PreferencesState = {
  preferences: PreferencesData
}

const _state = reactive<PreferencesState>({
  preferences: new PreferencesData(),
})

const CHANGE_EVENT = 'store:preferences-changed'
function notifyChanged() { uni.$emit(CHANGE_EVENT) }

// ====== 模块级 action ======

function loadPreferences() {
  _state.preferences = readPreferences()
  notifyChanged()
}

function toRemotePitType(value: string): string {
  if (value == 'Lolita') return 'LOLITA'
  if (value == '汉服') return 'HANFU'
  return value
}

/**
 * 偏好匹配分：首页 Feed 排序用
 * 命中坑向偏好 +100，命中关注品牌 +80，基准分 = item.rankingScore
 */
function computeScore(item: FeedItem): number {
  let score = item.rankingScore
  const pitTypes = _state.preferences.pitTypes
  // 坑向偏好匹配（UI 文案 → 后端枚举）
  if (item.category != '' && pitTypes.length > 0) {
    for (let i = 0; i < pitTypes.length; i++) {
      if (toRemotePitType(pitTypes[i]) == item.category) {
        score += 100
        break
      }
    }
  }
  // 关注品牌匹配
  const brands = _state.preferences.followedBrands
  if (item.brandName != '' && brands.length > 0) {
    for (let i = 0; i < brands.length; i++) {
      if (brands[i] == item.brandName) {
        score += 80
        break
      }
    }
  }
  return score
}

function savePreferences() {
  writePreferences(_state.preferences)
  if (getCachedAccessToken() != '') {
    const remoteTypes = [] as string[]
    for (let i = 0; i < _state.preferences.pitTypes.length; i++) remoteTypes.push(toRemotePitType(_state.preferences.pitTypes[i]))
    savePreferencesRemote({
      pitTypes: remoteTypes,
      followedBrands: _state.preferences.followedBrands,
      priceRange: _state.preferences.priceRange,
      themeMode: 'system',
    }).catch(() => { /* local state remains the offline fallback */ })
  }
}

async function refreshRemotePreferences(): Promise<void> {
  if (getCachedAccessToken() == '') return
  try {
    const remote = await loadPreferencesRemote()
    if (remote['pitTypes'] == null) return
    const next = new PreferencesData()
    const source = remote['pitTypes'] as string[]
    for (let i = 0; i < source.length; i++) {
      const value = source[i]
      next.pitTypes.push(value == 'LOLITA' ? 'Lolita' : value == 'HANFU' ? '汉服' : value)
    }
    if (remote['followedBrands'] != null) next.followedBrands = remote['followedBrands'] as string[]
    if (remote['priceRange'] != null) next.priceRange = remote['priceRange'] as string
    _state.preferences = next
    writePreferences(next)
    notifyChanged()
  } catch (e) {
    // Keep the local preference choice usable while offline.
  }
}

function setPitTypes(types: string[]) {
  const copy = [] as string[]
  for (let i = 0; i < types.length; i++) copy.push(types[i])
  _state.preferences.pitTypes = copy
  savePreferences()
  notifyChanged()
}

function togglePitType(type: string) {
  if (type === '') return
  const prefs = _state.preferences
  const values = [] as string[]
  for (let i = 0; i < prefs.pitTypes.length; i++) values.push(prefs.pitTypes[i])
  const idx = values.indexOf(type)
  if (idx >= 0) {
    values.splice(idx, 1)
  } else {
    values.push(type)
  }
  _state.preferences.pitTypes = values
  savePreferences()
  notifyChanged()
}

function resetPreferences() {
  const defaults = new PreferencesData()
  // preserve followed brands on reset
  defaults.followedBrands = _state.preferences.followedBrands
  _state.preferences = defaults
  savePreferences()
  notifyChanged()
}

// 初始化
loadPreferences()

// ====== useXxxStore：返回 store 句柄（页面零改动）======

class PreferencesStoreHandle {
  get preferences(): PreferencesData { return _state.preferences }
  loadPreferences(): void { loadPreferences() }
  savePreferences(): void { savePreferences() }
  setPitTypes(types: string[]): void { setPitTypes(types) }
  togglePitType(type: string): void { togglePitType(type) }
  resetPreferences(): void { resetPreferences() }
  refreshRemotePreferences(): Promise<void> { return refreshRemotePreferences() }
  computeScore(item: FeedItem): number { return computeScore(item) }
}

let _handle: PreferencesStoreHandle | null = null
export function usePreferencesStore(): PreferencesStoreHandle {
  if (_handle == null) _handle = new PreferencesStoreHandle()
  return _handle!
}
