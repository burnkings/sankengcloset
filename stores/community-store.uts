import { reactive } from 'vue'
import { enqueueLocalOperation, getCurrentSyncUserId } from '@/services/sync/local-sync-queue'

import { getCachedAccessToken } from '@/config/runtime'

import { CommunityPostRemote, deleteCommunityPostRemote, listCommunityPostPageRemote, listCommunityPostsRemote, setCommunityPostLikeRemote, uploadOutfitImageRemote, createCommunityPostRemote } from '@/services/user-data/user-data-service'
import { useSessionStore } from '@/stores/session-store'
import { showFeedback } from '@/utils/feedback'
import { readString, readList, writeList } from '@/stores/content-storage'

export class PublicLookPost {
  id: string = ''
  imageUrl: string = ''
  /** 全部图片（顺序即展示顺序）。为空时退回 [imageUrl]，老数据不受影响 */
  imageUrls: string[] = []
  caption: string = ''
  category: string = ''
  topic: string = ''
  authorUserId: string = ''
  authorNickname: string = ''
  /** 作者头像地址（空 = 作者未设头像，卡片回退 initial 文字首字） */
  avatarUrl: string = ''
  likeCount: number = 0
  liked: boolean = false
  /** Phase 2.3-A：关联商品 id（空 = 普通内容，卡片不显示商品入口） */
  productId: string = ''
  /** 'public' | 'private'（仅自己可见） */
  visibility: string = 'public'
  createdAt: string = ''
  initial: string = ''
}
export class SavedOutfitPost {
  id: string = ''
  image: string = ''
  /** 作者昵称/头像的**发布快照**（后端冗余列，不是当前账号资料）。
   *  用它而不是 session.profile，才能保证「我自己看到的」和「别人看到的」是同一条动态的同一份快照。 */
  authorNickname: string = ''
  authorAvatarUrl: string = ''
  /** 全部图片（顺序即展示顺序）。为空时退回 [image]，老数据不受影响 */
  imageUrls: string[] = []
  /** 'public' | 'private'（仅自己可见）——「我的动态」里要给出标识，否则用户分不清哪条是私密的 */
  visibility: string = 'public'
  caption: string = ''
  category: string = ''
  topic: string = ''
  productId: string = ''
  wardrobeIds: string[] = []
  createdAt: string = ''
  // true = 远程已发布（listCommunityPostsRemote mine）
  isRemote: boolean = false
}
const LIKED_POST_IDS_KEY = 'v2_library_liked_post_ids'
const MOCK_POSTS_KEY = 'v26_mock_published_posts'
type State = {
  outfitPosts: SavedOutfitPost[]
  likedPostIds: string[]
  publicPosts: PublicLookPost[]
  publicLoading: boolean
  publicError: string
  publicLoadedOnce: boolean
  publicNextCursor: string
  publicHasMore: boolean
  publicLoadingMore: boolean
}
export const communityState = reactive<State>({
  outfitPosts: [] as SavedOutfitPost[],
  likedPostIds: [] as string[],
  publicPosts: [] as PublicLookPost[],
  publicLoading: false,
  publicError: '',
  publicLoadedOnce: false,
  publicNextCursor: '',
  publicHasMore: false,
  publicLoadingMore: false,
})

export function readMockPosts(): SavedOutfitPost[] {
  try {
    const raw = readString(MOCK_POSTS_KEY)
    if (raw === '') return []
    const parsed = JSON.parse(raw) as UTSJSONObject[]
    const posts: SavedOutfitPost[] = []
    for (let i = 0; i < parsed.length; i++) {
      const item = parsed[i]
      if (item == null) continue
      const p = new SavedOutfitPost()
      p.id = item['id'] != null ? item['id'] as string : ''
      p.image = item['image'] != null ? item['image'] as string : ''
      p.caption = item['caption'] != null ? item['caption'] as string : ''
      p.category = item['category'] != null ? item['category'] as string : ''
      p.topic = item['topic'] != null ? item['topic'] as string : ''
      p.productId = item['productId'] != null ? item['productId'] as string : ''
      p.wardrobeIds = item['wardrobeIds'] != null ? item['wardrobeIds'] as string[] : []
      p.createdAt = item['createdAt'] != null ? item['createdAt'] as string : ''
      p.isRemote = true
      if (p.id != '') posts.push(p)
    }
    return posts
  } catch (e) {
    return []
  }
}

export function writeMockPosts(posts: SavedOutfitPost[]) {
  try {
    const serializable: UTSJSONObject[] = []
    for (let i = 0; i < posts.length; i++) {
      serializable.push({
        id: posts[i].id,
        image: posts[i].image,
        caption: posts[i].caption,
        category: posts[i].category,
        topic: posts[i].topic,
        productId: posts[i].productId,
        wardrobeIds: posts[i].wardrobeIds,
        createdAt: posts[i].createdAt,
      } as UTSJSONObject)
    }
    uni.setStorageSync(MOCK_POSTS_KEY, JSON.stringify(serializable))
  } catch (e) {
    // write failure is non-fatal
  }
}

export function mockToPublicLook(post: SavedOutfitPost): PublicLookPost {
  const p = new PublicLookPost()
  p.id = post.id
  p.imageUrl = post.image
  p.caption = post.caption
  p.category = post.category
  p.topic = post.topic
  const session = useSessionStore()
  const nickname = session.profile.nickname !== '' ? session.profile.nickname : '我'
  p.authorNickname = nickname
  p.avatarUrl = session.profile.avatarUrl
  p.initial = nickname.length > 0 ? nickname.substring(0, 1) : '我'
  p.likeCount = 0
  p.liked = false
  p.productId = post.productId
  p.createdAt = post.createdAt
  return p
}

export function remoteToPublicLook(item: CommunityPostRemote): PublicLookPost {
  const post = new PublicLookPost()
  post.id = item.id
  post.imageUrl = item.imageUrl
  post.imageUrls = item.imageUrls.length > 0 ? item.imageUrls : (item.imageUrl != '' ? [item.imageUrl] : [])
  post.caption = item.caption
  post.category = item.category == 'LOLITA' ? 'Lolita' : item.category == 'HANFU' ? '汉服' : item.category == 'MIXED' ? '混搭' : 'JK'
  post.topic = item.topic
  post.authorUserId = item.authorUserId
  post.authorNickname = item.authorNickname !== '' ? item.authorNickname : '同好'
  // 头像用后端现拼的作者头像；作者没设头像就留空，卡片自动回退文字首字
  post.avatarUrl = item.authorAvatarUrl
  post.likeCount = item.likeCount
  post.liked = item.liked
  post.productId = item.productId
  post.visibility = item.visibility
  post.createdAt = item.createdAt
  const nick = post.authorNickname
  post.initial = nick.length > 0 ? nick.substring(0, 1) : '同'
  return post
}

export function outfitCount(): number { return communityState.outfitPosts.length }

export function likedPostCount(): number { return communityState.likedPostIds.length }

export async function refreshPublicPosts(): Promise<void> {
  // 首次加载才显示骨架屏；之后进入静默刷新，避免空数据/重复进入闪 0.5s 骨架屏。
  if (!communityState.publicLoadedOnce) communityState.publicLoading = true
  communityState.publicError = ''
  try {
    const remote = await listCommunityPostPageRemote('', '', '', false)
    const posts: PublicLookPost[] = []
    for (let i = 0; i < remote.items.length; i++) {
      const item = remote.items[i]
      const post = remoteToPublicLook(item)
      posts.push(post)
      if (item.liked && communityState.likedPostIds.indexOf(item.id) < 0) communityState.likedPostIds.push(item.id)
    }
    communityState.publicPosts = posts
    communityState.publicNextCursor = remote.nextCursor
    communityState.publicHasMore = remote.hasMore
  } catch (e) {
    communityState.publicError = '动态加载失败，请重试'
  } finally {
    // 本机发布过的动态混入公开 Gallery 顶部；仅按本机帖子 ID 去重
    const mock = readMockPosts()
    const mockPublic: PublicLookPost[] = []
    const localIds: string[] = []
    for (let i = 0; i < mock.length; i++) { mockPublic.push(mockToPublicLook(mock[i])); localIds.push(mock[i].id) }
    const remoteOnly = communityState.publicPosts.filter((post) => localIds.indexOf(post.id) < 0)
    communityState.publicPosts = [...mockPublic, ...remoteOnly]
    communityState.publicLoading = false
    communityState.publicLoadedOnce = true
  }
}

export async function loadMorePublicPosts(): Promise<void> {
  if (communityState.publicLoadingMore || !communityState.publicHasMore || communityState.publicNextCursor === '') return
  communityState.publicLoadingMore = true
  try {
    const remote = await listCommunityPostPageRemote(communityState.publicNextCursor, '', '', false)
    const existing = [...communityState.publicPosts]
    for (let i = 0; i < remote.items.length; i++) {
      const item = remote.items[i]
      if (existing.some((post) => post.id === item.id)) continue
      existing.push(remoteToPublicLook(item))
      if (item.liked && communityState.likedPostIds.indexOf(item.id) < 0) communityState.likedPostIds.push(item.id)
    }
    communityState.publicPosts = existing
    communityState.publicNextCursor = remote.nextCursor
    communityState.publicHasMore = remote.hasMore
  } catch (e) {
    showFeedback('加载更多失败，请稍后重试')
  } finally {
    communityState.publicLoadingMore = false
  }
}

export async function refreshMyPosts(): Promise<void> {
  const mock = readMockPosts()
  if (getCachedAccessToken() == '') {
    // 游客：只展示本机发布过的动态
    communityState.outfitPosts = mock
      return
  }
  try {
    const remote = await listCommunityPostsRemote('', '', '', true)
    const saved = [] as SavedOutfitPost[]
    for (let i = 0; i < remote.length; i++) {
      const item = remote[i]
      const post = new SavedOutfitPost()
      post.id = item.id
      post.image = item.imageUrl
      post.imageUrls = item.imageUrls.length > 0 ? item.imageUrls : (item.imageUrl != '' ? [item.imageUrl] : [])
      post.visibility = item.visibility
      post.caption = item.caption
      post.category = item.category == 'LOLITA' ? 'Lolita' : item.category == 'HANFU' ? '汉服' : item.category == 'MIXED' ? '混搭' : item.category
      post.topic = item.topic
      post.productId = item.productId
      post.createdAt = item.createdAt
      post.authorNickname = item.authorNickname
      post.authorAvatarUrl = item.authorAvatarUrl
      post.isRemote = true
      saved.push(post)
      if (item.liked && communityState.likedPostIds.indexOf(item.id) < 0) communityState.likedPostIds.push(item.id)
    }
    communityState.outfitPosts = [...saved, ...mock]
    } catch (e) {
    // 网络失败保留上次列表，不阻塞社区页
  }
}

/**
 * 发布动态（支持多图）。
 *
 * 2026-09-30：由「单图」扩展成「多图」。做法就是主流那套 —— 逐张走
 * `POST /uploads:prepare` → `PUT content` 拿到 mediaId 数组，再一起交给发帖接口：
 *   · `mediaId`   = 首图（**封面**，后端现有字段，老接口继续可用）
 *   · `mediaIds`  = 全部图片（后端已支持：`community_posts.media_ids text[]`）
 * 同时接出可见性 `visibility`（'public' | 'private'）：后端 `community_posts.visibility`
 * 列和 CHECK 约束本来就有，缺的只是「路由要不要收这个字段」。
 */
export async function publishOutfitRemote(imagePaths: string[], caption: string, category: string, topic: string, wardrobeIds: string[] = [], productId: string = '', visibility: string = 'public'): Promise<boolean> {
  // 发布必须真实账号：游客不能发布（本机假发布会让「我的动态」与服务端长期不一致）
  if (getCachedAccessToken() == '') throw new Error('请先登录')
  if (imagePaths.length == 0) throw new Error('请先选择图片')
  const mediaIds: string[] = []
  for (let i = 0; i < imagePaths.length; i++) mediaIds.push(await uploadOutfitImageRemote(imagePaths[i]))
  const backendCategory = category === '混搭' ? 'MIXED' : (category === 'Lolita' ? 'LOLITA' : (category === '汉服' ? 'HANFU' : 'JK'))
  const payload = {
    mediaId: mediaIds[0],
    mediaIds,
    caption,
    category: backendCategory,
    topic,
    visibility: visibility === 'private' ? 'private' : 'public',
    wardrobeIds,
    // Phase 2.3-A：可选商品关联（空串不传 → 后端 productId=null 普通内容）
    ...(productId !== '' ? { productId } : {}),
  } as UTSJSONObject
  await createCommunityPostRemote(payload)
  // 发布成功后刷新本模块**自己**的两个列表。
  //
  // ⚠️ 这里曾经写的是 `reload()` —— 那是 `content-library-store` 的函数，本模块里根本不存在，
  //    所以每次发布都会在「帖子已建成功」之后抛 `ReferenceError: reload is not defined`：
  //    用户看到报错 toast，但帖子其实发出去了，且列表/图片/头像全都没刷新。
  //    本模块不能 import content-library-store（它反过来 import 本模块，会成环），
  //    所以只能调用这里自己的 refresh*。
  try {
    await refreshMyPosts()
    if (visibility !== 'private') await refreshPublicPosts()
  } catch (_) {
    // 刷新失败不影响发布结果：进「我的动态」/ 下拉刷新时会重新拉
  }
  return true
}

export function removeOutfit(id: string) {
  const liked = [...communityState.likedPostIds]
  const likedIdx = liked.indexOf(id)
  if (likedIdx >= 0) {
    liked.splice(likedIdx, 1)
    communityState.likedPostIds = liked
    writeList(LIKED_POST_IDS_KEY, liked)
  }
  const mockPosts = readMockPosts()
  const isLocal = mockPosts.some((post) => post.id == id)
  if (isLocal) {
    // 本机发布缓存里的帖：直接从本地存储移除
    writeMockPosts(mockPosts.filter((post) => post.id != id))
  } else if (getCachedAccessToken() != '') {
    // 远程帖子直接 DELETE（Authorized），失败才入队由同步队列重放
    deleteCommunityPostRemote(id).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'outfit', id, 'delete', '')
    })
  }
  // 直接过滤内存列表（不再全量 reload，避免删除后其余帖子从视图消失）
  communityState.outfitPosts = communityState.outfitPosts.filter((post) => post.id != id)
  communityState.publicPosts = communityState.publicPosts.filter((post) => post.id != id)
}

export function isPostLiked(postId: string): boolean {
  return communityState.likedPostIds.indexOf(postId) >= 0
}

export function togglePostLike(postId: string): boolean {
  if (postId === '') return false
  const values = [...communityState.likedPostIds]
  const idx = values.indexOf(postId)
  if (idx >= 0) values.splice(idx, 1)
  else values.unshift(postId)
  communityState.likedPostIds = values
  writeList(LIKED_POST_IDS_KEY, values)
  // 统一策略：直接远程写（Authorized CRUD）；仅在失败时入队，由 syncNow 重放
  if (getCachedAccessToken() != '') {
    const wanted = idx < 0
    setCommunityPostLikeRemote(postId, wanted).catch(() => {
      enqueueLocalOperation(getCurrentSyncUserId(), 'post_like', postId, idx < 0 ? 'upsert' : 'delete', '')
    })
  } else {
    enqueueLocalOperation(getCurrentSyncUserId(), 'post_like', postId, idx < 0 ? 'upsert' : 'delete', '')
  }
  return idx < 0
}

export function reloadCommunity() {
  communityState.likedPostIds = readList(LIKED_POST_IDS_KEY)
  // 我的发布：远程帖子由 refreshMyPosts 拉取；本机发布过的动态从存储恢复
  communityState.outfitPosts = readMockPosts()
}
